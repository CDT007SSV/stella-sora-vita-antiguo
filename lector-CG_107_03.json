",3,"z",null,null,null],["w",0.5],["ctl","avg1_107","b","009","resentful",null,null,null,null,"lengzhan","Linear",1.0],["say","avg1_107","I-I-I hear a cry for help in the distance! I have to go!",0,""],["ctl","avg1_107","b",null,null,null,-0.6,1.8,null,"manbu2","OutQuad",1.0],["cbg",0,null,null,0.9,"OutQuint",1.0,null,null,null],["se","se_089"],["say","avg1_107","C'mon, Boss, let's get back to the Lapis Eagle!",0,""],["w",0.5],["mrt",1,"z","025","exclamation","lengzhan"],["ctl","avg1_107","b",null,null,null,null,null,null,"diantou","Linear",1.0],["se","se_251"],["say","avg3_100","Whoa! What's the sudden rush?!==W== Don't pull so hard, you'll make us crash!",1,""],["w",1],["mrt",0,"z","007",null,"lengzhan"],["ctl","avg1_107","b",null,null,0.65,null,null,0.0,null,"OutQuart",1.0],["se","se_089"],["goon"],["mrt",4,"z",null,null,null],["clear",0,0,1],["w",0.5],["trn",0,0,false,false,0.5],["w",0.5],["clear",1,0,1],["w",0.5],["bg","field_daylight",0,0.0],["stg",0,null,null,1.0,"Linear",0.0,null,null,null],["show","avg1_107","b","008",null,null,null,0,null,null],["w",1],["trn",1,0,false,false,0.5],["w",1.0],["stg",0,null,null,1.2,"OutQuint",1.0,null,null,null],["w",1.0],["ctl","avg1_107","b",null,"shy",null,null,null,null,"lengzhan","Linear",1.0],["say","avg1_107","Phew...==W== I,==W== uh...",0,""],["w",1.0],["goon"],["w",0.5],["goon"],["w",0.5],["mrt",1,"y","011","think",null],["say","avg3_100","I can feel her blushing all the way through that helmet. Is it the heat, or is she just flustered?",2,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_107","b",null,"happy",null,null,null,null,"tiao2","Linear",1.0],["say","avg1_107","I did it! I upheld justice!",0,""],["ctl","avg1_107","b","003","flower",null,null,null,null,"niunie1","Linear",1.0],["say","avg3_100","And they called me \"Miss Knight\"...==W== Hehe, hehehe...",0,""],["w",1],["goon"],["w",0.5],["mrt",1,"z","022",null,"JuGong"],["say","avg3_100","Just now, Tilia, you were a true \"ally of justice,\" no doubt about it.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_107","b","007","star",null,null,null,null,null,"Linear",1.0],["bgm",""],["say","avg1_107","Really? Hearing you say that makes me feel like I can take on the world!",0,""],["w",0.5],["trn",0,1,false,false,1.0],["w",2.0],["stg",0,null,0.0,1.0,"Linear",0.0,null,null,null],["clear",1,0,1],["w",1],["bgm","m57"],["trn",1,1,false,false,1.0],["say","avg1_107","As everyone was consumed by despair,==W== the righteous knight rose to defense the innocent.==W== With no second thoughts, she confronted the colossal giant,==W== and finally won the brutal battle with her fearless courage!",11,""],["w",0.5],["choice",["Bravo!"],[[]]],["say","avg1_107","This Masked Knight story==W== was exactly like what happened just now!==W== I…==W== Am I dreaming...?",11,""],["w",0.5],["choice",["It's not a dream. You saved everyone."],[[]]],["say","avg1_107","Hehe,==W== you are making me blush...==W== But honestly,==W== it was all thanks to you!",11,""],["say","avg1_107","If you hadn’t give me that push,==W== I probably wouldn’t have had the courage to make the move.",11,""],["w",0.5],["choice",["I didn’t do anything special."],[[]]],["say","avg1_107","I don't think so.==W== Back then,==W== I was totally lost…",11,""],["say","avg1_107","Ugh,==W== I’m such a mess.==W== I always said I’d stand by my own sense of justice,==W== but I still let others’ opinions==W== get to me so easily.",11,""],["w",0.5],["choice",["We all have those moments."],[[]]],["say","avg1_107","But just now,==W== I even started doubting my belief…",11,""],["say","avg1_107","I’ve never been able to become a real Knight...==W== Maybe this is the reason…",11,""],["w",0.5],["choice",["Don’t beat yourself up. Think about what you’ve already done."],[[]]],["say","avg1_107","What ...==W== do you mean?",11,""],["w",0.5],["choice",["You've always been the one protecting, with your own strength."],[[]]],["say","avg1_107","My own ... strength...",11,""],["say","avg1_107","Hehe...==W== The way you put it...==W== I'm feeling a little better.",11,""],["w",0.5],["choice",["If you ever feel lost again, just call me."],[[]]],["w",0.5],["choice",["As your partner in justice, I’ll always be right behind you."],[[]]],["say","avg1_107","… I get it.==W== Thank you,==W== Boss.",11,""],["say","avg1_107","You’re right.==W== Since you believe in me so much,==W== I need to pull myself together!",11,""],["say","avg1_107","Ahem!==W== Well then, again—==W== Knight squire Tilia,==W== aiming at becoming a true knight of justice,==W== will always give her all!",11,""],["w",0.5],["trn",0,0,false,true,1.0],["w",1.0],["show","avg1_107","a","003",null,null,null,0,null,null],["w",0.5],["trn",1,0,false,false,1.0],["w",1.0],["stg",0,null,null,1.2,"OutQuint",1.0,null,null,null],["w",1.0],["mrt",1,"z","014","attention",null],["say","avg3_100","All right, the Masked Knight's heroic deed is done. Now it's this Boss' turn to put on a show.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_107","a","011","exclamation",null,null,null,null,"Tiao","Linear",1.0],["say","avg1_107","A show? Wait, you've already figured out how to handle United Harvest?",0,""],["w",0.5],["mrt",1,"z","003",null,null],["say","avg3_100","Yep. Sooner the better. We can't let the villagers get dragged into this.",1,""],["mrt",0,"z","013","happy",null],["say","avg3_100","So, my Masked Knight in training, go fetch the spoils of your giant battle.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_107","a","004","question",null,null,null,null,null,"Linear",1.0],["say","avg1_107","The s-spoils?",0,""],["w",0.5],["mrt",1,"z","014",null,null],["say","avg3_100","That giant, four-pronged \"arm of the giant.\"",1,""],["mrt",3,"z",null,null,null],["bgm",""],["w",0.5],["trn",0,0,false,false,1.0],["w",1.0],["clear",1,0,1],["stg",0,null,null,1.0,"Linear",0.0,null,null,null],["bg","grocery_store",0,0.0],["show","avg3_189","a","002",null,null,null,0,null,null],["w",1],["bgm","m49"],["trn",1,0,fa