",null,null],["say","avg3_100","You are always holding back because you think cookies aren't essential and you shouldn't indulge yourself.",1,""],["mrt",0,"z","022",null,null],["say","avg3_100","You're always taking care of us and buying us what we want, but you've been neglecting your own feelings.",1,""],["mrt",3,"z",null,null,null],["bgm",""],["w",0.46],["ctl","avg1_111","d","012",null,null,null,null,null,null,"OutSine",0.3],["w",0.3],["say","avg1_111","Since you've gone through all that trouble...",0,""],["w",0.3],["ctl","avg1_111","d",null,null,null,-0.32,1.5,0.0,null,"OutSine",0.4],["w",0.15],["se","se_113"],["w",0.3],["ctl","avg1_111","d","011",null,null,-0.18,1.3,1.0,null,"OutSine",0.5],["w",0.5],["say","0","Iris takes the cookies.",0,""],["w",0.3],["ctl","avg1_111","d","012","speechless",null,null,null,null,null,"OutSine",0.3],["w",0.3],["say","avg1_111","How long has it been since I last had one?",0,""],["ctl","avg1_111","d",null,null,null,null,null,null,null,"OutSine",0.3],["trn",0,1,true,true,0.8],["w",0.8],["bgm","m18"],["trn",1,1,false,false,2.2],["say","avg1_111","==W==I nagged at Noya ==W==for eating in bed this morning,==W== and now I'm doing the same...==W== Boss,==W== please help me keep this a secret!",11,""],["choice",["Don't worry"],[[]]],["w",0.1],["choice",["This will be our secret"],[[]]],["say","avg1_111","Thank you, ==W==Boss. Umm..., well...",11,""],["say","avg1_111","I must look weird now, ==W==don't I?==W== Not only did you catch me secretly book keeping under my blanket,==W== I'm now eating cookies in bed...",11,""],["say","avg1_111","Sigh...==W== There's so much going on in my head now ...==W== even the cookies ==W==that I rarely get to enjoy taste bland...",11,""],["choice",["Did I overstep with the cookie?"],[[]]],["w",0.1],["say","avg1_111","That's not ==W==what I meant...",11,""],["say","avg1_111","Actually,==W== when you gave me the cookies ...==W== I was so happy...",11,""],["say","avg1_111","But,==W== the thought that only I go