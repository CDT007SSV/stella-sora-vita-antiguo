,null,"ChanDou","Linear",0.5],["w",0.5],["mrt",2,"z","002","attention",null],["say","avg3_100","That's not a bad idea...==W== But if you only give them half, it might not be enough for the whole pack...",1,""],["w",0.5],["goon"],["mrt",4,"z","002",null,null],["w",0.5],["ctl","avg1_116","a","004",null,null,null,null,null,"jingxia","Linear",0.5],["say","avg1_116","Ugh...==W== Then I guess I'll give it all to them...!==W== Ugh...!",0,""],["w",0.4],["goon"],["w",0.4],["goon"],["ctl","avg1_116","a","008","sigh",null,null,null,null,null,"Linear",0.5],["say","avg1_116","All right,==W== you can have it all!",0,""],["w",1.0],["goon"],["ctl","avg1_116","a","008",null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["se","se_100"],["obj","qstory_side_116_002",0,null,0.6],["w",0.5],["say","avg1_116","But this is my most precious produce,==W== so you have to finish every bit of it. No waste allowed!",0,""],["w",0.5],["goon"],["w",0.5],["se","se_041"],["tsk","Xiao"],["say","Shrubshrews","Squeak—!!",0,""],["w",0.5],["say","0","The Shrubshrews nod eagerly at Ridge's words, then turn and head back into the forest. Ridge watches them go, still looking a bit reluctant.",0,""],["objx"],["w",0.5],["ctl","avg1_116","a","003",null,null,null,null,null,null,"Linear",0.0],["ctl","avg1_116","a",null,null,null,null,null,1.0,null,"Linear",0.5],["w",0.5],["mrt",2,"z","012","question",null],["say","avg3_100","Are you really okay with it?",1,""],["mrt",4,"z","012",null,null],["w",0.5],["ctl","avg1_116","a","002","symbol",null,null,null,null,"chijing","Linear",0.5],["say","avg1_116","What?!",0,""],["w",0.5],["mrt",2,"z","002",null,null],["say","avg3_100","You really hate having your food stolen, and you seemed super reluctant just now. So why did you give it all to those \"thieves\" in the end?",1,""],["mrt",4,"z","002",null,null],["w",1],["ctl","avg1_116","a","005","sigh",null,null,null,null,null,"Linear",0.5],["say","avg1_116","Because...==W== They don't have enough to eat. I just felt so sorry for them...",0,""],["w",0.5],["goon"],["ctl","avg1_116","a","008",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg1_116","I know what it's like to be hungry. Every day you have no energy, you feel miserable, and you can't look forward to the next day at all...==W== I never want to feel that way again.",0,""],["w",0.5],["goon"],["ctl","avg1_116","a","011",null,null,null,null,null,"niunie","Linear",0.5],["say","avg1_116","Because I've been through that myself. So when I think about them suffering too, I just...",0,""],["se","se_101"],["ctl","avg1_116","a","008",null,0.3,null,null,null,null,"OutSine",0.3],["say","avg1_116","I grow all these veggies and store up so much food precisely because I don't want anyone to go hungry. If they're short on food, maybe this will help them get through a tough time.",0,""],["ctl","avg1_116","a","002","attention",null,null,null,null,"daintou","Linear",0.3],["say","avg1_116","Oh, I know! How about we teach the Shrubshrews how to farm?",0,""],["ctl","avg1_116","a","006",null,null,null,null,null,"JuGong1","Linear",0.5],["say","avg1_116","That way, they'll always have something to eat and won't ever have to go hungry again!",0,""],["w",0.5],["mrt",2,"z","013","music",null],["say","avg3_100","I think that's a great idea...==W== But teaching them how to farm won't be easy. Looks like you'll be busy for a while.",1,""],["w",0.5],["mrt",0,"z","009","speechless",null],["goon"],["mrt",4,"z","009",null,null],["w",0.5],["se","se_101"],["ctl","avg1_116","a","003",null,0.5,null,null,null,"jushou","OutSine",0.3],["say","avg1_116","Really? I'm sure it'll go okay!",0,""],["w",0.5],["ctl","avg1_116","a",null,"star",null,null,null,null,"daintou","Linear",0.2],["bgm",""],["say","0","Seeing how confident Ridge looks, I suddenly feel like she might actually turn those Shrubshrews into farming experts.",0,""],["w",0.5],["end"]]}