ll],["say","avg1_123","Bo-bossy?!",0,""],["w",0.5],["ctl","avg1_123","b",null,"exclamation",null,null,null,null,"chijing","Linear",1.0],["w",1.0],["say","avg1_123","Am I dreaming? ==W==Wait, I'm not dreaming! Bossy? Bossy? Bossy, Bossy! Bossy~!",0,""],["w",0.5],["bg","forest_daylight_2",5,0.5],["fx",5,"fx_speedline_center",0,2],["stage",5,0,10],["tsk","Zhong"],["ctl","avg1_123","b","011",null,null,-0.35,1.5,1.0,null,"OutSine",0.35],["goon"],["w",0.5],["bgm","m37"],["stg",5,null,null,null,"Linear",1.0,null,null,"zhenjing"],["mrt",2,"z","025","shock",null],["say","avg3_100","Whoa ... ==W==Don't just jump at me like that. I almost didn't catch you!",1,""],["w",0.5],["mrt",0,"z","007","flurry",null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_123","b","009","star",null,0.0,1.0,1.0,null,"OutSine",0.35],["say","avg1_123","But somehow, you always catch me just right and make me feel safe!",0,""],["ctl","avg1_123","b","003","happy",null,null,null,1.0,"jushou2","OutSine",0.5],["say","avg1_123","That's why I just wanna cuddle with you, Bossy!",0,""],["w",0.5],["se","se_169"],["trn",0,1,true,false,1.0],["w",1.0],["stage",5,1,1],["bg","field_town_daylight",0,0.0],["fx",0,"fx_avg_reminiscence_loop",0,2],["trn",1,1,false,false,0.5],["w",0.5],["show","avg1_123","b","016",0.6,null,null,0,null,0.0],["ctl","avg1_123","b",null,"exclamation",0.5,null,null,1.0,"jushou2","OutSine",0.5],["say","avg1_123","Waaah! It's you, Bossy! You came to play with me!",0,""],["w",0.5],["mrt",2,"z","013",null,null],["say","avg3_100","Ann, have you been good these days...==W== Wahh!",1,""],["w",0.5],["se","se_063"],["fx",0,"fx_speedline_center_w",0,2],["ctl","avg1_123","b","007",null,null,-0.35,1.5,null,"jushou2","Linear",0.35],["w",0.5],["mrt",0,"z","025","shock",null],["goon"],["mrt",4,"z",null,null,null],["se","se_096"],["stg",0,null,null,null,"Linear",1.0,null,null,"1ZhenDong"],["ctl","avg1_123","b",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["se","se_169"],["trn",0,0,true,false,0.5],["w",0.5],["fx",0,"fx_avg_reminiscence_loop",1,2],["bg","forest_daylight_2",0,0.0],["trn",1,0,false,false,1.0],["w",1.0],["mrt",2,"z","007","flurry","chijing"],["say","avg3_100","That's why I said it's dangerous. I can't promise to catch you every single time.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["show","avg1_123","b","002",null,-0.35,1.5,0,null,0.0],["ctl","avg1_123","b","020",null,null,null,null,1.0,"niunie1","OutSine",0.5],["say","avg1_123","Don't tell me you are mad at me... Aren't you?",0,""],["w",0.5],["mrt",1,"z","010","sigh",null],["say","avg3_100","No, I'm not mad. It's just I don't want to get you hurt. ==W==Remember to give me a heads-up before you jump at me next time, okay?",1,""],["w",1.0],["mrt",0,"z","002",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_123","b","004","speechless",null,null,null,1.0,"chijing","OutSine",0.5],["say","avg1_123","Ah... Okay! ==W==Next time I'll shout really loud so you can hear me from super far away!",0,""],["w",1.0],["ctl","avg1_123","b","008","flower",null,null,null,null,"jushou2","Linear",0.5],["goon"],["w",0.5],["choice",["Pat Ann on her head"],[[]]],["w",0.5],["stg",0,null,null,null,"Linear",1.0,null,null,"niunie1"],["w",1.0],["ctl","avg1_123","b","007","love",null,null,null,1.0,"youzai","OutSine",0.5],["say","avg1_123","Hehe~",0,""],["w",0.5],["se","se_082"],["chd",0,2,"avg3_110","a","002",null],["ctl","avg3_110","a",null,null,null,null,null,null,"jushou1","Linear",0.5],["say","avg3_110","Awooo!",0,""],["w",0.5],["chd",1,2,"avg3_110","a","002",null],["ctl","avg1_123","b",null,null,null,0.0,1.0,1.0,"jushou2","OutSine",0.35],["show","avg3_110","a","002",0.9,null,0.9,0,null,0.0],["ctl","avg3_110","a",null,null,0.85,null,null,1.0,null,"Linear",0.5],["ctl","avg1_123","b","005","love",null,null,null,null,"niunie1","Linear",1.0],["w",1.0],["say","avg1_123","I didn't forget, Coco. You don't need to remind me.",0,""],["w",0.5],["stg",0,-60.0,null,1.15,"Linear",0.5,null,null,null],["mrt",1,"z","002","attention",null],["say","avg3_100","What's Coco saying?",1,""],["w",0.5],["mrt",0,"z","002",null,null],["ctl","avg1_123","b","018","shy",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_123","That it's almost time for the forest patrol. Don't worry, I remember. Coco, you worry too much.",0,""],["w",0.5],["mrt",1,"z","002",null,null],["say","avg3_100","You mean your daily routine? If so, count me in, too.",1,""],["w",0.5],["mrt",3,"z",null,null,null],["ctl","avg1_123","b","004","attention",null,null,null,null,null,"Linear",0.5],["say","avg1_123","Bossy wants to come along?==W== Oh yeah, let’s go!",0,""],["w",0.5],["ctl","avg1_123","b","009","music",null,null,null,1.0,"youzai","OutSine",0.5],["goon"],["w",0.5],["ctl","avg3_110","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["ctl","avg1_123","b","008","star",null,-0.35,1.5,1.0,"jushou2","OutSine",0.35],["say","avg1_123","Hold my hand, okay? The forest is big and we don't want you to get lost.",0,""],["w",0.5],["choice",["Take Ann's hand"],[[]]],["w",0.5],["ctl","avg1_123","b","005","happy",null,null,null,null,null,"Linear",0.5],["say","avg1_123","Heh-heh.",0,""],["stg",0,60.0,null,null,"Linear",0.5,null,null,null],["ctl","avg1_123","b","010","attention",0.4,0.0,1.0,1.0,"jushou2","OutSine",0.5],["say","avg1_123","Bossy, be careful! There are lots of bad guys around here!",0,""],["w",0.5],["mrt",1,"z","009","speechless",null],["say","avg3_100","... True, better safe than sorry.",1,""],["mrt",3,"z",null,null,null],["w",1.0],["bgm",""],["se","se_076"],["trn",0,2,true,false,0.5],["w",0.5],["bg","forest_daylight_2",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,-200.0,-200.0,1.5,"Linear",0.0,null,null,null],["trn",1,2,false,false,0.5],["w",0.5],["bgm","m56"],["cbg",0,0.0,null,null,"Linear",4.0,null,null,null],["w",0.5],["say","0","I follow carefully behind Ann. The deeper we go into the forest, the more beautiful the scenery becomes, but my attention is occupied elsewhere.",0,""],["w",0.5],["bgm",""],["bg","BG_Black",0,0.5],["se","se_112"],["say","0","Because I can sense it: there's something dangerous hanging in the air between the trees, sending a chill down my spine.",0,""],["w",0.5],["bg","forest_daylight_2",0,1.0],["w",1.0],["show","avg1_123","b","014",0.45,null,null,0,null,0.0],["ctl","avg1_123","b",null,"question",0.5,null,null,1.0,null,"OutSine",0.5],["say","avg1_123","What's wrong, Bossy? ==W==Wait... Did you sense that too?",0,""],["w",0.5],["ctl","avg1_123","b","012","attention",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg1_123","b",null,null,null,null,null,null,null,"Linear",0.0],["bgm",""],["stg",0,null,null,null,"Linear",1.0,null,null,"Zhong"],["mrt",2,"z","013","happy",null],["say","avg3_100","Huh? No. What are you talking about?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_123","b","005","star",null,null,null,1.0,"jushou2","OutSine",0.5],["say","avg1_123","No need to hide it from me. Don't worry, I've set up plenty of traps all through this forest!",0,""],["w",0.5],["se","se_077"],["ctl","avg1_123","b","012",null,null,null,null,null,"JuGong1","Linear",0.5],["w",0.5],["se","se_099"],["ctl","avg1_123","b","012",null,0.45,null,null,0.0,null,"Linear",0.3],["w",0.3],["stg",0,null,null,null,"Linear",1.0,null,null,"Zhong"],["w",0.5],["se","se_235"],["se","se_406"],["bg","BG_Black",0,0.5],["w",0.5],["say","0","Ann picks up a stone by her feet and tosses it onto an area seemingly clear ahead. A large net instantly springs up from beneath the grass.",0,""],["w",0.5],["mrt",1,"z","025","exclamation",null],["say","avg3_100","Wow... I had no idea there was a net hidden underneath all that... Would have totally fell for that.",1,""],["w",0.5],["mrt",0,"z","002",null,null],["bg","forest_daylight_2",0,0.5],["w",0.5],["ctl","avg1_123","b","005","star",0.5,null,null,1.0,null,"OutSine",0.5],["say","avg1_123","I made this trap myself. It's caught plenty of bad guys. Coco and I chased every last one of them out of the forest.",0,""],["ctl","avg1_123","b","014",null,null,null,null,1.0,"jushou2","OutSine",0.5],["say","avg1_123","I patrol every day to make sure there aren't any bad guys around. But some of the old traps are broken, so I need to find and fix them while I'm out here.==W== Got it, Bossy?",0,""],["ctl","avg1_123","b","008","happy",null,null,null,null,null,"Linear",0.5],["w",0.5],["goon"],["w",0.5],["mrt",1,"z","020","speechless",null],["say","avg3_100","Old traps...==W== Wait, Ann, are you telling me you made all the traps inside this forest?",1,""],["w",1.0],["mrt",0,"z","025","symbol",null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_123","b","018","shy",null,null,null,1.0,"chijing","OutSine",0.5],["say","avg1_123","I'm good but I'm not that good!",0,""],["w",0.5],["stg",0,60.0,null,null,"Linear",0.5,null,null,null],["ctl","avg1_123","b","009","music",0.3,null,null,1.0,"jushou2","OutSine",0.5],["say","avg1_123","Those traps were set up by the Eaze Village Adventurers. Back then, there were lots and lots of people on the squad. It wasn't always just me!",0,""],["ctl","avg1_123","b","003","speechless",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_123","Granny Enya taught everyone how to hide traps with branches and leaves. Nalan could run fast and jump high, so he was in charge of setting up all the moving mechanisms.",0,""],["ctl","avg1_123","b","008","flower",0.6,null,null,null,"jushou2","Linear",0.5],["say","avg1_123","Little Pea was great at drawing and could turn realistic pictures into cleverly disguised traps. And Uncle Mike could fix anything—whenever a mechanism broke, he'd always get it working again.",0,""],["w",0.5],["ctl","avg1_123","b","009","happy",0.45,null,null,1.0,"jushou2","OutSine",0.5],["say","avg1_123","We used to build traps together to keep out dangerous monsters and stop those masked bad guys from sneaking into the forest.",0,""],["w",0.5],["bgm",""],["ctl","avg1_123","b","020","speechless",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_123","But eventually...==W== The squad got smaller and smaller. Some said \"see you tomorrow\" but never came back. Before I knew it, I was the only one left...",0,""],["w",1.0],["se","se_095"],["bg","mood_3",0,0.5],["w",0.5],["ctl","avg1_123","b","015",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg1_123","b","013","vexation",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_123","I heard that they went off to live in the city. But I just don't understand. Why does everyone end up leaving their homes? Are they never coming back...?",0,""],["w",0.5],["mrt",1,"z","009",null,null],["say","avg3_100","W-well...",1,""],["mrt",3,"z",null,null,null],["w",0.5],["bg","forest_daylight_2",0,0.5],["w",0.5],["se","se_077"],["stg",0,null,null,1.05,"Linear",0.5,null,null,"jushou"],["w",0.5],["say","0","Instead of giving my answer, I crouch down and steady Ann's little straw hat before it slips off.",0,""],["w",0.5],["bgm","m12"],["mrt",1,"z","023",null,null],["say","avg3_100","The answer to that question is something that you'll have to find out for yourself, once you grow up.",1,""],["mrt",0,"z","022","love",null],["say","avg3_100","So no point in hurrying to find out. And even without your teammates, Ann, you’re strong enough to keep going, right?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_123","b","003","flower",null,null,null,1.0,"jushou2","OutSine",0.5],["say","avg1_123","Mm-hm! Ann will keep going!",0,""],["w",0.5],["se","se_061"],["stg",0,null,null,null,"Linear",1.0,null,null,"niunie1"],["w",1.0],["say","0","I pat Ann's head again. She tries to act all grown-up and serious, but her tail gives away everything she's feeling.",0,""],["w",0.5],["bg","forest",4,0.0],["show","avg3_110","a","002",0.68,null,0.9,4,null,1.0],["stage",4,0,0],["bgm",""],["se","se_074"],["se","se_155"],["ctl","avg3_110","a",null,null,0.6,null,null,1.0,"jushou","Linear",0.5],["say","avg3_110","Awo! Awoo!",0,nu