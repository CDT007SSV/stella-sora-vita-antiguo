],["bgm","m1"],["show","avg1_125","a","002",null,null,null,0,"attention",null],["say","avg1_125","Good morning to you, Boss. ==W==It has been quite some time—I do hope you have been faring well.",0,""],["w",0.5],["se","se_077"],["ctl","avg1_125","a","016",null,null,null,null,1.0,"JuGong","OutSine",0.5],["goon"],["w",0.5],["ctl","avg1_125","a","005",null,null,null,null,null,null,"Linear",0.5],["w",0.5],["mrt",1,"y","025","shock","chijing"],["say","avg3_100","What's with the formality? And a full-on hat tip?",2,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_125","a","007","love",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_125","Thank you for taking on my commission. With Donna and Teresa away today, you've really helped us out here at Post Haste.",0,""],["w",0.5],["mrt",1,"z","013","happy",null],["say","avg3_100","Don't mention it, I'm happy to be your special delivery person. So, what do you need me to do?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_077"],["ctl","avg1_125","a","005",null,null,null,null,1.0,"JuGong1","OutSine",0.5],["say","avg1_125","Your role will simply be to navigate the delivery routes, and I shall do the rest.",0,""],["w",0.5],["mrt",1,"z","002",null,null],["say","avg3_100","Navigate the routes?",1,null],["mrt",3,"z",null,null,null],["w",0.5],["se","se_021"],["ctl","avg1_125","a","014",null,0.3,0.0,1.0,1.0,null,"OutSine",0.5],["obj","qstory_side_125_001",1,null,null],["say","avg1_125","Yes. The highlighted points on the map show where we'll be heading.",0,""],["w",0.5],["ctl","avg1_125","a","005",null,null,null,null,null,null,"Linear",0.5],["say","avg1_125","I usually deliver letters by bike as it's more efficient. Normally I'd stop to check the map, but today I'm on a tight schedule with much to do, so I'll have to trouble you for directions.",0,""],["w",0.5],["mrt",1,"z","020",null,null],["say","avg3_100","Got it. Let me take a look at the map...==W== We sure are hitting a lot of places.",1,""],["w",0.5],["mrt",0,"z","002","attention",null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_125","a","004","speechless",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_125","I did the math last night. I'll be biking a total of 57 kilometers.==W== Not counting the rest stops, it should take about four and a half hours.",0,""],["w",1.0],["ctl","avg1_125","a","014",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["mrt",1,"z","025","symbol",null],["say","avg3_100","F-four and a half hours...?!",1,""],["mrt",3,"z",null,null,null],["w",0.5],["objx"],["w",0.5],["se","se_075"],["ctl","avg1_125","a","002",null,0.5,null,null,1.0,null,"OutSine",0.5],["say","avg1_125","It's actually a light day. Normally we're out for five or six hours.",0,""],["w",0.5],["mrt",1,"z","010","sigh",null],["say","avg3_100","That sounds like a lot of work...==W== But how will I guide you?",1,""],["w",0.5],["mrt",0,"z","002",null,null],["goon"],["mrt",0,"z","015",null,null],["say","avg3_100","Don't tell me you're planning to ride the bike while I run alongside you?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_146"],["ctl","avg1_125","a","015",null,null,null,null,null,"chijing","Linear",0.5],["say","avg1_125","Aha...That would be highly disrespectful … and impractical.",0,""],["ctl","avg1_125","a","005","attention",null,null,null,1.0,"jushou0","OutSine",0.5],["say","avg1_125","I asked Teresa to make a few modifications to the bike.",0,""],["ctl","avg1_125","a",null,null,0.3,null,null,null,null,"OutSine",0.5],["se","se_180"],["obj","qstory_side_125_002",1,null,null],["w",1.5],["mrt",2,"z","015","speechless",null],["say","avg3_100","...==W== That's just...adding a seat on the back.",1,null],["w",1.0],["mrt",0,"z","007","exclamation","jushou2"],["goon"],["w",0.5],["ctl","avg1_125","a","016",null,null,null,null,1.0,null,"OutSine",0.5],["say","avg1_125","Exactly.",0,""],["w",0.5],["objx"],["w",0.5],["ctl","avg1_125","a","003","star",0.5,null,null,null,null,"OutSine",0.5],["say","av