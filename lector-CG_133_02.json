,["bg","traveller_camp_b_daylight",0,0.5],["w",0.5],["ctl","avg1_133","a","028",null,null,null,null,null,"JuGong1","Linear",0.5],["say","avg1_133","I have a rough idea as to where they might be.",0,""],["w",0.5],["mrt",1,"z","002","attention",null],["say","avg3_100","What do you mean?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","a","003","speechless",null,null,null,null,null,"Linear",0.5],["w",1.5],["se","se_146"],["ctl","avg1_133","a","005",null,null,null,null,null,"chijing","Linear",0.5],["say","avg1_133","Actually, the reason I was late today was that I was investigating a suspicious group's hideout.",0,""],["ctl","avg1_133","a","023",null,null,null,null,null,null,"Linear",0.5],["say","avg1_133","I caught some of them, but the rest managed to escape. That was my mistake.",0,""],["w",0.5],["mrt",1,"z","009",null,null],["say","avg3_100","I see.",1,""],["mrt",0,"z","002","question",null],["say","avg3_100","That's why you asked me to join the patrol?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","a","007",null,null,null,null,null,null,"Linear",0.5],["say","avg1_133","Yeah. I was hoping maybe you'd notice something I missed, given your insight...==W== Didn't expect them to assault the camp in the open.",0,""],["w",1.0],["ctl","avg1_133","a","016","vexation",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["mrt",1,"y","023",null,null],["say","avg3_100","That's so like you, Nazuka.",2,""],["mrt",0,"z","002","question",null],["say","avg3_100","So, do you know what they're after?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","a","010",null,null,null,null,null,null,"Linear",0.5],["say","avg1_133","Most likely supplies. Since the hunting squad disbanded, security around the camp's gotten weaker. They've already carried out several thefts.",0,""],["w",0.5],["mrt",1,"z","012",null,null],["say","avg3_100","If they managed to slip past you, they must be pretty crafty.",1,""],["mrt",3,"z",null,null,null],["w",0.5]