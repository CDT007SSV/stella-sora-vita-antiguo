t traps the enemy inside.",0,""],["w",0.5],["mrt",1,"y","011","star",null],["say","avg3_100","Scouting, attack, capture... Nazuka really can do it all.",2,""],["w",0.5],["mrt",0,"z","002","question",null],["say","avg3_100","So... It's over?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","a","002",null,null,null,null,null,null,"Linear",0.5],["say","avg1_133","I've called for reinforcements. They're on their way.",0,""],["w",0.5],["se","se_077"],["ctl","avg1_133","a","010",null,null,null,null,null,"JuGong1","Linear",0.5],["say","avg1_133","Once we get these guys to tell us where the others are hiding, the rest won't be a problem.==W== That'll wrap up our patrol for today.",0,""],["w",0.5],["ctl","avg1_133","a","016","sigh",null,null,null,1.0,null,"OutSine",0.5],["goon"],["bgm",""],["ctl","avg1_133","a","012","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_133","Thanks for keeping me company. And...==W== I'm so so sorry. Even with me here, you still got a scare.",0,""],["w",1.0],["se","se_146"],["ctl","avg1_133","a","024",null,null,null,null,1.0,"niunie1","OutSine",0.5],["goon"],["w",0.5],["bgm","m3"],["mrt",1,"z","015",null,null],["say","avg3_100","Nazuka...",1,""],["mrt",0,"y","010",null,null],["say","avg3_100","I just got a deer bite, that's all.",2,""],["mrt",0,"z","014","music",null],["say","avg3_100","Don't worry about it. I just wanted to help you catch those criminals.",1,""],["w",0.5],["mrt",0,"z","013","happy",null],["say","avg3_100","Now we can relax and stroll around the market, right? Haha.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","a","006","vexation",null,null,null,null,"chijing","Linear",0.5],["say","avg1_133","Still, if I'd captured them all earlier, I wouldn't have had to drag you into all this.",0,""],["w",0.5],["se","se_077"],["ctl","avg1_133","a","029",null,null,null,null,null,"JuGong1","Linear",0.5],["say","avg1_133","Sorry.",0,""],["w",0.5],["mrt",1,"y","007","shock",null],["say","avg3_100","There seems to be some sort of misunderstanding.",2,""],["mrt",0,"z","015",null,null],["say","avg3_100","Did you think I was blaming you?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","a","009","question",null,null,null,null,null,"Linear",0.5],["say","avg1_133","You weren't?",0,""],["w",0.5],["mrt",1,"z","010","sigh",null],["say","avg3_100","Of course not.",1,""],["mrt",0,"z","002",null,null],["say","avg3_100","You just made one mistake. You're way too hard on yourself.",1,""],["mrt",0,"z","009",null,null],["say","avg3_100","I only wanted to repay your trust, that's all.",1,""],["mrt",0,"z","002",null,null],["say","avg3_100","You are the perfect fighter, but I just wanted to help, even if that meant being the decoy.",1,""],["mrt",0,"z","022","music",null],["say","avg3_100","In the end, I didn't do much, but I'm still glad I got to work with you.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","a","007","speechless",null,null,null,null,null,"Linear",0.5],["w",1.5],["ctl","avg1_133","a","017","happy",null,null,null,null,"jushou2","Linear",0.5],["say","avg1_133","Hehe...",0,""],["w",0.5],["mrt",1,"z","015","question",null],["say","avg3_100","Hmm?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","a","012","love",null,null,null,null,"JuGong1","Linear",0.5],["say","avg1_133","I just realized... We both try so hard to live up to each other's expectations.",0,""],["w",0.5],["mrt",1,"z","009",null,null],["say","avg3_100","That's true.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_074"],["ctl","avg1_133","a","008",null,null,-0.35,1.5,null,null,"Linear",0.3],["say","avg1_133","But ==PLAYER_NAME==, to me, you're already one of a kind—a partner I can't replace.",0,""],["ctl","avg1_133","a","017",null,null,null,null,null,"niunie1","Linear",0.5],["say","avg1_133","So please don't overthink it.",0,""],["ctl","avg1_133","a","009",null,null,null,null,null,null,"Linear",0.5],["say","avg1_133","As long as you stay with me, then...",0,""],["w",0.5],["ctl","avg1_133","a","024","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_133","...",0,""],["w",0.5],["mrt",1,"z","002","question",null],["say","avg3_100","Then what?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","a","018","happy",null,null,null,null,"JuGong1","Linear",0.5],["say","avg1_133","That's a secret.==W== I want to keep this feeling to myself, for now.",0,""],["w",1.0],["ctl","avg1_133","a","027",null,null,null,null,null,null,"Linear",0.3],["goon"],["w",0.5],["mrt",1,"z","014","music",null],["say","avg3_100","Now you've got me even more curious. Guess I'll just have to work harder until you tell me yourself.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","a","017","flower",null,0.0,1.0,null,null,"Linear",0.3],["say","avg1_133","I'm looking forward to it.",0,""],["bgm",""],["w",0.5],["trn",0,0,true,false,1.0],["w",1.0],["bg","traveller_camp_a_daylight",0,2.0],["w",2.0],["stg",0,0.0,null,1.0,"Linear",0.0,null,null,null],["se","se_065"],["trn",1,0,false,false,1.0],["w",1.5],["bgm","m12"],["mrt",1,"y","020","think",null],["say","avg3_100","Now, what's next? We already had those skewers, so I'm not hungry.",2,""],["mrt",0,"z","002","attention",null],["say","avg3_100","Oh, by the way, Nazuka, let's go back to that souvenir shop from earlier.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["show","avg1_133","a","007",0.5,null,null,0,null,0.0],["ctl","avg1_133","a",null,"question",null,null,null,1.0,null,"Linear",0.5],["say","avg1_133","Why?",0,""],["w",0.5],["mrt",1,"z","009",null,null],["say","avg3_100","I'm curious about the pinwheel thing.",1,""],["mrt",0,"z","002",null,null],["say","avg3_100","You reacted oddly back then. Does it mean something I don't know about?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","a","029","vexation",null,null,null,null,"chijing","Linear",0.5],["say","avg1_133","That is actually...",0,""],["w",0.5],["mrt",1,"z","002",null,null],["say","avg3_100","Another tough question?",1,""],["mrt",0,"z","022","question",null],["say","avg3_100","Then let me put it this way... If I gave you a pinwheel, would it make you happy?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","a","007","speechless",null,null,null,null,null,"Linear",0.5],["w",1.5],["ctl","avg1_133","a","009","shy",null,null,null,null,"chijing","Linear",1.0],["w",1.0],["say","avg1_133","Yes.",0,""],["w",0.5],["mrt",1,"z","013","music",null],["say","avg3_100","All right, that settles it.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_148"],["trn",0,0,false,false,0.5],["w",0.5],["ctl","avg1_133","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["trn",1,0,false,false,0.5],["w",0.5],["stg",0,60.0,null,null,"Linear",0.5,null,null,null],["show","avg3_143","a","002",0.45,null,null,0,null,0.0],["ctl","avg3_143","a",null,null,null,null,null,1.0,null,"Linear",0.5],["w",0.5],["mrt",2,"z","002","attention",null],["say","avg3_100","Excuse me, could I have one of those pinwheels from before?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_143","a",null,"happy",null,null,null,1.0,"JuGong1","Linear",0.5],["say","Souvenir Vendor","Sure thing.",0,""],["w",0.5],["se","se_148"],["trn",0,0,false,false,0.5],["w",0.5],["ctl","avg3_143","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["stg",0,0.0,null,null,"Linear",0.0,null,null,null],["trn",1,0,false,false,0.5],["w",0.5],["ctl","avg1_133","a",null,null,null,null,null,1.0,null,"Linear",0.5],["w",0.5],["se","se_062"],["stg",0,null,-30.0,1.05,"Linear",0.5,null,null,null],["w",1.0],["mrt",2,"z","014","star",null],["say","avg3_100","Here. It's for you.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["bgm",""],["ctl","avg1_133","a","011","speechless",null,null,null,null,"chijing","Linear",0.5],["w",2.5],["ctl","avg1_133","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["trn",0,1,true,false,0.5],["w",0.5],["bgm","m18"],["trn",1,1,false,false,3.0],["say","avg