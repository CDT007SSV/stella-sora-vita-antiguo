ay","avg1_137","... I still have a long way to go. If I want to catch up to you, I need more experience under my belt.",0,""],["w",0.5],["mrt",1,"z","017",null,null],["say","avg3_100","... Hard work is great, but don't push yourself too hard.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_137","b","002",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg1_137","I understand. Good night, Mentor.",0,""],["bgm",""],["w",0.5],["trn",0,0,true,true,0.75],["w",0.75],["bg","hotel_corridor_night",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,null,"Linear",0.0,null,null,null],["w",0.5],["say","0","Once Eleanor leaves, I sink into the soft bed and close my eyes.",0,""],["w",0.5],["se","se_055"],["say","0","I don't know how long I've slept, but I get up, all groggy, and stumble into the corridor...",0,""],["w",0.5],["se","se_167"],["cbg",0,null,null,1.1,"OutQuad",0.75,null,null,null],["trn",1,0,false,false,0.75],["w",1.25],["bgm","m4"],["mrt",1,"y","020","think",null],["say","avg3_100","...==W== Where's the bathroom again? This place is huge, and with the lights off, I can't see a thing.",2,""],["w",0.5],["mrt",0,"y","021",null,"lengzhan"],["goon"],["w",0.5],["mrt",0,"y","009","sweaty",null],["say","avg3_100","I can't wake someone up just to ask for directions...==W== Wait. Is that light coming from under that door?",2,""],["w",0.5],["cbg",0,-100.0,null,1.3,"OutQuad",0.5,null,null,null],["w",0.5],["mrt",0,"y","012","question",null],["goon"],["w",0.5],["mrt",0,"y","013","star",null],["say","avg3_100","Perfect! Someone's still awake. I'll ask them for directions.",2,""],["w",0.5],["se","se_171"],["mrt",0,"z","002",null,"jushou"],["say","avg3_100","Sorry to bother you this late. I was wondering...",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_062"],["show","avg1_137","a","002",0.65,null,null,0,null,0.0],["ctl","avg1_137","a",null,null,0.6,null,null,1.0,null,"OutQuad",0.5],["say","avg1_137","... Mentor? What are you doing up