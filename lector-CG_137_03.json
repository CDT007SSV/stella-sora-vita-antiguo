",0,""],["w",0.5],["mrt",1,"z","021","awkward",null],["say","avg3_100","That's not something I'd encourage. Please be more careful from now on.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_137","b","015","sweaty",null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_137","I know! I've learned my lesson.",0,""],["w",0.5],["bg","flatlands_daylight",0,1.0],["cbg",0,null,null,1.1,"Linear",0.0,null,null,null],["cbg",0,null,null,1.0,"Linear",10.0,null,null,null],["ctl","avg1_137","b",null,null,null,null,null,0.0,null,"Linear",0.5],["w",1],["say","avg1_137","... If I hadn't become a Trekker, I never would have realized how vast the world is. Or that the nameless flowers in my books actually bloom in real life.",9,""],["w",0.5],["se","se_055"],["say","avg1_137","Watching my world expand... I'll never get tired of exploring the unknown.",9,""],["w",0.5],["say","avg1_137","Even with the challenges ahead, I've never once regretted chasing my dream!",9,""],["w",0.5],["bg","forest",0,0.5],["ctl","avg1_137","b","002",null,null,null,null,1.0,null,"Linear",0.5],["w",0.5],["mrt",1,"z","020",null,null],["say","avg3_100","That's nice...",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_137","b","014","shock",null,null,null,null,"ChanDou","Linear",0.5],["say","avg1_137","Ah, I got carried away talking and forgot to draw. I need to focus now, Mentor.",0,""],["w",0.5],["ctl","avg1_137","b","002",null,null,null,null,null,null,"Linear",0.5],["mrt",1,"z","013",null,null],["say","avg3_100","Alright. I'll take a walk nearby.",1,""],["mrt",3,"z",null,null,null],["se","se_101"],["ctl","avg1_137","b",null,null,0.45,null,null,0.0,null,"OutQuad",0.5],["bgm",""],["w",0.5],["se","se_076"],["trn",0,0,true,true,0.75],["w",0.75],["bg","forest",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,1.1,"Linear",0.0,null,null,null],["w",0.5],["trn",1,0,false,false,0.75],["w",1.25],["bgm","m31"],["se","se_101"],["show","avg1_137","b","002",0.45,null,null,0,null,0.0],["ctl","avg1_137","b",null,"attention",0.5,null,null,1.0,null,"OutQuad",0.5],["w",0.5],["say","avg1_137","Okay, that should do it. Mentor, I'm done!",0,""],["w",0.5],["mrt",1,"z","017",null,null],["say","avg3_100","Perfect timing. Just done with my walk too.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_137","b","008",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg1_137","Sorry to keep you waiting, Mentor.",0,""],["w",0.5],["mrt",1,"z","002",null,null],["say","avg3_100","Don't worry about it. Say...==W== Eleanor, could you close your eyes?",1,""],["w",0.5],["mrt",0,"z","004",null,"diantou"],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_137","b","014",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_137","My eyes?==W== Okay...",0,""],["w",0.5],["ctl","avg1_137","b","016",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.3],["stg",0,null,-80.0,1.2,"OutQuad",0.65,null,null,"jushou"],["cbg",0,null,null,1.15,"OutQuad",0.65,null,null,null],["w",0.65],["bgm",""],["w",0.5],["trn",0,0,true,true,0.5],["w",0.5],["bg","BG_Black",0,0.0],["se","se_077"],["w",0.5],["mrt",1,"z","002",null,null],["say","avg3_100","... Alright, open them.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["say","avg1_137","Mentor? Did you put something on my head...==W== Oh...!",0,""],["w",0.5],["se","se_058"],["goon"],["w",0.5],["trn",0,1,true,false,0.5],["w",0.5],["trn",1,1,false,false,3.0],["bgm","m144"],["say","avg1_137","Is this ...==W== a flower crown!?",11,""],["choice",["I made it while you were painting."],[[]]],["say","avg1_137","Wow...==W== It's beautiful!==W== And incredibly cute!",11,""],["say","avg1_137","But Mentor,==W== why a flower crown...?",11,""],["choice",["I realized I haven't celebrated with you."],[[]]],["choice",["Since you're officially recognized as a Trekker."],[[]]],["say","avg1_137","A-A celebration...!?==W== Thank you so much!",11,""],["say","avg1_137","Um,==W== Mentor!==W== Does it==W== look good on me?",11,""],["choice",["Of course."],[[]]],["say","avg1_137","Ehehe...==W== I'm so, so happy.==W== I feel like a princess from a picture book...",11,""],["say","avg1_137","Being a Trekker is amazing, isn't it?==W== It lets me fulfill so many dreams and aspirations...==W== This is definitely something==W== I never could have experienced if I had stayed in the mansion.",11,""],["choice",["Let's keep making them come true."],[[]]],["choice",["All your new dreams, Eleanor."],[[]]],["say","avg1_137","My new dreams...==W== I think...==W== Right now, my dream is==W== to become a proper \"lady Trekker,\"==W== establish a guild of my own,==W== and to go on lots of adventures==W== with my precious friends.",11,""],["choice",["That's a great dream."],[[]]],["choice",["I'll be cheering you on."],[[]]],["say","avg1_137","Mentor...==W== Thank you.==W== I'm so glad==W== I met you...==W== I'm truly happy to be under your guidance.",11,""],["say","avg1_137","Please continue==W== to watch me grow, will you?",11,""],["choice",["I promise you I will."],[[]]],["say","avg1_137","!...==W== It's a promise, then!",11,""],["say","avg1_137","Oh, right, Mentor!==W== Please let me do something to thank you!",11,""],["say","avg1_137","You wanted to learn dancing, right?==W== If you'd like,==W== how about right here?",11,""],["choice",["Here?"],[[]]],["say","avg1_137","Yes,==W== it's just the two of us here, so we can dance freely...==W== It makes a lovely dance floor, don't you think?",11,""],["choice",["Yeah. And it's a beautiful place."],[[]]],["say","avg1_137","Then, Mentor,==W== let's dance together!",11,""],["trn",0,1,false,false,1],["w",1],["bgm",""],["bg","BG_Black",0,0.0],["trn",1,1,false,false,1.0],["w",1.5],["trn",0,0,true,true,0.75],["w",0.75],["bg","forest",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["show","avg1_137","b","002",0.6,-0.25,1.3,0,null,null],["w",0.5],["cbg",0,50.0,null,null,"Linear",20.0,null,null,null],["ctl","avg1_137","b",null,null,0.4,null,null,null,null,"Linear",20.0],["trn",1,0,false,false,0.75],["w",1.25],["fx",0,"fx_avg_sunlight",0,1],["ctl","avg1_137","b","003",null,null,null,null,null,null,"Linear",0.5],["say","0","I gently take her hand. Sunlight filters through the canopy, and the shadow of worry has vanished from her face.",0,""],["w",0.5],["say","0","On this private dance floor, her steps are light and graceful, like a free-spirited woodland fairy.",0,""],["w",0.5],["end"]]}