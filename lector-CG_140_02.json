l","avg1_140","b","010","happy",null,null,null,null,null,"Linear",0.5],["say","avg1_140","Aw, what a nice kid you are. You even remembered the name?",0,""],["w",0.5],["ctl","avg3_200","a","006","flower",null,null,null,null,null,"Linear",0.5],["say","Shy Boy","Yeah. Because it sounds really cute...",0,""],["w",0.5],["ctl","avg1_140","b","006","music",null,null,null,null,"youchupeng","Linear",0.5],["say","avg1_140","Right? Right?! You've got taste, kid.",0,""],["w",0.5],["ctl","avg3_200","a",null,"exclamation",null,null,null,null,"jushou2","Linear",0.5],["say","Shy Boy","I especially liked the carrot lever on top. It was super fun!",0,""],["w",0.5],["ctl","avg1_140","b","003","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_140","Hmm. If you like it that much...==W== All right! This Long-Eared Lookout Pie is yours now.",0,""],["w",1.0],["ctl","avg1_140","b","009","star",null,null,null,1.0,null,"OutSine",0.5],["goon"],["w",0.5],["stg",0,null,null,null,"Linear",1.0,null,null,"Xiao"],["ctl","avg3_200","a","007","shock",null,null,null,null,null,"Linear",0.5],["say","Shy Boy","R-really?! I can really have it?!",0,""],["w",0.5],["ctl","avg1_140","b","002",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg1_140","Of course. Anyone who appreciates how cute the Long-Eared Lookout Pie is clearly has good taste. I'd be happy for you to have it~",0,""],["w",0.5],["ctl","avg3_200","a",null,"love",0.6,null,null,null,"jushou2","Linear",0.5],["say","Shy Boy","Yay! Thank you so, so much, Miss!",0,""],["w",0.5],["ctl","avg1_140","b","004","attention",null,null,null,null,null,"Linear",0.5],["say","avg1_140","Oh, right, right. And if you ever want to try fitting it with different lenses,==W== you can get in touch with the person next to me~",0,""],["w",0.5],["stg",0,60.0,null,null,"Linear",0.5,null,null,null],["goon"],["w",0.5],["mrt",1,"z","015","question",null],["say","avg3_100","M-me?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_140","b","002",null,null,null,null,null,null,"Linear",0.3],["ctl","avg3_200","a","006","flower",0.5,-0.35,1.5,null,"jushou2","Linear",0.3],["say","Shy Boy","Okay! I'll do that, ==SEX17==!",0,""],["w",0.5],["mrt",1,"z","010","sigh",null],["say","avg3_100","Honestly, why is she suddenly volunteering me for extra work?==W== Still... Since it's for a kid, I can't really say no.",1,""],["w",0.5],["bgm",""],["mrt",0,"z","022",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["trn",0,0,true,false,1.0],["w",1.0],["bg","sky_dusk_a",0,0.5],["w",0.5],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["trn",1,0,false,false,1.0],["w",1.0],["cbg",0,null,90.0,null,"Linear",1.0,null,null,null],["w",0.5],["bg","flatlands_dusk",0,0.5],["w",0.5],["bgm",""],["w",0.5],["show","avg1_140","b","002",0.55,null,null,0,null,0.0],["ctl","avg1_140","b",null,null,0.5,null,null,1.0,null,"Linear",0.5],["say","avg1_140","Hehe♪ I knew you wouldn't let me down, Boss♪",0,""],["ctl","avg1_140","b","006","shy",null,null,null,null,null,"Linear",0.5],["say","avg1_140","And thanks for bringing me to see the play. My mind feels a lot clearer now, and my mood's way better, too.",0,""],["w",0.5],["mrt",1,"z","022",null,null],["say","avg3_100","That's great. Seeing so many people enjoy your inventions must make you want to work even harder.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_140","b","003","happy",null,null,null,null,null,"Linear",0.5],["say","avg1_140","Oh my. You noticed, huh.",0,""],["w",0.5],["ctl","avg1_140","b","004","exclamation",null,null,null,null,null,"Linear",0.5],["say","avg1_140","Hehe~ Boss, you deserve a little gold star!==W== Actually, all the stage machineries we saw today were invented by me♪",0,""],["w",0.5],["ctl","avg1_140","b","009","music",null,-0.15,1.3,null,null,"Linear",0.3],["goon"],["bgm",""],["ctl","avg1_140","b","010",null,null,null,null,null,null,"Linear",0.5],["say","avg1_140","That was the only commission I took recently. Compared to the clients who drone on forever and pile on request after request, this one was a lot more fun.",0,""],["w",0.5],["bgm",""],["ctl","avg1_140","b","003","speechless",null,null,null,null,null,"Linear",0.5],["w",1.5],["trn",0,0,true,false,1.0],["w",1.0],["bgm","m113"],["bg","4054_B",0,0.5],["w",0.5],["cbg",0,null,null,null,"Linear",0.0,null,null,"JingTouYaoHuang"],["bg","circle_light",0,0.0],["cbg",0,null,null,3.0,"Linear",0.0,null,null,null],["trn",1,0,false,false,1.0],["w",1.5],["say","avg1_140","My dream, ever since I was little, has been getting to be the heroine of a fairy tale with magical powers, like in The Wizard in the Emerald Castle or Alicia's Underground Adventure.",9,""],["w",0.5],["bg","4054_B",0,1.0],["cbg",0,300.0,400.0,1.3,"Linear",0.0,null,null,null],["w",1],["say","avg1_140","Rabbit Pie was actually designed after that always-late rabbit from Underground Adventure~",9,""],["w",0.5],["trn",0,0,false,false,1.0],["w",1.0],["bg","flatlands_dusk",0,0.5],["w",0.5],["trn",1,0,false,false,1.0],["w",1.0],["show","avg1_140","b","003",0.5,null,null,0,null,0.0],["ctl","avg1_140","b",null,null,null,null,null,1.0,null,"Linear",0.5],["w",0.5],["mrt",1,"z","002","attention",null],["say","avg3_100","So that's why you made all those stage machineries, too?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_140","b","002","idea",null,null,null,null,"diantou2","Linear",0.5],["say","avg1_140","Exactly. When the troupe director came to me, she said she wanted to recreate Dorothea's adventure perfectly onstage, and I knew right away it would be fun to work on.",0,""],["w",0.5],["ctl","avg1_140","b","006","shy",null,null,null,null,"niunie1","Linear",0.5],["say","avg1_140","And they even complimented Rabbit Pie's tea-making skills~ Once I realized the director actually had good taste, I figured I should put some real effort into the commission.",0,""],["w",0.5],["bg","mood_2",0,0.5],["ctl","avg1_140","b","009","star",null,null,null,null,"jushou2","Linear",0.5],["say","avg1_140","The more we talked, the more we hit it off. In the end, I did the whole thing for free. And I even threw in that little mechanical dog as a bonus gift.",0,""],["w",0.5],["ctl","avg1_140","b",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_140","Totty is like family to Dorothea, after all. It can't just be some random prop. I had to create something really worthy of that role.",0,""],["w",0.5],["bgm",""],["mrt",1,"z","025","symbol",null],["say","avg3_100","You did it for free... And even threw in a bonus freebie? If Bloc ever finds out, she's going to lecture you for hours again...",1,""],["mrt",3,"z",null,null,null],["w",0.5],["bg","mood_4",0,0.5],["ctl","avg1_140","b","013","awkward",null,null,null,null,null,"Linear",0.5],["say","avg1_140","Oh that, she already knows. That's why she bombarded me with messages. And then I blocked her.",0,""],["w",0.5],["se","se_095"],["mrt",1,"z","010",null,null],["say","avg3_100","O-Oh, I see... It all makes sense now...",1,""],["mrt",3,"z",null,null,null],["w",0.5],["bgm",""],["bg","flatlands_dusk",0,0.5],["ctl","avg1_140","b","006","music",null,null,null,null,null,"Linear",0.5],["say","avg1_140","So, what do you think? My stage inventions worked pretty well, didn't they?",0,""],["w",0.5],["mrt",1,"z","011","exclamation",null],["say","avg3_100","They were incredible. It really felt like I was going on an adventure with Dorothea.",1,""],["mrt",0,"z","002",null,null],["say","avg3_100","Of course, the actors were fantastic, too, but without your inventions, there's no way the show could have felt that magical.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_140","b","012","shy",null,null,null,null,"lengzhan2","Linear",0.5],["say","avg1_140","Hehehe~♪ You're making me blush.",0,""],["w",0.5],["ctl","avg1_140","b","003","speechless",null,null,null,null,null,"Linear",0.5],["w",0.5],["say","avg1_140","That's what inventing is for—to make people happy. Sure, every now and then somebody complains and tells me not to add all those extra bells and whistles... But then, why did they come to me in the first place?",0,""],["w",0.5],["ctl","avg1_140","b","002",null,null,null,null,null,"xuanyun","Linear",0.5],["say","avg1_140","On the other hand, if someone really appreciates what makes my inventions special, I'm more than happy to give them one as a gift♪",0,""],["w",0.5],["mrt",1,"z","020","attention",null],["say","avg3_100","No wonder you gave the Long-Eared Lookout Pie to that kid today.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_029"],["ctl","avg1_140","b","010",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg1_140","Because I could tell he genuinely liked it~",0,""],["w",0.5],["ctl","avg1_140","b","004","shy",null,null,null,null,"niunie1","Linear",0.3],["say","avg1_140","And... Boss, thank you so much...",0,""],["ctl","avg1_140","b","014","sweaty",null,null,null,null,null,"Linear",0.5],["say","avg1_140","I'm still a wanted fugitive, so I was hesitating to attend the performance in person. At most, I could look at the photos the director sent me.",0,""],["w",0.5],["ctl","avg1_140","b","003",null,null,null,null,null,null,"Linear",0.5],["say","avg1_140","But today...==W== Because of you, I got to see this play with my own eyes. So thank you.",0,""],["w",0.5],["bg","mood_1",0,0.3],["ctl","avg1_140","b","006","flower",null,-0.35,1.5,null,null,"Linear",0.3],["goon"],["w",0.5],["mrt",1,"z","013","happy",null],["say","avg3_100","You're welcome. I just happened to stumble into the right idea. I'm glad to see you feeling better.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_140","b","003","exclamation",null,null,null,null,"xuanyun","Linear",0.5],["say","avg1_140","Hehehe, exactly! Taking a break really helped. I feel so much lighter now, and all kinds of fun new ideas are already starting to come to me!",0,""],["w",1.0],["bg","flatlands_dusk",0,0.5],["bgm",""],["se","se_099"],["ctl","avg1_140","b","004",null,null,0.0,1.0,null,null,"Linear",0.3],["w",0.3],["say",