["w",0.3],["say","avg1_147","Since you've already been announced as my producer in front of so many people, why not make it official?",0,""],["ctl","avg1_147","a","006",null,null,null,null,null,null,"Linear",1.0],["w",0.4],["mrt",1,"z","025","shock",null],["say","avg3_100","Never mind that. What exactly do you mean by \"producer\" anyway?",1,""],["ctl","avg1_147","a","005","attention",null,null,null,null,"diantou2","Linear",0.5],["w",0.5],["say","avg1_147","I've heard other musicians say that when they're low on inspiration, a little guidance from a producer can work wonders and turn things around...",0,""],["w",0.4],["mrt",1,"z","002","speechless",null],["say","avg3_100","It's true that I have many talents...==W== But music is not one of them.",1,""],["mrt",0,"z","010","awkward",null],["goon"],["se","se_125"],["ctl","avg1_147","a","008",null,null,null,null,null,"buman","Linear",1.0],["say","avg3_100","If I mess up in that capacity, it's not just my reputation on the line—==B==it'll drag the Boss Accord down, too.",1,""],["mrt",0,"z","004","star",null],["say","avg3_100","As the Boss, I can't afford to show any weakness!",1,""],["ctl","avg1_147","a","008","speechless",null,null,null,null,null,"Linear",1.0],["w",1.0],["ctl","avg1_147","a","002",null,null,null,null,null,null,"Linear",1.0],["say","avg1_147","I don't quite get it, but the way you said that just now had a nice rhythm to it!",0,""],["ctl","avg1_147","a","006","happy",null,null,null,null,"huanxin","Linear",1.0],["say","avg1_147","I knew it! Getting you to be my producer was the right call!",0,""],["w",0.5],["mrt",2,"y","007","shock",null],["say","avg3_100","...",2,""],["w",0.5],["ctl","avg1_147","a","004",null,null,null,null,null,null,"Linear",1.0],["say","avg1_147","You came all the way here to listen to my performance for that reason. Right, Boss?",0,""],["w",0.4],["mrt",1,"z","010","sweaty",null],["say","avg3_100","I was simply drawn in by your music, but your performance really was impressive.",1,""],["mrt",0,"z","012","speechless",null],["say","avg3_100","It might bruise your ego a bit, but I must admit, it really was pure chance.",1,""],["mrt",0,"z","002",null,null],["say","avg3_100","So, you're looking for a producer because you're lacking inspiration, right?",1,""],["ctl","avg1_147","a","005","shock",null,null,null,null,"jushou","Linear",1.0],["w",1.0],["ctl","avg1_147","a",null,null,null,null,null,null,"lengzhan","Linear",1.0],["say","avg1_147","Yeah...==B== Yeah! ==W==Inspiration!",0,""],["ctl","avg1_147","a","011",null,null,null,null,null,null,"Linear",0.3],["w",0.3],["goon"],["bgm",""],["se","se_062"],["ctl","avg1_147","a",null,null,null,-0.05,1.05,null,"diantou","OutSine",0.4],["w",0.4],["ctl","avg1_147","a","008","vexation",null,null,null,null,null,"Linear",1.0],["bg","mood_4",0,1.0],["say","avg1_147","… The past few days, I tried playing my bass ...==B== to the ocean, the mountains, and the Monoliths, but nothing came to me.",0,""],["film",0],["bg","sky_night_a",0,1.0],["cbg",0,null,100.0,1.05,"Linear",0.0,null,null,null],["cbg",0,200.0,null,1.25,"OutSine",10.0,null,null,null],["ctl","avg1_147","a","003",null,null,null,null,null,null,"Linear",0.5],["w",0.5],["say","avg1_147","Before, just a few deep breaths would've been enough for me to hear their call...==B== The sounds they make.",0,""],["ctl","avg1_147","a","010","flurry",null,null,null,null,"lengzhan","Linear",0.5],["w",0.5],["bgm","m31"],["say","avg1_147","What should I do if ...==B== the Monoliths stop responding to me...?",0,""],["film",1],["bg","flavio_city_street",0,0.6],["w",0.6],["say","0","Caramel is an excellent musician and a unique Trekker who uses music as her weapon.",0,""],["ctl","avg1_147","a","009",null,null,null,null,null,"niunie","Linear",0.5],["w",0.5],["mrt",1,"y","020","think",null],["say","avg3_100","I've noticed before that she seems to be very in tune with the subtle, distant strange sounds coming from inside the Monoliths.",2,""],["trn",0,0,false,false,1.0],["w",1.0],["say","0","Those sounds might be a part of the truth about the Monoliths—it's just that people, myself included, don't really understand them.",0,""],["trn",1,0,false,false,1.0],["w",1.0],["mrt",1,"y","020","think",null],["say","avg3_100","Anyway, Caramel's talent and curiosity are truly rare and valuable qualities.",2,""],["mrt",0,"y","004",null,null],["say","avg3_100","… Besides, supporting a talented young artist's work could count as one of the Boss's achievements, too!",1,""],["mrt",0,"z","002",null,null],["say","avg3_100","I see, it's indeed a serious problem.",1,""],["mrt",0,"z","014","idea",null],["say","avg3_100","Although I don't know much about music, when it comes to finding inspiration, I can definitely help you come up with some ideas.",1,""],["ctl","avg1_147","a","010","exclamation",null,null,null,null,"diantou2","Linear",1.0],["w",1.0],["say","avg1_147","Awesome...==W== Then let's—",0,""],["ctl","avg1_147","a","004","star",null,null,null,null,null,"OutSine",0.3],["w",0.3],["goon"],["se","se_069"],["clear",0,0,1],["ctl","avg1_147","a",null,null,null,null,null,null,"ChanDou1","Linear",1.0],["w",1.0],["ctl","avg1_147","a","009","attention",null,null,1.0,null,"diantou2","OutSine",0.6],["w",0.6],["ctl","avg1_147","a",null,"shy",null,null,null,null,"niunie1","Linear",0.5],["w",0.5],["say","0","An awkward note interrupts her voice, which has been growing weaker from hunger.",0,""],["ctl","avg1_147","a","008","vexation",null,null,null,null,null,"Linear",1.0],["w",1.3],["bgm",""],["se","se_305"],["mrt",1,"z","011",null,null],["say","avg3_100","… Maybe we should sit down to eat first?",1,""],["w",0.3],["ctl","avg1_147","a","004","music",null,null,null,null,"huanxin","Linear",1.0],["w",1.0],["end"]]}