.5],["say","avg1_155","But there's one thing that really stuck with me.",0,""],["w",0.5],["mrt",1,"z","002",null,null],["say","avg3_100","What is it?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_155","b","003","speechless",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_155","The sailors in Carlo Town have a tradition—they always hug their families before setting out to sea. One time, I tried copying them and gave Granny a hug...",0,""],["ctl","avg1_155","b","011","shock",null,null,null,1.0,"chijing","OutSine",0.5],["say","avg1_155","I didn't see it coming, but she suddenly started crying... She almost never showed her emotions.",0,""],["ctl","avg1_155","b","007","happy",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_155","It really startled me... But then she hugged me back, tight. That made me so happy♪",0,""],["w",0.5],["mrt",1,"y","020","think",null],["say","avg3_100","No wonder... When she saw those two passengers hugging on the boat just now, she looks...",2,""],["mrt",3,"y",null,null,null],["w",0.5],["bgm",""],["se","se_169"],["trn",0,1,true,false,0.5],["w",0.5],["bg","deck_daylight",0,0.0],["fx",0,"fx_avg_reminiscence_loop",0,2],["show","avg2_983","b","008",0.6,null,null,0,null,1.0],["show","avg2_984","b","008",0.45,null,-1.0,0,null,1.0],["trn",1,1,false,false,1.0],["w",1.0],["ctl","avg2_983","b",null,null,null,null,null,1.0,"chijing","OutSine",0.5],["w",0.5],["ctl","avg2_984","b",null,null,null,null,null,1.0,"jushou2","OutSine",0.5],["w",0.5],["clear",1,0.5,0],["stg",0,60.0,null,null,"Linear",0.5,null,null,null],["w",0.5],["show","avg1_155","b","003",0.4,null,null,0,null,0.0],["ctl","avg1_155","b",null,"happy",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_155","This is really nice... It brings back memories of the old days...",0,""],["w",0.5],["se","se_169"],["trn",0,1,true,false,0.5],["w",0.5],["bg","beach_daylight",0,0.0],["fx",0,"fx_avg_reminiscence_loop",1,2],["trn",1,1,false,false,1.0],["w",1.0],["mrt",1,"y","023","love",nu