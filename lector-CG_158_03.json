"Linear",0.0,null,null,null],["trn",1,0,false,false,1.0],["bgm","m80"],["say","avg1_158","Tyrant, you're too slow!!!==W== I've been waiting for you for ages; I thought you were going to ditch me...==W== I almost fell asleep!",11,""],["say","avg1_158","Don't tease me at weird times—==W==if you're gonna open it, just open it already, okay?",11,""],["choice",["Seriously, just looking at this box gives me a bad feeling..."],[[]]],["choice",["Uh, why are you in the box?"],[[]]],["say","avg1_158","To surprise you, of course!==W== When you opened it,==W== and \"Bam,\" I just pop out. Wouldn't it be funny?",11,""],["say","avg1_158","Plus,==W== according to my research,==W== the \"Top 5 lines for girls to say\"==W== includes \"The present==W== is... ME==W==~\"",11,""],["say","avg1_158","So that's why...==W== Huh?==W== Wait, Oh no…",11,""],["choice",["What's wrong?"],[[]]],["say","avg1_158","Uhh,==W== I think I stayed in the box in this position for too long...==W== My feet are numb now...==W== I can't get out.",11,""],["choice",["Hmm. Are you alright?"],[[]]],["say","avg1_158","Well, I can't put any strength in them—==W==and they feel tingly.==W== But I'm sure it'll be fine if I just rest for a bit.",11,""],["say","avg1_158","Uh...==W== Eh?==W== What's wrong, Tyrant...==W== Why are you grinning like that?",11,""],["choice",["Poke!"],[[]]],["say","avg1_158","Gyaaaahhh! ==W==W-Wait, Tyrant!==W== What on earth are you doing?!",11,""],["choice",["Sorry, Laru. I can't pass up an opportunity like this."],[[]]],["say","avg1_158","Waaahahaha!==W== Hey!==W== No poking!==W== My body's not some kind of toy!?",11,""],["choice",["Sorry, Laru, I can't help..."],[[]]],["choice",["Poke again!"],[[]]],["say","avg1_158","No no no, what do you mean you can't help?!==W== I said I'm not your toy—",11,""],["say","avg1_158","Gyahahahahaha!==W== S-Stop,==W== that tickles!==W== Stooop!!",11,""],["say","avg1_158","Hah, hah...==W== Alright,==W== have you had enough fun?==W== If you have,==W== isn't it about time you got me out of this box?",11,""],["choice",["You can't get out by yourself?"],[[]]],["say","avg1_158","If I could, I would have by now!==W== So...==W== Help me out?",11,""],["choice",["Hm? What?"],[[]]],["say","avg1_158","Just...==W== Carry me out.==W== You've messed with my body for so long,==W== you owe me at least this much compensation alright?",11,""],["w",0.5],["bgm",""],["trn",0,0,true,true,2.0],["w",2.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["bg","city_room_inside_xmas",0,1.0],["w",1.0],["trn",1,0,false,false,1.0],["w",1.0],["bgm","m56"],["show","avg1_158","a","004",null,null,null,0,null,0.0],["ctl","avg1_158","a",null,"music",null,null,null,1.0,"2TiaoYue","Linear",0.5],["w",0.5],["say","avg1_158","Phew... Safe at last. That was way too close.",0,""],["w",0.5],["mrt",1,"z","014",null,null],["say","avg3_100","Honestly... Next time, think about what might happen if your plan goes wrong.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_158","a","013","flurry",null,null,null,null,"niunie","Linear",0.5],["say","avg1_158","I'll reflect on it...==W== Ugh, why did Bastelina have to tie it so tight?",0,""],["w",0.75],["ctl","avg1_158","a","005","resentful",null,null,null,null,"buman","Linear",0.5],["goon"],["w",0.5],["mrt",1,"z","014",null,null],["say","avg3_100","Why did you ask her to do it?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_158","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_158","She happened to stop by my place.",0,""],["w",0.5],["mrt",1,"z","012","question",null],["say","avg3_100","She came on her own?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_158","a","003",null,null,null,null,null,null,"OutSine",0.5],["say","avg1_158","Yeah, with a pile of documents too.==W== See? They're right there.",0,""],["w",0.5],["ctl","avg1_158","a",null,"attention",null,null,null,null,"youchupeng","Linear",0.5],["goon"],["w",0.5],["ctl","avg1_158","a",null,null,null,null,null,0.0,null,"L