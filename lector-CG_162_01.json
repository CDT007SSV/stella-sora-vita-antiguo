"say","avg1_162","... Should I take that as an insult?",0,""],["w",0.5],["mrt",1,"z","013","flurry","huanxin"],["say","avg3_100","Not at all. It's a compliment.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_162","a","016","vexation",null,0.0,1.0,null,"niunie1","OutSine",0.6],["stg",0,0.0,0.0,1.1,"OutSine",0.6,null,null,null],["say","avg1_162","A compliment...? I hardly think that is something to be proud of.",0,""],["ctl","avg1_162","a","005","question",null,null,null,null,"diantou","OutSine",0.4],["say","avg1_162","And what was that Dark Knight nonsense about?",0,""],["w",0.4],["mrt",1,"z","020","attention","jushou"],["say","avg3_100","Having aliases makes things easier. See? I called myself Boss too, didn't I?",1,""],["mrt",0,"z","004","happy","diantou"],["say","avg3_100","If someone can commit crimes under the guise of the Fallen Saintess, I don't see the harm in us using fake names to do some good.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_162","a","014","speechless",0.52,null,null,null,"manbu2","OutSine",0.5],["say","avg1_162","Playing bandits... What a despicable tactic. How can you be so resolute? Why was there zero hesitation?",0,""],["ctl","avg1_162","a",null,null,null,null,null,null,null,"Linear",0.0],["w",0.7],["mrt",1,"z","020",null,null],["say","avg3_100","Hmm... Because it was a choice I won't regret.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_162","a","010","question",0.5,null,null,null,null,"OutBack",0.5],["stg",0,0.0,0.0,1.16,"OutSine",0.5,null,null,null],["say","avg1_162","Regret?",0,""],["w",0.5],["mrt",1,"z","009",null,null],["say","avg3_100","Yeah... If we'd let those slavers go back there, I know I would have regretted it.",1,""],["stg",0,0.0,0.0,1.19,"OutSine",0.8,null,null,null],["se","se_077"],["mrt",0,"z","018",null,"diantou"],["say","avg3_100","So I just trusted my heart and took action. That's all there is to it.",1,""],["mrt",0,"z","017",null,null],["say","avg3_100","Even if you say it's despicable, I will always make a choice I won't regret. Every single time.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_162","a","017","sigh",null,null,null,null,"niunie","OutSine",0.5],["say","avg1_162","... So you really thought it all through.",0,""],["w",0.5],["stg",0,0.0,0.0,1.16,"OutSine",0.5,null,null,"Xiao"],["mrt",1,"z","007","shock","buman"],["say","avg3_100","Huh? What kind of person did you think I was?!",1,""],["mrt",3,"z",null,null,null],["w",0.3],["ctl","avg1_162","a","006","happy",null,null,null,null,"daintou","OutSine",0.6],["say","avg1_162","When someone suddenly says we'll become bandits, any normal person would assume they've lost their mind.",0,""],["w",0.5],["ctl","avg1_162","a","020",null,0.5,-0.1,1.12,null,"JuGong","OutSine",0.5],["stg",0,0.0,0.0,1.25,"OutSine",0.9,null,null,null],["say","avg1_162","But...==W== You helped me. Without you, I would have just stood there, unable to do a thing. And I know I would have regretted it, too...",0,""],["w",0.95],["goon"],["w",0.5],["mrt",1,"z","015",null,null],["say","avg3_100","Alina...",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_162","a","017","awkward",0.45,null,null,null,"diantou","OutSine",0.6],["stg",0,-30.0,0.0,1.16,"OutSine",0.6,null,null,null],["say","avg1_162","That being said, crossing the line ends today! For the sake of both our reputations, we can never speak of what happened here.",0,""],["w",0.5],["se","se_062"],["ctl","avg1_162","a","020",null,0.5,-0.28,1.35,null,null,"OutSine",0.7],["stg",0,0.0,40.0,1.24,"OutSine",0.85,null,null,null],["w",1.05],["ctl","avg1_162","a","020","shy",null,null,null,null,"niunie","OutSine",0.6],["say","avg1_162","Which means this stays between you and me.==W== Do we have an agreement?",0,""],["w",1.5],["ctl","avg1_162","a","016","attention",null,null,null,null,"jushou0","Linear",0.5],["goon"],["w",0.5],["mrt",1,"z","015",null,null],["say","avg3_100","A secret between the two of us...==W== Ah, I understand.",1,""],["w",0.5],["mrt",0,