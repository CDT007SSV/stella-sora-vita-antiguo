,"015",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_119","Although, using the fragrance of edible flowers to mimic inedible ones is a clever trick used a lot in patisserie.",0,""],["w",0.5],["mrt",2,"z","002",null,null],["say","avg3_100","Nanoha, you sure know a lot about pastries...==W== You must really love them. Speaking of sunflowers...",1,""],["w",0.5],["mrt",0,"z","012",null,null],["goon"],["mrt",4,"z","012",null,null],["w",0.5],["show","avg3_143","a","002",0.1,null,null,0,null,0.0],["se","se_062"],["stg",0,null,null,1.0,"OutSine",0.35,null,null,null],["cbg",0,null,null,1.1,"OutSine",0.35,null,null,null],["ctl","avg3_143","a",null,null,0.3,null,null,1.0,"diantou","OutSine",0.35],["ctl","avg1_119","a",null,null,0.7,null,null,null,null,"OutSine",0.35],["w",0.35],["ctl","avg3_143","a",null,"attention",null,null,null,null,"JuGong","Linear",0.5],["say","avg3_874","Excuse me. Here's your tea refill. Is there anything else you'd like?",0,""],["w",0.5],["mrt",2,"z","010","sigh",null],["say","avg3_100","Nah, we are good...==W== It's so delicious, and I've had way too much already.",1,""],["w",0.5],["goon"],["mrt",4,"z","010",null,null],["w",0.5],["ctl","avg3_143","a",null,"star",null,null,null,null,"JuGong","Linear",0.5],["say","avg3_874","Thank you for coming!",0,""],["w",0.5],["stg",0,null,null,1.1,"OutSine",0.5,null,null,null],["cbg",0,null,null,1.2,"Linear",0.5,null,null,null],["ctl","avg3_143","a",null,null,0.1,null,null,0.0,null,"OutSine",0.5],["hide","avg3_143",0.5],["ctl","avg1_119","a",null,null,0.5,null,null,null,null,"OutSine",0.5],["w",0.5],["ctl","avg1_119","a","015","question",null,null,null,null,"ChanDou","Linear",0.5],["say","avg1_119","You really don't want more?",0,""],["w",0.5],["mrt",2,"z","021","vexation","ChanDou"],["say","avg3_100","It's not just being polite...==W== I'm totally stuffed... I even feel a bit bloated.",1,""],["w",0.5],["mrt",0,"z","010","sigh",null],["goon"],["mrt",4,"z","010",null,null],["w",0.5],["ctl","avg1_119","a","003",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg1_119","Then let's walk a bit on the way back. Should help with digestion.",0,""],["w",0.5],["mrt",2,"z","002","question",null],["say","avg3_100","By the way, Nanoha, do you mind taking a detour? There's a place I want to take you to.",1,""],["mrt",4,"z","002",null,null],["w",0.5],["bgm",""],["ctl","avg1_119","a","002","happy",null,null,null,null,"daintou","Linear",0.5],["say","avg1_119","Of course. I am your maid. Anywhere you want to go, I'll be right by your side.",0,""],["w",0.5],["se","se_093"],["trn",0,0,true,true,0.75],["w",0.75],["bg","field_daylight",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,300.0,-360.0,1.5,"Linear",0.0,null,null,null],["w",0.5],["trn",1,0,false,false,0.75],["w",1.25],["mrt",2,"z","002","attention",null],["say","avg3_100","It's just ahead. When I was having the cake, I suddenly thought of this place.",1,""],["mrt",4,"z","002",null,null],["w",0.5],["se","se_036"],["cbg",0,-50.0,null,null,"Linear",1.75,null,null,null],["w",0.5],["say","avg1_119","The endless wheat fields,==W== the sound of the stalks in the wind, the smell of fresh grass. Hard to believe something this beautiful is so close by.",0,""],["w",0.5],["se","se_036_stop"],["bgm","m16"],["goon"],["w",0.5],["cbg",0,-300.0,-360.0,1.5,"OutSine",0.3,null,null,null],["mrt",2,"z","014","attention",null],["say","avg3_100","But most importantly, over there! Look beyond that hill!",1,""],["mrt",4,"z","014",null,null],["w",0.5],["show","avg1_119","a","002",0.5,null,null,0,null,0.0],["ctl","avg1_119","a",null,null,null,null,null,1.0,null,"Linear",0.5],["w",0.5],["say","avg1_119","Is that...==W== A sunflower field?",0,""],["w",0.5],["ctl","avg1_119","a","015","question",null,null,null,null,"ChanDou","Linear",0.5],["goon"],["w",0.5],["mrt",2,"z","013","music",null],["say","avg3_100","Isn’t it beautiful? It goes perfectly with the sunflower cake we just ate, both carrying that similar sunny scent.",1,""],["mrt",4,"z","013",null,null],["w",0.5],["ctl","avg1_119","a","003",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg1_119","Yeah, it’s really pretty… so pretty it almost makes you want to disappear into it.",0,""],["se","se_101"],["ctl","avg1_119","a","005",null,0.5,-0.1,1.1,null,null,"OutSine",0.35],["say","avg1_119","Tell me, Boss—Do you like sunflowers?",0,""],["w",0.5],["mrt",2,"z","003",null,null],["say","avg3_100","Well… I don’t have memories, so I’m not sure if I liked it before…==W== but I definitely do now. Why did you ask?",1,""],["w",0.5],["mrt",0,"z","012","question",null],["goon"],["mrt",4,"z","012",null,null],["w",0.5],["ctl","avg1_119","a","009","sigh",null,null,null,null,"chijing","Linear",0.5],["say","avg1_119","It's just that I suddenly remembered some things from long ago...",0,""],["ctl","avg1_119","a","012",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg1_119","When I was little, I planted a sunflower field with a senior colleague from Goodwind Homecare.",0,""],["w",0.5],["mrt",2,"z","013","happy",null],["say","avg3_100","A sunflower field you planted as a child... I kind of want to see it. Is it still there?",1,""],["mrt",4,"z","013",null,null],["bgm",""],["w",0.5],["ctl","avg1_119","a","009",null,null,null,null,null,null,"Linear",0.5],["say","avg1_119","It's gone ...==W== or rather, it's become a place that never existed.",0,""],["w",0.5],["ctl","avg1_119","a","014","vexation",null,null,null,null,"ChanDou","Linear",0.5],["goon"],["w",0.5],["mrt",2,"z","015",null,null],["say","avg3_100","A place that never existed...==W== What do you mean?",1,""],["w",0.5],["mrt",0,"z","012","question","ChanDou"],["goon"],["mrt",4,"z","012",null,null],["w",0.5],["bgm","m57"],["se","se_101"],["ctl","avg1_119","a","010",null,null,-0.2,1.2,null,null,"OutSine",0.3],["say","avg1_119","Because of a mission, I was separated from that senior and left the sunflower field. When I returned and asked people about it, they were certain that there had never been one...",0,""],["ctl","avg1_119","a","009",null,null,null,null,null,"chijing","Linear",0.5],["say","avg1_119","But I remember it so clearly...==W== Was I wrong? The sunflower field and my senior seem to have vanished from this world.",0,""],["w",0.5],["ctl","avg1_119","a","013","sigh",null,null,null,null,"JuGong","Linear",0.5],["goon"],["w",0.5],["mrt",2,"z","012",null,"ChanDou"],["say","avg3_100","So that's what happened...==W== Could it be that those people you asked... They sacrificed those memories when they made a wish at the Monolith?",1,""],["w",0.5],["mrt",0,"z","020","question",null],["goon"],["mrt",4,"z","020",null,null],["w",0.5],["ctl","avg1_119","a","004",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg1_119","Possibly... Boss, I'm thinking...",0,""],["ctl","avg1_119","a","015",null,null,null,null,null,"zuochupeng","Linear",0.5],["say","avg1_119","If a sunflower field disappears from the world, forgotten, and one day even I, the last person who have memories of it, no longer remember—then did it ever truly exist?",0,""],["ctl","avg1_119","a","009","vexation",null,null,null,null,null,"Linear",0.5],["say","avg1_119","Maybe there are countless sunflower fields like that in this world. They are forgotten and erased. In the end, they leave no trace at all.",0,""],["w",0.5],["mrt",2,"z","003",null,null],["say","avg3_100","… It’s something we can’t do anything about, I suppose.",1,""],["mrt",4,"z","003",null,null],["bgm",""],["w",0.5],["se","se_048"],["ctl","avg1_119","a","002",null,null,null,null,null,null,"Linear",0.5],["say","avg3_999","Ah, Master! What a coincidence.",0,""],["show","avg3_202","a","002",1.0,null,null,0,null,0.0],["se","se_101"],["cbg",0,null,null,1.4,"OutSine",0.5,null,null,null],["ctl","avg1_119","a",null,null,0.3,0.0,1.0,null,null,"OutSine",0.5],["ctl","avg3_202","a",null,null,0.7,null,null,1.0,"JuGong","OutSine",0.5],["w",0.5],["ctl","avg3_202","a","010","star",null,null,null,null,"huanxin2","Linear",0.5],["say","av