,0,0],["film",0],["bg","field_town_daylight",0,0.0],["show","avg3_167","a","002",null,null,null,0,null,0.0],["trn",1,0,false,false,1.0],["w",1.0],["ctl","avg3_167","a",null,null,null,null,null,1.0,null,"OutSine",1.0],["say","avg1_149","There was another child once, with the same condition.",3,""],["say","avg1_149","Back when I was an apprentice, I met a girl here, all skin and bones.",3,""],["se","se_059"],["ctl","avg3_167","a",null,null,null,null,null,null,"jinzhang","Linear",1.0],["say","avg1_149","She was born with a severe illness, and her parents abandoned her here.",3,""],["se","se_034"],["ctl","avg3_167","a",null,null,null,-0.05,null,null,null,"OutSine",1.0],["stg",0,null,-50.0,1.3,"OutSine",1.0,null,null,null],["w",0.8],["bgm",""],["se","se_034_stop"],["se","se_074"],["ctl","avg3_167","a",null,null,null,0.0,null,null,"jushou","OutSine",0.3],["w",0.8],["se","se_055"],["ctl","avg3_167","a",null,"vexation",null,null,null,null,null,"Linear",1.0],["say","avg1_149","But her case was far worse than mine. She couldn't wield magic at all.",3,""],["trn",0,0,false,false,1],["w",1],["hide","avg3_167"],["fx",0,"fx_avg_reminiscence_loop",1,0],["bg","forest_night_1",0,0.0],["ctl","avg1_149","a","004",null,null,null,null,1.0,null,"Linear",0.0],["film",1],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["trn",1,0,false,false,1.0],["w",1.0],["bgm",""],["bgm",""],["mrt",0,"z","015","shock",null],["say","avg3_100","Like me?",1,""],["ctl","avg1_149","a",null,"speechless",null,null,null,null,null,"Linear",1.0],["w",1.0],["ctl","avg1_149","a","006",null,null,null,null,null,null,"Linear",1.0],["say","avg1_149","Not quite. Just being near magic made her sick. They had no choice but to send her to the Sanctuary of Grace, outside the city.",0,""],["say","avg1_149","We became friends. We didn't have a single thing in common—food, hobbies, you name it—but our shared condition connected us.",0,""],["ctl","avg1_149","a",null,"sigh",null,null,null,null,"diantou","Linear",0.5],["w",0.5],["say","avg1_149","But... I suppose I was just more suited for combat. I made full Arbiter fast enough. She, on the other hand...",0,""],["say","avg1_149","She asked me once==W== if the Gods had forsaken her. I could only tell her the God of Grace abandons no one.",0,""],["ctl","avg1_149","a","015",null,null,null,null,null,null,"Linear",0.3],["w",0.3],["goon"],["w",0.4],["mrt",0,"z","009","sigh",null],["say","avg3_100","It must've been hard on you both.",1,""],["bgm",""],["ctl","avg1_149","a","006",null,null,null,null,null,null,"Linear",1.0],["w",1.0],["say","avg1_149","I didn't know what else to do. And duty called.",0,""],["ctl","avg1_149","a","016",null,null,null,null,null,null,"Linear",0.5],["w",0.5],["say","avg1_149","I was on a mission across the continent when the news of her passing reached me.",0,""],["say","avg1_149","There was a meltdown at a nearby Monolith. To protect everyone, she unleashed this incredible, blinding spell and neutralized the threat.",0,""],["w",0.4],["mrt",2,"z","025","exclamation",null],["say","avg3_100","Wait. Didn't you say she couldn't use magic?",1,""],["ctl","avg1_149","a",null,null,null,null,null,0.0,null,"OutSine",1.0],["say","avg1_149","That's when I learned the truth. It wasn't that she couldn't wield magic... She was fatally allergic to it.",0,""],["se","se_169"],["trn",0,0,true,true,1.0],["w",1.0],["se","se_283"],["bg","bossroom_inside",0,0.0],["film",0],["show","avg3_167","a","002",null,null,1.1,0,null,0.0],["cbg",0,null,200.0,1.2,"Linear",0.0,null,null,null],["fx",0,"fx_avg_reminiscence_loop",0,0],["fx",0,"fx_avg_dust_2_a",0,0],["trn",1,0,false,false,1.0],["w",1.0],["ctl","avg3_167","a",null,null,null,null,null,1.0,null,"OutSine",1.0],["w",1.0],["ctl","avg3_167","a",null,null,null,null,null,null,"lengzhan","Linear",1.0],["w",1.0],["se","se_110"],["ctl","avg3_167","a",null,null,null,-0.3,null,0.0,null,"OutSine",1.0],["say","avg1_149","That spell she cast to save everyone... It was the first and last time she ever touched magic.",3,""],["trn",0,0,true,true,1.0],["w",1.0],["fx",0,"fx_avg_reminiscence_loop",1,0],["fx",0,"fx_avg_dust_2_a",1,0],["bg","forest_night_1",0,0.5],["w",0.5],["film",1],["trn",1,0,false,false,1.0],["w",1.0],["bgm","m5"],["w",0.5],["mrt",1,"z","005",null,null],["say","avg3_100","She sacrificed herself...",1,""],["show","avg1_149","a","002",null,null,null,0,null,0.0],["ctl","avg1_149","a","006",null,null,-0.3,1.35,null,null,"OutSine",0.6],["w",0.6],["se","se_077"],["ctl","avg1_149","a",null,null,null,null,null,1.0,null,"OutSine",0.6],["w",0.6],["say","avg1_149","Great ==SEX12==, do you think the God of Grace is actually real?",0,""],["w",0.4],["mrt",0,"z","010","sweaty",null],["say","avg3_100","Whoa, hey now. You're a Dusk Arbiter. That's a dangerous question to ask.",1,""],["ctl","avg1_149","a","003",null,null,null,null,null,null,"Linear",1.0],["w",1.0],["say","avg1_149","Heh... You're right.==W== Fate can be so cruel. If this isn't some sick joke by the God of Grace, what else could it be?",0,""],["ctl","avg1_149","a","018","happy",null,null,null,null,null,"Linear",1.0],["w",0.4],["goon"],["se","se_055"],["mrt",0,"z","012",null,null],["say","avg3_100","Rather than getting caught up in that, I prefer to believe in \"paradise.\"",1,""],["mrt",0,"z","009",null,null],["say","avg3_100","A final home for every soul that fought to the very end, no matter their faith or their path in life.",1,""],["mrt",0,"z","002",null,null],["say","avg3_100","Maybe someday, we can ask your friend in person what was truly on her mind at her last moment.",1,""],["w",0.4],["ctl","avg1_149","a","006","shock",null,null,null,null,null,"Linear",1.0],["w",1.0],["say","avg1_149","Great ==SEX12==...",0,""],["ctl","avg1_149","a","005","happy",null,null,null,null,null,"Linear",1.0],["say","avg1_149","Pfft... Hahahaha~",0,""],["w",0.4],["mrt",0,"z","007",null,null],["say","avg3_100","W-What's so funny? Was it something I said?",1,""],["ctl","avg1_149","a","002",null,null,null,null,null,"diantou2","Linear",1.0],["w",1.0],["say","avg1_149","Ahem... Forgive me~ I wasn't laughing at you. Actually, I'm touched you took my question so seriously. I just ... wasn't expecting it.",0,""],["say","avg1_149","Paradise, huh... What a romantic thought.",0,""],["se","se_077"],["bgm",""],["ctl","avg1_149","a","003",null,null,null,null,null,"diantou","Linear",0.5],["w",0.5],["say","avg1_149","Thanks to you, my heart is finally still.",0,""],["fx",0,"fx_avg_flash_light",0,0],["ctl","avg1_149","a","009",null,null,null,null,null,null,"Linear",1.0],["w",1.0],["trn",0,0,true,true,1.0],["w",1.0],["mrt",2,"y","025","exclamation",null],["say","avg3_100","Huh...!? This feeling... I know that murderous aura!",2,""],["bg","BG_Black",0,0.0],["trn",1,0,true,true,1.0],["w",1.0],["bgm","m11"],["bg","4036_B",5,1.0],["w",1.0],["cbg",5,null,-100.0,1.6,"Linear",0.0,null,null,null],["stage",5,0,2],["cbg",5,null,-130.0,1.65,"OutSine",0.5,null,null,null],["say","avg1_149","Just as I thought. Of all the souls I've met, yours is the strongest, the most unique ... and the one that intrigues me most.",9,""],["se","se_050"],["say","avg1_149","Yes... I simply must make you mine, no matter what it takes~",9,""],["stage",5,1,3],["w",0.2],["bg","4036_B",0,0.3],["w",0.3],["bg","4036_B",0,0.3],["cbg",0,null,null,1.1,"Linear",0.0,null,null,null],["say","avg1_149","So ... how about becoming my Great ==SEX12==, and mine alone? I'll make it well worth your while~",9,""],["w",0.3],["mrt",1,"z","010","sweaty",null],["say","avg3_100","I'm happy you're feeling better, but I'm gonna take a hard pass on that...!",1,""],["bg","4036_B",0,1.0],["cbg",0,null,-120.0,1.2,"OutSine",0.0,null,null,null],["say","avg1_149","There you go again... But that's another thing I adore about you.",9,""],["say","avg1_149","A soul, once gone, can't return. But the one before me now can still be saved. And for that I'm willing to use forceful methods.",9,""],["mrt",1,"z","007","exclamation",null],["stg",0,null,null,null,"Linear",1.0,null,null,"jushou"],["say","avg3_100","W-Wait...! Are you serious this time!?",1,""],["cbg",0,null,null,1.25,"OutSine",1.5,null,null,null],["w",0.3],["say","avg1_149","Time for a little taste~",9,""],["se","se_070"],["stg",0,null,null,null,"Linear",1.0,null,null,"Zhong"],["w",0.5],["bgm",""],["mrt",2,"z","007","exclamation",null],["say","avg3_100","Stop it!",1,""],["trn",0,0,false,false,1.0],["w",1.0],["se","se_236"],["mrt",0,"z","025","question",null],["say","avg3_100","G-Gerie...?!",1,""],["bgm",""],["se","se_208"],["bg","forest_night_1",0,0.3],["w",0.3],["mrt",0,"y","003",null,"niunie"],["fx",0,"fx_avg_eye_ev",0,0],["say","avg3_100","So warm ... and soft?",2,""],["show","avg1_149","a","002",null,-0.4,1.5,0,null,0.0],["trn",1,0,false,false,1.0],["w",1.0],["bgm","m22"],["ctl","avg1_149","a",null,null,null,null,null,1.0,null,"OutSine",0.5],["w",0.5],["ctl","avg1_149","a","009","happy",null,null,null,null,null,"Linear",1.0],["w",1.0],["say","avg1_149","Hehe... I shall spare you this time. Seeing that flustered look on your face was worth it, Great ==SEX12==~",0,""],["w",0.4],["mrt",1,"z","010","sweaty",null],["say","avg3_100","Hah... Don't joke like that again! I can never tell when you're actually being serious.",1,""],["ctl","avg1_149","a","008",null,null,null,null,null,"niunie","Linear",0.6],["w",0.6],["say","avg1_149","Oh? But I'm always completely sincere with you, my Great ==SEX12==.",0,""],["w",0.4],["mrt",0,"z","010","sigh",null],["say","avg3_100","That's why I'm always on edge!==W== Anyway, why'd you bring me all the way out here?",1,""],["mrt",0,"z","002",null,null],["goon"],["ctl","avg1_149","a","004",null,null,null,null,null,"diantou","Linear",0.5],["w",0.5],["say","avg1_149","I couldn't get her her favorite comic book, so I was hoping you could share about your adventures with her.",0,""],["w",0.4],["mrt",0,"z","013","happy",null],["say","avg3_100","Oh, I get it. Leave it to me.",1,""],["ctl","avg1_149","a","017","music",null,null,null,null,"diantou","Linear",1.0],["w",1.0],["say","avg1_149","Hehe... Thank you~ I know she'll be thrilled.",0,""],["se","se_207"],["ctl","avg1_149","a",null,null,null,-0.42,null,0.0,null,"OutSine",0.8],["w",0.8],["bgm",""],["trn",0,0,true,true,1.0],["w",1.0],["bg","sky_night_b",0,0.0],["cbg",0,100.0,0.0,1.2,"Linear",0.0,null,null,null],["trn",1,0,false,false,1.0],["cbg",0,-50.0,null,null,"Linear",8.0,null,null,null],["w",1.5],["say","0","We sit together, and I share stories of our journey so far.",0,""],["w",0.5],["stg",0,0.0,0.0,1.05,"OutSine",1.0,null,null,null],["bg","forest_night_1",0,1.0],["w",1.0],["mrt",1,"z","002",null,null],["say","avg3_100","Wow, it's gotten late. Looks like I won't finish tonight.",1,""],["mrt",0,"z","014","music","diantou"],["say","avg3_100","There are still so many stories left. I'll come back if I get the chance.",1,""],["show","avg1_149","a","003",null,null,null,0,null,null],["say","avg1_149","I'm really looking forward to it...==W== Well, then, let's call it a day. It's so late, I will escort you home~",0,""],["ctl","avg1_149","a","002","happy",null,null,null,null,"diantou","Linear",0.3],["w",0.3],["goon"],["w",0.4],["mrt",0,"z","010","sweaty",null],["say","avg3_100","Please ... don't bother.",1,""],["se","se_075"],["ctl","avg1_149","a",null,null,null,-0.25,1.3,null,"JuGong","OutSine",0.5],["w",0.5],["say","avg1_149","Hehe...==W== Don't worry about it. Carrying you back in my arms will be much faster than you walking by yourself, don't you think?",0,""],["ctl","avg1_149","a","005","love",null,null,null,null,null,"Linear",0.4],["w",0.4],["goon"],["se","se_112"],["mrt",0,"z","007","shock",null],["stg",0,0.0,0.0,1.0,"OutSine",0.8,null,null,"Xiao"],["w",0.8],["say","avg3_100","No need! I can walk on my own.",1,""],["se","se_074"],["se","se_077"],["ctl","avg1_149","a","009",null,null,-0.4,1.45,null,null,"OutSine",0.4],["w",0.4],["trn",0,0,true,true,0.7],["w",0.7],["bg","story_main_01_006_c",0,1.0],["w",1.0],["se","se_115"],["trn",1,0,false,false,1.5],["bgm",""],["cbg",0,null,null,1.1,"Linear",3.0,null,null,null],["w",0.5],["say","0","That night, Gerie sees me safely back to the Lucky Oasis, as serene and gentle as a true devotee of the God of Grace.",0,""],["end"]]}