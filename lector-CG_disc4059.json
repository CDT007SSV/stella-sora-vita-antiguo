",0,"fx_avg_reminiscence_loop",0,0],["se","se_169"],["se","se_036_stop"],["trn",1,0,false,false,0.75],["w",1.25],["show","avg3_100","c","002",null,null,null,0,null,0.0],["ctl","avg3_100","c",null,null,null,null,null,1.0,null,"Linear",0.5],["w",1.0],["ctl","avg3_100","c","022",null,null,null,null,null,"diantou","Linear",1.0],["w",1.0],["say","1","Trekkers are freer and hold more potential than anyone else.",0,""],["w",0.5],["se","se_169"],["trn",0,0,true,true,1.0],["w",1.0],["fx",0,"fx_avg_reminiscence_loop",1,0],["bg","forest_daylight_2",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,1.4,"Linear",0.0,null,null,null],["w",0.5],["show","avg1_137","b","007",0.6,-0.175,1.2,0,null,null],["trn",1,0,false,false,1.0],["w",1.5],["bgm",""],["ctl","avg1_137","b","010",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_137","Trekkers are free.==W== In that case...",0,""],["w",0.5],["ctl","avg1_137","b","012","speechless",null,null,null,null,null,"Linear",0.5],["goon"],["w",1.0],["se","se_207"],["ctl","avg1_137","b","002",null,null,-0.1,null,null,null,"OutQuad",0.5],["say","0","Struck by a sudden realization, Eleanor stands up.",0,""],["w",0.5],["ctl","avg1_137","b","002",null,null,null,null,null,null,"Linear",0.5],["say","avg1_137","I think I finally understand...==W== It's time to head back.",0,""],["w",0.5],["ctl","avg1_137","b","003",null,null,null,null,null,null,"Linear",0.5],["goon"],["bgm",""],["w",0.5],["trn",0,0,true,true,0.75],["w",0.75],["bg","hotel_senior_office",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["w",0.5],["trn",1,0,false,false,0.75],["w",1.25],["cbg",0,null,null,1.1,"OutQuad",0.5,null,null,null],["show","avg1_137","b","002",null,null,0.97,0,null,0.0],["ctl","avg1_137","b",null,null,null,null,1.0,1.0,null,"OutQuad",0.5],["w",0.8],["bgm","m56"],["ctl","avg1_137","b","013","exclamation",null,null,null,null,"lengzhan","Linear",0.5],["tsk","Xiao"],["say","avg1_137","I am Eleanor, the \"Lady Trekker.\" How can those high-society techniques capture the Trekker I am today? I need to forget the formulas, the theories, the rules... I'll paint from the heart.==W== That is the only way to do justice to who I am now.",0,""],["w",0.5],["ctl","avg1_137","b","016",null,null,null,null,null,"JuGong","Linear",0.5],["goon"],["w",0.5],["ctl","avg1_137","b","011","music",null,null,null,null,null,"Linear",0.5],["say","avg1_137","I'll capture the joy I've felt since becoming a Trekker, along with my hopes for the future. I'll paint the real \"me\"...!",0,""],["bgm",""],["w",0.5],["trn",0,0,true,true,0.75],["w",0.5],["se","se_187"],["w",0.75],["bg","field_room_inside_daylight",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["say","0","Several days later.",8,""],["w",0.5],["trn",1,0,false,false,0.75],["w",0.75],["se","se_187_stop"],["w",0.5],["cbg",0,null,null,1.1,"OutQuad",0.5,null,null,null],["show","avg1_137","b","002",null,null,0.97,0,null,0.0],["ctl","avg1_137","b",null,null,null,null,1.0,1.0,null,"OutQuad",0.5],["w",0.3],["bgm",""],["ctl","avg1_137","b","011","happy",null,null,null,null,"daintou","Linear",0.5],["say","avg1_137","Vivian, Caterine, welcome. As of today, this is our guild headquarters!",0,""],["w",0.5],["cbg",0,null,null,1.0,"OutQuad",0.5,null,null,null],["ctl","avg1_137","b",null,null,null,null,0.97,0.0,null,"OutQuad",0.5],["hide","avg1_137",0.5],["w",0.5],["show","avg3_224","a","002",0.75,null,null,0,null,0.0],["show","avg3_223","a","002",0.25,null,null,0,null,0.0],["ctl","avg3_224","a",null,null,0.7,null,null,1.0,null,"OutQuad",0.5],["ctl","avg3_223","a",null,null,0.3,null,null,1.0,null,"OutQuad",0.5],["w",0.8],["ctl","avg3_223","a","003",null,null,null,null,null,"youchupeng","Linear",0.5],["w",0.5],["say","avg3_223","Finally.==W== Heh, choosing this place was the right call.",0,""],["w",0.5],["ctl","avg3_223","a","005","music",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg3_224","a","009","happy",null,null,null,null,null,"Linear",0.5],["say","avg3_224","We all chose it at first sight. I guess great minds think alike.",0,""],["w",0.5],["cbg",0,null,null,1.1,"OutQuad",0.5,null,null,null],["chd",0,1,"avg1_137","b","016","shy"],["ctl","avg3_223","a",null,null,0.25,null,null,null,null,"OutQuad",0.5],["ctl","avg3_224","a",null,null,0.75,null,null,null,null,"OutQuad",0.5],["say","avg1_137","Also, I have something I want to show you...",0,""],["bgm",""],["w",0.5],["trn",0,0,true,true,0.75],["w",0.75],["bg","4059_B",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["w",1],["se","se_021"],["trn",1,0,false,false,0.75],["w",0.75],["bgm","m143"],["say","avg3_224","I-Is this ...==W== your self-portrait? I've never seen a composition like this before.",9,""],["w",0.5],["goon"],["w",0.5],["say","avg3_224","It is highly original! It is as if you captured your past and your future on the same canvas...!",9,""],["w",0.5],["cbg",0,-200.0,-300.0,1.3,"OutQuad",1.0,null,null,null],["say","avg3_223","Plus, this expression captures you better than the other painting did...==W== I love it. Anyone who looks at this will find your smile contagious.",9,""],["w",0.5],["goon"],["w",0.5],["say","avg3_224","It looks like you figured out why that old portrait felt weird.",9,""],["w",0.5],["cbg",0,300.0,null,null,"OutQuad",1.0,null,null,null],["say","avg1_137","Yes. It was because the me in that painting only had eyes for the noble world.",9,""],["w",0.5],["se","se_055"],["say","avg1_137","... I know I am still inexperienced. Whether as a proper lady or a Trekker, I still have a lot to learn, but...",9,""],["w",0.5],["cbg",0,0.0,0.0,1.0,"Linear",15.0,null,null,null],["say","avg1_137","At least I have officially started my journey as a Trekker. My old self almost feels like a stranger to me now...",9,""],["w",0.5],["say","avg3_223","You are our guild captain. You should hold your head high and be more confident.",9,""],["w",0.5],["say","avg3_224","Exactly. We can't let you outdo us, either.",9,""],["w",0.5],["say","avg1_137","Caterine, Vivian...==W== Thank you. You two gave me the push to paint this portrait.",9,""],["w",0.5],["goon"],["w",0.5],["bg","flatlands_daylight",2,0.0],["show","avg3_123","a","002",0.25,null,null,0,null,0.0],["show","avg1_137","b","002",null,null,null,2,null,0.0],["ctl","avg3_123","a",null,null,null,null,null,1.0,null,"Linear",1.0],["ctl","avg1_137","b",null,null,null,null,null,1.0,null,"Linear",1.0],["bg","mansion_garden_daylight",0,1.0],["stage",2,0,0],["say","avg1_137","If it weren't for this painting, it would have been difficult to see clearly how much I've changed.",0,""],["w",0.5],["say","avg1_137","I promise you: I will become a captain worthy of this painting, and we will forge a brand-new future!",0,""],["w",0.5],["trn",0,0,true,true,0.75],["w",0.75],["stage",2,1,1],["bg","field_room_inside_daylight",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,1.1,"Linear",0.0,null,null,null],["w",0.5],["trn",1,0,false,false,0.75],["w",1.25],["show","avg3_223","a","002",0.25,null,0.97,0,null,0.0],["show","avg3_224","a","002",0.75,null,0.97,0,null,0.0],["ctl","avg3_223","a",null,null,0.3,null,1.0,1.0,null,"OutQuad",0.5],["ctl","avg3_224","a",null,null,0.7,null,1.0,1.0,null,"OutQuad",0.5],["w",1.0],["ctl","avg3_223","a","003","attention",null,null,null,null,"diantou","Linear",0.5],["say","avg3_223","Oh my, our captain is so dependable.",0,""],["w",0.5],["ctl","avg3_224","a","006",null,null,null,null,null,"zuochupeng","Linear",0.5],["say","avg3_224","You are the only one who could lead us, Eleanor.",0,""],["w",0.5],["ctl","avg3_223","a","005","idea",null,null,null,null,"jushou","Linear",0.5],["say","avg3_223","By the way, Eleanor, would you paint us next?",0,""],["w",0.5],["se","se_112"],["ctl","avg3_224","a","007",null,null,null,null,null,"chijing","Linear",0.5],["say","avg3_224","You're sneaky, Caterine. I won't let you cut in line.",0,""],["w",0.5],["show","avg1_137","b","002",null,null,0.97,0,null,0.0],["ctl","avg3_223","a",null,null,0.2,null,null,null,null,"OutQuad",0.65],["ctl","avg3_224","a",null,null,0.8,null,null,null,null,"OutQuad",0.65],["ctl","avg1_137","b",null,"music",null,null,1.0,1.0,null,"OutQuad",0.65],["say","avg1_137","Of course. Actually,==W== since we have the chance, why don't I paint a group portrait of the three of us?",0,""],["w",0.5],["ctl","avg1_137","b","003",null,null,null,null,null,"JuGong","Linear",0.5],["goon"],["w",0.5],["bg","mood_1",0,0.5],["ctl","avg3_223","a","006",null,null,null,null,null,null,"Linear",0.5],["ctl","avg3_224","a","006",null,null,null,null,null,null,"Linear",0.5],["ctl","avg1_137","b",null,"flower",null,null,null,null,"chijing","Linear",0.5],["say","avg1_137","We can hang our individual portraits, then put up a painting of us together.==W== That is what will make this place feel like our guild, don't you think?",0,""],["w",0.5],["ctl","avg1_137","b","002",null,null,null,null,null,"JuGong","Linear",0.5],["goon"],["w",0.5],["bg","field_room_inside_daylight",0,0.5],["cbg",0,null,null,1.1,"Linear",0.0,null,null,null],["ctl","avg3_224","a","009","exclamation",null,null,null,null,null,"Linear",0.5],["say","avg3_224","Good idea!",0,""],["w",0.5],["ctl","avg3_223","a","009","happy",null,null,null,null,null,"Linear",0.5],["say","avg3_223","Sounds perfect!",0,""],["w",0.5],["ctl","avg1_137","b","003",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg1_137","Heh heh, just wait and see!",0,""],["bgm",""],["w",0.5],["end"]]}