],["mrt",0,"z","007",null,"jingxia"],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["bgm","m53"],["ctl","avg1_162","c","008",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_162","S-Sorry, ==PLAYER_NAME==! That was pure reflex. Are you hurt?==W== Here, let me help you up.",0,""],["w",0.5],["ctl","avg1_162","c","007",null,null,null,null,null,"diantou","Linear",0.5],["goon"],["se","se_100"],["cbg",0,null,100.0,null,"OutQuad",1.0,null,null,null],["ctl","avg1_162","c",null,null,null,-0.6,1.8,0.0,null,"OutQuad",0.5],["hide","avg1_162",0.5],["w",1.0],["bg","phylanis_street_outside_night",0,1.0],["cbg",0,null,-100.0,1.1,"Linear",0.0,null,null,null],["cbg",0,null,0.0,null,"OutQuad",1.0,null,null,null],["w",1.0],["show","avg1_162","a","008",null,null,0.97,0,null,0.0],["ctl","avg1_162","a",null,null,null,null,1.0,1.0,null,"OutQuad",0.5],["w",1.0],["mrt",1,"z","002",null,null],["say","avg3_100","I'm fine, don't worry about it. Besides, you protected me, right? When you took me down,==W== you grabbed my shoulders to break the fall.",1,""],["w",0.5],["ctl","avg1_162","a","020",null,null,null,null,null,null,"Linear",0.5],["mrt",0,"z","011",null,"niunie1"],["goon"],["w",0.5],["mrt",0,"z","013","attention","jushou"],["say","avg3_100","But hey, wasn't that move pretty slick? I actually forced you to pin me! My swordplay must be getting somewhere, huh?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_162","a","004","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_162","Your swordplay...==W== It is smoother. And feinting the slash to set up a thrust was clever.",0,""],["w",0.65],["ctl","avg1_162","a","005",null,null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["ctl","avg1_162","a","017","awkward",null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_162","But your body lacks conditioning. It just can't keep up with your head. When you shifted your stance, you left a massive opening.",0,""],["w",0.5],["bg","mood_4",0,0.75],["ctl","avg1_162","a","011","vexation",null,null,null,null,null,"Linear",0.5],["say","avg1_162","The kind of opening that ...==W== makes an opponent instinctively want to close the gap, sweep your legs, and drop a headbutt.",0,""],["w",0.5],["ctl","avg1_162","a","003",null,null,-0.175,1.2,null,null,"OutQuad",0.5],["goon"],["w",0.5],["bg","phylanis_street_outside_night",0,0.75],["cbg",0,null,null,1.4,"Linear",0.0,null,null,null],["mrt",1,"z","007","question",null],["say","avg3_100","Huh?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_162","a","012","shy",null,null,null,null,"niunie1","Linear",0.5],["say","avg1_162","It was just too tempting. My body reacted on its own. Thank the stars I stopped before the headbutt.",0,""],["w",0.5],["mrt",1,"z","021","sweaty",null],["say","avg3_100","Wait. So you didn't grab me gently to break my fall... You were pulling me in to break my nose?!",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_162","a","002",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_162","Yeah.",0,""],["w",0.5],["se","se_070"],["stg",0,null,null,null,"Linear",1.0,null,null,"Xiao"],["mrt",1,"z","007",null,null],["tsk","Xiao"],["say","avg3_100","Hey now, isn't that a little brutal?! We're supposed to be practicing!",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_112"],["ctl","avg1_162","a","012",null,null,null,null,null,"chijing","Linear",0.5],["say","avg1_162","Ahem. That was my mistake. But if you don't go all out in practice, you won't last a second in a real fight.",0,""],["w",0.5],["ctl","avg1_162","a","002","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_162","You felt it too, didn't you, ==PLAYER_NAME==? Your body is holding your brain's response back. The best tactics in the world mean nothing==W== if you can't execute them.",0,""],["w",0.5],["ctl","avg1_162","a","011",null,null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["ctl","avg1_162","a","005",null,null,-0.25,1.3,null,null,"OutQuad",0.5],["say","avg1_162","But conditioning doesn't happen overnight. Even if you train every day, you need months to see real results.",0,""],["w",0.5],["ctl","avg1_162","a","021","happy",null,null,null,null,null,"Linear",0.5],["say","avg1_162","Starting tomorrow, come jogging with me at night. We'll mix stamina work with your sword forms. Just stick with it, and eventually, everything will get better.",0,""],["w",0.5],["mrt",1,"z","010",null,null],["say","avg3_100","Got it, got it. I'll take it seriously.",1,""],["w",0.5],["mrt",0,"z","020",null,"lengzhan"],["say","avg3_100","Still, get you talking about swords and you'll never want to stop.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_162","a","010","symbol",null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_162","Wha—? D-Do I? Am I really that chatty?",0,""],["w",0.5],["mrt",1,"z","018",null,null],["say","avg3_100","Come to think of it, out of all the time we spend alone, I'd say fifty percent of it is just training...",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_162","a","017","vexation",null,null,null,null,null,"Linear",0.5],["say","avg1_162","Th-That's not true!==W== We patrol together too... Speaking of, let's go on patrol right now! A change of pace will do you good.",0,""],["w",0.5],["ctl","avg1_162","a","005",null,null,null,null,null,"jushou","Linear",0.5],["goon"],["w",0.5],["mrt",1,"z","019","awkward",null],["say","avg3_100","And the other fifty percent is patrolling.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_162","a","003",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_162","Yeah. I have absolutely no comeback for that.",0,""],["bgm",""],["w",0.5],["ctl","avg1_162","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_162","I hate to admit it, but my life is just ...==W== monotonous. It must be a total bore hanging out with me, ==PLAYER_NAME==.",0,""],["w",0.5],["ctl","avg1_162","a","014","sigh",null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["bgm","m57"],["mrt",1,"z","003",null,null],["say","avg3_100","Objectively? Yeah, it's a little dull.==W== But doing it all with you makes up for it.",1,""],["w",0.5],["mrt",0,"z","014",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_162","a","010","question",null,null,null,null,null,"OutQuad",0.3],["say","avg1_162","It does?==W== But... I'm hardly interesting. I'm nowhere near as sharp or well-read as Elis, and I don't know Filanis half as well as Lulu.",0,""],["w",0.5],["ctl","avg1_162","a","011",null,null,null,null,null,null,"OutSine",2.0],["goon"],["w",0.5],["mrt",1,"z","017","music",null],["say","avg3_100","Just being around you makes me feel safe.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_162","a","014","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_162","S...==W== Safe?",0,""],["w",0.65],["ctl","avg1_162","a","022",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg1_162","a","003",null,null,null,null,null,null,"Linear",0.5],["say","avg1_162","My swordplay is good, and I will always protect you. But I can't fix every single problem.",0,""],["w",0.5],["ctl","avg1_162","a","017",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_162","Even when patrolling the \"perfect\" city of Filanis, we could run into a starving thief, or some violent thug from another city.",0,""],["w",0.5],["ctl","avg1_162","a","010","shy",null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_162","Y-You absolutely can't drop your guard just because I'm here! You can't just feel safe. What if we get ambushed?",0,""],["w",0.5],["ctl","avg1_162","a","004",null,null,null,null,null,null,"Linear",0.5],["say","avg1_162","Strictly speaking, I can't guarantee your safety in every conceivable scenario. So...==W== Please don't let your guard down.",0,""],["w",0.5],["ctl","avg1_162","a","005",null,null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["mrt",1,"z","018",null,null],["say","avg3_100","I didn't mean that kind of safe. I mean...==W== Even when we're walking through the dark, and even though barely anyone here knows what you do for them...",1,""],["w",0.5],["mrt",0,"z","002",null,null],["goon"],["w",0.5],["mrt",0,"z","020",null,"lengzhan"],["say","avg3_100","... You never get discouraged. And you never stop pushing for a better tomorrow.",1,""],["w",0.5],["mrt",0,"z","013","flower",null],["say","avg3_100","You're like a warm little sun. Just being around you, I catch some of your drive.",1,""],["w",0.5],["mrt",0,"z","003",null,"JuGong"],["say","avg3_100","Phew. I need to step it up, too. When you finally earn your way back into the Monolith, I'm going to find a way home.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["cbg",0,null,-60.0,1.3,"OutQuad",1.0,null,null,null],["ctl","avg1_162","a",null,null,null,-0.35,1.35,0.0,null,"OutQuad",0.5],["hide","avg1_162",0.5],["w",0.5],["bg","sky_night_b",0,1.0],["cbg",0,null,null,1.3,"Linear",15.0,null,null,null],["se","se_055"],["say","avg1_162","Your home...==W== Would you tell me about it more?",0,""],["w",0.5],["goon"],["w",0.5],["say","avg1_162","You said before that there are no slaves there...==W== What kind of city is it?",0,""],["w",0.5],["goon"],["w",0.5],["mrt",1,"z","002",null,null],["say","avg3_100","Oh, my home isn't exactly a city. It's a vehicle.",1,""],["w",0.5],["mrt",0,"z","011",null,"niunie1"],["say","avg3_100","My friends and I drive it all over the world. But it's true, out of all the places we've visited, none of them have slaves.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["say","avg1_162","That sounds ...==W== so free. Growing up, the only places I've ever known are the Grand Arena in Emor and Filanis.",0,""],["w",0.5],["goon"],["w",0.5],["se","se_125"],["say","avg1_162","I don't even know ...==W== what Emor looks like outside the Arena walls.",0,""],["w",0.5],["goon"],["w",0.5],["mrt",1,"z","017",null,null],["say","avg3_100","You'll get your chance. You're free now too, Alina. You're only staying behind to repay a debt, and to help make Filanis a better place.",1,""],["w",0.3],["bg","city_street_water",0,1.0],["cbg",0,null,null,1.3,"Linear",0.0,null,null,null],["cbg",0,null,null,1.0,"Linear",20.0,null,null,null],["w",0.5],["fx",0,"fx_avg_reminiscence_loop",0,0],["mrt",0,"z","002",null,null],["say","avg3_100","Someday, Filanis will be the city you've always dreamed of. When that day comes...==W== If I'm still around, we'll go traveling together.",1,""],["w",0.5],["mrt",0,"z","012",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["se","se_052"],["say","avg1_162","Is that a promise?",0,""],["w",0.5],["mrt",1,"z","018",null,null],["say","avg3_100","It's a promise.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["bg","phylanis_street_outside_night",0,1.0],["w",0.5],["fx",0,"fx_avg_reminiscence_loop",1,0],["w",0.1],["show","avg1_162","a","006",null,null,null,0,null,0.0],["ctl","avg1_162","a",null,null,null,null,null,1.0,null,"Linear",1.0],["w",1.3],["ctl","avg1_162","a","010","shock",null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_162","Ah, look at the time. I need to start patrol and blow the timekeeping horn.",0,""],["w",0.5],["ctl","avg1_162","a","002",null,null,null,null,null,null,"Linear",0.5],["mrt",1,"z","013",null,null],["say","avg3_100","I'm coming with you.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_162","a","008",null,null,null,null,null,null,"Linear",0.5],["say","avg1_162","You stayed up late last night doing the Night Watchers' ledgers...==W== Can you even keep your eyes open?",0,""],["w",0.5],["ctl","avg1_162","a","005","question",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["se","se_084"],["fx",0,"fx_avg_congr",0,1],["ctl","avg1_162","a","011",null,null,null,null,null,null,"Linear",0.5],["mrt",1,"z","013",null,null],["say","avg3_100","Don't underestimate me. I'm the ultimate night owl.",1,""],["mrt",3,"z",null,null,null],["bgm",""],["w",0.5],["t