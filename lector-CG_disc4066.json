",0,""],["w",0.5],["ctl","avg1_162","c","003",null,null,null,null,null,null,"Linear",0.5],["say","avg1_162","Exactly. Your form's improving.",0,""],["w",0.5],["ctl","avg1_162","c","007",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg1_162","Alright, let's try a real fight, ==PLAYER_NAME==. Come at me with everything we covered. Don't hold back.",0,""],["bgm",""],["w",0.5],["ctl","avg3_100","a","006","exclamation",null,null,null,null,"diantou","OutQuad",0.5],["say","avg3_100","Oki!",0,""],["chd",1,2,"avg1_162","a","002",null],["w",0.5],["bgm","m148"],["se","se_063"],["stg",0,null,null,null,"Linear",0.5,null,null,"Xiao"],["fx",0,"fx_speedline_center_w",0,1],["ctl","avg3_100","a",null,null,null,-0.175,1.2,0.0,"lengzhan","OutSine",0.4],["w",0.7],["se","se_322"],["stg",0,null,null,null,"Linear",0.3,null,null,"Zhong"],["w",0.1],["fx",0,"fx_avg_atta",0,0],["say","0","Blades ring out in the quiet night. Gripping my training sword, I throw everything I have into the offensive.",0,""],["w",0.5],["stg",0,null,-50.0,1.1,"OutQuad",0.5,null,null,null],["show","avg1_162","a","002",null,null,0.97,0,null,0.0],["ctl","avg1_162","a","003",null,null,null,1.0,1.0,null,"OutQuad",0.5],["w",0.8],["mrt",1,"y","020","think",null],["say","avg3_100","A basic slash is just gonna get blocked. She said use everything, so...",2,""],["w",0.5],["mrt",0,"z","026","exclamation","lengzhan"],["tsk","Xiao"],["say","avg3_100","Here I come, Alina!",1,""],["mrt",3,"z",null,null,null],["w",0.5],["choice",["Feint a slash to set up a thrust"],[[]]],["w",0.5],["se","se_063"],["fx",0,"fx_speedline_center_w",0,1],["stg",0,null,null,1.2,"OutQuad",0.5,null,null,null],["ctl","avg1_162","a","002",null,null,null,null,null,null,"Linear",0.5],["w",1.0],["se","se_104"],["fx",0,"fx_avg_line_drop_w",0,0],["stg",0,null,-120.0,null,"OutQuad",0.35,null,null,null],["ctl","avg1_162","a","010",null,null,null,null,null,"lengzhan","Linear",0.5],["w",0.9],["se","se_137"],["stg",0,null,0.0,1.3,"OutQuad",0.5,null,null,"ju