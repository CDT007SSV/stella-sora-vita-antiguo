","avg3_100","It's dead quiet in here. Are they still asleep?",2,""],["mrt",3,"u",null,null,null],["w",0.5],["show","avg1_155","b","004",0.7,-0.35,1.4,0,null,0.0],["ctl","avg1_155","b",null,null,0.6,null,null,1.0,null,"OutSine",0.5],["se","se_099"],["say","avg1_155","Mornin', Boss♪",0,""],["w",0.5],["se","se_070"],["stg",0,null,null,1.1,"Linear",0.5,null,null,"Zhong"],["mrt",1,"v","025",null,null],["say","avg3_100","Whoa! You scared me!",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_155","b","004","question",0.5,null,null,1.0,null,"OutSine",0.5],["say","avg1_155","Sleep okay? How was your first night at sea?",0,""],["w",0.5],["mrt",1,"v","011","love",null],["say","avg3_100","Great. Wasn't as rocky as I expected, and the bedding smelled ... nice.",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_155","b","009","attention",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_155","Oh, you noticed... ==W==Sorry 'bout that. It's the blanket Karin and I use.",0,""],["w",0.5],["ctl","avg1_155","b","002",null,null,0.0,1.0,null,null,"Linear",0.3],["goon"],["w",0.5],["mrt",1,"v","007","shy",null],["say","avg3_100","... Oh! You really didn't have to. The floor would've been fine.",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_155","b","013","happy",null,null,null,1.0,"JuGong1","OutSine",0.5],["say","avg1_155","Don't be silly. You're part of the crew now, Boss. We look after our own.",0,""],["w",0.5],["mrt",1,"v","023",null,null],["say","avg3_100","Alright, if you say so. Thanks, I appreciate it.",1,""],["mrt",0,"v","002","attention",null],["say","avg3_100","By the way, I thought I heard a weird noise last night. Was everything okay?",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_155","b","011","speechless",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_155","Just the waves. They got pretty rough for a bit. I was surprised you slept through it.==W== You were totally knocked out...♪",0,""],["w",1.0],["ctl","avg1_155","b","013","m