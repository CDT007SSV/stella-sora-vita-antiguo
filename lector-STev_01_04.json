1_157","b","007",null,null,null,null,1.0,"chijing","OutSine",0.5],["say","avg1_157","I'll just have to sneak in while you're asleep and snip off your hair! Bit by bit, I'll get enough to make a sachet ... and if I wear it, Shia will...",0,""],["w",0.5],["mrt",1,"v","007","exclamation",null],["say","avg3_100","Hey, hey—!",1,""],["mrt",3,"v",null,null,null],["w",0.5],["se","se_077"],["ctl","avg1_157","b","009",null,null,null,null,1.0,"JuGong1","OutSine",0.5],["say","avg1_157","Fine! You pass my inspection ... for now. But I'm still watchin'!",0,""],["w",0.5],["mrt",1,"u","010","sigh",null],["say","avg3_100","Well, that's a relief, I guess.",2,""],["mrt",3,"u",null,null,null],["bgm",""],["w",0.5],["se","se_095"],["stg",0,100.0,null,null,"OutSine",1.0,null,null,null],["w",1.0],["mrt",1,"v","002","attention",null],["say","avg3_100","Mmm, something smells amazing... Could that be...?",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_157","b","018","exclamation",null,null,null,1.0,"jushou2","OutSine",0.5],["say","avg1_157","That must be Shia with breakfast! I'm outta here!",0,""],["w",0.5],["se","se_148"],["ctl","avg1_157","b",null,null,0.7,null,null,0.0,null,"OutSine",0.5],["w",1.0],["stg",0,0.0,null,null,"Linear",0.5,null,null,null],["w",0.5],["mrt",1,"v","015",null,null],["say","avg3_100","And she's gone—==W==that was quick!",1,""],["w",1.0],["mrt",0,"v","007","exclamation","jushou2"],["goon"],["mrt",3,"v",null,null,null],["w",0.5],["se","se_065"],["trn",0,2,false,false,1.0],["w",1.0],["bg","cabin_daylight",0,0.0],["trn",1,2,false,false,1.0],["w",1.0],["fx",0,"fx_avg_bubble",0,0],["w",0.5],["say","0","To my surprise, Shia's an incredible cook.",0,""],["w",0.5],["bg","BG_Black",0,1.0],["w",1.0],["se","se_077"],["say","0","With full stomachs, we pack our gear and get ready to head ashore.",0,""],["w",0.5],["trn",0,0,true,false,1.0],["w",1.0],["bg","beach_wasteland_daylight",0,0.5],["w",0.5],["stg",0,50.0,null,1.1,"Linear",0.0,null,null,null],["trn",1,0,false,fals