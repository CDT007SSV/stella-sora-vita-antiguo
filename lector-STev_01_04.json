],["w",0.5],["bgm",""],["trn",0,0,true,false,1.0],["w",1.0],["bg","deck_daylight",0,1.0],["w",1.0],["se","se_076"],["trn",1,0,false,false,1.0],["w",1.5],["show","avg1_157","b","017",null,null,null,0,null,0.0],["ctl","avg1_157","b",null,"speechless",null,null,null,1.0,null,"OutSine",0.5],["w",1.5],["bgm","m56"],["ctl","avg1_157","b","004",null,null,null,null,null,"JuGong1","Linear",0.5],["say","avg1_157","Bags are packed, list is checked. We should be good.",0,""],["w",0.5],["se","se_021"],["mrt",2,"v","002",null,null],["say","avg3_100","I shuffled a few things around to balance the weight distribution. My notes are on the list if you wanna look.",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_157","b","016","attention",null,-0.35,1.5,1.0,null,"OutSine",0.3],["say","avg1_157","Wow, Boss. You're a lot more on top of things than I thought.",0,""],["w",0.5],["mrt",1,"v","013",null,null],["say","avg3_100","Heh, you're giving me too much credit.",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_157","b","009","exclamation",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_157","But—!!",0,""],["ctl","avg1_157","b","014","resentful",null,0.0,1.0,1.0,"jushou2","OutSine",0.3],["say","avg1_157","That doesn't mean I've forgiven you for this morning!",0,""],["w",0.5],["se","se_251"],["ctl","avg1_157","b","007",null,null,null,null,1.0,"chijing","OutSine",0.5],["say","avg1_157","To do that to Shia...==W== Unforgivable! Utterly unforgivable!",0,""],["w",1.0],["ctl","avg1_157","b","020","angry",null,null,null,1.0,null,"OutSine",0.5],["goon"],["w",0.5],["mrt",1,"v","010","vexation",null],["say","avg3_100","I didn't do a thing! I just tripped, and she's the one who came over and sniffed me...",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_157","b","006","symbol",null,null,null,1.0,"chijing","OutSine",0.5],["say","avg1_157","What?!==W== She went out of her way to sniff you?!",0,""],["w",0.5],["ctl","avg1_157","b","019","shock",null,-0.35,1.5,1.0,"jushou2","OutSine",0.5],["goon"],["w",0.5],["mrt",1,"u","021","awkward",null],["say","avg3_100","Dang it. I shouldn't have said that. Now she's really mad...",2,""],["mrt",3,"u",null,null,null],["w",0.5],["ctl","avg1_157","b","009",null,null,null,null,1.0,null,"OutSine",0.5],["say","avg1_157","Ha! Okay, I see what's going on. Your true identity...",0,""],["w",0.5],["mrt",1,"u","015",null,null],["say","avg3_100","What's she getting at? Don't tell me she thinks...",2,""],["mrt",3,"u",null,null,null],["w",0.5],["bgm",""],["bg","BG_Black",0,0.3],["fx",0,"fx_avg_flash_light",0,0],["ctl","avg1_157","b","020",null,null,-0.5,1.7,1.0,null,"OutSine",0.3],["say","avg1_157","You're a siren right?! You've obviously bewitched Shia!",0,""],["w",0.5],["mrt",1,"v","025","symbol",null],["say","avg3_100","Huh?!",1,""],["mrt",3,"v",null,null,null],["w",0.5],["bg","deck_daylight",0,0.5],["se","se_074"],["ctl","avg1_157","b","017",null,null,0.0,1.0,1.0,null,"OutSine",0.5],["say","avg1_157","I knew somethin' was up! Why else would Shia allow you on the ship and be so nice to you? She's usually so wary of people.",0,""],["se","se_124"],["ctl","avg1_157","b","003",null,null,null,null,1.0,"niunie1","OutSine",0.5],["say","avg1_157","She... She used to only be like that with me...",0,""],["w",0.5],["mrt",1,"v","015","speechless",null],["say","avg3_100","You...",1,""],["w",0.5],["mrt",0,"u","010","sigh",null],["say","avg3_100","So that's what this is about. She thinks I'm stealing Shia from her.",2,""],["mrt",3,"u",null,null,null],["w",0.5],["bgm","m59"],["ctl","avg1_157","b","008","exclamation",null,-0.35,1.5,1.0,"jushou2","OutSine",0.3],["say","avg1_157","Please—I'm begging you, leave Shia alone! If you're gonna cast a spell or anything, do it to me!",0,""],["w",0.5],["se","se_070"],["stg",0,null,null,null,"Linear",1.0,null,null,"Zhong"],["mrt",1,"v","025",null,null],["say","avg3_100","What are you even talking about?!",1,""],["mrt",3,"v",null,null,null],["w",0.5],["se","se_112"],["ctl","avg1_157"