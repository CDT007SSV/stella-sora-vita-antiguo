","a","007",1.0,null,null,0,null,0.0],["ctl","avg1_157","a",null,"angry",0.85,null,null,1.0,null,"OutSine",0.5],["ctl","avg2_984","b",null,null,0.6,null,null,null,null,"Linear",0.5],["ctl","avg2_983","b",null,null,0.4,null,null,null,null,"Linear",0.5],["w",0.5],["say","avg1_157","Think you can run?! Think again! Time to see what this harpoon gun can do!",0,""],["w",0.5],["bg","BG_Black",3,0.5],["show","avg1_155","a","002",0.4,null,null,3,null,0.0],["stage",3,0,0],["ctl","avg1_155","a",null,"idea",0.5,null,null,1.0,null,"OutSine",0.5],["say","avg1_155","Karin, you pin 'em down. I'll swing around to the ship and cut off their escape.",0,""],["w",0.5],["ctl","avg1_157","a","014","exclamation",null,null,null,1.0,"jushou2","OutSine",0.5],["say","avg1_157","On it!!",0,""],["w",0.5],["stage",3,1,3],["stg",0,0.0,null,null,"Linear",0.5,null,null,null],["se","se_251"],["ctl","avg1_157","a",null,null,0.75,null,null,null,null,"Linear",0.5],["ctl","avg2_984","b","008",null,0.5,null,null,null,null,"Linear",0.5],["ctl","avg2_983","b",null,null,0.3,null,null,null,null,"Linear",0.5],["w",1.0],["mrt",1,"u","004","star",null],["say","avg3_100","Those people hardly had any chance to fight back... This kind of seamless coordination is built on the trust between Shia and Karin.",2,""],["mrt",3,"u",null,null,null],["w",0.5],["clear",1,0.5,1],["fx",0,"fx_avg_dust_2_b",1,0],["cbg",0,-200.0,null,1.3,"Linear",0.5,null,null,null],["w",0.5],["mrt",2,"u","025","attention",null],["say","avg3_100","... Huh? Who's that on deck?",2,""],["mrt",3,"u",null,null,null],["w",0.5],["bg","beach_wasteland_daylight",0,0.5],["bg","mood_2",5,0.0],["stg",5,null,null,1.0,"Linear",0.5,null,null,null],["show","avg1_157","a","002",0.5,null,null,5,null,0.0],["stage",5,0,14],["ctl","avg1_157","a","020","exclamation",0.5,null,null,1.0,"jushou2","OutSine",0.5],["say","avg1_157","... Flashbang! Everyone, get down!",0,""],["w",0.5],["bgm",""],["stage",5,1,15],["fx",0,"fx_avg_flash_ev",0,2],["trn",0,1,true,false,0.2],["w",0.2],["bg","white",0,0.0],["trn",1,0,false,false,0.2],["w",0.2],["mrt",2,"u","016","exclamation",null],["say","avg3_100","Agh—! That's blinding!",2,""],["mrt",3,"u",null,null,null],["w",0.5],["trn",0,1,false,false,0.5],["w",0.5],["bg","beach_wasteland_daylight",0,0.0],["trn",1,1,false,false,1.5],["se","se_227"],["w",0.5],["say","0","My vision very soon clears, but our targets have already vanished.",0,""],["w",0.5],["bgm","m49"],["show","avg1_155","a","014",0.25,null,null,0,null,0.0],["ctl","avg1_155","a",null,null,0.3,null,null,1.0,null,"OutSine",0.5],["w",0.5],["say","avg1_155","Ah, shame. We lost them.",0,""],["w",0.5],["ctl","avg1_155","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["se","se_370"],["stg",0,-100.0,-100.0,1.2,"Linear",0.5,null,null,null],["w",1.0],["mrt",1,"v","002","attention",null],["say","avg3_100","Over there! Their ship's pulling away!",1,""],["mrt",3,"v",null,null,null],["w",0.5],["stg",0,0.0,0.0,1.0,"Linear",0.5,null,null,null],["show","avg1_157","a","007",0.3,null,null,0,null,0.0],["ctl","avg1_157","a",null,"resentful",0.4,null,null,1.0,"jushou2","OutSine",0.5],["say","avg1_157","Dammit, what a dirty trick... I'm going after them!",0,""],["w",0.5],["se","se_148"],["stg",0,-60.0,null,null,"Linear",0.5,null,null,null],["ctl","avg1_157","a","013",null,0.7,null,null,0.0,null,"OutSine",0.5],["w",0.5],["se","se_074"],["ctl","avg1_155","a","011",null,0.4,null,null,1.0,null,"OutSine",0.5],["say","avg1_155","Leave them. We could be walking right into an ambush.==W== We're after the same thing—our paths will cross again.",0,""],["w",1.0],["se","se_077"],["ctl","avg1_155","b","002",null,null,null,null,null,"JuGong1","Linear",0.5],["goon"],["ctl","avg1_157","a",null,null,0.8,null,null,0.0,null,"Linear",0.0],["w",1],["ctl","avg1_157","a","007","resentful",0.75,null,null,1.0,null,"OutSine",0.5],["say","avg1_157","Fine. But next time, they'll get what's comin' to them!",0,""],["se","se_077"],["ctl","avg1_157","b","002",null,null,null,null,1.0,"JuGong1","OutSine",0.5],["w",1.0],["ctl","avg1_157","b",null,null,0.8,null,null,0.0,null,"Linear",0.3],["ctl","avg1_155","b","009","attention",0.5,null,null,1.0,null,"OutSine",0.5],["say","avg1_155","Boss, you okay? You didn't get hurt, did you?",0,""],["w",0.5],["mrt",1,"v","022",null,null],["say","avg3_100","I'm fine ... and the supplies we gathered are all intact.",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_155","b","014","sigh",null,null,null,1.0,"JuGong1","OutSine",0.5],["say","avg1_155","Good. It's getting late. We should head back.",0,""],["w",0.5],["bgm",""],["mrt",1,"u","012","attention",null],["say","avg3_100","Shia's been quiet... Must be upset those people got away.",2,""],["mrt",0,"u","020","think",null],["say","avg3_100","And what's this about a \"diary\"? Could what they said about the \"Monolith\" ... actually be true?",2,""],["mrt",3,"u",null,null,null],["w",0.5],["trn",0,0,true,false,1.0],["w",1.0],["bg","cabin_night",0,1.0],["w",1.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["se","se_076"],["trn",1,0,false,false,1.0],["w",1.5],["show","avg1_157","b","017",null,null,null,0,null,0.0],["se","se_092"],["ctl","avg1_157","b",null,null,null,null,null,1.0,"JuGong1","OutSine",0.5],["w",0.5],["say","avg1_157","I'm done eating.",0,""],["w",0.5],["bgm","m12"],["ctl","avg1_157","b",null,null,0.3,null,null,null,null,"Linear",0.5],["show","avg1_155","b","009",0.7,null,null,0,null,0.0],["ctl","avg1_155","b",null,"attention",0.65,null,null,1.0,null,"OutSine",0.5],["say","avg1_155","You barely ate, Karin. Something wrong with the food?",0,""],["w",0.5],["ctl","avg1_157","b","006","flurry",null,null,null,1.0,"chijing","OutSine",0.5],["say","avg1_157","N-No, that's not it...==W== Dinner was great!",0,""],["w",1.0],["ctl","avg1_157","b","011","exclamation",null,null,null,1.0,"daintou","OutSine",0.5],["goon"],["w",0.5],["mrt",1,"u","009",null,null],["say","avg3_100","The mood here is a little thick...==W== I should probably try to lighten things up.",2,""],["w",0.5],["mrt",0,"u","012","idea",null],["goon"],["mrt",3,"u",null,null,null],["w",0.5],["mrt",2,"v","007","flurry",null],["say","avg3_100","Ahem. That's on me. I prepped the fish. Guess I missed a few scales, huh?",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_155","b","002","happy",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_155","Heh, ever the peacemaker, aren't you, Boss?",0,""],["w",0.5],["se","se_050"],["ctl","avg1_155","b","007",null,null,null,null,1.0,"zuochupeng","OutSine",0.5],["say","avg1_155","Hey, Karin. Even the Boss can tell something's weighing on you. Talk to us about it, will you?",0,""],["w",0.5],["ctl","avg1_157","b","017","speechless",null,null,null,1.0,null,"OutSine",0.5],["w",1.5],["ctl","avg1_157","b","004",null,null,null,null,1.0,null,"OutSine",0.5],["say","avg1_157","You're the one who's been off since we got back. You've just been moping around, and you barely even touched your soup... Don't think I didn't notice.",0,""],["w",0.5],["ctl","avg1_157","b","014","exclamation",0.4,null,null,1.0,null,"OutSine",0.5],["say","avg1_157","\"Talk to us about it\"? Shia, you're the one holding everything in!",0,""],["w",0.5],["se","se_146"],["ctl","avg1_155","b","011",null,null,null,null,1.0,"chijing","OutSine",0.5],["say","avg1_155","Huh? I'm not... Where's all this coming from anyway?",0,""],["w",0.5],["ctl","avg1_157","b","013","symbol",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_157","It's what those people were saying, isn't it?!==W== Ugh, I'm gonna stuff them in a salted fish barrel one by one! That'll teach 'em to spread rumors!",0,""],["w",0.5],["ctl","avg1_157","b","007","angry",null,null,null,null,"jushou2","Linear",0.5],["goon"],["w",0.5],["mrt",1,"v","004","exclamation",null],["say","avg3_100","She's right! Someone oughta sew their mouths shut!",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_155","b","003","speechless",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_155","Hehe...==W== I don't know what to do with you two.",0,""],["w",1.0],["ctl","avg1_155","b","014","sigh",null,null,null,1.0,null,"OutSine",0.5],["goon"],["w",0.5],["ctl","avg1_157","b","005",null,null,null,null,null,null,"Linear",0.5],["ctl","avg1_155","b","012",null,null,null,null,1.0,"niunie1","OutSine",0.5],["say","avg1_155","Karin, Boss, you're both right. When you can't figure something out on your own, it's better to share the burden.",0,""],["w",0.5],["bgm",""],["ctl","avg1_157","b",null,null,0.3,null,null,0.0,null,"Linear",0.5],["hide","avg1_157",0.5],["se","se_062"],["ctl","avg1_155","b","011",null,0.5,null,null,1.0,null,"OutSine",0.5],["say","avg1_155","There is something ...==W== that has been haunting me for a long, long time.",0,""],["w",1],["ctl","avg1_155","b",null,"vexation",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["mrt",1,"v","002",null,null],["say","avg3_100","What?!",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_155","b","017","speechless",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_155","When Granny returned all those years ago, everyone saw how badly hurt she was, wrapped in bandages from head to toe.",0,""],["w",0.5],["bgm","m3"],["bg","mood_3",0,0.5],["ctl","avg1_155","b","012",null,null,null,null,1.0,"chijing","OutSine",0.5],["say","avg1_155","But ... I'm the only one who knew the truth. She wasn't injured at all. The bandages were just for show.",0,""],["w",0.5],["se","se_053"],["stg",0,null,null,null,"Linear",0.5,null,null,"Zhong"],["say","avg1_157","Wh-What...? How is that possible?!",0,""],["w",0.5],["trn",0,0,true,false,1.0],["w",1.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["bg","BG_Black",0,0.5],["w",0.5],["trn",1,0,false,false,1.0],["w",1.0],["se","se_168"],["say","avg1_155","The first night she was back, I was too worried to sleep, so I snuck into her room to check on her.",0,""],["w",0.5],["show","avg3_201","b","007",0.5,null,null,0,null,0.0],["ctl","avg3_201","b",null,null,null,null,null,1.0,null,"OutSine",0.5],["w",1.5],["se","se_077"],["ctl","avg3_201","a","002",null,null,null,null,null,"JuGong1","OutSine",0.5],["say","avg1_155","And that's when I saw it. She'd taken all the bandages off. There wasn't a single scratch on her.",0,""],["w",0.5],["ctl","avg3_201","a","002",null,null,null,null,0.0,null,"OutSine",0.5],["w",0.5],["say","avg1_155","By the next morning, she was all wrapped up again... I never understood why she did it.",0,""],["w",0.5],["trn",0,0,true,false,1.0],["w",1.0],["bg","cabin_night",0,0.5],["w",0.5],["trn",1,0,false,false,1.0],["w",1.0],["show","avg1_155","b","016",null,null,null,0,null,0.0],["ctl","avg1_155","b",null,"vexation",null,null,null,1.0,"chijing","OutSine",0.5],["say","avg1_155","A few days later, I worked up the courage to ask. She denied everything. Said I was confusing nightmares with reality in my distress...",0,""],["w",0.5],["ctl","avg1_155","b","011","exclamation",null,null,null,1.0,"jushou2","OutSine",0.5],["say","avg1_155","But I know what I saw. It was real.",0,""],["w",0.5],["mrt",1,"v","002",null,null],["say","avg3_100","I mean, if she really ran into it, there's no way she'd get away without a scratch. The ghosts in the legends aren't exactly friendly.",1,""],["mrt",0,"u","020","think",null],["say","avg3_100","She didn't get hurt, yet pretended to be seriously injured...==W== Was it to deepen people's fear of the Ghost Ship?",2,""],["w",1.0],["se","se_030"],["mrt",0,"u","009",null,null],["goon"],["mrt",3,"u",null,null,null],["w",0.5],["stg",0,60.0,null,null,"Linear",0.5,null,null,null],["ctl","avg1_155","b",null,null,0.65,null,null,null,null,"Linear",0.5],["show","avg1_157","b","006",0.25,null,null,0,null,0.0],["ctl","avg1_157","b",null,"flurry",0.3,null,null,1.0,null,"OutSine",0.5],["say","avg1_157","W-Why are you making it sound even creepier—Aaaah!",0,""],["w",0.5],["ctl","avg1_155","b","016","vexation",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_155","That \"diary\" those people mentioned... It's been bothering me. Granny kept a meticulous ship's log for every voyage. If she couldn't write at sea, she'd fill it in the moment she got back.",0,""],["w",0.5],["ctl","avg1_155","b","017",null,null,null,null,1.0,null,"OutSine",0.5],["say","avg1_155","But I leafed through her logbooks once. That specific trip was the only one without a single entry.",0,""],["ctl","avg1_155","b","014","sigh",null,null,null,1.0,"chijing","OutSine",0.5],["say","avg1_155","That's why on this voyage, we have to constantly get our bearings, keep a sharp lookout to log our position, and adjust our course as needed.",0,""],["w",0.5],["ctl","avg1_157","b","010","happy",null,null,null,1.0,"jushou2","OutSine",0.5],["say","avg1_157","She must have left it blank on purpose, right? It'd be a huge problem if someone else got the log and tried to follow her route.",0,""],["w",0.5],["mrt",1,"v","014","music",null],["say","avg3_100","My thoughts exactly. With other Trekkers searching for the Ghost Ship, your grandma probably left it out on purpose.",1,""],["mrt",0,"v","002","idea",null],["say","avg3_100","We still need more intel... My companions are investigating back in town. I'll check in with them and see if they've dug up any new leads.",1,""],["mrt",3,"v",null,null,null],["w",0.5],["se","se_077"],["ctl","avg1_155","b","002",null,null,null,null,1.0,"JuGong1","OutSine",0.5],["say","avg1_155","Okay. We're counting on you, Boss.",0,""],["w",0.5],["ctl","avg1_155","b",null,null,0.7,null,null,0.0,null,"Linear",0.5],["ctl","avg1_157","b","012","star",0.45,null,null,1.0,null,"OutSine",0.5],["say","avg1_157","Your grandma was an impressive fighter! She must have beaten all the ghosts, which was why she came back unscathed!",0,""],["w",0.5],["bgm",""],["mrt",1,"v","020","speechless",null],["say","avg3_100","If that were the case, why wouldn't she write \"all ghosts defeated\" in her log? The fact that she didn't ... could mean...",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_157","b","016","question",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_157","M-Mean...?",0,""],["w",0.5],["mrt",1,"v","009",null,null],["say","avg3_100","It means...==W== Karin might still get her chance to join the Ghost Ship's crew.",1,""],["w",0.5],["se","se_368"],["tsk","Zhong"],["mrt",0,"v","006",null,null],["goon"],["mrt",3,"v",null,null,null],["w",0.5],["se","se_070"],["stg",0,null,null,null,"Linear",0.5,null,null,"Zhong"],["ctl","avg1_157","b","019",null,null,null,null,1.0,"chijing","OutSine",0.5],["say","avg1_157","Aaaaah—==W==Stop it!! Now you're just messing with me, Boss!!",0,""],["w",0.5],["ctl","avg1_157","b",null,"exclamation",null,-0.35,1.5,null,null,"Linear",0.3],["goon"],["w",0.5],["bgm","m37"],["mrt",1,"v","013","happy",null],["say","avg3_100","I'm just exploring the possibilities. If you're scared now, what will you do if we find a real ghost? Think you could even hold the camera steady?",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_157","b","020","resentful",null,0.0,1.0,1.0,"jushou2","OutSine",0.3],["say","avg1_157","Wh-Who says I'm scared?!",0,""],["w",0.5],["mrt",1,"v","025","exclamation",null],["say","avg3_100","Look out! Behind you!",1,null],["mrt",3,"v",null,null,null],["w",0.5],["stg",0,null,null,null,"Linear",0.5,null,null,"Zhong"],["se","se_099"],["ctl","avg1_157","b","022",null,0.3,0.0,1.0,1.0,"jushou2","OutSine",0.5],["w",0.5],["stg",0,-60.0,null,null,"Linear",0.5,null,null,null],["se","se_099"],["ctl","avg1_157","b",null,null,0.85,null,null,null,"jushou2","Linear",0.5],["ctl","avg1_155","b",null,null,null,null,null,1.0,null,"Linear",0.5],["say","avg1_157","Waaaaaaugh—!!!",0,""],["w",1.0],["ctl","avg1_155","b","004","happy",null,null,null,1.0,"niunie1","OutSine",0.5],["say","avg1_155","Hehe. Alright, Boss, that's enough teasing. Any more and poor Karin will be too scared to sleep tonight.",0,""],["w",0.5],["ctl","avg1_157","b","020","exclamation",0.45,null,null,1.0,"jushou2","OutSine",0.5],["say","avg1_157","Th-That's not true! I'm totally fine sleeping by myself!",0,""],["w",0.5],["mrt",1,"u","010","sigh",null],["say","avg3_100","Heh... Looks like everyone's finally loosened up a bit.",2,""],["mrt",3,"u",null,null,null],["w",0.5],["bgm",""],["trn",0,0,true,false,1.0],["w",1.0],["bg","sky_night_b",0,0.5],["w",0.5],["cbg",0,null,null,1.1,"Linear",0.0,null,null,null],["se","se_025"],["trn",1,0,false,false,1.0],["w",1.0],["cbg",0,null,80.0,null,"Linear",2.0,null,null,null],["w",1.5],["say","0","It's my turn for the night watch. I sort through the intel we have and give Mistique a call.",0,""],["w",0.5],["se","se_025_stop"],["trn",0,0,false,false,0.5],["w",0.5],["bg","BG_Black",5,0.0],["show","avg1_135","c","004",null,null,null,5,null,null],["stage",5,0,0],["bg","deck_night",0,0.0],["trn",1,0,false,false,0.5],["w",1.0],["se","se_055"],["mrt",1,"v","003",null,null],["say","avg3_100","...==W== So, that's what we've got. Any updates on your end?",1,""],["w",1.0],["mrt",0,"v","002","question",null],["goon"],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_135","c","003","music",null,null,null,1.0,"JuGong1","OutSine",0.5],["say","avg1_135","Of course! After a few days of clandestine investigation, this witch has unearthed something spectacular!★",0,""],["w",0.5],["mrt",1,"v","002","attention",null],["say","avg3_100","Oh? I'm all ears.",1,""],["mrt",3,"v",null,null,null],["bgm","m42"],["w",0.5],["ctl","avg1_135","c","004","speechless",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_135","Back then, several Trekker crews were tailing Marlene, but they were hit by a storm. Most of the ships turned back, all but one.",0,""],["ctl","avg1_135","c","010",null,null,null,null,1.0,null,"OutSine",0.5],["say","avg1_135","One Trekker weathered the storm and kept sailing after her. He was a zealous treasure hunter, convinced there were deep-sea treasures at the source of the light.",0,""],["w",0.5],["mrt",1,"v","002","question",null],["say","avg3_100","Hold on... You don't think the diary that group had today belonged to him, do you?",1,""],["mrt",0,"v","020",null,null],["say","avg3_100","But why are they so certain the light comes from a Monolith?",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_135","c",null,null,null,null,null,0.0,null,"OutSine",0.5],["bg","BG_Black",5,0.5],["w",0.5],["se","se_055"],["stg",5,null,350.0,1.5,"Linear",0.0,null,null,null],["say","avg1_135","—Because the man chronicled what he saw with his own eyes:==W== the source of the light was a colossal object on an island.",0,""],["w",0.5],["bg","view_wasteland_night",5,0.5],["se","se_185"],["goon"],["w",0.5],["mrt",1,"v","025","symbol",null],["say","avg3_100","What?!",1,""],["mrt",3,"v",null,null,null],["w",0.5],["bg","BG_Black",5,0.5],["w",0.5],["stg",5,0.0,0.0,1.0,"Linear",0.0,null,null,null],["ctl","avg1_135","c","003",null,null,null,null,1.0,null,"OutSine",0.5],["say","avg1_135","A massive, glowing object rising from an island...==W== It could only be a Monolith right?",0,""],["w",0.5],["ctl","avg1_135","c","005","star",null,null,null,1.0,null,"OutSine",0.5],["goon"],["w",0.5],["mrt",1,"v","015",null,null],["say","avg3_100","If that's the case, why do most people still cling to Marlene's version of the \"Ghost Ship\" story?",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_135","c","003",null,null,null,null,1.0,null,"OutSine",0.5],["say","avg1_135","Well, who are you more likely to trust? The living, or the dead?",0,""],["w",0.5],["mrt",1,"v","009",null,null],["say","avg3_100","So you're saying ... he never made it back? No wonder that crew said his luck crapped out on him.",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_135","c","004",null,null,null,null,1.0,null,"OutSine",0.5],["say","avg1_135","Precisely. When his ship was recovered, all that was left aboard were his skeletal remains and a diary.",0,""],["ctl","avg1_135","c","010","sigh",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_135","He was gravely injured in the storm and suffered a psychotic break. The latter half of the diary is incoherent—even his own family dismissed it as feverish delirium.",0,""],["w",0.5],["mrt",1,"v","020",null,null],["say","avg3_100","I see...==W== So how did his diary end up in their possession?",1,""],["w",0.5],["mrt",0,"v","002","question",null],["goon"],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_135","c","005","happy",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_135","Who knows? They likely offered a handsome sum for it. One can hardly blame the family for selling...★",0,""],["w",0.5],["mrt",1,"v","009",null,null],["say","avg3_100","Right...==W== By the way, was there any mention of Marlene in the diary?",1,""],["w",0.5],["bgm",""],["mrt",0,"v","002","attention",null],["goon"],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_135","c","004",null,null,null,null,1.0,null,"OutSine",0.5],["say","avg1_135","His family didn't mention her, no. I'll have to investigate that further~",0,""],["ctl","avg1_135","c","010","sigh",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_135","Very few people are privy to this. It took considerable effort to persuade them to talk, you know.",0,""],["w",0.5],["bg","mood_1",5,0.5],["ctl","avg1_135","c","005","music",null,null,null,1.0,"jushou2","OutSine",0.5],["say","avg1_135","In exchange, you need to keep close tabs on that crew for me, Boss~",0,""],["w",0.5],["mrt",1,"v","002",null,null],["say","avg3_100","Understood. I'll let you know the moment I learn anything.",1,""],["mrt",3,"v",null,null,null],["w",0.5],["se","se_118"],["stage",5,1,7],["w",1.0],["mrt",1,"u","020","speechless",null],["say","avg3_100","Okay, at least I know where the rumor came from now. But how am I going to tell Shia and Karin?",2,""],["mrt",0,"u","009",null,null],["say","avg3_100","They trust their grandmother so much...",2,""],["mrt",3,"u",null,null,null],["w",0.5],["end"]]}