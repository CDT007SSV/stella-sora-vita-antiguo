,"OutSine",0.5],["goon"],["w",0.5],["bg","mood_3",0,1.0],["ctl","avg2_990","b","003","speechless",null,null,null,1.0,null,"OutSine",0.5],["say","Treasure Hunter Leader","D-Don't tell me ... she was a ...==W== g-g-ghost?!",0,""],["w",1.0],["stg",0,null,null,null,"Linear",1.0,null,null,"zhenjing"],["se","se_112"],["ctl","avg2_990","b","010",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["trn",0,0,false,false,0.5],["w",0.5],["bg","cabin_night",0,0.0],["trn",1,0,false,false,0.5],["w",0.5],["se","se_368"],["show","avg2_983","b","002",0.65,null,null,0,null,0.0],["ctl","avg2_983","b",null,null,0.6,null,null,1.0,null,"Linear",0.5],["w",0.5],["ctl","avg2_983","b",null,null,null,null,null,null,"zuochupeng","Linear",1.0],["w",1.5],["se","se_356"],["ctl","avg2_990","b",null,null,null,null,null,null,"chijing","Linear",0.5],["w",0.5],["trn",0,0,true,false,0.2],["w",0.2],["bg","sky_night_b",0,0.5],["w",0.5],["trn",1,0,false,false,0.2],["w",0.2],["fx",0,"fx_speedline_center_w",0,0],["se","se_063"],["say","Treasure Hunter Leader","Waaaaaaaaah—!!",0,""],["w",0.5],["cbg",0,null,90.0,1.1,"Linear",10.0,null,null,null],["bgm","m36"],["se","se_053"],["say","Clumsy Treasure Hunter","Boss?! Boss, what's wrong?!",0,""],["w",0.5],["se","se_046"],["tsk","Zhong"],["say","Thuggish Treasure Hunter","It's all your fault! You sneaked up on her and scared her half to death! Don't you know she's terrified of ghosts?!",0,""],["w",0.5],["se","se_124"],["say","Clumsy Treasure Hunter","S-Sorry, boss! I was just bringing you a late-night snack ... and forgot to knock...",0,""],["w",0.5],["stg",0,null,null,null,"Linear",1.0,null,null,"Zhong"],["bgm",""],["se","se_070"],["say","Treasure Hunter Leader","A ghost! GHOST! Stay away from me—!!",0,""],["w",0.5],["trn",0,0,true,false,1.0],["w",1.0],["bg","deck_night",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0,null,null,null],["trn",1,0,false,false,1.0],["w",1.5],["show","avg1_157","b","003",null,null,null,0,null,0.0],["se","se_186"],["ctl","avg1_157",