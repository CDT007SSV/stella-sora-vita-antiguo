5","b",null,null,0.65,null,null,null,null,"Linear",0.5],["ctl","avg1_157","a",null,"resentful",0.35,null,null,1.0,"jushou2","OutSine",0.5],["say","avg1_157","That's right! My salted fish bucket is ready! You all better be prepared to be beaten into fishcakes!",0,""],["w",0.5],["clear",1,0.5,1],["se","se_070"],["bg","mood_4",0,0.5],["stg",0,null,null,null,"Linear",0.5,null,null,"Zhong"],["show","avg2_991","b","011",0.75,null,null,0,null,0.0],["show","avg2_983","b","008",0.3,null,null,0,null,0.0],["show","avg2_984","b","008",0.15,null,null,0,null,0.0],["show","avg2_990","b","011",0.55,null,null,0,null,0.0],["ctl","avg2_991","b",null,null,0.75,null,null,1.0,null,"OutSine",0.5],["ctl","avg2_983","b",null,null,0.3,null,null,1.0,null,"OutSine",0.5],["ctl","avg2_984","b",null,null,0.15,null,null,1.0,null,"OutSine",0.5],["ctl","avg2_990","b",null,null,0.55,null,null,1.0,null,"OutSine",0.3],["say","Treasure Hunter Crew","W-WE'RE SO SORRY—!!!",0,""],["w",0.5],["bgm",""],["trn",0,0,true,false,1.0],["w",1.0],["bg","BG_Black",0,0.5],["w",0.5],["trn",1,0,false,false,1.0],["w",1.0],["say","0","And so, the treasure hunters apologize to us, promise to clear up all the rumors about Granny, and swear they would never return to this island to disturb the Hexhorn Whale.",0,""],["w",0.5],["trn",0,0,false,false,1.0],["w",1.0],["se","se_431"],["bg","view_whale_2",0,0.5],["w",0.5],["cbg",0,null,null,1.1,"Linear",0.0,null,null,null],["trn",1,0,false,false,1.0],["w",1.0],["cbg",0,null,null,1.0,"Linear",10.0,null,null,null],["se","se_347"],["say","0","At sunrise, we set off on our return journey. The Hexhorn Whale swims alongside the boat, saying goodbye.",9,""],["w",1.5],["se","se_431_stop"],["se","se_021"],["say","0","Bathed in warm morning light, Shia and Karin open the long-sealed diary:",9,""],["w",1.0],["bgm","m6"],["say","0","==A-1==\"... Calor Month 18th, Cloudy. This is my third day on the island. Whally helped me recover the boat, but it was too damaged to repair.\"==P== \"==A-1==Calor Month 21st, Cloudy. I found a dying Hexhorn Whale on the beach. Whally was very sad. I could only watch as it stopped breathing. I collected some shells and placed them beside it, hoping it would have a long, peaceful dream.\"==P== ==A-1==\"Calor Month 30th, Sunny. I built a new ship and was ready to go back. Whally didn't want me to leave. I don't know if I can protect their home from other people in the future.\"",10,""],["w",0.5],["bg","deck_daylight",0,0.5],["w",0.5],["show","avg1_155","b","009",null,null,null,0,null,0.0],["ctl","avg1_155","b",null,"attention",null,null,null,1.0,null,"OutSine",0.5],["say","avg1_155","This is the last entry. I remember Granny returned to town a few days later.",0,""],["w",0.5],["show","avg1_157","b","006",0.3,null,null,0,null,0.0],["ctl","avg1_157","b",null,"question",0.35,null,null,1.0,null,"OutSine",0.5],["ctl","avg1_155","b",null,null,0.65,null,null,null,null,"Linear",0.5],["w",0.5],["say","avg1_157","There's nothing else? Let me see...==W== Huh? There's something written on the back cover!",0,""],["w",0.5],["ctl","avg1_157","b","016","exclamation",null,null,null,null,"jushou2","Linear",0.5],["tsk","Zhong"],["goon"],["w",0.5],["clear",1,0.5,1],["bg","BG_Black",0,0.5],["w",0.5],["se","se_055"],["say","0","\"To the person reading this: if you are not Shia, please stop here. The following words are what I have always wanted to say but never had the chance to.\"",8,""],["w",1.0],["bg","deck_daylight",0,0.5],["w",0.5],["show","avg1_155","b","009",null,null,null,0,null,0.0],["ctl","avg1_155","b",null,"symbol",null,null,null,1.0,"chijing","Linear",0.5],["w",0.5],["say","avg1_155","This is ... for me?!",0,""],["w",0.5],["ctl","avg1_155","b",null,null,null,null,null,0.0,null,"Linear",0.5],["hide","avg1_155",0.5],["w",0.5],["bg","sky_sunny",0,0.5],["w",0.5],["show","avg3_201","a","003",0.75,-0.5,1.5,0,null,0.0],["ctl","avg3_201","a",null,null,null,null,null,0.9,null,"Linear",0.5],["w",0.5],["se","se_022"],["say","0","==A-1==\"Shia, congratulations. You've figured out the truth through your own efforts. You must be an amazing seafaring Trekker now.\"==P== ==A-1==\"The source of the light is these bones. It is neither a ghost ship, nor treasures. You must be surprised, right? Only a third-rate Trekker would be discouraged by it not being treasures.\"==P== ==A-1==\"I believe you understand, that this island is the sacred resting place of Hexhorn Whales. To prevent greedy people from disturbing them, I will make up a ghost ship story. Please continue to protect this island in my place.\"",10,""],["se","se_022_stop"],["w",0.5],["ctl","avg3_201","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["chd",0,3,"avg1_157","b","018","star"],["say","avg1_157","That's Granny. She knew those \"third-rate Trekkers\" would follow us.",0,""],["w",0.5],["mrt",2,"v","002","attention",null],["say","avg3_100","And she knew you'd find your way here even before she left the island.",1,""],["mrt",3,"v",null,null,null],["w",0.5],["chd",1,3,"avg1_157","a","002",null],["ctl","avg3_201","a",null,null,null,null,null,0.9,null,"Linear",0.5],["w",0.5],["se","se_022"],["say","0","==A-1==\"I'm sorry, Shia. Please forgive me for keeping this from you all this time. You were still young, and I was worried you might accidentally let it slip. It would bring too much danger, and I fear I couldn't protect you.\"==P== ==A-1==\"You must be all grown up now, right? I really wish I could see what you've become... But unfortunately, I won't have the chance.==P== ==A-1==Alright, don't be sad. Even if I've left this world, I will always be by your side, just like the sea.==P== ==A-1==You are my most precious treasure.\"",10,""],["se","se_022_stop"],["w",0.5],["ctl","avg3_201","a",null,null,null,null,null,0.0,null,"Linear",0.5],["hide","avg3_201",0.5],["w",0.5],["bg","deck_daylight",0,0.5],["w",0.5],["mrt",1,"u","023","think",null],["say","avg3_100","To Granny, the most precious treasure was Shia...",2,""],["mrt",3,"u",null,null,null],["w",0.5],["show","avg1_155","b","017",null,null,null,0,null,0.0],["se","se_186"],["ctl","avg1_155","b",null,null,null,null,null,1.0,"chijing","OutSine",0.5],["say","avg1_155","Thank you, Boss. Thanks to you, we got to read Granny's diary.",0,""],["w",0.5],["ctl","avg1_155","b","003","love",null,null,null,1.0,"niunie1","OutSine",0.5],["say","avg1_155","And... I finally understand what was in her heart.",0,""],["w",0.5],["stg",0,60.0,null,null,"Linear",0.5,null,null,null],["w",0.5],["show","avg1_157","b","008",0.3,null,null,0,null,0.0],["ctl","avg1_155","b",null,null,0.6,null,null,null,null,"Linear",0.5],["se","se_112"],["ctl","avg1_157","b",null,null,null,null,null,1.0,"chijing","OutSine",0.5],["say","avg1_157","Uwahh… Granny…",0,""],["w",0.5],["ctl","avg1_155","b","009","attention",null,null,null,null,null,"Linear",0.5],["say","avg1_155","Oh, little Karin, why are you crying?",0,""],["w",0.5],["mrt",1,"v","013","happy",null],["say","avg3_100","Good thing the sun is already up, or you might attract ghosts.",1,""],["mrt",3,"v",null,null,null],["bgm",""],["w",0.5],["se","se_146"],["ctl","avg1_157","b","006",null,null,null,null,1.0,"chijing","OutSine",0.5],["w",1.0],["ctl","avg1_155","b",null,null,null,null,null,0.0,null,"Linear",0.2],["hide","avg1_155",0.2],["ctl","avg1_157","b","022","resentful",0.45,-0.35,1.5,1.0,"jushou2","OutSine",0.3],["say","avg1_157","There you go again! You won't scare me anymore! Boss, just you wait...",0,""],["w",1.0],["trn",0,0,true,false,0.5],["w",0.5],["se","se_430"],["stg",0,null,null,1.0,"Linear",2.0,null,null,null],["w",2.0],["trn",1,0,false,false,0.5],["w",1.0],["show","avg1_155","b","003",0.5,null,null,0,null,0.0],["ctl","avg1_155","b",null,"happy",null,null,null,1.0,"niunie1","OutSine",0.5],["say","avg1_155","Granny… Don't worry. I'm not alone anymore.",0,""],["w",0.5],["bg","mood_1",0,0.5],["ctl","avg1_155","b","006","flower",null,null,null,1.0,"JuGong2","OutSine",0.5],["say","avg1_155","By my side, I already have companions, w