,"OutQuad",0.7],["w",0.5],["chd",0,0,"avg3_170","a","006",null],["chd",0,1,"avg3_168","a","006",null],["ctl","avg3_170","a",null,"happy",null,null,null,null,"lengzhan","Linear",0.5],["ctl","avg3_168","a",null,"happy",null,null,null,null,"lengzhan","Linear",0.5],["say","Rowdy Kids","Wah—!!",0,""],["w",0.5],["chd",1,0,"avg3_170","a","002",null],["chd",1,1,"avg3_168","a","002",null],["w",0.5],["ctl","avg1_150","b",null,"speechless",null,null,null,null,"zuochupeng","Linear",0.5],["say","avg1_150","Ugh...==W== Not again... Why am I like this...?==W== Why am I different from everyone else...",0,""],["w",1.4],["ctl","avg1_150","b",null,null,null,null,null,null,null,"Linear",0.3],["se","se_440"],["ctl","avg4_101","a",null,null,null,null,null,0.3,null,"Linear",0.3],["w",0.3],["ctl","avg4_101","a",null,null,null,null,null,0.0,null,"Linear",0.3],["goon"],["w",1],["ctl","avg4_101","a",null,null,null,null,null,0.3,null,"Linear",0.3],["w",0.3],["ctl","avg4_101","a",null,null,null,null,null,0.0,null,"Linear",0.3],["goon"],["w",0.5],["bgm",""],["ctl","avg1_150","b","004",null,0.5,null,null,null,null,"OutQuad",0.8],["say","avg1_150","I wanted ...==W== to fish with everyone, too...",0,""],["w",0.5],["ctl","avg1_150","b",null,"sigh",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["se","se_169"],["trn",0,1,true,true,0.5],["w",0.5],["fx",0,"fx_avg_reminiscence_loop",1,0],["bg","city_alley_daylight_winter",0,0.0],["stg",0,0.0,0.0,1.1,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["trn",1,1,false,false,0.5],["w",1.0],["show","avg1_158","a","002",null,null,null,0,null,0.0],["ctl","avg1_158","a",null,null,null,null,null,1.0,null,"Linear",0.5],["w",1.0],["ctl","avg1_158","a","009",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_158","And that's pretty much what happened.==W== When I was a kid, my body would light up whenever I got emotional.==W== Weird, right? It was hard to make friends.",0,""],["w",0.5],["ctl","avg1_158","a","008","sweaty",null,null,null,null,"lengzhan","Linear",0.5],["goon"],["w",0.5],["ctl","avg1_158","a","015",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg1_158","a","003","sigh",null,null,null,null,"diantou","Linear",0.5],["say","avg1_158","By the time I stopped crying, everyone was gone...",0,""],["w",0.5],["mrt",1,"q","021","vexation",null],["say","avg3_100","Sorry,==W== I shouldn't have asked.",1,""],["w",0.5],["mrt",0,"q","009",null,"lengzhan"],["goon"],["mrt",3,"q",null,null,null],["w",0.5],["ctl","avg1_158","a","012","star",null,null,null,null,"diantou","Linear",0.5],["say","avg1_158","Don't worry about it.==W== I've gotten used to it.==W== It didn't really bother—",0,""],["w",0.5],["ctl","avg1_158","a","009","speechless",null,null,null,null,null,"Linear",0.5],["goon"],["w",1.4],["ctl","avg1_158","a","003","sigh",null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["bgm","m45"],["ctl","avg1_158","a","014","resentful",null,-0.18,1.2,null,"JuGong","OutQuad",0.5],["say","avg1_158","Ugh! No, of course it bothers me! I must've been miserable back then...!",0,""],["w",0.5],["ctl","avg1_158","a","013","awkward",null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_158","But if I started to cry, I would glow again...",0,""],["w",0.5],["ctl","avg1_158","a","008",null,null,null,null,null,"lengzhan2","Linear",0.5],["say","avg1_158","The more I tried to hold it in, the worse it got.==W== Honestly, I had no idea what to do.==W== Poor little me...",0,""],["w",0.5],["ctl","avg1_158","a","009",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg1_158","a","015","sigh",null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["ctl","avg1_158","a","007","attention",null,null,null,null,"buman","Linear",0.5],["say","avg1_158","Not long after that, I heard a saying: \"If you make a wish beneath the Snowish Tree, it'll come true.\"",0,""],["w",0.5],["mrt",1,"q","012","question",null],["say","avg3_100","From that very storybook, right?",1,""],["mrt",3,"q",null,null,null],["w",0.5],["ctl","avg1_158","a","012","music",null,null,null,null,"diantou","Linear",0.5],["say","avg1_158","Yes. That's where it came from.",0,""],["w",0.5],["bgm",""],["ctl","avg1_158","a","009",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg1_158","The story goes like this—",0,""],["w",0.5],["se","se_169"],["ctl","avg1_158","a",null,null,null,-0.2,null,0.0,null,"OutQuad",0.8],["stg",0,0.0,0.0,1.0,"Linear",0.8,null,null,null],["bg","city_alley_night_winter",0,0.8],["w",1.3],["bgm","m5"],["cbg",0,null,null,1.1,"Linear",20.0,null,null,null],["say","avg1_158","Long, long ago, when Artifacts were rare, and life was hard...",0,""],["w",0.5],["say","avg1_158","One winter, the snowfall was especially terrible. People quickly ran out of firewood and huddled in their homes, shivering.",0,""],["w",0.5],["se","se_031"],["stg",0,null,null,null,"Linear",0.5,null,null,"Xiao"],["tsk","Xiao"],["say","avg1_158","Then suddenly—thunk! Something fell through a chimney and landed in the ashes of a dead fireplace—it was an Artifact no one had ever seen before.",0,""],["w",0.5],["say","avg1_158","And==W== it wasn't just that one family.==W== Every household received one.",0,""],["w",0.5],["se","se_056"],["goon"],["w",0.5],["goon"],["w",1.0],["bg","field_room_inside_daylight_winter",0,0.8],["w",0.8],["cbg",0,-150.0,null,1.1,"Linear",20.0,null,null,null],["say","avg1_158","They looked strange and all different from one another, but if you just poured a little magic into them, they'd warm the entire house up!",0,""],["w",0.5],["say","avg1_158","Those with chimneys found their Artifacts dropped down through them; those without found theirs hanging on nearby tree branches.",0,""],["w",0.5],["se","se_180"],["say","avg1_158","People went around asking who could have sent such precious gifts, and all they saw was a figure in a red scarf, riding a sleigh through the snow...",0,""],["w",0.5],["say","avg1_158","He called out, \"Have a happy winter season! Accept these gifts!\"",0,""],["w",1.0],["se","se_103"],["bg","forest_winter",0,0.8],["w",0.8],["cbg",0,null,null,1.1,"Linear",20.0,null,null,null],["say","avg1_158","When people followed his trail into the forest, they found a great tree piled high with more gifts...",0,""],["w",0.5],["say","avg1_158","But the sleigh rider was gone, vanished like a spirit.",0,""],["w",0.5],["se","se_095"],["say","avg1_158","Thanks to those Artifacts, everyone survived the blizzard next day in warmth and safety.",0,""],["w",0.5],["say","avg1_158","Believing they were blessings from the God of Grace, people named the tree the \"Snowish Tree.\"",0,""],["w",1.0],["bg","city_park_night_winter",0,0.8],["w",0.8],["cbg",0,null,null,1.1,"Linear",20.0,null,null,null],["say","avg1_158","And the gift-giver became known as the \"Snowish Tree Spirit\" sent by the God of Grace.",0,""],["w",0.5],["se","se_047"],["say","avg1_158","To commemorate this event, people began leaving gift boxes beneath the tree; they also copied the spirit by exchanging presents with friends and family...",0,""],["w",0.5],["say","avg1_158","And that's how the Snowish Festival began.",0,""],["bgm",""],["w",0.5],["stg",0,null,null,1.1,"Linear",0.8,null,null,null],["bg","city_alley_daylight_winter",0,0.8],["ctl","avg1_158","a",null,null,null,-0.18,null,1.0,null,"OutQuad",0.8],["w",1.3],["bgm","m57"],["ctl","avg1_158","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_158","Every kid probably thinks that after making a wish, the gift they want might just appear beneath the tree...==W== Something like that.",0,""],["w",0.5],["ctl","avg1_158","a","007","attention",null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["ctl","avg1_158","a","003","sigh",null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_158","But even back then, I wasn't that naive. I didn't believe in something like that would just happen to me.",0,""],["w",0.5],["ctl","avg1_158","a","004",null,null,null,null,null,null,"Linear",0.5],["say","avg1_158","After all...==W== If you're going to make a wish, you should be looking for a Wishing Box in the Monolith, not some tree.",0,""],["w",0.5],["ctl","avg1_158","a","012","happy",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg1_158","a","004",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg1_158","But a kid can't go exploring the Monolith alone, right?==W== So I went to the tree instead, to make a wish I knew wouldn't come true.",0,""],["w",0.5],["ctl","avg1_158","a","008","awkward",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg1_158","a","005","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_158","That photo ...==W== must've been taken then.",0,""],["w",1.4],["ctl","avg1_158","a","008","flurry",null,null,null,null,"lengzhan","Linear",0.5],["goon"],["w",0.5],["mrt",1,"q","021",null,null],["say","avg3_100","So that's the truth==W== behind the Spirit photo.",1,""],["w",0.5],["mrt",0,"q","009","sweaty","ChanDou"],["goon"],["mrt",3,"q",null,null,null],["w",0.5],["ctl","avg1_158","a","006",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg1_158","Pretty much, yeah! I just never imagined I'd end up being passed around as some kind of \"Snowish Tree Spirit\"...==W== Hahaha!",0,""],["w",0.5],["ctl","avg1_158","a",null,"happy",null,null,null,null,"ChanDou","Linear",0.5],["goon"],["w",0.5],["mrt",1,"q","003",null,null],["say","avg3_100","Not your everyday experience, for sure.",1,""],["w",0.5],["mrt",0,"q","002",null,null],["say","avg3_100","So there's no spirit, after all.",1,""],["mrt",3,"q",null,null,null],["w",0.5],["se","se_101"],["ctl","avg1_158","a","008",null,0.45,null,null,null,null,"OutQuad",0.4],["say","avg1_158","Right...==W== But ...==W== not entirely...",0,""],["w",0.3],["se","se_101"],["ctl","avg1_158","a","013",null,0.5,null,null,null,null,"OutQuad",0.5],["goon"],["w",0.3],["ctl","avg1_158","a",null,"awkward",null,null,null,null,"lengzhan","Linear",0.5],["w",0.5],["goon"],["w",0.5],["mrt",2,"q","012","question",null],["say","avg3_100","Yeah?",1,""],["mrt",4,"q",null,null,null],["w",0.5],["bgm",""],["se","se_101"],["ctl","avg1_158","a","002",null,null,-0.33,1.4,null,null,"OutQuad",0.5],["say","avg1_158","The Spirit ...==W== really does exist.",0,""],["w",0.5],["ctl","avg1_158","a","011","music",null,null,null,null,"diantou","Linear",0.5],["tsk","Xiao"],["goon"],["end"]]}