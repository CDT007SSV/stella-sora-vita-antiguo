,"z",null,null,null],["w",0.5],["bg","story_event_03_001",0,1.0],["w",1.0],["say","avg1_159","You seem so intrigued. Shall I take you to the tailor? We could get an outfit made for you, too.",9,""],["w",0.5],["choice",["That's kind of you... But I'll pass."],[[]]],["w",0.5],["se","se_057"],["say","avg1_159","Really? A pity. I was curious to see how you would look in Loong's fashion.",9,""],["w",0.5],["trn",0,0,false,false,1.0],["w",1.0],["bg","phoenix_food_street",0,0.5],["w",0.5],["trn",1,0,false,false,1.0],["w",1.0],["show","avg1_159","a","007",0.45,null,null,0,null,0.0],["ctl","avg1_159","a","007","speechless",null,null,null,1.0,null,"Linear",0.5],["say","avg1_159","Since we're both here, why don't we walk together? You could guide me through the sights of Cangwu...",0,""],["bgm",""],["ctl","avg1_159","a","008","sigh",null,null,null,null,"chijing","Linear",0.5],["say","avg1_159","Or so I'd like to say. But I have urgent matters to attend to.==W== ==PLAYER_NAME==, do you know the way to the Baize Bureau?",0,""],["w",0.5],["ctl","avg1_159","a","005","question",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["mrt",2,"z","002","attention",null],["say","avg3_100","You're heading to the Bureau too? Perfect. I'm actually on my way there right now.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_159","a","003","question",null,null,null,null,null,"Linear",0.5],["say","avg1_159","\"Too\"? Has anything happened?",0,""],["w",0.5],["mrt",1,"z","009","vexation",null],["say","avg3_100","Yeah. My friends, the New Star Guild members, have gone missing.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_159","a","005","attention",0.5,-0.35,1.5,null,null,"Linear",0.3],["say","avg1_159","What a coincidence.==W== I can't reach Jinglin, either.",0,""],["w",0.5],["se","se_030"],["ctl","avg1_159","a","011",null,null,null,null,null,null,"Linear",0.5],["bg","BG_Black",0,0.5],["w",0.5],["show","avg1_117","a","002",0.2,-0.35,1.8,0,null,0.0],["ctl","avg1_117","a",null,null,null,null,null,0.2,null,"Linear",0.5],["goon"],["w",0.5],["mrt",2,"z","025","symbol",null],["say","avg3_100","What?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["trn",0,0,true,false,1.0],["w",1.0],["bg","agency_daylight",0,0.5],["w",0.5],["trn",1,0,false,false,1.0],["w",1.0],["bgm","m12"],["show","avg1_113","b","012",null,null,null,0,null,0.0],["ctl","avg1_113","b",null,"speechless",null,null,null,1.0,null,"Linear",0.5],["w",0.5],["say","avg1_113","I see.",0,""],["ctl","avg1_113","b",null,null,null,null,null,null,null,"Linear",0.0],["w",0.5],["ctl","avg1_113","b","002",null,null,null,null,null,"JuGong1","Linear",0.5],["say","avg1_113","==PLAYER_NAME== arrived near Cangwu with Noya, Amber, and Iris on a commission, stopping here to rest and resupply.",0,""],["ctl","avg1_113","b","016",null,null,null,null,null,null,"Linear",0.5],["say","avg1_113","After arriving yesterday, the three of them split off with you to take a side commission. After that, ==PLAYER_NAME== lost contact with them.",0,""],["w",0.5],["se","se_074"],["stg",0,60.0,null,null,"Linear",0.5,null,null,null],["show","avg1_159","a","002",0.2,null,null,0,null,0.0],["ctl","avg1_159","a",null,null,0.25,null,null,1.0,null,"Linear",0.5],["ctl","avg1_113","b",null,null,0.65,null,null,1.0,null,"OutSine",0.5],["w",0.5],["say","avg1_113","As for Ms. Coronis, she has known Jinglin since treating her mother in Philae. She came here on vacation at Jinglin's invitation.",0,""],["w",0.5],["ctl","avg1_159","a","004",null,0.25,null,null,null,null,"Linear",0.5],["ctl","avg1_113","b","014",null,null,null,null,1.0,null,"Linear",0.5],["say","avg1_113","However, when she visited Jinglin's home yesterday, she learned that Jinglin had gone out and never returned.",0,""],["w",0.5],["mrt",1,"z","010","sigh",null],["say","avg3_100","I still can't reach any of them. We'd look for clues ourselves, but we don't know our way around as Coronis and I are new to Cangwu.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_146"],["ctl","avg1_113","b","004",null,null,null,null,null,"chijing","Linear",0.5],["say","avg1_113","I understand. Ordinarily, I'd lead the search myself, but I have urgent official business I cannot step away from...",0,""],["w",0.5],["ctl","avg1_159","a",null,null,0.2,null,null,0.0,null,"Linear",0.3],["ctl","avg1_113","b","009","exclamation",0.5,null,null,null,"jushou2","Linear",0.5],["say","avg1_113","I will, however, alert my colleagues to keep a lookout. If any leads surface, I'll notify you immediately.",0,""],["w",1.0],["bgm",""],["ctl","avg1_113","b",null,null,null,null,null,0.0,null,"Linear",0.3],["w",0.3],["cbg",0,-150.0,-100.0,1.3,"Linear",0.5,null,null,null],["w",0.5],["se","se_071"],["say","avg3_999","In that case, leave it to me!",0,""],["w",0.5],["ctl","avg1_113","b","015",null,0.3,null,null,0.0,null,"Linear",0.0],["bg","agency_daylight",0,0.5],["w",0.5],["show","avg1_141","b","016",0.7,null,null,0,null,0.0],["ctl","avg1_141","b",null,"star",0.6,null,null,1.0,null,"Linear",0.5],["w",1.0],["bgm","m44"],["ctl","avg1_113","b",null,"shock",0.3,null,null,1.0,null,"Linear",0.5],["say","avg1_113","Chixia? What are you doing here?",0,""],["ctl","avg1_113","b",null,null,null,null,null,1.0,null,"Linear",0.0],["w",0.5],["ctl","avg1_141","b","002","sigh",null,null,null,null,"chijing","Linear",0.5],["say","avg1_141","Got sent on an errand run, what else?",0,""],["w",0.5],["ctl","avg1_141","b",null,null,null,null,null,0.0,"JuGong1","Linear",0.5],["ctl","avg1_113","b",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["se","se_087"],["obj","qstory_event_03_008",0,null,null],["w",0.5],["say","avg1_141","Ta-da! Behold, Shimiao's Miaovelous Sword, polished and good as new! The seniors even added some mods—you're gonna love 'em!",0,""],["w",0.5],["objx"],["w",0.5],["se","se_077"],["ctl","avg1_113","a","009",null,null,null,null,1.0,"JuGong1","Linear",0.5],["say","avg1_113","New mods... Right. Thank you. Please pass on my regards to your seniors as well.",0,""],