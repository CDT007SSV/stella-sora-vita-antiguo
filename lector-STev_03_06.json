",3,"z",null,null,null],["w",0.5],["se","se_493"],["stg",0,null,-60.0,1.1,"Linear",1.0,null,null,null],["ctl","avg1_159","a",null,null,0.25,null,null,0.0,null,"Linear",0.5],["ctl","avg1_141","a",null,null,0.7,null,null,0.0,null,"Linear",0.5],["bg","tower_elevator_unknow",0,0.5],["w",1.5],["ctl","avg1_159","a","008","sigh",null,null,null,1.0,null,"Linear",0.5],["say","avg1_159","Jokes aside, I genuinely hope we won't need to resort to such measures.",0,""],["w",0.5],["bgm",""],["se","se_074"],["ctl","avg1_113","a","016",null,0.7,null,null,1.0,null,"Linear",0.5],["say","avg1_113","Agreed. We must locate them immediately.",0,""],["w",0.5],["mrt",1,"z","002",null,null],["say","avg3_100","Let's move out. Stay sharp.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_060"],["stg",0,null,null,1.15,"Linear",1.0,null,null,null],["ctl","avg1_159","a","002",null,0.2,null,null,0.0,null,"Linear",0.5],["ctl","avg1_113","a",null,null,0.75,null,null,0.0,null,"Linear",0.5],["w",0.5],["trn",0,0,true,false,1.0],["w",1.0],["bg","tower_fire_earth",0,0.5],["w",0.5],["stg",0,60.0,0.0,1.0,"Linear",0.0,null,null,null],["trn",1,0,false,false,1.0],["stg",0,0.0,null,null,"Linear",1.0,null,null,null],["w",0.5],["bgm","m44"],["show","avg1_141","a","008",0.3,null,null,0,null,0.0],["ctl","avg1_141","a",null,"speechless",0.35,null,null,1.0,null,"Linear",1.0],["w",1.0],["say","avg1_141","We've been hiking forever, and there's still no sight of this \"Nian\" that the smuggler was ranting about.",0,""],["w",0.5],["stg",0,-80.0,null,1.05,"Linear",0.5,null,null,null],["show","avg1_113","a","002",0.8,null,null,0,null,0.0],["ctl","avg1_113","a",null,null,null,null,null,1.0,null,"Linear",0.5],["ctl","avg1_141","a",null,"question",0.45,null,null,null,"jushou2","Linear",0.5],["say","avg1_141","Hey, Shimiao, you think Nian actually exists in a place like this?",0,""],["w",0.5],["ctl","avg1_113","a","011","sweaty",null,null,null,null,null,"Linear",0.5],["say","avg1_113","You are the Xuan Shi. Shouldn't this be your area of expertise?",0,""],["w",0.5],["ctl","avg1_113","a","004",null,null,null,null,null,null,"Linear",0.5],["ctl","avg1_141","a","019","shy",null,null,null,null,"niunie1","Linear",0.5],["say","avg1_141","But I've never seen a real one! That's way out of my league!",0,""],["w",0.5],["stg",0,60.0,null,null,"OutSine",1.0,null,null,null],["show","avg1_159","a","005",0.1,null,null,0,null,0.0],["ctl","avg1_159","a",null,"attention",0.15,null,null,1.0,null,"Linear",0.5],["say","avg1_159","I recall Loongs describing the Nian as a formidable creature. Care to tell me more about it?",0,""],["w",0.5],["ctl","avg1_113","a",null,null,null,null,null,0.0,null,"Linear",0.5],["hide","avg1_113",0.5],["ctl","avg1_159","a",null,null,null,null,null,0.0,null,"Linear",0.5],["hide","avg1_159",0.5],["ctl","avg1_141","a","017","speechless",null,null,null,null,null,"Linear",1.0],["w",0.5],["say","avg1_141","Nian is nothing but a massive pest! Used to emerge every festival to wreak havoc.",0,""],["w",0.5],["ctl","avg1_141","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["bg","white",0,0.5],["bg","circle_light",0,0.0],["cbg",0,null,null,3.0,"Linear",0.0,null,null,null],["fx",0,"fx_avg_reminiscence_loop",0,2],["show","avg2_952","a","002",0.45,0.1,1.4,0,null,0.0],["se","se_081"],["ctl","avg2_952","a",null,null,null,null,null,1.0,"guodongtiao1","Linear",0.5],["w",0.5],["say","avg1_141","It'd scare the kids and trash our houses, ruining the big Springseek feast everyone worked so hard on!",0,""],["w",0.5],["ctl","avg2_952","a","002",null,null,null,null,null,null,"OutSine",0.5],["w",0.5],["bg","mood_3",5,0.0],["show","avg1_113","a","012",null,null,null,5,null,1.0],["stage",5,0,4],["se","se_257"],["ctl","avg1_113","a","016",null,null,null,null,null,null,"Linear",0.5],["say","avg1_113","Actually, the ancient texts explicitly state that the creature \"devours humans.\"",0,""],["w",0.5],["trn",0,0,true,false,0.5],["w",0.5],["fx",0,"fx_avg_reminiscence_loop",1,2],["stage",5,1,1],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["bg","tower_fire_earth",0,0.0],["trn",1,0,false,false,0.5],["w",0.5],["stg",0,null,null,null,"Linear",1.0,null,null,"Xiao"],["show","avg1_141","a","019",null,null,null,0,null,0.0],["ctl","avg1_141","a",null,"question",null,null,null,1.0,"chijing","Linear",0.5],["w",0.5],["say","avg1_141","Huh? For real? Maybe there are different versions. My version is my Senior's.",0,""],["se","se_146"],["ctl","avg1_141","a","009",null,null,null,null,null,"niunie1","Linear",0.5],["say","avg1_141","Well... Anyway! Since disaster followed it everywhere, people had no choice but to lock themselves indoors every time it started to roam.",0,""],["w",0.5],["ctl","avg1_141","a","002","idea",null,null,null,null,"jushou2","Linear",0.5],["say","avg1_141","Eventually, they figured out it was terrified of three things: loud noises, the color red, and firelight.",0,""],["se","se_412"],["ctl","avg1_141","a","016",null,null,null,null,null,"JuGong1","Linear",0.5],["say","avg1_141","So folks started putting up red couplets and lanterns. They'd keep the lights on all night and set off firecrackers to drive the beast away.",0,""],["ctl","avg1_141","a","007","star",null,null,null,null,null,"Linear",0.5],["say","avg1_141","That is why we gotta make a huge racket with firecrackers during the festival! It's tradition!",0,""],["w",0.5],["show","avg1_159","a","012",0.15,null,null,0,null,0.0],["ctl","avg1_159","a",null,"attention",0.2,null,null,1.0,null,"Linear",0.5],["say","avg1_159","I see... That explains your earlier insistence that \"it isn't a festival without firecrackers.\"",0,""],["w",0.5],["stg",0,-60.0,null,null,"Linear",0.5,null,null,null],["show","avg1_113","a","007",0.9,null,null,0,null,0.0],["ctl","avg1_113","a",null,"sweaty",0.85,null,null,1.0,null,"Linear",0.5],["ctl","avg1_141","a","019",null,null,null,null,null,"chijing","Linear",0.5],["say","avg1_113","Incorrect. That is merely because Chixia enjoys the noise and chaos.",0,""],["w",0.5],["ctl","avg1_141","a",null,null,null,null,null,0.0,null,"Linear",0.5],["ctl","avg1_159","a",null,null,null,null,null,0.0,null,"Linear",0.5],["ctl","avg1_113","a","012","speechless",0.75,null,null,null,null,"Linear",1.0],["say","avg1_113","Today, Springseek couplets and firecrackers are no longer about warding off Nian.==W== They live on as enduring symbols of the festival.",0,""],["w",0.5],["bg","phoenix_street",0,1.0],["ctl","avg1_113","a","009",null,null,null,null,null,null,"Linear",0.5],["goon"],["ctl","avg1_113","a","011","sigh",null,null,null,null,null,"Linear",0.5],["say","avg1_113","I doubt anyone sets off firecrackers solely to drive away Nian these days.",0,""],["w",0.5],["bg","tower_fire_earth",0,0.5],["w",0.5],["se","se_074"],["ctl","avg1_113","a","014",null,0.5,null,null,null,null,"OutCubic",0.5],["say","avg1_113","However, the legendary Nian appearing inside the Monolith... That is certainly a cause for concern.",0,""],["w",0.5],["mrt",1,"z","020",null,null],["say","avg3_100","But that smuggler claimed it swallowed the firecrackers the moment it appeared. That contradicts the legend, doesn't it?",1,""],["mrt",3,"z",null,null,null],["ctl","avg1_141","a","007",null,0.85,null,null,0.0,null,"Linear",0.0],["w",0.5],["ctl","avg1_113","a",null,null,0.3,null,null,null,null,"Linear",0.5],["ctl","avg1_141","a",null,"happy",0.75,null,null,1.0,"jushou2","Linear",0.5],["say","avg1_141","Maybe it's a smart one! Knows the bangs are its weakness, so it gobbled them up before they could go off!",0,""],["ctl","avg1_159","a","003",null,0.3,null,null,null,null,"Linear",0.0],["w",0.5],["stg",0,60.0,null,null,"Linear",1.0,null,null,null],["ctl","avg1_113","a",null,null,null,null,null,0.0,null,"Linear",0.5],["ctl","avg1_141","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["se","se_062"],["ctl","avg1_159","a","011",null,0.35,null,null,1.0,null,"Linear",0.5],["w",0.5],["say","avg1_159","Regardless of the specifics, there is undeniably a powerful entity residing within the Monolith.",0,""],["w",0.5],["bg","BG_Black",0,0.5],["ctl","avg1_159","a",null,"speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_159","When that smuggler mentioned Nian,==W== she presented with rapid breathing, pallor, and acute muscle tension. Physiological reactions do not lie. There is no doubt she encountered a terrifying creature.",0,""],["w",0.5],["se","se_112"],["show","avg2_984","c","008",0.7,-0.45,1.8,0,null,0.0],["ctl","avg2_984","c",null,null,null,null,null,0.2,"lengzhan2","OutSine",0.5],["goon"],["w",0.5],["bg","tower_fire_earth",0,0.5],["ctl","avg2_984","c","002",null,null,null,null,0.0,null,"OutSine",0.5],["w",0.5],["ctl","avg1_159","a",null,null,0.45,null,null,null,null,"Linear",0.5],["say","avg1_159","As for whether it is truly the legendary monster...==W== Heh. Shall we investigate and see for ourselves?",0,""],["w",0.5],["ctl","avg1_159","a","002","music",null,null,null,1.0,"JuGong1","OutSine",0.5],["goon"],["w",0.5],["mrt",1,"z","009",null,null],["say","avg3_100","Space inside the Monolith is chaotic; the routes never stay the same. Yet all we can do is press on.",1,""],["mrt",0,"z","020",null,null],["say","avg3_100","No matter how the layout shifts, the path always leads down. We're bound to reach the Boss's Domain eventually.",1,""],["mrt",0,"z","002",null,null],["say","avg3_100","Now, about Nian...==W== Wait.",1,""],["w",0.5],["bgm",""],["stg",0,-80.0,null,1.1,"Linear",1.0,null,null,null],["ctl","avg1_159","a",null,null,null,null,null,0.0,null,"Linear",0.5],["hide","avg1_159",0.5],["w",0.5],["mrt",0,"z","002","attention",null],["goon"],["mrt",3,"z",null,null,null],["ctl","avg1_141","a","021",null,0.8,null,null,0.0,null,"Linear",0.0],["w",0.5],["se","se_146"],["ctl","avg1_141","a",null,null,0.75,null,null,1.0,null,"Linear",0.5],["say","avg1_141","What is it?",0,""],["w",0.5],["mrt",1,"z","015","question",null],["say","avg3_100","Have you noticed that ... something feels different around here?==W== Look at that shop. Abo