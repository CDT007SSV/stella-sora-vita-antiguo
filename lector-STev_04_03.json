w",0.6],["bgm",""],["say","0","Under the faint moonlight, I follow her tracks to a clearing near our camp.",0,""],["w",0.35],["se","se_202"],["trn",0,1,false,false,0.7],["w",0.7],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["bg","north_street_grey_night",0,0.0],["trn",1,1,false,false,0.7],["w",0.55],["say","0","As if reading the room, a crooked streetlamp flickers on, lighting the figure at the path's end.",0,""],["w",0.35],["stg",0,-100.0,null,1.15,"OutQuad",0.6,null,null,null],["film",0],["bg","north_street_grey_night",0,0.7],["cbg",0,150.0,null,1.15,"Linear",0.0,null,null,null],["cbg",0,250.0,null,null,"Linear",17.0,null,null,null],["w",0.2],["show","avg1_143","a","013",0.64,-0.4,1.4,0,null,0.0],["ctl","avg1_143","a",null,null,null,null,null,1.0,null,"OutSine",0.5],["ctl","avg1_143","a",null,null,0.55,null,null,null,null,"Linear",17.0],["w",0.5],["bgm","m57"],["say","avg1_143","How did this place ... end up like this...",3,""],["w",0.35],["say","0","Bathed in that light, she seems more solitary now than she did by day.",3,""],["w",0.35],["film",1],["clear",1,0.45,1],["stg",0,0.0,0.0,1.0,"OutQuad",0.6,null,null,null],["bg","north_street_grey_night",0,0.7],["w",0.6],["mrt",2,"z","012","question",null],["say","avg3_100","What are you doing out here? I thought you were keeping watch for me.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_062"],["show","avg1_143","a","004",0.67,-0.255,1.3,0,null,0.0],["ctl","avg1_143","a",null,null,0.5,-0.33,1.4,1.0,null,"OutQuad",0.6],["w",0.6],["say","avg1_143","I am on watch. But that doesn't require me to stay at your bedside the entire night.",0,""],["ctl","avg1_143","a","005","music",null,null,null,null,null,"OutSine",0.35],["say","avg1_143","Relax. I rigged the room with defensive wards for Nocturn Eterna. If they get close, they'll be riddled with holes.",0,""],["w",0.5],["mrt",2,"y","021","awkward","lengzhan"],["say","avg3_100","Sounds ... dangerous. Did you factor my safety into that setup?",1,""],["mrt",3,"y",