ll,null,null,"OutSine",0.35],["w",0.35],["say","avg1_143","You saw them?!",0,""],["w",0.35],["stg",0,150.0,0.0,1.1,"OutCubic",0.7,null,null,null],["w",0.4],["show","avg3_195","b","010",0.28,-0.15,1.2,0,null,0.0],["bgm","m11"],["ctl","avg3_195","b",null,"vexation",null,null,null,1.0,"lengzhan","OutCubic",0.45],["w",0.45],["say","avg3_195","Well, only from behind.",0,""],["ctl","avg3_195","b",null,null,null,null,null,null,null,"Linear",0.3],["ctl","avg3_195","b","011","exclamation",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","avg3_195","They have white horns on their head. There's no mistaking it.",0,""],["ctl","avg3_195","b",null,null,null,null,null,0.0,null,"OutSine",0.35],["hide","avg3_195",0.35],["w",0.35],["stg",0,-150.0,-20.0,1.15,"OutCubic",0.7,null,null,null],["w",0.4],["ctl","avg1_143","a","009","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_143","White horns...",0,""],["ctl","avg1_143","a",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.35],["mrt",2,"z","025","shock",null],["say","avg3_100","Sounds like the stalker of me Wraith mentioned, the one that's been stalking me.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["cbg",0,50.0,null,null,"OutCubic",0.7,null,null,null],["ctl","avg1_143","a",null,null,0.72,null,null,0.0,null,"OutCubic",0.7],["hide","avg1_143",0.7],["show","avg3_195","b","008",0.35,-0.165,1.2,0,null,0.0],["ctl","avg3_195","b",null,"exclamation",0.55,null,null,1.0,null,"OutCubic",0.7],["say","avg3_195","Is that so?! Then... Maybe Nocturn Eterna's true target is Tyrant...==W== Right, that Nocturn Eterna headed for the Monolith.",0,""],["w",0.8],["ctl","avg3_195","b","014","idea",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["goon"],["w",0.35],["mrt",1,"y","020","think",null],["say","avg3_100","In Emor, Nocturn Eterna—Aeloria's goal was to destroy Monoliths.",2,""],["mrt",0,"y","021","question",null],["say","avg3_100","But why would they enter a Monolith they already destroyed? Was it because the Monolith was rebooted?",2,""],["mrt",0,"y","003",null,null],["say","avg3_100","Are they trying to destroy the Monolith before it returns to normal? Or are they just here to stall our investigation?",2,""],["mrt",0,"y","021","sigh",null],["say","avg3_100","But regardless of the goal, there's no reason for them to be performing that kind of ritual.",2,""],["mrt",0,"y","020",null,null],["say","avg3_100","Something feels off... Am I missing a piece of the puzzle?",2,""],["mrt",0,"z","012","speechless",null],["say","avg3_100","Participants... Duel... Answer...",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_195","b","010","awkward",null,null,null,null,"chijing","OutSine",0.35],["w",0.35],["say","avg3_195","Tyrant?",0,""],["w",0.5],["ctl","avg3_195","b",null,null,0.38,-0.26,1.35,0.0,null,"OutCubic",0.6],["cbg",0,-220.0,0.0,1.2,"OutCubic",0.8,null,null,null],["w",0.3],["show","avg1_143","a","009",0.75,-0.09,1.1,0,null,0.0],["ctl","avg1_143","a",null,null,0.58,-0.17,1.2,1.0,null,"OutCubic",0.7],["w",0.7],["mrt",1,"y","012","speechless",null],["say","avg3_100","Wraith. The mural said: \"God descends from the Monolith... Participants... Duel... Answer...\" Right?",1,""],["mrt",3,"y",null,null,null],["w",0.5],["se","se_077"],["ctl","avg1_143","a","016",null,null,null,null,null,"diantou","OutSine",0.35],["w",0.35],["say","avg1_143","Word for word. I remember it clearly.",0,""],["w",0.5],["mrt",1,"z","002",null,null],["say","avg3_100","This is just my own speculation, but... It explains why they haven't touched us. They want us to do their work and finish the ritual.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_143","a","009","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_143","I see... So that's what the text means. Gather participants for a ritual and have them duel one another until a sole victor remains—only then will God grant a response.",0,""],["ctl","avg1_143","a",null,null,null,null,null,null,null,"Linear",0.3],["w",0.35],["mrt",2,"z","003","exclamation",null],["say","avg3_100","They aren't trying to take us out; they're thinning the herd. They need a \"sole victor\" to receive that answer.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_143","a","002","question",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_143","And once a victor is chosen, then what?",0,""],["w",0.35],["mrt",1,"y","020","shock",null],["bgm",""],["say","avg3_100","That's the missing piece. We'll have to track down Nocturn Eterna and beat the truth out of them.",1,""],["mrt",3,"y",null,null,null],["w",0.51],["se","se_349"],["stg",0,180.0,null,1.1,"OutQuad",1.2,null,null,null],["trn",0,0,true,true,1.21],["w",1.21],["bg","city_room_inside_daylight_winter",0,0.0],["cbg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["stg",0,-120.0,0.0,1.07,"Linear",0.0,null,null,null],["trn",1,0,false,false,0.8],["stg",0,150.0,null,1.1,"OutCubic",0.8,null,null,null],["show","avg3_195","b","005",0.32,-0.16,1.2,0,null,null],["ctl","avg3_195","b",null,null,0.43,null,null,null,null,"OutCubic",0.7],["w",0.7],["say","avg3_195","Brilliant deduction! I'd expect nothing less from you, Tyrant.",0,""],["w",0.35],["se","se_070"],["stg",0,null,null,null,"OutSine",0.0,null,null,"Zhong"],["ctl","avg3_195","b","015",null,null,-0.41,1.5,null,null,"OutSine",0.35],["w",0.35],["say","avg3_195","The plan is set, then. We head to the Monolith and flush Nocturn Eterna out of their hole.",0,""],["bgm",""],["ctl","avg3_195","b","006",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg3_195","Any objections? If not, let's get straight to planning—",0,""],["w",0.35],["se","se_069"],["ctl","avg3_195","b",null,null,null,null,null,null,"chijing","OutSine",0.35],["w",1.5],["ctl","avg3_195","b","022","shy",null,null,null,null,null,"OutSine",0.35],["w",0.35],["bgm","m4"],["say","avg3_195","S-Sorry... I haven't had a bite since this morning...",0,""],["w",0.5],["mrt",2,"z","013","attention",null]