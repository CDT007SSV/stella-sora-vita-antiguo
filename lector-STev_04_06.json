.",0,""],["ctl","avg3_195","b","009","flurry",null,null,null,null,"lengzhan","Linear",1.0],["say","avg3_195","Are you joking?! I saw those horns clear as day! You're the liar here, Wraith! You're the traitor!",0,""],["ctl","avg1_143","a","005",null,0.45,null,1.05,null,null,"OutQuint",1.0],["ctl","avg3_195","b",null,null,0.75,null,0.95,null,null,"OutQuint",1.0],["se","se_062"],["say","avg1_143","We lacked hard evidence before. But last night, while grabbing food, I took a closer look at the injuries the others sustained.",0,""],["w",0.5],["mrt",1,"z","003",null,"JuGong"],["say","avg3_100","No wonder you were gone for so long... It all makes sense now.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_143","a","004","attention",null,null,null,null,null,"Linear",1.0],["say","avg1_143","And guess what? Their wounds were identical—inflicted by magic.==W== The only ones here capable of that ... are you and Mage.",0,""],["w",1],["ctl","avg3_195","b","010",null,null,null,null,null,"lengzhan","Linear",1.0],["goon"],["ctl","avg1_143","a","016","speechless",null,null,null,null,"niunie1","Linear",1.0],["say","avg1_143","Since Mage is already down for the count...==W== The only suspect left is you,==W== Edda.",0,""],["w",1],["goon"],["se","se_226"],["cbg",0,50.0,null,null,"OutQuint",1.0,null,null,null],["ctl","avg1_143","a",null,null,0.25,null,1.1,null,null,"OutQuint",1.0],["ctl","avg3_195","b",null,null,0.62,null,1.0,null,"lengzhan","OutQuint",1.0],["stg",0,-200.0,-40.0,1.2,"OutQuint",1.0,null,null,null],["w",1],["goon"],["ctl","avg3_195","b","018","exclamation",null,null,null,null,"diantou","Linear",1.0],["say","avg3_195","That is pure speculation! Boss, don't let her twist the truth! She's the liar here!",0,""],["w",0.5],["mrt",1,"z","003",null,"JuGong"],["say","avg3_100","No. I think Wraith is right.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_195","b","010","symbol",null,null,null,null,"lengzhan","Linear",1.0],["say","avg3_195","H-How can you say that?!",0,""],["w",0.5],["mrt",1,"y","003",null,null],["say","avg3_100","First—==W==this whole situation feels off.==W== It's nothing like my previous run-ins with Nocturn Eterna.",1,""],["trn",0,0,false,false,0.5],["w",0.5],["ctl","avg3_195","b",null,null,null,null,null,0.0,null,"Linear",0.0],["hide","avg3_195",0],["ctl","avg1_143","a",null,null,null,null,null,0.0,null,"Linear",0.0],["hide","avg1_143",0],["stg",0,0.0,0.0,1.2,"Linear",0.0,null,null,null],["fx",0,"fx_avg_reminiscence_loop",0,2],["w",0.2],["show","avg1_106","b","005",0.57,null,null,0,null,null],["show","avg3_197","a","007",0.42,null,null,0,null,null],["bg","hotel_banquet_hall_night",0,0.0],["ctl","avg3_197","a",null,null,null,null,null,null,"niunie1","Linear",1.0],["stg",0,null,null,1.23,"OutSine",2.0,null,null,null],["trn",1,0,false,false,0.5],["w",0.5],["goon"],["w",1],["goon"],["mrt",0,"y","002",null,null],["say","avg3_100","Second—==W==you sent us to a specific spot ... and coincidentally,==W== that's exactly where we found those murals and ancient weapons.",1,""],["trn",0,0,false,false,0.5],["w",0.5],["ctl","avg1_106","b",null,null,null,null,null,0.0,null,"Linear",0.0],["hide","avg1_106",0],["ctl","avg3_197","a",null,null,null,null,null,0.0,null,"Linear",0.0],["hide","avg3_197",0],["stg",0,null,null,1.2,"Linear",0.0,null,null,null],["w",0.2],["show","avg2_971","a","005",null,null,null,0,null,null],["bg","cavern",0,0.0],["stg",0,null,null,1.23,"OutSine",2.0,null,null,null],["trn",1,0,false,false,0.5],["w",0.5],["ctl","avg2_971","a",null,null,null,null,null,null,"lengzhan","Linear",1.0],["goon"],["w",1],["ctl","avg2_971","a",null,null,null,null,null,null,"lengzhan","Linear",1.0],["goon"],["mrt",0,"y","014",null,null],["say","avg3_100","Finally—==W==you're the only one left standing.==W== Unharmed, and in total control.",1,""],["trn",0,0,false,false,0.5],["w",0.5],["ctl","avg2_971","a",null,null,null,null,null,0.0,null,"Linear",0.0],["hide","avg2_971",0],["fx",0,"fx_avg_reminiscence_loop",1,2],["stg",0