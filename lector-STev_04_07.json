w",0.5],["mrt",1,"y","016",null,"chijing"],["say","avg3_100","I fell for it. Edda's attack was a trap—she wanted Wraith to shield me and come closer...==W== But ... why did the circle activate on me?",2,""],["w",0.5],["mrt",0,"y","009","think",null],["goon"],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg3_195","a",null,null,null,null,null,0.0,null,"Linear",0.3],["ctl","avg1_143","a",null,null,null,null,null,0.0,null,"Linear",0.3],["fx",0,"fx_avg_flash_light",0,1],["mrt",2,"z","025",null,null],["say","avg3_100","Wait... Did you...?!",1,""],["mrt",3,"z",null,null,null],["w",0.5],["bgm",""],["se","se_169"],["trn",0,1,true,false,1.0],["w",1.0],["bg","north_street_city_daylight",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["fx",0,"fx_avg_reminiscence_loop",0,2],["trn",1,1,false,false,1.0],["w",1.0],["show","avg3_195","b","012",0.5,-0.25,1.3,0,null,0.0],["ctl","avg3_195","b","012",null,null,null,null,1.0,null,"OutSine",0.33],["w",0.68],["mrt",2,"z","012",null,null],["say","avg3_100","It's okay. Danger's gone...==W== Come on, deep breath.",1,""],["w",0.5],["se","se_019"],["stg",0,null,-150.0,1.4,"OutBack",0.6,null,null,null],["w",0.6],["mrt",0,"z","023",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_195","b","006","shy",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg3_195","Huff... Huff...Your heartbeat, Tyrant... It makes me feel so safe.",0,""],["w",0.35],["se","se_169"],["trn",0,1,true,false,1.0],["w",1.0],["bg","tower_common",0,0.5],["w",0.5],["fx",0,"fx_avg_reminiscence_loop",1,2],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["trn",1,1,false,false,1.0],["w",1.0],["bgm",""],["w",0.5],["mrt",1,"z","025","exclamation",null],["say","avg3_100","When you pretended to panic and hugged me, you planted the circle on my clothes?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["show","avg3_195","a","005",null,null,null,0,"music",0.0],["ctl","avg3_195","a",null,null,null,null,null,1.0,"JuGong1","Linear",0.5],["say","avg3_195","Exactly~ Quite convincing, wasn't it? The warming spell I cast on your clothes earlier was just to hide the sigil.==W== Tyrant, you are too gullible.",0,""],["w",0.5],["se","se_074"],["ctl","avg3_195","a","006",null,null,-0.45,1.5,1.0,null,"OutSine",0.3],["goon"],["w",0.5],["ctl","avg3_195","a","020","sigh",null,null,null,null,"chijing","Linear",0.5],["say","avg3_195","You should be grateful you ran into kind old me. If it had been Nocturn Eterna who found you... Well...",0,""],["w",0.5],["stg",0,null,-30.0,1.1,"OutCubic",0.5,null,null,null],["mrt",1,"z","026","exclamation",null],["say","avg3_100","What did you do to Wraith?!",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_195","a","008",null,null,null,null,null,null,"Linear",0.5],["say","avg3_195","Hmph. This Monolith might be drained, but phase one is complete...==W== This domain belongs to Them now.",0,""],["w",0.5],["se","se_075"],["ctl","avg3_195","a","013",null,null,0.0,1.0,1.0,null,"OutSine",0.3],["goon"],["w",0.5],["show","avg1_143","a","003",0.6,null,null,0,null,0.0],["ctl","avg3_195","a","016","star",0.35,null,null,null,null,"OutCubic",0.5],["ctl","avg1_143","a",null,null,null,null,null,1.0,null,"Linear",0.5],["say","avg3_195","They seized her mind and cast it into a rift in spacetime. She's gone for good.",0,""],["w",0.5],["mrt",1,"z","012","question",null],["say","avg3_100","Who is this \"They\" you keep talking about?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_029"],["ctl","avg3_195","a","016",null,null,null,null,null,"JuGong1","Linear",0.5],["say","avg3_195","I don't usually share my secrets, but for Tyrant, I suppose I can make an exception.",0,""],["w",0.5],["ctl","avg3_195","a","007","shy",null,null,null,null,"chijing","Linear",0.5],["say","avg3_195","After all, I still need you two to see my plan through.",0,""],["w",0.5],["mrt",1,"z","012","attention",null],["say","avg3_100","Why do you need me?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_062"],["ctl","avg1_143","a",null,null,0.7,null,null,0.0,null,"Linear",0.5],["ctl","avg3_195","a","008",null,0.5,null,null,null,null,"Linear",0.5],["say","avg3_195","This world may worship supreme beings like the God of Grace... But in Norstheim, we revere something else entirely. They are—",0,""],["w",0.5],["ctl","avg3_195","a",null,null,null,null,null,0.0,null,"Linear",0.3],["bgm",""],["bg","BG_Black",0,0.3],["w",0.3],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["w",0.5],["se","se_372"],["say","0","The Archons.",8,""],["w",0.5],["trn",0,0,false,false,1.0],["w",1.0],["bg","story_main_01_023_a",0,0.0],["film",0],["bgm","m29"],["trn",1,0,false,false,1.0],["w",1.0],["stg",0,null,null,1.1,"Linear",10.0,null,null,null],["say","avg3_195","They once commanded the Monoliths and demanded fear ... until the Grace Imperium tried to erase them from history.",3,""],["ctl","avg3_195","a","016",null,0.3,-0.3,1.3,0.0,null,"Linear",0.0],["w",0.5],["ctl","avg3_195","a","016","happy",null,null,null,0.9,null,"Linear",0.5],["say","avg3_195","I'm not like those fools. I found the remnants in ruins and banned scriptures, and I learned the truth of their power.",3,""],["w",0.5],["ctl","avg3_195","a","009",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg3_195","The Archons are fickle, however. Few are ever deemed worthy to become their \"Kin.\"",3,""],["w",0.5],["ctl","avg3_195","a",null,null,null,null,null,0.0,null,"Linear",0.5],["se","se_219"],["bg","story_main_01_023_a",0,0.5],["w",0.5],["fx",0,"fx_avg_star_lp",0,0],["say","avg3_195","But in my search... I was lucky enough to earn Their gaze.",3,""],["w",0.5],["stg",0,null,null,null,"Linear",1.0,null,null,"Xiao"],["say","avg3_195","In that instant, it all became clear. The cryptic runes, the whispers in the dark... Suddenly, I understood everything!",3,""],["w",0.5],["ctl","avg3_195","a","020","love",null,null,null,0.9,null,"Linear",0.5],["say","avg3_195","The one who blessed me, without a doubt, is the Archon who holds the authority of \"War.\"",3,""],["w",0.5],["trn",0,0,true,false,1.0],["w",1.0],["bg","tower_common",0,0.5],["w",0.5],["film",1],["fx",0,"fx_avg_star_lp",1,0],["trn",1,0,false,false,1.0],["w",1.0],["show","avg3_195","a","021",null,null,null,0,null,0.0],["ctl","avg3_195","a",null,"speechless",null,null,null,1.0,null,"Linear",0.5],["say","avg3_195","And to bring the Archon of War into this world... I will gladly sacrifice everything!",0,""],["w",0.5],["mrt",1,"z","009",null,null],["say","avg3_100","That's a lot to process... But is that why you tricked Wraith into coming all this way?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_195","a","004","music",null,null,null,null,null,"Linear",0.5],["say","avg3_195","That's right. The moment I mentioned Nocturn Eterna, she agreed to follow. Easy, too.",0,""],["ctl","avg3_195","a","006",null,null,null,null,null,"diantou2","Linear",0.5],["say","avg3_195","Only if warriors powerful enough join the ritual will They be satisfied.",0,""],["w",0.5],["mrt",1,"z","012","question",null],["say","avg3_100","Then why me? I'm as good a fighter as an ordinary person with no magic.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_195","a","015","happy",null,null,null,null,null,"Linear",0.5],["say","avg3_195","The Archons exist beyond the laws of reality. The summoning ritual merely anchors their passage into this world. To draw Their attention, besides performing the rites They favor... A \"special individual\" is also required.",0,""],["w",0.5],["se","se_029"],["ctl","avg3_195","a","004",null,null,-0.4,1.5,null,null,"OutCubic",0.3],["say","avg3_195","As the Tyrant, you are the final piece of the puzzle. The most critical component—the Witness.",0,""],["ctl","avg3_195","a","006","love",null,null,null,null,"jushou2","Linear",0.5],["say","avg3_195","As long as you stand here, within the ritual, They will surely take notice. That's what makes you ... special!",0,""],["w",1.0],["ctl","avg3_195","a","011","vexation",null,null,null,null,"niunie1","Linear",0.5],["say","avg3_195","I'd planned to just lock you up, but ...==W== that nuisance was sharper than I gave her credit for. I never found an opening.",0,""],["w",1.0],["se","se_030"],["stg",0,-120.0,null,null,"OutCubic",0.5,null,null,null],["show","avg1_143","a","003",0.7,0.05,0.85,0,null,0.0],["ctl","avg1_143","a",null,null,null,null,null,1.0,null,"Linear",0.3],["ctl","avg3_195","a","019",null,0.4,null,null,1.0,null,"OutSine",0.3],["goon"],["w",0.5],["ctl","avg3_195","a",null,null,null,null,null,0.0,null,"Linear",0.5],["stg",0,-450.0,-100.0,1.5,"OutCubic",1.0,null,null,null],["w",1.5],["mrt",1,"y","009","think",null],["say","avg3_100","Wraith was protecting me from the start...==W== Did she have Edda figured out all along?",2,""],["w",1.0],["mrt",0,"y","025","attention",null],["goon"],["mrt",3,"y",null,null,null],["ctl","avg3_195","a","004",null,0.4,0.0,1.0,0.0,null,"Linear",0.0],["w",0.5],["ctl","avg1_143","a",null,null,null,null,null,1.0,null,"Linear",0.3],["stg",0,-100.0,0.0,1.1,"OutCubic",0.5,null,null,null],["ctl","avg3_195","a",null,"happy",0.45,null,null,1.0,null,"Linear",0.5],["say","avg3_195","Hmph. Doesn't matter now! You've disrespected the Archon, and you'll pay the price!",0,""],["w",0.5],["mrt",1,"z","026","exclamation",null],["say","avg3_100","Wait! Don't hurt Wraith! Look, this is all just in your head! Those ancient texts, the legends—none of them are proven!",1,""],["mrt",3,"z",null,null,null],["w",0.5],["stg",0,null,null,null,"Linear",1.0,null,null,"Zhong"],["ctl","avg1_143","a",null,null,null,null,null,0.0,null,"Linear",0.3],["ctl","avg3_195","a","018","angry",0.5,-0.4,1.5,null,null,"OutCubic",0.3],["say","avg3_195","Silence. Even coming from you, Tyrant, that tests my patience.",0,""],["w",0.5],["ctl","avg3_195","a","021","music",null,null,null,null,"JuGong1","Linear",0.5],["say","avg3_195","Hmph. Seeing is believing. Before the ritual ends, allow me to show you...",0,""],["w",0.5],["ctl","avg3_195","a","013","exclamation",