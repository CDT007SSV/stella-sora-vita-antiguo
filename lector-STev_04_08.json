002",null,-0.1,1.15,0,null,null],["w",0.1],["trn",1,0,false,false,0.7],["ctl","avg2_982","a",null,"vexation",null,null,null,null,"chijing","OutSine",0.7],["w",0.7],["say","Attendant","She took down our whole regiment with her bare hands.",0,""],["ctl","avg2_982","a",null,"exclamation",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","Attendant","That fighting style... Where did you learn it?",0,""],["w",0.35],["se","se_230"],["chd",0,2,"avg1_143","b","009",null],["w",0.35],["say","avg1_143","Where? In Norstheim, kids drill these moves from the moment they can stand.",0,""],["w",0.35],["ctl","avg1_143","b","019","shock",null,null,null,null,"jushou","OutSine",0.3],["w",0.3],["say","avg1_143","Rely too much on your weapon, and you'll get yourself killed. That's basic training.",0,""],["chd",1,2,"avg1_143","a","002",null],["w",0.35],["ctl","avg2_982","a",null,"angry",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","Attendant","Damn you! How dare you mock our traditions!",0,""],["w",0.35],["ctl","avg2_982","a",null,null,1.0,null,null,0.0,null,"InBack",0.85],["w",0.35],["se","se_148"],["trn",0,0,true,true,0.5],["w",0.5],["show","avg2_982","a","002",0.0,-0.19,1.25,0,null,0.0],["show","avg1_143","b","009",0.7,-0.21,1.25,0,null,0.0],["bgm",""],["w",0.15],["trn",1,0,false,false,0.5],["w",0.2],["ctl","avg2_982","a",null,null,0.35,null,null,1.0,null,"OutCubic",0.7],["ctl","avg1_143","b",null,null,null,null,null,1.0,null,"OutCubic",0.7],["w",0.45],["se","se_227"],["trn",0,1,true,true,0.7],["w",0.7],["say","0","Enough!",8,""],["w",0.7],["clear",0,0,1],["w",0.4],["show","avg3_109","a","002",null,-0.15,1.2,0,null,1.0],["trn",1,1,false,false,0.8],["w",0.6],["chd",0,2,"avg2_982","a","002","resentful"],["w",0.35],["say","Attendant","Vice Commander! Why stop us?! We can still fight!",0,""],["chd",1,2,"avg2_982","a","002",null],["w",0.35],["ctl","avg3_109","a",null,"sigh",null,null,null,null,null,"Linear",0.35],["w",0.35],["say","Strange Old Man","The outcome is clear. This fight was never fair. Press on, and we lose our last shred of dignity.",0,""],["bgm","m52"],["say","Strange Old Man","Before I declare the victor, young soul. I have a question.",0,""],["w",0.35],["bg","city_street_night_winter",0,0.7],["w",0.3],["ctl","avg3_109","a",null,"question",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","Strange Old Man","These skills of yours... In your world, are they truly common knowledge?",0,""],["w",0.35],["se","se_169"],["trn",0,1,true,true,0.8],["w",0.8],["bg","north_street_grey_night",0,0.0],["show","avg1_143","b","013",null,-0.25,1.3,0,null,null],["trn",1,1,false,false,0.8],["w",0.2],["ctl","avg1_143","b",null,"speechless",null,null,null,null,null,"Linear",0.35],["w",0.35],["say","avg1_143","... Or so I've heard. Legend has it that this style was once a closely guarded secret among the nobility.",0,""],["ctl","avg1_143","b","003",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_143","But in the frozen lands, if you can't fight, you won't survive.",0,""],["ctl","avg1_143","b","002",null,null,null,null,null,null,"OutSine",3.0],["say","avg1_143","Eventually, it became a survival skill for everyone—man, woman, and child.",0,""],["w",0.35],["se","se_169"],["trn",0,1,true,true,0.8],["w",0.8],["bg","hotel_banquet_hall_night",0,0.0],["show","avg1_143","b","002",0.7,-0.17,1.2,0,null,null],["show","avg3_109","a","002",0.3,-0.16,1.23,0,null,null],["trn",1,1,false,false,0.8],["w",0.15],["ctl","avg1_143","b","005","attention",null,null,null,null,null,"Linear",0.35],["w",0.35],["say","avg1_143","Does this answer satisfy you?",0,""],["w",0.5],["ctl","avg3_109","a",null,"speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","Strange Old Man","Ah... Has so much time truly passed in the world outside? No wonder the appearance of this hall keeps shifting.",0,""],["ctl","avg3_109","a",null,null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","Strange Old Man","I can still tell this was a place for dining, though it looks nothing like the tables in our memories. This must be ... the architectural style of your era.",0,""],["ctl","avg1_143","b","010","happy",null,null,null,null,"daintou","OutSine",0.45],["w",0.45],["say","avg1_143","Hmph, you're far too sentimental. A table is a table—as long as you can eat at it, what's the problem?",0,""],["ctl","avg3_109","a",null,"music",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","Strange Old Man","Haha, I like your spirit. You remind me of the days when I was still among the living.",0,""],["w",0.3],["se","se_227"],["trn",0,0,true,true,0.9],["w",0.9],["show","avg3_109","a","002",0.25,-0.21,1.3,0,null,null],["bg","story_main_01_004",0,0.0],["cbg",0,0.0,null,1.2,"Linear",0.0,null,null,null],["trn",1,0,false,false,0.9],["cbg",0,-250.0,null,null,"Linear",20.0,null,null,null],["ctl","avg3_109","a",null,null,null,null,null,null,null,"Linear",0.3],["say","Strange Old Man","We have witnessed too much slaughter, watched war reduce everything to ruins, cycle after cycle.",0,""],["w",0.5],["clear",0,0,1],["w",0.35],["bg","story_main_01_005",0,0.7],["cbg",0,0.0,null,1.2,"Linear",0.0,null,null,null],["cbg",0,-250.0,null,null,"Linear",20.0,null,null,null],["say","Strange Old Man","Yet ... from this scarred earth, new life and order always seem to rise.",0,""],["w",0.5],["clear",0,0,1],["w",0.35],["se","se_169"],["trn",0,1,true,true,0.9],["w",0.9],["bg","hotel_banquet_hall_night",0,0.0],["cbg",0,100.0,null,1.1,"Linear",0.0,null,null,null],["show","avg1_143","b","002",0.7,-0.16,1.2,0,null,null],["show","avg3_109","a","002",0.3,-0.175,1.25,0,null,null],["w",0.4],["trn",1,1,false,false,0.9],["w",0.35],["ctl","avg3_109","a",null,"attention",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","Strange Old Man","God must have guided you to us. Perhaps to deliver a message.",0,""],["ctl","avg1_143","b","013","speechless",null,null,null,null,null,"OutSine",0.35],["say","avg1_143","I've been wondering... Are you the legion from the murals? The ones who marched with the \"God of War\"?",0,""],["ctl","avg1_143","b",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.35],["ctl","avg3_109","a",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.3],["say","Strange Old Man","We did campaign with her, yes ... and in the end, we lost ourselves within the Monolith, right alongside her.",0,""],["ctl","avg3_109","a",null,"sigh",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","Strange Old Man","She was once a legendary fighter, but somewhere along the line, she became isolated ... obsessive. We tried to bring her back to her senses, unfortunately...",0,""],["ctl","avg1_143","b","009","exclamation",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","avg1_143","You failed. And your souls were trapped right here.",0,""],["w",0.35],["ctl","avg3_109","a",null,"attention",null,null,null,null,"daintou","OutSine",0.35],["w",0.35],["say","Strange Old Man","But you're different, young soul. Your fate isn't sealed in this place.",0,""],["bgm",""],["w",0.5],["say","Strange Old Man","Thanks to your companion's nature, the ritual binding us here has weakened significantly.",0,""],["w",0.35],["trn",0,0,false,false,0.7],["w",1.1],["se","se_501"],["fx",0,"fx_avg_goldenlight_continued",0,1],["trn",1,0,false,false,0.8],["w",0.35],["ctl","avg3_109","a",null,null,null,null,null,null,null,"Linear",0.5],["say","Strange Old Man","If we ... channel our remaining power, we should be able to break you out of this domain.",0,""],["ctl","avg1_143","b","022","sweaty",null,null,null,null,"lengzhan","Linear",0.35],["w",0.35],["say","avg1_143","... Wait. You're not planning to—",0,""],["w",0.5],["clear",0,0,1],["w",0.35],["se","se_062"],["ctl","avg1_143","b",null,null,0.9,null,null,0.0,null,"OutCubic",0.7],["hide","avg1_143",0.7],["ctl","avg3_109","a",null,null,0.5,null,null,null,null,"OutCubic",0.7],["cbg",0,-100.0,null,null,"OutCubic",0.7,null,null,null],["w",0.7]