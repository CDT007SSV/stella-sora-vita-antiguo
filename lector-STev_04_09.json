ll,"Linear",1.0,null,null,"1ZhenDong"],["say","avg1_143","You're running low on Grace. Quit stalling. If you've got a trump card, use it.",9,""],["w",0.5],["cbg",0,0.0,0.0,1.0,"OutCubic",0.5,null,null,null],["fx",0,"fx_speedline_center",0,0],["say","avg1_143","Throw whatever you've got at me. I'll put you down every single time.",9,""],["w",0.5],["trn",0,0,false,false,0.5],["w",0.5],["bg","BG_Black",0,0.0],["bg","story_event_04_003_b",5,0.0],["cbg",5,null,550.0,1.35,"Linear",0.0,null,null,null],["bgm",""],["trn",1,0,false,false,0.5],["w",0.5],["se","se_049"],["stage",5,0,0],["w",0.5],["bgm","m14"],["say","avg3_195","Hmph. Big talk.",9,""],["w",0.5],["se","se_058"],["say","avg1_143","Make your point.",9,""],["w",0.5],["stage",5,1,17],["say","avg3_195","If you wanted this over, you would've pulled the trigger already.==W== But... Look around. Familiar? The day the Monolith went dark.",9,""],["w",1.0],["se","se_055"],["bg","north_street_city_daylight",0,0.5],["goon"],["w",0.5],["cbg",0,null,null,null,"Linear",1.0,null,null,"Xiao"],["say","avg1_143","How do you know about that day?!",9,""],["w",0.5],["bg","story_event_04_003_a",0,1.0],["cbg",0,null,150.0,null,"Linear",0.0,null,null,null],["w",0.5],["se","se_051"],["say","avg3_195","Of course I know. Like I said—I did my homework before coming here.",9,""],["say","avg3_195","Not just the Monolith... I dug into everything regarding Norstheim.",9,""],["w",0.5],["cbg",0,0.0,200.0,1.1,"OutSine",2.0,null,null,null],["se","se_055"],["say","avg3_195","After all... I wasn't able to stand here with the person who mattered most that day.",9,""],["say","avg3_195","I may not care for this city...==W== but who wouldn't want to know the truth about their own homeland?",9,""],["w",0.5],["se","se_052"],["goon"],["w",0.5],["choice",["Homeland? Then you're..."],[[]]],["w",0.5],["stg",0,null,null,null,"Linear",1.0,null,null,"chijing"],["se","se_125"],["say","avg3_195","That's right. Born and raised. Though most people just called me the Disgrace of Norstheim.",9,""],["say","avg3_195","Heh. I feel nothing for this place, yet it haunts the back of my mind...==W== Like a curse.",9,""],["w",0.5],["se","se_030"],["goon"],["w",0.5],["stg",0,-150.0,null,null,"OutSine",1.0,null,null,null],["se","se_055"],["say","avg3_195","But you... You're from the Warlord's bloodline. You lived a comfortable life before that day, and even after… You'll never understand how I feel.",9,""],["w",0.5],["bg","story_event_04_002",2,0.0],["cbg",2,-300.0,null,null,"Linear",0.0,null,null,null],["se","se_257"],["stage",2,0,4],["say","avg1_143","You're right... Seeing what you've done, I can't pretend to understand you. But I've never forgotten my clan's honor.",9,""],["w",0.5],["cbg",0,-50.0,null,null,"Linear",1.0,null,null,null],["say","avg3_195","Clan's honor?==W== Heh... Hahahaha!",9,""],["w",0.5],["se","se_070"],["bg","story_event_04_003_b",0,0.5],["cbg",0,-50.0,200.0,1.1,"Linear",0.0,null,null,null],["stg",0,null,null,null,"Linear",1.0,null,null,"Zhong"],["goon"],["w",0.5],["se","se_057"],["say","avg3_195","Ahem... Excuse me. I just didn't expect such high-and-mighty words coming from you.",9,""],["w",0.5],["se","se_052"],["say","avg1_143","Hm? Did I say something strange?",9,""],["w",0.5],["trn",0,0,false,false,1.0],["w",1.0],["cbg",0,70.0,null,null,"Linear",0.0,null,null,null],["stg",0,0.0,90.0,null,"Linear",0.0,null,null,null],["bg","story_event_04_003_a",0,0.5],["w",0.5],["stage",2,1,1],["trn",1,0,false,false,0.5],["w",0.5],["bgm",""],["fx",0,"fx_speedline_center",0,0],["stg",0,null,120.0,1.05,"OutCubic",0.5,null,null,null],["say","avg3_195","You think I don't know? Wraith, you haven't killed a single Nocturn Eterna.==W== The monsters that destroyed your home... You haven't laid a finger on them.",9,""],["w",1.0],["se","se_048"],["stg",0,null,null,null,"Linear",1.0,null,null,"Xiao"],["goon"],["w",0.5],["bg","story_event_04_003_b",0,0.5],["se","se_049"],["say","avg3_195","And you have the nerve to say you never forgot... Don't make me laugh.",9,""],["w",0.5],["bg","BG_Black",0,0.5],["w",0.5],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["se","se_048"],["choice",["Wraith, don't let her get in your head!"],[[]]],["w",0.5],["stg",0,null,0.0,null,"Linear",0.5,null,null,null],["bg","north_street_city_daylight",0,0.5],["w",0.5],["se","se_075"],["show","avg1_143","a","004",null,0.05,null,0,null,0.0],["ctl","avg1_143","a",null,null,null,0.0,null,1.0,null,"OutCubic",0.5],["say","avg1_143","Thanks for the warning, but I'm fine. Nothing she says changes the truth. I never forgot that honor.==W== No... Actually, you helped me reclaim it.",0,""],["w",0.5],["ctl","avg1_143","a","007","love",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["mrt",1,"z","015","question",null],["say","avg3_100","M-me? What do you mean?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_143","a",null,null,null,null,null,0.0,"JuGong1","OutCubic",0.5],["w",0.5],["se","se_087"],["obj","qstory_event_04_003",0,null,null],["w",0.5],["say","avg1_143","You heard me correctly.",0,""],["w",0.5],["mrt",1,"z","002","exclamation",null],["say","avg3_100","Ah... So that's what you meant. I suppose that did happen.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["objx"],["w",0.5],["se","se_231"],["fx",0,"fx_avg_noise",0,0],["w",1],["se","se_489"],["fx",0,"fx_avg_snowstorm_lp",0,0],["w",1.0],["fx",0,"fx_avg_noise",1,0],["show","avg3_195","a","024",null,null,null,0,null,0.0],["ctl","avg3_195","a",null,"speechless",null,null,null,1.0,null,"Linear",0.5],["w",0.5],["say","avg3_195","At it again... I hate people like you...",0,""],["w",0.5],["se","se_251"],["ctl","avg3_195","a","019",null,null,null,null,null,"lengzhan2","Linear",0.5],["say","avg3_195","Acting like you deserve everything. Flaunting everything... Everything I can never have...",0,""],["w",0.5],["stg",0,null,null,null,"Linear",1.0,null,null,"Zhong"],["ctl","avg3_195","a","018","angry",null,null,null,null,null,"Linear",0.5],["say","avg3_195","Why do you get 