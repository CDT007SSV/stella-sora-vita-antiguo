0.5],["ctl","avg1_112","a",null,null,null,null,null,0.0,null,"Linear",1.0],["stg",0,-200.0,-100.0,1.2,"Linear",1.5,null,null,null],["say","avg1_125","Family expectations, professional doubts, my own mistakes...==W== The weight of it all just felt like a torrential downpour drowning me.",0,""],["w",0.5],["ctl","avg1_125","a","018",null,null,null,null,null,null,"Linear",0.5],["goon"],["ctl","avg1_125","a",null,null,0.6,null,null,null,null,"OutQuad",0.6],["say","avg1_125","In the end, I couldn't bear it any longer. So I ran away.",0,""],["w",0.5],["mrt",1,"y","020","think",null],["say","avg3_100","I never expected Freesia to have a past like that...",2,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_125","a","017",null,null,null,null,null,null,"Linear",0.5],["bgm",""],["say","avg1_125","As I wandered aimlessly... I met Donna.",0,""],["w",0.5],["se","se_169"],["trn",0,0,true,true,1.0],["w",1.0],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["bg","sky_sunny",0,0.0],["cbg",0,null,100.0,null,"OutSine",2.0,null,null,null],["se","se_338"],["fx",0,"fx_avg_movie",0,0],["fx",0,"fx_avg_reminiscence_loop",0,1],["trn",1,0,false,false,1.5],["w",2.5],["bgm","m5"],["w",0.5],["fx",0,"fx_avg_movie",1,0],["bg","forest",0,1.0],["show","avg1_125","b","002",0.28,null,null,0,null,0.0],["show","avg1_130","b","002",0.65,null,null,0,null,0.0],["w",1],["ctl","avg1_130","b",null,null,0.7,null,null,1.0,"2TiaoYue","Linear",0.5],["w",0.5],["ctl","avg1_125","b",null,null,0.3,null,null,1.0,null,"Linear",0.5],["w",0.5],["ctl","avg1_130","b","002","star",null,null,null,null,null,"Linear",1.0],["say","avg1_130","Phew—and just like that, another letter reaches its recipient safe and sound! Mission accomplished!",0,""],["w",0.5],["se","se_236"],["ctl","avg1_130","b","008","star",null,null,null,null,"zuochupeng","Linear",0.5],["say","avg1_130","Gotta say though, Freesia, you were incredible back there!",0,""],["w",0.5],["ctl","avg1_130","b","003","awkward",null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_130","If you hadn't stepped in, that boar would've knocked me off the mountain!",0,""],["w",0.5],["ctl","avg1_125","b","014",null,null,null,null,null,null,"Linear",0.5],["say","avg1_125","It's my duty to help. You did commission me as your bodyguard, after all.",0,""],["w",0.5],["ctl","avg1_130","b","009",null,null,null,null,null,null,"Linear",0.5],["say","avg1_130","Yeah, but the delivery's done! Technically, your job is finished.",0,""],["w",0.5],["ctl","avg1_125","b","017","speechless",null,null,null,null,null,"Linear",0.5],["w",0.5],["say","avg1_125","Not until I see you safely back to Port Bellin.==W== The contract stands.",0,""],["w",0.4],["ctl","avg1_125","b","005",null,null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["ctl","avg1_130","b","005","happy",null,null,null,null,"youzai","Linear",0.5],["say","avg1_130","Thank you so much!",0,""],["w",0.5],["ctl","avg1_130","b","004","attention",null,null,null,null,null,"Linear",0.5],["say","avg1_130","So, after you drop me off at Port Bellin, what's next for you?",0,""],["w",0.5],["ctl","avg1_125","b","017",null,null,null,null,null,null,"Linear",0.5],["w",0.5],["say","avg1_125","Um...==W== I'm not sure. I suppose I'll just see where the road takes me.",0,""],["w",0.5],["ctl","avg1_125","b","014","vexation",null,null,null,null,null,"Linear",0.5],["goon"],["ctl","avg1_125","b","004","sigh",null,null,null,null,null,"Linear",0.5],["say","avg1_125","... I suppose even I don't really know what my next step should be.",0,""],["ctl","avg1_125","b","012",null,null,null,null,null,null,"Linear",0.5],["w",0.5],["ctl","avg1_130","b","009","shock",null,null,null,null,null,"Linear",0.5],["say","avg1_130","If that's the case...==W== Do you wanna join me as a courier?",0,""],["w",0.5],["se","se_101"],["ctl","avg1_130","b",null,null,0.6,null,null,null,null,"OutQuad",0.7],["stg",0,180.0,-30.0,1.2,"OutQuad",0.7,null,null,null],["w",0.5],["ctl","avg1_130","b","004","idea",null,null,null,null,null,"Linear",0.5],["goon"],["ctl","avg1_130","b","002","music",null,null,null,null,"huanxin","Linear",0.5],["say","avg1_130","After this commission, I'm more convinced. Having a reliable partner is truly amazing! What do you say? Come team up with me!",0,""],["w",0.5],["ctl","avg1_125","b","019","speechless",null,null,null,null,null,"Linear",1.0],["w",1.0],["ctl","avg1_125","b","017","question",null,null,null,null,null,"Linear",0.5],["say","avg1_125","Actually... I've been curious. Why go to such lengths just to deliver letters? This one was over a decade old. You're not even getting paid for it.",0,""],["w",0.5],["ctl","avg1_130","b","008",null,null,null,null,null,"niunie","Linear",0.5],["say","avg1_130","It's not about the money. Some things just have to be done.",0,""],["w",0.5],["say","avg1_130","People write letters to convey what they can't express in person, yet still wish to convey. If the letters get lost... Then those heartfelt messages never reach the heart they belong to, do they?",0,""],["ctl","avg1_125","b","014",null,null,null,null,null,null,"Linear",1.0],["w",0.5],["ctl","avg1_130","b","006",null,null,null,null,null,"youzai","Linear",0.5],["say","avg1_130","That is precisely why I became a courier. The thought that if I try just a little harder, perhaps one more person might be saved by a letter delivered in time...",0,""],["w",1.0],["se","se_077"],["ctl","avg1_125","b","002",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_125","Saving others... It truly is an important job.",0,""],["w",0.5],["ctl","avg1_130","b","005","happy",null,null,null,null,"huanxin","Linear",0.5],["say","avg1_130","Right? Then starting today, Freesia, we're partners!",0,""],["w",0.5],["ctl","avg1_130","b","009","shy",null,null,null,null,"niunie1","Linear",0.5],["say","avg1_130","Well... The pay isn't exactly great... But if you don't want to go back just yet... You can stay with me! I can cook too! How about it? How about it?",0,""],["w",0.5],["ctl","avg1_125","b","015",null,null,null,null,null,null,"Linear",0.5],["say","avg1_125","But...==W== Perhaps I have no right to be a courier. After all, I'm the one ignoring the very feelings ... that are trying to reach me.",0,""],["w",0.5],["ctl","avg1_125","b","013","sigh",null,null,null,null,null,"Linear",0.5],["w",0.5],["goon"],["ctl","avg1_125","b",null,null,null,null,null,null,null,"Linear",0.5],["w",0.5],["ctl","avg1_130","b","003","question",null,null,null,null,"chijing","Linear",0.5],["say","avg1_130","Eh? You mean...",0,""],["w",0.5],["ctl","avg1_125","b","002",null,null,null,null,null,null,"Linear",0.5],["say","avg1_125","When I ran away from home, my mother tucked a letter into my bag. I still haven't been able to open it...==W== How can I be a courier, when I can't even face a letter from my own family?",0,""],["w",0.4],["ctl","avg1_125","b","019",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg1_130","b","009",null,null,null,null,null,null,"Linear",0.5],["say","avg1_130","I see...==W== But I think that's all the more reason you should give it a try!",0,""],["w",0.5],["ctl","avg1_130","b","007","star",null,null,null,null,"huanxin","Linear",1.0],["goon"],["w",0.5],["ctl","avg1_125","b","017","shock",null,null,null,null,null,"Linear",0.5],["say","avg1_125","Why? I can't even treat the feelings within these letters with such sincerity like you do...",0,""],["ctl","avg1_125","b",null,null,null,null,null,null,null,"Linear",0.5],["w",0.5],["ctl","avg1_130","b","006","happy",null,null,null,null,null,"Linear",0.5],["say","avg1_130","Actually, I was just as lost as you are when I first started... I even hesitated, too, over whether or not I should open that letter addressed to me.",0,""],["w",0.5],["ctl","avg1_130","b","002","star",null,null,null,null,"daintou","Linear",0.5],["say","avg1_130","But I still became who I am today—a courier. Who knows? Maybe you too will change your mind someday, if the right opportunity comes along.",0,""],["w",0.5],["se","se_100"