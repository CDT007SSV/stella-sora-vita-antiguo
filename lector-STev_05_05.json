l","avg1_130","a",null,"sigh",null,null,null,null,"daintou","Linear",1.0],["w",0.3],["ctl","avg3_138","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.1],["ctl","avg3_139","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.1],["ctl","avg3_143","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.1],["ctl","avg3_144","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.1],["ctl","avg3_167","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",1.0],["se","se_077"],["ctl","avg1_130","a","010",null,null,-0.3,null,null,null,"OutQuad",1.0],["bg","posthouse_inside_dusk",0,0.6],["w",0.3],["say","avg1_130","Even back then, I figured it out pretty quickly:==W== No matter where I stayed, I'd always just be the outsider.",0,""],["w",0.4],["goon"],["stg",0,null,null,1.13,"Linear",1.0,null,null,null],["ctl","avg1_130","a","009","sigh",null,null,null,null,"JuGong","Linear",0.5],["w",1.5],["se","se_048"],["trn",0,1,true,true,0.8],["w",0.8],["stg",0,0.0,0.0,1.2,"Linear",0.0,null,null,null],["fx",0,"fx_avg_reminiscence_loop",0,1],["bg","posthouse_night",0,0.0],["show","avg1_130","a","006",null,null,null,0,null,null],["ctl","avg1_130","a","006",null,null,-0.13,1.2,null,null,"Linear",0.1],["w",0.1],["trn",1,1,false,false,1.0],["w",1.5],["say","avg1_130","I just...==W== I don't ever want to be alone again.",0,""],["w",0.6],["stg",0,null,-50.0,1.5,"OutQuad",0.6,null,null,null],["ctl","avg1_130","a","015",null,null,null,null,null,null,"Linear",0.35],["w",0.35],["goon"],["w",0.5],["trn",0,0,true,true,1.0],["w",1.0],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["fx",0,"fx_avg_reminiscence_loop",1,1],["w",0.3],["mrt",1,"y","020","think",null],["say","avg3_100","... So that's what she meant. She's been through so much...",2,""],["mrt",3,"y",null,null,null],["show","avg1_130","a","014",null,-0.06,1.1,0,null,null],["bg","posthouse_inside_dusk",0,0.0],["w",0.5],["trn",1,0,false,false,1.0],["w",1.5],["ctl","avg1_130","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_130","To avoid getting tossed aside, I watched everyone constantly, shape-shifting into whatever they wanted me to be… Just when I started losing track of who I really was...==W== It found me. A letter from my parents.",0,""],["w",0.5],["ctl","avg1_130","a","008","star",null,null,null,null,"diantou","Linear",1.0],["goon"],["w",0.5],["mrt",1,"z","002","shock",null],["say","avg3_100","Eh...?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_130","a","003","happy",null,null,null,null,"huanxin","Linear",0.5],["say","avg1_130","Haha... It gave me quite a shock, too. Turns out, they mailed it while they were still alive.",0,""],["w",0.5],["ctl","avg1_130","a","015","vexation",null,null,null,null,null,"Linear",0.5],["say","avg1_130","But it never reached me. Right after sending it... They died in an accident. And since I kept bouncing between relatives, it was never delivered to the right address.",0,""],["w",0.5],["mrt",1,"z","012",null,null],["say","avg3_100","Then ... how did it finally find you?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_130","a","008","attention",null,null,null,null,"daintou","Linear",0.5],["say","avg1_130","It was the courier. He refused to give up the search ... for years.",0,""],["w",0.5],["mrt",1,"z","025","symbol",null],["say","avg3_100","Years?!",1,""],["bgm",""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_130","a","003","star",null,null,null,null,"huanxin","Linear",0.5],["say","avg1_130","Incredible, isn't it? I owe that courier ... everything. I'm only standing here today because that letter was delivered to me.",0,""],["w",0.5],["bgm","m39"],["ctl","avg1_130","a","006",null,null,null,null,null,"niunie","Linear",0.5],["say","avg1_130","The pages were filled with their love, with affections—\"Donna, we love you.\"==W== Realizing I was actually deeply loved by someone... It saved my life.",0,""],["w",0.5],["stg",0,null,-50.0,1.3,"OutQuad",0.6,null,null,null],["w",0.6],["ctl","avg1_130","a","016","flurry",null,null,null,null,"ChanDou","Linear",1.0],["goon"],["w",1.0],["stg",0,null,0.0,1.2,"OutQuad",1.0,null,null,null],["w",0.7],["mrt",1,"z","023",null,"diantou"],["say","avg3_100","I see... I'm so glad that letter found its way to you.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_130","a","006",null,null,null,null,null,"huanxin","Linear",0.5],["say","avg1_130","That's why ... I decided to become a courier.",0,""],["w",0.5],["ctl","avg1_130","a","008","star",null,null,null,null,null,"Linear",0.5],["say","avg1_130","I want to help people by delivering their sentiment. Maybe I can save someone, too. Just like how that courier saved me.",0,""],["w",0.5],["mrt",1,"z","002","idea",null],["say","avg3_100","That explains why you're so desperate for the recipient to read their letter.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_130","a","007",null,null,null,null,null,"daintou","Linear",0.5],["say","avg1_130","Yeah. It's tragic when feelings vanish without ever being heard. And ... I do not wish for regrets upon the recipient.",0,""],["w",0.5],["ctl","avg1_130","a","014",null,null,null,null,null,"lengzhan2","Linear",1.0],["say","avg1_130","But ... in the end, that's just me projecting. Bringing personal emotions into work is wrong!==W== I'm the leader of Post Haste. I need to make decisions that are best for the business...",0,""],["w",0.5],["ctl","avg1_130","a","010",null,null,null,null,null,"diantou","Linear",0.5],["w",0.5],["goon"],["w",0.5],["mrt",1,"z","011",null,null],["say","avg3_100","Sometimes, there's nothing wrong with that. In fact, we can call that your \"conviction.\"",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_130","a","012","question",null,null,null,null,null,"Linear",0.5],["say","avg1_130","Conviction...?",0,""],["w",0.5],["mrt",1,"z","004","attention","diantou"],["say","avg3_100","Yeah. Only a leader with conviction is worth following.",1,""],["w",0.5],["mrt",0,"z","002",null,null],["say","avg3_100",