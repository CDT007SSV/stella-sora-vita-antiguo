ll,"niunie1","Linear",1.0],["say","Howard","Ideals are fine, but you only live once. You can't achieve anything if you're dead. I won't support this...==W== This reckless game of \"courier\" you're playing. Please leave.",0,""],["w",1],["ctl","avg3_139","a",null,null,null,null,null,null,null,"Linear",1.0],["goon"],["w",0.5],["mrt",1,"z","003","attention",null],["bgm",""],["say","avg3_100","\"Reckless game\"...? I can't let that slide.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_130","b","014","question",null,null,null,null,null,"Linear",1.0],["ctl","avg3_139","a","008",null,null,null,null,null,null,"Linear",1.0],["say","avg1_130","Boss...?",0,""],["w",0.5],["mrt",1,"z","026",null,null],["say","avg3_100","Post Haste puts their lives on the line to deliver mail, yes—but don't mistake that for recklessness.",1,""],["bgm",""],["mrt",0,"z","003",null,"JuGong"],["say","avg3_100","You're right. You can't fulfill an ideal if you're dead. But knowing that is exactly why they are so strong.",1,""],["mrt",0,"z","014",null,null],["say","avg3_100","Since they promised to deliver every letter, they make it their business to survive. Getting stronger, tougher, and staying safe... That is part of the job.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["stg",0,null,0.0,1.0,"OutCubic",1.0,null,null,null],["ctl","avg1_130","b",null,null,0.35,null,0.87,0.0,null,"OutQuint",1.0],["ctl","avg3_139","a",null,null,0.65,null,-0.9,0.0,null,"OutQuint",1.0],["w",0.5],["show","avg1_125","a","003",0.7,null,1.05,0,null,0.0],["show","avg1_127","a","006",0.3,null,1.05,0,null,0.0],["ctl","avg1_127","a",null,null,0.32,null,1.0,1.0,null,"OutQuint",1.0],["ctl","avg1_125","a",null,null,0.68,null,1.0,1.0,null,"OutQuint",1.0],["se","se_077"],["w",0.5],["bgm","m66"],["say","avg1_125","... Precisely.==W== We refuse to let anything stop us from completing a delivery.",0,""],["w",1],["goon"],["ctl","avg1_127","a","003","happy",null,null,null,null,"tiao2","Linear",1.0],["say","avg1_127","That's right!==W== If something happened to us, the mail wouldn't get delivered, and that's not an option!",0,""],["w",1],["goon"],["ctl","avg1_125","a",null,null,0.7,null,1.05,0.0,null,"OutQuint",1.0],["hide","avg1_125",1.0],["ctl","avg1_127","a",null,null,0.3,null,1.05,0.0,null,"OutQuint",1.0],["hide","avg1_127",1.0],["stg",0,null,20.0,1.1,"OutCubic",1.0,null,null,null],["w",0.5],["ctl","avg3_139","a","004",null,0.68,null,-1.0,1.0,null,"OutQuint",1.0],["ctl","avg1_130","b","009","speechless",0.32,null,0.97,1.0,null,"OutQuint",1.0],["se","se_062"],["w",0.5],["say","avg1_130","Freesia... Teresa...==W== You're right.==W== Yes.",0,""],["w",0.5],["ctl","avg1_130","b","002",null,null,null,null,null,"JuGong","Linear",1.0],["goon"],["w",1],["goon"],["w",0.5],["trn",0,1,false,false,0.5],["w",0.5],["ctl","avg1_130","b","013",null,0.35,null,null,0.0,null,"OutQuint",0.0],["hide","avg1_130",0],["ctl","avg3_139","a",null,null,null,null,null,0.0,null,"Linear",0.0],["hide","avg3_139",0],["stg",0,0.0,0.0,1.0,"OutQuint",0.0,null,null,null],["w",0.5],["bg","story_event_05_002_a",0,0.0],["cbg",0,-450.0,600.0,1.8,"Linear",0.0,null,null,null],["se","se_062"],["bgm",""],["stg",0,null,null,1.05,"OutQuad",4.0,null,null,null],["trn",1,1,false,false,0.5],["w",0.5],["say","avg1_130","Mr. Howard, maybe we do seem reckless to you... Maybe it looks like we're gambling with our lives. But—",9,""],["w",0.5],["say","avg1_130","We aren't going down that easily.",9,""],["w",0.5],["say","Howard","What do you mean?",9,""],["w",0.5],["bg","story_event_05_002_a",0,1.0],["se","se_074"],["say","avg1_130","Distance can separate us, but the need to connect remains... That desire to bridge the gap is exactly why we write letters.",9,""],["w",0.5],["say","avg1_130","But ... pouring your soul onto paper means nothing if the message never arrives. Without a courier, all those feelings simply vanish into the void.",9,""],["w",0.5],["show","avg1_103","a","002",0.55,-0.5,1.8,0,"flurry",0.0],["say","avg1_130","The pay is terrible, and the danger is real... But that's no excuse to walk away. If the world lacks people to do this job, then we will step up.",9,""],["w",0.5],["say","avg1_130","We refuse to fall. Until every last message is delivered safely, we'll survive whatever hell awaits us. We'll keep fighting.",9,""],["w",0.5],["say","Howard","Why are you going so far for this...",9,""],["trn",0,1,false,false,0.5],["w",0.5],["bg","story_event_05_002_b",0,0.0],["stg",0,null,null,1.0,"OutQuad",3.0,null,null,null],["trn",1,1,false,false,0.5],["fx",0,"fx_avg_sunlight_flip",0,0],["se","se_226"],["say","avg1_130","Because a letter once saved my life, delivering a message from the past to give me strength... And it made me who I am today.",9,""],["w",0.5],["say","avg1_130","I'm dedicating my life to ensuring no letter goes undelivered, and no feeling goes unheard!",9,""],["w",0.5],["trn",0,0,false,false,1.0],["w",1.0],["show","avg3_139","a","004",0.68,null,null,0,null,1.0],["show","avg1_130","b","004",0.32,0.06,0.97,0,null,null],["ctl","avg1_103","a",null,null,null,null,null,null,null,"Linear",0.0],["hide","avg1_103",0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,50.0,0.0,1.0,"OutQuint",0.0,null,null,null],["bg","beilin_house_dusk",0,0.0],["w",0.5],["trn",1,0,false,false,1.0],["w",1.0],["say","Howard","... I always figured Trekkers were just reckless idiots with a death wish.==W== Exactly like the bastard of a father who wrote this.",0,""],["w",1],["goon"],["ctl","avg1_130","b","009","attention",null,null,null,null,null,"Linear",1.0],["say","avg1_130","You recognize the sender?",0,""],["ctl","avg3_139","a",null,null,0.6,null,null,null,null,"OutQuint",1.0],["stg",0,null,0.0,1.1,"OutQuint",1.0,null,null,null],["ctl","avg1_130","b",null,null,0.27,null,null,0.0,null,"OutQuint",1.0],["hide","avg1_130",1.0],["obj","qstory_event_05_001",1,0.35,0.55],["se","se_252"],["say","Howard","That specific signature style... It's the old man's handwriting, no doubt about it. I'd recognize that scrawl anywhere.",0,""],["ctl","avg3_139","a",null,"speechless",null,null,null,null,"niunie1","Linear",1.0],["say","Howard","Business was slow back then... So he just up and left to become a Trekker.==W== Irresponsible old fool. Abandoning a solid trade in pursuit of danger... He was out of his mind.",0,""],["w",1],["ctl","avg3_139","a",null,null,null,null,null,null,null,"Linear",1.0],["goon"],["w",0.5],["mrt",1,"y","020","question",null],["say","avg3_100","Then why do you still forge equipment for Trekkers?",1,""],["mrt",0,"y","002",null,null],["say","avg3_100","Howard gear is renowned for combining durability with a lightweight design. For Trekkers facing constant danger, that kind of reliability is a lifeline.",1,""],["mrt",0,"z","014","attention","diantou"],["say","avg3_100","You talk trash about the profession, yet you hung your sign back up and kept working the forge. Why?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_139","a","008",null,0.5,null,null,null,null,"OutQuint",1.0],["stg",0,0.0,0.0,1.0,"OutQuint",1.0,null,null,null],["cbg",0,0.0,0.0,1.0,"OutQuint",1.0,null,null,null],["objx"],["se","se_021"],["say","Howard","... Someone has to look out for those suicidal maniacs, don't they?==W== Someone has to save their necks.",0,""],["w",1],["goon"],["ctl","avg3_139","a","004",null,0.72,-0.5,1.8,0.8,null,"OutQuint",1.0],["stg",0,null,-100.0,1.05,"OutSine",3.0,null,null,null],["bg","beilin_street_dusk",0,1.0],["say","Howard","Look, I know Nova needs Trekkers.==W== Everyone living safely in the cities with their Artifacts owes that peace to them, one way or another.",0,""],["w",1],["goon"],["bg","wild_tower_dusk",0,1.0],["say","Howard","\"Some jobs in this world just have to get done. I want to help, so I make gear.\" My dad used to say that all the time...==W== And I guess I feel the same way.",0,""],["w",1],["goon"],["chd",0,0,"avg1_127","a","009",null],["ctl","avg1_127","a",null,"question",null,null,null,null,null,"Linear",1.0],["say","avg1_127","If that's true,==W== why do you badmouth him so much, meow?",0,""],["w",0.5],["goon"],["show","avg1_130","b","014",0.32,0.06,0.97,0,null,null],["chd",1,0,"avg1_127","a","002",null],["bg","beilin_house_dusk",0,1.0],["stg",0,0.0,20.0,1.1,"OutQuint",1.0,null,null,null],["ctl","avg3_139","a","007","resentful",0.68,0.0,1.0,1.0,null,"OutQuint",1.0],["say","Howard","He abandoned his family without a word for that dangerous life, and we haven't heard a peep since.==W== Who wouldn't be pissed off?",0,""],["w",1],["goon"],["ctl","avg1_130","b",null,null,null,null,null,null,"lengzhan","Linear",1.0],["say","avg1_130","Mr. Howard...",0,""],["ctl","avg3_139","a","004",null,null,null,null,null,"JuGong","Linear",1.0],["se","se_113"],["say","Howard","Sigh... Sorry you had to see that.==W== I made a fool of myself. I'll take the letter.",0,""],["w",1],["goon"],["ctl","avg1_130","b","002","symbol",null,null,null,null,"Tiao","Linear",1.0],["say","avg1_130","R-Really?!",0,""],["ctl","avg3_139","a","006",null,null,null,null,null,"niunie1","Linear",1.0],["say","Howard","If I refused something you Trekkers fought tooth and nail to recover...==W== My reputation as a smith who \"protects Trekker lives\" wouldn't be worth scrap.",0,""],["w",0.5],["goon"],["ctl","avg1_130","b","005","star",null,null,null,null,"daintou","Linear",1.0],["say","avg1_130","Thank you so much!",0,""],["w",0.5],["ctl","avg1_130","b",null,null,0.25,null,null,0.0,null,"OutQuint",1.0],["hide","avg1_130",1.0],["ctl","avg3_139","a","002",null,0.5,null,null,null,null,"OutQuart",1.0],["stg",0,null,-50.0,1.2,"OutQuint",1.0,null,null,null],["se","se_088"],["bgm",""],["film",0],["w",0.5],["se","se_357"],["w",0.5],["ctl","avg3_139","a","004",null,null,null,null,null,"lengzhan","Linear",1.0],["say","0","He takes the tattered envelope from the girl and tears it open. A hard, round Artifact tumbles out.",3,""],["w",0.5],["film",1],["ctl","avg3_139","a",null,null,null,null,null,null,"JuGong","Linear",1.0],["se","se_100"],["bgm",""],["w",1],["ctl","avg3_139","a","007","attention",null,null,null,null,null,"Linear",1.0],["say","Howard","Is this ... a rolled-up ruler with markings? Looks handy, I guess. But why would the old man send me this kind of th—",0,""],["w",0.5],["film",0],["say","0","Howard chokes on his words, eyes glued to the letter.",3,""],["w",0.5],["film",1],["w",0.5],["bgm","m50"],["se","se_021"],["say","0","\"To my beloved son—\"",8,""],["w",0.5],["se","se_252"],["say","0","\"Not sure if this will ever reach you, but I found a neat Artifact I wanted you to have. It's called a 'Tape Measure.' Figured it'd come in handy for sizing things up when you're crafting gear.\"",8,""],["w",0.5],["se","se_252"],["say","0","\"You always dreamed of being a smith. But the shop started failing under my watch, and I've always felt like I let you down... I left the city to find work and raise money... But I was too ashamed to tell you the truth before I left. Please, forgive your old man's foolish pride.\"",8,""],["w",0.5],["se","se_252"],["say","0","\"These days, I take Trekker commissions and sell my gear in the field. Even doing maintenance on the side—business is booming! So, just focus on honing your craft. Don't worry about money. I'm sending cash to your mother.\"",8,""],["w",0.5],["se","se_252"],["say","0","\"I'll come home once I've saved up a bit more... When I do, I'd love for you to work on my gear... Haha, too much to ask?\"",8,""],["w",0.5],["stg",0,0.0,0.0,1.0,"OutQuint",1.0,null,null,null],["se","se_021"],["ctl","avg3_139","a","005",null,null,null,null,null,null,"Linear",1.0],["say","Howard","Until then, thank you for keeping the family name alive\"...==W== What is this... What in the world?",0,""],["w",1],["goon"],["ctl","avg3_139","a",null,null,null,null,null,null,"lengzhan","Linear",1.0],["say","Howard","Dad left ... for the family? For me? That's why he became a Trekker...?",0,""],["ctl","avg3_139","a","008","flurry",null,null,null,null,"lengzhan","Linear",1.0],["say","Howard","You have to be kidding me... And I... All this time... Ugh...",0,""],["show","avg1_130","b","014",0.35,0.06,0.97,0,null,0.0],["cbg",0,-50.0,null,null,"OutQuint",1.0,null,null,null],["ctl","avg3_139","a",null,null,0.6,null,null,null,null,"OutQuint",1.0],["ctl","avg1_130","b",null,null,0.4,null,null,1.0,null,"OutQuint",1.0],["se","se_100"],["say","avg1_130","...==W== Take this handkerchief.",0,""],["w",1.0],["goon"],["se","se_390"],["ctl","avg3_139","a","004",null,null,null,null,null,"JuGong","Linear",1.0],["say","Howard","Sorry...==W==",0,""],["ctl","avg1_130","b","006",null,0.38,null,null,null,null,"OutQuint",1.0],["w",1.0],["goon"],["cbg",0,0.0,null,null,"OutQuint",1.0,null,null,null],["ctl","avg1_130","b",null,null,0.35,null,0.95,null,null,"OutQuint",1.0],["ctl","avg3_139","a",null,"speechless",0.52,-0.1,1.2,null,null,"OutQuint",1.0],["say","Howard","My father became a Trekker for my dream... Yet I've sat here hating him for it all this time...==W== How could I be so... I'm pathetic...",0,""],["ctl","avg1_130","b","009",null,null,null,null,null,null,"Linear",1.0],["w",1],["ctl","avg3_139","a",null,null,null,null,null,null,null,"Linear",1.0],["goon"],["stg",0,150.0,null,1.2,"OutQuint",1.0,null,null,null],["cbg",0,null,null,0.98,"OutQuint",1.0,null,null,null],["ctl","avg1_130","b","013",null,0.38,0.03,1.02,null,null,"OutQuint",1.0],["ctl","avg3_139","a",null,null,0.72,-0.18,1.35,null,null,"OutQuint",1.0],["se","se_226"],["say","avg1_130","Don't say that!==W== I think you've done amazing, Mr. Howard!",0,""],["w",1],["goon"],["ctl","avg3_139","a","008",null,null,null,null,null,"lengzhan","OutQuint",1.0],["say","Howard","Huh?",0,""],["stg",0,0.0,20.0,1.1,"OutQuint",1.0,null,null,null],["cbg",0,0.0,0.0,1.0,"OutQuint",1.0,null,null,null],["ctl","avg1_130","b",null,"attention",0.32,0.06,0.97,null,null,"OutQuint",1.0],["ctl","avg3_139","a",null,null,0.68,0.0,1.0,null,null,"OutQuint",1.0],["say","avg1_130","Look at you! You became an incredible smith, didn't you?==W== Your father's wish has already come true!",0,""],["w",1],["goon"],["ctl","avg1_130","b","006","happy",null,null,null,null,"JuGong","Linear",1.0],["say","avg1_130","He supported the dream of the son he loved...==W== And you made it happen with your own hands!",0,""],["w",1],["goon"],["ctl","avg3_139","a","002",null,null,null,null,null,"lengzhan","Linear",1.0],["say","Howard","... Thank you. Thanks for bringing this to me...==W== Because of this letter, I think ... I can finally take a few real steps forward.",0,""],["w",1],["ctl","avg3_139","a","003",null,null,null,null,null,"diantou","Linear",1.0],["goon"],["bgm",""],["w",0.5],["trn",0,0,false,false,2.0],["w",2.0],["end"]]}