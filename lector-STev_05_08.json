TiaoYue","OutQuad",0.5],["w",0.5],["say","avg1_130","Goooood morning, Boss! Whatcha up to?",0,""],["w",0.5],["mrt",1,"z","013",null,null],["say","avg3_100","Morning, Donna. Just taking in the view one last time. Trying to burn it into my memory.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_236"],["ctl","avg1_130","a",null,null,null,-0.3,1.35,null,"JuGong","OutQuad",0.6],["stg",0,null,30.0,1.2,"OutQuad",0.6,null,null,null],["w",1],["ctl","avg1_130","a","017","star",null,null,null,null,"youzai","Linear",0.5],["say","avg1_130","Gorgeous, right? This is actually my favorite spot for morning-gazing.",0,""],["w",0.5],["mrt",1,"z","023",null,"diantou"],["say","avg3_100","It really is. And this breeze... Just enough to wake me up from my morning daze.",1,""],["w",0.5],["mrt",0,"z","002","attention",null],["say","avg3_100","Did you sleep well?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_130","a","009","star",null,null,null,null,"diantou2","Linear",0.5],["say","avg1_130","Like a log! Now that the job's done, I am recharged, refreshed, and back at 100%!",0,""],["w",0.5],["ctl","avg1_130","a","008",null,null,null,null,null,null,"Linear",0.5],["say","avg1_130","But ... that also means the New Star Guild's contract is up. You're heading out today, aren't you?",0,""],["w",0.5],["mrt",1,"z","002",null,null],["say","avg3_100","Yeah. Iris says it's time to hit the road.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_130","a","014",null,null,null,null,null,"niunie","Linear",0.5],["say","avg1_130","Aww, what a bummer! You guys are total naturals at this courier stuff. If you stuck around to help, I'd sleep way better at night!",0,""],["w",0.5],["mrt",1,"z","014","music",null],["say","avg3_100","Haha, please. Compared to Post Haste, we're mere amateurs.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_130","a","003","happy",null,null,null,null,null,"Linear",0.5],["say","avg1_130","Hahaha, I'm just teasing! But seriously... Even if it was just for a few days, I really enjoyed working with you all.",0,""],["w",0.5],["mrt",1,"z","002",null,null],["say","avg3_100","I ...==W== really enjoyed it, too.",1,""],["w",0.6],["mrt",0,"z","013","love",null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_130","a","002",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_130","... Yeah. Plus, watching you work made me realize something, Boss. I've got a long way to go before I can call myself a real leader.",0,""],["w",0.5],["ctl","avg1_130","a","017","star",null,null,null,null,"huanxin","Linear",0.5],["say","avg1_130","There's so much more for me to learn... I have to push myself to be more like you, Boss.",0,""],["w",0.5],["mrt",1,"z","002",null,null],["say","avg3_100","Donna, you don't need to be like me.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_130","a","005","shock",null,null,null,null,"chijing","Linear",0.5],["say","avg1_130","Huh?",0,""],["ctl","avg1_130","a",null,null,null,null,null,null,null,"Linear",0.5],["w",0.5],["mrt",1,"z","012",null,null],["say","avg3_100","You have your own strengths. The Donna standing in front of me is already an incredible leader.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_130","a","012","flurry",null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_130","R-Really? You think so...? I...",0,""],["w",0.5],["mrt",1,"z","002",null,null],["say","avg3_100","Remember what I told you? A leader without conviction won't have any followers.",1,""],["w",0.5],["ctl","avg1_130","a","018",null,null,null,null,null,null,"Linear",0.5],["mrt",0,"z","002",null,null],["say","avg3_100","It was your conviction that pulled us through. Everyone followed you because they believed in you.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_130","a","013","shy",null,null,null,null,"youzai","Linear",0.5],["say","avg1_130","Quit it, Boss! You're way too good at flattery! Keep talking like that and you'll make me blush.",0,""],["w",0.5],["trn",0,0,true,true,1.0],["w",1.0],["cbg",0,null,null,1.05,"Linear",0.0,null,null,null],["stg",0,0.0,0.0,1.1,"Linear",0.0,null,null,null],["show","avg1_130","a","012",null,-0.06,1.1,0,null,null],["w",1],["trn",1,0,false,false,1.0],["w",1.5],["ctl","avg1_130","a","014","sigh",null,null,null,null,"diantou","Linear",0.5],["bgm",""],["say","avg1_130","... This is the last time we'll be chatting like this, right, Boss? Makes me feel kinda lonely.",0,""],["w",0.5],["mrt",1,"z","012","speechless",null],["stg",0,null,-30.0,1.3,"Linear",1.5,null,null,null],["say","avg3_100","Donna...",1,""],["mrt",3,"z",null,null,null],["w",1.0],["ctl","avg1_130","a","010",null,null,null,null,null,null,"Linear",0.5],["say","avg1_130","I'm terrible at goodbyes. Did I ever tell you? I used to drift from place to place, never really had a home.",0,""],["w",0.5],["ctl","avg1_130","a","012",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_130","Friendships, trust ... and connections... It always feels like they could vanish at any moment. I can't stop thinking about it...==W== And it makes me feel so alone.",0,""],["w",0.5],["ctl","avg1_130","a","015",null,null,null,null,null,"lengzhan","Linear",0.5],["goon"],["w",0.5],["ctl","avg1_130","a","016",null,null,null,null,null,"stop","Linear",0.5],["w",0.5],["say","avg1_130","That's why ...==W== I'm terrified Post Haste will end up like that too. I work myself to the bone just to keep us all together...",0,""],["w",0.4],["ctl","avg1_130","a",null,"flurry",null,null,null,null,"ChanDou1","Linear",0.5],["goon"],["w",1.0],["se","se_077"],["stg",0,null,null,1.35,"OutQuad",0.6,null,null,"jushou"],["w",0.6],["ctl","avg1_130","a","015","shock",null,0.0,1.0,null,"jushou","OutCubic",0.5],["w",0.5],["say","avg1_130","—Ah! S-Sorry! Why am I getting so emotional...? Somehow, I always end up spilling my guts talking to you, Boss.",0,""],["ctl","avg1_130","a",null,null,null,null,null,null,null,"Linear",0.5],["w",0.3],["stg",0,null,null,1.25,"OutQuad",0.7,null,null,null],["w",1],["mrt",1,"z","012",null,null],["say","avg3_100","Goodbyes happen. It sounds sad, but nothing in this world lasts forever.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_130","a","014",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_130","... Yeah, I know.",0,""],["w",0.5],["mrt",1,"z","022","idea",null],["bgm",""],["say","avg3_100","But we can write. Even if we're miles apart, a letter can still reach you.",1,""],["w",0.3],["mrt",0,"z","017",null,null],["say","avg3_100","\"Even when people are miles apart, a letter keeps their connection alive.\"==W== Isn't that right, Donna?",1,""],["w",0.5],["mrt",0,"z","013",null,null],["goon"],["ctl","avg1_130","a","008",null,null,null,null,null,null,"Linear",0.5],["w",0.5],["mrt",0,"z","014","music","diantou"],["say","avg3_100","As long as we have the power of letters, you'll never be alone.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_130","a","003","happy",null,null,null,null,"niunie1","Linear",0.5],["say","avg1_130","I'm the courier here, yet you're the one teaching me about the power of letters... You got me.",0,""],["w",0.5],["ctl","avg1_130","a","002",null,null,null,null,null,null,"Linear",0.5],["say","avg1_130","You're right. Letters are the bridge that connects us all.",0,""],["w",0.5],["mrt",1,"z","013","attention",null],["say","avg3_100","Write to me anytime. I promise I'll write back.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_208"],["ctl","avg1_130","a",null,null,null,-0.25,1.3,null,"diantou","Linear",0.5],["say","avg1_130","You bet! It's a promise, Boss!",0,""],["w",0.5],["stg",0,null,null,null,"Linear",0.5,null,null,"jushou"],["w",0.5],["se","se_074"],["bgm",""],["trn",0,0,true,true,0.6],["w",0.6],["stg",0,-100.0,0.0,1.1,"Linear",0.0,null,null,null],["bg","posthouse",0,0.0],["show","avg1_127","a","017",0.65,null,null,0,null,0.0],["trn",1,0,false,false,0.6],["w",0.6],["se","se_072"],["ctl","avg1_127","a",null,null,0.6,null,null,1.0,"2TiaoYue",