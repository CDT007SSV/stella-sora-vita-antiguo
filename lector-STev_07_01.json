y","020","think",null],["say","avg3_100","That's weird. Aren't we going to talk about the commission?",2,""],["mrt",3,"y",null,null,null],["w",0.5],["se","se_076"],["stg",0,null,null,1.0,"OutCubic",1.0,null,null,null],["trn",0,0,false,true,1.0],["w",1.0],["ctl","avg3_205","a","003",null,null,null,null,null,null,"Linear",0.0],["w",1],["stg",0,null,null,1.1,"OutCubic",1.0,null,null,null],["trn",1,0,false,false,1.0],["w",1.0],["mrt",1,"z","009","happy",null],["say","avg3_100","Later, we went into the Monolith together and fought Stellaroids...==W== Anyway, I kinda helped Firefly make her wish come true.",1,""],["w",0.7],["mrt",0,"z","003","music","diantou"],["goon"],["mrt",0,"z","002",null,"daintou"],["say","avg3_100","... And that's basically it.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_205","a",null,"speechless",null,null,null,null,"diantou2","Linear",0.5],["say","avg3_205","I see. So there was a whole episode like that during the Snowish Festival...",0,""],["w",0.5],["ctl","avg3_205","a","008","flower",null,null,null,null,null,"Linear",0.5],["say","avg3_205","Heh. Then it seems I really did ask the right person for this commission.",0,""],["w",0.5],["mrt",1,"z","021","question",null],["say","avg3_100","... Hm? What do you mean by that?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_205","a",null,"happy",null,null,null,null,"daintou","Linear",0.5],["say","avg3_205","I mean that, since you already have experience with her, there's clearly no one more suitable for this job than you.",0,""],["ctl","avg3_205","a","007",null,null,null,null,null,null,"Linear",0.5],["say","avg3_205","The commission is this:==W== I'd like you to look after Firefly for a while.",0,""],["w",0.7],["ctl","avg3_205","a",null,"star",null,null,null,null,"youchupeng","Linear",1.0],["goon"],["w",0.5],["mrt",1,"z","015","shock",null],["say","avg3_100","... That's it?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_205","a","003","speechless",null,null,null,null,"niunie1","Linear",0.5],["say","avg3_205","That's it...",0,""],["w",0.5],["ctl","avg3_205","a","004","awkward",null,null,null,null,"diantou","Linear",0.5],["say","avg3_205","Well, it's not as simple as it sounds.",0,""],["ctl","avg3_205","a","005",null,null,null,null,null,null,"Linear",0.5],["say","avg3_205","I imagine you've already noticed to some extent that Firefly grew up in a very unusual environment.",0,""],["ctl","avg3_205","a","009","sigh",null,null,null,null,null,"Linear",0.5],["say","avg3_205","Because of that, there are many ways in which she differs from ordinary children...==W== In other words, her sense of what is normal is a little different...",0,""],["w",0.7],["goon"],["w",0.5],["ctl","avg3_205","a",null,"vexation",null,null,null,null,"niunie","Linear",0.5],["say","avg3_205","Getting her to behave and listen can be quite a headache—",0,""],["w",0.5],["ctl","avg3_205","a","005",null,null,null,null,null,"diantou","Linear",0.5],["se","se_029"],["say","avg3_205","And that is precisely why I'm asking this of you.==W== Since the two of you already know each other, you really are a very good fit.",0,""],["w",0.7],["ctl","avg3_205","a","007","love",null,-0.15,1.15,null,"manbu2","OutCubic",1.0],["goon"],["w",0.5],["mrt",1,"y","020","think",null],["say","avg3_100","I see... If that's all the commission is, then I should be able to handle it on my own.",2,""],["w",0.5],["mrt",0,"z","002",null,"diantou"],["say","avg3_100","Understood. I'll take the job.",1,""],["w",0.5],["mrt",0,"z","003","speechless",null],["say","avg3_100","Come to think of it, Firefly once mentioned she had a mentor.==W== Would that be you?",1,""],["w",0.7],["mrt",0,"z","014","question","diantou"],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_205","a","003",null,null,null,null,null,"niunie","Linear",0.5],["se","se_146"],["say","avg3_205","No, that's someone else. You'll be meeting her soon enough.",0,""],["w",0.5],["ctl","avg3_205","a","002",null,null,null,null,null,"diantou