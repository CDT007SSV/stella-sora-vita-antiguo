","avg1_115","f",null,null,null,null,null,1.0,null,"Linear",1.0],["w",1.0],["se","se_062"],["ctl","avg1_120","a",null,null,0.75,null,null,1.0,null,"OutQuad",0.5],["w",0.5],["say","avg1_120","Sorry to wake you.",0,""],["w",0.5],["ctl","avg1_120","a","015",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_120","I'm Canace. I'm a professor at Grace Light Academy.",0,""],["w",0.5],["ctl","avg1_115","f",null,"speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_115","Puh ... fessor?",0,""],["w",0.5],["ctl","avg1_120","a","008","sweaty",null,null,null,null,"niunie","Linear",0.5],["say","avg1_120","Think of it as a \"teacher.\"",0,""],["w",0.5],["ctl","avg1_115","f",null,"question",null,null,null,null,null,"Linear",0.5],["say","avg1_115","A \"teacher\"...?",0,""],["w",0.5],["se","se_062"],["ctl","avg1_120","a","002",null,0.6,null,null,null,"JuGong","InQuad",0.7],["stg",0,100.0,null,1.2,"OutQuad",0.7,null,null,null],["w",1],["ctl","avg1_120","a",null,"attention",null,null,null,null,null,"Linear",0.5],["say","avg1_120","I'm here to get you out of this place. Do you want to come with me?",0,""],["w",0.5],["ctl","avg1_115","f",null,null,null,null,null,null,"niunie","Linear",0.5],["say","avg1_115","I don't understand...",0,""],["w",0.5],["ctl","avg1_115","f",null,"question",null,null,null,null,null,"Linear",0.5],["say","avg1_115","Is this ... a new order?",0,""],["ctl","avg1_120","a","007",null,null,null,null,null,null,"Linear",1.0],["w",0.5],["se","se_208"],["ctl","avg1_120","a",null,null,0.45,null,null,null,null,"OutQuad",1.0],["stg",0,300.0,-100.0,1.35,"Linear",1.0,null,null,null],["w",0.5],["trn",0,0,true,true,1.5],["w",1.5],["stg",0,0.0,0.0,1.1,"Linear",0.0,null,null,null],["bg","wog_academy_office",0,1.0],["w",1.0],["show","avg1_120","a","003",null,-0.08,1.1,0,null,0.0],["fx",0,"fx_avg_reminiscence_loop",1,1],["trn",1,0,false,false,1.0],["w",1.0],["ctl","avg1_120","a",null,null,null,null,null,1.0,null,"Linear",0.5],["w",1],["say","avg1_120","And that's how Firefly and I first met.",0,""],["w",0.5],["ctl","avg1_120","a","009",null,null,null,null,null,null,"Linear",0.5],["say","avg1_120","Igna and I pulled Firefly out of that lab, hoping to give her a normal life.",0,""],["w",0.5],["ctl","avg1_120","a","016","star",null,null,null,null,"youzai","Linear",0.5],["say","avg1_120","I handle her living and schooling. Igna acts as our backup, keeping the Eye of Grace off our backs.",0,""],["w",1.0],["ctl","avg1_120","a","015",null,null,null,null,null,null,"Linear",0.5],["say","avg1_120","Firefly still has to go in for regular \"testing,\" but her life is much more normal now.",0,""],["w",0.5],["say","avg1_120","Her numbers climbed steadily for a while before they ...==W== flatlined again.",0,""],["w",0.5],["ctl","avg1_120","a","007",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["mrt",1,"z","012","question",null],["say","avg3_100","Did something happen?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_120","a","009","sigh",null,null,null,null,"diantou","Linear",0.5],["say","avg1_120","No, nothing.==W== And that's the problem. A safe environment alone isn't enough to fix everything.",0,""],["w",0.5],["ctl","avg1_120","a","003",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.3],["say","avg1_120","Igna thinks Firefly's subconsciously holding back. Her past trauma is capping her progress. Her lack of emotion has become the biggest bottleneck for the experiment.",0,""],["w",0.5],["mrt",1,"z","002","speechless",null],["say","avg3_100","I've heard magic is tied to the user's emotions...",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_120","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_120","Exactly. That's the basis for Igna's theory.",0,""],["w",0.5],["ctl","avg1_120","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_120","Right or wrong, if she stays stuck like this... Sooner or later—",0,""],["w",0.5],["mrt",1,"z","012","question",null],["say","avg3_100","They'll take her back?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_120","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_120","Yes. The only reason we've kept her out this long is by pretending we're still advancing their research.",0,""],["w",0.5],["ctl","avg1_120","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_120","I want her to grow up healthy, like a normal kid. I've been racking my brain trying to help her open up. And then ... it hit me—",0,""],["w",0.5],["ctl","avg1_120","a","017","vexation",null,null,null,null,null,"Linear",0.5],["say","avg1_120","The only place Firefly feels happy is inside the Monolith, surrounded by danger.",0,""],["w",0.5],["ctl","avg1_120","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_120","Back then, field tests in the Monolith were her only escape from the lab. No painful experiments. To Firefly, fighting Stellaroids was her only free time.",0,""],["w",0.5],["mrt",1,"y","020","think",null],["say","avg3_100","... That's ... heartbreaking!",2,""],["w",0.5],["mrt",0,"y","020",null,null],["say","avg3_100","So during the Snowish Festival, when she dragged Laru and me into the Monolith... She was trying to relax in the only way she knew how.",2,""],["w",0.5],["mrt",0,"z","002","attention",null],["say","avg3_100","... Wait. Doesn't Firefly love taking pictures? Couldn't that help her open up?",1,""],["w",0.5],["mrt",0,"z","002",null,null],["say","avg3_100","If we can get her to stop burying her emotions, her numbers should go back up, right?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_120","a","019","speechless",null,null,null,null,null,"Linear",1.0],["w",1.0],["ctl","avg1_120","a","008","sweaty",null,null,null,null,null,"Linear",0.5],["say","avg1_120","I'm ashamed to admit it, but as her guardian, I only realized this recently. I knew she liked capturer back in the lab, but I figured it was a fluke. Just a kid staring at a shiny new toy.",0,""],["w",0.5],["ctl","avg1_120","a","015",null,null,null,null,null,null,"Linear",0.5],["say","avg1_120","But recently, I watched her snapping photos of the scenery... And she actually looked happy.",0,""],["w",0.5],["ctl","avg1_120","a","016",null,null,null,null,null,null,"Linear",0.5],["say","avg1_120","I think... Or at least, I want to believe ... that it's a sign of healing.",0,""],["w",0.5],["ctl","avg1_120","a","011","sigh",null,null,null,null,"JuGong","Linear",0.5],["say","avg1_120","I regret missing the signs until now...",0,""],["w",0.5],["mrt",1,"z","011","happy",null],["say","avg3_100","It's alright. We still have time.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_120","a","002",null,null,null,null,null,null,"Linear",0.5],["say","avg1_120","... You're right. Especially with a capable assistant by my side.",0,""],["w",0.5],["ctl","avg1_120","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_120","I suspect it already. My company alone isn't enough to help her grow.",0,""],["w",0.5],["ctl","avg1_120","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_120","I may be a \"teacher\" to her now, but I'm still far from becoming her \"friend.\" Besides, my work leaves me with barely any time for her.",0,""],["w",0.5],["se","se_075"],["ctl","avg1_120","a",null,null,null,-0.2,1.3,null,null,"Linear",0.5],["w",0.5],["say","avg1_120","That's why I need a favor, ==PLAYER_NAME==. Will you be Firefly's friend?",0,""],["w",0.5],["se","se_070"],["stg",0,null,null,null,"Linear",1.0,null,null,"xiaozhen"],["w",1.0],["mrt",1,"z","007","question",null],["say","avg3_100","Me...?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_120","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_120","You're the only other grown-up she lets in. She trusts you.",0,""],["w",0.5],["mrt",1,"z","009","speechless",null],["say","avg3_100","...",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_169"],["trn",0,1,true,true,1.0],["w",1.0],["fx",0,"fx_avg_reminiscence_loop",0,1],["show","avg1_158","a","002",0.65,null,null,0,null,null],["show","avg1_115","b","002",0.35,null,null,0,null,null],["bg","city_park_night_winter",0,0.0],["stg",0,null,null,1.1,"Linear",0.5,null,null,null],["w",0.5],["trn",1,1,false,false,1.0],["w",1.5],["ctl","avg1_158","a","004",null,null,-0.01,null,null,null,"OutQuad",0.5],["w",0.5],["say","avg1_158","I see...==W== So your wish wasn't about gifts, was it?",0,""],["w",0.3],["ctl","avg1_158","a","002",null,null,0.0,null,null,null,"OutSine",0.5],["goon"],["w",0.5],["ctl","avg1_115","b","014",null,null,null,null,null,"niunie","Linear",0.5],["say","avg1_115","No.",0,""],["w",0.5],["ctl","avg1_158","a","003","shock",null,null,null,null,null,"Linear",0.5],["say","avg1_158","Okay... Then, what is your wish?",0,""],["ctl","avg1_158","a",null,null,null,null,null,null,null,"Linear",0.5],["w",0.5],["ctl","avg1_115","b","004","speechless",null,null,null,null,null,"Linear",0.5],["w",0.5],["say","avg1_115","I wish for ...==W== a friend to play with.",0,""],["w",0.4],["ctl","avg1_115","b","008",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["se","se_169"],["trn",0,1,true,true,1.0],["w",1.0],["fx",0,"fx_avg_reminiscence_loop",1,1],["bg","wog_academy_office",0,1.0],["w",1.0],["cbg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["trn",1,1,false,false,2.0],["w",1],["mrt",1,"y","020","think",null],["say","avg3_100","I had no idea back then...",2,""],["w",0.5],["mrt",0,"y","009",null,null],["say","avg3_100","I didn't expect a simple wish for having a friend to mean the world to her.",2,""],["mrt",3,"y",null,null,null],["show","avg1_120","a","003",null,-0.07,1.1,0,null,0.0],["w",0.5],["ctl","avg1_120","a",null,null,null,null,null,1.0,null,"Linear",0.5],["w",0.5],["say","avg1_120","Things look bleak, which is why I need you. Everything we do is for Firefly.",0,""],["w",0.5],["mrt",1,"z","003",null,null],["say","avg3_100","When you put it like that, there is no reason for me to refuse.",1,""],["w",0.5],["mrt",0,"z","014","music",null],["say","avg3_100","I'm more than happy to be her friend.",1,""],["mrt",3,"z",null,null,null],["bgm",""],["w",0.5],["se","se_077"],["ctl","avg1_120","a","015",null,null,null,null,null,"JuGong","Linear",0.5],["w",0.5],["say","avg1_120","Thank you, ==PLAYER_NAME==...",0,""],["w",0.5],["ctl","avg1_120","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_120","What a relief. I think I can finally sleep well tonight.",0,""],["w",0.5],["end"]]}