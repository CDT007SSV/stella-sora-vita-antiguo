5],["w",0.5],["say","Excited Tourist","You guys hunting the resort urban legends too? Perfect timing! We were debating whether to stake out the woods for Terror Scissorhands tonight, or wait by the beach for the Human-Eating Vending Artifact.",0,""],["w",0.5],["bgm","m112"],["show","avg1_112","d","005",0.2,null,null,0,null,0.0],["ctl","avg1_112","d",null,null,0.25,null,null,1.0,null,"OutCubic",0.5],["say","avg1_112","What? Resort urban legends?",0,""],["w",0.5],["ctl","avg3_138","a","007","attention",null,null,null,null,null,"Linear",0.5],["say","Excited Tourist","Wait, you're not here for the rumors?",0,""],["w",0.5],["se","se_074"],["show","avg1_160","b","020",0.8,null,null,0,null,0.0],["ctl","avg1_160","b",null,null,0.75,null,null,1.0,null,"Linear",0.5],["say","avg1_160","We're regular tourists. But those rumors sound fascinating. Could you tell us more?",0,""],["w",0.5],["ctl","avg3_138","a",null,"happy",null,null,null,null,null,"Linear",0.505],["say","Excited Tourist","You bet!==W== This resort has gotten popular with thrill-seekers lately. Most folks come strictly for the legends.",0,""],["w",1.0],["ctl","avg1_160","b",null,null,null,null,null,0.0,null,"Linear",0.3],["ctl","avg1_112","d",null,null,null,null,null,0.0,null,"Linear",0.3],["ctl","avg3_138","a","006","music",null,-0.35,1.5,null,null,"OutCubic",0.3],["goon"],["fx",0,"fx_avg_flash_light",0,0],["ctl","avg3_138","a","002",null,null,null,null,null,null,"Linear",0.5],["say","Excited Tourist","The top three are the Gaze in the Dark, Terror Scissorhands, and the Human-Eating Vending Artifact.",0,""],["w",0.5],["ctl","avg1_112","d","008","question",null,null,null,1.0,null,"Linear",0.5],["say","avg1_112","Hu-Human-Eating Vending Artifact? That sounds intense...",0,""],["w",0.5],["ctl","avg3_138","a",null,"happy",null,0.0,1.0,1.0,null,"Linear",0.3],["w",0.8],["trn",0,0,true,false,1.0],["w",1.0],["bg","BG_Black",0,0.5],["w",0.5],["trn",1,0,false,false,1.0],["w",1.0],["obj","qstory_event_10_003",0,null,0.6],["w",0.5],["say","Excited Tourist","I heard there's a Human-Eating Vending Artifact here. It tosses out drinks to lure people in, and sometimes you can hear chewing from inside. People say the drinks are made from the victims' blood.",0,""],["w",0.5],["objx"],["w",0.5],["say","Excited Tourist","Then there's Terror Scissorhands. That one's popular too. The most widely told version goes like this—",0,""],["w",0.5],["show","avg2_956","a","002",0.3,0.95,-1.0,5,null,1.0],["ctl","avg2_956","a",null,null,null,0.95,-1.0,null,null,"Linear",0.0],["bg","white",5,0.0],["ctl","avg2_956","a",null,null,1.0,null,null,null,"manbu_loop","Linear",10.0],["stage",5,0,0],["w",0.5],["say","Excited Tourist","Years ago, this resort had a hardworking gardener. He couldn't stop working even after his death, so he turned into a vengeful spirit. Every night, he'd wander the grounds with giant shears.==W==",0,""],["w",1.0],["stage",5,1,1],["goon"],["hide","avg2_956"],["bg","beilin_street",0,0.5],["w",0.5],["show","avg3_138","a","006",null,null,null,0,null,0.0],["ctl","avg3_138","a",null,"speechless",null,null,null,1.0,null,"Linear",0.5],["w",0.5],["say","Excited Tourist","As for the Gaze in the Dark, there are tons of theories. The funniest one is that it's a Bouncing Fairy Light that escaped a Monolith...",0,""],["w",0.5],["ctl","avg3_138","a",null,null,0.35,null,null,null,null,"Linear",0.5],["show","avg1_160","b","020",0.75,null,null,0,null,0.0],["ctl","avg1_160","b",null,"question",0.7,null,null,1.0,null,"OutCubic",0.5],["say","avg1_160","Have you seen any of those yourself? Not hearsay, but with your own eyes.",0,""],["w",0.5],["bgm",""],["ctl","avg3_138","a","007","sigh",null,null,null,null,null,"Linear",0.5],["say","Excited Tourist","Not personally. Plenty of people swear they're real, but no one has concrete proof.",0,""],["w",0.5],["ctl","avg1_160","b",null,null,null,null,null,0.0,null,"Linear",0.3],["ctl","avg3_138","a","006","exclamation",0.5,-0.35,1.5,null,null,"OutCubic",0.3],["say","Excited Tourist","That's why I've decided to skip sleep for a few days. I'm bound to catch at least one in the act!",0,""],["w",0.5],["trn",0,6,true,false,0.5],["w",0.5],["stg",0,100.0,null,1.1,"Linear",0.0,null,null,null],["bg","beilin_house",0,0.5],["w",0.5],["trn",1,6,false,false,0.5],["w",0.5],["bgm","m44"],["show","avg3_144","a","007",0.45,null,null,0,null,0.0],["ctl","avg3_144","a",null,"question",null,null,null,1.0,null,"Linear",0.5],["w",0.5],["say","Bewildered Tourist","Strange rumors? News to me. I'm on vacation, just here to relax.",0,""],["w",0.5],["mrt",1,"v","002",null,null],["say","avg3_100","Have you heard any strange noises at night? Or noticed anything unsettling?",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg3_144","a","006","happy",null,null,null,null,"xuanyun","Linear",0.5],["say","Bewildered Tourist","I'm out cold the second it gets dark, so I don't remember a thing.",0,""],["w",0.5],["ctl","avg3_144","a","007","attention",null,-0.35,1.5,null,"stop","Linear",0.3],["say","Bewildered Tourist","By the way, is that girl with you?==W== She's been staring at us this whole time.",0,""],["w",0.5],["ctl","avg3_144","a",null,null,null,null,null,1.0,"lengzhan2","OutSine",0.5],["goon"],["w",0.5],["ctl","avg3_144","a",null,null,null,null,null,0.0,null,"Linear",0.5],["stg",0,-70.0,null,1.0,"OutCubic",0.5,null,null,null],["w",0.5],["se","se_090"],["show","avg1_142","b","010",0.85,null,null,0,null,0.0],["ctl","avg1_142","b",null,null,0.85,null,null,1.0,"lengzhan","OutCubic",0.5],["w",1.0],["mrt",1,"v","015","question",null],["say","avg3_100","Huh? Cosette?",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_142","b","012","exclamation",null,null,null,null,"chijing","OutCubic",0.5],["say","avg1_142","...!!",0,""],["w",0.5],["trn",0,0,false,false,0.2],["w",0.2],["stg",0,0.0,0.0,1.1,"Linear",0.0,null,null,null],["bg","beilin_house",0,0.0],["ctl","avg1_142","b",null,null,0.5,null,null,null,null,"Linear",0.0],["cbg",0,-500.0,-100.0,1.5,"Linear",0.0,