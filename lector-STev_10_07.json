_008",1,null,null],["w",0.5],["se","se_029"],["ctl","avg1_160","c","005",null,null,null,null,1.0,"diantou2","Linear",0.5],["say","avg1_160","Yeah, that's it. Good job.==W== Ah... I'm coming back to life. It's so warm.",0,""],["w",1.0],["ctl","avg1_160","c","027","love",null,null,null,null,"niunie1","Linear",0.5],["goon"],["w",0.5],["mrt",1,"v","013",null,null],["say","avg3_100","This left hand of yours did a good job, huh?",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_160","c","023","shy",null,null,null,null,null,"Linear",0.5],["say","avg1_160","It did. At this rate, I'll end up spoiled rotten.",0,""],["w",0.5],["mrt",1,"v","011",null,null],["say","avg3_100","Would that be so bad? You could use the rest.",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_160","c","004","happy",null,null,null,null,null,"Linear",0.5],["say","avg1_160","That does sound tempting...",0,""],["w",0.5],["objx"],["w",0.3],["se","se_074"],["ctl","avg1_160","c","031",null,0.55,-0.25,1.3,null,null,"OutCubic",0.5],["say","avg1_160","==PLAYER_NAME==, come closer?==W== It'll be warmer...",0,""],["w",1.0],["ctl","avg1_160","c","027","shy",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["mrt",1,"v","022",null,null],["say","avg3_100","Yeah, good idea. Let's stay close.",1,""],["mrt",3,"v",null,null,null],["w",0.5],["stg",0,null,-30.0,1.3,"OutQuad",1.0,null,null,null],["se","se_100"],["w",0.5],["trn",0,0,true,false,0.5],["w",0.5],["cbg",0,0.0,-150.0,1.3,"Linear",1.0,null,null,null],["w",1.0],["trn",1,0,false,false,1.0],["w",1.0],["cbg",0,-100.0,null,null,"Linear",3.0,null,null,null],["w",1],["say","avg1_160","...==W== Thank you for earlier, ==PLAYER_NAME==.",0,""],["w",1.0],["goon"],["w",0.5],["mrt",1,"v","002",null,null],["say","avg3_100","The fire? That was nothing.",1,""],["mrt",3,"v",null,null,null],["w",0.5],["bg","cavern",0,0.5],["w",0.5],["show","avg1_160","c","023",0.55,null,null,0,null,0.0],["ctl","avg1_160","c","023","speechless",null,null,null,1.0,null,"Linear",0.5],["say","avg1_160","Not only that.==W== You helped me pull myself together when I was panicking.",0,""],["w",1.0],["ctl","avg1_160","c","031","shy",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["mrt",1,"v","022",null,null],["say","avg3_100","It's what I'm here for.",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_160","c","006",null,null,null,null,null,null,"Linear",0.5],["say","avg1_160","It might seem like a given to you... But it means everything to me.",0,""],["w",0.5],["mrt",1,"v","002",null,null],["say","avg3_100","Then let me thank you too. Thanks for always looking out for me, Willow.",1,""],["mrt",0,"v","023",null,null],["say","avg3_100","I wouldn't have made it this far without the survival skills you taught me.",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_160","c","031","music",null,null,null,null,null,"Linear",0.5],["say","avg1_160","Heh... It's the least I could do. Part of being a senior is showing newcomers the ropes.",0,""],["w",0.5],["mrt",1,"v","002","attention",null],["say","avg3_100","Speaking of which, Noya mentioned you used to be an amazing Trekker. Is that true?",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_160","c","007","sweaty",null,null,null,null,"chijing","Linear",0.5],["say","avg1_160","That's a huge stretch. I was a Trekker for a couple of years, that's all.",0,""],["ctl","avg1_160","c","027",null,null,null,null,null,null,"Linear",0.5],["say","avg1_160","I'm glad I haven't forgotten the experience. At least it came in handy today.",0,""],["w",0.5],["mrt",1,"v","002",null,null],["say","avg3_100","Then why join the Trekker Association? With your skills, you'd be a legend by now if you kept going.",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_160","c","025","vexation",null,null,null,null,null,"Linear",0.5],["say","avg1_160","Hmm... Why, indeed.==W== I realized I wasn't cut out for that life. I'm better off working behind the scenes.",0,""],["w",1.0],["ctl","avg1_160","c