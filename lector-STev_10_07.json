 you apologizing for?"],[[]]],["w",0.5],["cbg",0,null,0.0,1.3,"OutQuint",1.5,null,null,null],["w",0.5],["say","avg1_160","You warned me, but I was too impatient to listen.",9,""],["say","avg1_160","I was supposed to keep you safe. Instead, I messed up and dragged you into danger...",9,""],["stg",0,null,null,null,"Linear",1.0,null,null,"Xiao"],["se","se_112"],["say","avg1_160","I swore I'd never make this mistake again. And then I did.",9,""],["w",0.5],["fx",0,"fx_avg_rain_sky",1,0],["bg","BG_Black",0,0.505],["w",0.505],["se","se_186"],["say","avg1_160","If anything happens to you, how could I face the New Star Guild?",9,""],["w",1.0],["trn",0,0,false,false,0.5],["w",0.5],["bg","story_event_10_002",0,0.5],["w",0.5],["cbg",0,null,150.0,1.2,"Linear",0.0,null,null,null],["trn",1,0,false,false,0.5],["w",0.5],["cbg",0,null,null,1.1,"Linear",10.0,null,null,null],["w",0.5],["say","avg1_160","Everyone worked hard to give me this awesome arm... Yet I still made the same mistake.",9,""],["say","avg1_160","It's cold metal. It never gets tired, never gets hurt. It's supposed to be stronger than my real arm.",9,""],["w",0.5],["stg",0,null,null,null,"Linear",1.0,null,null,"Xiao"],["say","avg1_160","Why... Why does it hurt this much?",9,""],["w",0.5],["mrt",1,"v","009",null,null],["say","avg3_100","I don't know the details of your past, but you didn't drag me down.",1,""],["mrt",3,"v",null,null,null],["w",0.5],["say","avg1_160","But...",9,""],["w",0.5],["mrt",1,"v","009",null,null],["say","avg3_100","If you hadn't caught me when we fell, I'd be fish food by now.",1,""],["mrt",0,"v","022",null,null],["say","avg3_100","I did what you would have done—risked my neck to help a friend. You have nothing to apologize for.",1,""],["mrt",0,"v","024",null,null],["say","avg3_100","Willow, thank you for saving my life. I want to show my gratitude, not accept an apology. Those are two different things.",1,""],["mrt",3,"v",null,null,null],["w",1.0],["mrt",2,"v","022",null,null],["say","avg3_100","So stop beating yourself up. Okay?",1,""],["mrt",3,"v",null,null,null],["w",0.5],["se","se_055"],["say","avg1_160","...",9,""],["w",0.5],["mrt",1,"v","003",null,null],["say","avg3_100","You didn't save me just because you have a fancy mechanical arm.",1,""],["mrt",0,"v","002",null,null],["say","avg3_100","It was your wits, your experience, and your guts.",1,""],["mrt",0,"v","023","speechless",null],["say","avg3_100","As long as you're safe, I'm happy. And since that arm is out of commission...",1,""],["mrt",3,"v",null,null,null],["w",0.5],["bgm",""],["se","se_019"],["bg","story_event_10_002_a_FP",0,1.0],["w",1.0],["cbg",0,null,150.0,1.0,"OutCubic",0.5,null,null,null],["w",1.0],["choice",["Let me be your left hand from now on."],[[]]],["w",0.5],["stg",0,null,null,null,"Linear",1.0,null,null,"Xiao"],["se","se_058"],["say","avg1_160","Huh?",9,""],["w",0.5],["bgm","m113"],["mrt",1,"v","017",null,null],["say","avg3_100","Just tell me what needs doing. Boss me around like I'm your actual hand!",1,""],["mrt",0,"v","023",null,null],["say","avg3_100","Clearing paths, moving rubble, helping you walk... I'm on it.",1,""],["mrt",0,"v","002",null,null],["say","avg3_100","And if something's too much for me alone, we'll figure it out together.",1,""],["mrt",0,"v","022",null,null],["say","avg3_100","You've been holding it together for so long. Why not lean on me for a change?",1,""],["mrt",3,"v",null,null,null],["w",0.5],["trn",0,0,false,false,0.5],["w",0.5],["bg","forest_rain",0,0.5],["w",0.5],["fx",0,"fx_avg_rain_2",0,0],["fx",0,"fx_fog_lp",0,0],["trn",1,0,false,false,0.5],["w",0.5],["show","avg1_160","c","014",null,-0.4,1.5,0,null,0.0],["ctl","avg1_160","c",null,"speechless",null,null,null,1.0,null,"Linear",0.5],["w",0.5],["say","avg1_160","==PLAYER_NAME==...",0,""],["w",0.5],["mrt",1,"v","013",null,null],["say","avg3_100","Deal? No more apologizing, okay?",1,""],["mrt",3,"v",null,null,null],["w",0.5],["ctl","avg1_160","c",null,null,null,null,null,null,null,"Linear",0.505],["sa