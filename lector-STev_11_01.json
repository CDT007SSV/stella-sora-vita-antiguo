,"b","012",null,null,null,null,null,"niunie1","Linear",0.5],["say","avg1_155","How else am I supposed to confirm she's the one Horizon sent without getting a read on her scent?",0,""],["w",0.5],["ctl","avg1_157","b","004","exclamation",null,null,null,null,null,"Linear",0.5],["say","avg1_157","Normal people start by asking for a name!",0,""],["w",0.5],["se","se_146"],["ctl","avg3_161","a","003",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg3_161","Yeah, starting with a name feels a bit safer...",0,""],["w",0.5],["ctl","avg1_155","b","007","happy",0.25,null,null,null,null,"Linear",0.5],["say","avg1_155","Hehe, sorry for the scare. But identity confirmed.",0,""],["w",0.5],["ctl","avg3_161","a","002",null,null,null,null,null,null,"Linear",0.5],["ctl","avg1_155","b","002","music",null,null,null,null,"JuGong1","Linear",0.5],["say","avg1_155","Nice to meet you. I'm Shia, and this is Karin. We're seafaring Trekkers. If it involves the sea, we handle it.",0,""],["ctl","avg1_155","b","009","question",null,null,null,null,null,"Linear",0.5],["say","avg1_155","And you must be Leafia. The surveyor who hauled a massive bag of tools all the way from Sailstead on a wild goose chase for a sea Monolith that might not even exist.",0,""],["w",0.5],["ctl","avg3_161","a","004",null,null,null,null,null,null,"Linear",0.5],["say","avg3_161","Sounds like Horizon already filled you in on me.",0,""],["ctl","avg3_161","a","010","love",null,null,null,null,null,"Linear",0.5],["say","avg3_161","But to be polite, let me do this right. I'm Leafia, with the Trekker Association.",0,""],["ctl","avg3_161","a","004",null,null,null,null,null,"niunie1","Linear",0.5],["say","avg3_161","I'm hoping you two can help me head out to sea and look into those sea Monolith rumors.",0,""],["w",0.5],["ctl","avg1_157","b","005","speechless",null,null,null,null,null,"Linear",0.5],["w",1.5],["ctl","avg1_157","b","005",null,0.7,null,null,null,null,"OutCubic",0.5],["say","avg1_157","That takes some nerve.",0,""],["ctl","avg1_157","b","004","awkward",null,null,null,null,null,"Linear",0.5],["say","avg1_157","Most people would write that off as a hoax or back out. Not you. You showed up hauling a giant pack.",0,""],["ctl","avg1_157","b","009",null,null,null,null,null,"jushou2","Linear",0.5],["say","avg1_157","I'm warning you now, surveying at sea is no joke. Underestimate the ocean, and you will pay for it.",0,""],["w",0.5],["ctl","avg3_161","a","003",null,null,null,null,null,null,"Linear",0.5],["say","avg3_161","I'd never. That's why I came to you.",0,""],["ctl","avg3_161","a","004","music",null,null,null,null,"xuanyun","Linear",0.5],["say","avg3_161","Horizon said you two are the best seafaring Trekkers around. Real experts. I figured with you, I'd be in good hands.",0,""],["w",0.5],["ctl","avg1_155","b",null,null,null,null,null,0.0,null,"Linear",0.3],["stg",0,-200.0,-50.0,1.3,"Linear",0.5,null,null,null],["ctl","avg1_157","b","016","question",null,null,null,null,"chijing","Linear",0.5],["say","avg1_157","Experts?==W== Mmm-hmm... Best... Experts...",0,""],["w",1.0],["ctl","avg3_161","a",null,null,null,null,null,0.0,null,"Linear",0.3],["bg","mood_1",0,0.5],["fx",0,"fx_avg_bubble",0,0],["ctl","avg1_157","b","011",null,0.58,0.0,1.0,null,null,"OutCubic",0.5],["w",0.5],["goon"],["w",0.5],["ctl","avg3_161","a","401",null,0.35,null,null,null,null,"Linear",0.0],["ctl","avg1_155","b",null,null,0.5,null,null,null,null,"Linear",0.0],["bg","ttc_harbour_2_daylight",0,0.505],["w",0.505],["stg",0,null,null,1.1,"OutQuart",0.5,null,null,null],["ctl","avg1_157","b",null,null,null,null,null,null,"xuanyun","Linear",0.5],["ctl","avg3_161","a","013","attention",null,null,null,1.0,"chijing","Linear",0.5],["say","avg3_161","Is she okay? Did I say something weird?",0,""],["ctl","avg1_155","b","013",null,0.8,null,null,null,null,"Linear",0.0],["w",0.5],["ctl","avg1_155","b","013","happy",0.8,null,null,1.0,null,"Linear",0.5],["say","avg1_155","Heh, looks like Karin's tail is pointing straight up.",