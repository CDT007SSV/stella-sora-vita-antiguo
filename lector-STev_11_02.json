,"avg1_157","b","004","attention",null,null,null,null,null,"Linear",0.5],["say","avg1_157","You look like you can't get enough of it. Don't tell me this is your first time out here.",0,""],["w",0.5],["ctl","avg1_157","b",null,null,null,null,null,0.0,null,"Linear",0.5],["hide","avg1_157",0.5],["ctl","avg3_161","b","010","happy",0.5,null,null,null,null,"Linear",0.5],["say","avg3_161","First time this far out. The view is nothing like the ocean I'm used to.",0,""],["ctl","avg3_161","b","003","speechless",null,null,null,null,null,"Linear",0.5],["say","avg3_161","When I look at the water from land, my brain defaults to practical things. Are there reefs nearby? How do I map out this coastline?",0,""],["w",0.5],["se","se_146"],["ctl","avg3_161","b","004",null,null,null,null,null,"chijing","Linear",0.5],["say","avg3_161","But out here on the boat, I get it. It's a completely different perspective from drawing maps.",0,""],["w",0.5],["se","se_520"],["ctl","avg3_161","b","010",null,null,null,null,null,"xuanyun","Linear",0.5],["say","avg3_161","... The wind, the waves, the deck rocking under my feet. It all feels incredibly real.",0,""],["w",0.5],["chd",0,2,"avg1_157","b","010","music"],["say","avg1_157","You can't capture the sea on paper, after all.",0,""],["w",0.5],["chd",1,2,"avg1_157","a","002",null],["ctl","avg3_161","b","015","speechless",null,null,null,null,null,"Linear",0.5],["say","avg3_161","I spend most of my time traveling overland. Mountains, rivers, cities, roads. Mapping those isn't hard.",0,""],["ctl","avg3_161","b","006","vexation",null,null,null,null,"niunie1","Linear",0.5],["say","avg3_161","But out here, there's nothing but water. No landmarks, no borders. Even directions feel fuzzy.",0,""],["w",0.5],["trn",0,0,false,false,0.5],["w",0.5],["ctl","avg3_161","b",null,null,null,null,null,0.0,null,"Linear",0.0],["stg",0,-200.0,-50.0,1.2,"Linear",0.0,null,null,"still"],["bg","view_sea_daylight",0,0.0],["cbg",0,null,90.0,null,"Linear",0.0,null,null,null],["cbg",0,null,null,null,"Linear",0.0,null,null,"JingTouYaoHuang"],["trn",1,0,false,false,0.5],["w",1.0],["say","avg3_161","It looks empty, but I can't shake the feeling something is hidden underneath.",0,""],["w",1.0],["bg","deck_daylight",0,0.5],["w",0.5],["ctl","avg3_161","b",null,null,0.4,null,null,0.0,null,"Linear",0.5],["show","avg1_157","b","002",0.6,-0.05,null,0,null,0.0],["se","se_030"],["ctl","avg1_157","b","013",null,0.6,0.0,null,1.0,null,"OutCubic",0.5],["say","avg1_157","The sea's a liar.==W== It looks calm on top, but whirlpools and reefs are waiting underneath. One minute it's clear skies, the next it's a storm.",0,""],["w",0.5],["ctl","avg1_157","b","017","speechless",null,null,null,null,null,"Linear",0.5],["goon"],["ctl","avg1_157","b","013","sigh",null,null,null,null,null,"Linear",0.5],["say","avg1_157","The farther out you go, the wilder the water gets. And the weather stops making sense.",0,""],["w",0.5],["ctl","avg1_157","b",null,null,0.75,null,null,null,null,"OutCubic",0.5],["ctl","avg3_161","b","006","exclamation",0.5,null,null,1.0,null,"OutCubic",0.5],["say","avg3_161","I see... I guess your experience is what keeps us safe out here.",0,""],["ctl","avg1_155","b","003",null,0.2,-0.4,1.3,null,null,"Linear",0.0],["w",0.5],["ctl","avg1_157","b","015",null,null,null,null,null,null,"Linear",0.5],["ctl","avg3_161","b","004",null,null,null,null,null,null,"Linear",0.5],["stg",0,70.0,null,1.0,"OutCubic",0.5,null,null,null],["se","se_074"],["ctl","avg1_155","b",null,null,null,-0.2,null,1.0,null,"OutCubic",0.5],["say","avg1_155","To understand the sea, looking isn't enough. You have to listen to the wind, smell the air, feel the pull of the waves...",0,""],["w",0.5],["ctl","avg1_155","b","018",null,null,null,null,null,"niunie1","Linear",0.5],["say","avg1_155","Take today. The breeze is fresh and clean. Perfect weather.==W== But if the air turns damp and heavy, with a murky saltiness to it, then the weather is about to turn.",0,""],["w",0.5],["ctl","avg1_155","b",