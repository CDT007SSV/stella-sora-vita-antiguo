s is what I do.",0,""],["w",0.5],["trn",0,0,true,false,1.0],["w",1.0],["film",0],["bg","flatlands_daylight",0,0.5],["w",0.5],["stg",0,-50.0,null,null,"Linear",3.0,null,null,null],["trn",1,0,false,false,0.5],["w",1.5],["bg","beach_wasteland_daylight",0,0.5],["w",0.5],["say","avg3_161","Coastlines, mountains...",3,""],["w",0.5],["trn",0,0,false,false,0.5],["w",0.5],["stg",0,0.0,null,null,"Linear",0.0,null,null,null],["bg","forest",0,0.5],["w",0.5],["stg",0,-60.0,null,null,"Linear",3.0,null,null,null],["trn",1,0,false,false,0.5],["w",1.5],["bg","forest_daylight_2",0,0.5],["w",0.5],["say","avg3_161","Forests, the Wilds...",3,""],["w",0.5],["trn",0,0,false,false,0.5],["w",0.5],["stg",0,0.0,null,null,"Linear",0.0,null,null,null],["film",1],["bg","cabin_daylight",0,0.0],["trn",1,0,false,false,0.505],["w",0.505],["show","avg3_161","b","701",null,null,null,0,null,0.0],["ctl","avg3_161","b","016","exclamation",null,null,null,1.0,"jushou2","Linear",0.5],["say","avg3_161","If a place hasn't been explored or mapped, I want to see it for myself.",0,""],["w",0.5],["chd",0,0,"avg1_157","b","004","question"],["say","avg1_157","But the maps we have now are detailed enough, aren't they?",0,""],["w",0.5],["chd",1,0,"avg1_157","a","002",null],["ctl","avg3_161","b","011","speechless",null,null,null,null,null,"Linear",0.5],["say","avg3_161","Looking complete doesn't mean they're accurate. Rivers shift course, mountains crumble, forests expand.",0,""],["w",0.5],["ctl","avg3_161","b",null,null,null,null,null,null,null,"Linear",0.0],["trn",0,0,true,false,0.5],["w",0.5],["bg","sky_tower",0,0.0],["cbg",0,null,90.0,null,"Linear",1.0,null,null,null],["trn",1,0,false,false,0.5],["w",1.0],["say","avg3_161","And Monoliths reshape the land around them.==W== A map from a few years ago could be entirely useless today.",0,""],["w",0.5],["bg","BG_Black",0,0.5],["goon"],["w",0.5],["trn",0,0,false,false,0.5],["w",0.5],["show","avg3_161","b","004",0.65,null,null,0,null,null],["bg","cabin_daylight",0,0.1],[