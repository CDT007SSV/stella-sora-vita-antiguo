.0],["bg","BG_Black",0,0.5],["w",0.5],["se","se_239"],["say","0","Leafia takes the bowl of liquid, with its questionable color and indescribable smell, and falls silent. Then, as if surrendering, she squeezes her eyes shut and downs it in one gulp.",0,""],["w",0.5],["bg","deck_daylight",0,0.5],["w",0.5],["ctl","avg3_161","b","014","vexation",null,null,null,1.0,null,"Linear",0.5],["say","avg3_161","Ugh...",0,""],["w",0.5],["ctl","avg1_157","b","016","symbol",0.4,null,null,1.0,null,"OutCubic",0.5],["say","avg1_157","Well?! How is it?!",0,""],["w",0.5],["se","se_095"],["bg","mood_4",0,0.5],["ctl","avg3_161","b","018",null,null,null,null,null,"niunie1","Linear",0.5],["say","avg3_161","It tastes like seaweed, ginger, and mint all fought to the death inside my mouth... Leaving behind this unspeakable sour bitterness...==W== Ugh, I think I'm going to hurl...",0,""],["w",0.5],["ctl","avg3_161","b","019","awkward",null,null,null,null,"chijing","Linear",0.5],["goon"],["w",0.5],["ctl","avg1_157","b","006","sweaty",null,null,null,null,null,"Linear",0.5],["say","avg1_157","Is it that awful...? This is the most normal-tasting version we have...",0,""],["w",0.5],["bg","deck_daylight",0,0.505],["ctl","avg1_157","b","014","resentful",0.5,null,null,null,"jushou2","Linear",0.5],["say","avg1_157","No, wait, forget the taste! How are you feeling?!",0,""],["w",0.5],["ctl","avg3_161","b","003",null,null,null,null,null,null,"Linear",0.5],["say","avg3_161","I think I feel a little better...==W== But I also want to throw up even more now...",0,""],["w",0.5],["ctl","avg3_161","b","005","vexation",null,null,null,null,"chijing","Linear",0.5],["goon"],["w",0.5],["trn",0,0,true,false,0.5],["w",0.5],["stg",0,0.0,0.0,1.1,"Linear",0.0,null,null,null],["trn",1,0,false,false,0.5],["w",0.5],["show","avg1_155","b","012",0.55,null,null,0,null,0.0],["ctl","avg1_155","b","012","sigh",null,null,null,1.0,null,"Linear",0.5],["say","avg1_155","If even the special remedy didn't help... You must be severely seasick.",0,""],["ctl","avg1_155","b","011",null,null,null,null,null,null,"Linear",0.5],["say","avg1_155","Leafia, if it's too much, we can still turn back.",0,""],["w",0.5],["ctl","avg1_155","b","014","speechless",null,null,null,null,"niunie1","Linear",0.5],["say","avg1_155","You need to know your limits at sea. Getting sick your first time this far out is totally normal. And it would be a shame if this ruined the ocean for you.",0,""],["w",0.5],["bgm",""],["ctl","avg1_155","b",null,null,null,null,null,0.0,null,"OutCubic",0.5],["w",0.5],["show","avg3_161","b","006",0.5,null,null,0,null,0.0],["fx",0,"fx_speedline_center",0,0],["ctl","avg3_161","b","006",null,null,-0.35,1.5,1.0,null,"Linear",0.3],["say","avg3_161","No. Don't turn back.",0,""],["bgm","m48"],["w",0.5],["ctl","avg3_161","b","016",null,null,null,null,null,"jushou2","Linear",0.5],["say","avg3_161","If we turn back now, I won't be able to rest either.==W== We came all this way, I can't give up halfway.",0,""],["w",0.5],["ctl","avg3_161","b","003",null,null,null,null,null,null,"Linear",0.5],["goon"],["ctl","avg3_161","b","006",null,null,null,null,null,null,"Linear",0.5],["say","avg3_161","If I quit now, I'll be leaving another huge blank spot on my map. I'll definitely regret that... Let's keep going.",0,""],["w",0.5],["stg",0,100.0,null,null,"OutCubic",1.0,null,null,null],["ctl","avg3_161","b",null,null,null,null,null,null,null,"Linear",0.5],["show","avg1_157","b","013",0.2,-0.05,1.0,0,null,0.0],["ctl","avg1_157","b",null,"sweaty",null,null,null,1.0,null,"Linear",0.5],["say","avg1_157","... You are way too stubborn.",0,""],["ctl","avg1_155","b","002",null,0.75,-0.05,null,null,null,"Linear",0.0],["w",0.5],["stg",0,0.0,null,null,"OutCubic",1.0,null,null,null],["ctl","avg1_155","b",null,"love",null,null,null,1.0,"JuGong1","Linear",0.5],["say","avg1_155","Alright, your call. Karin, take Leafia down to the cabin. I'll take the helm and keep us steady.",0,""],["w",0.5],["ctl","avg1_157","b","004",null,null,null,null