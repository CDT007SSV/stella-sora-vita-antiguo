,0,null,null],["stg",0,-200.0,-50.0,1.3,"OutSine",0.0,null,null,null],["w",0.3],["trn",1,1,false,false,1.0],["w",2.0],["say","avg3_224","We're not as brave as you, Eleanor. If I had to put it into words...",0,""],["w",0.5],["ctl","avg3_224","a","011","vexation",null,null,null,null,null,"Linear",0.5],["say","avg3_224","I think our biggest wish ... is to find a dream to call our own.",0,""],["w",0.5],["trn",0,1,true,true,0.8],["w",0.8],["fx",0,"fx_avg_reminiscence_loop",1,0],["stg",0,-100.0,-50.0,1.2,"Linear",0.0,null,null,null],["w",0.5],["show","avg3_223","a","002",0.4,-0.07,1.1,0,null,0.0],["show","avg3_224","a","002",0.7,-0.07,1.1,0,null,0.0],["trn",1,1,false,false,1.0],["w",1.0],["bgm",""],["w",0.5],["se","se_062"],["ctl","avg3_223","a",null,null,null,null,null,1.0,null,"OutSine",0.6],["ctl","avg3_224","a",null,null,null,null,null,1.0,null,"OutSine",0.6],["bgm",""],["w",0.5],["ctl","avg3_224","a","002","happy",null,null,null,null,"diantou","Linear",0.5],["ctl","avg3_223","a",null,"happy",null,null,null,null,null,"Linear",1.0],["w",0.5],["ctl","avg3_224","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg3_224","And now ... we've finally found it.",0,""],["w",0.5],["ctl","avg3_223","a","004","idea",null,null,null,null,null,"Linear",1.0],["ctl","avg3_224","a","004","idea",null,null,null,null,null,"Linear",0.5],["say","avg3_224","We want to become Trekkers.",0,""],["w",0.5],["ctl","avg3_224","a","002",null,null,null,null,null,null,"Linear",0.5],["say","avg3_224","We've been by your side through everything.==W== We've seen your bright smiles, and we've seen you struggle when things got hard.",0,""],["bgm","m39"],["goon"],["w",0.5],["ctl","avg3_224","a","004",null,null,null,null,null,null,"Linear",0.5],["say","avg3_224","Everything you've experienced is what our lives have been missing.==W== Without us even realizing it, this thought took root in our hearts: we want to live as freely as you do.",0,""],["w",0.5],["goon"],["w",1.0],["ctl","avg3_223","a","011","vexation",null,null,null,null,null,"Linear",0.5],["say","avg3_223","And every time we watch you leave, Vivian and I feel lonely ... and useless.==W== We hate just sitting here worrying, unable to help at all.",0,""],["w",0.5],["goon"],["w",0.5],["ctl","avg3_224","a","004",null,null,null,null,null,"diantou","Linear",0.5],["say","avg3_224","So Eleanor, we're done just standing here watching you go. We want to walk beside you on this path.",0,""],["w",0.5],["ctl","avg3_223","a","010","attention",null,null,null,null,"diantou","Linear",0.5],["say","avg3_223","That's right. Becoming Trekkers is how we make that dream a reality.",0,""],["ctl","avg3_224","a","002",null,null,null,null,null,null,"Linear",1.0],["w",0.5],["ctl","avg3_223","a","003","flower",null,null,null,null,"youzai","Linear",0.5],["say","avg3_223","If the three of us could head out together and go on an adventure... Wouldn't that be amazing?",0,""],["w",0.5],["trn",0,0,true,true,1.0],["w",1.0],["cbg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["stg",0,0.0,-100.0,1.35,"Linear",0.0,null,null,null],["show","avg1_137","b","014",null,-0.07,1.1,0,null,null],["w",0.5],["trn",1,0,false,false,1.0],["w",1.3],["ctl","avg1_137","b","009","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_137","Go on an adventure ... together...",0,""],["w",0.5],["ctl","avg1_137","b","016",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_137","If that actually happened, I'd be so happy...",0,""],["ctl","avg1_137","b","002",null,null,0.0,1.0,null,null,"OutSine",0.7],["stg",0,0.0,0.0,1.2,"OutSine",0.7,null,null,null],["w",1.0],["ctl","avg1_137","b","007","question",null,null,null,null,null,"Linear",0.5],["say","avg1_137","... Wait, does that mean you want to come to the Monolith with me today?",0,""],["show","avg3_223","a","002",0.6,null,null,0,null,0.0],["show","avg3_224","a","002",0.75,null,null,0,null,0.0],["w",0.5],["ctl","avg1_137","b",null,null,0.3,null,null,null,null,"OutQuad",0.6],["w",0.5],["ctl","a