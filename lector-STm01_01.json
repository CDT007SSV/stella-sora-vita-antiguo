{"id":"STm01_01","names":{"0":"","avg3_999":"???","avg1_112":"Noya","avg1_103":"Amber","avg1_111":"Iris","avg3_100":"Sylar"},"en":{"0":"","avg3_999":"???","avg1_112":"Noya","avg1_103":"Amber","avg1_111":"Iris","avg3_100":"Sylar"},"tx":1,"steps":[["intro","Acto uno","El reinicio del despertar","En tu sueño te llaman «Tirano». Despiertas como un Trekker sin memoria en un vehículo que avanza hacia la Ciudad de los Mil Monolitos. Las chicas prometen ayudarte a recuperar lo que olvidaste."],["bg","BG_Black",0,0.4],["w",0.2],["say","0","Las legiones de Emor sufrieron diez derrotas trágicas, impotentes ante la hechizante magia del Tirano.\n\nPero la intervención divina trajo claridad. El Tirano perdió sus poderes oscuros al pisar Emor y fue llevado ante el juicio.\n\nDesde ese día, el Tirano dejó de existir, y la generosidad del Dios de la Gracia fluyó por igual sobre todos los Novianos.\n\n—Crónicas de Nueva Nova, por Virigia",10,""],["w",1.0],["film",0],["clear",0,0,1],["w",0.5],["bgm","m13"],["bg","story_main_01_004",0,1.0],["cbg",0,100.0,480.0,1.4,"Linear",0.0,null,null,null],["cbg",0,50.0,null,null,"Linear",4.0,null,null,null],["w",0.6],["say","0","Un olor a pólvora flota en la brisa del atardecer.",3,""],["w",1],["clear",0,0,1],["w",0.3],["bg","story_main_01_004",0,1.0],["cbg",0,-200.0,100.0,1.35,"Linear",0.0,null,null,null],["cbg",0,-150.0,null,null,"Linear",4.0,null,null,null],["w",0.6],["say","0","Edificios derrumbados y estandartes hechos pedazos cubren el paisaje.",3,""],["w",1],["clear",1,0,1],["w",0.3],["bg","story_main_01_004",0,1.0],["cbg",0,null,-100.0,0.95,"Linear",0.0,null,null,null],["w",0.6],["say","0","Hordas de soldados asaltan la Ciudad de los Mil Monolitos y reducen la magnífica ciudad a ruinas.",3,""],["w",1],["clear",0,0,1],["w",0.3],["bg","BG_Black",0,1.0],["w",1.0],["say","0","El soberano de ayer ahora está sentado, prisionero en un trono helado...",3,""],["w",1],["clear",0,0,1],["w",0.3],["se","se_403"],["w",0.7],["se","se_403"],["w",0.7],["se","se_403"],["bg","story_main_01_018",0,1.0],["cbg",0,-100.0,-70.0,0.98,"Linear",0.0,null,null,null],["w",0.6],["say","0","esperando a que algún afortunado reclame su cabeza.",3,""],["w",1],["clear",0,0,1],["w",0.3],["bg","BG_Black",0,0.8],["w",0.8],["say","avg3_999","Lo siento, mi Tirano...",3,"vo_STm01_00_001"],["w",1],["clear",0,0,1],["w",0.3],["bg","story_main_01_001",0,1.2],["w",0.9],["say","avg3_999","Es porque te he traicionado…",3,"vo_STm01_00_002"],["w",1],["clear",0,0,1],["w",0.3],["choice",["¿Quién... eres?","¿Traicionado?","Te equivocas de persona. Yo no soy ningún Tirano."],[[["say","avg3_999","Oh... Es verdad.",3,"vo_STm01_01_001"],["w",0.3],["say","avg3_999","Supongo que funcionó…",3,"vo_STm01_01_002"],["w",1],["clear",0,0,1],["w",0.3],["say","avg3_999","Quizá perdiste la memoria, pero no pasa nada. Seguro que te esperan días felices.",3,"vo_STm01_01_003"],["w",1.0],["clear",0,0,1],["w",0.3]],[["say","avg3_999","Me volví contra el ejército del Tirano...",3,"vo_STm01_01_004"],["w",0.3],["say","avg3_999","Y eso hizo que nuestro sueño se hiciera añicos.",3,"vo_STm01_01_005"],["w",0.8],["clear",0,0,1],["w",0.3],["say","avg3_999","Es decir... La historia que intentábamos escribir termina hoy.",3,"vo_STm01_01_006"],["w",0.8],["clear",0,0,1],["w",0.3]],[["say","avg3_999","Aunque tú no te consideres «Tirano»...",3,"vo_STm01_01_007"],["w",1],["clear",0,0,1],["w",0.3],["say","avg3_999","Mientras todos crean que lo eres...",3,"vo_STm01_01_008"],["w",1],["clear",0,0,1],["w",0.3],["say","avg3_999","Entonces eso es lo que eres, y nadie más.",3,"vo_STm01_01_009"],["w",1.0],["clear",0,0,1],["w",0.3]]]],["w",0.1],["bg","story_main_01_002",0,0.7],["w",0.5],["say","avg3_999","Y una última cosa…",3,"vo_STm01_01_010"],["w",1],["clear",0,0,1],["w",0.3],["trn",0,0,false,false,0.8],["w",0.8],["bg","BG_Black",0,0.0],["bg","story_main_01_023_a",0,0.0],["fx",0,"fx_avg_star_lp",0,0],["w",0.45],["trn",1,0,false,false,0.8],["w",0.7],["say","avg3_999","¿Ves esa estrella tan brillante?",3,"vo_STm01_01_011"],["w",0.3],["say","avg3_999","Para proteger su frágil ego…",3,"vo_STm01_01_012"],["w",1],["clear",0,0,1],["w",0.3],["say","avg3_999","la gente entrega sus deseos a esa estrella.",3,"vo_STm01_01_013"],["w",1],["clear",0,0,1],["w",0.3],["say","avg3_999","Porque así, cuando sus deseos no se cumplen...",3,"vo_STm01_01_014"],["w",0.3],["say","avg3_999","«Bueno, hice lo que pude, pero mi estrella de la suerte no brilló para mí».",3,"vo_STm01_01_015"],["w",0.3],["say","avg3_999","Pueden poner excusas.",3,"vo_STm01_01_016"],["w",0.3],["say","avg3_999","Pero los sueños no se cumplen solo porque los deseemos. La vida no es tan fácil.",3,"vo_STm01_01_017"],["w",0.3],["trn",0,0,false,false,0.8],["w",0.8],["bg","story_main_01_002",0,0.0],["fx",0,"fx_avg_star_lp",1,0],["trn",1,0,false,false,0.6],["w",0.6],["say","avg3_999","Pero somos tan patéticos que no podemos enfrentar nuestra vida sin engañarnos así.",3,"vo_STm01_01_018"],["w",1],["clear",0,0,1],["w",0.3],["bg","story_main_01_003",0,1.0],["cbg",0,null,-50.0,0.98,"OutSine",0.0,null,null,null],["w",0.8],["say","avg3_999","Y justo por eso... no necesitas convertirte en una estrella de los deseos.",3,"vo_STm01_01_019"],["w",0.2],["say","avg3_999","Nadie obtiene resultados distintos haciendo lo mismo una y otra vez.",3,"vo_STm01_01_020"],["w",1],["clear",0,0,1],["w",0.2],["choice",["Resultados distintos…"],[[]]],["cbg",0,null,100.0,null,"Linear",7.0,null,null,null],["clear",0,0,1],["w",0.5],["say","avg3_999","Adiós, Tirano. Me alegra que hayamos tenido esta última charla.",3,"vo_STm01_01_021"],["w",0.3],["bg","BG_Black",0,0.8],["w",0.8],["say","avg3_999","Pero, si... Si el destino volviera a guiarnos…",3,"vo_STm01_01_022"],["bgm",""],["w",0.8],["clear",0,0,1],["w",0.3],["stg",5,null,null,1.1,"Linear",0.0,null,null,null],["bg","story_main_01_002",5,0.0],["cbg",5,20.0,80.0,0.95,"Linear",0.0,null,null,null],["w",0.8],["stage",5,0,16],["w",0.3],["say","avg3_999","Volvamos a vernos bajo un cielo sin estrellas.",3,"vo_STm01_01_023"],["w",0.5],["clear",0,0,1],["bg","BG_Black",5,0.7],["w",1.2],["stage",5,1,17],["film",1],["bg","BG_Black",0,0.0],["w",0.6],["fx",0,"fx_speedline_center",0,0],["bg","story_main_01_006_a",0,0.7],["cbg",0,null,null,null,"Linear",0.0,null,null,"xingshi"],["cbg",0,null,null,1.2,"OutSine",0.6,null,null,null],["w",0.3],["se","se_410"],["mrt",2,"z","025","exclamation",null],["say","avg3_100","¡N-No te vayas! Tengo preguntas para ti—",1,""],["mrt",0,"y","020","think",null],["say","avg3_100","¿Eh? ¿Dónde estoy...?",2,""],["mrt",3,"z",null,null,null],["w",0.45],["say","0","Despierto mirando el techo corredizo desconocido de una caravana.",0,""],["w",0.3],["mrt",1,"y","020","think",null],["say","avg3_100","Cierto. Me rescataron en el desierto.",2,""],["mrt",0,"y","003",null,null],["say","avg3_100","Escalé el Monolito con ellas. Ahora nos dirigimos a la ciudad.",2,""],["mrt",3,"z",null,null,null],["w",0.46],["cbg",0,null,50.0,null,"OutSine",1.0,null,null,"stop"],["w",0.6],["bg","story_main_01_007_a",0,0.6],["cbg",0,null,null,1.05,"Linear",0.0,null,null,null],["w",0.6],["say","avg1_111","Estás empapado. ¿Una pesadilla?",9,""],["w",0.3],["se","se_092"],["obj","qstory_side_111_001",0,null,0.54],["w",0.3],["say","0","Tomo una taza de Iris.==W== La bebida tibia alivia mi garganta y calma mis nervios.",9,""],["w",0.7],["se","se_284"],["cbg",0,null,null,null,"Linear",0.0,null,null,"jushou"],["objx"],["w",0.9],["goon"],["w",0.3],["bgm","m56"],["mrt",1,"y","020","speechless",null],["say","avg3_100","No sabría decir si fue una pesadilla.==W== Pero gracias, ya me siento mejor.",1,""],["w",0.6],["mrt",0,"z","023",null,null],["goon"],["mrt",0,"z","002","attention",null],["say","avg3_100","En el sueño... alguien me llamó «Tirano».",1,""],["mrt",3,"z",null,null,null],["bg","story_main_01_007_f",5,0.0],["cbg",5,-100.0,-390.0,1.9,"Linear",0.0,null,null,null],["w",0.45],["bg","BG_Black",0,0.8],["w",0.6],["stage",5,0,16],["say","avg1_103","Tirano...",9,""],["w",0.3],["stage",5,1,17],["w",0.3],["bg","story_main_01_025",0,0.8],["w",0.6],["say","avg1_112","Vaya, eso es antiguo. Como sacado de un cuento infantil.",9,""],["choice",["¿Antiguo?"],[[]]],["w",0.1],["clear",0,0,1],["bg","story_main_01_007_g",1,0.0],["cbg",1,550.0,-20.0,1.1,"Linear",0.0,null,null,null],["w",0.3],["cbg",0,820.0,null,null,"OutSine",0.8,null,null,null],["stage",1,0,0],["say","avg1_111","¿Te refieres a esta palabra?",9,""],["w",0.3],["trn",0,0,false,false,0.6],["w",0.6],["stage",1,1,1],["bg","BG_Black",0,0.0],["w",0.3],["trn",1,0,false,false,0.7],["w",0.4],["se","se_118"],["obj","qstory_main_01_020",0,null,0.54],["w",0.3],["say","0","Con un gesto que me resulta extrañamente familiar, Iris gira su cuaderno de lado y señala una frase.",9,""],["w",0.3],["objx"],["w",0.3],["fx",0,"fx_avg_magic_ice",0,0],["w",1.1],["say","0","Tirano.",8,""],["w",1.0],["clear",0,0,1],["w",0.3],["bg","story_main_01_007_f",0,0.7],["cbg",0,800.0,-50.0,1.67,"Linear",0.0,null,null,null],["w",0.5],["mrt",2,"z","002","idea",null],["say","avg3_100","Esa es.",1,""],["mrt",3,"z",null,null,null],["w",0.46],["bg","story_main_01_007_j",0,0.7],["cbg",0,800.0,-50.0,1.67,"Linear",0.0,null,null,null],["w",0.5],["say","avg1_111","En realidad, ya no usamos esa palabra. Es una palabra antigua.==W== Ahora todos dicen simplemente «Jefe».",9,""],["w",0.5],["bg","story_main_01_007_f",0,0.7],["cbg",0,800.0,-50.0,1.67,"Linear",0.0,null,null,null],["w",0.6],["goon"],["mrt",2,"z","015","question",null],["say","avg3_100","¿Jefe?",1,""],["mrt",3,"z",null,null,null],["w",0.45],["bg","story_main_01_007_j",0,0.7],["cbg",0,800.0,-50.0,1.67,"OutSine",0.0,null,null,null],["w",0.4],["say","avg1_111","Es el Stellaroid más fuerte de todos dentro de un Monolito.",9,""],["w",0.3],["bg","story_main_01_007_f",0,0.7],["cbg",0,800.0,-50.0,1.67,"Linear",0.0,null,null,null],["w",0.5],["say","avg1_111","Esa palabra antigua... representaba a un destructor de mundos, al que derrotaban los guerreros...",9,""],["w",0.3],["bg","BG_Black",0,0.6],["bg","story_main_01_007_f",5,0.0],["cbg",5,-100.0,-390.0,1.9,"Linear",0.0,null,null,null],["w",0.4],["stage",5,0,16],["bgm",""],["say","avg1_103","Un villano supremo.",9,""],["w",0.3],["stage",5,1,17],["bg","story_main_01_007_f",0,0.7],["cbg",0,800.0,-50.0,1.67,"Linear",0.0,null,null,null],["w",0.5],["say","avg1_111","Así que hasta el sonido del nombre tuvo que desaparecer.",9,""],["w",0.3],["bg","story_main_01_025",0,0.7],["w",0.5],["bgm","m1"],["say","avg1_112","Espera, ¿el Tirano era así?",9,""],["say","avg1_112","Yo pensaba que lo del Tirano era conquistar todos los Monolitos. ¿No es genial?",9,""],["w",0.3],["cbg",0,820.0,null,null,"OutSine",0.6,null,null,null],["stage",1,0,0],["w",0.4],["say","avg1_111","No terminaste la historia, Noya. El Tirano planeaba demoler todos los Monolitos después de conquistarlos.",9,""],["bg","story_main_01_007_j",1,0.6],["cbg",1,550.0,-20.0,1.1,"Linear",0.0,null,null,null],["w",0.4],["say","avg1_111","Sin Monolitos no hay Artefactos... ¿cómo no va a ser el fin del mundo?",9,""],["w",0.3],["trn",0,0,false,false,0.6],["w",0.6],["stage",1,1,1],["bg","BG_Black",0,0.0],["w",0.1],["trn",1,0,false,false,0.7],["w",0.4],["obj","qstory_side_112_004",0,null,0.54],["w",0.3],["say","0","Iris acaricia su ansiado Artefacto de grabación.",9,""],["w",0.3],["objx"],["w",0.3],["bg","story_main_01_025",0,0.7],["w",0.5],["say","avg1_112","Tranquila. Perder todos los Artefactos no sería el fin del mundo.",9,""],["say","avg1_112","De todos modos empeñamos casi todos los Artefactos. No es que los usemos.",9,""],["w",0.3],["bg","story_main_01_007_g",0,0.7],["cbg",0,800.0,-50.0,1.67,"OutSine",0.0,null,null,null],["w",0.5],["say","avg1_111","Cierto, ¡pero el dinero de venderlos es lo que paga las reparaciones del Lucky Oasis!",9,""],["w",0.3],["mrt",1,"z","002","question",null],["say","avg3_100","Lucky Oasis... ¿así se llama este vehículo?",1,""],["mrt",3,"z",null,null,null],["w",0.46],["bg","BG_Black",0,0.7],["w",0.5],["stage",5,0,16],["say","avg1_103","Sí, y también es el nombre de nuestro hogar.",9,""],["w",0.3],["stage",5,1,17],["bg","story_main_01_007_o",0,0.8],["cbg",0,800.0,-50.0,1.67,"Linear",0.0,null,null,null],["w",0.6],["say","avg1_111","Exacto. Esto es más que nuestro transporte: es el hogar que construimos nosotras mismas.",9,""],["bg","story_main_01_007_k",0,0.8],["cbg",0,800.0,-50.0,1.67,"Linear",0.0,null,null,null],["w",0.6],["say","avg1_111","Las tres crecimos en el mismo orfanato. Cada perno y cada placa del Lucky Oasis lo pusimos nosotras...==W== bueno, sobre todo Noya.",9,""],["w",0.8],["bg","story_main_01_007_o",0,0.8],["cbg",0,800.0,-50.0,1.67,"Linear",0.0,null,null,null],["w",0.6],["goon"],["w",0.3],["bg","story_main_01_025",0,0.7],["w",0.7],["say","avg1_112","Ah, ¡y puedes llamarlo Loxy!",9,""],["w",0.3],["mrt",1,"z","025","exclamation",null],["say","avg3_100","¿Lo construyeron todo ustedes solas? Es increíble, Noya.==W== Pero si querían un vehículo, ¿por qué no pedirlo a alguna caja de deseos?",1,""],["w",0.7],["mrt",0,"y","020","speechless",null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["say","avg1_112","¡Jeje! ¡Así hacemos las cosas los Trekkers! Pedir cosas sin más es aburrido. ¡Desea piezas y construye algo genial con tus manos!",9,""],["say","avg1_112","Oye, Iris, Loxy hace ruido. ¿Crees que podemos darnos el lujo de comprar grasa cuando vendamos el botín?",9,""],["w",0.3],["bg","BG_Black",0,0.6],["w",0.4],["stage",5,0,16],["say","avg1_103","Y mi arma... necesita una recarga de magia...",9,""],["w",0.3],["stage",5,1,17],["bg","story_main_01_007_k",0,0.6],["cbg",0,800.0,-50.0,1.67,"Linear",0.0,null,null,null],["w",0.4],["say","avg1_111","Parece bastante urgente...==W== Pero la respuesta es no.",9,""],["w",0.7],["se","se_048"],["bg","story_main_01_007_l",0,0.6],["cbg",0,800.0,-50.0,1.67,"Linear",0.0,null,null,"Xiao"],["w",0.4],["goon"],["w",0.3],["bg","story_main_01_025",0,0.7],["w",0.5],["say","avg1_112","¡Ay, vamos! ¿Por qué?",9,""],["w",0.3],["bg","story_main_01_007_n",0,0.7],["cbg",0,800.0,-20.0,1.67,"Linear",0.0,null,null,null],["w",0.5],["say","avg1_111","Estamos sin un centavo. Hasta la última moneda tiene que ir a lo esencial. «Bastante urgente» no basta.",9,""],["say","avg1_111","Después de comprar los suministros esenciales, según mis cuentas nos alcanzará justo para una Piedra del Alma.",9,""],["w",0.3],["bg","story_main_01_025",0,0.7],["w",0.5],["say","avg1_112","Piedra del Alma... ¡Ah, sí, hagámoslo!",9,""],["w",0.3],["bg","BG_Black",0,0.7],["bg","story_main_01_007_m",5,0.0],["cbg",5,-100.0,-390.0,1.9,"Linear",0.0,null,null,null],["w",0.5],["stage",5,0,16],["w",0.5],["bg","story_main_01_007_k",5,0.6],["cbg",5,-100.0,-390.0,1.9,"Linear",0.0,null,null,null],["say","avg1_103","De acuerdo.",9,""],["w",0.3],["stage",5,1,17],["bg","story_main_01_007_i",0,0.7],["cbg",0,800.0,-50.0,1.67,"Linear",0.0,null,null,null],["w",0.5],["mrt",1,"y","020","question",null],["say","avg3_100","Piedra del Alma... ¿Te refieres a la piedra con forma de estrella de cuatro puntas que llevan puesta?",1,""],["mrt",3,"y",null,null,null],["w",0.45],["bg","story_main_01_007_f",0,0.7],["cbg",0,800.0,-50.0,1.67,"Linear",0.0,null,null,null],["w",0.5],["say","avg1_111","Es una piedra ligada a tu alma que almacena magia.",9,""],["bg","story_main_01_007_k",0,0.7],["cbg",0,800.0,-50.0,1.67,"Linear",0.0,null,null,null],["w",0.5],["say","avg1_111","Los hechizos y los Artefactos consumen mucho poder, así que primero hay que guardar algo en la piedra.",9,""],["bg","story_main_01_007_o",0,0.7],["cbg",0,800.0,-50.0,1.67,"Linear",0.0,null,null,null],["w",0.5],["say","avg1_111","Además, el Imperio de la Gracia guarda el registro de todas las Piedras del Alma que se han fabricado.",9,""],["say","avg1_111","Así, cuando te consigamos una nueva, tu nombre e identidad deberían aparecer de inmediato.",9,""],["w",0.3],["bg","story_main_01_025",0,0.7],["w",0.4],["say","avg1_112","¡Eres un genio, Iris!",9,""],["w",0.3],["bg","BG_Black",0,0.7],["w",0.5],["stage",5,0,16],["say","avg1_103","Genio...",9,""],["w",0.3],["stage",5,1,17],["bg","story_main_01_007_o",0,0.7],["cbg",0,800.0,-50.0,1.67,"Linear",0.0,null,null,null],["w",0.3],["say","avg1_111","Gracias...==W== Pero ningún halago va a adelantar tus compras en la lista.",9,""],["w",0.7],["bg","story_main_01_007_f",0,0.7],["cbg",0,800.0,-50.0,1.67,"OutSine",0.0,null,null,null],["w",0.3],["goon"],["w",0.3],["se","se_055"],["w",0.2],["say","avg1_112","...",9,""],["say","avg1_103","...",9,""],["w",0.3],["mrt",2,"z","007","vexation","lengzhan"],["say","avg3_100","Pero es caro... No quiero ser una carga.",1,""],["mrt",3,"z",null,null,null],["w",0.45],["bg","story_main_01_007_o",0,0.7],["cbg",0,800.0,-50.0,1.67,"Linear",0.0,null,null,null],["w",0.5],["say","avg1_111","Todos los Trekkers juramos ayudar a quienes han perdido la memoria.",9,""],["say","avg1_111","Porque quién sabe. Mañana podríamos ser nosotras las que nos quedemos en blanco.",9,""],["w",0.3],["bg","story_main_01_025",0,0.7],["w",0.7],["say","avg1_112","¡Tú acepta! No todos los días Iris es tan generosa.",9,""],["w",0.3],["bgm",""],["se","se_070"],["bg","story_main_01_007_b",0,0.7],["cbg",0,1200.0,null,2.0,"Linear",0.0,null,null,"Zhong"],["w",0.5],["say","avg1_111","¡Noya—!",9,""],["se","se_410"],["w",0.3],["bg","story_main_01_025",0,0.8],["cbg",0,null,null,null,"Linear",0.0,null,null,"xingshi"],["w",0.7],["say","avg1_112","¡Miren! ¡Llegamos a la Ciudad de los Mil Monolitos!",9,""],["w",0.3],["bg","BG_Black",0,0.7],["w",0.5],["say","0","Noya conduce el vehículo hacia una ciudad inmensa y bulliciosa.",9,""],["w",1.0],["clear",0,0,1],["w",0.4],["se","se_263"],["trn",0,4,false,false,1.5],["w",1.5],["bg","story_main_01_008",0,0.7],["cbg",0,100.0,null,1.05,"Linear",0.0,null,null,null],["trn",1,4,false,false,1.5],["w",1.5],["cbg",0,-100.0,null,null,"Linear",15.0,null,null,null],["w",0.5],["bgm","m13"],["say","avg1_103","Vaya, han pasado dos años desde que nos fuimos.==W== Este lugar sigue tan animado como siempre.",9,""],["w",0.5],["goon"],["w",0.3],["bg","story_main_01_009",0,0.7],["cbg",0,100.0,null,1.05,"Linear",0.0,null,null,null],["cbg",0,-100.0,null,null,"Linear",15.0,null,null,null],["w",0.5],["say","avg1_103","Ah.",9,""],["say","avg1_111","¿Qué pasa, Amber?",9,""],["say","avg1_103","Un gato negro.",9,""],["w",0.3],["bg","story_main_01_010",0,0.8],["cbg",0,100.0,null,1.05,"Linear",0.0,null,null,null],["cbg",0,-100.0,null,null,"Linear",20.0,null,null,null],["w",0.5],["say","avg1_111","Quizá deberíamos pasar por el Orfanato de las Cenizas a ver a la tía Allie... No, primero tenemos que vender los Artefactos.",9,""],["w",0.3],["mrt",2,"y","020","think",null],["say","avg3_100","Entonces la Ciudad de los Mil Monolitos... no fue destruida.",2,""],["mrt",0,"y","010","sigh",null],["say","avg3_100","¿De verdad... fue solo un sueño?",2,""],["mrt",3,"y",null,null,null],["w",0.46],["cbg",0,null,-50.0,null,"Linear",2.5,null,null,null],["w",1],["bg","story_main_01_005",0,0.7],["cbg",0,null,0.0,1.05,"Linear",0.0,null,null,null],["cbg",0,null,-60.0,null,"OutSine",4.0,null,null,null],["w",0.5],["say","0","A lo lejos, estrellas incrustadas en altas torres blancas que se alzan como centinelas silenciosos.",9,""],["bgm",""],["w",1],["clear",0,0,1],["w",0.3],["end"]]}