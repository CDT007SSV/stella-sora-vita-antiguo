"avg1_112","a",null,"exclamation",null,null,null,1.0,"jushou","OutSine",0.4],["w",0.4],["say","avg1_112","Uf. Pobres de ellos.",0,""],["ctl","avg1_132","a","003","sigh",null,null,null,null,null,"OutSine",0.3],["w",0.3],["say","avg1_132","Qué va, a mí me dieron una paliza. Lo único bueno fue que los niños lograron escapar.",0,""],["w",0.3],["trn",0,0,true,true,0.7],["w",0.7],["bg","story_main_01_029",0,0.0],["trn",1,0,false,false,0.7],["w",0.4],["say","avg1_132","Al llegar a casa, me miré al espejo y vi a una chica llena de moretones.",9,""],["say","avg1_132","Era huérfana, igual que ellos. Viví en las mismas calles, sin saber nunca de dónde saldría mi próxima comida.",9,""],["say","avg1_132","Y si alguna vez juntaba unas monedas, algún matón me las quitaba.",9,""],["w",0.3],["film",0],["w",0.2],["fx",0,"fx_avg_reminiscence_loop",0,0],["bg","story_main_01_028",0,0.6],["cbg",0,null,null,0.98,"Linear",0.0,null,null,null],["w",0.3],["say","Vicious Gangster","Vaya, vaya, si es la avecilla que salió volando del Distrito de las Cenizas.",3,""],["say","Vicious Gangster","¿Qué pasa? ¿Te acostumbraste tanto a tu jaula de platino que olvidaste de dónde vienes? No querrás ensuciar esa ropa tan fina, ¿verdad?",3,""],["w",0.3],["film",1],["w",0.2],["fx",0,"fx_avg_reminiscence_loop",1,0],["w",0.1],["bg","ttc_canal_dusk",0,0.7],["cbg",0,null,null,1.05,"Linear",0.0,null,null,null],["w",0.4],["show","avg1_132","a","003",0.52,-0.09,1.15,0,null,0.0],["ctl","avg1_132","a",null,"speechless",null,null,null,1.0,null,"OutSine",0.4],["w",0.4],["say","avg1_132","Tenía razón. Había olvidado por completo quién era.",0,""],["ctl","avg1_132","a",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.3],["say","avg1_132","Me importaba demasiado esa prenda que llevaba puesta.",0,""],["ctl","avg1_132","a","008",null,null,null,null,null,null,"OutSine",0.3],["w",0.3],["say","avg1_132","El primer libro que leí en mi vida me lo dio la tía Allie.",0,""],["w",0.3],["ctl","avg1_132","a",null,null,null,null,null,0.0,null,"OutSine",0.4],["stg",0,-50.0,null,null,"Linear",0.7,null,null,null],["w",0.6],["bg","city_alley_dusk",0,0.7],["cbg",0,100.0,null,1.05,"Linear",0.0,null,null,null],["cbg",0,-100.0,null,null,"Linear",7.0,null,null,null],["w",0.6],["say","avg1_132","El orfanato no podía acoger a todos, pero su calle era la más segura del Distrito de las Cenizas. Podías dormir bajo un puente allí y tus cosas estaban a salvo.",0,""],["say","avg1_132","La tía Allie me prestaba libros del orfanato. No conseguí la beca por ser lista. La conseguí porque alguien me cuidaba las espaldas.",0,""],["w",0.3],["stg",0,0.0,null,null,"Linear",1.0,null,null,null],["w",0.3],["ctl","avg1_132","a","002",null,null,null,null,null,null,"Linear",0.0],["bg","ttc_canal_dusk",0,0.7],["cbg",0,null,null,1.05,"Linear",0.0,null,null,null],["w",0.3],["show","avg1_111","a","002",0.82,-0.03,1.05,0,null,0.0],["ctl","avg1_132","a",null,null,null,null,null,1.0,null,"OutSine",0.4],["ctl","avg1_111","a","011","happy",0.77,null,null,1.0,null,"OutSine",0.4],["w",0.4],["say","avg1_111","Ah, así que por eso los libros del estante desaparecían y reaparecían. Eras tú quien los tomaba prestados.",0,""],["ctl","avg1_132","a","013","sweaty",null,null,null,null,null,"OutSine",0.3],["w",0.3],["say","avg1_132","Sí, prácticamente era una niña del orfanato. Lástima que no llegué a conocerlas en ese entonces.",0,""],["show","avg1_103","a","002",0.2,-0.03,1.05,0,null,0.0],["ctl","avg1_103","a","007","star",0.25,null,null,1.0,null,"OutSine",0.4],["w",0.4],["say","avg1_103","Todavía no es tarde. Toma, intercambiemos números.",0,""],["ctl","avg1_132","a","012","shy",null,null,null,null,null,"OutSine",0.3],["w",0.3],["say","avg1_132","Claro.",0,""],["clear",1,0.4,1],["w",0.3],["bg","story_main_01_030",0,0.7],["w",0.5],["say","avg1_132","Creí que había salido del Distrito de las Cenizas yo sola. Resulta que simplemente nunca noté a la gente que sostenía un paraguas sobre mi cabeza.",9,""],["say","avg1_132","Cuando un pájaro se escapa de la jaula, eso es escapar. ¿Cuando toda la bandada alza el vuelo? Eso sí es volar de verdad.",9,""],["w",0.3],["bg","story_main_01_031",0,0.7],["cbg",0,null,null,1.05,"Linear",0.0,null,null,null],["cbg",0,null,null,0.98,"Linear",6.0,null,null,null],["w",0.4],["say","avg1_132","Cuando la tía Allie y el orfanato desaparecieron, pensé que me tocaba a mí sostener el paraguas para los niños.",9,""],["say","avg1_132","Pelear no era lo mío, pero estudié todos los libros de artes marciales de la biblioteca de la Academia Platino.",9,""],["say","avg1_132","La vida de pandilla me era ajena, pero vi todas las películas de pandillas del Monolito de la colección de la Academia Platino.",9,""],["say","avg1_132","Así que agarré un bate, me puse el atuendo que yo misma hice, fingí ser la más dura de todas y derribé la puerta del viejo orfanato donde se habían instalado las pandillas.",9,""],["say","avg1_132","Y cuando me di cuenta, el Clan Viento de Ceniza ya existía. Y terminé con un montón de niños a mi alrededor... Yo solía ser una de ellos.",9,""],["say","avg1_132","Y esa es mi historia.",9,""],["w",0.3],["bg","mood_1",0,0.7],["w",0.4],["show","avg1_111","a","011",null,-0.14,1.2,0,null,0.0],["ctl","avg1_111","a",null,"flower",null,null,null,1.0,null,"OutSine",0.4],["w",0.3],["say","avg1_111","Gracias... por proteger un lugar que significa tanto para nosotras.",9,""],["w",0.5],["clear",1,0.4,1],["w",0.25],["bg","story_main_01_013",0,0.7],["w",0.4],["say","avg1_132","No me lo agradezcas. Yo solo...",9,""],["say","avg1_132","...hacía lo que había que hacer.",9,""],["say","avg1_132","Nada puede detener al viento que sopla por el Distrito de las Cenizas.",9,""],["say","avg1_132","Suena bastante rudo, ¿verdad? En realidad, es solo un lugar donde un montón de callejeros nos cuidamos entre nosotros.",9,""],["say","avg1_132","Yo, Vollara, Neuvira y los otros mayores... no podríamos proteger esta calle solos, al menos no jugando limpio.",9,""],["say","avg1_132","Tenemos que pa