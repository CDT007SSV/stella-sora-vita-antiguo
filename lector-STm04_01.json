{"id":"STm04_01","names":{"0":"","avg1_103":"Amber","avg1_112":"Noya","avg1_113":"Shimiao","avg1_133":"Nazuka","avg1_1996":"Noya","avg3_100":"Sylar","avg3_182":"Elis","avg3_999":"???"},"en":{"0":"","avg1_103":"Amber","avg1_112":"Noya","avg1_113":"Shimiao","avg1_133":"Nazuka","avg1_1996":"Noya B","avg3_100":"Sylar","avg3_182":"Elis","avg3_999":"???"},"tx":1,"steps":[["intro","Act One","The Old Days","To escape the Garden of Parasite, you leap into a pit with Nazuka. When you wake up, you're resting your head on Nazuka's lap, and she tells you about what happened in the past. If only this peaceful moment would last forever."],["say","0","This is a story from a distant past— one never recorded in any history book.",8,""],["w",1.0],["clear",0,0,1],["w",0.4],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["bg","white_room_inside_a",0,1.0],["cbg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["w",0.8],["bgm","m54"],["show","avg3_182","a","002",0.68,-0.1,1.15,0,null,0.0],["ctl","avg3_182","a",null,"exclamation",0.6,null,null,1.0,null,"OutSine",0.5],["w",0.5],["say","avg3_999","==PLAYER_NAME==... ==PLAYER_NAME==! C'mon, wake up.",0,""],["w",0.3],["ctl","avg3_182","a",null,null,null,-0.2,null,null,null,"OutSine",0.5],["w",0.5],["se","se_077"],["show","avg3_100","a","011",0.3,-0.2,1.15,0,null,0.0],["ctl","avg3_100","a",null,null,null,null,null,null,null,"OutSine",0.0],["ctl","avg3_182","a",null,null,null,-0.1,null,null,null,"OutSine",1.0],["w",0.15],["ctl","avg3_100","a",null,"sleepy",0.36,-0.1,null,1.0,null,"OutBack",1.35],["w",2.4],["stg",0,0.0,0.0,1.25,"OutSine",0.7,null,null,null],["ctl","avg3_182","a",null,null,0.66,null,null,0.0,null,"OutSine",0.6],["ctl","avg3_100","a",null,null,0.27,null,null,0.0,null,"OutSine",0.6],["w",0.75],["say","avg3_999","Hey, check this out! My latest creation. From now on, this is our secret hideout.",0,""],["w",0.35],["stg",0,null,null,1.05,"OutQuad",0.7,null,null,null],["w",0.3],["ctl","avg3_100","a",null,null,0.33,null,null,1.0,null,"Out