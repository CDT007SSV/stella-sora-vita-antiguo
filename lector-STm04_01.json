,"avg3_182","a",null,"flurry",0.65,null,null,1.0,"daintou","OutSine",0.6],["w",0.6],["say","avg3_999","Whoa, you're sleepy again?",0,""],["w",0.3],["stg",0,0.0,null,1.05,"OutSine",0.6,null,null,null],["w",0.1],["se","se_062"],["ctl","avg3_182","a",null,null,0.5,-0.32,1.45,null,null,"OutSine",0.5],["w",0.5],["say","avg3_999","Don't lie on the ground like that. You'll catch a cold.",0,""],["w",0.3],["se","se_169"],["trn",0,1,true,true,0.8],["w",0.8],["bg","white_room_inside_a",0,0.0],["cbg",0,0.0,0.0,1.2,"Linear",0.0,null,null,null],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["show","avg3_182","a","002",0.515,-0.5,2.5,0,null,null],["film",0],["trn",1,1,false,false,1.2],["w",1.2],["say","avg3_999","Here. Next time you feel tired, just rest your head on my lap.",3,""],["w",0.8],["bgm",""],["clear",0,0,1],["w",0.4],["bg","BG_Black",0,2.0],["w",1.0],["trn",0,0,false,false,1],["w",1],["fx",0,"fx_avg_eye_ev",0,2],["film",1],["w",0.1],["trn",1,0,false,false,0.8],["w",3.95],["say","0","Something soft and warm cradles the back of my head. I close my eyes, drifting into a peaceful dream.",8,""],["w",0.8],["clear",0,0,1],["w",0.4],["trn",0,0,true,true,0.8],["w",0.8],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["w",1.2],["bg","story_main_03_011",0,0.7],["cbg",0,null,200.0,1.15,"Linear",0.0,null,null,null],["trn",1,0,false,false,0.7],["cbg",0,null,0.0,1.0,"OutSine",4.65,null,null,null],["fx",0,"fx_avg_eye_ev",0,0],["w",5.2],["head","17:18, Pluvia Month 27th, Outside Philae, Unknown Pit"],["w",0.4],["mrt",2,"z","025","symbol",null],["tsk","Zhong"],["say","avg3_100","Na... Nazuka?",1,""],["mrt",0,"z","007","flurry","daintou"],["say","avg3_100","Where ... are we?",1,""],["mrt",3,"z",null,null,null],["bgm","m20"],["w",0.45],["bg","story_main_03_011_b",0,0.7],["w",0.5],["say","avg1_133","Before that, tell me: what do you see when you look at me? And describe your surroundings...",9,""],["w",0.4],["mrt",1,"y","021","awkward","lengzhan"],["say","avg3_100","You? You're just Nazuka.",1,""],["mrt",3,"y",null,null,null],["w",0.45],["bg","story_main_03_011_a",0,0.8],["cbg",0,-500.0,-200.0,1.5,"Linear",0.0,null,null,null],["cbg",0,-400.0,null,null,"Linear",6.0,null,null,null],["w",1.2],["mrt",1,"z","002",null,null],["say","avg3_100","As for our surroundings... Is that a light up there? Are we in some kind of hole?",1,""],["mrt",3,"z",null,null,null],["w",0.51],["bg","story_main_03_011_f",0,0.7],["w",0.7],["say","avg1_133","Phew... You haven't been affected by the magic mist from the Garden of Parasite. That's a relief.",9,""],["w",0.3],["bg","story_main_03_011_e",0,0.7],["w",0.4],["mrt",1,"y","020","speechless",null],["say","avg3_100","The Garden of Parasite... Magic mist?",1,""],["mrt",0,"y","007","symbol","jingxia"],["say","avg3_100","Right, I remember now! We ran into the Garden of Parasite in the forest, so we took refuge in here.",1,""],["mrt",3,"z",null,null,null],["w",0.51],["bg","story_main_03_011_b",0,0.0],["w",0.3],["say","avg1_133","Yeah. I have no idea who dug it, but this pit was a real lifesaver. It's too deep for those vines to reach us.",9,""],["w",0.3],["mrt",1,"y","003",null,null],["say","avg3_100","I see...==W== Wait, how'd I pass out?",1,""],["w",0.8],["mrt",0,"y","021","question",null],["goon"],["mrt",3,"y",null,null,null],["w",0.45],["show","avg1_103","a","002",0.57,-0.5,1.6,0,"shy",0.0],["bg","story_main_03_011_d",0,0.4],["w",0.4],["say","avg1_133","A-Ah, well... After you jumped, I kinda ... landed on you.",9,""],["w",0.3],["ctl","avg1_103","a",null,null,null,null,null,null,null,"OutSine",0.0],["hide","avg1_103",0],["mrt",2,"z","025","idea",null],["say","avg3_100","Oh.==W== So you knocked me out.",1,""],["w",0.4],["mrt",0,"z","014","music","jushou"],["goon"],["mrt",3,"z",null,null,null],["w",0.45],["se","se_070"],["cbg",0,null,null,null,"Linear",0.0,null,null,"Zhong"],["say","avg1_133","I-It wasn't on purpose! A-And I'm not that heavy...!",9,""],["w",0.3],["show","avg1_103","a","002",0.39,-0.35,1.6,0,"angry",0.0],["bg","story_main_03_011_g",0,0.4],["say","avg1_133","Hmph... And here I was trying to be nice 'cause I felt bad...",9,""],["w",0.3],["ctl","avg1_103","a",null,null,null,null,null,null,null,"OutSine",0.3],["hide","avg1_103",0.3],["mrt",2,"y","020","think",null],["say","avg3_100","So she isn't always so cold.==W== Maybe ... this is the real Nazuka?",2,""],["w",0.6],["mrt",0,"y","002",null,null],["goon"],["bg","story_main_03_011",0,0.6],["w",0.5],["mrt",0,"z","023",null,null],["say","avg3_100","Hey, it's not your fault. In an emergency like that, you can't really worry about the landing.==W== Besides, you'd already burned through all your magic and stamina.",1,""],["w",0.5],["mrt",0,"y","003",null,null],["goon"],["mrt",0,"z","007","flurry","daintou"],["say","avg3_100","Hang on, what am I lying on?",1,""],["mrt",3,"y",null,null,null],["w",0.45],["se","se_054"],["cbg",0,-30.0,null,null,"OutSine",0.25,null,null,null],["w",0.25],["cbg",0,30.0,null,null,"OutSine",0.25,null,null,null],["w",0.25],["cbg",0,-30.0,null,null,"OutSine",0.25,null,null,null],["w",0.25],["cbg",0,30.0,null,null,"OutSine",0.25,null,null,null],["w",0.25],["cbg",0,0.0,null,null,"OutSine",0.15,null,null,null],["w",0.15],["say","0","A soft warmth cradles the back of my head, just like in my dream. It's only then did I realize I'm resting on Nazuka's lap.",9,""],["w",0.4],["se","se_146"],["cbg",0,null,-150.0,null,"OutQuad",0.75,null,null,null],["w",0.85],["se","se_086"],["cbg",0,null,0.0,null,"OutSine",0.4,null,null,"chijing"],["w",0.4],["say","0","I scramble to get up, but Nazuka holds my shoulders down.",9,""],["bg","story_main_03_011_c",0,0.7],["w",0.4],["say","avg1_133","I was worried you had hit your head. Just lie down a little longer.",9,""],["w",0.3],["mrt",1,"y","020","think",null],["say","avg3_100","She's definitely worried. That awkward kindness...==W== It's just like Nazuna.",2,""],["w",0.5],["mrt",0,"y","023",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.51],["bg","story_main_03_011_b",0,0.4],["w",0.4],["show","avg1_103","a","002",0.51,-0.13,-1.1,0,"sigh",0.0],["say","avg1_133","Also ... it'd be a problem for me if you move around. I inhaled some of that mist while casting magic, so right now ... you don't look like yourself to me.",9,""],["w",0.3],["mrt",2,"z","025","symbol",null],["say","avg3_100","You were poisoned by the mist?!",1,""],["mrt",3,"z",null,null,null],["ctl","avg1_103","a",null,null,null,null,null,null,null,"Linear",0.1],["hide","avg1_103",0.1],["w",0.51],["bg","story_main_03_011_f",0,0.0],["w",0.3],["say","avg1_133","It's nothing serious. I've been exposed to it before. The effects wear off in about an hour, without lingering effects.",9,""],["bg","story_main_03_011_e",0,0.5],["w",0.5],["say","avg1_133","The hallucinations can shift at any second though, so if I look away, my eyes may play another trick on me. With you on my lap, at least I can be sure you are you.",9,""],["w",0.3],["mrt",1,"z","003",null,null],["say","avg3_100","I see...==W== So the lap pillow's actually practical.",1,""],["w",0.5],["mrt",0,"y","007","shy","lengzhan"],["goon"],["mrt",3,"y",null,null,null],["w",0.51],["show","avg1_113","a","002",0.54,-0.205,1.35,0,"attention",0.0],["bg","story_main_03_011_b",0,0.0],["w",0.3],["say","avg1_133","Mhm. So it's best we stay like this 'til I've recovered. You wouldn't want me to ... mistake you for a monster, would you?",9,""],["w",0.3],["mrt",2,"z","007","flurry",null],["say","avg3_100","Definitely not...==W== But now I'm curious. What do I look like to you now? What kind of monster?",1,""],["w",0.5],["mrt",0,"y","021","question",null],["goon"],["mrt",3,"y",null,null,null],["w",0.51],["bg","story_main_03_011_f",0,0.0],["w",0.3],["say","avg1_133","Not a monster. A statue.==W== You know the One-Armed Saint at the Philae Museum of Art? Kinda like that, but with your face.",9,""],["w",0.5],["show","avg1_103","a","002",0.565,-0.21,1.2,0,"music",0.0],["bg","story_main_03_011_e",0,0.4],["w",0.4],["goon"],["w",0.4],["mrt",1,"y","003",null,null],["say","avg3_100","Don't know that one...==W== But if I look like stone, do I feel cold and hard, too?",1,""],["ctl","avg1_103","a",null,null,null,null,null,null,null,"Linear",0.0],["hide","avg1_103",0],["w",0.6],["mrt",0,"z","002","question",null],["goon"],["mrt",3,"z",null,null,null],["w",0.51],["bg","story_main_03_011_b",0,0.0],["w",0.3],["say","avg1_133","Mhm. Rough, cold, and hard. The mist from the Garden of Parasite messes with your sense of touch, too.",9,""],["w",0.35],["mrt",2,"z","007","symbol","guodongtiao1"],["say","avg3_100","This must be uncomfortable... And you've been watching over me the whole time?",1,""],["mrt",3,"z",null,null,null],["w",0.51],["bg","story_main_03_011_h",0,0.35],["w",0.35],["say","avg1_133","It's nothing. When you were unconscious, I wasn't even sure if you'd wake up... That was the real worry.",9,""],["w",0.3],["mrt",2,"z","013","happy",null],["say","avg3_100","Pfft—hahaha.",1,""],["mrt",3,"z",null,null,null],["w",0.51],["show","avg1_103","a","002",0.59,-0.5,1.6,0,"question",0.0],["bg","story_main_03_011_c",0,0.3],["w",0.3],["say","avg1_133","Hey... What's so funny?",9,""],["w",0.3],["ctl","avg1_103","a",null,null,null,null,null,null,null,"Linear",0.0],["hide","avg1_103",0],["mrt",1,"z","014","music",null],["say","avg3_100","Sorry, couldn't help it.==W== I just never imagined that the serious, combative, and somewhat aloof Nazuka I know had a side like this.",1,""],["w",0.7],["mrt",0,"y","011","shy",null],["bg","story_main_03_011_d",0,0.4],["goon"],["mrt",0,"y","023",null,null],["say","avg3_100","You're actually pretty gentle. And it's unexpectedly endearing that you'd worry about your weight at a time like this.==W== This version of you is pretty approachable.",1,""],["w",0.6],["mrt",0,"z","022",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.51],["show","avg1_103","a","002",0.55,-0.22,-1.15,0,"vexation",0.0],["bg","story_main_03_011_g",0,0.4],["w",0.4],["say","avg1_133","I feel like you're teasing me.",9,""],["w",0.3],["ctl","avg1_103","a",null,null,null,null,null,null,null,"Linear",0.0],["hide","avg1_103",0],["mrt",2,"z","007","exclamation",null],["say","avg3_100","It's a 100% genuine compliment.",1,""],["mrt",3,"z",null,null,null],["w",0.51],["show","avg1_103","a","002",0.58,-0.35,1.5,0,"speechless",0.0],["bg","story_main_03_011_h",0,0.4],["w",0.4],["say","avg1_133","If you say so. Still, you're pretty relaxed, trying to lighten the mood even now. Do you really understand the severity of our situation?",9,""],["ctl","avg1_103","a",null,null,null,null,null,null,null,"OutSine",0.3],["bg","story_main_03_011_c",0,0.4],["w",0.4],["say","avg1_133","The Garden of Parasite is still up there waiting for us, we're trapped in this steep hole that could collapse at any second, and my magic is gone, so I can't fly us out.",9,""],["w",0.3],["mrt",2,"y","010","sigh",null],["say","avg3_100","Hmm... So we really are at a dead end.",1,""],["mrt",3,"y",null,null,null],["w",0.51],["ctl","avg1_103","a",null,null,null,null,null,null,null,"Linear",0.0],["hide","avg1_103",0],["say","avg1_133","Yeah. All we can do is wait for the magic mist to clear, pray this hole doesn't fall in on us, and try to recover some magic. That and nothing else.",9,""],["w",0.3],["mrt",1,"z","013","music",null],["say","avg3_100","For now, isn't that enough?",1,""],["mrt",3,"z",null,null,null],["w",0.51],["show","avg1_103","a","002",0.585,-0.45,1.55,0,"question",0.0],["bg","story_main_03_011_b",0,0.4],["w",0.4],["say","avg1_133","Why are you smiling?",9,""],["w",0.4],["mrt",1,"z","002",null,null],["say","avg3_100","I have a friend who smiles in any situation. I once asked her about, and she said—",1,""],["mrt",3,"z",null,null,null],["w",0.51],["trn",0,0,false,false,0.7],["w",0.7],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["bg","ttc_parkbase_daylight",0,0.0],["cbg",0,-30.0,15.0,1.1,"Linear",0.0,null,null,null],["fx",0,"fx_avg_reminiscence_loop",0,0],["cbg",0,0.0,0.0,null,"OutSine",0.4,null,null,null],["trn",1,0,false,false,0.5],["show","avg1_1996","b","002",0.47,-0.11,1.16,0,null,0.0],["ctl","avg1_1996","b",null,null,null,null,null,0.0,null,"OutSine",0.0],["ctl","avg1_1996","b",null,"attention",0.55,-0.15,1.23,1.0,null,"OutSine",0.35],["w",0.35],["say","avg1_112","Smiling or crying, you're still facing the same problem...",0,""],["w",0.3],["ctl","avg1_1996","b",null,null,null,null,null,0.0,null,"OutSine",0.4],["show","avg1_112","b","002",0.53,-0.15,1.23,0,null,0.0],["ctl","avg1_112","b","003",null,null,null,null,0.0,null,"OutSine",0.0],["ctl","avg1_112","b",null,null,null,null,null,1.0,null,"Linear",0.5],["ctl","avg1_112","b",null,null,0.48,-0.215,1.34,null,null,"OutSine",0.35],["w",0.32],["ctl","avg1_112","b",null,"music",0.49,-0.218,1.35,null,null,"OutSine",0.2],["w",0.35],["say","avg1_112","So why not smile and feel a little better?",0,""],["w",0.35],["trn",0,0,true,true,0.7],["w",0.7],["bg","story_main_03_011",0,0.0],["fx",0,"fx_avg_reminiscence_loop",1,0],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["trn",1,0,false,false,0.6],["w",0.25],["mrt",2,"y","024","speechless",null],["say","avg3_100","I think she's right. Even if we really are stuck, there's no point being miserable. A sour face won't fix anything.",1,""],["mrt",3,"y",null,null,null],["w",0.51],["bg","story_main_03_011_f",0,0.4],["w",0.4],["say","avg1_133","We might as well smile since crying makes no difference. Interesting...==W== I shall give it a try since we're stuck here.",9,""],["w",0.5],["bg","story_main_03_011_e",0,0.45],["w",0.45],["goon"],["w",0.3],["mrt",2,"z","002","idea",null],["say","avg3_100","That's the spirit. On that note, I have a suggestion—",1,""],["bg","story_main_03_011_b",0,0.4],["mrt",0,"z","014","music",null],["say","avg3_100","Why don't we use this time to get to know each other?",1,""],["mrt",0,"z","023",null,null],["say","avg3_100","If we understand each other's strengths and weaknesses, we'll have more tactical options when a crisis hits.",1,""],["mrt",3,"z",null,null,null],["w",0.51],["bg","story_main_03_011_f",0,0.4],["w",0.4],["say","avg1_133","A way to use our time efficiently... That's not a bad idea.==W== Shall I begin?",9,""],["w",0.6],["show","avg1_103","a","002",0.585,-0.45,1.53,0,"question",0.0],["bg","story_main_03_011_b",0,0.0],["w",0.1],["goon"],["w",0.3],["ctl","avg1_103","a",null,null,null,null,null,null,null,"Linear",0.0],["hide","avg1_103",0],["mrt",2,"z","013","attention",null],["say","avg3_100","After you.",1,""],["mrt",3,"z",null,null,null],["w",0.51],["bg","story_main_03_011",0,0.4],["w",0.4],["say","avg1_133","Come to think of it... ==PLAYER_NAME==, have you actually been inside Philae since you got here?",9,""],["w",0.4],["mrt",1,"y","020","speechless",null],["say","avg3_100","Huh? I guess we haven't... We've just been going back and forth between the camp and the Trekkers' House.",1,""],["mrt",0,"y","021","question",null],["say","avg3_100","But what does that have to do with her...?",2,""],["mrt",3,"y",null,null,null],["w",0.51],["show","avg1_103","a","002",0.49,-0.27,-1.25,0,"happy",0.0],["bg","story_main_03_011_f",0,0.0],["say","avg1_133","Then you probably don't know that the One-Armed Saint statue at the Philae Museum of Art is nude.",9,""],["bgm",""],["w",0.3],["ctl","avg1_103","a",null,null,null,null,null,null,null,"Linear",0.3],["hide","avg1_103",0.3],["mrt",1,"y","003","sigh",null],["say","avg3_100","But nude statues are pretty common for showcasing the human form, aren't they?",1,""],["mrt",3,"z",null,null,null],["w",0.51],["se","se_224"],["trn",0,0,false,false,0.6],["w",0.6],["bg","story_main_03_011_b",0,0.0],["fx",0,"fx_avg_reminiscence_loop",0,0],["trn",1,0,false,false,0.6],["fx",0,"fx_avg_movie",0,0],["w",0.75],["mrt",2,"z","007","flurry",null],["say","avg3_100","Definitely not...==W== But now I'm curious. What do I look like to you now? What kind of monster?",1,""],["w",0.7],["mrt",0,"y","021","question",null],["goon"],["mrt",3,"y",null,null,null],["w",0.51],["bg","story_main_03_011_f",0,0.0],["w",0.6],["say","avg1_133","Not a monster. A statue. You know the One-Armed Saint at the Philae Museum of Art? Kinda like that, but with your face.",9,""],["fx",0,"fx_avg_movie",1,0],["fx",0,"fx_avg_reminiscence_loop",1,0],["w",0.4],["bg","story_main_03_011_e",0,0.4],["w",0.4],["se","se_070"],["stg",0,null,null,null,"Linear",0.0,null,null,"Zhong"],["bgm","m37"],["mrt",2,"z","025","symbol",null],["tsk","Xiao"],["say","avg3_100","You see me like that too?!==W== Wait, hold on a sec—",1,""],["w",0.5],["mrt",0,"z","007","flurry","guodongtiao1"],["goon"],["mrt",3,"z",null,null,null],["w",0.51],["se","se_147"],["cbg",0,null,null,null,"OutSine",0.0,null,null,"zhenjing"],["w",0.78],["choice",["Cover yourself up"],[[]]],["w",0.1],["show","avg1_103","a","002",0.515,-0.17,-1.15,0,"star",0.0],["bg","story_main_03_011_f",0,0.4],["w",0.4],["say","avg1_133","Pfft—",9,""],["w",0.3],["ctl","avg1_103","a",null,null,null,null,null,null,null,"Linear",0.0],["hide","avg1_103",0],["mrt",2,"z","007","shy","lengzhan"],["say","avg3_100","Hey! You're messing with me, aren't you?!",1,""],["mrt",3,"z",null,null,null],["w",0.51],["show","avg1_103","a","002",0.4,-0.38,1.65,0,"angry",0.0],["bg","story_main_03_011_g",0,0.0],["say","avg1_133","Well, someone was making such a big deal about getting \"knocked out\" earlier. So now we're even.",9,""],["w",0.3],["ctl","avg1_103","a",null,null,null,null,null,null,null,"OutSine",0.3],["hide","avg1_103",0.3],["mrt",1,"y","021","think",null],["say","avg3_100","Holding a grudge over something so silly...==W== Still, it's good that we can joke around like this.",2,""],["w",0.5],["mrt",0,"y","003",null,null],["goon"],["mrt",0,"y","025","symbol","guodongtiao1"],["say","avg3_100","Wait! What about the statue?! You left out the most important part!",2,""],["mrt",3,"y",null,null,null],["w",0.51],["show","avg1_103","a","002",0.56,-0.27,1.27,0,"music",0.0],["bg","story_main_03_011_f",0,0.4],["w",0.4],["say","avg1_133","Relax... Some part of the One-Armed Saint is clothed, though it's still about 95% exposed.",9,""],["w",0.3],["ctl","avg1_103","a",null,null,null,null,null,null,null,"Linear",0.0],["hide","avg1_103",0],["se","se_070"],["stg",0,null,null,null,"Linear",0.0,null,null,"Zhong"],["mrt",2,"z","007",null,null],["tsk","Zhong"],["say","avg3_100","How is that any different from being completely naked...?!",1,""],["mrt",3,"z",null,null,null],["bgm",""],["w",0.51],["se","se_067"],["bg","story_main_03_011_a",0,0.7],["cbg",0,-200.0,-200.0,1.3,"Linear",0.0,null,null,"Xiao"],["w",1.5],["bg","story_main_03_011_h",0,0.7],["w",0.3],["show","avg1_103","a","002",0.6,-0.41,1.4,0,"exclamation",0.0],["w",0.4],["say","avg1_133","Steady. The Garden of Parasite is on the move.",9,""],["w",0.4],["cbg",0,null,-70.0,null,"OutSine",0.9,null,null,null],["hide","avg1_103"],["bg","BG_Black",0,0.7],["w",0.3],["se","se_067"],["w",0.3],["fx",0,"fx_avg_dust_light",0,0],["w",1.5],["se","se_219"],["bg","white",0,0.7],["w",0.65],["bg","BG_Black",0,0.6],["w",0.6],["say","0","The ground shudders violently, as dirt and rock fall from the wall. Nazuka shields me with her body, using the last of her magic to conjure a wind barrier as thin as a cicada's wing.",9,""],["w",0.3],["bg","story_main_03_011",0,1.2],["w",1.2],["bgm","m57"],["mrt",2,"z","002","attention",null],["say","avg3_100","Thanks...==W== But you don't have to shield me like that. I'm tougher than most people make me out to be.",1,""],["w",0.5],["mrt",0,"z","003",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.51],["bg","story_main_03_011_h",0,0.45],["w",0.45],["say","avg1_133","I... I just can't bear seeing people around me fall into danger.",9,""],["w",0.3],["mrt",2,"y","020",null,null],["say","avg3_100","You can't bear that, huh?==W== Is that why you left Petal Bloom? Even though I don't actually know the whole story.",1,""],["w",0.5],["mrt",0,"z","002","attention",null],["goon"],["mrt",3,"z",null,null,null],["w",0.51],["show","avg1_103","a","002",0.59,-0.4,1.43,0,"exclamation",0.0],["bg","story_main_03_011_b",0,0.4],["w",0.4],["say","avg1_133","Don't jump to conclusions.",9,""],["w",0.3],["mrt",2,"z","002","attention",null],["say","avg3_100","But you and Nazuna fought so flawlessly together.==W== I don't think that's possible if you really dislike her.",1,""],["w",0.5],["mrt",0,"y","003",null,null],["goon"],["mrt",0,"z","022",null,null],["say","avg3_100","I don't pay much attention to what people say. I care more about what they do.",1,""],["mrt",3,"z",null,null,null],["w",0.51],["ctl","avg1_103","a",null,null,null,null,null,null,null,"Linear",0.0],["hide","avg1_103",0],["bg","story_main_03_011",0,0.4],["w",0.4],["say","avg1_133","==PLAYER_NAME==. Please, no more questions.",9,""],["w",0.3],["mrt",1,"y","020","speechless",null],["say","avg3_100","Keeping something like that to yourself must be agonizing.",1,""],["mrt",0,"y","012","question",null],["say","avg3_100","Doesn't it ... hurt?",1,""],["mrt",3,"z",null,null,null],["w",0.51],["bg","story_main_03_011_c",0,0.6],["w",0.6],["say","avg1_133","...?!",9,""],["bg","story_main_03_011_h",0,0.4],["w",0.4],["say","avg1_133","This ... has nothing to do with you.",9,""],["w",0.3],["mrt",1,"z","002",null,null],["say","avg3_100","You're right, it doesn't.==W== After all, I'm just a stone statue with Boss's face now.",1,""],["w",0.5],["mrt",0,"z","014","music",null],["goon"],["mrt",3,"z",null,null,null],["w",0.51],["bg","story_main_03_011_f",0,0.0],["say","avg1_133","\"A stone statue with Boss's face\"...==W== Pfft. What a weird way to put it.",9,""],["w",0.5],["bg","story_main_03_011_e",0,0.4],["w",0.4],["goon"],["w",0.4],["mrt",1,"z","003",null,null],["say","avg3_100","Exactly. I'm just a statue.==W== Your secret's safe with me. I won't tell anyone.",1,""],["w",0.6],["mrt",0,"z","022",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.51],["bg","story_main_03_011_f",0,0.45],["w",0.45],["say","avg1_133","\"The One-Armed Saint statue with Boss's face\"... You know, that does make you a fitting confidant.",9,""],["w",0.3],["bgm",""],["bg","story_main_03_011_e",0,0.45],["w",0.45],["say","avg1_133","Fine. If you really want to know... Here it goes.",9,""],["w",0.3],["show","avg1_103","a","002",0.583,-0.38,1.5,0,"speechless",0.0],["bg","story_main_03_011_b",0,0.45],["w",0.45],["say","avg1_133","Two months ago, I was covering the expedition party's retreat. And I saw something I was never meant to see.",9,""],["ctl","avg1_103","a",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.3],["end"]]}