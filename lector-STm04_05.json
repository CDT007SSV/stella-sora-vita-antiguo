Pluvia Month 28th, Outside Philae, Trekker Camp"],["mrt",2,"y","020","think",null],["say","avg3_100","It's starting to rain.==W== Good thing I bought an umbrella.",2,""],["w",0.7],["mrt",0,"y","011","star","jushou"],["goon"],["mrt",0,"y","002","attention",null],["say","avg3_100","Noya and the others are finally clear of those illusions. I should get back and figure out what's next.",2,""],["mrt",3,"z",null,null,null],["w",0.5],["stg",0,130.0,null,1.1,"OutSine",0.6,null,null,null],["w",0.3],["se","se_062"],["show","avg1_133","a","015",0.36,-0.1,1.17,0,null,0.0],["ctl","avg1_133","a",null,null,0.3,null,null,1.0,null,"OutSine",0.55],["w",0.85],["clear",1,0.45,1],["stg",0,-90.0,null,1.05,"OutSine",0.6,null,null,null],["w",0.4],["mrt",2,"y","020","question",null],["say","avg3_100","Is that ... Nazuka?==W== She doesn't have an umbrella. I should go help.==W== Getting sick out here in the rain would be awful.",2,""],["w",0.5],["mrt",0,"y","003",null,null],["goon"],["w",0.5],["mrt",0,"y","002","idea","jushou"],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["se","se_062"],["stg",0,90.0,null,1.1,"OutBack",0.9,null,null,null],["w",0.8],["mrt",2,"z","013","happy",null],["say","avg3_100","Naz—==W==",1,""],["w",0.5],["mrt",0,"z","007","symbol","jushou"],["goon"],["mrt",4,"z",null,null,null],["w",0.51],["se","se_148"],["stg",0,150.0,null,null,"OutCubic",0.8,null,null,null],["trn",0,0,true,true,0.85],["w",0.85],["se","se_195_stop"],["bg","forest_camp_rain",0,0.0],["cbg",0,90.0,null,1.05,"Linear",0.0,null,null,null],["stg",0,-70.0,null,1.1,"Linear",0.0,null,null,null],["trn",1,0,false,true,0.85],["stg",0,0.0,null,null,"Linear",0.85,null,null,null],["w",0.3],["show","avg1_133","a","015",0.65,-0.12,1.2,0,null,0.0],["ctl","avg1_133","a",null,null,null,null,null,1.0,null,"OutSine",0.4],["w",0.15],["se","se_062"],["show","avg3_135","a","004",0.29,-0.12,1.2,0,null,0.0],["ctl","avg3_135","a",null,null,0.35,null,null,1.0,null,"OutSine",0.55],["w",0.55],["bgm","m42"],["say","avg3_135","You're here.",0,""],["w",0.5],["ctl","avg1_133","a","024",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","You insisted we meet right away.==W== What's so urgent?",0,""],["w",0.5],["ctl","avg1_133","a","010","question",null,null,null,null,null,"OutSine",0.3],["w",0.3],["goon"],["ctl","avg3_135","a","005","attention",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg3_135","Just wanted to confirm with you. On the next raid against the Garden of Parasite, we must secure \"that thing.\"",0,""],["ctl","avg1_133","a","015","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_133","Why the sudden rush? Don't tell me...",0,""],["ctl","avg1_133","a",null,null,null,null,null,null,null,"OutSine",0.3],["ctl","avg3_135","a","011","angry",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg3_135","You got it. Lady Gray just stopped by to press the issue. She also said ... \"that thing\" is hidden inside its trunk.",0,""],["ctl","avg3_135","a",null,null,null,null,null,null,null,"OutSine",0.3],["ctl","avg1_133","a","007","question",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","The trunk? And how do you plan to get it? Our raid failed just today.",0,""],["ctl","avg3_135","a","006","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg3_135","Well... Why not just capture it alive and take our sweet time? C'mon, we managed to bag the Blade of Jade. How hard can this thing be?",0,""],["ctl","avg3_135","a",null,null,null,null,null,null,null,"OutSine",0.3],["ctl","avg1_133","a","020","symbol",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","avg1_133","Capture it alive? That's far too risky. You've seen it yourself—the Garden of Parasite gets stronger by the day. We're not powerful enough yet to capture it live.",0,""],["w",0.5],["ctl","avg3_135","a","008","vexation",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg3_135","But we're in deep trouble if we don't get \"that thing.\" Have you forgotten how Lady Gray threatened us?",0,""],["ctl","avg1_133","a","024",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","I remember.==W== So, what's the plan?",0,""],["w",0.5],["ctl","avg1_133","a","019","question",null,null,null,null,null,"OutSine",0.3],["w",0.3],["goon"],["w",0.35],["clear",1,0.4,1],["stg",0,70.0,null,null,"Linear",0.7,null,null,null],["w",0.41],["bg","forest_camp_rain",0,0.7],["cbg",0,0.0,null,1.05,"Linear",0.0,null,null,null],["show","avg3_135","a","002",0.48,-0.09,1.15,0,null,0.0],["ctl","avg3_135","a",null,"attention",null,null,null,1.0,null,"OutSine",0.45],["w",0.45],["say","avg3_135","The magic mist is the real problem.==W== Once we deplete that, the Garden of Parasite is just a clumsy monster swinging its branches around.",0,""],["w",0.5],["ctl","avg3_135","a","003",null,null,null,null,null,null,"OutSine",0.3],["show","avg2_976","a","002",0.37,-0.09,1.15,0,null,0.0],["ctl","avg2_976","a",null,null,null,null,null,0.7,null,"OutSine",0.8],["ctl","avg2_976","a",null,null,0.27,null,null,null,null,"OutSine",2.0],["w",0.8],["goon"],["w",0.5],["chd",0,2,"avg1_133","a","002","question"],["w",0.3],["say","avg1_133","How do we deplete it?",0,""],["chd",1,2,"avg1_133","a","002",null],["w",0.35],["show","avg2_982","a","004",0.6,-0.03,1.05,0,null,0.0],["ctl","avg2_982","a",null,null,0.7,null,null,0.8,null,"OutSine",1.0],["ctl","avg3_135","a","005","attention",null,null,null,null,null,"OutSine",0.35],["w",0.35],["bgm",""],["say","avg3_135","With people. We'll have the squad members charge in first.",0,""],["w",0.35],["ctl","avg2_982","a",null,null,null,null,null,0.0,null,"OutSine",0.5],["hide","avg2_982",0.5],["ctl","avg2_976","a",null,null,null,null,null,0.0,null,"OutSine",0.5],["hide","avg2_976",0.5],["stg",0,-240.0,null,1.15,"OutSine",0.7,null,null,null],["w",0.35],["show","avg1_133","a","020",0.82,-0.09,1.15,0,null,0.0],["ctl","avg1_133","a",null,"symbol",0.75,null,null,1.0,null,"OutQuad",0.5],["w",0.5],["say","avg1_133","Are you insane? Claire, you know as well as I do that you'd be sending them to their deaths.",0,""],["bgm","m46"],["ctl","avg3_135","a","003","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg3_135","They'll just be inhaling some mist.==W== That's not fatal ... right?",0,""],["w",0.5],["ctl","avg3_135","a","002",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["goon"],["w",0.5],["ctl","avg1_133","a","013","vexation",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg1_133","If they start hallucinating, they'll turn on each other. The result is exactly the same.",0,""],["ctl","avg1_133","a","016","sigh",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","Besides, the Garden of Parasite is already too powerful.==W== A monster this dangerous... Claire, we have to destroy it ourselves on the next hunt.",0,""],["w",0.5],["ctl","avg1_133","a","023",null,null,null,null,null,null,"OutSine",0.3],["w",0.3],["goon"],["ctl","avg1_133","a","005","speechless",null,null,null,null,null,"Linear",0.0],["say","avg1_133","I haven't touched the 10 million Dorra from Lady Gray. After we deal with the Garden of Parasite, I'm returning it. That way, our business with United Harvest is concluded.",0,""],["ctl","avg1_133","a",null,null,null,null,null,null,null,"OutSine",0.3],["ctl","avg3_135","a","008","angry",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg3_135","You think they'll just let us go once we're \"even\"?==W== Hah, that's so naive.==W== After everything we've seen, you really think we can just walk away?==W== United Harvest will never drop this.",0,""],["w",0.5],["ctl","avg3_135","a",null,null,null,null,null,null,null,"OutSine",0.3],["goon"],["w",0.5],["ctl","avg3_135","a","011",null,null,null,null,null,null,"OutSine",0.3],["w",0.3],["goon"],["w",0.5],["se","se_070"],["stg",0,null,null,null,"Linear",0.0,null,null,"Zhong"],["tsk","Xiao"],["ctl","avg1_133","a",null,null,0.82,null,null,0.0,null,"OutSine",0.45],["hide","avg1_133",0.45],["ctl","avg3_135","a","012",null,0.62,-0.27,1.4,null,null,"OutSine",0.45],["w",0.45],["goon"],["w",0.35],["cbg",0,90.0,null,null,"OutSine",0.5,null,null,null],["ctl","avg3_135","a",null,null,0.52,null,null,0.0,null,"OutSine",0.45],["hide","avg3_135",0.45],["show","avg1_133","a","021",0.72,-0.27,1.4,0,null,0.0],["ctl","avg1_133","a",null,"exclamation",0.625,null,null,1.0,null,"OutQuad",0.45],["w",0.45],["say","avg1_133","You're the naive one, Claire!",0,""],["ctl","avg1_133","a","028","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","Think about it. \"That thing\" can twist a mimic vine into the monstrosity we're facing. United Harvest would do anything to keep their rivals from finding out they have something that powerful.",0,""],["ctl","avg1_133","a",null,null,null,null,null,null,null,"OutSine",0.3],["ctl","avg1_133","a","026",null,null,null,null,null,null,"OutSine",0.4],["w",0.4],["say","avg1_133","So, the moment Lady Gray gets her hands on it, she'll have us eliminated.",0,""],["ctl","avg1_133","a","015",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","But, if \"that thing\" is destroyed in the fight—if no one gets it and we can plausibly deny knowing what it was—United Harvest might just leave us alone.",0,""],["w",0.35],["clear",1,0.4,1],["stg",0,-80.0,null,null,"Linear",0.7,null,null,null],["w",0.41],["bg","forest_camp_rain",0,0.7],["cbg",0,70.0,null,1.05,"Linear",0.0,null,null,null],["show","avg1_133","a","015",0.71,-0.09,1.16,0,null,0.0],["ctl","avg1_133","a",null,null,null,null,null,1.0,null,"OutSine",0.45],["show","avg3_135","a","006",0.38,-0.09,1.15,0,null,0.0],["ctl","avg3_135","a",null,"symbol",null,null,null,1.0,"jushou","OutSine",0.45],["w",0.45],["say","avg3_135","No way, Nazuka, this is United Harvest! We failed them. There's no way they won't retaliate.",0,""],["ctl","avg1_133","a","016","sigh",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","There is! The Big Three have been on a rampage for months, and our hunting squad has been making headlines—not just in Philae, but in other cities too.",0,""],["ctl","avg1_133","a","019","attention",null,null,null,null,null,"Linear",0.5],["say","avg1_133","We're not just some unknown Trekkers anymore; we're in the public eye now.",0,""],["ctl","avg1_133","a","010",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","That means even a company like United Harvest can't take us out quietly. As long as we stay in the dark about what \"that thing\" really is, a peaceful way out of this isn't impossible.",0,""],["w",0.35],["ctl","avg3_135","a","007","speechless",null,null,null,null,null,"OutSine",0.5],["w",1.7],["ctl","avg3_135","a","004",null,null,null,null,null,null,"OutSine",0.3],["w",0.3],["say","avg3_135","So that's your angle... You've always hated the spotlight, but lately you've been actively seeking it out.",0,""],["w",0.5],["ctl","avg3_135","a","006","sweaty",null,null,null,null,"lengzhan","Linear",0.35],["w",0.35],["say","avg3_135","But what if they don't care? What if they decide to punish us for botching the job and coming back empty-handed anyway?",0,""],["ctl","avg1_133","a","027","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","If it comes to that... Just say it was all my idea.==W== Act like you knew nothing. I'll take the fall for everything.",0,""],["w",0.7],["ctl","avg1_133","a","012",null,null,null,null,null,null,"OutSine",0.3],["w",0.3],["bgm",""],["goon"],["ctl","avg3_135","a","003","happy",null,null,null,null,"daintou","Linear",0.35],["w",0.35],["say","avg3_135","Hah. How noble, Nazuka. Turning on Petal Bloom to protect your friends, taking all the blame to shield the team... You've even got an out for me all planned.",0,""],["ctl","avg3_135","a","002",null,null,null,null,null,null,"Linear",0.35],["w",0.35],["say","avg3_135","Just like the One-Armed Saint from the legends... Sacrificing herself to save Philae.",0,""],["w",0.5],["ctl","avg1_133","a","016","sigh",null,null,null,null,null,"OutSine",0.35],["say","avg1_133","It's not that dramatic. I just want to keep everyone safe.",0,""],["w",0.35],["ctl","avg3_135","a","003","music",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","avg3_135","Hmph. Heheheh.==W== Hahahaha!",0,""],["w",0.5],["ctl","avg1_133","a",null,null,0.78,null,null,0.0,null,"OutSine",0.5],["hide","avg1_133",0.5],["ctl","avg3_135","a","010","happy",0.54,-0.22,1.35,null,"daintou","OutSine",0.6],["w",0.6],["goon"],["chd",0,2,"avg1_133","a","020","symbol"],["w",0.35],["say","avg1_133","Claire, what's gotten into you?",0,""],["chd",1,2,"avg1_133","a","002",null],["w",0.35],["ctl","avg3_135","a","011","vexation",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg3_135","Surviving by not seeing \"that thing\"... Why didn't I think of that sooner? I guess I'm just not cut out for these clever games like you are.",0,""],["ctl","avg3_135","a","012","angry",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg3_135","I can't keep up with all the scheming, and I don't wanna die. So I've already signed a magic contract with Lady Gray.",0,""],["bgm","m11"],["ctl","avg3_135","a",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.35],["trn",0,0,true,true,0.65],["w",0.65],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["bg","forest_camp_rain",0,0.0],["cbg",0,0.0,null,1.05,"Linear",0.0,null,null,null],["trn",1,0,false,false,0.65],["show","avg3_135","a","012",0.32,-0.14,1.23,0,null,0.0],["ctl","avg3_135","a",null,null,null,null,null,1.0,null,"OutSine",0.45],["show","avg1_133","a","020",0.82,-0.14,1.23,0,null,0.0],["ctl","avg1_133","a",null,"flurry",0.7,null,null,1.0,"daintou","OutSine",0.55],["w",0.55],["say","avg1_133","A contract? What kind of contract?",0,""],["w",0.5],["ctl","avg3_135","a","011","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg3_135","It says as long as I follow Lady Gray's orders to the letter and search for \"that thing\"...",0,""],["ctl","avg3_135","a",null,null,null,null,null,null,null,"OutSine",0.3],["ctl","avg3_135","a","008","exclamation",null,null,null,null,"jushou","OutSine",0.34],["w",0.34],["say","avg3_135","United Harvest will give me a fortune and a cushy job where I can earn Dorra for life, regardless of the outcome.",0,""],["ctl","avg1_133","a","020","awkward",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg1_133","How could you trust someone like Lady Gray? This is United Harvest we're talking about. There's bound to be a trap or a loophole in that contract.",0,""],["ctl","avg3_135","a","006","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg3_135","Yeah ... maybe. That's why I need your help.",0,""],["ctl","avg3_135","a",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.35],["ctl","avg1_133","a","004","question",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","Help you?",0,""],["w",0.35],["ctl","avg3_135","a","005","idea",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","avg3_135","That's right. I told Lady Gray there's no way I can take down the Garden of Parasite alone. But with you, I know we can find a way.",0,""],["ctl","avg3_135","a","004","speechless",null,null,null,null,null,"Linear",0.35],["w",0.35],["say","avg3_135","They know how strong you are, of course. Lady Gray said if you join United Harvest and work for her, she'll let you draft the contract.",0,""],["ctl","avg3_135","a",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.35],["ctl","avg3_135","a","008",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg3_135","See? You're the key to this whole deal.",0,""],["ctl","avg1_133","a","003",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","So she just wants to use us as pawns.==W== That plan to have the squad members wear down the mist... That was her idea, wasn't it?",0,""],["w",0.5],["ctl","avg1_133","a","015","shock",null,null,null,null,null,"OutSine",0.3],["w",0.3],["goon"],["ctl","avg1_133","a",null,null,null,null,null,null,null,"Linear",0.3],["ctl","avg3_135","a","011","vexation",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg3_135","You figure everything out, don't you, Nazuka? But I'm not like you. I'm out of options.",0,""],["ctl","avg1_133","a","019","exclamation",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","avg1_133","Claire, don't do this. Let me think. There has to be another way.",0,""],["ctl","avg3_135","a","010","question",null,null,null,null,null,"Linear",0.35],["w",0.35],["say","avg3_135","Oh? Is the great Saint gonna swoop in and solve all my problems?",0,""],["w",0.35],["clear",1,0.4,1],["stg",0,70.0,null,null,"Linear",0.7,null,null,null],["w",0.41],["bgm",""],["bg","forest_camp_rain",0,0.7],["cbg",0,70.0,null,1.05,"Linear",0.0,null,null,null],["show","avg3_135","a","011",0.48,-0.21,1.35,0,null,0.0],["ctl","avg3_135","a",null,"speechless",null,null,null,1.0,null,"OutSine",0.35],["w",0.35],["say","avg3_135","It's impossible. I don't know how you see it, but to me, the gap between us and United Harvest is like a single raindrop against a sky full of storm clouds.",0,""],["ctl","avg3_135","a",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.35],["stg",0,null,-70.0,null,"Linear",2.0,null,null,null],["w",0.3],["clear",1,0.4,1],["w",0.5],["se","se_149"],["bg","sky_rain",0,1.0],["cbg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["say","avg3_135","If you're really so amazing, why don't you just blow away the clouds above us and make this rain stop?!",0,""],["w",0.35],["bg","BG_Black",5,0.0],["show","avg3_135","a","005",0.56,-0.285,1.7,5,null,null],["ctl","avg3_135","a",null,null,null,null,null,0.0,null,"Linear",0.0],["ctl","avg3_135","a",null,null,0.5,null,null,1.0,null,"OutSine",0.6],["stage",5,0,0],["say","avg3_135","Just like the legendary One-Armed Saint!",0,""],["w",0.35],["stage",5,1,17],["stg",0,null,0.0,null,"Linear",1.0,null,null,null],["w",1.0],["trn",0,0,true,true,0.1],["w",0.1],["stg",0,90.0,0.0,1.05,"Linear",0.0,null,null,null],["bg","forest_camp_rain",0,0.0],["cbg",0,-200.0,0.0,1.2,"Linear",0.0,null,null,null],["fx",0,"fx_avg_rain_2",0,1],["trn",1,0,false,false,1.0],["film",0],["cbg",0,0.0,null,1.15,"OutSine",1.0,null,null,null],["se","se_101"],["show","avg3_135","a","005",0.57,-0.3,1.8,0,null,0.0],["ctl","avg3_135","a",null,null,null,null,null,1.0,null,"OutSine",0.5],["ctl","avg3_135","a",null,null,0.45,-0.37,1.9,null,null,"OutSine",1.0],["w",1.0],["say","avg3_135","... That's all I have to say.",3,""],["w",0.3],["say","avg3_135","Goodbye, Nazuka. In the end, we were never on the same path.",3,""],["w",0.5],["clear",0,0,1],["w",0.32],["se","se_102"],["w",0.3],["film",1],["stg",0,-180.0,null,1.1,"OutSine",1.75,null,null,null],["ctl","avg3_135","a",null,null,0.33,-0.43,2.0,0.0,null,"OutSine",1.5],["hide","avg3_135",1.5],["w",1.4],["show","avg1_133","c","015",0.67,-0.175,1.3,0,null,0.0],["ctl","avg1_133","c",null,null,null,null,null,1.0,null,"OutSine",0.6],["ctl","avg1_133","c",null,null,0.61,-0.22,1.37,null,null,"OutSine",1.3],["w",1.0],["ctl","avg1_133","c","011","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","...",0,""],["w",0.5],["ctl","avg1_133","c",null,null,null,null,null,null,null,"OutSine",0.3],["clear",0,0,1],["w",0.35],["se","se_101"],["stg",0,-200.0,-30.0,1.18,"OutSine",0.7,null,null,null],["w",1.0],["se","se_101"],["stg",0,-215.0,-60.0,1.25,"OutSine",0.7,null,null,null],["w",1.1],["mrt",2,"z","012",null,null],["say","avg3_100","Nazuka...",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","c","024","sigh",null,null,null,null,null,"OutSine",0.35],["w",0.35],["se","se_149_stop"],["say","avg1_133","==PLAYER_NAME==... You heard all that...",0,""],["w",0.35],["se","se_076"],["trn",0,3,true,true,1.0],["w",1.0],["bg","uniseed_greenhouse_outside",0,0.0],["fx",0,"fx_avg_rain_2",1,1],["stg",0,0.0,0.0,1.1,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["w",0.5],["trn",1,3,false,false,1.2],["w",0.7],["head","15:00, Pluvia Month 28th, Greenhouse District in Philae"],["bgm","m57"],["mrt",2,"y","002","question",null],["say","avg3_100","So this is where you first met Lady Gray?",1,""],["mrt",3,"y",null,null,null],["w",0.5],["se","se_062"],["show","avg1_133","a","002",0.59,-0.19,1.32,0,null,0.0],["ctl","avg1_133","a",null,null,0.53,null,null,1.0,null,"OutSine",0.55],["w",0.55],["say","avg1_133","Yeah. She was in a United Harvest uniform, looked like she held a high rank. And all the supplies she gave us later came directly from them.",0,""],["w",0.5],["mrt",1,"y","020","speechless",null],["say","avg3_100","United Harvest... They're in the grain and food industry, right?",1,""],["mrt",3,"y",null,null,null],["w",0.5],["se","se_077"],["ctl","avg1_133","a","003",null,null,-0.24,null,null,null,"OutSine",0.4],["w",0.4],["ctl","avg1_133","a","015",null,null,-0.19,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","That's right. They're the biggest company in this industry in Nova. I heard they grow seventy percent of all the grain on the continent.",0,""],["w",0.3],["cbg",0,-90.0,null,null,"Linear",1.2,null,null,null],["ctl","avg1_133","a",null,null,0.65,null,null,null,null,"OutSine",1.2],["w",0.4],["film",0],["ctl","avg1_133","a",null,null,null,null,null,0.0,null,"OutSine",0.8],["hide","avg1_133",0.8],["w",0.4],["bg","uniseed_business",0,0.8],["cbg",0,-90.0,null,1.05,"Linear",0.0,null,null,null],["cbg",0,0.0,null,null,"Linear",4.0,null,null,null],["w",0.6],["say","avg1_133","They have branches in every city.",3,""],["w",0.5],["clear",0,0,1],["w",0.3],["bg","uniseed_greenhouse_inside",0,0.8],["cbg",0,-90.0,null,1.05,"Linear",0.0,null,null,null],["cbg",0,0.0,null,null,"Linear",4.0,null,null,null],["w",0.6],["say","avg1_133","Word is that the one here in Philae is their largest.",3,""],["w",0.5],["clear",0,0,1],["w",0.35],["film",1],["stg",0,null,null,1.0,"OutSine",1.0,null,null,null],["bg","uniseed_greenhouse_outside",0,1.0],["cbg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["w",0.2],["show","avg1_133","a","010",0.52,-0.09,1.15,0,null,0.0],["ctl","avg1_133","a",null,null,null,null,null,1.0,null,"OutSine",0.45],["ctl","avg1_133","a",null,null,null,-0.19,1.32,1.0,null,"OutSine",0.85],["w",0.85],["mrt",1,"y","020","question",null],["say","avg3_100","Philae's climate and environment... I'm guessing it's ideal for growing crops?",1,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_133","a","003","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","That, and the influence from the Monolith in the lake.==W== Its wishing boxes are known to produce Artifacts useful for farming.",0,""],["w",0.5],["ctl","avg1_133","a",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.1],["ctl","avg1_133","a","002",null,null,null,null,null,null,"OutSine",0.3],["w",0.3],["goon"],["w",0.35],["mrt",1,"y","009",null,null],["say","avg3_100","Hearing you put it that way, United Harvest is a true company giant. It does sound like we're a single raindrop and they're a storm cloud.",1,""],["mrt",0,"y","012","question",null],["say","avg3_100","So what's your plan?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","a","028","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","I don't trust Lady Gray.",0,""],["ctl","avg1_133","a",null,null,null,null,null,null,null,"OutSine",0.3],["ctl","avg1_133","a","016","sigh",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","Since she's trying to use Claire for some kind of scheme... I'm going to split from the hunting squad for now.",0,""],["ctl","avg1_133","a","019","exclamation",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","avg1_133","I'll take down the Garden of Parasite before Claire can... End this myself.",0,""],["w",0.35],["mrt",1,"y","020","question",null],["say","avg3_100","Brute force over strategy, huh? Not a bad idea, but ... isn't that a huge risk?",1,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_133","a","024","vexation",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg1_133","It is. This weather makes it impossible to use fire against the Garden of Parasite... And with Philae's rainy season here, there's no telling when the sun will be out again.",0,""],["ctl","avg1_133","a","012","idea",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","avg1_133","The silver lining is that monsters usually lie low in weather like this, and the main force can't push deep into the forest. So, it's not all bad.",0,""],["w",0.5],["ctl","avg1_133","a","028","sigh",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg1_133","If only I could work a miracle like the One-Armed Saint.",0,""],["bgm",""],["w",0.35],["mrt",2,"z","002","attention",null],["say","avg3_100","I keep hearing about the One-Armed Saint. What's the story there?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["stg",0,null,-100.0,null,"Linear",3.0,null,null,null],["w",0.5],["ctl","avg1_133","a",null,null,null,null,null,0.0,null,"OutSine",0.8],["hide","avg1_133",0.8],["w",0.5],["film",0],["w",0.1],["fx",0,"fx_avg_reminiscence_loop",0,0],["bg","uniseed_auditorium",0,0.9],["cbg",0,-100.0,100.0,1.05,"Linear",0.0,null,null,null],["w",0.4],["bgm","m27"],["say","avg1_133","It's a local Philaen legend.",3,""],["w",0.5],["clear",0,0,1],["w",0.35],["bg","city_street_water",0,0.9],["w",0.8],["say","avg1_133","Years ago, a one-armed statue was unearthed here.",3,""],["w",0.3],["say","avg1_133","The plaque on its base had the faded word \"Saint\"...",3,""],["w",0.35],["bg","BG_Black",0,1.0],["w",0.9],["say","avg1_133","... and a nearby stone slab told her story.",3,""],["w",0.5],["clear",0,0,1],["w",0.35],["bg","sky_rain",0,0.8],["cbg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["show","avg1_133","a","003",0.8,-0.34,1.6,0,null,0.0],["ctl","avg1_133","a",null,null,null,null,null,0.7,null,"Linear",0.8],["ctl","avg1_133","a",null,null,null,-0.3,null,null,null,"OutBack",1.0],["w",0.8],["say","avg1_133","Long, long ago, the people of Philae angered the god of swamps.",3,""],["w",0.6],["clear",0,0,1],["w",0.35],["bg","city_street_water_rain",0,0.8],["cbg",0,0.0,100.0,1.05,"Linear",0.0,null,null,null],["ctl","avg1_133","a","019",null,null,null,null,null,null,"OutSine",0.3],["w",0.5],["say","avg1_133","In its fury, the god cursed the land with endless rains, threatening to drown the city.",3,""],["w",0.6],["clear",0,0,1],["w",0.35],["trn",0,0,false,false,0.8],["w",0.8],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["bg","story_main_01_023_a",0,0.0],["fx",0,"fx_avg_star_lp",0,0],["ctl","avg1_133","a","016",null,0.82,-0.4,null,null,null,"OutSine",0.35],["w",0.35],["trn",1,0,false,false,0.8],["say","avg1_133","People begged the god to stop, but it demanded the most beautiful thing in the city as an offering.",3,""],["w",0.35],["ctl","avg1_133","a","028",null,null,null,null,null,null,"OutSine",0.5],["say","avg1_133","They offered countless treasures, yet the god remained unmoved.",3,""],["w",0.5],["clear",0,0,1],["w",0.35],["ctl","avg1_133","a","027",null,null,null,null,null,null,"OutSine",0.3],["w",0.3],["say","avg1_133","It was not until one day, a passing Trekker offered her own arm and hand—",3,""],["w",0.5],["clear",0,0,1],["w",0.3],["trn",0,0,true,true,1.0],["w",1.0],["fx",0,"fx_avg_star_lp",1,0],["stg",0,null,0.0,1.1,"Linear",0.0,null,null,null],["bg","BG_Black",0,0.0],["trn",1,0,true,true,0.8],["bgm",""],["say","0","—nimble hands capable of forging anything, that the divine silence finally broke.",8,""],["w",0.5],["clear",0,0,1],["se","se_195"],["w",0.35],["stg",0,null,-100.0,null,"OutSine",5.0,null,null,null],["bg","sky_rain",0,2.0],["w",2.2],["se","se_195_stop"],["film",1],["bg","sky_sunny",0,2.0],["fx",0,"fx_avg_sunlight",0,0],["w",0.3],["se","se_302"],["w",2.2],["say","avg1_133","The god was pleased. It stopped the rains, and the floodwaters formed a great lake with fertile shores. From then on, the people of Philae lived in prosperity.",0,""],["w",0.5],["clear",0,0,1],["w",0.35],["stg",0,null,0.0,null,"OutSine",2.25,null,null,null],["w",0.8],["fx",0,"fx_avg_reminiscence_loop",1,0],["bg","uniseed_greenhouse_outside",0,1.0],["cbg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["w",0.4],["show","avg1_133","a","004",0.53,-0.19,1.3,0,null,0.0],["ctl","avg1_133","a",null,null,null,null,null,1.0,null,"OutSine",0.7],["w",0.3],["ctl","avg1_133","a",null,"attention",null,null,null,null,null,"OutSine",0.4],["w",0.4],["say","avg1_133","So, that's the end of the legend. What'd you think, Boss?",0,""],["w",0.5],["se","se_302_stop"],["mrt",1,"y","021","think",null],["say","avg3_100","Hmm... On the surface, it's a nice story ... but something about it feels a little creepy.",2,""],["mrt",3,"y",null,null,null],["w",0.5],["choice",["Admire the Saint's courage","Question the facts","Suggest another theory"],[[["w",0.1],["bgm","m77"],["mrt",1,"y","020","speechless",null],["say","avg3_100","I think the legend might've romanticized it.",1,""],["mrt",0,"y","003",null,null],["say","avg3_100","Maybe the saint didn't just give up—maybe she fought the god, and won, though at the cost of her arm. That's why the flood stopped.",1,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_133","a","003",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","That's possible...==W== But if so, it wasn't a god. It was a demon.",0,""],["ctl","avg1_133","a","028","speechless",null,null,null,null,null,"OutSine",0.3],["w",0.3],["goon"],["ctl","avg1_133","a",null,null,null,null,null,null,null,"Linear",0.3],["w",0.35],["mrt",1,"y","021","sweaty","lengzhan"],["say","avg3_100","A \"god\" that casually throws a fit doesn't sound like any normal god I know.",1,""],["mrt",3,"y",null,null,null],["w",0.35]],[["w",0.1],["bgm","m77"],["mrt",2,"y","020","exclamation",null],["say","avg3_100","And in the end, it's just a statue with only one arm, right? It could've just broken off.==W== As for the storm, it was probably just a natural disaster.",1,""],["w",0.5],["mrt",0,"y","003",null,null],["goon"],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_133","a","020","sweaty",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg1_133","Ha, so pragmatic. You really have a knack for looking at things from a purely realistic angle, Boss.",0,""],["w",0.35],["mrt",1,"z","002",null,null],["say","avg3_100","I mean, it's rare for an artifact dug up from the ground to be in perfect condition, isn't it?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","a","027","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","That's a fair point.==W== I hope the truth is just like you said—that no one got hurt, and everyone just lived happily ever after.",0,""],["w",0.6],["ctl","avg1_133","a",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.3],["ctl","avg1_133","a","012",null,null,null,null,null,null,"OutSine",0.3],["w",0.3],["goon"],["w",0.35]],[["w",0.1],["bgm","m77"],["mrt",1,"y","020","speechless",null],["say","avg3_100","Hmm... I think \"offering her arm and hand\" was symbolic.",1,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_133","a","020","symbol",null,null,null,null,"jushou","Linear",0.35],["w",0.35],["say","avg1_133","Symbolic?!",0,""],["w",0.35],["mrt",1,"z","003",null,null],["say","avg3_100","Water doesn't just drain on its own. You need hands to dig canals and build levees to actually control a flood.",1,""],["mrt",0,"y","012","attention",null],["say","avg3_100","Maybe the people of Philae put up the statue to commemorate the person who led them in taming the waters.",1,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_133","a","027","sigh",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","Huh... That's a really practical way of looking at it, Boss.",0,""],["w",0.35]]]],["w",0.1],["trn",0,0,true,true,1.0],["w",1.0],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["show","avg1_133","a","027",0.53,-0.19,1.3,0,null,null],["trn",1,0,false,false,1.0],["w",0.8],["ctl","avg1_133","a",null,null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","Still, what I admire about the One-Armed Saint is her courage to make that sacrifice.",0,""],["ctl","avg1_133","a","012","attention",null,null,null,null,null,"Linear",0.35],["w",0.35],["say","avg1_133","I'm a Trekker, and my time making wishes in the Monolith has taught me one thing.",0,""],["ctl","avg1_133","a","019","exclamation",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","avg1_133","If you want to gain something, you have to give something up first. Decisively.",0,""],["ctl","avg1_133","a","028","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","I want to be that kind of decisive person—someone who can clear the path for everyone else.",0,""],["ctl","avg1_133","a",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.35],["bgm",""],["mrt",2,"z","002","idea",null],["say","avg3_100","I get it.==W== Well... Since you once saw me as a figure like the One-Armed Saint...",1,""],["w",0.5],["mrt",0,"y","003",null,null],["goon"],["mrt",3,"y",null,null,null],["w",0.51],["ctl","avg1_133","a",null,null,null,null,null,0.0,null,"Linear",0.45],["hide","avg1_133",0.45],["film",0],["bg","BG_Black",5,0.0],["show","avg3_100","c","006",null,-0.3,1.85,5,null,null],["w",0.3],["stage",5,0,0],["say","1","On a day like today, when we can't even use fire, let me clear the path a different way.",3,""],["w",0.5],["clear",0,0,1],["stage",5,1,1],["w",0.35],["film",1],["ctl","avg3_100","a",null,null,null,null,null,null,null,"Linear",0.1],["hide","avg3_100",0.1],["w",0.3],["show","avg1_133","a","002",0.53,-0.19,1.3,0,null,0.0],["ctl","avg1_133","a",null,null,null,null,null,1.0,null,"OutSine",0.5],["w",0.35],["mrt",2,"z","014","music",null],["say","avg3_100","As it happens, I have an idea about how we can investigate Lady Gray and the Three Grand Commissions.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["end"]]}