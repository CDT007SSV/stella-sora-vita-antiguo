,null,1.0,null,"Linear",0.5],["say","avg1_156","About time those idiots realized how stupid they were being, huh?",0,""],["w",0.5],["stg",0,0.0,null,null,"Linear",0.5,null,null,null],["show","avg3_132","a","008",0.65,null,null,0,null,0.0],["ctl","avg3_132","a",null,null,null,null,null,1.0,null,"Linear",0.5],["say","avg3_132","Everyone was ... really furious.",0,""],["w",0.5],["mrt",1,"z","009",null,null],["say","avg3_100","I can understand where they're coming from. After all, to them, we're the reason the first expedition failed.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["stg",0,-80.0,null,null,"Linear",1.0,null,null,null],["trn",0,0,true,false,0.5],["w",0.5],["trn",1,0,false,false,0.5],["w",0.5],["show","avg1_111","a","002",0.6,null,null,0,null,0.0],["se","se_074"],["ctl","avg1_111","a",null,null,0.55,null,null,1.0,null,"Linear",0.5],["say","avg1_111","Boss, the Trekkers who surrounded us have pulled back. They're running toward the camp.",0,""],["w",0.5],["ctl","avg1_111","a",null,null,null,null,null,0.0,null,"Linear",0.5],["stg",0,80.0,null,1.2,"Linear",0.5,null,null,null],["w",0.5],["show","avg1_156","a","020",0.4,null,null,0,null,0.0],["se","se_146"],["ctl","avg1_156","a",null,null,null,null,null,1.0,"chijing","Linear",0.5],["say","avg1_156","Dang it! They harass us, then just take off?==W== Fuyuka, Kaede, let's go get them!",0,""],["w",0.5],["ctl","avg1_156","a","017","resentful",null,null,null,null,"jushou2","Linear",0.5],["goon"],["se","se_099"],["ctl","avg1_156","a",null,null,0.0,null,null,0.0,null,"Linear",0.5],["w",0.3],["stg",0,120.0,null,null,"Linear",0.5,null,null,null],["w",1.0],["show","avg1_134","a","009",0.8,null,null,0,null,0.0],["stg",0,0.0,null,null,"Linear",0.5,null,null,null],["w",0.5],["ctl","avg1_134","a",null,"flurry",0.6,null,null,1.0,"jushou2","Linear",0.5],["say","avg1_134","R-Right!",0,""],["w",0.5],["bgm",""],["se","se_148"],["ctl","avg1_134","a",null,null,0.2,null,null,0.0,null,"Linear",0.5],["trn",0,0,true,false,0.5],["w",0.5],