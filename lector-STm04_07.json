ll,null,null,null,"Linear",0.5],["say","Withdrawn Trekker","Rumors? Nazuka admitted it herself! She said she's the one who got the whole squad wiped out.",0,""],["w",0.5],["mrt",2,"z","025","shock",null],["say","avg3_100","What did you just say?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_112"],["ctl","avg1_156","a","023",null,null,null,null,null,null,"OutSine",0.5],["tsk","Zhong"],["say","avg1_156","Wait, hold on...!==W== What exactly did Nazuka admit to?",0,""],["w",1.0],["ctl","avg3_132","a",null,null,null,null,null,0.0,null,"Linear",0.5],["stg",0,-150.0,-100.0,1.2,"Linear",0.5,null,null,null],["ctl","avg3_138","a",null,null,0.45,null,null,null,null,"Linear",0.5],["ctl","avg1_156","a","020","symbol",0.65,null,null,null,"jushou2","Linear",0.5],["goon"],["w",0.5],["ctl","avg3_138","a","008","awkward",null,null,null,null,"chijing","Linear",0.5],["say","Withdrawn Trekker","Didn't I just tell you? She—she confessed! Said she was the reason the first hunt was ruined! Just—just now, at the camp square! Now the whole place is in chaos!",0,""],["w",0.5],["trn",0,0,true,false,0.5],["w",0.5],["bg","traveller_camp_a_daylight",0,1.0],["w",1.0],["stg",0,100.0,null,1.1,"Linear",0.0,null,null,null],["trn",1,0,false,false,0.5],["w",0.5],["head","10:30, Tonitrua Month 3rd, Outside Philae, Trekker Camp"],["stg",0,0.0,null,null,"Linear",2.0,null,null,null],["w",1.0],["say","0","By the time we reach the camp, the place is in complete disarray.",0,""],["w",0.5],["show","avg1_112","a","008",0.3,null,null,0,null,0.0],["ctl","avg1_112","a",null,"speechless",null,null,null,1.0,null,"Linear",0.5],["say","avg1_112","Rocks, eggs, broken flagpoles... What happened here?",0,""],["w",0.5],["ctl","avg1_112","a",null,null,null,null,null,null,null,"Linear",0.0],["show","avg3_132","a","009",0.75,null,null,0,null,0.0],["ctl","avg3_132","a",null,"vexation",null,null,null,1.0,null,"Linear",0.5],["say","avg3_132","Nazuka... I hope she's alright.",0,""],["w",0.5],["trn",0,0,true,false,0.5],["w",0.5],["trn",1,0,false,false,0.5],["w",0.5],["stg",0,80.0,null,null,"Linear",0.5,null,null,null],["w",0.5],["show","avg1_111","a","007",0.6,null,null,0,null,0.0],["show","avg3_139","a","004",0.3,null,null,0,null,0.0],["ctl","avg3_139","a",null,null,null,null,null,1.0,null,"Linear",0.5],["ctl","avg1_111","a",null,"question",0.55,null,null,1.0,null,"Linear",0.5],["say","avg1_111","Excuse me, could you tell us what happened?",0,""],["w",0.5],["ctl","avg3_139","a","007","attention",null,null,null,null,null,"Linear",0.5],["say","Angry Trekker","What? Haven't you heard about the murderer?==W== Hmph. We must've been blind to ever call that monster a hero.",0,""],["w",0.5],["ctl","avg3_139","a","004","angry",null,null,null,null,"chijing","Linear",0.5],["goon"],["w",0.5],["ctl","avg3_139","a",null,null,null,null,null,null,null,"Linear",0.0],["stg",0,-60.0,null,null,"Linear",0.5,null,null,null],["show","avg1_103","a","003",0.8,null,null,0,null,0.0],["ctl","avg1_103","a",null,"speechless",0.75,null,null,1.0,null,"Linear",0.5],["w",0.5],["say","avg1_103","Monster ... hero ...==W== Nazuka?",0,""],["w",1.0],["ctl","avg1_103","a","002","question",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["stg",0,null,null,null,"Linear",1.0,null,null,"Zhong"],["ctl","avg3_139","a","004","resentful",null,null,null,null,null,"Linear",0.5],["say","Angry Trekker","Don't say her name. It makes me sick. She was only a \"hero\" because our sacrifices built her up. She climbed to the top by stepping on everyone else.",0,""],["ctl","avg3_139","a",null,null,null,null,null,null,"jushou2","Linear",0.5],["say","Angry Trekker","Leaving her own comrades to die just to hog the reward... How could anyone forgive that?",0,""],["w",0.5],["ctl","avg1_111","a",null,null,null,null,null,0.0,null,"Linear",0.3],["ctl","avg1_103","a",null,null,null,null,null,0.0,null,"Linear",0.3],["bgm",""],["ctl","avg3_139","a",null,null,0.5,null,null,null,null,"Linear",0.5],["w",0.5],["bg","mood_3",0,0.5],["ctl","avg3_139","a","003","happy",null,null,null,null,"chijing","Linear",0.5],["say","Angry Trekker","Heh... To think the new squad was just another tool for that scumbag to use... All my hard work feels like one big joke.",0,""],["w",0.5],["bg","traveller_camp_a_daylight",0,0.5],["show","avg1_156","a","002",0.8,0.0,1.0,0,null,0.0],["ctl","avg1_156","a",null,"music",0.7,null,null,1.0,null,"Linear",0.5],["say","avg1_156","Oh, I see. You're a complete and total idiot!",0,""],["w",0.5],["ctl","avg3_139","a","007","symbol",0.4,null,null,null,null,"Linear",0.5],["say","Angry Trekker","What did you just say?",0,""],["w",0.5],["bgm","m59"],["ctl","avg1_156","a","003",null,null,null,null,null,"niunie1","Linear",0.5],["say","avg1_156","Oh, my bad. I guess you're too dense to understand what people are saying.",0,""],["ctl","avg1_156","a","002","happy",null,null,null,null,"JuGong1","Linear",0.5],["say","avg1_156","I said you're an idiot! You've got a head on your shoulders but no idea how to use it!",0,""],["w",0.5],["se","se_062"],["ctl","avg1_156","a","011",null,0.6,null,null,null,null,"Linear",0.5],["w",0.5],["say","avg1_156","You're with the new squad, right? So think—has there ever been a single raid where Nazuka wasn't leading the charge?",0,""],["w",0.5],["ctl","avg3_139","a","008","speechless",0.35,null,null,null,null,"Linear",0.5],["say","Angry Trekker","S-She ...==W== she was only in it for the re—reward. She's the strongest, so she put on that whole act just to trick us.",0,""],["w",1.0],["ctl","avg3_139","a","004","resentful",null,null,null,null,"jushou2","Linear",0.5],["goon"],["w",0.5],["stg",0,0.0,-100.0,1.15,"Linear",0.5,null,null,null],["ctl","avg1_156","a","007","question",0.55,null,null,null,null,"Linear",0.5],["say","avg1_156","So you just hid somewhere safe and watched her risk her life?",0,""],["w",0.5],["se","se_146"],["ctl","avg3_139","a","007",null,null,null,null,null,"chijing","Linear",0.5],["say","Angry Trekker","No! She was obviously planning to use us as bait—to push us out to die when things got critical.",0,""],["w",0.5],["ctl","avg1_156","a","018","question",null,null,null,null,null,"Linear",0.5],["say","avg1_156","Oh yeah? And did that ever actually happen to you?",0,""],["w",0.5],["ctl","avg3_139","a","008","vexation",null,null,null,null,"chijing","Linear",0.5],["say","Angry Trekker","Dammit... This is pointless!==W== Then why would she say something like that...?",0,""],["w",0.5],["ctl","avg3_139","a",null,null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg3_139","a",null,null,0.25,null,null,null,null,"Linear",0.5],["se","se_251"],["ctl","avg1_156","a","020",null,0.45,null,null,null,null,"Linear",0.5],["stg",0,null,null,null,"Linear",0.5,null,null,"Zhong"],["w",0.5],["say","avg1_156","You, tell me right now. What exactly did Nazuka say here, and what just happened?",0,""],["w",0.5],["stg",0,100.0,null,null,"Linear",0.5,null,null,null],["ctl","avg3_139","a","004","speechless",null,null,null,null,"niunie1","Linear",0.5],["w",1.0],["say","Angry Trekker","She... Nazuka admitted the first hunt's failure was her fault. And then ... the crowd couldn't hold back. Some people started throwing rocks, and some even drew their swords.",0,""],["w",0.5],["ctl","avg3_139","a",null,null,null,null,null,null,null,"Linear",0.0],["chd",0,2,"avg3_132","a","007","shock"],["say","avg3_132","They drew their swords?!",0,""],["w",0.5],["stg",0,0.0,null,null,"Linear",0.5,null,null,null],["chd",1,2,"avg3_132","a","002",null],["ctl","avg1_156","a",null,null,0.6,null,null,null,null,"Linear",0.5],["se","se_124"],["ctl","avg3_139","a","008",null,0.35,null,null,null,"jushou2","Linear",0.5],["say","Angry Trekker","W-Well, we just yelled, we didn't get physical! It's not like we could beat ...==W== beat her anyway. Nobody actually dared to attack her.",0,""],["w",1.0],["ctl","avg3_139","a","007","sweaty",null,null,null,null,"chijing","Linear",0.5],["goon"],["w",0.5],["ctl","avg3_139","a","004",null,null,null,null,null,"JuGong1","Linear",0.5],["say","Angry Trekker","Then Nazuka disappeared deeper into the camp while we were all shouting at her. She said ... she'd take responsibility and ... vanish.",0,""],["w",0.5],["se","se_112"],["chd",0,2,"avg1_134","a","010",null],["say","avg1_134","Nazuka senpai...",0,""],["w",0.5],["chd",1,2,"avg1_134","a","002",null],["ctl","avg1_156","a","017","angry",null,null,null,null,"jushou2","Linear",0.5],["say","avg1_156","What?! And you didn't even try to stop her?!==W== Never mind—",0,""],["w",1.0],["ctl","avg1_156","a","011","sigh",null,null,null,null,"chijing","Linear",0.5],["goon"],["w",0.5],["ctl","avg3_139","a",null,null,null,null,null,0.0,null,"Linear",0.3],["ctl","avg1_156","a","020","exclamation",0.5,-0.2,1.5,null,"jushou2","Linear",0.3],["say","avg1_156","Boss! Everyone! We have to find Nazuka, now!",0,""],["bgm",""],["w",0.5],["trn",0,0,true,false,1.0],["w",1.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["bg","forest_camp_rain",0,1.0],["w",1.0],["fx",0,"fx_avg_rain_2",0,2],["se","se_195"],["trn",1,0,false,false,1.0],["w",1.0],["head","11:00, Tonitrua Month 3rd, Outside Philae, Trekker Camp"],["se","se_150"],["stg",0,null,null,1.05,"Linear",1.0,null,null,null],["w",1.0],["stg",0,60.0,null,null,"Linear",0.5,null,null,null],["w",1.0],["stg",0,-60.0,null,null,"Linear",0.5,null,null,null],["w",1.0],["mrt",2,"y","009","vexation",null],["say","avg3_100","It's starting to rain. I've looked all over camp, but still no sign of Nazuka.",2,""],["mrt",0,"y","020","think",null],["say","avg3_100","Where could she go? The forest, maybe? She's been pushing herself way too hard these days.",2,""],["se","se_146"],["mrt",0,"y","012",null,"chijing"],["say","avg3_100","If she runs into the Garden of Parasite, she'll be in real trouble...",2,""],["mrt",3,"y",null,null,null],["w",0.5],["se","se_014"],["say","avg1_156","She's nowhere to be found! Where the hell did Nazuka run off to?!",0,""],["w",0.5],["say","avg3_132","But why would she say it was her fault?",0,""],["w",0.5],["say","avg1_156","It's so stupid! All she ever does is make things harder for everyone.",0,""],["w",0.5],["say","avg1_134","I know I know it's not my place to butt in, but...",0,""],["w",0.5],["say","avg1_134","Do you think Nazuka senpai said it was her fault just to keep us out of it?",0,""],["w",0.5],["say","avg1_134","If she hadn't, everyone here would've blamed us and Boss for sure.",0,""],["w",0.5],["say","avg1_156","And that's exactly what's so stupid about it!!",0,""],["w",0.5],["say","avg1_156","She pulled this same stunt last time! Always making these big decisions on her own without talking to any of us!",0,""],["w",0.5],["say","avg1_156","Who does she think she is? Some legendary saint who saved Philae in endless rains?",0,""],["w",0.5],["say","avg3_100","The legend...",2,""],["w",0.5],["se","se_169"],["se","se_195_stop"],["bgm","m58"],["trn",0,1,false,false,1.0],["w",1.0],["bg","story_main_03_011_f",0,0.0],["fx",0,"fx_avg_rain_2",1,2],["fx",0,"fx_avg_reminiscence_loop",0,2],["trn",1,1,false,false,1.0],["w",1.3],["say","avg1_133","Not a monster. A statue. You know the One-Armed Saint at the Philae Museum of Art? Kinda like that, but with your face.",9,""],["w",0.5],["se","se_169"],["trn",0,1,true,false,1.0],["w",1.0],["bg","uniseed_greenhouse_outside",0,0.5],["w",0.5],["show","avg1_133","a","027",0.53,-0.19,1.3,0,null,0.0],["trn",1,1,false,false,1.0],["w",1.0],["ctl","avg1_133","a",null,null,null,null,null,1.0,null,"OutSine",0.5],["w",0.5],["say","avg1_133","Still, what I admire about the One-Armed Saint is her courage to make that sacrifice.",0,""],["w",0.5],["se","se_169"],["bgm",""],["trn",0,1,true,false,1.0],["w",1.0],["fx",0,"fx_avg_reminiscence_loop",1,2],["fx",0,"fx_avg_rain_2",0,2],["bg","forest_camp_rain",0,1.0],["w",1.0],["trn",1,1,false,false,1.0],["w",1.0],["say","avg3_100","I think I might know where she went. How well do you all know the city?",0,""],["w",0.5],["say","avg1_156","We don't go into the city much, but we're locals, so we know the basic layout.",0,""],["w",0.5],["say","avg3_132","I'm in the city for work pretty often, so I know my way around.",0,""],["w",0.5],["say","avg3_100","There's a place I need to check. I'll need your help.",0,""],["w",0.5],["say","avg3_100","I could be wrong, though. Noya, Iris, Amber—could you do me a favor and search the forest?",0,""],["w",0.5],["say","avg1_103","Got it.",0,""],["say","avg1_111","We're on it.",0,""],["say","avg1_112","Alright, let's roll! We'll take Loxy and go.",0,""],["w",0.5],["se","se_091"],["trn",0,0,false,false,1.0],["w",1.0],["bg","city_street_water_rain",0,0.5],["w",0.5],["fx",0,"fx_avg_rain_2",1,2],["se","se_195"],["fx",0,"fx_avg_rain_2",0,0],["trn",1,0,false,false,1.0],["w",1.0],["se","se_193"],["fx",0,"fx_avg_thunder",0,0],["stg",0,null,null,null,"Linear",1.0,null,null,"Zhong"],["head","12:10, Tonitrua Month 3rd, Philae, Somewhere in the Silver District"],["w",0.5],["trn",0,0,false,false,0.2],["w",0.2],["fx",0,"fx_avg_thunder",1,0],["se","se_472"],["bg","story_main_03_004",0,0.5],["w",0.5],["cbg",0,null,null,1.1,"Linear",0.0,null,null,null],["trn",1,0,false,false,1.0],["w",1.5],["cbg",0,null,80.0,null,"OutSine",1.0,null,null,null],["se","se_055"],["say","avg1_133","Where ...==W== did I wander off to?",9,""],["w",0.5],["goon"],["w",0.5],["se","se_047"],["cbg",0,60.0,null,null,"Linear",0.5,null,null,null],["w",0.5],["say","Chatty Passerby","Hey, did you hear? They took down the One-Armed Saint statue.",9,""],["w",0.5],["cbg",0,null,null,1.05,"Linear",10.0,null,null,null],["se","se_058"],["say","Curious Trekker","What, really? I thought that statue was super popular.",9,""],["w",0.5],["se","se_049"],["say","Chatty Passerby","It's a fake. The Eye of Grace just put out new research saying the legend and the statue are both forgeries made up way later.",9,""],["w",0.5],["se","se_057"],["say","Curious Trekker","Oh, so that whole legend was just a fiction.",9,""],["w",0.5],["trn",0,0,false,false,0.5],["w",0.5],["bg","BG_Black",0,0.0],["fx",0,"fx_avg_rain_2",1,0],["bg","story_main_03_005_c",0,0.0],["trn",1,0,false,false,0.5],["w",0.5],["se","se_055"],["bgm","m38"],["say","avg1_133","A false legend...==W== Yeah, I guess I really am a fake.",9,""],["w",0.5],["bg","story_main_03_005_b",0,1.0],["w",1.0],["fx",0,"fx_avg_rain",0,0],["goon"],["w",0.5],["say","avg1_133","I actually thought that sacrificing something precious to me would fix everything ... and protect everyone.",9,""],["w",0.5],["se","se_169"],["trn",0,0,true,false,0.5],["w",0.5],["fx",0,"fx_avg_reminiscence_loop",0,2],["fx",0,"fx_avg_rain",1,0],["bg","sky_rain",0,0.0],["trn",1,0,false,false,1.0],["w",1.0],["stg",0,null,null,null,"Linear",1.0,null,null,"Zhong"],["se","se_046"],["say","avg3_135","If you're really so amazing, why don't you just blow away the clouds above us and make this rain stop?!",0,""],["w",0.5],["se","se_169"],["trn",0,1,true,false,1.0],["w",1.0],["fx",0,"fx_avg_reminiscence_loop",1,2],["fx",0,"fx_avg_rain",0,0],["bg","story_main_03_005_b",0,0.0],["trn",1,1,false,false,0.5],["w",0.5],["se","se_055"],["say","avg1_133","I'm just ...==W== a self-righteous fool who hurt her own friends. I can't even tell which way the wind is blowing...",9,""],["w",1.5],["goon"],["w",0.5],["say","avg1_133","What ...==W== what am I even doing...?",9,""],["w",1.0],["goon"],["w",0.5],["trn",0,0,false,false,1],["w",1],["bg","BG_Black",0,0.5],["w",0.5],["fx",0,"fx_avg_rain",1,0],["trn",1,0,false,false,1.0],["w",1.0],["se","se_208"],["say","0","Curled up in a corner on the street, Nazuka hugs her knees and shuts her eyes, letting the roar of the rain wash everything else away.",9,""],["w",0.5],["se","se_227"],["say","avg1_133","This way, I don't have to obsess about that impossible question.",9,""],["se","se_195_stop"],["se","se_466"],["w",0.5],["say","avg1_133","The rain ...==W== stopped?",9,""],["w",0.5],["goon"],["w",0.5],["choice",["There you are."],[[]]],["w",0.5],["se","se_047"],["bg","story_main_03_006",0,1.0],["stg",0,null,60.0,null,"Linear",1.0,null,null,null],["w",1.5],["say","avg1_133","Boss... What are you doing here?",9,""],["w",0.5],["choice",["You're the one who told me about the One-Armed Saint."],[[]]],["w",0.1],["choice",["So it's no surprise that I'm here, right?"],[[]]],["w",0.5],["se","se_055"],["bg","story_main_03_006_a",0,0.5],["w",0.5],["say","avg1_133","Ah... I guess that's true.",9,""],["w",0.5],["bg","story_main_03_006_c",0,0.5],["w",0.5],["say","avg1_133","Sorry you came all this way for nothing. The statue's been taken down.",9,""],["w",0.5],["choice",["Yeah, I heard people talking."],[[]]],["w",0.1],["choice",["Honestly, I think it's better if the tale and statue are forgotten."],[[]]],["w",0.5],["se","se_186"],["bg","story_main_03_006_d",0,1.0],["w",1.0],["say","avg1_133","Even you feel that way...",9,""],["w",1.0],["trn",0,0,true,false,1.0],["w",1.0],["bg","city_street_water_rain",0,0.5],["w",0.5],["fx",0,"fx_avg_rain_2",0,0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["trn",1,0,false,false,1.0],["w",1.0],["mrt",1,"z","003",null,null],["say","avg3_100","Exactly. Would a real saint sacrifice their own arms for some vague hope or empty promise?",1,""],["mrt",0,"z","002",null,null],["say","avg3_100","If there really was an evil god who demanded a sacrifice to stop rains and floods, a true saint would use their own two hands to strike it down instead.",1,""],["show","avg1_133","c","006",null,null,null,0,null,0.0],["ctl","avg1_133","c",null,null,null,null,null,1.0,null,"Linear",0.5],["mrt",0,"z","012",null,null],["say","avg3_100","Just like what you did when you fought against the Big Three.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","c","024","speechless",null,null,null,1.0,null,"Linear",0.5],["w",0.5],["say","avg1_133","The Big ... Three.==W== Boss, Nazuna was right. I made the wrong call from the very beginning, right when we went to fight them. If it weren't for that...",0,""],["w",0.5],["se","se_112"],["ctl","avg1_133","c","028",null,null,null,null,null,"chijing","Linear",0.5],["goon"],["w",0.5],["mrt",1,"z","012",null,null],["say","avg3_100","The wrong call? Alright then, if you could go back in time, what would you do?",1,""],["mrt",0,"z","002","question",null],["say","avg3_100","Would you have retreated before others?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_146"],["ctl","avg1_133","c","005",null,null,null,null,null,"chijing","Linear",0.5],["say","avg1_133","No, I wouldn't... I would still buy time for everyone to retreat, over and over. Back then, only Claire and I could cover them.",0,""],["w",0.5],["stg",0,null,-25.0,1.05,"OutQuad",0.5,null,null,null],["se","se_226"],["mrt",1,"z","002",null,null],["say","avg3_100","Would you have backed down and escaped Philae alone when United Harvest threatened your friends' safety?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","c","005",null,null,null,null,null,null,"Linear",0.5],["say","avg1_133","I wouldn't...==W== There's no way.",0,""],["w",0.5],["se","se_112"],["ctl","avg1_133","c","013",null,null,null,null,null,"lengzhan","Linear",0.5],["goon"],["w",0.5],["stg",0,null,-50.0,1.1,"OutQuad",0.5,null,null,null],["se","se_226"],["mrt",1,"z","002",null,null],["say","avg3_100","Then, would you have let your friends handle that dangerous intel, letting them get targeted by United Harvest and putting them in danger?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","c","021","exclamation",null,null,null,null,"jushou","Linear",0.5],["say","avg1_133","Absolutely not!",0,""],["w",1.0],["ctl","avg1_133","c","005","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_133","...",0,""],["w",0.5],["ctl","avg1_133","c","015",null,null,null,null,null,null,"Linear",0.5],["say","avg1_133","Heh. I see what you mean, Boss. Even if I could go back, I'd still make the same choices.",0,""],["se","se_186"],["ctl","avg1_133","c","030",null,null,null,null,null,"chijing","Linear",0.5],["say","avg1_133","You're trying to tell me my fate is sealed.",0,""],["w",0.5],["ctl","avg1_133","c","027","happy",null,null,null,null,"JuGong1","Linear",0.5],["say","avg1_133","I guess that makes me a hopeless case.",0,""],["w",0.5],["mrt",1,"z","023",null,null],["say","avg3_100","Hopelessly stubborn, maybe.",1,""],["mrt",0,"z","002","attention",null],["say","avg3_100","When you can't blow the rain clouds away, just open an umbrella. If you don't have one, just ask someone who does for help.",1,""],["w",0.5],["mrt",0,"z","017",null,null],["say","avg3_100","Nazuka, there's nothing wrong with figuring things out on your own, but don't forget that your friends can help too.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","c","006",null,null,null,null,null,null,"Linear",0.5],["say","avg1_133","But...",0,""],["w",0.5],["mrt",1,"z","009",null,null],["say","avg3_100","I know it's hard for you.",1,""],["mrt",0,"z","002",null,null],["say","avg3_100","You're more than strong enough, and you have a kindness that protects your guild. Yet you push away your friends, thinking that you can handle everything yourself.",1,""],["w",0.5],["ctl","avg1_133","c",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["bg","sky_rain_b",0,1.0],["cbg",0,null,0.0,1.03,"Linear",4.0,null,null,null],["w",1.0],["mrt",1,"z","020",null,null],["say","avg3_100","To me, that's no different from the One-Armed Saint in the legend. You're both praying to some \"evil god\" for mercy.",1,""],["mrt",0,"z","009","speechless",null],["say","avg3_100","Your plan might get you through the immediate crisis, but it'll only lead to more hardship down the road.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["trn",0,0,false,false,1],["w",1],["fx",0,"fx_avg_rain_2",1,0],["bg","story_main_03_006_d",0,0.0],["stg",0,null,30.0,null,"Linear",0.0,null,null,null],["trn",1,0,false,false,1.0],["w",1.0],["stg",0,null,60.0,null,"Linear",1.0,null,null,null],["w",1.0],["say","avg1_133","I... No… That's ... that's not—",9,"vo_STm04_06_001"],["w",0.5],["se","vo_STm04_06_001"],["se","se_169"],["trn",0,1,true,false,1.0],["w",1.0],["fx",0,"fx_avg_reminiscence_loop",0,2],["fx",0,"fx_avg_rain_2",1,0],["bg","ruin_travellers_home_inside",0,0.5],["w",0.5],["trn",1,1,false,false,1.0],["w",1.0],["show","avg1_133","a","010",null,null,null,0,null,null],["show","avg1_156","a","011",null,null,null,0,null,null],["ctl","avg1_133","a","010",null,null,null,null,null,null,"Linear",0.5],["w",0.5],["say","avg1_133","I'm starting a new hunting squad.==W== And it has no room for the weak. Goodbye.",0,"vo_STm04_06_002"],["w",0.5],["ctl","avg1_133","a","003",null,null,null,null,null,null,"Linear",0.4],["w",0.4],["goon"],["ctl","avg1_156","a","010","exclamation",null,null,null,null,null,"Linear",1.0],["w",1.0],["se","se_006"],["ctl","avg1_133","a","005",null,0.2,null,null,0.0,null,"OutSine",0.7],["stg",0,100.0,null,1.15,"OutSine",0.8,null,null,null],["w",0.8],["ctl","avg1_156","a","016",null,0.6,null,null,null,"buman","Linear",0.5],["se","se_169"],["trn",0,1,true,false,1.0],["w",1.0],["fx",0,"fx_avg_reminiscence_loop",1,2],["bg","story_main_03_006_d",0,0.5],["w",0.5],["stg",0,null,60.0,1.1,"Linear",0.0,null,null,null],["trn",1,1,false,false,1.0],["w",1.0],["stg",0,null,null,null,"Linear",1.0,null,null,"Xiao"],["say","avg1_133","Everything you're saying... I understand it all! But I don't have a choice! There is no other way!",9,"vo_STm04_06_003"],["w",0.5],["stg",0,null,80.0,1.0,"Linear",20.0,null,null,null],["say","avg1_133","Because... Nazuna and Kaede are too kind. If I didn't do this, they'd insist on following me, no matter what…",9,"vo_STm04_06_004"],["w",1.0],["say","avg1_133","But if that happened... They would get hurt. Worse, something terrible—irreversible—might happen.",9,"vo_STm04_06_005"],["w",1.0],["say","avg1_133","Everyone says I'm \"tough\"... But I'm not tough at all…",9,"vo_STm04_06_006"],["w",0.5],["say","avg1_133","No. If being tough means standing by and doing nothing while the people you care about get hurt ... then I don't want to be tough.",9,"vo_STm04_06_007"],["w",0.5],["say","avg1_133","But ... why? My feelings were real... So why did I...?",9,"vo_STm04_06_008"],["w",0.5],["say","avg1_133","I... I wish I could go back in time and do it all over... I want to apologize for the horrible things I said, to say I'm sorry... I just want to be with them again—",9,"vo_STm04_06_009"],["w",0.5],["say","avg1_133","I never wanted to be separated from the people I love...",9,"vo_STm04_06_010"],["w",0.5],["choice",["Is this how you really feel?"],[[]]],["w",0.5],["say","avg1_133","Yes. But I know time can't be turned back. It was my choice, and I have to live with it.",9,"vo_STm04_06_011"],["w",0.5],["choice",["It's true, you can't turn back time."],[[]]],["w",0.1],["choice",["But since you can't redo the past, why not look forward instead?"],[[]]],["w",0.5],["bgm",""],["bg","story_main_03_006",0,0.5],["say","avg1_133","Huh? Look forward...?",9,"vo_STm04_06_012"],["w",0.5],["choice",["It's never too late to say what needs to be said."],[[]]],["w",0.5],["trn",0,0,false,false,1.0],["w",1.0],["bg","BG_Black",0,1.0],["w",1.0],["trn",1,0,false,false,1.0],["w",1.0],["se","se_463"],["bg","story_main_04_002_a",5,0.5],["w",0.5],["cbg",5,null,500.0,1.1,"Linear",0.0,null,null,null],["stage",5,0,0],["say","avg1_134","Uh ... senpai?",9,""],["w",0.5],["cbg",5,null,350.0,null,"OutSine",1.0,null,null,null],["w",1.5],["say","avg1_133","Eh?==W== Fu-Fuyuka?!",9,""],["w",0.5],["se","se_058"],["goon"],["w",0.5],["trn",0,0,false,false,0.5],["w",0.5],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["stage",5,1,1],["bg","story_main_04_002_a",0,0.0],["se","se_219"],["bgm","m3"],["trn",1,1,false,false,1.0],["w",1.0],["se","se_463"],["bg","story_main_04_002_b",0,0.5],["w",1.0],["se","se_050"],["say","avg3_132","Nazuka... Let's go home together.",9,""],["w",0.5],["stg",0,null,null,null,"Linear",1.0,null,null,"Xiao"],["se","se_053"],["say","avg1_133","Kaede, you're here too?==W== Then—",9,""],["w",1.0],["se"