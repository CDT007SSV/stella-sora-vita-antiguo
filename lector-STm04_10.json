1_111","a",null,"sigh",null,null,null,1.0,null,"OutSine",0.4],["w",0.4],["say","avg1_111","You really saved us, in more ways than one.==W== Any longer and those vines would have completely shredded my clothes.",0,""],["w",0.5],["ctl","avg1_111","a","011",null,null,null,null,null,null,"OutSine",0.3],["w",0.3],["goon"],["w",0.35],["clear",1,0.45,1],["stg",0,-120.0,null,null,"Linear",0.7,null,null,null],["bg","forest_night_1",0,0.7],["cbg",0,90.0,null,1.05,"Linear",0.0,null,null,null],["w",0.3],["show","avg3_132","a","004",0.545,-0.1,1.15,0,null,0.0],["ctl","avg3_132","a",null,"love",null,null,null,1.0,null,"OutSine",0.45],["w",0.45],["say","avg3_132","We owe our thanks to you, too. We couldn't have faced the Garden of Parasite without you clearing the vines. This victory belongs to all of us.",0,""],["w",0.35],["stg",0,null,-80.0,null,"Linear",1.5,null,null,null],["clear",1,0.4,1],["w",0.7],["bg","sky_night_b",0,0.8],["w",0.5],["se","se_147"],["show","avg1_135","a","002",0.56,-0.25,1.15,0,null,0.0],["bgm",""],["ctl","avg1_135","a",null,null,null,-0.07,null,1.0,null,"OutBack",0.55],["w",0.55],["say","avg1_135","I've captured all your heroic struggles on camera!==W== Once I release these images—with a little of this witch's special touch, of course—every Trekker will know you were framed.",0,""],["w",0.5],["ctl","avg1_135","a","005","music",null,null,null,null,null,"OutSine",0.35],["w",0.35],["goon"],["w",0.35],["stg",0,null,0.0,null,"Linear",1.5,null,null,null],["w",0.2],["clear",1,0.45,1],["bgm","m12"],["w",0.6],["bg","forest_night_1",0,0.7],["cbg",0,null,null,1.05,"Linear",0.0,null,null,null],["w",0.2],["show","avg1_156","a","004",0.66,-0.13,1.2,0,null,0.0],["ctl","avg1_156","a",null,"star",0.6,null,null,1.0,null,"OutSine",0.45],["w",0.45],["say","avg1_156","Nazuka, did you hear that? The rumors can't spread anymore. You don't have to worry...",0,""],["ctl","avg1_156","a","010","symbol",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","avg1_156","Huh? Where'd Nazuka go? Nazuka—?!",0,""],["w",0.35],["chd",0,0,"avg1_134","a","005","exclamation"],["w",0.35],["say","avg1_134","Nazuka senpai flew off with Master. She said the Monolith in the forest must be crawling with Stellaroids since no one's been there, so she went ahead to clear them out.",0,""],["chd",1,0,"avg1_134","a","002",null],["w",0.35],["ctl","avg1_156","a","021","sigh",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_156","We just finished fighting the Garden of Parasite! Can't she sit still for five minutes?==W== Hey, wait a sec!==W== Why did Boss go with her?!",0,""],["w",0.5],["ctl","avg1_156","a","023","exclamation",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["goon"],["bgm",""],["w",0.5],["ctl","avg1_156","a","012","resentful",null,null,null,null,"daintou","OutSine",0.65],["w",0.65],["goon"],["w",0.4],["se","se_076"],["trn",0,3,true,true,1.0],["w",1.0],["stg",0,0.0,-130.0,1.05,"Linear",0.0,null,null,null],["bg","forest_night_2_a",0,0.0],["trn",1,3,false,false,1.0],["w",0.5],["head","19:00, Tonitrua Month 6th, Outside Philae, Deep in the Forest"],["stg",0,null,0.0,null,"OutBack",0.6,null,null,null],["show","avg1_133","a","027",0.53,0.07,1.35,0,null,0.0],["ctl","avg1_133","a",null,null,null,-0.31,null,1.0,null,"OutQuad",0.45],["w",0.3],["fx",0,"fx_avg_wind_attack",0,0],["se","se_328"],["ctl","avg1_133","a","012",null,null,-0.225,null,null,null,"OutQuad",0.35],["w",0.35],["mrt",2,"y","020","question",null],["bgm","m77"],["say","avg3_100","Nazuka, are you sure it's okay for us to just run off like this?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","a","027",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","Don't worry. With the Garden of Parasite destroyed, those frenzied monsters should calm down, too. Even if everyone's exhausted, Nazuna and the others can handle whatever comes.",0,""],["w",0.5],["ctl","avg1_133","a","012",null,null,null,null,null,null,"OutSine",0.3],["w",0.3],["mrt",1,"z","002",null,null],["say","avg3_100","That's not my main concern...==W== Well, okay, I am a little worried. But my point is...",1,""],["w",0.5],["mrt",0,"z","003",null,null],["goon"],["mrt",0,"y","002","question",null],["say","avg3_100","Shouldn't we have told everyone? They're going to be worried when they realize we're gone.",1,""],["mrt",3,"y",null,null,null],["w",0.51],["ctl","avg1_133","a","002","attention",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","Oh, that? Don't worry about it. I asked Fuyuka to pass on a message for us.",0,""],["ctl","avg1_133","a","008","idea",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","avg1_133","Besides, months' worth of Stellaroids have probably built up in the Monolith. We need to go clear them out.",0,""],["ctl","avg1_133","a","022",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","And of course, I cooked up an excuse for you—you're \"evaluating the new hire's job performance.\" Feel better now?",0,""],["w",0.35],["ctl","avg1_133","a","012",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["mrt",1,"y","009","speechless",null],["say","avg3_100","\"The new hire\"...==W== So you do remember. While you were trapped in that illusion, I made a soul trade with you. Anyone who does so automatically becomes an employee of the Boss Accord.",1,""],["w",0.8],["mrt",0,"y","020",null,"jushou"],["goon"],["mrt",0,"z","002","question",null],["say","avg3_100","So you heard everything I said back then?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","a","028","speechless",null,null,null,null,null,"OutSine",0.5],["w",0.5],["say","avg1_133","To be precise... I couldn't make out a word you were saying. The magic mist completely blocked my mind from the real world. All I could see and hear were illusions.",0,""],["ctl","avg1_133","a",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.35],["mrt",1,"z","012",null,null],["say","avg3_100","But.. You still managed to make a wish.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","a","027",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","Because, even though I couldn't clearly hear what you were saying, I felt like you wanted me to say something.",0,""],["ctl","avg1_133","a","017","shy",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","It's not often you get a chance to just speak your mind. As a result, it happened to align exactly with what you intended.",0,""],["w",0.5],["ctl","avg1_133","a","012","love",null,null,null,null,null,"Linear",0.5],["say","avg1_133","That just proved we are on the same page~",0,""],["w",0.5],["mrt",2,"y","010","sigh",null],["say","avg3_100","I know, but ... I'm still sorry you had to agree to a soul trade unknowingly.",1,""],["mrt",0,"z","002","attention","daintou"],["say","avg3_100","You made a wish, and that sealed the deal. I shall make it happen with my life as collateral. Your soul will be temporarily entrusted to my keeping, and become my permanent possession after your wish comes true.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_101"],["ctl","avg1_133","a","027",null,null,-0.327,1.5,null,null,"OutSine",0.45],["w",0.45],["say","avg1_133","I told you, it's fine. Really.==W== In fact, I'm the one who should be thanking you.",0,""],["w",0.5],["ctl","avg1_133","a","008","idea",null,null,null,null,"jushou","OutSine",0.3],["w",0.3],["goon"],["w",0.35],["clear",1,0.4,1],["w",0.2],["se","se_224"],["fx",0,"fx_avg_movie",0,1],["bg","story_main_03_011",0,0.8],["cbg",0,null,null,0.96,"Linear",0.0,null,null,null],["w",0.2],["fx",0,"fx_avg_reminiscence_loop",0,0],["w",0.6],["say","avg1_133","Whether it was back in that hole when I was ready to give up...",9,""],["w",0.5],["se","se_221"],["bg","story_main_03_006",0,0.8],["cbg",0,null,null,0.96,"Linear",0.0,null,null,null],["w",0.7],["say","avg1_133","... or when I was heartbroken and alone in the cold rain...",9,""],["w",0.35],["se","se_221"],["bg","story_main_04_003",0,0.8],["cbg",0,null,null,0.96,"Linear",0.0,null,null,null],["w",0.7],["say","avg1_133","... or even this time, trapped in that beautiful dream the mist created...",9,""],["w",0.35],["se","se_169"],["trn",0,1,false,false,0.7],["w",0.7],["bg","forest_night_2_a",0,0.0],["cbg",0,null,null,1.05,"Linear",0.0,null,null,null],["fx",0,"fx_avg_movie",1,1],["fx",0,"fx_avg_reminiscence_loop",1,0],["show","avg1_133","a","027",0.525,-0.22,1.35,0,null,null],["trn",1,1,false,false,0.7],["w",0.7],["ctl","avg1_133","a",null,null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","Boss, you've saved me three times now.==W== I know it sounds dramatic, but each time I felt like I was reborn.",0,""],["w",0.5],["ctl","avg1_133","a","012","flower",null,-0.325,1.5,null,null,"OutSine",0.45],["w",0.45],["goon"],["ctl","avg1_133","a","017",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","When you look at it that way, maybe ... my soul was already entrusted to you from the start.",0,""],["w",0.35],["mrt",2,"z","014","music",null],["say","avg3_100","You're giving me too much credit. You've saved me plenty of times, too.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_133","a","008","love",null,null,null,null,"jushou","OutSine",0.35],["say","avg1_133","It's okay. Feelings like this are subjective, you know?",0,""],["w",0.5],["ctl","avg1_133","a","010","attention",null,null,null,null,null,"Linear",0.5],["say","avg1_133","Ah, but ... while I have no problem entrusting my soul to you, there is one little thing that's stuck in my mind...",0,""],["w",0.5],["mrt",1,"y","012","question",null],["say","avg3_100","And that is...?",1,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_133","a","027",null,null,null,null,null,null,"Linear",0.5],["bgm",""],["say","avg1_133","Mhmm. It's the reason we're here.==W== Shh, don't startle them. Follow me.",0,""],["w",0.5],["ctl","avg1_133","a","012","exclamation",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["goon"],["w",0.35],["se","se_025"],["clear",1,0.4,1],["stg",0,null,-100.0,null,"OutSine",2.0,null,null,null],["w",1.1],["bg","sky_night_a",0,0.8],["cbg",0,null,null,1.05,"Linear",0.0,null,null,null],["w",0.7],["say","0","The air is thick with the scent of damp earth and leaves. The quiet forest feels like a dark labyrinth.",0,""],["say","0","I follow Nazuka, my footsteps light on the mossy path as we move through dense thickets that rustle in the wind.",0,""],["w",0.35],["stg",0,null,0.0,null,"OutSine",5.2,null,null,null],["w",0.9],["trn",0,1,false,false,1.6],["w",1.6],["stg",0,null,null,1.05,"Linear",0.0,null,null,null],["film",0],["bg","story_main_04_001_b",0,0.0],["cbg",0,null,225.0,1.32,"Linear",0.0,null,null,null],["w",0.2],["trn",1,1,false,false,1.4],["w",1.3],["say","avg1_133","Here we are.",3,"vo_STm04_10_001"],["bgm","m58"],["w",0.5],["clear",0,0,1],["w",0.35],["choice",["How beautiful! There's the Monolith, with the light dancing."],[[]]],["w",0.1],["film",1],["bg","story_main_04_001_a",0,0.7],["cbg",0,900.0,800.0,1.6,"Linear",0.0,null,null,null],["cbg",0,700.0,null,null,"Linear",15.0,null,null,null],["w",0.7],["say","avg1_133","Every year around this time, lightbugs brimming with magic gather here and fly towards the Monolith. So—",9,"vo_STm04_10_002"],["w",0.5],["clear",0,0,1],["w",0.35],["bg","story_main_04_001_a",0,1.0],["cbg",0,-900.0,800.0,1.6,"Linear",0.0,null,null,null],["cbg",0,-700.0,null,null,"Linear",15.0,null,null,null],["w",0.9],["say","avg1_133","It is said that when you make a wish here, the lightbugs will carry it to the Monolith. Even if the wish remains unfulfilled, it will be forever etched there.",9,"vo_STm04_10_003"],["w",0.5],["clear",0,0,1],["w",0.35],["bg","story_main_03_008_c",0,1.0],["cbg",0,650.0,-600.0,2.0,"Linear",0.0,null,null,null],["cbg",0,null,-450.0,null,"Linear",15.0,null,null,null],["w",1.5],["say","avg1_133","Before the Big Three appeared and brought disaster, this was Philae's finest place for making wishes.",9,"vo_STm04_10_004"],["w",0.5],["clear",0,0,1],["w",0.35],["trn",0,1,false,false,1.0],["w",1.0],["bg","story_main_04_001_c",0,0.0],["cbg",0,null,-30.0,0.96,"OutSine",0.0,null,null,null],["trn",1,1,false,false,1.0],["w",0.9],["say","avg1_133","That's why, Boss... I was hoping we could perform the soul trading again, right here.",9,"vo_STm04_10_005"],["w",0.5],["clear",0,0,1],["w",0.35],["bg","story_main_04_001_b",0,0.8],["cbg",0,null,-30.0,0.96,"Linear",0.0,null,null,null],["w",0.7],["say","avg1_133","Don't get the wrong idea—I don't mean anything else. After all, a soul can only be \"sold\" once in a lifetime, right? And such a crucial contract was made in a daze, all thanks to that meddling mist...",9,"vo_STm04_10_006"],["w",0.5],["clear",0,0,1],["w",0.35],["bg","story_main_04_001_c",0,0.2],["cbg",0,null,-30.0,0.96,"Linear",0.0,null,null,null],["w",0.3],["say","avg1_133","It's just not fair.",9,"vo_STm04_10_007"],["w",0.5],["clear",0,0,1],["w",0.3],["choice",["I see."],[[]]],["w",0.1],["choice",["So you want to perform the trade again here, to have your wish engraved in the Monolith?"],[[]]],["w",0.1],["bg","story_main_04_001_a",0,0.8],["cbg",0,null,-30.0,0.96,"Linear",0.0,null,null,null],["w",0.7],["say","avg1_133","Well... not exactly. After all, that's just a tale.",9,"vo_STm04_10_008"],["w",0.5],["clear",0,0,1],["w",0.35],["bg","story_main_04_001_c",0,0.7],["cbg",0,null,-30.0,0.96,"Linear",0.0,null,null,null],["w",0.6],["say","avg1_133","Besides, it was you who told me that wishes are things you make happen with your own hands.",9,"vo_STm04_10_009"],["w",0.5],["clear",0,0,1],["w",0.35],["say","avg1_133","I chose this location simply because it's the first fully-explored Monolith in Philae that reliably grants Artifacts through wishes.",9,"vo_STm04_10_010"],["w",0.5],["clear",0,0,1],["w",0.35],["bg","story_main_04_001_b",0,0.8],["cbg",0,null,-30.0,0.96,"Linear",0.0,null,null,null],["w",0.7],["say","avg1_133","I've scoured every history book in Philae, but I could never find which Trekker first charted it. Maybe it was a tale, too. But thinking about it now... What if it was the One-Armed Saint?",9,"vo_STm04_10_011"],["w",0.5],["clear",0,0,1],["w",0.35],["choice",["Heh, that's a fascinating theory."],[[]]],["w",0.1],["choice",["If it's true, that would mean the Saint wasn't a work of fiction."],[[]]],["w",0.1],["choice",["The legend could be real after all."],[[]]],["w",0.1],["bg","story_main_04_001_c",0,0.0],["cbg",0,null,-30.0,0.96,"Linear",0.0,null,null,null],["w",0.3],["say","avg1_133","That's right. Speaking of which... You know, Boss, in the illusion created by the Garden of Parasite... I saw a happy future.",9,"vo_STm04_10_012"],["w",0.5],["clear",0,0,1],["w",0.35],["say","avg1_133","Nazuna's wish, Kaede's wish, Fuyuka's wish ... even mine. They all came true. We were living a warm and peaceful life.",9,"vo_STm04_10_013"],["w",0.5],["clear",0,0,1],["w",0.35],["bg","story_main_04_001_a",0,0.8],["cbg",0,null,-30.0,0.96,"Linear",0.0,null,null,null],["w",0.7],["say","avg1_133","If that's truly the future I had always longed for... Then I really am greedy.",9,"vo_STm04_10_014"],["w",0.5],["clear",0,0,1],["w",0.35],["say","avg1_133","Right, Boss, do you know? It was you who made me realize that it was nothing more than a dream.",9,"vo_STm04_10_015"],["w",0.5],["choice",["Me? What did I do?"],[[]]],["w",0.1],["bg","story_main_04_001",0,0.7],["cbg",0,null,-30.0,0.96,"Linear",0.0,null,null,null],["w",0.6],["say","avg1_133","Hehe. You didn't do anything at all.",9,"vo_STm04_10_016"],["w",0.5],["clear",0,0,1],["w",0.35],["film",0],["fx",0,"fx_avg_reminiscence_loop",0,0],["bg","story_main_04_003",0,0.8],["w",0.8],["say","avg1_133","You just ... weren't in that future.",3,"vo_STm04_10_017"],["w",0.5],["clear",0,0,1],["w",0.35],["say","avg1_133","But even without you, we unconsciously left an empty space. For you.",3,"vo_STm04_10_018"],["w",0.5],["clear",0,0,1],["w",0.35],["choice",["It's probably because of my immunity to magic..."],[[]]],["w",0.1],["choice",["... that Garden of Parasite couldn't create a mimic."],[[]]],["w",0.1],["film",1],["fx",0,"fx_avg_reminiscence_loop",1,0],["bg","story_main_04_001_c",0,0.7],["cbg",0,null,-30.0,0.96,"Linear",0.0,null,null,null],["w",0.7],["say","avg1_133","That makes sense... Alright, Boss. Shall we begin the soul trade now?",9,"vo_STm04_10_019"],["w",0.5],["clear",0,0,1],["w",0.35],["mrt",2,"z","014",null,null],["say","avg3_100","Of course.==W== Then, please state your wish—",1,""],["w",0.5],["mrt",0,"z","022",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["se","se_169"],["trn",0,1,false,false,1.0],["w",1.0],["film",0],["bg","story_main_04_001_b",0,0.0],["cbg",0,50.0,200.0,1.6,"Linear",0.0,null,null,null],["cbg",0,-50.0,null,null,"Linear",8.0,null,null,null],["trn",1,1,false,false,0.9],["w",0.9],["say","avg1_133","Boss, hear my wish.",3,"vo_STm04_10_020"],["w",0.5],["clear",0,0,1],["w",0.3],["film",1],["w",0.1],["bg","story_main_04_001_c",0,0.7],["cbg",0,null,-30.0,0.96,"OutSine",0.0,null,null,null],["w",0.5],["say","avg1_133","I hope that from now on, you'll always, always be by my side.",9,"vo_STm04_10_021"],["w",0.5],["clear",0,0,1],["w",0.35],["choice",["I accept your wish."],[[]]],["w",0.1],["bg","story_main_04_001_a",0,0.7],["cbg",0,null,-30.0,0.96,"Linear",0.0,null,null,null],["w",0.5],["say","avg1_133","And when that wish comes true...",9,"vo_STm04_10_022"],["w",0.5],["clear",0,0,1],["w",0.35],["trn",0,1,false,false,0.7],["w",0.7],["bg","white",0,0.0],["trn",1,1,false,false,0.7],["say","0","My soul will be yours to keep.",8,"vo_STm04_10_023"],["w",0.5],["clear",0,0,1],["w",0.35],["bg","story_main_04_001",0,0.8],["cbg",0,null,-30.0,0.96,"Linear",0.0,null,null,null],["w",0.7],["choice",["It's over."],[[]]],["w",0.1],["choice",["Still, don't you wanna make a grander wish?"],[[]]],["w",0.1],["choice",["I'll help you fulfill it together."],[[]]],["w",0.1],["bg","story_main_04_001_a",0,0.7],["cbg",0,null,-30.0,0.96,"Linear",0.0,null,null,null],["say","avg1_133","No, that's not necessary.",9,"vo_STm04_10_024"],["w",0.5],["clear",0,0,1],["w",0.35],["bg","story_main_04_001_c",0,0.7],["cbg",0,null,-30.0,0.96,"Linear",0.0,null,null,null],["w",0.6],["say","avg1_133","The only wish I want to come true is this one.",9,"vo_STm04_10_025"],["bgm",""],["w",0.5],["clear",0,0,1],["w",0.35],["se","se_025_stop"],["trn",0,1,false,false,1.0],["w",1.0],["bg","forest_night_2_a",0,0.0],["cbg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["w",0.3],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["show","avg1_133","a","017",0.525,-0.23,1.35,0,null,0.0],["trn",1,1,false,false,1.0],["w",0.4],["ctl","avg1_133","a",null,"shy",null,null,null,1.0,null,"OutSine",0.5],["w",0.5],["say","avg1_133","There. Thank you. No more regrets. I feel so much lighter. Come on, Boss, let's head for the Monolith.",0,""],["w",0.5],["mrt",2,"z","002","idea",null],["say","avg3_100","Right.",1,""],["mrt",3,"z",null,null,null],["w",0.51],["se","se_090"],["w",0.5],["ctl","avg1_133","a",null,null,null,null,null,0.0,null,"OutSine",0.5],["hide","avg1_133",0.5],["w",0.2],["bg","BG_Black",0,0.8],["w",0.2],["bg","forest_night_1",5,0.0],["cbg",5,1300.0,200.0,2.0,"Linear",0.0,null,null,null],["se","se_090"],["stage",5,0,14],["w",0.4],["mrt",2,"z","026","shock",null],["say","avg3_100","Is that a monster?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["stage",5,1,15],["bg","forest_night_2_a",0,0.8],["cbg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["w",0.25],["show","avg1_133","a","019",0.525,-0.12,1.2,0,null,0.0],["ctl","avg1_133","a",null,"exclamation",null,-0.19,1.3,1.0,null,"OutQuad",0.45],["say","avg1_133","Boss, get behind me. I'll take care of it.",0,""],["w",0.35],["cbg",0,90.0,null,null,"OutSine",0.6,null,null,null],["ctl","avg1_133","a",null,null,0.34,null,null,null,null,"OutSine",0.6],["w",0.2],["bg","forest_night_1",2,0.0],["cbg",2,800.0,null,1.6,"Linear",0.0,null,null,null],["stage",2,0,0],["w",0.1],["se","se_147"],["show","avg1_134","a","005",0.42,-0.19,1.28,2,null,0.0],["ctl","avg1_134","a",null,null,null,null,null,null,null,"OutSine",0.0],["ctl","avg1_134","a",null,null,0.55,null,null,1.0,null,"OutCubic",0.4],["w",0.4],["ctl","avg1_134","a",null,null,0.5,null,null,null,null,"OutBack",0.5],["w",0.5],["ctl","avg1_133","a","020",null,null,null,null,null,null,"Linear",0.3],["bgm","m28"],["say","avg1_134","Oof!",0,""],["w",0.35],["mrt",1,"y","025","symbol",null],["say","avg3_100","Fuyuka? What are you doing here? Wait... Don't tell me...",1,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_134","a","011","vexation",null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_134","Ow, don't push... U-Um... Master! I-I'm so sorry! There's a reason for this...!",0,""],["w",0.35],["se","se_147"],["stage",2,1,1],["w",0.25],["ctl","avg1_133","a",null,null,0.525,null,null,null,null,"OutSine",0.5],["w",0.45],["chd",0,2,"avg1_156","a","017","resentful"],["w",0.3],["say","avg1_156","Nazuka! You were trying to sneak off without us?!",0,""],["w",0.35],["ctl","avg1_133","a","016","sigh",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_133","... I should have known this would happen.",0,""],["w",0.35],["chd",0,0,"avg1_112","a","007","exclamation"],["w",0.35],["say","avg1_112","Yo, ==PLAYER_NAME==! You're going to hunt Stellaroids, and you didn't even invite us?",0,""],["chd",1,0,"avg1_112","a","002",null],["chd",1,2,"avg1_156","a","002",null],["w",0.2],["ctl","avg1_133","a","028",null,null,null,null,null,null,"OutSine",0.35],["chd",0,1,"avg1_111","a","011","idea"],["w",0.35],["say","avg1_111","Forget about the Stellaroids for a second—a Monolith that hasn't seen a wish in ages could create brand-new types of Artifacts! Come on, Boss, this is a huge opportunity for the New Star Guild!",0,""],["w",0.35],["chd",0,0,"avg1_103","a","013","angry"],["w",0.3],["bgm",""],["say","avg1_103","Boss... You just left without sending me a message. You broke y