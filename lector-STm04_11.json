1,"z","014","question",null],["say","avg3_100","All done already?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_135","a","016","shock",null,null,null,null,"lengzhan","Linear",1.0],["say","avg1_135","Oh no,==W== not the dessert!==W== I meant the exclusive scoop I got from interviewing the Boss.",0,""],["w",0.5],["goon"],["w",0.5],["ctl","avg1_135","a","010",null,null,null,null,null,"JuGong","Linear",1.0],["goon"],["ctl","avg1_135","a","005","happy",null,null,null,null,"tiao2","Linear",1.0],["say","avg1_135","Thanks again for everything! I'll be sure to let you see the draft before it goes to print.",0,""],["w",0.5],["mrt",1,"z","013","music",null],["say","avg3_100","Sounds good. I look forward to reading your masterpiece.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["stg",0,null,null,1.0,"OutQuint",1.0,null,null,null],["ctl","avg1_135","a","003",null,0.35,null,null,0.0,null,"OutSine",1.5],["hide","avg1_135",1.5],["se","se_010"],["w",1],["mrt",1,"y","010","sigh",null],["say","avg3_100","Whew, I'm wiped. This cleanup is more exhausting than fighting the Big Three ever was.==W== I wonder how Fuyuka's doing collecting the award.",2,""],["w",0.5],["goon"],["mrt",0,"y","020","speechless",null],["say","avg3_100","Now that our deal's settled, I need to go find Serena and ask about the orphanage.",2,""],["mrt",3,"y",null,null,null],["bgm",""],["se","se_381"],["cbg",0,null,0.0,null,"OutQuint",1.0,null,null,null],["cbg",0,null,50.0,1.05,"OutQuint",1.0,null,null,null],["w",1.0],["fx",0,"fx_avg_speaking",0,2],["se","se_219"],["bgm","m46"],["say","avg4_999","Pardon the intrusion, Tyrant.==W== I have observed that the souls you possess and safeguard now total nine.",0,""],["w",0.5],["goon"],["fx",0,"fx_avg_speaking",1,2],["fx",0,"fx_avg_speaking",0,2],["w",0.5],["mrt",1,"y","020","speechless","niunie1"],["say","avg3_100","Five before I came to Philae, plus the four from Petal Bloom... Yep, that makes nine.",2,""],["mrt",3,"y",null,null,null],["w",0.5],["fx",0,"fx_avg_speaking",1,2],["fx",0,"fx_avg_speaking",0,2],["say","avg4_999","If you were to procure just one more, you would complete your first mission.",0,""],["say","avg4_999","But I do not understand.",0,""],["fx",0,"fx_avg_speaking",1,2],["fx",0,"fx_avg_speaking",0,2],["w",0.5],["mrt",1,"y","012","question",null],["say","avg3_100","What do you mean?",2,""],["mrt",3,"y",null,null,null],["w",0.5],["fx",0,"fx_avg_speaking",1,2],["fx",0,"fx_avg_speaking",0,2],["bgm",""],["say","avg4_999","When the Garden of Parasite was on its rampage,==W== you could have traded for the souls of every Trekker present.==W== Your collection would be several times larger than it is now.",0,""],["w",0.5],["se","se_227"],["goon"],["w",0.5],["goon"],["say","avg4_999","But you did not do so. Why?",0,""],["fx",0,"fx_avg_speaking",1,2],["fx",0,"fx_avg_speaking",0,2],["bgm",""],["w",0.5],["mrt",1,"y","003","speechless",null],["say","avg3_100","Because people aren't objects.==W== They should never be treated as just tools for me to complete a mission.",2,""],["w",0.5],["mrt",0,"y","003",null,null],["goon"],["mrt",3,"y",null,null,null],["w",0.5],["fx",0,"fx_avg_speaking",1,2],["fx",0,"fx_avg_speaking",0,2],["say","avg4_999","I do not understand.",0,""],["fx",0,"fx_avg_speaking",1,2],["fx",0,"fx_avg_speaking",0,2],["w",0.5],["mrt",1,"y","002","attention",null],["say","avg3_100","Vita, do you know why I rarely ask you questions?",2,""],["mrt",3,"y",null,null,null],["w",0.5],["fx",0,"fx_avg_speaking",1,2],["fx",0,"fx_avg_speaking",0,2],["say","avg4_999","Please enlighten me, Tyrant.",0,""],["fx",0,"fx_avg_speaking",1,2],["fx",0,"fx_avg_speaking",0,2],["w",0.5],["mrt",1,"y","014",null,null],["say","avg3_100","Your top priority==W== is just making sure I complete my mission, right?",2,""],["w",0.5],["goon"],["mrt",3,"y",null,null,null],["w",0.5],["fx",0,"fx_avg_speaking",1,2],["fx",0,"fx_avg_speaking",0,2],["say","avg4_999","Yes. That aligns with your interests, Tyrant.",0,""],["fx",0,"fx_avg_speaking",1,2],["fx",0,"fx_avg_speaking",0,2],["w",0.5],["mrt",1,"y","003",null,"niunie1"],["se","se_226"],["say","avg3_100","But that's just what you assume is in my best interest.",2,""],["mrt",0,"y","020","speechless",null],["say","avg3_100","I'm not convinced your \"help\" won't harm my companions,==W== and I'm not sure completing the mission will lead to an outcome I desire.",2,""],["w",0.5],["goon"],["mrt",0,"y","012",null,null],["say","avg3_100","Can you prove to me that it will?",2,""],["mrt",3,"y",null,null,null],["w",0.5],["fx",0,"fx_avg_speaking",1,2],["fx",0,"fx_avg_speaking",0,2],["say","avg4_999","I am processing...==W== My apologies.==W== I cannot provide such proof.",0,""],["w",0.5],["fx",0,"fx_avg_speaking",1,2],["fx",0,"fx_avg_speaking",0,2],["w",1.5],["fx",0,"fx_avg_speaking",1,2],["fx",0,"fx_avg_speaking",0,2],["goon"],["w",0.5],["goon"],["fx",0,"fx_avg_speaking",1,2],["fx",0,"fx_avg_speaking",0,2],["w",0.5],["mrt",1,"y","023",null,null],["say","avg3_100","Then I still can't trust you.",2,""],["mrt",0,"y","014","attention","JuGong"],["say","avg3_100","And remember this:==W== my companions will always be my first priority.",2,""],["w",0.5],["goon"],["mrt",0,"y","009",null,"niunie1"],["say","avg3_100","And until you're certain about that, I might never complete this first mission of yours.",2,""],["mrt",3,"y",null,null,null],["w",0.5],["fx",0,"fx_avg_speaking",1,2],["fx",0,"fx_avg_speaking",0,2],["say","avg4_999","...",0,""],["say","avg4_999","You are correct. I failed to consider what you truly desire, Tyrant.",0,""],["say","avg4_999","I will take my leave. Everything I do is to help you become a more powerful Tyrant.",0,""],["show","avg1_136","b","003",null,null,null,0,null,0.0],["say","avg4_999","Your wish is my command.",0,""],["se","se_342"],["fx",0,"fx_avg_speaking",1,2],["cbg",0,null,0.0,1.0,"OutQuint",1.0,null,null,null],["cbg",0,null,-100.0,null,"OutQuint",1.0,null,null,null],["stg",0,null,null,1.2,"OutQuint",1.0,null,null,null],["w",0.5],["se","se_062"],["ctl","avg1_136","b",null,null,null,null,null,1.0,null,"OutQuart",1.0],["w",1.2],["ctl","avg1_136","b","002","music",null,null,null,null,"JuGong","Linear",1.0],["bgm",""],["say","avg3_974","Well now, fancy meeting you here.",0,""],["w",0.5],["mrt",1,"z","002","attention",null],["say","avg3_100","Serena. I was just on my way to find you.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_136","b","004","happy",null,null,null,null,null,"Linear",1.0],["bgm","m42"],["say","avg3_974","I've been here for a little while.",0,""],["ctl","avg1_136","b","002",null,null,null,null,null,"niunie1","Linear",1.0],["say","avg3_974","You were tied up with that interview, and afterward, you seemed quite taken with that unique phone of yours.==W== I didn't want to interrupt.",0,""],["w",0.5],["goon"],["w",0.5],["mrt",1,"z","009","speechless",null],["say","avg3_100","Let's skip the pleasantries.==W== Can you give us the information you promised==W== about the orphanage?",1,""],["w",1],["goon"],["mrt",0,"z","014",null,null],["w",0.5],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_136","b","004",null,null,null,null,null,"diantou","Linear",1.0],["se","se_021"],["say","avg3_974","Of course. Integrity is the foundation of good business, after all.==W== Please, take a look at this.",0,""],["w",1],["ctl","avg1_136","b",null,null,null,-0.05,1.1,null,null,"OutQuint",1.0],["cbg",0,null,null,0.95,"OutQuint",1.0,null,null,null],["se","se_062"],["goon"],["w",0.5],["mrt",1,"z","025","exclamation",null],["se","se_252"],["say","avg3_100","This is...",1,""],["mrt",0,"z","009","speechless",null],["say","avg3_100","And you're sure this is reliable?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_136","b","005","happy",null,null,null,null,"JuGong","Linear",1.0],["say","avg3_974","One hundred percent authentic.==W== I have my connections in the major companies, so getting these transaction records wasn't difficult.",0,""],["w",0.5],["goon"],["ctl","avg1_136","b","002",null,n