,["ctl","avg1_134","a","009","shock",null,null,null,null,"Tiao","Linear",1.0],["say","avg1_134","Oh, I'm so sorry!==W== I should have explained all that from the start.",0,""],["w",0.5],["ctl","avg1_134","a",null,null,null,null,null,null,null,"Linear",1.0],["goon"],["ctl","avg2_985","a","003","attention",null,null,null,null,"JuGong","Linear",1.0],["say","avg2_985","It's okay.==W== I only decided on this after returning to Philae yesterday, and I didn't send word until this morning.==W== It's perfectly understandable that you couldn't rearrange your schedules.",0,""],["w",0.5],["goon"],["w",0.5],["ctl","avg1_134","a","006",null,null,null,null,null,null,"Linear",1.0],["goon"],["ctl","avg2_985","a","006","question",null,null,null,null,null,"Linear",1.0],["say","avg2_985","I understand you donated the bounty from defeating the Big Three to help repair the Camp?",0,""],["ctl","avg1_134","a","013","happy",null,null,null,null,"daintou","Linear",1.0],["say","avg1_134","Um, yes.==W== The reward was for the Trekkers who defeated the monsters,==W== but taking down the Big Three was a group effort. It wasn't just the work of one or two Trekkers or guilds.",0,""],["w",0.5],["goon"],["w",0.5],["ctl","avg2_985","a","005",null,null,null,null,null,null,"Linear",1.0],["goon"],["ctl","avg1_134","a","008",null,null,null,null,null,"niunie1","Linear",1.0],["say","avg1_134","We felt it was only right for everyone to pitch in and repair the damage the Camp sustained from the Garden of Parasite.",0,""],["ctl","avg1_134","a","009","flurry",null,null,null,null,"lengzhan","Linear",1.0],["say","avg1_134","Um...==W== At least, that's what the Boss and Nazuka senpai said.",0,""],["w",0.5],["goon"],["ctl","avg2_985","a","003",null,null,null,null,null,"JuGong","Linear",1.0],["bgm",""],["say","avg2_985","I see.==W== Even so, this medal is my personal recognition of the Petal Bloom's achievements...",0,""],["w",0.5],["ctl","avg1_134","a","006",null,null,null,null,null,null,"Linear",1.0],["goon"],["ct