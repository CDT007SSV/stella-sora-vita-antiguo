5],["say","avg3_183","It was merely a byproduct.==W== Behold: my latest breakthrough in magical cultivation: the Jade Grass.",0,""],["w",0.5],["se","se_100"],["obj","qstory_main_05_005_c",1,null,0.54],["ctl","avg3_183","a",null,null,0.3,null,null,null,null,"OutSine",0.4],["ctl","avg3_134","a",null,null,0.72,null,null,null,null,"OutCubic",0.4],["w",0.4],["goon"],["w",0.35],["mrt",1,"w","020","speechless",null],["say","avg3_100","Jade Grass... The name sounds familiar...",1,""],["mrt",3,"w",null,null,null],["objx"],["w",0.5],["ctl","avg3_134","a",null,null,0.8,null,null,0.0,null,"OutQuad",0.5],["hide","avg3_134",0.5],["ctl","avg3_183","a","004","attention",0.5,-0.11,1.15,null,null,"OutQuad",0.5],["w",0.2],["obj","qstory_main_05_005_b",1,0.75,0.54],["w",0.35],["say","avg3_183","The wild variety absorbs sunlight by day and releases it at night, like the real sun.==W== To replicate that perfectly, I practically lived in the cage with the Blade of Jade!",0,""],["w",0.3],["se","se_056"],["fx",0,"fx_avg_bling",0,1],["obj","qstory_main_05_005_a",1,0.75,0.54],["w",0.3],["goon"],["ctl","avg3_183","a","002",null,0.35,null,null,null,null,"Linear",7.0],["say","avg3_183","Several months back, Trekkers caught Blade of Jade out in the Wilds. Its feathers are pure condensed magic, and it generates magical wind just by flapping its wings.",0,""],["fx",0,"fx_avg_bling",1,1],["objx"],["w",0.3],["show","avg2_964","a","002",0.66,-0.04,1.1,0,null,0.0],["ctl","avg2_964","a",null,null,null,null,null,0.7,null,"OutSine",0.5],["ctl","avg3_183","a","007",null,null,null,null,null,null,"OutSine",0.5],["ctl","avg2_964","a",null,null,0.75,null,null,null,null,"Linear",9.0],["say","avg3_183","We pumped the beast full of high-magic feed, then we used the feathers—and that wind—to turbocharge the Grass, so that the Grass can release magical sunlight.",0,""],["ctl","avg3_183","a","006","happy",null,null,null,null,"daintou","OutSine",0.45],["w",0.45],["say","avg3_183","Heh... Hahaha! Fate rewards the ambitious! The Jade Grass we cultivated are exceptional. Their light accelerates the growth of plants. They make the wild variety look like weeds.",0,""],["say","avg3_183","Two months. Nine greenhouses. We matched their entire annual output. The field tests on the wheat outside? Spectacular results.",0,""],["w",0.35],["ctl","avg2_964","a",null,null,null,null,null,0.0,null,"OutSine",0.45],["hide","avg2_964",0.45],["w",0.15],["chd",0,2,"avg1_112","c","014","exclamation"],["w",0.3],["say","avg1_112","Why go to such lengths to force the harvest? What is the point?",0,""],["chd",1,2,"avg1_112","a","002",null],["w",0.35],["ctl","avg3_183","a","003","shock",0.51,null,null,null,null,"OutCubic",0.5],["w",0.5],["say","avg3_183","Point? There is no \"point.\" The company wanted higher yields and lower costs. I delivered.",0,""],["ctl","avg3_183","a",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.35],["chd",0,0,"avg3_134","a","004","question"],["w",0.35],["say","avg3_134","Wait... Does that mean other United Harvest goods are also mixed with this magic-forced flour?",0,""],["chd",1,0,"avg3_134","a","002",null],["w",0.35],["ctl","avg3_183","a","007","happy",null,null,null,null,"daintou","OutSine",0.35],["w",0.35],["say","avg3_183","Heh heh. You're sharper than you look, Mina.",0,""],["ctl","avg3_183","a","002","speechless",null,null,null,null,null,"Linear",0.35],["w",0.35],["say","avg3_183","Tawny Nightingale, Golden Nightingale... Who cares? The profit there is peanuts compared to our bestsellers.",0,""],["ctl","avg3_183","a",null,null,null,null,null,null,null,"Linear",0.3],["w",0.3],["stg",0,null,null,null,"Linear",0.0,null,null,"Zhong"],["se","se_070"],["ctl","avg3_183","a","006",null,null,null,null,null,null,"Linear",0.5],["tsk","Xiao"],["say","avg3_183","Still, money is money. Even if it's just a single Dorra, I'd prefer it in my pocket.",0,""],["w",0.5],["ctl","avg3_183","a","004","sigh",null,null,null,null,null,"Linear",0.35],["w",0.35],["say","avg3_183","Never thought anyone would actually bother petitioning management over the Tawny Nightingale... The company wrote that product off ages ago.",0,""],["w",0.5],["ctl","avg3_183","a",null,null,0.7,null,null,1.0,null,"OutCubic",0.5],["cbg",0,-90.0,null,null,"OutCubic",0.7,null,null,null],["show","avg3_134","a","002",0.15,-0.09,1.15,0,null,0.0],["ctl","avg3_134","a","012","exclamation",0.3,null,null,1.0,null,"OutCubic",0.5],["w",0.5],["say","avg3_134","That's a lie! The company never gave up on it!",0,""],["w",0.3],["ctl","avg3_183","a",null,null,0.8,null,null,0.0,null,"OutQuad",0.5],["hide","avg3_183",0.5],["ctl","avg3_134","a","006","attention",0.5,null,null,null,"daintou","OutSine",0.55],["bgm",""],["say","avg3_134","When I petitioned Lady Darcia for the investigation team, she told me herself...",0,""],["w",0.35],["clear",1,0.4,1],["film",0],["fx",0,"fx_avg_reminiscence_loop",0,0],["w",0.3],["bg","dulcia_office_inside",0,0.7],["w",0.05],["show","avg2_985","a","002",null,-0.14,1.15,0,null,0.0],["ctl","avg2_985","a",null,null,null,null,null,1.0,null,"OutQuad",0.5],["w",0.5],["say","avg2_985","The Tawny Nightingale is the pride of our Philae Branch. It built our reputation with the Trekkers and the Ash District.",3,""],["w",0.35],["ctl","avg2_985","a","008",null,null,null,null,null,null,"Linear",0.5],["say","avg2_985","Conduct a thorough investigation, Mina. I know you won't let me down.",3,""],["w",0.35],["clear",1,0.45,1],["film",1],["fx",0,"fx_avg_reminiscence_loop",1,0],["w",0.1],["bg","uniseed_greenhouse_inside_night",0,0.6],["cbg",0,-90.0,null,1.05,"Linear",0.0,null,null,null],["w",0.15],["show","avg3_134","a","006",null,-0.09,1.15,0,null,0.0],["bgm","m43"],["ctl","avg3_134","a",null,null,null,null,null,1.0,null,"OutCubic",0.45],["w",0.45],["mrt",1,"w","020","think",null],["say","avg3_100","Huh? So Mina's backer is Darcia... And Firenze helped clear our names before, too.",2,""],["mrt",0,"w","021","question",null],["say","avg3_100","If the CEO and the second in command are 