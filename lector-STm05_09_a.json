002","speechless",null,null,null,null,null,"Linear",0.5],["say","avg3_183","The Intelligent Plants are indeed the life's work of master. They're beautiful, and maybe the master is right. Maybe they really will change the world.",0,""],["w",0.5],["se","se_146"],["ctl","avg3_183","a",null,null,null,null,null,null,"chijing","Linear",0.5],["say","avg3_183","But no matter how magnificent they are, they aren't my creation.",0,""],["ctl","avg3_183","a","003",null,null,null,null,null,null,"Linear",0.5],["say","avg3_183","==PLAYER_NAME==, I don't know what mediocrity means to a Trekker. But in my field? To be called average is to be called a failure.",0,""],["w",0.5],["se","se_095"],["bg","mood_3",0,0.5],["ctl","avg3_183","a","002",null,null,null,null,null,null,"Linear",0.5],["say","avg3_183","I used to dream that hard work could overcome natural talent... But a dream is all it was. I could never beat the true geniuses.",0,""],["se","se_251"],["ctl","avg3_183","a",null,null,null,null,null,null,"chijing","Linear",0.5],["say","avg3_183","But I couldn't accept that. So I clawed my way to this position, surviving on nothing but sheer loyalty to the master.",0,""],["w",0.5],["ctl","avg3_183","a",null,null,null,null,null,0.0,null,"Linear",0.5],["bg","uniseed_exhibition_night",0,0.5],["w",1.0],["se","se_087"],["obj","qstory_main_05_010",0,null,null],["w",0.5],["say","avg3_183","The Jade Grass is the only real achievement of my entire life. I'll never hand them over.",0,""],["w",0.5],["se","se_207"],["objx"],["w",0.5],["ctl","avg3_183","a",null,null,null,null,null,1.0,"JuGong1","Linear",0.5],["w",0.5],["say","0","Joseph empties the last drop, stands, and dusts off his knees.",0,""],["w",0.5],["ctl","avg3_183","a","005","happy",null,null,null,null,null,"Linear",0.5],["say","avg3_183","There... Now, I have no regrets.",0,""],["w",0.5],["mrt",1,"x","003",null,null],["say","avg3_100","Right. We're running out of time anyway.",1,""],["mrt",3,"x",null,null,null],["w",1.0],["bgm",""],["ctl","avg3_183","a","002","speechless",null,null,null,null,null,"Linear",0.5],["say","avg3_183","Indeed. Let's get going ...==W== to the next world together!",0,""],["w",0.5],["se","se_368"],["bg","BG_Black",0,0.3],["tsk","Zhong"],["ctl","avg3_183","a","006",null,0.55,-0.35,1.5,1.0,null,"OutSine",0.3],["goon"],["w",0.5],["stg",0,null,null,null,"Linear",1.0,null,null,"Zhong"],["bg","uniseed_exhibition_night",0,0.5],["se","se_226"],["mrt",2,"x","025",null,null],["say","avg3_100","What did you just say?",1,""],["mrt",3,"x",null,null,null],["w",0.5],["se","se_308"],["bgm","m47"],["trn",0,0,true,false,0.5],["w",0.5],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,-200.0,-100.0,1.2,"Linear",0.0,null,null,null],["show","avg2_964","a","002",1.0,0.8,0.8,0,null,1.0],["trn",1,0,false,false,0.5],["cbg",0,0.0,0.0,1.0,"OutSine",0.5,null,null,null],["show","avg3_183","a","006",0.55,null,null,0,null,0.0],["ctl","avg2_964","a","002",null,0.5,0.1,1.0,1.0,null,"OutQuart",0.5],["w",0.5],["ctl","avg2_964","a",null,null,0.6,-0.6,2.5,null,null,"OutQuint",0.3],["se","se_310"],["fx",0,"fx_avg_moster_roared",0,0],["w",0.2],["ctl","avg2_964","a",null,null,null,null,null,0.0,null,"Linear",0.2],["w",0.2],["stg",0,null,null,1.1,"Linear",0.5,null,null,"Zhong"],["ctl","avg3_183","a",null,null,null,null,null,1.0,"chijing","Linear",0.5],["se","se_328"],["fx",0,"fx_avg_wind_attack",0,2],["w",0.5],["se","se_096"],["ctl","avg3_183","a",null,null,null,0.05,0.9,0.0,null,"OutCubic",0.8],["w",0.8],["bg","BG_Black",0,0.5],["w",1.0],["se","se_049"],["tsk","Zhong"],["say","avg3_183","You were so patient with me... Stalling for your friends, right? Hahaha, well so was I! And look! It's here—my greatest ally!!",0,""],["w",1.0],["se","se_309"],["ctl","avg2_964","a",null,null,null,0.1,1.0,0.0,null,"Linear",0.0],["fx",0,"fx_avg_moster_roared",0,0],["bg","uniseed_exhibition_night",0,0.5],["ctl","avg2_964","a",null,null,0.5,-0.2,1.5,1.0,"JuGong1","OutQuint",0.5],["w",0.5],["mrt",2,"x","025",null,null],["say"