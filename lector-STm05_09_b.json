w",0.5],["say","avg1_103","Off ... again?==W== Why does Nyx take every Friday off? She's always late on Thursdays, too.",0,""],["w",0.5],["goon"],["w",0.5],["trn",0,0,false,false,0.5],["w",0.5],["clear",1,0,1],["stg",0,0.0,0.0,1.2,"Linear",0.0,null,null,null],["bg","uniseed_exhibition_night",0,0.0],["fx",0,"fx_avg_reminiscence_loop",1,0],["show","avg3_134","a","012",null,null,null,0,null,null],["trn",1,0,false,false,0.5],["w",0.5],["mrt",1,"x","014","attention",null],["say","avg3_100","Amber gave me the lead.==W== She actually suspected Nyx to be the one behind this whole mess.",1,""],["show","avg1_138","a","012",0.68,null,null,0,null,0.0],["w",0.5],["cbg",0,50.0,null,null,"OutCubic",1.0,null,null,null],["ctl","avg3_134","a",null,null,0.35,null,null,null,null,"OutQuint",1.0],["ctl","avg1_138","a",null,null,0.65,null,null,1.0,null,"OutQuint",1.0],["se","se_062"],["goon"],["mrt",3,"x",null,null,null],["w",0.5],["ctl","avg1_138","a",null,"attention",null,null,null,null,"diantou","OutQuint",1.0],["say","avg1_138","What made you realize==W== I wasn't the enemy then?",0,""],["w",0.5],["goon"],["w",0.5],["mrt",1,"x","003",null,null],["say","avg3_100","Luck, mostly.==W== I pieced together what Sapphire and Amber told me, and the pattern was obvious:==W== you were sneaking off every Friday for something else.",1,""],["w",0.5],["ctl","avg3_134","a","007",null,null,null,null,null,null,"Linear",1.0],["mrt",0,"x","002",null,"JuGong"],["goon"],["w",0.5],["goon"],["mrt",0,"x","003","speechless",null],["say","avg3_100","They said Marketing runs you ragged—==W==bossing you around==W== until you're so sleep-deprived you're napping all over the place.",1,""],["w",0.5],["goon"],["w",0.5],["goon"],["mrt",0,"w","009",null,"diantou"],["stg",0,null,-50.0,1.3,"OutCubic",1.0,null,null,null],["cbg",0,null,null,0.95,"OutCubic",1.0,null,null,null],["say","avg3_100","But you don't have family here in Philae,==W== and you aren't in debt to loan sharks.",1,""],["w",0.5],["goon"],["mrt",0,"w","020",null,"niunie1"],["say","avg3_100","It didn't add up.==W== Why take that abuse if you don't need the money?==W== Either you're a masochist, or you had an ulterior motive.",1,""],["w",0.5],["mrt",0,"w","020","question",null],["goon"],["w",0.5],["goon"],["mrt",0,"w","010","sweaty",null],["say","avg3_100","And carrying that pillow everywhere?==W== Too theatrical, it broke character.==W== The only logic was that you needed to hide something on you. That made you incredibly suspicious.",1,""],["w",0.5],["goon"],["w",1],["mrt",0,"w","002","attention","JuGong"],["goon"],["mrt",3,"w",null,null,null],["stg",0,null,0.0,1.2,"OutCubic",1.0,null,null,null],["cbg",0,null,null,1.0,"OutCubic",1.0,null,null,null],["w",0.5],["ctl","avg3_134","a","012",null,null,null,null,null,null,"Linear",1.0],["ctl","avg1_138","a","009",null,null,null,null,null,"niunie1","Linear",1.0],["se","se_349"],["say","avg1_138","Spot on. Can't believe that's where I slipped up.==W== Guess my undercover skills need a little polish.",0,""],["w",0.5],["goon"],["stg",0,null,null,1.0,"OutCubic",1.0,null,null,null],["cbg",0,null,null,0.95,"OutCubic",1.0,null,null,null],["ctl","avg3_134","a",null,null,0.28,null,null,0.0,null,"OutQuint",1.0],["hide","avg3_134",1.0],["ctl","avg1_138","b","008",null,0.5,null,null,null,null,"OutQuint",1.0],["se","se_078"],["say","avg1_138","Allow me to reintroduce myself. I'm Nyx, an inspector from United Harvest's Compliance Department. I monitor the Philae Branch. The Marketing gig was just a cover.",0,""],["ctl","avg1_138","b","004",null,null,null,null,null,"diantou","Linear",1.0],["say","avg1_138","The pillow's for my weapon. But the Fridays off were genuinely for slacking off. Marketing works people to the bone, and I really can't deal with that.",0,""],["w",0.5],["stg",0,null,null,1.2,"OutCubic",1.0,null,null,null],["cbg",0,null,null,1.0,"OutCubic",1.0,null,null,null],["mrt",1,"x","012","question",null],["say","avg3_100","Did you let Amber notice your schedule on purpose, just to lure us here?",1,""],["mrt",3,"x",null,null,null],["w",0.5],["ctl","avg1_138","b","009",null,null,null,null,null,"JuGong","Linear",1.0],["say","avg1_138","Guilty. And thanks for the backup. Handling these mercenaries solo would've been a pain. I owe you one.",0,""],["w",0.5],["mrt",1,"w","014",null,"JuGong"],["say","avg3_100","Help us catch Lady Gray and get answers about the orphanage. Then we'll call it even.",1,""],["mrt",3,"w",null,null,null],["w",0.5],["ctl","avg1_138","b","005","music",null,null,null,null,null,"Linear",1.0],["say","avg1_138","You've got a deal.",0,""],["w",0.5],["bgm",""],["trn",0,0,false,false,1],["w",1],["clear",1,0,1],["stg",0,null,null,1.0,"Linear",0.0,null,null,null],["w",1],["bg","uniseed_exhibition_night",0,0.0],["show","avg3_183","a","002",null,null,null,0,null,0.0],["w",0.5],["trn",1,0,false,false,1.0],["head","22:45, Messis Month 4th, Greenhouse District, Philae, Greenhouse No.100"],["ctl","avg3_183","a",null,null,null,null,null,1.0,null,"Linear",1.0],["stg",0,null,null,1.2,"OutCubic",1.0,null,null,null],["w",1.0],["ctl","avg3_183","a",null,null,null,null,null,null,"lengzhan","Linear",1.0],["say","avg3_183","...",0,""],["chd",0,0,"avg3_134","a","006","flurry"],["stg",0,50.0,null,null,"OutCubic",1.0,null,null,null],["say","avg3_134","Director Joseph,==W== let's move.==W== We have medics waiting outside to patch you up.",0,""],["w",0.5],["goon"],["w",0.5],["goon"],["stg",0,0.0,null,null,"OutCubic",1.0,null,null,null],["ctl","avg3_183","a",null,null,null,null,null,null,"niunie1","Linear",1.0],["chd",1,0,"avg3_134","a","002",null],["se","se_077"],["say","avg3_183","Don't bother. Just let me rest. I'll tell you everything you want to know.",0,""],["ctl","avg3_183","a",null,null,null,null,null,null,"JuGong","Linear",1.0],["stg",0,null,-50.0,1.0,"OutCubic",1.0,null,null,null],["bgm","m14"],["say","avg3_183","The Jade Grass was a complete accident.",0,""],["ctl","avg3_183","a",null,null,null,null,null,null,null,"OutQuint",0.5],["bg","unisee