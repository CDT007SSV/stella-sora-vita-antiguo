tl","avg1_112","c",null,null,0.28,null,null,0.0,null,"OutQuint",1.0],["hide","avg1_112",1.0],["se","se_252"],["obj","qstory_main_06_016",1,0.4,0.54],["cbg",0,null,null,0.95,"OutCubic",1.0,null,null,null],["say","avg1_110","This is the only thing we found in the basement—",0,""],["ctl","avg1_110","c","010","speechless",null,null,null,null,null,"Linear",1.0],["say","avg1_110","This recipe dates back a very long time. I believe it may have been the ancient relic itself... Turned out it wasn't what Lady Darcia was after.",0,""],["ctl","avg1_110","c","009",null,0.5,null,null,null,null,"OutQuint",1.0],["cbg",0,null,null,1.0,"OutCubic",1.0,null,null,null],["stg",0,null,null,1.0,"OutCubic",1.0,null,null,null],["objx"],["se","se_021"],["say","avg1_110","So the Tawny Nightingale recipe really was found in the orphanage, just as the mysterious messenger claimed... But that only raises more questions.",0,""],["chd",0,0,"avg1_111","c","017","question"],["stg",0,50.0,null,null,"OutCubic",1.0,null,null,null],["say","avg1_111","So you're saying... Aunt Allie took the kids and moved overnight, just like Rainea said?",0,""],["ctl","avg1_110","c","010",null,null,null,null,null,"JuGong","Linear",1.0],["say","avg1_110","That seems to be the case. Whoever was protecting the orphanage neutralized our soldiers with ease.==W== Relocating the children wouldn't have been difficult, and once they went into hiding, we'd have no way of tracking them.",0,""],["w",1.0],["goon"],["chd",0,2,"avg1_103","e","005","question"],["stg",0,-50.0,null,null,"OutCubic",1.0,null,null,null],["say","avg1_103","How do you explain the debt then?",0,""],["ctl","avg1_110","c","012","sweaty",null,null,null,null,null,"Linear",1.0],["say","avg1_110","The fact is, I only recently learned about the debt that was pinned on the orphanage.",0,""],["ctl","avg1_110","c",null,"speechless",null,null,null,null,"niunie1","Linear",1.0],["say","avg1_110","Apparently, to raise funds, Lady Gray searched United Harvest's archives for organizations that had recently been wiped out.==W== She used those names as loan entities, exploiting information gaps between city-states to secure collateralized loans.",0,""],["w",1],["ctl","avg1_110","c","009",null,null,null,null,null,"diantou","Linear",1.0],["stg",0,0.0,null,null,"OutCubic",1.0,null,null,null],["chd",1,2,"avg1_103","e","002",null],["chd",1,0,"avg1_111","c","002",null],["goon"],["w",0.5],["mrt",1,"w","010","sigh",null],["say","avg3_100","So it was loan fraud. That contract eventually fell into Feagin's hands and caused us plenty of trouble in Emor.",1,""],["mrt",3,"w",null,null,null],["show","avg2_985","a","006",0.72,null,null,0,null,0.0],["w",0.5],["ctl","avg1_110","c",null,null,0.3,null,null,null,null,"OutQuint",1.0],["ctl","avg2_985","a",null,null,0.7,null,null,1.0,null,"OutQuint",1.0],["se","se_062"],["say","avg2_985","I'm sorry, Your Majesty. I didn't think things through when I was raising funds.",0,""],["w",0.5],["mrt",1,"x","003",null,"niunie1"],["say","avg3_100","There's no erasing what's already happened… But it's behind us now.==W== What exactly was the ancient relic you were searching for beneath the orphanage?",1,""],["w",1],["mrt",0,"x","002","question",null],["goon"],["mrt",3,"x",null,null,null],["w",0.5],["ctl","avg2_985","a","003",null,null,null,null,null,"JuGong","Linear",1.0],["say","avg2_985","I was looking for an ancient map, Your Majesty. According to legend, it recorded the path that leads to the Tyrant.",0,""],["stg",0,null,null,1.1,"OutCubic",1.0,null,null,null],["ctl","avg1_110","c",null,null,0.28,null,null,0.0,null,"OutQuint",1.0],["hide","avg1_110",1.0],["ctl","avg2_985","a","005",null,0.5,null,null,null,null,"OutQuint",1.0],["se","se_062"],["say","avg2_985","Although Firenze never found that map, fate somehow brought us together.",0,""],["w",0.5],["mrt",1,"x","020","speechless",null],["say","avg3_100","Enough flattery.==W== That's all I have for you tonight. It's late, get some rest.",1,""],["w",1],["mrt",0,"x","002"