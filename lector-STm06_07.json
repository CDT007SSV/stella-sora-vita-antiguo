r",0.5],["ctl","avg1_110","c",null,null,null,null,null,1.0,null,"Linear",0.5],["w",0.5],["ctl","avg2_985","a","004","attention",null,null,null,null,null,"Linear",0.5],["say","avg2_985","You've likely deduced its power:==W== transferring human minds and memories.==W== Simply put, placing it in a tank of Psychic Fluid links the subject's consciousness to the network.",0,""],["w",0.5],["ctl","avg2_985","a","005",null,null,null,null,null,"JuGong","Linear",0.5],["ctl","avg1_110","c",null,null,null,null,null,null,"ChanDou","Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","a","008",null,null,null,null,null,null,"Linear",1.0],["w",1.0],["goon"],["w",0.5],["trn",0,0,true,true,0.75],["w",0.75],["fx",0,"fx_avg_reminiscence_loop",1,0],["w",0.5],["trn",1,0,false,false,0.75],["w",1.25],["show","avg1_110","c","008",null,null,null,0,null,0.0],["ctl","avg1_110","c",null,null,null,null,null,1.0,null,"Linear",0.5],["w",1.0],["ctl","avg1_110","c",null,null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_110","Look.==W== At the bottom of that massive tank lies the Bishop.==W== Once we extract it, the Intelligent Plant won't be a threat anymore.",0,""],["w",0.5],["stg",0,-550.0,200.0,1.5,"OutQuad",0.5,null,null,null],["ctl","avg1_110","c",null,null,0.45,null,null,0.0,null,"OutQuad",0.5],["w",0.8],["obj","qstory_main_06_015",0,null,0.6],["w",1.0],["goon"],["w",0.5],["goon"],["w",0.5],["objx"],["w",0.5],["mrt",1,"z","021","awkward",null],["say","avg3_100","Fishing a chess piece out of a tank that deep won't be easy.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["stg",0,0.0,0.0,1.0,"OutQuad",0.5,null,null,null],["w",0.5],["ctl","avg1_110","c",null,null,0.5,null,null,1.0,null,"OutQuad",0.5],["w",0.5],["say","avg1_110","Indeed. We face two main obstacles.==W== First, the key to the lid. Darcia keeps it on her person at all times.",0,""],["w",0.5],["ctl","avg1_110","c","012",null,null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["ctl","avg1_110","c","004","vexation",null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_110","Second, the Psychic Fluid inside is a far more treacherous problem...==W== Even standing next to it exposes you to magic vapors that can warp your mind.",0,""],["w",0.5],["ctl","avg1_110","c","017",null,null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["mrt",1,"z","002",null,null],["say","avg3_100","I see. You want to use the Boss Accord's protection to withstand the fluid, so you can dive in and grab the piece?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_110","c","008",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_110","Precisely. So I will ask one last time.==W== Boss ...==W== make a soul pact with me.",0,""],["w",0.5],["ctl","avg1_110","c","002",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",1],["se","se_062"],["ctl","avg1_110","c","014",null,null,-0.25,1.3,null,null,"OutQuad",0.5],["goon"],["w",0.5],["mrt",1,"y","020","think",null],["say","avg3_100","We are so close to defeating Darcia, and her logic is sound, but...",2,""],["w",0.5],["mrt",0,"z","010","sigh","lengzhan"],["say","avg3_100","No.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["bgm",""],["ctl","avg1_110","c","016","angry",null,null,null,null,"diantou","Linear",0.5],["say","avg1_110","I'm warning you. Anyone who gets in the way of my plan is an enemy.==W== Give me an acceptable reason while I still have patience.",0,""],["w",0.5],["ctl","avg1_110","c","007",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["mrt",1,"z","003",null,"lengzhan"],["say","avg3_100","Because I'm weak.==W== If the Intelligent Plants attack while you're down there, who's going to stop it?",1,""],["w",0.5],["mrt",0,"z","020",null,null],["goon"],["w",0.5],["mrt",0,"z","010","sigh","diantou"],["say","avg3_100","I can't buy you that kind of time.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_110","c","011","awkward",null,null,null,null,null,"Linear",0.5],["say","avg1_110","What are you getting at?",0,""],["w",0.5],["mrt",1,"z","013",null,null],["say","avg3_100","We play to our strengths. The alliance stands, but no soul pact.==W== The reason is simple—",1,""],["w",0.5],["mrt",0,"z","004",null,null],["goon"],["w",0.5],["bgm","m39"],["mrt",0,"z","018",null,null],["ctl","avg1_110","c","013",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg3_100","I will be the one==W== diving into the tank.",1,""],["w",0.5],["goon"],["w",0.5],["mrt",0,"z","002",null,null],["say","avg3_100","You're willing to risk your life to beat Darcia; I'm willing to stake mine too.==W== I have magic immunity.==W== That fluid shouldn't affect me.",1,""],["w",0.5],["goon"],["w",0.5],["mrt",0,"z","019",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_110","c",null,"speechless",null,null,null,null,"ChanDou","Linear",0.5],["say","avg1_110","Magic immunity...?!==W== That's rare.",0,""],["w",0.5],["se","se_070"],["ctl","avg1_110","c","013",null,null,null,null,null,"lengzhan","Linear",0.5],["tsk","Xiao"],["goon"],["w",0.5],["ctl","avg1_110","c","012",null,null,null,null,null,null,"Linear",0.5],["mrt",1,"z","013","happy",null],["say","avg3_100","Hah, looks like your intel isn't perfect.==W== Anyway, leave the piece to me. In exchange, you cover me.==W== If you fail, I'm done for.",1,""],["w",0.5],["mrt",0,"z","022",null,null],["goon"],["w",0.5],["mrt",0,"z","009",null,"lengzhan"],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_110","c","003",null,null,null,null,null,null,"Linear",0.5],["say","avg1_110","Heh...==W== Hahahaha. Very well. Since that is your choice.",0,""],["w",0.5],["ctl","avg1_110","c","015","music",null,null,null,null,"JuGong","Linear",0.5],["goon"],["w",0.5],["ctl","avg1_110","c","018",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_110","Then, Boss, from this moment on, we are allies against Darcia.",0,""],["bgm",""],["w",0.5],["end"]]}