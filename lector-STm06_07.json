,0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,1.0,"OutSine",0.0,null,null,null],["cbg",0,null,null,1.1,"Linear",15.0,null,null,null],["bg","uniseed_exhibition_destroyed",5,0.0],["show","avg3_1249","a","002",0.32,-0.1,1.1,5,null,null],["show","avg3_1250","a","002",0.72,-0.1,1.1,5,null,null],["show","avg1_110","c","014",0.5,-0.1,1.1,5,null,null],["fx",5,"fx_avg_reminiscence_loop",0,0],["trn",1,0,false,false,0.75],["w",1.15],["stage",5,0,4],["ctl","avg1_110","c",null,null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_110","Take everyone to the Ash District. Save your explanations for the interrogation room.",0,""],["w",0.5],["mrt",1,"z","018",null,null],["say","avg3_100","For a split second, I honestly thought you were the one pulling the strings behind all this...",1,""],["w",0.5],["mrt",0,"z","019",null,null],["say","avg3_100","Until==W== I saw that map in the VIP room.",1,""],["w",1],["stage",5,1,3],["hide","avg1_110"],["hide","avg3_1249"],["hide","avg3_1250"],["fx",5,"fx_avg_reminiscence_loop",1,0],["se","se_021"],["bg","story_main_06_024_a",0,1.0],["w",1.0],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["se","se_052"],["say","avg1_110","Oh? And what did you find?",9,""],["w",0.5],["say","1","That was your handwriting on the map, right?==W== You marked the interrogation room in the southwest. Right on the city edge. Hop the wall, and you're in the woods.",9,""],["stg",0,500.0,400.0,1.5,"OutQuad",0.8,null,null,null],["w",0.8],["show","avg1_110","c","002",0.3,-0.55,null,0,"attention",0.0],["goon"],["w",0.5],["say","1","So, you were turning a blind eye to our escape... No. You wanted us to run, didn't you?",9,""],["w",0.5],["se","se_349"],["w",0.5],["say","avg1_110","Bravo. Dealing with smart people saves me so much effort.==W== I'd planned a little \"accident\" outside the interrogation room, but Darcia beat me to the punch.",9,""],["w",0.5],["chd",0,4,"avg2_985","a","002",null],["w",0.5],["goon"],["w",0.5],["chd",1,4,"avg2_985","a","002",null],["say","avg1_110","Now, my turn. About Nyx, inside that tank...",9,""],["w",0.5],["trn",0,0,false,false,0.5],["w",0.5],["bg","story_main_06_017_b",0,0.0],["stg",0,-300.0,-300.0,1.3,"Linear",0.0,null,null,null],["fx",0,"fx_avg_watermarks_lp",0,0],["trn",1,0,false,false,0.5],["w",1.0],["se","se_455"],["say","1","Nyx? I see.==W== So she really is on your side.",9,""],["w",0.5],["goon"],["w",0.5],["se","se_052"],["say","1","You want me to get her out?",9,""],["w",0.5],["say","avg1_110","Make no mistake. We accepted that we might be sacrificed for this plan long ago.",9,""],["w",0.3],["fx",0,"fx_avg_watermarks_lp",1,0],["trn",0,0,false,false,0.5],["w",0.5],["bg","story_main_05_002",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["trn",1,0,false,false,0.5],["w",0.8],["say","avg1_110","Success is our only hope. But victory hinges on HQ's cooperation...==W== And they've dragged their feet long enough to let the whole operation spiral out of control.",9,""],["w",0.5],["fx",0,"fx_avg_noise",0,0],["goon"],["w",0.5],["say","1","Wait...==W== The legion outside. Were they supposed to attack at dawn? Is that why you were watching the sky?",9,""],["w",1],["trn",0,0,false,false,0.5],["w",0.5],["bg","story_main_06_024_a",0,0.5],["fx",0,"fx_avg_noise",1,0],["w",0.5],["trn",1,0,false,false,0.5],["w",1.0],["goon"],["w",0.5],["stg",0,-500.0,600.0,1.6,"OutQuad",1.0,null,null,null],["chd",0,4,"avg3_121","a","002",null],["say","1","Even if they're a day late, they're close by...==W== We haven't hit a dead end yet, have we?",9,""],["w",0.5],["goon"],["w",0.5],["se","se_122"],["say","avg1_110","Hard to say.==W== If they were close, they certainly would have noticed the riot inside.",9,""],["w",0.5],["goon"],["w",0.5],["say","avg1_110","Yet they sit idle at the Trekker Camp. Either the commander is incompetent, or the troops lack the discipline to attack after a forced march.",9,""],["bgm",""],["w",0.5],["se","se_169"],["trn",0,0,true,true,0.75],["w",0.75],["fx",0,"fx_avg_reminiscence_loop",1,0],["bg","uniseed_basement_corelab",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,1.1,"Linear",0.0,null,null,null],["trn",1,0,false,false,0.75],["w",1.25],["show","avg1_110","c","014",null,null,null,0,null,0.0],["ctl","avg1_110","c",null,null,null,null,null,1.0,null,"Linear",0.5],["w",0.5],["ctl","avg1_110","c",null,null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_110","Either way, they stand no chance against Darcia.==W== That is why, Boss, I'm offering you a soul pact. Provided you can—",0,""],["w",0.5],["ctl","avg1_110","c","010",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.2],["choice",["No. I can't."],[[]]],["ctl","avg1_110","c","012",null,null,null,null,null,null,"Linear",0.5],["w",0.5],["bgm","m11"],["mrt",1,"z","003","attention",null],["say","avg3_100","My soul pact doesn't control people. I can't just force a surrender.",1,""],["w",0.5],["mrt",0,"z","012",null,"diantou"],["say","avg3_100","She looks loyal, sure, but that loyalty runs on her own twisted logic. She doesn't blindly obey my orders.==W== And where did you hear about \"soul pacts,\" anyway?",1,""],["w",0.5],["mrt",0,"z","004",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_110","c","009",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_110","An information broker told me...",0,""],["w",0.5],["chd",0,0,"avg3_974","b","002",null],["mrt",1,"z","012","question",null],["say","avg3_100","Was this broker in a cloak?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_110","c","008",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_110","Yes. The one based at the Trekker Camp.",0,""],["w",0.5],["chd",1,0,"avg3_974","a","002",null],["mrt",1,"z","009","sweaty",null],["say","avg3_100","Serena. Figures. I'll save my breath, then. I grant a wish, and the price is your soul.",1,""],["w",0.5],["mrt",0,"z","002","attention",null],["say","avg3_100","In other words, I take your soul, then I grant your wish.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_110","c","013",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_110","Grant my wish...",0,""],["w",0.5],["mrt",1,"z","010","sigh","diantou"],["say","avg3_100","Yeah. But even with a pact, I can't control Darcia.",1,""],["w",0.5],["mrt",0,"z","002",null,null],["say","avg3_100","I can let the house arrest slide.==W== But hurting my friends? That's where I draw the line. Petal Bloom's exile, Mistique getting hurt—that's all on her.",1,""],["w",0.5],["mrt",0,"z","012",null,null],["goon"],["w",0.5],["mrt",0,"z","006",null,"diantou"],["say","avg3_100","I was planning to sabotage her crazy scheme anyway. Since our goals align,==W== you don't need a pact. I'll help you.",1,""],["w",0.5],["mrt",0,"z","014","music",null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_110","c","011",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_110","Are you serious? You'll help me ...==W== for nothing?",0,""],["w",0.5],["ctl","avg1_110","c","012","question",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["mrt",1,"z","009",null,"diantou"],["say","avg3_100","Yep.==W== Honestly, I hate using soul pacts myself. So I'm not asking for any payment.",1,""],["w",0.5],["mrt",0,"z","022",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["bgm",""],["ctl","avg1_110","c","010","sigh",null,null,null,null,"diantou","Linear",0.5],["say","avg1_110","Is that so? Then this negotiation is over. Pretend I never mentioned a partnership.",0,""],["w",0.5],["se","se_062"],["ctl","avg1_110","c",null,null,null,null,0.98,0.0,null,"OutQuad",0.5],["w",1.0],["se","se_070"],["mrt",1,"z","025",null,"lengzhan"],["tsk","Xiao"],["say","avg3_100","Huh? What?! Hold on, this isn't a joke!",1,""],["mrt",3,"z",null,null,null],["w",0.5],["cbg",0,-500.0,null,1.5,"OutQuad",0.7,null,null,null],["w",0.7],["ctl","avg1_110","c",null,null,null,null,1.0,null,null,"Linear",0.0],["ctl","avg1_110","c",null,null,null,null,null,1.0,null,"Linear",0.5],["w",0.9],["say","avg1_110","Do I look like I'm joking?==W== Besides, I refuse to owe anyone favors.",0,""],["w",0.5],["ctl","avg1_110","c","017","awkward",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["se","se_062"],["ctl","avg1_110","c","009",null,null,-0.25,1.3,null,null,"OutQuad",0.5],["w",0.5],["ctl","avg1_110","c",null,"sigh",null,null,null,null,"diantou","Linear",0.5],["say","avg1_110","Listen. Without payment, there's no liability.==W== A \"price\" is the only guarantee that a partner is reliable.",0,""],["w",0.5],["ctl","avg1_110","c","014",null,null,null,null,null,"JuGong","Linear",0.5],["goon"],["w",0.5],["ctl","avg1_110","c","010",null,null,null,null,null,null,"Linear",0.5],["say","avg1_110","Yet you claim you want nothing. Isn't that just saying==W== you won't take responsibility for the outcome?",0,""],["w",0.5],["se","se_062"],["ctl","avg1_110","c","014",null,null,0.0,1.0,null,null,"OutSine",0.5],["goon"],["w",0.5],["mrt",1,"y","020","think",null],["say","avg3_100","I was being too naive...==W== Maybe Firenze's strength is that composure—she never wavers. And also...",2,""],["w",0.5],["mrt",0,"y","009",null,"lengzhan"],["goon"],["mrt",3,"y",null,null,null],["w",0.5],["se","se_169"],["trn",0,0,true,true,0.75],["w",0.75],["bg","story_main_01_003",0,0.0],["cbg",0,null,-50.0,0.98,"OutSine",0.0,null,null,null],["film",0],["w",0.5],["trn",1,0,false,false,0.75],["w",1.55],["say","avg3_999","So please, my Tyrant, don't become a star once more.",3,""],["w",0.2],["say","avg3_999","The same old road leads to the same old ends.",3,""],["w",1],["trn",0,0,true,true,0.75],["w",0.75],["bg","uniseed_basement_corelab",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,-500.0,0.0,1.5,"Linear",0.0,null,null,null],["film",1],["w",0.5],["trn",1,0,false,false,0.75],["w",1.05],["show","avg1_110","c","017",null,null,null,0,null,0.0],["ctl","avg1_110","c",null,null,null,null,null,1.0,null,"Linear",0.5],["w",1.0],["bgm","m46"],["mrt",1,"y","020","think",null],["say","avg3_100","She really checkmated me there.",2,""],["w",0.5],["mrt",0,"z","002",null,null],["say","avg3_100","Be rational, Firenze.==W== Darcia is a formidable opponent.==W== We need every ounce of combat prowess we can get right now. You should prioritize working with me...",1,""],["w",0.5],["mrt",0,"z","003",null,null],["goon"],["w",0.5],["mrt",0,"z","004",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_110","c","008",null,null,null,null,null,null,"Linear",0.5],["say","avg1_110","Am I to understand ...==W== that you're begging for my assistance?",0,""],["w",0.5],["ctl","avg1_110","c","003",null,null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["mrt",1,"z","012",null,null],["say","avg3_100","Huh?==W== Have our positions just reversed...",1,""],["w",0.5],["se","se_070"],["mrt",0,"z","007",null,"lengzhan"],["tsk","Xiao"],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_110","c","010","sigh",null,null,null,null,"diantou","Linear",0.5],["say","avg1_110","Sigh...==W== You be rational. I simply expect you to show the resolve required for this.",0,""],["w",0.5],["ctl","avg1_110","c","002",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg1_110","c","008",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg1_110","Did I not make myself clear? Let's use a more formal term then...==W== \"Alliance.\" Our lives are on the line here,==W== so I need to know you're truly prepared for the consequences.",0,""],["w",0.5],["ctl","avg1_110","c","003",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["se","se_062"],["ctl","avg1_110","c","015",null,null,-0.25,1.3,null,null,"OutQuad",0.5],["goon"],["w",1],["mrt",1,"z","012","question",null],["say","avg3_100","You're making a soul pact the condition for our partnership?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["c