,null],["w",0.5],["se","se_226"],["ctl","avg1_110","c","016",null,null,-0.225,1.25,null,null,"OutQuad",0.5],["say","0","A slight sting at my neck. The rapier at my throat trembles for a split second, then snaps back.",0,""],["w",0.5],["ctl","avg1_110","c","007","angry",null,null,null,null,null,"Linear",0.5],["say","avg1_110","Boss, you're insane. Have you no fear of death?",0,""],["w",0.5],["mrt",1,"z","002",null,null],["say","avg3_100","Of course I do. But we don't have time to play games. Besides—",1,""],["w",0.5],["mrt",0,"z","004","question","diantou"],["say","avg3_100","You aren't on Darcia's side, are you?",1,""],["w",0.5],["mrt",0,"z","020",null,null],["say","avg3_100","I've pretty much figured out why you cornered me like this...==W== But I need to hear you say it, Firenze.",1,""],["w",0.5],["mrt",0,"z","006",null,"diantou"],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["se","se_100"],["ctl","avg1_110","c","008",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg1_110","You're right. We aren't allies. But tell me...==W== When did you realize?",0,""],["w",0.5],["ctl","avg1_110","c","017","question",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["mrt",1,"z","018","happy",null],["say","avg3_100","You left too many loose ends.",1,""],["mrt",3,"z",null,null,null],["bgm",""],["w",0.5],["se","se_169"],["trn",0,0,true,true,0.75],["w",0.75],["fx",0,"fx_avg_reminiscence_loop",0,0],["bg","uniseed_warehouse",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,1.1,"Linear",0.0,null,null,null],["trn",1,0,false,false,0.75],["w",1.25],["show","avg1_135","b","004",null,null,null,0,null,0.0],["ctl","avg1_135","b",null,null,null,null,null,1.0,null,"Linear",0.5],["w",1.0],["ctl","avg1_135","b","018","speechless",null,null,null,null,null,"Linear",1.0],["say","avg1_135","Which means==W== this \"Anonymous User\" tapped my phone today without me noticing.==W== They sent the request,==W== dropped the intel, then deleted me instantly.",0,"