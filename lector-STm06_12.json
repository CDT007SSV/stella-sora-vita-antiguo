",null,null,null,null,null,"lengzhan","Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","c","007",null,null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["mrt",1,"z","015",null,null],["say","avg3_100","That person just now...==W== Was that you back in school?",1,""],["w",0.5],["mrt",0,"z","020",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["bg","philae_room_dusk",0,0.5],["cbg",0,null,null,1.5,"Linear",25.0,null,null,null],["ctl","avg2_985","c","004",null,null,null,null,null,"diantou","Linear",0.5],["say","avg2_985","Yes.==W== My father was a Senator for United Harvest.==W== He gave his life eliminating the company's rivals during the conflict with Grace Imperium,==W== yet,==W== the Senate refused to honor his sacrifice.==W== Instead, they picked my family's fortune clean like vultures.",0,""],["w",0.5],["ctl","avg2_985","c","006",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.8],["ctl","avg2_985","c","004",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","c","014",null,null,null,null,null,"lengzhan","Linear",0.5],["goon"],["w",0.8],["ctl","avg2_985","c","009",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","c","011",null,null,null,null,null,"ChanDou","Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","c","003",null,null,null,null,0.0,null,"OutQuad",0.5],["w",0.6],["obj","qstory_main_06_012",0,null,0.6],["w",1.0],["say","avg2_985","The classmates who used to flock to me for favors vanished overnight.==W== They mirrored the Senate to turn on me,==W== bullying and mocking me.",0,""],["w",0.5],["ctl","avg2_985","c","010",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","c","014",null,null,null,null,null,"ChanDou","Linear",0.5],["goon"],["w",0.5],["objx"],["w",1.1],["ctl","avg2_985","c","004",null,null,null,null,1.0,null,"Linear",0.5],["w",0.5],["say","avg2_985","At first, I dismissed them as fools who got off on tormenting the weak.==W== I told myself I still had my garden. Even if every human on earth betrayed me, my plants never would.",0,""],["w",0.5],["ctl","avg2_985","c","003",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","c","004",null,null,0.0,1.0,null,null,"OutQuad",0.8],["say","avg2_985","But when they uprooted my flowerbeds,==W== I realized I was wrong.==W== They weren't trying to get anything from me. They weren't even doing it for fun.",0,""],["w",0.5],["ctl","avg2_985","c","010",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","c","013",null,null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","c","012","angry",null,null,null,null,null,"Linear",0.5],["tsk","Xiao"],["say","avg2_985","They bullied me simply to feel safe.",0,""],["w",0.5],["ctl","avg2_985","c","006",null,null,null,null,null,null,"Linear",0.5],["mrt",1,"z","012","question",null],["say","avg3_100","Safe?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["bgm",""],["bg","white",0,0.5],["ctl","avg2_985","c",null,null,null,null,null,0.95,null,"Linear",0.5],["w",1.0],["fx",0,"fx_avg_noise",0,0],["se","se_387"],["w",0.25],["ctl","avg2_985","c","004",null,null,null,null,null,null,"Linear",0.5],["fx",0,"fx_avg_noise",1,0],["say","0","\"You were way too cozy with the ex-President. Keep talking to her, and people get the wrong idea.\"",8,""],["w",0.5],["fx",0,"fx_avg_noise",0,0],["se","se_387"],["w",0.25],["ctl","avg2_985","c","009",null,null,null,null,null,null,"Linear",0.5],["fx",0,"fx_avg_noise",1,0],["say","0","\"She's a murderer's daughter, you know...\"",8,""],["w",0.5],["fx",0,"fx_avg_noise",0,0],["se","se_387"],["w",0.25],["ctl","avg2_985","c","011",null,null,null,null,null,"lengzhan","Linear",0.5],["fx",0,"fx_avg_noise",1,0],["say","0","\"If anyone finds out we used to be friends, I'll get dragged down with her.\"",8,""],["w",0.5],["bgm","m13"],["ctl","avg2_985","c","004",null,null,null,null,null,"diantou","Linear",0.5],["say","avg2_985","Fear of isolation. Desperate for acceptance. Humans need a herd to feel secure,==W== and they'll happily throw their own to the wolves to stay in it.==W== We truly are pathetic creatures.",0,""],["w",0.5],["ctl","avg2_985","c","010",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","c","005","sigh",null,null,null,null,"lengzhan","Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","c","003",null,null,null,null,null,"diantou","Linear",0.5],["say","avg2_985","In the wreckage of my garden, I found a book.==W== Heh. I imagine you can guess what was inside?",0,""],["w",0.5],["ctl","avg2_985","c","007",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","c",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["bg","story_main_01_004",0,0.5],["w",0.5],["cbg",0,null,null,1.2,"Linear",10.0,null,null,null],["w",0.5],["say","avg2_985","Exactly. It was your story. In your story,==W== \"You\" suffered just like I did—betrayed time and again by those closest to you,==W== yet always rising to fight back. Your resilience spoke to me.",9,""],["w",0.5],["goon"],["w",0.5],["goon"],["w",0.5],["bg","white",0,0.5],["w",0.5],["ctl","avg2_985","c","007",null,null,null,null,0.95,null,"Linear",0.5],["w",0.5],["say","avg2_985","You became my light. Because of the Tyrant,==W== I found the strength to gather the stones they cast at me==W== and use them to pave my path to power.",0,""],["w",0.5],["ctl","avg2_985","c","011",null,null,null,null,null,"lengzhan","Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","c","007",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","c","004",null,null,null,null,null,null,"Linear",0.5],["say","avg2_985","Swearing loyalty to Your Majesty was only natural.==W== Bringing plants into your Legion, granting them minds of their own...==W== This is how I atone for the innocent flowers I failed to protect.",0,""],["w",0.5],["ctl","avg2_985","c","014","speechless",null,null,null,null,"ChanDou","Linear",0.5],["goon"],["w",1.2],["ctl","avg2_985","c","003",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","c","002",null,null,null,null,null,null,"Linear",0.5],["say","avg2_985","Most importantly—==W==unlike people, plants always return your care with beauty.",0,""],["w",0.5],["ctl","avg2_985","c","007",null,null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","c","005",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg2_985","It may take decades, maybe centuries...==W== But I will perfect this army step by step. I won't let you down, Your Majesty.",0,""],["w",0.5],["ctl","avg2_985","c","003",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","c",null,null,null,null,null,0.0,null,"Linear",0.5],["bg","wild_tower_dusk",0,0.5],["cbg",0,-500.0,300.0,1.5,"Linear",0.0,null,null,null],["w",0.5],["cbg",0,500.0,null,null,"Linear",25.0,null,null,null],["ctl","avg2_985","c","007",null,null,null,null,null,null,"Linear",0.5],["say","avg2_985","If only we could move everyone's souls into plant vessels...==W== Imagine what a peaceful, tranquil world we'd finally have.",0,""],["w",0.5],["ctl","avg2_985","c","007",null,null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["mrt",1,"z","012",null,null],["say","avg3_100","You're romanticizing them.==W== Parasitic vines bleed their hosts dry, and climbers choke the very trees that support them just to steal the light.",1,""],["w",0.5],["mrt",0,"z","003","awkward",null],["goon"],["w",0.5],["mrt",0,"z","002",null,null],["say","avg3_100","Walnut leaves poison the soil to kill rivals.==W== Even the gaps in a forest canopy are just borders in a constant war for territory.",1,""],["w",0.5],["mrt",0,"z","010","sigh","diantou"],["goon"],["w",0.5],["bg","white",0,0.5],["ctl","avg2_985","c",null,null,null,null,null,0.95,null,"Linear",0.5],["w",0.5],["mrt",0,"z","003",null,"lengzhan"],["say","avg3_100","Darcia, that garden of peace you're imagining... It doesn't exist.",1,""],["w",0.5],["mrt",0,"z","002",null,null],["say","avg3_100","Just like your \"light.\"==W== The Tyrant you worship isn't the person standing before you now.",1,""],["w",0.5],["mrt",0,"z","009",null,"ChanDou"],["goon"],["w",0.5],["mrt",0,"z","020","speechless",null],["say","avg3_100","You want me ...==W== to be the Tyrant from your fantasies.==W== But I'm just me.==W== I can never be the idol you've built in your mind.",1,""],["w",1.4],["mrt",0,"z","023",null,null],["goon"],["w",0.5],["mrt",0,"z","010","sigh","diantou"],["goon"],["w",0.5],["mrt",0,"z","020",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["bg","uniseed_greenhouse_outside_dusk",0,0.5],["cbg",0,null,null,1.1,"Linear",15.0,null,null,null],["ctl","avg2_985","c",null,null,null,null,null,1.0,null,"Linear",0.5],["w",0.5],["ctl","avg2_985","c","007",null,null,-0.075,1.1,null,null,"OutQuad",0.5],["say","avg2_985","I know, Your Majesty.==W== I've been watching you since the moment you stepped through our doors.",0,""],["w",0.5],["ctl","avg2_985","c","002",null,null,null,null,null,"JuGong","Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","c","014",null,null,-0.15,1.2,null,null,"OutQuad",0.5],["say","avg2_985","But I couldn't admit it. If I did, I'd be alone again.==W== After finally finding a ray of hope...==W== How could I possibly bear to let it go?",0,""],["w",0.5],["ctl","avg2_985","c","008","speechless",null,null,null,null,"lengzhan","Linear",0.5],["goon"],["w",1.2],["ctl","avg2_985","c","003",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","c","007",null,null,null,null,null,"zuochupeng","Linear",0.5],["say","avg2_985","Heh... Hahaha.==W== Deep down, I know. I'm no different from the humans I despise, forcing my delusions onto others just to feel a false sense of security.",0,""],["w",0.5],["ctl","avg2_985","c","003",null,null,null,null,null,"lengzhan","Linear",0.5],["goon"],["w",0.5],["mrt",1,"z","012","question",null],["say","avg3_100","Is that how you really feel?==W== You're right, humans are cowards. We're afraid of so many things.",1,""],["w",0.5],["mrt",0,"z","009",null,"lengzhan"],["goon"],["w",0.5],["bg","white",0,0.5],["ctl","avg2_985","c","002",null,null,null,null,0.95,null,"Linear",0.5],["w",0.5],["mrt",0,"z","002",null,"diantou"],["say","avg3_100","But we're also capable of courage. We fight tooth and nail to conquer that fear for the sake of our ideals.",1,""],["w",0.5],["mrt",0,"z","023",null,null],["say","avg3_100","Admitting our inadequacy and still striving for a better future. Isn't that a strength in itself?",1,""],["w",0.5],["mrt",0,"z","022","music",null],["say","avg3_100","To me, such humanity is beautiful.",1,""],["w",0.5],["mrt",0,"z","020",null,"diantou"],["say","avg3_100","Darcia, stop this. It's not too late.==W== No one died in the chaos in Philae.==W== You still have a chance to make amends.",1,""],["w",0.5],["mrt",0,"z","015",null,null],["goon"],["w",0.5],["mrt",0,"z","010",null,"lengzhan"],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["se","se_418"],["fx",0,"fx_avg_noise",0,0],["ctl","avg2_985","d","009",null,null,null,null,null,"lengzhan","Linear",0.5],["fx",0,"fx_avg_noise",1,0],["se","se_418_stop"],["say","avg2_985","A wretch like me doesn't deserve such kindness. Heh...==W== You really are the ==SEX12== Tyrant I always admired.",0,""],["w",0.5],["ctl","avg2_985","d","007",null,null,null,null,null,null,"OutQuad",0.5],["goon"],["w",0.5],["ctl","avg2_985","d","003",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg2_985","But I'm already too far gone. I've merged myself with the cultivation tank ages ago to develop the Gen-2 Intelligent Plant.",0,""],["w",0.5],["ctl","avg2_985","d","004",null,null,-0.25,1.3,null,null,"OutQuad",0.5],["say","avg2_985","This form you see before you is the last shred of my humanity.",0,""],["w",0.5],["mrt",1,"z","021",null,null],["say","avg3_100","Darcia...==W== Why...==W== Why go this far?",1,""],["w",1],["mrt",0,"z","021","awkward","lengzhan"],["goon"],["w",1],["mrt",0,"z","010","sigh","diantou"],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg2_985","d",null,null,null,null,null,0.0,null,"Linear",0.5],["bg","story_main_06_029",0,0.5],["cbg",0,null,null,1.1,"Linear",15.0,null,null,null],["w",0.5],["say","avg2_985","I put Firenze through the same hell I faced, yet ...==W== she was luckier. She had loyal friends.",9,""],["w",0.5],["goon"],["w",0.5],["bg","white",0,0.5],["ctl","avg2_985","d","003",null,null,null,null,0.95,null,"Linear",0.5],["w",1.0],["ctl","avg2_985","d","007",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg2_985","Heh...==W== All I ever wanted was to be loved.==W== To be needed.==W== To be told that==W== my existence wasn't a mistake.",0,""],["w",0.5],["ctl","avg2_985","d","006",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","d","010",null,null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","d","009",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","d","008",null,null,null,null,null,"chijing","Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","d","007",null,null,null,null,null,null,"Linear",0.5],["say","avg2_985","But seeing the people you choose to stand by your side...==W== I realized I could never be one of them. I've strayed too far from the path.",0,""],["w",0.5],["ctl","avg2_985","d","013",null,null,null,null,null,"JuGong","Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","d","003",null,null,null,null,0.85,null,"Linear",0.5],["say","avg2_985","So this is it...==W== The end of Darcia.",0,""],["w",0.5],["ctl","avg2_985","d","002",null,null,null,null,0.75,"lengzhan","Linear",0.5],["goon"],["w",0.5],["fx",0,"fx_avg_watermarks_lp",0,0],["ctl","avg2_985","d","003",null,null,null,null,0.65,"JuGong","Linear",0.5],["say","avg2_985","But I made my peace long ago. I seek no redemption.==W== I despise humanity, and I'll remain its enemy until my dying breath.",0,""],["w",0.5],["ctl","avg2_985","d","006",null,null,null,null,0.55,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","d","007",null,null,null,null,0.45,null,"Linear",0.5],["say","avg2_985","Grant me one last wish.==W== Take the chess piece ... and end me. With your own hands.",0,""],["w",0.5],["ctl","avg2_985","d","008",null,null,null,null,0.35,"diantou","Linear",0.5],["goon"],["w",0.5],["ctl","avg2_985","d","007",null,null,null,null,0.25,null,"Linear",0.5],["say","avg2_985","I can't stand by your side, but remember this:==W== every other company in this world is your enemy.",0,""],["w",0.5],["ctl","avg2_985","d","012",null,null,null,null,0.15,"lengzhan","Linear",0.5],["goon"],["bgm",""],["w",0.5],["se","se_169"],["trn",0,0,true,true,0.75],["w",0.75],["fx",0,"fx_avg_reminiscence_loop",1,0],["bg","story_main_06_022_FP",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,1.1,"Linear",0.0,null,null,null],["cbg",0,null,null,1.0,"Linear",15.0,null,null,null],["w",0.5],["se","se_455"],["trn",1,0,false,false,0.75],["w",1.05],["mrt",1,"z","016",null,"diantou"],["say","avg3_100","Gulb...==W== What was ... that...?",1,""],["w",1.5],["mrt",0,"z","016",null,null],["goon"],["w",0.5],["mrt",0,"z","025",null,"lengzhan"],["say","avg3_100","The piece...==W== I've got the Bishop...!",1,""],["w",0.5],["mrt",0,"z","026","exclamation",null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["trn",0,0,false,false,0.75],["w",0.75],["fx",0,"fx_avg_watermarks_lp",1,0],["bg","uniseed_basement_corelab",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,1.1,"Linear",0.0,null,null,null],["w",0.75],["trn",1,0,false,false,0.75],["w",1.25],["head","03:00, Messis Month 8th, Greenhouse District, Philae, Lab Core"],["w",0.2],["se","se_072"],["w",0.3],["show","avg1_110","c","012",null,null,0.98,0,null,0.0],["ctl","avg1_110","c",null,null,null,null,1.0,1.0,null,"Linear",0.5],["w",0.3],["bgm","m14"],["ctl","avg1_110","c","004",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg1_110","Boss, are you alright?",0,""],["w",0.5],["mrt",1,"z","010","flurry","lengzhan"],["say","avg3_100","Huff, huff... I'm back.==W== Firenze, how long was I under?",1,""],["w",0.5],["mrt",0,"z","020","question",null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_110","c","013",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_110","A minute, maybe?==W== I'm not sure. Definitely no more than two.",0,""],["w",0.5],["ctl","avg1_110","c","012",null,null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["mrt",1,"z","021",null,null],["say","avg3_100","Felt like==W== a lifetime...",1,""],["w",0.5],["mrt",0,"z","003","awkward","lengzhan"],["goon"],["w",0.5],["mrt",0,"z","009","speechless",null],["say","avg3_100","Wait, never mind that.==W== Where's Darcia? Where is she?!",1,""],["w",1.3],["mrt",0,"z","025","symbol",null],["goon"],["mrt",3,"z",null,null,null],["bgm",""],["w",0.5],["stg",0,-500.0,-300.0,1.5,"OutQuad",0.8,null,null,null],["ctl","avg1_110","c",null,null,0.45,-0.03,null,0.0,null,"OutQuad",0.8],["hide","avg1_110",0.8],["w",0.8],["say","avg1_110","Right there. Looks like ...==W== she entered the tank a while ago. She's fused with the Lithe Grass Mother.",0,""],["w",0.5],["goon"],["w",0.5],["bg","view_secret_laboratory_b",5,0.0],["cbg",5,300.0,null,1.5,"Linear",0.0,null,null,null],["fx",5,"fx_avg_reminiscence_loop",0,0],["stage",5,0,0],["bgm","m20"],["w",0.3],["cbg",5,null,10.0,null,"OutQuad",0.3,null,null,null],["w",0.3],["se","se_491"],["cbg",5,null,0.0,null,"OutQuad",0.5,null,null,null],["say","0","Your Majesty...==W== Is that you?",0,""],["w",0.5],["goon"],["w",0.5],["mrt",1,"z","025",null,"lengzhan"],["say","avg3_100","Dar—",1,""],["mrt",3,"z",null,null,null],["w",0.25],["show","avg2_985","c","002",0.55,null,null,0,null,0.0],["stage",5,1,1],["ctl","avg2_985","c",null,null,null,null,null,0.8,null,"Linear",0.5],["w",0.5],["say","0","Forgive me, Your Majesty. I can no longer see or hear.",8,""],["w",0.5],["say","0","If only I'd met you sooner... Maybe I wouldn't have lost my way...",8,""],["bgm",""],["w",0.5],["end"]]}