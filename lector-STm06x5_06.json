,"ab","010","sigh",null,null,null,1.0,"chijing","Linear",0.5],["say","avg3_100","Good.==W== Don't worry about me. Call back when you're safe.",0,""],["w",0.5],["ctl","avg3_100","ab","022",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["bgm",""],["ctl","avg1_110","c","002","music",null,null,null,null,"diantou2","Linear",0.5],["say","avg1_110","Got it. And if you run into trouble, call me immediately. Talk soon, Boss.",0,""],["w",0.5],["se","se_091"],["ctl","avg3_100","ab",null,null,null,null,null,null,"JuGong1","Linear",0.5],["w",0.5],["trn",0,0,true,false,0.5],["w",0.5],["stage",1,1,1],["objx"],["w",1.0],["trn",1,0,false,false,0.5],["w",0.5],["show","avg1_145","a","006",null,null,null,0,null,0.0],["ctl","avg1_145","a",null,"speechless",null,null,null,1.0,null,"Linear",0.5],["w",0.5],["say","avg1_145","...",0,""],["w",0.5],["mrt",1,"ac","023","happy",null],["say","avg3_100","Spot-on prediction. Sounds like she \"took the deal\" and is off to enjoy the high life.",1,""],["mrt",3,"ac",null,null,null],["w",0.5],["se","se_146"],["ctl","avg1_145","a","007",null,null,null,null,null,"chijing","Linear",0.5],["w",1.0],["ctl","avg1_145","a",null,"sweaty",null,null,null,null,null,"Linear",0.5],["say","avg1_145","... Your companions are a bunch of absolute weirdos.",0,""],["w",0.5],["bgm","m49"],["mrt",1,"ac","014",null,null],["say","avg3_100","Maybe. But \"weirdo\" isn't the right word.",1,""],["mrt",0,"ac","020",null,null],["say","avg3_100","Whether it's Boss Accord, or the people who stand by me as true friends... Every single one of them keeps their word.",1,""],["mrt",0,"ac","023","love",null],["say","avg3_100","I know they'll keep their end of the bargain. That's why I'd bet my life on them.",1,""],["mrt",3,"ac",null,null,null],["w",0.5],["se","se_030"],["ctl","avg1_145","a","006",null,null,null,null,null,null,"Linear",0.5],["say","avg1_145","Every corporate suit I've ever met wakes up calculating margins and weighing risks. No exceptions.",0,""],["w",0.5],["mrt",1,"ac","002",null,null],["say","avg3_100","I weigh the risks too, you know.",1,""],["mrt",0,"ac","003",null,null],["say","avg3_100","But to me, keeping a promise and building trust means a hell of a lot more than squeezing out some petty profit.",1,""],["mrt",0,"ac","012","question",null],["say","avg3_100","Trust takes a lifetime to build, but only a second to shatter. That's what makes it so precious, isn't it?",1,""],["mrt",3,"ac",null,null,null],["w",0.5],["ctl","avg1_145","a","012","awkward",null,null,null,null,null,"Linear",0.5],["say","avg1_145","You love your grand speeches, don't you? Save it for some naive kid who might actually buy it.",0,""],["w",0.5],["mrt",1,"ac","013","happy",null],["say","avg3_100","You seemed to be enjoying it. Anyway—Firenze and I both turned your employer down.",1,""],["mrt",0,"ac","014",null,null],["say","avg3_100","My companions don't break promises. And I believe you won't, either.",1,""],["mrt",3,"ac",null,null,null],["w",0.5],["ctl","avg1_145","a","009","symbol",null,null,null,null,"chijing","Linear",0.5],["say","avg1_145","... Huh? What are you talking about? Have you lost your mind?",0,""],["w",0.5],["mrt",1,"ac","014","music",null],["say","avg3_100","Didn't we have a deal? You promised to keep me safe until the banquet ended. You're still honoring that promise.",1,""],["mrt",3,"ac",null,null,null],["w",0.5],["ctl","avg1_145","a","005","happy",null,null,null,null,null,"Linear",0.5],["say","avg1_145","I made that up on the spot. And you actually bought it.",0,""],["w",0.5],["mrt",1,"ac","018",null,null],["say","avg3_100","True.==W== You approached me with an ulterior motive, spewing nothing but lies.",1,""],["w",0.5],["trn",0,0,false,false,0.5],["w",0.5],["ctl","avg1_145","a",null,null,null,null,null,0.0,null,"Linear",0.0],["bg","story_event_06_004",0,0.0],["trn",1,0,false,false,0.5],["w",0.5],["mrt",0,"ac","009",null,null],["goon"],["mrt",3,"ac",null,null,null],["w",0.5],["trn",0,0,true,false,1.0],["w",1.0],["bg","hotel_guest_room_a_night",0,0.5],["w",0.5],["trn",1,0,false,false,1.0],["w",1.0],["show","avg1_145","a","006",null,null,null,0,null,null],["mrt",1,"ac","003",null,null],["say","avg3_100","But so far, all you've done is tie me up. You haven't hurt me or my companions.",1,""],["mrt",0,"ac","013",null,null],["say","avg3_100","You didn't just take out the mercs tailing us... You knocked out an entire squad of Desert Scorpions last night, all to keep me safe.",1,""],["mrt",0,"ac","013","star",null],["say","avg3_100","That doesn't just make you a competent bodyguard. It practically makes you my guardian angel.",1,""],["mrt",3,"ac",null,null,null],["w",0.5],["ctl","avg1_145","a","004","happy",null,null,null,null,null,"Linear",0.5],["say","avg1_145","Then, following your twisted logic—why exactly did I tie you up?",0,""],["w",0.5],["mrt",1,"ac","014",null,null],["say","avg3_100","Well... Let's just say it's a personal hobby of mine.==W== Thanks for indulging me, Otoha.",1,""],["w",0.5],["mrt",0,"ac","011","shy","niunie1"],["goon"],["mrt",3,"ac",null,null,null],["w",0.5],["stg",0,null,null,null,"Linear",1.0,null,null,"zhenjing"],["ctl","avg1_145","a","010","symbol",null,null,null,null,"chijing","Linear",0.5],["say","avg1_145","Huh?!",0,""],["w",0.5],["bgm",""],["mrt",1,"ac","009","speechless",null],["say","avg3_100","...==W== I've said enough. It's my turn to ask a question, and I only have one.",1,""],["w",1.0],["mrt",0,"ac","012","attention",null],["goon"],["mrt",3,"ac",null,null,null],["w",0.5],["ctl","avg1_145","a","004",null,null,null,null,null,null,"Linear",0.5],["say","avg1_145","About my employer?",0,""],["w",0.5],["mrt",1,"ac","009",null,null],["say","avg3_100","I don't care about them. Firenze will dig that up soon enough.",1,""],["mrt",0,"ac","012",null,null],["say","avg3_100","What I care about is...==W== Otoha, what did you do to Nanoha?",1,""],["w",0.5],["se","se_063"],["stg",0,null,-20.0,1.1,"OutCubic",0.3,null,null,null],["fx",0,"fx_speedline_center_w",0,0],["mrt",0,"ac","026",null,null],["goon"],["mrt",3,"ac",null,null,null],["w",0.5],["stg",0,null,null,null,"Linear",1.0,null,null,"Zhong"],["ctl","avg1_145","a","009","shock",null,null,null,null,"shouji","Linear",0.5],["say","avg1_145","...?!",0,""],["ctl","avg1_145","a",null,null,null,null,null,null,null,"Linear",0.0],["w",0.5],["bgm","m46"],["mrt",1,"ac","012",null,null],["say","avg3_100","I didn't see her at Goodwind Homecare.",1,""],["mrt",0,"ac","005",null,null],["say","avg3_100","The whole place was empty except for you. What did you do?",1,""],["mrt",3,"ac",null,null,null],["w",0.5],["show","avg1_119","a","005",0.8,-0.1,1.4,0,null,0.0],["ctl","avg1_119","a",null,null,null,null,null,0.9,null,"Linear",0.5],["se","se_146"],["ctl","avg1_145","a","007",null,null,null,null,null,"chijing","Linear",0.5],["say","avg1_145","Nanoha...?!==W== Are you and Nano—==W==no, are you and that maid that close?",0,""],["w",1.0],["ctl","avg1_145","a","006",null,null,null,null,1.0,null,"OutSine",0.5],["goon"],["w",0.5],["ctl","avg1_119","a",null,null,null,null,null,0.0,null,"Linear",0.5],["ctl","avg1_145","a","009",null,null,-0.25,1.3,1.0,null,"OutSine",0.3],["goon"],["w",0.5],["ctl","avg1_145","a","006","question",null,null,null,null,null,"Linear",0.5],["say","avg1_145","As far as I know, you've only met her once. Why are you so worried about some maid?",0,""],["w",0.5],["mrt",1,"ac","012",null,"jushou2"],["say","avg3_100","We've only met once, but we helped each other out. If you attacked Goodwind Homecare because I was going to see her, then I'm responsible.",1,""],["mrt",3,"ac",null,null,null],["w",0.5],["ctl","avg1_145","a","004","happy",null,null,null,null,null,"Linear",0.5],["say","avg1_145","Hilarious. Your own life is on the line, and you're worried about a stranger you've met once.",0,""],["ctl","avg1_145","a","012","sweaty",null,null,null,null,null,"Linear",0.5],["say","avg1_145","Are you some legendary \"saint\" of the Grace Imperium? Didn't think I'd see a walking myth today.",0,""],["w",0.5],["mrt",1,"ac","009",null,null],["say","avg3_100","This is between your employer and me. It has nothing to do with Goodwind Homecare.",1,""],["se","se_176"],["mrt",0,"ac","005",null,null],["say","avg3_100","If innocent people get dragged into this and put in danger, I won't forgive you.",1,""],["mrt",3,"ac",null,null,null],["w",0.5],["ctl","avg1_145","a","007","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_145","...",0,""],["ctl","avg1_145","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_145","What if...==W== What if that maid is in on it with me?",0,""],["w",0.5],["ctl","avg1_145","a","008",null,null,null,null,1.0,null,"OutSine",0.5],["goon"],["w",0.5],["mrt",1,"ac","012",null,null],["say","avg3_100","Nanoha isn't like that.",1,""],["mrt",3,"ac",null,null,null],["w",0.5],["ctl","avg1_145","a","002","happy",null,null,null,null,null,"Linear",0.5],["say","avg1_145","Isn't she? What do you even know about her?==W== Every Goodwind maid is raised in a world of endless scheming and crushing expectations. No exceptions.",0,""],["w",0.5],["ctl","avg1_145","a","009","exclamation",null,null,null,1.0,"jushou2","OutSine",0.5],["goon"],["ctl","avg1_145","a","005","sweaty",null,null,null,null,null,"Linear",0.5],["say","avg1_145","Trusting her blindly after one meeting... How naive.",0,""],["w",0.5],["mrt",1,"ac","018",null,null],["say","avg3_100","I might not be good at much, but I do know how to read people. I trust her.",1,""],["mrt",0,"ac","010","sigh",null],["say","avg3_100","Besides. Even though you tied me up, I'm getting the same vibe from you. Strange, isn't it?",1,""],["mrt",3,"ac",null,null,null],["w",0.5],["se","se_146"],["ctl","avg1_145","a","006",null,null,0.0,1.0,null,"chijing","Linear",0.3],["say","avg1_145","Me and ... Nanoha? Same vibe?",0,""],["w",0.5],["mrt",1,"ac","002",null,null],["say","avg3_100","Yeah. That's why I tested you with my question.",1,""],["mrt",0,"ac","014","music",null],["say","avg3_100","And your reaction gave you away. You're a good person.",1,""],["mrt",0,"ac","013",null,null],["say","avg3_100","You keep threatening my life, but you haven't yet pointed that gun at me once.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_145","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["obj","qstory_main_06x5_003_FP",0,null,null],["mrt",2,"ac","020",null,null],["say","avg3_100","You even sent that cute drawing days in advance. Disguised as a threat, but meant as a warning.",1,""],["objx"],["w",0.5],["mrt",0,"ac","014","question",null],["say","avg3_100","Why wouldn't I trust someone like that?",1,""],["mrt",3,"ac",null,null,null],["w",0.5],["ctl","avg1_145","a","012","sweaty",null,null,null,1.0,"lengzhan2","Linear",0.5],["say","avg1_145","Still talking about trust... You are unbelievable.",0,""],["w",0.5],["ctl","avg1_145","a",null,"speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_145","...",0,""],["ctl","avg1_145","a","004","sigh",null,null,null,null,"JuGong1","Linear",0.5],["say","avg1_145","I came here to figure you out, but you completely flipped the script. How unexpected.",0,""],["w",0.5],["mrt",1,"ac","002",null,null],["say","avg3_100","I already know your true nature. But tell me... Have you figured me out?",1,""],["mrt",3,"ac",null,null,null],["w",0.5],["bgm",""],["ctl","avg1_145","a",null,"speechless",null,null,null,null,null,"Linear",0.5],["w",1.5],["ctl","avg1_145","a","006","attention",null,null,null,null,null,"Linear",0.5],["say","avg1_145","... Hey. Got any money on you?",0,""],["w",0.5],["mrt",1,"ac","020",null,null],["say","avg3_100","Some pocket change, maybe.",1,""],["mrt",3,"ac",null,null,null],["w",0.5],["ctl","avg1_145","a","009",null,null,null,null,null,null,"Linear",0.5],["say","avg1_145","Name a number. Anything works.",0,""],["w",0.5],["se","se_087"],["mrt",1,"ac","002",null,null],["say","avg3_100","Then ... a thousand Dorra? That's all I have.",1,""],["mrt",3,"ac",null,null,null],["w",0.5],["se","