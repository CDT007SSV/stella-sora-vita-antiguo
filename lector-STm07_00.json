null,null],["w",0.2],["ctl","avg3_220","a","002","shock",null,null,null,null,"diantou","Linear",0.35],["w",0.35],["say","avg3_220","Speaking of HQ... I'm due for a check-in. Operator, patch me through to Geminia.",0,""],["ctl","avg3_220","a",null,null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["trn",0,0,true,true,0.75],["w",0.25],["se","se_142"],["w",1.95],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["stage",1,0,0],["bg","story_main_02_022",1,0.0],["bg","hotel_senior_office",0,0.0],["cbg",0,200.0,null,1.2,"Linear",0.0,null,null,null],["show","avg3_220","a","002",0.7,-0.08,1.1,0,null,null],["se","se_408"],["w",1.6],["se","se_408_stop"],["w",0.1],["trn",1,0,false,false,0.7],["w",0.1],["se","se_342"],["w",0.5],["bgm","m46"],["say","Slightly Coquettish Voice","Mercurio! Took you long enough. How's the cleanup going in Philae?",0,""],["w",0.5],["se","se_077"],["ctl","avg3_220","a","010",null,null,null,null,null,"diantou","OutSine",0.4],["w",0.4],["say","avg3_220","Madame CEO. Thanks to Sales, we have a stable client base. We've also signed three high-profile executive clients in the past two days—they should open doors to lucrative new networks.",0,""],["w",0.4],["se","se_029"],["w",0.4],["say","Omnisky Aegis CEO","Not bad! While every other branch is tanking from the bad press, you swoop in and actually boost the numbers... Oh, I can picture the twisted looks on the Senators' faces. It's going to be a treat.",0,""],["w",0.4],["ctl","avg3_220","a","005","exclamation",null,null,null,null,"jushou","OutSine",0.4],["w",0.4],["say","avg3_220","Let's not forget that ten days ago, I formally proposed we attend Firenze's banquet. Like it or not, she's the one running Philae now.",0,""],["w",0.4],["ctl","avg3_220","a","009","awkward",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg3_220","But the Senate shot it down so as to not \"upset United Harvest HQ.\" That refusal is exactly what allowed the Desert Scorpions to slip in, disguised as our staff.",0,""],["w",0.4],["stage",1,1,1],["w",0.6],["ctl","avg3_220","a","005","attention",0.5,-0.15,1.2,null,"daintou","OutQuad",0.6],["w",0.4],["say","avg3_220","Furthermore, I've confirmed that the impersonation plot was orchestrated by a United Harvest executive gunning for Firenze's job. They certainly weren't worried about damaging relations with us.",0,""],["w",0.4],["ctl","avg3_220","a","003","music",null,null,null,null,"diantou","OutSine",0.35],["w",0.35],["say","avg3_220","I've compiled the full details into a new report. A Trekker is already en route to Geminia with it.",0,""],["w",0.4],["trn",0,0,true,true,0.8],["w",0.8],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["bg","story_main_02_022",0,0.0],["trn",1,0,false,false,0.8],["w",0.4],["se","se_055"],["say","Omnisky Aegis CEO","...",0,""],["w",0.5],["se","se_030"],["w",0.4],["say","Omnisky Aegis CEO","Sigh... My foolish little sister. You know that cold, abrasive attitude is exactly why you've been stuck in middle management all these years, right?",0,""],["w",0.4],["trn",0,0,false,false,0.7],["w",0.7],["bg","hotel_senior_office",0,0.0],["cbg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["show","avg3_220","a","003",null,-0.11,1.15,0,null,0.0],["trn",1,0,false,false,0.7],["w",0.15],["ctl","avg3_220","a",null,"question",null,null,null,1.0,null,"OutSine",0.5],["w",0.25],["say","avg3_220","And you? My naive big sister. The Senate didn't give you that chair for your brains. They put you there because you're a pushover—a perfect rubber stamp.",0,""],["w",0.5],["stage",1,0,0],["se","se_087"],["ctl","avg3_220","a",null,null,0.7,null,null,null,null,"OutBack",0.7],["w",0.3],["say","Omnisky Aegis CEO","Heh... Maybe I am a \"rubber stamp.\" But isn't it your job to add value to worthless things?",0,""],["say","Omnisky Aegis CEO","Speaking of work, how are you boosting sales in this mess? Public opinion is eating us alive with these rumors about colluding with the Desert Scorpions.",0,""],["w",0.4],["ctl","avg3_220","a","004","happy",null,null,null,null,"daintou","OutSine",0.5],["w",0.5],["say","avg3_220","The Desert Scorpion is the biggest bandit syndicate in the northwest. Is it really such a bad thing for an insurance company to have a ... dangerous reputation?",0,""],["w",0.5],["stage",1,1,1],["w",0.15],["se","se_021"],["ctl","avg3_220","a","010",null,0.6,null,null,null,null,"OutCubic",0.6],["obj","qstory_main_07_001",1,0.35,0.54],["w",0.35],["say","avg3_220","Who do you think fed Scarlet Sights those stories? I've personally sat down with half a dozen witches this week.",0,""],["w",0.5],["ctl","avg3_220","a","012","love",null,null,null,null,"jushou","OutSine",0.4],["w",0.4],["say","avg3_220","We should launch new security and property packages in the Western Region immediately. Fear sells, and people will eat up whatever we offer for months.",0,""],["w",0.4],["objx"],["trn",0,0,true,true,0.7],["w",0.9],["bg","story_main_02_022",0,0.0],["cbg",0,null,-20.0,null,"Linear",0.0,null,null,null],["trn",1,0,false,false,0.7],["w",0.3],["se","se_030"],["tsk","Xiao"],["say","Omnisky Aegis CEO","Wait, you leaked that? Won't that just drag our name through the mud even more?",0,""],["chd",0,2,"avg3_220","a","004","music"],["w",0.5],["say","avg3_220","A scandal this big runs with or without us. By flooding them with interviews, we control the narrative and spin it to our advantage.",0,""],["chd",1,2,"avg3_220","a","002",null],["w",0.4],["se","se_055"],["say","Omnisky Aegis CEO","Ruthlessly exploiting your own scandal ... even for the good of the company. Heh, you really are a terrifying kid.",0,""],["w",0.5],["se","se_087"],["say","Omnisky Aegis CEO","Anyway, good news. Since the Senate completely misread the room at the Philae banquet, those old fossils are finally loosening their grip.",0,""],["w",0.5],["say","Omnisky Aegis CEO","You have full access to company resources now. The only condition is to fix this mess with the Desert Scorpions impersonating our staff.",0,""],["w",0.4],["se","se_169"],["trn",0,1,false,false,0.7],["w",0.7],["stage",1,0,0],["bg","hotel_senior_office",0,0.0],["cbg",0,-90.0,null,1.05,"Linear",0.0,null,null,null],["show","avg3_220","a","002",0.7,-0.11,1.15,0,null,0.0],["w",0.4],["trn",1,1,false,false,0.8],["w",0.2],["ctl","avg3_220","a",null,"star",null,null,null,1.0,null,"OutCubic",0.6],["w",0.6],["bgm",""],["say","avg3_220","Rest easy. I've got a plan.",0,""],["w",0.4],["se","se_342"],["ctl","avg3_220","a","003",null,null,null,null,null,"diantou","OutSine",0.3],["stage",1,1,1],["w",0.75],["obj","qstory_main_07_001",1,0.35,0.54],["se","se_021"],["ctl","avg3_220","a","002",null,0.62,-0.14,1.2,null,null,"OutCubic",0.7],["w",0.5],["say","0","Mercurio's finger slides across the screen, stopping on a Scarlet Sights headline.",0,""],["objx"],["w",0.5],["cbg",0,30.0,null,null,"OutCubic",0.6,null,null,null],["ctl","avg3_220","a","004","star",0.5,-0.23,1.32,null,null,"OutCubic",0.6],["say","avg3_220","The best way to bury bad news ... is to create an even bigger one.",0,""],["w",0.5],["end"]]}