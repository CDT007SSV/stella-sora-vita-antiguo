ll,0.5,-0.2,1.33,null,null,"OutCubic",0.7],["w",0.4],["mrt",2,"y","002","exclamation",null],["say","avg3_100","You flushed them out deliberately.",1,""],["mrt",3,"y",null,null,null],["w",0.5],["se","se_077"],["ctl","avg3_215","a","003",null,null,null,null,null,"diantou","OutSine",0.4],["w",0.4],["say","avg3_215","Having them abandon that room worked in my favor.",0,""],["w",0.3],["ctl","avg3_215","a",null,null,null,null,null,null,null,"OutSine",0.4],["say","avg3_215","Which proves ...==W== coming to you for help was the right call.",0,""],["w",0.5],["fx",0,"fx_avg_bling",0,0],["w",0.15],["ctl","avg3_215","a","004","star",null,-0.25,1.42,null,"diantou","OutQuad",0.35],["w",0.35],["goon"],["bgm",""],["w",0.5],["fx",0,"fx_avg_bling",1,0],["ctl","avg3_215","a",null,"question",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg3_215","I admire your competence. On that note... Could I ask for one more favor?",0,""],["w",0.5],["se","se_252"],["ctl","avg3_215","a",null,null,0.65,null,null,null,null,"OutCubic",0.7],["w",0.25],["obj","qstory_main_06_024",1,0.35,0.54],["w",0.35],["say","0","Matilda takes a file from Nyx and solemnly hands it over.",0,""],["w",0.4],["bgm","m101"],["ctl","avg3_215","a","003",null,null,null,null,null,"diantou","OutSine",0.35],["say","avg3_215","This represents a forty-one percent stake in the Philae branch.",0,""],["w",0.5],["mrt",1,"y","021","speechless",null],["say","avg3_100","Forty-one percent? Don't tell me you expect me to buy this off you.",1,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg3_215","a","002","idea",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","avg3_215","I do. That was the plan all along.",0,""],["w",0.4],["objx"],["ctl","avg3_215","a","004","attention",0.5,null,null,null,"daintou","OutSine",0.6],["w",0.5],["say","avg3_215","Samuel held these shares forty-five years ago. He sold his stake in United Harvest, but kept a piece of the Philae branch.",0,""],["say","avg3_215","Those of us left over from the old guard inherited this forty-one percent directly from him.",0,""],["w",0.4],["ctl","avg3_215","a","003",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg3_215","Headquarters holds forty-nine percent, leaving the final ten percent to the Senate representative of the Philae branch.",0,""],["w",0.5],["ctl","avg3_215","a","004","idea",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","avg3_215","If that representative aligns with our faction, we secure a fifty-one percent majority and take control of the branch.",0,""],["say","avg3_215","But if they side with headquarters, HQ commands fifty-nine percent, and the branch becomes their puppet.",0,""],["w",0.4],["mrt",2,"y","020","speechless",null],["say","avg3_100","The shares Samuel kept versus those allocated to the Senators... It's too deliberate.",1,""],["w",0.4],["mrt",0,"z","002","exclamation","jushou"],["say","avg3_100","Almost like he saw this coming. Like he wanted to forge this city into a crucible, forcing both sides to clash and challenge each other.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_215","a","003",null,null,null,null,null,null,"OutSine",0.4],["w",0.4],["say","avg3_215","Sharp as ever, Boss. You hit the mark perfectly.",0,""],["w",0.5],["ctl","avg3_215","a","002",null,null,null,null,null,null,"OutSine",0.4],["say","avg3_215","Even so, the New Orelian faction has held the Senate majority for forty-five years. The Speaker's role always goes to a headquarters appointee.",0,""],["w",0.5],["ctl","avg3_215","a","003","sigh",null,null,null,null,"lengzhan","OutSine",0.4],["w",0.4],["say","avg3_215","It's kept our faction backed into a corner... But we can't afford a clean break. If food production crashes, the people will starve.",0,""],["w",0.4],["bgm",""],["ctl","avg3_215","a","002",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg3_215","We had to swallow our pride and accept the status quo.==W== But your arrival changes the game.",0,""],["w",0.5],["ctl","avg3_215","a","004","flower",null,null,null,null,"jushou","OutSine",0.4],["goon"],["w",0.4],["ctl","avg3_215","a",null,null,0.65,null,null,null,null,"OutCubic",0.7],["show","avg3_134","a","004",0.46,-0.21,1.3,0,null,0.0],["ctl","avg3_134","a",null,null,0.33,null,null,0.8,null,"OutCubic",0.7],["w",0.4],["bgm","m79"],["mrt",1,"y","009",null,null],["say","avg3_100","I wouldn't say that... The one turning the tides here is Mina, your branch representative.",1,""],["w",0.5],["ctl","avg3_134","a","003",null,null,null,null,null,null,"OutSine",0.35],["mrt",0,"y","024",null,null],["say","avg3_100","I don't know about her politics, but I do know that she wants the company to produce better food, and I back that.",1,""],["w",0.5],["ctl","avg3_134","a","002",null,null,null,null,null,null,"OutSine",0.35],["mrt",0,"y","023",null,null],["say","avg3_100","Her raw conviction is just like Samuel when he founded United Harvest.",1,""],["w",0.5],["ctl","avg3_134","a",null,null,0.23,null,null,0.0,null,"OutCubic",0.7],["hide","avg3_134",0.7],["ctl","avg3_215","a",null,null,0.5,null,null,null,null,"OutCubic",0.7],["mrt",0,"z","002","attention","daintou"],["say","avg3_100","Setting that aside, even if we wanted to buy those shares, the capital is a massive hurdle...",1,""],["w",0.5],["mrt",0,"z","010","sigh","lengzhan"],["say","avg3_100","I hate admitting this, but I rarely carry more cash than the allowance Iris gives me. Speaking of... Iris, what's our current bank balance?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["chd",0,0,"avg1_111","a","007","speechless"],["w",0.35],["say","avg1_111","Um... Fifty-one thousand and one Dorra.",0,""],["chd",1,0,"avg1_111","a","002",null],["w",0.4],["mrt",2,"z","002",null,null],["say","avg3_100","As you see, Boss Accord isn't exactly flush with cash.==W== Matilda, what's the actual market value of those shares?",1,""],["w",0.6],["mrt",0,"y","012","question",null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_215","a","009","sweaty",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg3_215","At current rates? Roughly fifty billion Dorra.",0,""],["bgm",""],["w",0.4],["stg",0,-90.0,null,null,"OutCubic",0.7,null,null,null],["se","se_148"],["trn",0,0,true,true,0.71],["w",0.71],["bg","dulcia_office_inside",0,0.0],["stg",0,90.0,null,1.05,"Linear",0.0,null,null,null],["w",0.05],["trn",1,0,false,false,0.7],["stg",0,-180.0,null,1.1,"OutBack",0.7,null,null,null],["w",0.1],["show","avg1_111","a","007",0.7,-0.07,1.1,0,null,0.0],["ctl","avg1_111","a",null,"symbol",0.58,null,null,1.0,null,"OutCubic",0.6],["w",0.45],["say","avg1_111","F-Fifty billion Dorra?! Fifty billion! Do you know how many zeros that is?!",0,""],["w",0.4],["se","se_356"],["ctl","avg1_111","a",null,null,null,null,null,null,"lengzhan","OutSine",0.4],["w",1.1],["stg",0,90.0,null,1.05,"OutCubic",0.7,null,null,null],["show","avg1_103","c","008",0.2,-0.07,1.1,0,null,0.0],["ctl","avg1_103","c",null,"flurry",0.33,null,null,1.0,"tiao2","OutQuad",0.85],["w",0.5],["say","avg1_103","Iris, short-circuited.",0,""],["w",0.4],["trn",0,0,true,true,0.7],["w",0.7],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["bg","dulcia_office_inside",0,0.0],["cbg",0,null,null,1.05,"Linear",0.0,null,null,null],["show","avg3_215","a","002",null,-0.2,1.32,0,null,null],["trn",1,0,false,false,0.7],["w",0.3],["mrt",2,"z","002","exclamation",null],["say","avg3_100","Yeah, fifty billion is astronomical. We can't afford that. Honestly, I can't even process a number that high.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["bgm",""],["ctl","avg3_215","a","003",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg3_215","You don't need to worry about the upfront cost.==W== Boss, have you heard the Grace Imperium opened bidding for the Monolith?",0,""],["w",0.5],["ctl","avg3_215","a","002","shock",null,null,null,null,null,"OutSine",0.4],["w",0.4],["goon"],["ctl","avg3_215","a",null,null,null,null,null,null,null,"OutSine",0.4],["w",0.4],["mrt",1,"y","020","question",null],["say","avg3_100","Yeah. The auction to decide who gets operating rights to the Philae Monolith for the next decade?",1,""],["mrt",3,"y",null,null,null],["w",0.5],["bgm","m46"],["se","se_077"],["ctl","avg3_215","a","003",null,null,null,null,null,"diantou","OutSine",0.4],["w",0.2],["say","avg3_215","Correct. But we are only a branch office. Without authorization from a parent company holding a Seal of Grace, we can't even enter the bid.",0,""],["w",0.4],["ctl","avg3_215","a","009","vexation",null,null,null,null,"lengzhan","Linear",0.5],["say","avg3_215","And given the New Orelian faction's recent stunts, they'd never sign off on our request.",0,""],["say","avg3_215","If we lose access to the Philae Monolith, whoever wins the bid will use the Artifacts it produces to crush us.",0,""],["w",0.4],["mrt",2,"y","002","attention",null],["say","avg3_100","What do you need from me?",1,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg3_215","a","004","flower",null,-0.28,1.45,null,null,"OutSine",0.4],["w",0.4],["say","avg3_215","I'll discount these shares down to thirty billion Dorra. A ninety-nine-year payment plan, with a one-Dorra down payment.",0,""],["w",0.35],["se","se_077"],["ctl","avg3_215","a","003",null,null,null,null,null,"diantou","OutSine",0.4],["w",0.4],["say","avg3_215","There's one condition.==W== To get us into that auction, I need you to use your Seal of Grace and sponsor us. We need your backing.",0,""],["w",0.6],["ctl","avg3_215","a","004","shy",null,null,null,null,"lengzhan","OutSine",0.3],["w",0.3],["goon"],["w",0.5],["mrt",1,"y","020","speechless",null],["say","avg3_100","Even then, that's roughly three hundred million Dorra a year.",1,""],["w",0.5],["mrt",0,"z","003","sigh","diantou"],["say","avg3_100","Don't you think that's a bit steep for a company with exactly fifty-one thousand and one Dorra in the bank?",1,""],["w",0.4],["mrt",0,"z","002","attention","daintou"],["say","avg3_100","I get th