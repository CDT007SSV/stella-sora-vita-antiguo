,null,null,null,null,null,"OutSine",0.35],["w",0.35],["mrt",2,"z","012","question",null],["say","avg3_100","What's wrong, Firenze?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_110","c","009","attention",null,null,null,null,"daintou","OutSine",0.35],["w",0.35],["say","avg1_110","Remember our talk about finding someone to watch your back?",0,""],["w",0.35],["mrt",1,"y","002","idea",null],["say","avg3_100","Yeah. You said you'd look around on your end.",1,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_110","c","011","awkward",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg1_110","I have. Sadly, I haven't found anyone suitable.",0,""],["w",0.5],["ctl","avg1_110","c","010","sigh",null,null,null,null,"diantou","OutSine",0.3],["say","avg1_110","But we're heading into the Philae Monolith next. It's incredibly dangerous, for real. I'd rather gather a full team and prep everything before we make a move.",0,""],["w",0.35],["chd",0,2,"avg1_112","a","006","question"],["w",0.3],["say","avg1_112","Huh? Is it that dangerous? We used it as a hideout before.",0,""],["w",0.35],["ctl","avg1_110","c","016","flurry",null,null,null,null,"chijing","OutSine",0.5],["say","avg1_110","You didn't go deep enough to feel it. If you had gone further in, you'd understand why they sealed that tower.",0,""],["w",0.35],["chd",0,0,"avg1_111","b","007","symbol"],["w",0.35],["say","avg1_111","Sealed?",0,""],["chd",1,0,"avg1_111","a","002",null],["chd",1,2,"avg1_112","a","002",null],["w",0.35],["stg",0,null,-25.0,1.25,"OutCubic",0.7,null,null,null],["w",0.15],["ctl","avg1_110","c","010","sigh",null,null,null,null,"chijing","OutSine",0.4],["w",0.4],["say","avg1_110","Yeah. This was six years ago. I was still a student, so I only heard bits and pieces from my father.",0,""],["w",0.35],["ctl","avg1_110","c","009",null,0.7,null,null,null,null,"OutCubic",0.7],["w",0.15],["bg","tower_entrance",0,0.6],["cbg",0,250.0,null,1.2,"Linear",0.0,null,null,null],["cbg",0,10.0,null,null,"Linear",20.0,null,null,null],["w",0.6],["say","avg1_110","During the last ten-year cycle, the Philae Monolith belonged to United Harvest.",0,""],["w",0.35],["se","se_169"],["trn",0,0,false,false,0.7],["w",0.7],["ctl","avg1_110","c",null,null,null,null,null,0.75,null,"Linear",0.0],["bg","tower_wishbox_room",0,0.0],["cbg",0,-180.0,0.0,1.1,"Linear",0.0,null,null,null],["w",0.05],["trn",1,0,false,false,0.7],["cbg",0,-280.0,null,null,"Linear",15.0,null,null,null],["w",0.6],["say","avg1_110","But one day, a Trekker squad from the Philae branch wished for an Artifact that never should have existed. It was a massive violation of the Grace Imperium.",0,""],["w",0.35],["bg","tower_intel",0,0.7],["cbg",0,280.0,null,1.1,"Linear",0.0,null,null,null],["cbg",0,180.0,null,null,"Linear",15.0,null,null,null],["w",0.6],["ctl","avg1_110","c",null,null,null,null,null,null,null,"OutSine",0.35],["say","avg1_110","After that, they locked down the lake island Monolith and shut off the cable cars.",0,""],["w",0.35],["ctl","avg1_110","c",null,null,null,null,null,0.0,null,"OutCubic",0.7],["hide","avg1_110",0.7],["film",0],["w",0.15],["bg","traveller_camp_a_daylight",0,0.7],["cbg",0,90.0,null,1.05,"Linear",0.0,null,null,null],["cbg",0,-40.0,null,null,"Linear",10.0,null,null,null],["w",0.45],["say","avg1_110","United Harvest had to start relying on Trekkers bringing Artifacts from the Wilds. That's actually how the Trekker Camp boomed...",3,""],["w",0.5],["clear",0,0,1],["w",0.45],["film",1],["stg",0,null,null,1.05,"OutCubic",0.7,null,null,null],["w",0.1],["bg","dulcia_office_inside",0,0.7],["cbg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["w",0.2],["show","avg1_110","c","010",null,-0.1,1.15,0,null,0.0],["ctl","avg1_110","c",null,"sigh",null,null,null,1.0,null,"OutCubic",0.6],["w",0.6],["say","avg1_110","But that's beside the point.",0,""],["w",0.35],["ctl","avg1_110","c",null,null,null,null,null,null,null,"OutCubic",0.4],["stg",0,300.0,null,1.2,"OutCubic",0.7,null,null,null],["w",0.2],["show","avg1_111","b","002",0.16,-0.035,1.05,0,null,0.0],["ctl","avg1_111","b",null,"attention",0.25,null,null,1.0,null,"OutCubic",0.5],["say","avg1_111","I see. So that's the danger. Six years without a single wish is definitely a problem. In a Monolith dormant for that long, anything could happen.",0,""],["w",0.35],["ctl","avg1_110","c","017",null,null,null,null,null,null,"OutSine",0.3],["stg",0,0.0,null,1.1,"OutCubic",0.7,null,null,null],["w",0.2],["show","avg1_112","a","006",0.9,-0.035,1.05,0,null,0.0],["ctl","avg1_112","a",null,"question",0.8,null,null,1.0,null,"OutCubic",0.6],["w",0.45],["say","avg1_112","What kind of Artifact breaks the rules like that?",0,""],["w",0.35],["ctl","avg1_111","b",null,null,0.16,null,null,0.0,null,"OutCubic",0.7],["hide","avg1_111",0.7],["ctl","avg1_112","a",null,null,0.9,null,null,0.0,null,"OutCubic",0.7],["hide","avg1_112",0.7],["stg",0,null,-80.0,1.25,"OutCubic",0.7,null,null,null],["w",0.15],["ctl","avg1_110","c","012","awkward",null,null,null,null,"lengzhan","OutQuad",0.4],["w",0.4],["bgm",""],["say","avg1_110","No idea. HQ locked it down as top secret. There isn't a record of it in the Philae archives.",0,""],["w",0.35],["ctl","avg1_110","c",null,null,0.65,null,null,0.0,null,"OutCubic",0.75],["hide","avg1_110",0.75],["bgm","m57"],["cbg",0,260.0,null,1.15,"OutCubic",0.75,null,null,null],["w",0.05],["show","avg3_152","a","013",0.3,null,1.05,0,null,0.0],["ctl","avg3_152","a",null,null,0.4,-0.027,1.1,1.0,null,"OutCubic",0.7],["w",0.4],["mrt",2,"z","002","question",null],["say","avg3_100","Bastelina, do you know anything about this?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["cbg",0,100.0,null,null,"OutCubic",0.65,null,null,null],["ctl","avg3_152","a","014","flurry",0.51,null,null,null,"daintou","OutQuad",0.65],["w",0.65],["say","avg3_152","Eh? Even cute little Bastelina doesn't have the answer to that! I only joined the Grace Imperium this year, and my seniors have never brought it up. It's probably a taboo.",0,""],["w",0.35],["ctl","avg3_152","a","011","shock",null,null,null,null,"jushou","OutCubic",0.35],["w",0.35],["say","avg3_152","But speaking of bodyguards, why don't you just ask her, Boss?",0,""],["ctl","avg3_152","a",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.35],["mrt",1,"y","002","question",null],["say","avg3_100","Her?",1,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg3_152","a","007","music",null,-0.17,1.3,null,"diantou","OutSine",0.32],["w",0.32],["say","avg3_152","Yeah! When I got here this morning, I saw her standing by the river over there. Looked like she was praying for something.",0,""],["bgm",""],["w",0.35],["se","se_076"],["trn",0,3,true,true,1.0],["w",1.0],["bg","philae_street_grey_daylight",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,1.1,"Linear",0.0,null,null,null],["w",0.6],["fx",0,"fx_avg_wisteria_right",0,1],["cbg",0,null,null,1.0,"OutSine",5.5,null,null,null],["trn",1,3,true,false,1.0],["w",0.15],["se","se_440"],["w",1.5],["head","08:30, Venatio Month 14th, Silver District in Philae, Path by the River"],["say","0","I follow Bastelina down an alley just outside United Harvest Philae.",0,""],["w",0.35],["se","se_060"],["film",0],["w",0.1],["stg",0,null,null,null,"Linear",0.0,null,null,"JingTouYaoHuang"],["bg","hotel_daylight",0,0.9],["cbg",0,700.0,900.0,1.8,"OutSine",0.0,null,null,null],["cbg",0,null,800.0,null,"OutSine",13.0,null,null,null],["show","avg3_152","a","002",null,0.4,1.7,0,null,0.0],["ctl","avg3_152","a",null,null,null,null,null,1.0,null,"OutSine",0.8],["ctl","avg3_152","a",null,null,null,0.5,1.5,null,"manbu_loop","OutSine",13.0],["w",1.5],["say","avg3_152","Over there, Boss.",3,""],["w",0.5],["clear",0,0,1],["w",0.4],["film",1],["w",0.3],["se","se_169"],["trn",0,1,true,true,0.9],["w",0.9],["stg",0,null,null,null,"Linear",0.0,null,null,"stop"],["bg","BG_Black",0,0.0],["fx",0,"fx_avg_wisteria_right",1,1],["w",0.4],["bgm","m75"],["trn",1,1,false,false,0.9],["bg","story_main_07_001",6,0.0],["cbg",6,-100.0,700.0,2.2,"Linear",0.0,null,null,null],["stage",6,0,0],["bg","BG_Black",5,0.0],["cbg",6,null,650.0,null,"OutSine",4.5,null,null,null],["w",2.0],["bg","BG_Black",6,0.6],["w",0.4],["bg","story_main_07_001",5,0.7],["cbg",5,-100.0,200.0,2.2,"Linear",0.0,null,null,null],["cbg",5,null,150.0,null,"OutSine",4.5,null,null,null],["stage",5,0,16],["w",0.8],["mrt",2,"z","025","symbol",null],["say","avg3_100","Is that...",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_437"],["trn",0,1,false,false,0.9],["w",0.9],["stage",5,1,1],["stage",6,1,1],["bg","story_main_07_001",0,0.0],["cbg",0,null,null,1.3,"Linear",0.0,null,null,null],["fx",0,"fx_avg_wisteria_right",0,1],["w",0.3],["trn",1,1,false,false,0.9],["cbg",0,null,null,1.0,"OutSine",45.0,null,null,null],["w",0.9],["say","avg1_144","O Guardian of Goodwind, hear my prayer. Wash away all misfortune, sin, and impurity. With deepest reverence, I ask of you:",9,"vo_STm07_06_001"],["w",0.5],["clear",0,0,1],["w",0.35],["say","avg1_144","Please keep my ==SEX11== safe and grant ==SEX4== good health. May ==SEX3== journey be smooth and grant ==SEX4== lasting blessings.",9,"vo_STm07_06_002"],["w",0.5],["clear",0,0,1],["w",0.35],["say","avg1_144","Should misfortune find my ==SEX11==, let it strike me instead.",9,"vo_STm07_06_003"],["w",0.5],["clear",0,0,1],["w",0.35],["say","avg1_144","Should enemies stand in ==SEX3== way, let me be the blade that strikes them down.",9,"vo_STm07_06_004"],["w",0.5],["clear",0,0,1],["w",0.35],["say","avg1_144","I beg of you... Mend our severed fate, and bind me to my ==SEX11== once more. I humbly pray.",9,"vo_STm07_06_005"],["w",0.5],["clear",0,0,1],["w",0.35],["say","avg1_144","Phew. I've lost count of how many prayers I've offered since coming here. Yet my ==SEX11== and I remain apart.",9,"vo_STm07_06_006"],["w",0.5],["clear",0,0,1],["w",0.35],["say","avg1_144","Why... Why won't it work?",9,"vo_STm07_06_007"],["w",0.5],["clear",0,0,1],["bgm",""],["w",0.35],["trn",0,0,false,false,0.8],["w",0.8],["fx",0,"fx_avg_wisteria_right",1,1],["bg","BG_Black",0,0.0],["show","avg1_144","c","010",null,-0.25,1.35,0,null,0.0],["trn",1,0,false,false,0.8],["w",0.2],["ctl","avg1_144","c",null,"shy",null,null,null,1.0,"ChanDou","OutCubic",0.5],["w",0.3],["say","avg1_144","... No, I know why.==W== I try to clear my mind to pray, but my head is just filled with thoughts of my ==SEX11==. I'm drowning in worldly attachments.",9,"vo_STm07_06_008"],["w",0.85],["ctl","avg1_144","c","003","speechless",null,null,null,null,null,"Linear",0.5],["show","avg3_100","a","022",0.2,-0.32,1.5,0,null,0.0],["ctl","avg3_100","a",null,null,null,null,null,0.5,null,"OutSine",0.7],["ctl","avg3_100","a",null,null,null,-0.27,null,null,null,"OutSine",6.0],["w",0.7],["goon"],["ctl","avg1_144","c",null,null,null,null,null,null,null,"OutSine",0.35],["w",0.4],["se","se_169"],["trn",0,1,true,true,0.9],["w",0.9],["bg","story_main_07_001",0,0.0],["fx",0,"fx_avg_wisteria_right",0,1],["trn",1,1,false,false,0.9],["w",0.6],["say","avg1_144","The Guardian of Goodwind must be exasperated with me.",9,"vo_STm07_06_009"],["w",0.5],["clear",0,0,1],["w",0.35],["say","avg1_144","Then again, I am a blade. Isn't it perfectly natural that I can't think of anything else until I'm back in the hands of my wielder?",9,"vo_STm07_06_010"],["w",0.5],["clear",0,0,1],["w",0.35],["say","avg1_144","Wait! That means these aren't worldly attachments at all! It's pure, undeniable loyalty! Oh, Guardian of Goodwind, please forgive my foolishness!",9,"vo_STm07_06_011"],["bgm",""],["w",0.5],["clear",0,0,1],["w",0.35],["se","se_520"],["trn",0,1,true,true,0.7],["w",0.7],["fx",0,"fx_avg_wisteria_right",1,1],["bg","story_main_07_002",0,0.0],["fx",0,"fx_avg_wisteria_left",0,1],["trn",1,1,false,false,0.7],["say","avg1_144","Oh...",9,"vo_STm07_06_012"],["w",0.5],["clear",0,0,1],["w",0.4],["bgm","m70"],["say","avg1_144","What a strong, soothing breeze... Is this a sign from the Guardian of Goodwind?",9,"vo_STm07_06_013"],["w",0.5],["clear",0,0,1],["w",0.4],["say","avg1_144","Cleaved in two, the rock no longer parts the current. Fallen wisteria petals simply drift through the gap, floating downstream together.",9,"vo_STm07_06_014"],["w",0.5],["clear",0,0,1],["w",0.4],["say","avg1_144","I see. My ==SEX11== and I are just like those petals. We may be separated for now, but we are destined to reunite.",9,"vo_STm07_06_015"],["w",0.5],["clear",0,0,1],["w",0.4],["say","avg1_144","O Guardian of Goodwind, thank you for showing me the way.",9,"vo_STm07_06_016"],["w",0.5],["clear",0,0,1],["w",0.35],["say","avg1_144","Still... I should be satisfied just having my prayers answered. But part of me selfishly hopes that tomorrow is the day we meet. Am I asking for too much?",9,"vo_STm07_06_017"],["bgm",""],["w",0.5],["clear",0,0,1],["w",0.35],["se","se_169"],["bg","white",0,0.7],["w",0.4],["choice",["Chitose!"],[[]]],["w",0.1],["bg","story_main_07_002",0,0.8],["w",0.6],["say","avg1_144","That voice... Is it you?",9,"vo_STm07_06_018"],["w",0.5],["clear",0,0,1],["w",0.35],["trn",0,1,false,false,0.8],["w",0.8],["fx",0,"fx_avg_wisteria_left",1,1],["bg","white",0,0.0],["trn",1,1,false,false,0.8],["w",0.4],["say","0","My ==SEX11==?!",8,"vo_STm07_06_019"],["w",0.5],["clear",0,0,1],["w",0.4],["end"]]}