"bg","story_main_07_004",0,0.7],["cbg",0,-100.0,400.0,1.25,"Linear",0.0,null,null,null],["cbg",0,0.0,-50.0,1.0,"OutBack",2.7,null,null,null],["w",0.7],["film",1],["w",0.1],["se","se_480"],["trn",0,1,false,false,1.0],["w",1.0],["stg",0,null,null,null,"Linear",0.0,null,null,"JingTouYaoHuang"],["trn",1,1,false,false,0.85],["w",0.1],["head","11:35, Venatio Month 14th, Outside Philae, Cable Car Cabin"],["say","avg1_144","My ==SEX11==, Lady Noya has secured the station. The battle is over.",9,"vo_STm07_09_001"],["w",0.35],["say","avg1_144","Despite facing so many enemies alone, she managed to defeat them all without taking a single life. Her swordsmanship was truly masterful.",9,"vo_STm07_09_002"],["w",0.35],["mrt",2,"z","007","symbol",null],["say","avg3_100","...Eh? Really?",1,""],["mrt",0,"y","009","sigh",null],["say","avg3_100","I can't even make out who's over there from this distance.==W== You've got more than just quick reflexes; your vision is on a whole different level.",1,""],["w",0.6],["mrt",0,"z","014","music","jushou"],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["show","avg1_103","a","002",0.505,-0.19,1.4,0,"shy",0.0],["w",0.35],["say","avg1_144","You flatter me. Perceive and parry the threat posed by an approaching adversary in time is simply my duty as a blade.",9,"vo_STm07_09_003"],["say","avg1_144","Since young, I was taught to think like that.",9,"vo_STm07_09_004"],["w",0.35],["mrt",2,"z","009","sigh",null],["say","avg3_100","I see. As long as everyone is unscathed...",1,""],["mrt",3,"z",null,null,null],["w",0.5],["cbg",0,-300.0,400.0,1.45,"OutCubic",0.9,null,null,null],["w",0.1],["film",0],["fx",0,"fx_speedline_center",0,0],["w",1.2],["mrt",2,"z","025","exclamation",null],["say","avg3_100","Wait, Chitose, your hand is bleeding?!",1,""],["mrt",4,"z",null,null,null],["w",0.5],["film",1],["cbg",0,0.0,-50.0,1.0,"OutCubic",0.8,null,null,null],["w",0.75],["ctl","avg1_103","a",null,"speechless",null,-0.175,null,null,null,"Linear",0.0],["say","avg1_144","Ah. I blocked the snapped steel cable swinging at you with my hand.",9,"vo_STm07_09_005"],["ctl","avg1_103","a",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.35],["say","avg1_144","Do not worry, my ==SEX11==. A minor chipped edge hardly impairs my function. Please continue to wield me in battle without hesitation.",9,"vo_STm07_09_006"],["w",0.35],["cbg",0,-50.0,-200.0,1.2,"OutCubic",0.7,null,null,null],["w",0.45],["mrt",2,"z","026","resentful",null],["say","avg3_100","I don't care about the battles! I care about you!",1,""],["w",0.35],["mrt",0,"y","010","sigh","lengzhan"],["say","avg3_100","Seriously... I appreciate your desire to protect me, but you need to start valuing your own life too...",1,""],["mrt",3,"y",null,null,null],["show","avg1_144","d","008",null,-0.5,1.6,5,null,null],["bg","wild_tower_daylight",5,0.0],["cbg",5,-1400.0,-500.0,2.5,"Linear",0.0,null,null,null],["w",0.5],["bg","BG_Black",0,0.7],["w",0.3],["stage",5,0,14],["cbg",5,-1700.0,null,null,"Linear",40.0,null,null,null],["ctl","avg1_144","d",null,"awkward",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg1_144","Uh... Yes, my ==SEX11==.",9,"vo_STm07_09_007"],["w",0.45],["mrt",2,"y","020","question",null],["say","avg3_100","Chitose, with that bottomless bedroll of yours, didn't you pack any bandages or medicine?",1,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_144","c","010","shy",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg1_144","Thank you for your concern, my ==SEX11==. To my shame, I exhausted my supply of hilt-wrapping bandages during my training...",9,"vo_STm07_09_008"],["w",0.35],["ctl","avg1_144","c","003",null,null,null,null,null,"diantou","OutSine",0.35],["w",0.35],["say","avg1_144","Please, pay it no mind. I am a blade, and a blade does not bleed. This blood merely proves that my training is insufficient.",9,"vo_STm07_09_009"],["w",0.45],["mrt",1,"z","002",null,null],["say","avg3_100","Chitose. What did I just tell you to value?",1,""],["mrt",3,"z",null,null,null],["w",0.35],["ctl","avg1_144","c","004","idea",null,null,null,null,"jushou","Linear",0.35],["w",0.35],["say","avg1_144","Ah... My... My own life...",9,"vo_STm07_09_010"],["w",0.7],["clear",0,0,1],["stage",5,1,15],["w",0.55],["bg","story_main_07_004",0,0.7],["cbg",0,null,-50.0,null,"Linear",0.0,null,null,null],["ctl","avg1_103","a",null,"speechless",null,null,null,null,null,"Linear",0.35],["w",0.7],["say","avg1_144","My deepest apologies. I was so focused on serving my ==SEX11== that I completely forgot...",9,"vo_STm07_09_011"],["ctl","avg1_103","a",null,null,null,null,null,null,null,"OutSine",0.3],["hide","avg1_103",0.3],["w",0.35],["ctl","avg1_144","a",null,null,null,null,null,null,null,"Linear",0.0],["hide","avg1_144",0],["bgm",""],["film",0],["cbg",0,-200.0,100.0,1.2,"OutCubic",0.7,null,null,null],["w",0.45],["choice",["Tear the hem of my shirt"],[[]]],["w",0.1],["se","se_088"],["bg","BG_Black",0,0.6],["w",1.25],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,"stop"],["se","se_070"],["chd",0,4,"avg1_144","d","008",null],["tsk","Zhong"],["say","avg1_144","U-Um... My ==SEX11==, what are you doing?",0,"vo_STm07_09_012"],["chd",1,4,"avg1_144","a","002",null],["w",0.7],["choice",["Give me your hand."],[[]]],["w",0.1],["bgm","m58"],["bg","story_main_07_005_FP",0,0.9],["cbg",0,null,null,1.2,"Linear",0.0,null,null,null],["cbg",0,null,null,1.0,"OutCubic",0.9,null,null,null],["film",1],["w",0.5],["say","avg1_144","O-Okay. Like ... this?",9,"vo_STm07_09_013"],["w",0.35],["say","1","Let's try to stop the bleeding for now. Once we're inside the Monolith, I'll wish for proper disinfectants and real bandages. Bear with it until then.",9,""],["w",0.35],["say","avg1_144","But... My own negligence has caused damage to your attire. To be treated with such kindness now... I am utterly undeserving.",9,"vo_STm07_09_014"],["w",0.35],["choice",["Chitose?"],[[]]],["w",0.1],["say","avg1_144","Ah... Yes!",9,"vo_STm07_09_015"],["w",0.35],["say","1","I'm not rejecting you playing the role of my protective blade. Honestly, I'm grateful for it.",9,""],["say","1","But to me, you're more than a weapon. You're my companion—just like everyone else in the New Star Guild.",9,""],["w",0.35],["say","avg1_144","More than a blade... I am a companion to my ==SEX11==...",9,"vo_STm07_09_016"],["w",0.35],["say","1","Don't misunderstand though? I'm not disregarding your role as a blade. Phew, all done. How's that? Pretty professional work, if I do say so myself.",9,""],["w",0.35],["say","avg1_144","... Sure. It's not restricting my movements, and the wrapping is really neat.",9,"vo_STm07_09_017"],["w",0.35],["say","1","Getting hurt comes with the job for a Trekker. I picked it up along the way.",9,""],["say","1","Besides, there's nothing wrong with a wielder taking care of their blade, right?",9,""],["w",0.35],["bg","story_main_07_006",0,0.8],["cbg",0,null,null,0.98,"Linear",0.0,null,null,null],["w",0.7],["say","avg1_144","You are ... absolutely right. How strange. The wound you treated ... feels warm. Soothing.",9,"vo_STm07_09_018"],["say","avg1_144","Could this be ... your magic, my ==SEX11==?",9,"vo_STm07_09_019"],["w",0.5],["mrt",2,"y","020","speechless",null],["say","avg3_100","Nope. You know I can't use magic, Chitose. That's probably in your head.",1,""],["w",0.35],["mrt",0,"z","002","attention","daintou"],["say","avg3_100","I checked the cut earlier. It's not deep and missed the bone. Rest up a bit, and you'll be fine.",1,""],["w",0.35],["mrt",0,"y","021","question",null],["bgm",""],["say","avg3_100","By the way, why are you so set on becoming a blade? I think you're perfectly fine the way you are.",1,""],["mrt",3,"y",null,null,null],["w",0.5],["bg","BG_Black",0,0.8],["cbg",0,null,null,1.05,"Linear",0.0,null,null,null],["w",0.5],["show","avg1_144","c","003",null,-0.21,1.3,0,null,0.0],["ctl","avg1_144","c",null,"speechless",null,null,null,1.0,null,"OutCubic",0.6],["w",0.6],["say","avg1_144","Because becoming a flawless blade is my sole purpose. It is my destiny.",0,"vo_STm07_09_020"],["w",0.35],["ctl","avg1_144","c",null,null,null,null,null,0.0,null,"OutSine",0.4],["hide","avg1_144",0.4],["w",0.25],["say","0","This is the first time I've spoken to you of this, my ==SEX11==. For as long as I can remember, I lived in a vast, empty estate with my parents and my Master.",8,"vo_STm07_09_021"],["w",0.35],["se","se_169"],["trn",0,1,false,false,0.7],["w",0.7],["stg",0,0.0,0.0,1.15,"Linear",0.0,null,null,null],["fx",0,"fx_avg_reminiscence_loop",0,0],["film",0],["bg","tanikaze_court_daylight",0,0.0],["w",0.4],["cbg",0,-450.0,-60.0,1.45,"Linear",0.0,null,null,null],["trn",1,1,false,false,0.7],["bgm","m52"],["cbg",0,-600.0,null,null,"OutSine",15.0,null,null,null],["w",0.4],["say","Gentle Voice","We will always be here to protect you, Chitose.",3,""],["w",0.45],["say","Gentle Voice","Just dedicate yourself to your Master's training, and you will become a \"useful blade.\"",3,""],["w",0.35],["stg",0,0.0,0.0,1.03,"OutCubic",0.8,null,null,null],["film",1],["w",0.1],["bg","tanikaze_court_daylight",0,0.7],["cbg",0,0.0,null,1.05,"Linear",0.0,null,null,null],["w",0.1],["show","avg1_144","b","005",0.5,-0.09,1.15,0,null,0.0],["ctl","avg1_144","b",null,"speechless",null,null,null,1.0,null,"OutQuad",0.6],["w",1.8],["ctl","avg1_144","b",null,null,null,null,null,null,null,"OutSine",0.35],["show","avg3_1242","d","002",0.85,-0.35,1.5,0,null,0.0],["ctl","avg3_1242","d",null,null,0.75,null,null,0.85,null,"OutCubic",0.8],["w",0.65],["say","avg1_144","Under the guidance of my parents and Master, I honed my skills day after day.",0,"vo_STm07_09_022"],["ctl","avg3_1242","d",null,null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["show","avg3_100","c","002",0.13,-0.35,1.5,0,null,0.0],["ctl","avg3_100","c",null,null,0.22,null,null,0.85,null,"OutCubic",0.8],["w",0.25],["ctl","avg3_100","c",null,"idea",null,null,null,null,null,"OutSine",0.35],["w",0.4],["say","1","I see. Your parents and your Master... What were they like?",0,""],["w",0.35],["ctl","avg3_100","c",null,null,0.1,-0.42,1.65,null,null,"OutCubic",0.7],["ctl","avg3_1242","d",null,null,0.9,-0.42,1.65,null,null,"OutCubic",0.7],["stg",0,null,null,1.2,"OutCubic",0.7,null,null,null],["fx",0,"fx_avg_reminiscence_loop",1,0],["ctl","avg1_144","b","008",null,null,null,null,null,null,"Linear",0.5],["w",0.15],["bg","mood_3",0,0.7],["w",0.7],["say","avg1_144","Hmm... I wouldn't know. I never saw their human faces.",0,"vo_STm07_09_023"],["ctl","avg3_100","c",null,null,null,null,null,0.0,null,"OutCubic",0.7],["hide","avg3_100",0.7],["ctl","avg3_1242","d",null,null,null,null,null,0.0,null,"OutCubic",0.7],["hide","avg3_1242",0.7],["ctl","avg1_144","b","003",null,null,null,null,null,null,"OutSine",0.4],["w",0.4],["say","avg1_144","By the time I was old enough to understand their existence, they had already become legendary blades.",0,"vo_STm07_09_024"],["w",0.35],["ctl","avg1_144","b",null,null,null,null,null,0.0,null,"OutQuad",0.7],["hide","avg1_144",0.7],["w",0.15],["stg",0,null,null,1.12,"OutCubic",0.9,null,null,null],["w",0.15],["show","avg3_1242","a","003",null,-0.09,1.1,0,null,0.0],["ctl","avg3_1242","a",null,null,null,null,null,1.0,null,"OutCubic",0.7],["w",0.55],["say","avg1_144","That is the destiny of my bloodline. To scatter our consciousness, forge ourselves into steel, and sever the evils of this world.",0,"vo_STm07_09_025"],["w",0.35],["ctl","avg3_1242","a",null,null,null,null,null,0.0,null,"OutQuad",0.7],["hide","avg3_1242",0.7],["stg",0,null,null,1.05,"OutCubic",0.9,null,null,null],["bg","mood_4",0,0.8],["w",0.15],["show","avg1_144","d","006",0.493,-0.16,1.2,0,null,0.0],["ctl","avg1_144","d",null,null,null,null,null,1.0,null,"OutCubic",0.7],["w",0.55],["say","avg1_144","But ... I am ashamed to admit that while I know those words by heart, I have no idea what they truly mean.",0,"vo_STm07_09_026"],["w",0.35],["stg",0,null,-80.0,1.2,"OutCubic",0.7,null,null,null],["film",0],["w",0.1],["ctl","avg1_144","d","003",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_144","Unlike my parents and Master, the fact that I am still a human is the proof of my failure.",3,"vo_STm07_09_027"],["w",0.8],["clear",0,0,1],["w",0.5],["ctl","avg1_144","d","007",null,null,null,null,null,null,"OutSine",0.35],["bgm",""],["say","avg1_144","To fail as a sharp edge and deal senseless harm... Such a flawed blade has no value whatsoever.",3,"vo_STm07_09_028"],["w",0.8],["clear",0,0,1],["w",0.5],["film",1],["se","se_169"],["trn",0,1,true,true,0.8],["w",0.8],["bg","story_main_07_004",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["w",0.4],["cbg",0,-20.0,-350.0,1.4,"Linear",0.0,null,null,"JingTouYaoHuang"],["trn",1,1,false,false,0.8],["w",0.35],["bgm","m70"],["say","avg1_144","Fortunately, I found you, my ==SEX11==. You gave me a chance to prove my worth... But that is no excuse for me to neglect my training.",9,"vo_STm07_09_029"],["w",0.5],["mrt",1,"y","020","speechless",null],["say","avg3_100","... Is that why you push yourself so hard?",1,""],["mrt",3,"y",null,null,null],["w",0.5],["trn",0,1,false,false,0.8],["w",0.8],["stg",5,null,null,null,"Linear",0.0,null,null,"JingTouYaoHuang"],["film",0],["bg","BG_Black",0,0.0],["bg","wild_tower_daylight",5,0.0],["cbg",5,-1200.0,-500.0,2.2,"Linear",0.0,null,null,null],["show","avg3_100","c","022",0.5,null,null,5,null,null],["cbg",5,-1400.0,null,null,"OutSine",40.0,null,null,null],["ctl","avg3_100","c",null,null,null,-0.4,1.8,null,null,"Linear",0.0],["stage",5,0,0],["trn",1,1,false,false,0.8],["w",0.4],["say","1","If that's the case, I want to help you find the real meaning behind that destiny.",9,""],["w",0.3],["ctl","avg3_100","c","003",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","1","But ... after hearing all that...",9,""],["w",0.35],["trn",0,0,true,true,0.7],["w",0.7],["stg",5,null,null,null,"Linear",0.0,null,null,"stop"],["stage",5,1,1],["show","avg3_100","c","022",null,-0.34,1.6,0,null,null],["bg","white",0,0.0],["bg","circle_light",0,0.0],["cbg",0,null,null,2.0,"OutSine",0.0,null,null,null],["trn",1,0,false,false,0.7],["w",0.5],["say","1","Chitose, could you promise me one thing?",3,""],["w",0.35],["trn",0,1,true,true,0.7],["w",0.7],["film",1],["bg","story_main_07_004",0,0.0],["cbg",0,-20.0,-350.0,1.4,"Linear",0.0,null,null,"JingTouYaoHuang"],["trn",1,1,false,false,0.7],["w",0.4],["say","avg1_144","I am yours to command, my ==SEX11==.",9,"vo_STm07_09_030"],["w",0.5],["mrt",1,"z","023",null,null],["say","avg3_100","Your dedication is amazing, really.==W== But it wouldn't hurt to stop and just look at the world around you once in a while, right?",1,""],["w",0.5],["mrt",0,"z","013",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.51],["say","avg1_144","Stop? But why...?",9,"vo_STm07_09_031"],["w",0.35],["say","avg1_144","It is like forging steel. The metal must be quenched over and over. If this process is deliberately interrupted, the blade turns brittle.",9,"vo_STm07_09_032"],["w",0.35],["bgm",""],["mrt",1,"z","003",null,null],["say","avg3_100","I get where you're coming from.==W== But sometimes taking a breather lets you see things from a totally different angle.",1,""],["w",0.5],["mrt",0,"z","002","attention","daintou"],["goon"],["w",0.35],["se","se_169"],["stg",0,250.0,null,1.15,"OutQuad",1.1,null,null,null],["w",0.2],["trn",0,1,false,false,0.9],["w",0.9],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["bg","sky_sunny",0,0.0],["cbg",0,180.0,null,1.1,"Linear",0.0,null,null,"stop"],["trn",1,1,false,false,0.9],["fx",0,"fx_avg_sunlight",0,0],["cbg",0,0.0,null,null,"OutSine",20.0,null,null,"JingTouYaoHuang"],["bgm","m58"],["w",1.5],["say","1","For example... Look out the window. You can only appreciate this because we're sitting still. Have you ever seen such a view?",9,""],["w",0.35],["say","avg1_144","No... I've never seen anything like it. And as I gaze out at it...",9,"vo_STm07_09_033"],["w",0.35],["say","avg1_144","It feels as though I am one with the sky. My heart feels cleansed.",9,"vo_STm07_09_034"],["w",0.35],["se","se_169"],["trn",0,1,false,false,0.7],["w",0.7],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["bg","story_main_07_004",0,0.0],["cbg",0,-20.0,-350.0,1.4,"Linear",0.0,null,null,"JingTouYaoHuang"],["w",0.4],["trn",1,1,false,false,0.7],["w",0.3],["mrt",2,"z","014","music",null],["say","avg3_100","See? Polishing your state of mind like this is also a form of training.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["say","avg1_144","I understand. So this is the mental fortitude I lacked. I had never considered it that way... Your wisdom knows no bounds, my ==SEX11==. Then, if this counts as training... May I make a small request?",9,"vo_STm07_09_035"],["w",0.35],["mrt",1,"z","013",null,null],["say","avg3_100","Of course. Anything I can do.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["cbg",0,-50.0,-400.0,1.7,"InBack",1.0,null,null,null],["w",0.4],["se","se_019"],["bg","story_main_07_006",0,0.7],["cbg",0,null,null,0.99,"Linear",0.0,null,null,"JingTouYaoHuang"],["w",0.4],["say","avg1_144","To bring my heart closer to yours... To master Oneness... Would you allow me to ... come closer to you, to see the view you see... If that is alright?",9,"vo_STm07_09_036"],["bgm",""],["w",3.0],["clear",0,0,1],["w",0.4],["se","se_076"],["trn",0,2,false,false,1.0],["w",1.0],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["bg","story_main_07_003",0,0.0],["cbg",0,90.0,0.0,1.05,"Linear",0.0,null,null,null],["w",0.3],["trn",1,2,false,false,1.0],["w",0.15],["head","11:45, Venatio Month 14th, Outside Philae, Cable Car Station"],["se","se_020"],["show","avg3_152","a","010",0.3,-0.14,1.2,0,null,0.0],["ctl","avg3_152","a",null,null,null,null,null,1.0,"youzaiLp","OutCubic",0.7],["w",0.2],["obj","qstory_main_07_011",1,0.6,0.54],["w",1.65],["objx"],["w",0.15],["stg",0,100.0,null,1.15,"OutCubic",0.7,null,null,null],["w",0.1],["bgm","m2"],["show","avg1_112","b","002",0.8,-0.14,1.2,0,null,0.0],["se","se_020_stop"],["ctl","avg1_112","b",null,"attention",0.62,null,null,1.0,"daintou","OutQuad",0.6],["w",0.6],["say","avg1_112","Looks like the cable car is almost across.",0,""],["w",0.35],["ctl","avg3_152","a","007","music",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","avg3_152","Are you sure you don't want a peek through my telescope? It's quite the show.",0,""],["w",0.35],["se","se_077"],["ctl","avg1_112","b","003",null,null,null,null,null,"diantou","OutSine",0.35],["w",0.35],["say","avg1_112","Nah, let them have their moment. Boss is reliable. ==SEX1=='ll take good care of Chitose.",0,""],["w",0.35],["ctl","avg3_152","a","011","question",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg3_152","Oh? You think so? Given her sword skills, shouldn't Miss Chitose be taking care of Boss?",0,""],["w",0.35],["ctl","avg1_112","b","005","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_112","Not exactly. My gut says Chitose is wrestling with a lot of confusion. I know the feeling. Boss is probably the only one who can help her.",0,""],["ctl","avg1_112","b",null,null,null,null,null,null,null,"Linear",0.35],["w",0.35],["ctl","avg3_152","a","010","happy",null,null,null,null,"daintou","OutSine",0.45],["w",0.45],["say","avg3_152","Hehe ♪ You play the reckless, high-energy card, Miss Noya, but you're actually watching everyone closely.",0,""],["ctl","avg3_152","a","004",null,null,null,null,null,null,"Linear",0.35],["w",0.35],["ctl","avg1_112","b","007","exclamation",null,null,null,null,"jushou","OutSine",0.35],["say","avg1_112","Of course I am! Boss and Chitose are my friends! ♪",0,""],["w",0.35],["se","se_113"],["stg",0,null,400.0,1.4,"OutCubic",0.8,null,null,null],["ctl","avg3_152","a",null,null,0.2,null,1.3,0.8,null,"OutCubic",0.7],["ctl","avg1_112","b",null,null,0.72,null,1.3,0.8,null,"OutCubic",0.7],["w",0.3],["show","avg2_983","a","004",null,-0.25,null,0,null,0.0],["ctl","avg2_983","a",null,null,null,null,null,null,null,"Linear",0.0],["show","avg2_984","a","004",null,-0.25,-1.0,0,null,0.0],["ctl","avg2_984","a",null,null,null,null,null,null,null,"Linear",0.0],["ctl","avg2_983","a",null,null,null,null,null,1.0,null,"OutSine",0.5],["ctl","avg2_984","a",null,null,null,null,null,1.0,null,"OutSine",0.5],["w",0.5],["say","avg1_112","Alright, enough worrying! Let's tie up these goons. Once Iris and Amber get here, we'll head over and back Boss up.",0,""],["w",0.35],["ctl","avg2_984","a",null,null,null,null,null,0.0,null,"OutSine",0.5],["hide","avg2_984",0.5],["ctl","avg2_983","a",null,null,null,null,null,0.0,null,"OutSine",0.5],["hide","avg2_983",0.5],["stg",0,null,0.0,1.1,"OutBack",1.1,null,null,null],["w",0.5],["ctl","avg3_152","a","005","star",0.3,-0.14,1.2,1.0,null,"OutCubic",0.6],["ctl","avg1_112","b","002",null,0.62,-0.14,1.2,1.0,null,"OutCubic",0.6],["w",0.6],["say","avg3_152","Leave that to me! Your adorable Bastelina aced her knot-tying class, too.",0,""],["w",0.35],["ctl","avg1_112","b","003","idea",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["bgm",""],["say","avg1_112","How reliable! I'll grab the ropes.",0,""],["w",0.35],["ctl","avg1_112","b","004",null,1.0,null,null,0.0,null,"InBack",0.7],["w",0.35],["se","se_147"],["w",0.7],["cbg",0,-90.0,null,null,"OutCubic",0.7,null,null,null],["ctl","avg3_152","a","003","sigh",0.46,null,null,null,null,"OutCubic",0.7],["w",0.7],["say","avg3_152","Miss Noya's honesty is her best trait...==W== But turning down my telescope means she's missing out on a spectacular show.",0,""],["bgm","m34"],["w",0.5],["ctl","avg3_152","a","004",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["goon"],["w",0.35],["stg",0,110.0,-50.0,1.25,"OutCubic",0.7,null,null,null],["film",0],["se","se_226"],["w",0.1],["ctl","avg3_152","a","007",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg3_152","For instance, I doubt Boss or Miss Chitose has any clue that there's a \"cute little stalker\" dangling right beneath their cable car.",3,""],["w",0.35],["ctl","avg3_152","a","003","flower",null,null,null,null,"youzaiLp","Linear",0.35],["w",0.35],["say","avg3_152","My, my. With such an unexpected wild card crashing the party… What will become of this technical review? ♪",3,""],["w",0.35],["bgm",""],["stg",0,null,-300.0,null,"OutSine",5.0,null,null,null],["film",1],["ctl","avg3_152","a",null,null,null,null,null,0.0,null,"OutSine",0.6],["hide","avg3_152",0.6],["w",3.5],["se","se_169"],["trn",0,1,true,true,1.0],["w",1.0],["bg","sky_tower",0,0.7],["cbg",0,-200.0,100.0,1.2,"Linear",0.0,null,null,null],["film",1],["cbg",0,null,0.0,null,"Linear",10.0,null,null,null],["w",0.52],["stg",0,0.0,0.0,1.13,"Linear",0.0,null,null,null],["w",0.1],["trn",1,1,false,false,0.85],["bgm","m28"],["stg",0,null,null,null,"Linear",0.0,null,null,"Zhong"],["se","se_070"],["chd",0,3,"avg1_142","a","019",null],["tsk","Zhong"],["say","avg1_142","Waaah, it's too high! So scary...! Are we at the station yet?! My fingers are slipping!!!!",0,""],["w",1.0],["clear",0,0,1],["bgm",""],["w",0.4],["end"]]}