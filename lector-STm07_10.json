],["mrt",0,"y","012",null,null],["say","avg3_100","I need to find a way to help her.==W== Wait, that's it!",2,""],["w",0.55],["bgm",""],["mrt",0,"y","002","idea","jushou"],["goon"],["mrt",3,"y",null,null,null],["w",0.5],["se","se_076"],["trn",0,3,true,true,1.0],["w",1.0],["stg",0,90.0,0.0,1.05,"Linear",0.0,null,null,null],["w",0.4],["obj","qstory_main_07_014",0,null,0.54],["trn",1,3,false,false,1.0],["w",1.0],["say","0","After a quick sweep of the floor, I spot a Wishing Box barely larger than my hand tucked in a corner.",0,""],["w",0.35],["obj","qstory_main_07_014",1,0.31,0.54],["show","avg1_144","d","011",0.71,-0.15,1.2,0,null,0.0],["ctl","avg1_144","d",null,"star",0.61,null,null,1.0,null,"OutCubic",0.6],["w",0.6],["bgm","m49"],["say","avg1_144","My ==SEX11==, will this box yield the Artifact the Grace Imperium demands?",0,""],["w",0.35],["mrt",1,"z","009","sigh",null],["say","avg3_100","Probably not. It's way too small.",1,""],["w",0.35],["mrt",0,"y","020","think",null],["say","avg3_100","Makes sense. We're too far down in the Monolith to find a massive one. But this will do just fine.",2,""],["mrt",3,"y",null,null,null],["w",0.5],["objx"],["ctl","avg1_144","d","004","attention",0.455,-0.22,1.3,null,"daintou","OutSine",0.6],["w",0.6],["say","avg1_144","Understood. Please step behind me. We must continue our ascent.",0,""],["w",0.35],["mrt",2,"z","002","exclamation",null],["say","avg3_100","Hold on, Chitose. Let's rest here for today.",1,""],["mrt",3,"z",null,null,null],["w",0.35],["ctl","avg1_144","d","008","flurry",null,null,null,null,"tiao2","OutSine",0.5],["w",0.5],["say","avg1_144","My ==SEX11==, please do not worry about me. Thanks to your care, I am still fully capable of fighting.",0,""],["w",0.35],["mrt",1,"z","013",null,null],["say","avg3_100","Haste makes waste.==W== Honestly, I'm wiped out. Let's recharge so we can tackle the tower properly tomorrow.",1,""],["w",0.4],["mrt",0,"z","014","music","jushou"],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_144","d","006","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_144","If you insist...==W== I will secure a place for rest at once.",0,""],["w",0.6],["ctl","avg1_144","d",null,null,null,null,null,null,null,"Linear",0.3],["w",0.2],["ctl","avg1_144","d","009","idea",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["goon"],["w",0.35],["stg",0,-90.0,null,null,"InBack",0.9,null,null,null],["ctl","avg1_144","d",null,null,0.75,null,null,null,null,"InBack",0.9],["w",0.35],["se","se_148"],["trn",0,0,true,true,0.6],["w",0.6],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["bg","tower_rest",5,0.0],["cbg",0,-90.0,null,1.05,"Linear",0.0,null,null,null],["trn",1,0,false,false,0.7],["w",0.45],["mrt",2,"z","002","attention",null],["say","avg3_100","No, no need.==W== We can catch our breath at that rest area over there. Just don't eat anything inside it.",1,""],["w",0.4],["se","se_087"],["stage",5,0,14],["mrt",0,"z","014",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["stage",5,1,15],["w",0.3],["show","avg1_144","d","004",0.96,-0.14,1.15,0,null,0.0],["ctl","avg1_144","d",null,null,null,null,null,null,null,"Linear",0.0],["ctl","avg1_144","d",null,"attention",0.83,null,null,1.0,null,"OutBack",0.6],["w",0.6],["say","avg1_144","I understand.==W== I brought some meat buns I made myself. Please, have one.",0,""],["w",0.5],["ctl","avg1_144","d","009","flower",0.65,-0.14,1.2,null,"jushou","OutCubic",0.4],["w",0.15],["obj","qstory_main_07_016",1,0.35,0.54],["w",0.3],["goon"],["w",0.35],["stg",0,null,null,null,"Linear",0.0,null,null,"Xiao"],["mrt",2,"z","007","symbol",null],["say","avg3_100","Oh! These are uniquely shaped!==W== Thank you!",1,""],["w",0.6],["mrt",0,"z","013","love","jushou"],["goon"],["mrt",3,"z",null,null,null],["objx"],["w",0.6],["cbg",0,50.0,null,null,"OutCubic",0.7,null,null,null],["ctl","avg1_144","d",null,null,0.5,null,null,null,null,"OutCubic",0.7],["w",0.6],["mrt",1,"y","020","shock",null],["say","avg3_1