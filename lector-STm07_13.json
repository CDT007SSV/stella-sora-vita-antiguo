",0.23,null,null,0,null,0.0],["ctl","avg3_136","a",null,null,0.12,null,null,0.0,null,"OutQuint",1.0],["hide","avg3_136",1.0],["ctl","avg3_137","a",null,null,0.88,null,null,0.0,null,"OutQuint",1.0],["hide","avg3_137",1.0],["ctl","avg1_110","c",null,null,0.6,null,null,null,null,"OutQuint",1.0],["stg",0,50.0,null,1.05,"OutQuint",1.0,null,null,null],["w",0.5],["ctl","avg1_111","a",null,"flurry",0.28,null,null,1.0,null,"OutQuint",1.0],["say","avg1_111","U-um... Is this the time to be this relaxed? We're still 7 billion short, and the Dorra are due before sunset! Are we going to make it?!",0,""],["ctl","avg1_110","c","018","music",null,null,null,null,null,"Linear",1.0],["say","avg1_110","Fair point. But we still have two more companies to pitch to. We aren't out of options yet.",0,""],["ctl","avg1_110","c","015",null,null,null,null,null,"diantou","Linear",1.0],["se","se_077"],["say","avg1_110","Take Goodwind Homecare. They have a massive demand for flowers. Our joint greenhouse project is still on the table, though the Darcia incident put it on hold. Now is the perfect time to reopen those talks.",0,""],["ctl","avg1_111","a","007","question",null,null,null,null,"lengzhan","Linear",1.0],["say","avg1_111","A stalled project like that... Can we finalize a deal in half a day?",0,""],["ctl","avg1_110","c","008","speechless",null,null,null,null,"JuGong","Linear",1.0],["say","avg1_110","Easily. But I need the New Star Guild's help. It's simple—you three need to exaggerate what happens at the banquet.",0,""],["show","avg1_112","a","006",0.82,null,null,0,null,0.0],["ctl","avg1_110","c",null,null,null,null,null,null,null,"Linear",1.0],["stg",0,0.0,null,null,"OutQuint",1.0,null,null,null],["ctl","avg1_111","a",null,null,null,null,null,null,null,"Linear",1.0],["w",0.5],["show","avg1_103","c","008",0.42,-0.1,null,0,"question",0.0],["ctl","avg1_112","a",null,"question",0.8,null,null,1.0,null,"OutQuint",1.0],["ctl","avg1_103","c",null,"question",null,0.0,null,1.0,null,"OutBack",0.7],["s