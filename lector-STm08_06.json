4],["w",0.4],["ctl","avg3_100","aa","013","flower",0.8,-0.07,1.1,1.0,null,"OutCubic",0.5],["w",0.9],["stg",0,0.0,null,1.05,"OutCubic",0.6,null,null,null],["ctl","avg3_100","ab","004","star",0.5,-0.17,1.25,null,null,"OutBack",0.8],["w",1.1],["show","avg1_156","a","002",0.75,-0.24,1.25,0,null,0.0],["ctl","avg1_156","a",null,null,null,null,null,0.75,null,"OutCubic",0.6],["ctl","avg1_156","a",null,null,null,-0.16,null,null,null,"OutSine",7.0],["w",0.4],["say","0","Nazuna's decoy act works like a charm.",3,""],["w",0.4],["say","0","Before we even hit the desert, I catch a glimpse of a shop window's Projector showing footage of \"me\" all dressed up for a United Harvest Philae event.",3,""],["bgm",""],["w",0.4],["se","se_263"],["trn",0,4,true,true,1.0],["w",1.0],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,"xingshi"],["film",1],["bg","desert_notower_daylight",0,0.0],["cbg",0,200.0,null,1.2,"Linear",0.0,null,null,null],["w",0.3],["cbg",0,0.0,null,1.25,"OutSine",11.0,null,null,null],["trn",1,4,true,false,1.0],["se","se_410"],["w",0.8],["say","0","But that's where our luck ends. The moment we step into the desert, the Wilds bare their fangs.",0,""],["w",0.8],["clear",0,0,1],["w",0.45],["se","se_410_stop"],["se","se_458"],["bg","BG_Black",0,0.7],["w",0.6],["say","0","Ten days after leaving Philae.",8,""],["w",0.5],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,"stop"],["clear",0,0,1],["w",0.4],["bg","desert_notower_daylight",0,0.8],["cbg",0,0.0,0.0,1.2,"Linear",0.0,null,null,null],["cbg",0,null,null,1.1,"OutSine",4.0,null,null,null],["head","12:00, Nebula Month 6th, Sunset Desert, Unknown Dune"],["se","se_410"],["stg",0,null,null,null,"Linear",0.0,null,null,"xingshi"],["bg","carriage_inside",0,0.7],["cbg",0,null,null,1.15,"Linear",0.0,null,null,null],["cbg",0,null,null,1.05,"OutQuad",1.7,null,null,null],["bg","story_main_01_025",5,0.0],["cbg",5,null,350.0,1.1,"Linear",0.0,null,null,null],["w",1.0],["film",0],["stage",5,0,0],["w",0.5],["say","avg1_112","Phew, it's roasting out here. Iris, how's our water looking?",3,""],["w",0.4],["stage",5,1,1],["film",1],["stg",0,null,null,1.0,"OutCubic",0.7,null,null,"stop"],["se","se_410_stop"],["se","se_245"],["w",1.7],["se","se_245_stop"],["se","se_342"],["w",0.15],["show","avg1_111","b","002",0.59,-0.17,1.25,0,null,0.0],["ctl","avg1_111","b",null,null,0.5,null,null,1.0,null,"OutCubic",0.7],["w",0.4],["bgm","m46"],["say","avg1_111","We've been rationing, but we're down to three days' worth. It's getting dangerous. If we don't find the Monolith today, we'll have to head back for supplies.",0,""],["w",0.4],["chd",0,2,"avg1_112","a","015","speechless"],["w",0.4],["say","avg1_112","Supplies, yeah... Still, this makes zero sense. According to Amber's photo, the Monolith should be right next to that signpost.",0,""],["ctl","avg1_112","a",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.4],["stg",0,100.0,null,1.1,"OutCubic",0.7,null,null,"still"],["ctl","avg1_111","b",null,null,0.27,null,null,null,null,"OutCubic",0.7],["w",0.3],["obj","qstory_main_06_025",1,0.51,0.54],["ctl","avg1_112","a","016","vexation",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg1_112","And that compass we got from Firenze, the one from under the orphanage, used to point at the desert. I thought it was connected to the Monolith, but the second we hit the dunes it started spinning in circles. How peculiar.",0,""],["chd",1,2,"avg1_112","a","002",null],["w",0.4],["trn",0,0,false,false,0.8],["w",0.8],["ctl","avg1_111","b",null,null,null,null,null,null,null,"Linear",0.0],["hide","avg1_111",0],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,"xingshi"],["obj","qstory_main_08_009",1,null,0.54],["bg","desert_notower_daylight",0,0.0],["cbg",0,200.0,null,1.2,"Linear",0.0,null,null,null],["cbg",0,0.0,null,1.15,"OutSine",10.0,null,null,null],["w",0.3],["trn",1,0,false,false,0.8],["chd",0,0,"avg1_103","c","006","attention"],["w",0.35],["say","avg1_103","This is where I ran into enemies. I climbed the dune and saw the Monolith.",0,""],["w",0.4],["ctl","avg1_103","c","008","vexation",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg1_103","So why can't we find it?",0,""],["w",0.4],["chd",0,2,"avg1_111","b","004","question"],["w",0.35],["say","avg1_111","Could there be multiple signposts like this? Maybe we're looking at the wrong one.",0,""],["objx"],["chd",1,0,"avg1_103","a","002",null],["chd",1,2,"avg1_111","a","002",null],["w",0.4],["stage",5,0,0],["w",0.45],["say","avg1_112","No way. I cross-checked the photo with that signpost over and over, and the erosion marks match perfectly. This is the one.",0,""],["w",0.4],["trn",0,0,false,false,0.8],["w",0.8],["bg","carriage_inside",0,0.0],["cbg",0,null,null,1.05,"Linear",0.0,null,null,null],["stage",5,1,1],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,"stop"],["trn",1,0,false,false,0.8],["show","avg1_111","b","007",0.6,-0.1,1.15,0,null,0.0],["ctl","avg1_111","b",null,"exclamation",0.5,null,null,1.0,null,"OutCubic",0.6],["w",0.35],["say","avg1_111","Then there's only one explanation. I read that sand dunes shift constantly. In strong winds, they can travel far in a single night.",0,""],["w",0.4],["stg",0,null,null,1.1,"OutCubic",0.7,null,null,null],["w",0.15],["ctl","avg1_111","b","004","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_111","This signpost probably got carried away from its original spot by the shifting sand. That's why the Monolith isn't actually nearby.",0,""],["ctl","avg1_111","b",null,null,null,null,null,null,null,"OutSine",0.35],["w",0.4],["chd",0,2,"avg1_112","a","007","idea"],["w",0.4],["say","avg1_112","That explains it! We've walked this far and haven't even seen the Wishing Box ==PLAYER_NAME== was in. I knew something was off!",0,""],["chd",1,2,"avg1_112","a","002",null],["w",0.4],["se","se_061"],["stg",0,250.0,null,1.15,"OutCubic",0.7,null,null,null],["show","avg1_103","c","005",0.25,0.1,1.15,0,null,0.0],["ctl","avg1_103","c",null,null,null,-0.11,null,1.0,null,"OutBack",0.8],["w",0.45],["ctl","avg1_103","c","002",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_103","Agree.",0,""],["w",0.4],["bgm",""],["ctl","avg1_111","b","003","shock",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","avg1_111","We've been searching this area for days. No Monolith, no Wishing Box. The signpost moving is the only logical conclusion.",0,""],["ctl","avg1_111","b",null,null,null,null,null,null,null,"OutSine",0.35],["w",0.4],["se","se_164"],["stg",0,-100.0,null,1.1,"OutCubic",0.7,null,null,"Xiao"],["trn",0,0,true,true,0.71],["w",0.71],["bg","desert_notower_daylight",0,0.0],["cbg",0,180.0,null,1.1,"Linear",0.0,null,null,null],["stg",0,180.0,0.0,1.1,"Linear",0.0,null,null,null],["trn",1,0,false,false,0.7],["stg",0,-90.0,null,1.05,"OutBack",0.8,null,null,"Xiao"],["show","avg1_112","b","002",0.3,-0.07,1.1,0,null,0.0],["ctl","avg1_112","b",null,null,null,null,null,null,null,"Linear",0.0],["ctl","avg1_112","b",null,null,0.55,-0.1,1.15,1.0,null,"OutBack",0.8],["w",0.65],["bgm","m2"],["say","avg1_112","Makes sense... ==PLAYER_NAME==, what do you think?",0,""],["w",0.4],["mrt",2,"ca","009","speechless",null],["say","avg3_100","Mm...",1,""],["mrt",3,"ca",null,null,null],["w",0.51],["bg","circle_light",0,0.0],["cbg",0,100.0,null,2.2,"OutCubic",0.0,null,null,null],["cbg",0,100.0,null,2.0,"OutCubic",0.7,null,null,null],["ctl","avg1_112","b","004","question",0.45,-0.28,1.4,null,null,"OutCubic",0.7],["say","avg1_112","Hey? You with us,==W== ==PLAYER_NAME==?",0,""],["w",0.9],["cbg",0,null,50.0,1.5,"OutCubic",0.7,null,null,null],["se","se_539"],["ctl","avg1_112","b","005",null,0.54,-0.355,1.5,null,null,"OutBack",0.7],["w",0.3],["goon"],["w",0.4],["cbg",0,null,null,2.5,"OutCubic",0.7,null,null,null],["w",0.15],["mrt",2,"ca","007","symbol",null],["say","avg3_100","Huh? Sorry, I'm fine, just spaced out. What was the question?",1,""],["mrt",3,"ca",null,null,null],["w",0.51],["ctl","avg1_112","b","004","attention",null,null,null,null,"daintou","OutSine",0.35],["w",0.35],["say","avg1_112","I was asking if you think we can't find the Monolith because the signpost in Amber's photo shifted with the dunes.",0,""],["w",0.4],["mrt",1,"cb","020","speechless",null],["say","avg3_100","Yeah... Probably. It's not like the Monolith could up and move.",1,""],["mrt",3,"cb",null,null,null],["w",0.51],["ctl","avg1_112","b","008","vexation",null,null,null,null,"lengzhan","OutSine",0.35],["say","avg1_112","Hey, are you okay, ==PLAYER_NAME==? You look awful. Please don't tell me it's heatstroke.",0,""],["w",0.4],["ctl","avg1_112","b",null,null,0.72,null,null,0.0,null,"OutCubic",0.7],["cbg",0,-50.0,null,null,"OutCubic",0.7,null,null,null],["w",0.1],["show","avg1_103","c","008",0.38,-0.35,1.5,0,null,0.0],["ctl","avg1_103","c",null,"flurry",0.55,null,null,1.0,"daintou","OutQuad",0.6],["w",0.4],["say","avg1_103","Here, let me feel your skin.",0,""],["w",0.4],["ctl","avg1_103","c","004","flower",null,-0.49,1.7,null,null,"OutCubic",0.75],["w",0.15],["bgm",""],["trn",0,0,false,false,0.65],["w",0.65],["stg",0,210.0,0.0,1.12,"Linear",0.0,null,null,null],["ctl","avg1_103","c",null,null,0.4,-0.42,1.6,null,null,"Linear",0.0],["w",0.7],["trn",1,0,false,false,0.7],["ctl","avg1_103","c","003","attention",null,-0.14,1.2,null,"daintou","OutQuad",0.63],["bgm",""],["w",0.3],["say","avg1_103","No fever.",0,""],["w",0.4],["stg",0,-120.0,null,1.07,"OutCubic",0.7,null,null,null],["show","avg1_111","a","015",0.82,-0.14,1.2,0,null,0.0],["ctl","avg1_111","a",null,"question",0.69,null,null,1.0,null,"OutCubic",0.7],["w",0.5],["say","avg1_111","No fever, face not flushed, palms not sweaty... Boss, any headache or dizziness?",0,""],["w",0.4],["mrt",1,"cb","009","speechless",null],["say","avg3_100","Nothing like that.",1,""],["mrt",3,"cb",null,null,null],["w",0.51],["ctl","avg1_111","a","004","sigh",null,null,null,null,null,"Linear",0.35],["w",0.35],["say","avg1_111","Then it's pure exhaustion. We've been pushing for ten days straight.",0,""],["w",0.4],["ctl","avg1_111","a","002","exclamation",null,null,null,null,"jushou","Linear",0.5],["say","avg1_111","Everyone, with the signpost gone, we need to widen our search. But that means our supplies won't last. I say we find a town to restock and get some proper rest.",0,""],["w",0.4],["bgm",""],["ctl","avg1_103","c","008","awkward",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg1_103","Time enough to reach a town outside the desert?",0,""],["w",0.4],["ctl","avg1_111","a","007","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_111","No amount of time would be enough. But I remember hearing about a town in this desert that's not charted in the Trekker's Handbook.",0,""],["ctl","avg1_111","a",null,null,null,null,null,null,null,"OutSine",0.35],["w",0.4],["stg",0,-125.0,null,1.16,"OutCubic",0.7,null,null,null],["ctl","avg1_103","c",null,null,0.32,null,null,null,null,"OutCubic",0.7],["ctl","avg1_111","a",null,null,0.77,null,null,null,null,"OutCubic",0.7],["w",0.2],["se","se_473"],["obj","qstory_side_111_006",1,null,0.54],["w",0.4],["say","avg1_111","Let me check my notes...",0,""],["w",0.4],["ctl","avg1_111","a","011","star",null,null,null,null,"tiao2","Linear",0.3],["w",0.3],["bgm","m49"],["say","avg1_111","Found it. I took these notes from Willow back when we first became Trekkers. She mentioned this place. Let me see... It should only take half a day from here.",0,""],["w",0.4],["trn",0,0,true,false,0.7],["w",0.7],["stg",0,90.0,0.0,1.05,"Linear",0.0,null,null,null],["objx"],["bg","desert_notower_daylight",0,0.0],["show","avg1_103","c","002",0.3,-0.1,1.15,0,null,null],["show","avg1_111","a","002",0.5,-0.1,1.15,0,null,null],["w",0.35],["trn",1,0,false,false,0.7],["stg",0,-180.0,null,1.1,"OutCubic",0.7,null,null,null],["show","avg1_112","a","008",0.82,-0.1,1.15,0,null,0.0],["ctl","avg1_112","a",null,"sweaty",0.72,null,null,1.0,null,"OutCubic",0.7],["w",0.4],["say","avg1_112","A town not charted in the Trekker's Handbo