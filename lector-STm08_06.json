ll,null,null,"Linear",0.3],["w",0.4],["mrt",0,"ca","016","vexation","lengzhan"],["say","avg3_100","Or if Angie and the Salvation Committee launch another assassination attempt on the decoy Boss...",1,""],["mrt",3,"ca",null,null,null],["w",0.51],["trn",0,0,true,true,0.8],["w",0.8],["film",1],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["bg","mirage_street_night",0,0.0],["cbg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["show","avg1_112","e","018",null,-0.11,1.15,0,null,0.0],["trn",1,0,false,false,0.9],["ctl","avg1_112","e",null,"speechless",null,null,null,1.0,null,"OutCubic",0.7],["w",0.4],["say","avg1_112","Then Nazuna and everyone protecting her would be in danger, danger meant for you.",0,""],["ctl","avg1_112","e","024",null,null,null,null,null,null,"OutSine",0.3],["w",0.3],["say","avg1_112","If they got hurt or killed, it would be because they took your place. Meanwhile, the rest of us here would be stuck on the run, looking over our shoulders for the rest of our lives.",0,""],["w",0.4],["mrt",2,"ca","025","flurry",null],["say","avg3_100","Noya... You knew...",1,""],["mrt",3,"ca",null,null,null],["w",0.51],["stg",0,null,-10.0,1.15,"OutCubic",0.7,null,null,null],["w",0.1],["show","avg1_145","b","002",0.25,-0.17,1.15,0,null,0.0],["ctl","avg1_145","b",null,null,null,null,null,0.85,null,"Linear",0.5],["ctl","avg1_112","e","003",null,null,null,null,null,null,"Linear",0.5],["ctl","avg1_145","b",null,null,null,-0.1,null,null,null,"OutSine",10.0],["w",0.45],["say","avg1_112","We knew from the start. That makeup artist was Otoha from the banquet.",0,""],["w",0.4],["ctl","avg1_112","e","007","idea",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","avg1_112","I guessed by instinct, Amber caught a floral scent, and Iris tracked your schedule. You never had a chance to sneak out at night and meet someone we didn't know.",0,""],["w",0.4],["ctl","avg1_145","b",null,null,null,null,null,0.0,null,"OutCubic",0.7],["hide","avg1_145",0.7],["mrt",1,"ca","025","speechless",null],["say","avg3_100","Then why didn't anyone stop her?",1,""],["mrt",3,"ca",null,null,null],["w",0.51],["ctl","avg1_112","e","021","sigh",null,null,null,null,null,"Linear",0.35],["w",0.35],["say","avg1_112","Because everyone else knew too. Nazuna, Nazuka, Fuyuka, Kaede, Firenze, Chitose. They all understood this would paint a target on Philae. On themselves.",0,""],["w",0.4],["ctl","avg1_112","e","006",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_112","As for Otoha, she saw through Firenze's plan and volunteered.",0,""],["w",0.4],["mrt",1,"ca","025","speechless",null],["say","avg3_100","So you mean...",1,""],["mrt",3,"ca",null,null,null],["w",0.5],["stg",0,null,-20.0,1.25,"OutCubic",0.7,null,null,null],["bgm",""],["w",0.2],["ctl","avg1_112","e","020",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_112","Everyone believes you can find the proof. But even if you fail, they hoped this would buy you a way out, a chance for you to survive.",0,""],["w",0.4],["mrt",2,"ca","025","flurry",null],["say","avg3_100","So everyone knew... This whole time...",1,""],["mrt",3,"ca",null,null,null],["se","se_115"],["w",1.0],["stg",0,0.0,0.0,1.1,"OutCubic",0.7,null,null,null],["show","avg1_111","d","004",0.15,-0.21,1.3,0,null,0.0],["ctl","avg1_111","d",null,"sigh",0.27,-0.115,1.15,1.0,null,"OutCubic",0.7],["show","avg1_103","g","002",0.85,-0.23,1.3,0,null,0.0],["ctl","avg1_103","g",null,null,0.72,-0.13,1.145,1.0,null,"OutCubic",0.7],["w",0.5],["bgm","m18"],["say","avg1_111","Boss, I had a feeling this was bothering you... I just didn't expect it to be weighing on you this heavily.",0,""],["w",0.4],["ctl","avg1_111","d","002",null,null,null,null,null,null,"OutSine",0.3],["ctl","avg1_103","g","007","flurry",null,null,null,null,"daintou","OutSine",0.35],["w",0.35],["say","avg1_103","You worry ... because you care.",0,""],["w",0.4],["se","se_070"],["stg",0,null,null,null,"Linear",0.0,null,null,"Zhong"],["mrt",2,"ca","007",null,"shilaimu1"],["tsk","Xiao"],["say","avg3_100","Wait... I thought you were asleep.",1,""],["mrt",3,"ca",null,null,null],["w",0.5],["ctl","avg1_111","d","013","attention",null,null,null,null,"daintou","OutSine",0.35],["w",0.35],["say","avg1_111","We got tossed around pretty hard coming down that dune... We've been awake since we hit Mirage. We kept quiet because Noya clearly wanted a moment with you...",0,""],["w",0.4],["ctl","avg1_103","g","014","flower",null,null,null,null,"tiao2","OutSine",0.35],["w",0.35],["say","avg1_103","Didn't want to interrupt.",0,""],["w",0.4],["ctl","avg1_111","d","012",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_111","Anyway, Boss.==W== I heard one of Angie's main reasons for calling you the Tyrant is that you're always helping people, always doing good deeds.",0,""],["w",0.6],["ctl","avg1_111","d","011","love",null,null,null,null,"jushou","OutSine",0.3],["w",0.3],["goon"],["w",0.4],["ctl","avg1_103","g","007","shy",null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_103","If you're the Tyrant... We're fine with that.",0,""],["w",0.4],["ctl","avg1_112","e","004","happy",null,null,null,null,"tiao2","OutSine",0.35],["w",0.35],["say","avg1_112","Exactly! The world could use a few more Tyrants like you.",0,""],["w",0.4],["mrt",1,"ca","025","speechless",null],["say","avg3_100","... Thank you.==W== I understand now.",1,""],["w",0.9],["mrt",0,"ca","022",null,null],["goon"],["w",0.4],["mrt",0,"cb","024",null,null],["say","avg3_100","I've been an idiot. I was so focused on keeping all of you safe, I forgot you wanted to keep me safe too.",1,""],["mrt",3,"ca",null,null,null],["w",0.51],["ctl","avg1_112","e","007","music",null,-0.22,1.3,null,null,"OutCubic",0.7],["w",0.4],["say","avg1_112","Keep your head up! Don't underestimate us. Everyone in Philae has been to hell and back with you.",0,""],["w",0.4],["ctl","avg1_103","g","007","star",0.7,-0.23,1.28,null,null,"OutCubic",0.7],["w",0.4],["say","avg1_103","Everyone's tough.",0,""],["w",0.4],["ctl","avg1_111","d","014","exclamation",0.29,-0.22,1.3,null,null,"OutCubic",0.7],["w",0.4],["say","avg1_111","We're way tougher than you, Boss.",0,""],["w",0.4],["ctl","avg1_112","e","004","happy",null,null,null,null,"daintou","OutSine",0.3],["w",0.3],["say","avg1_112","Right! By the time we find your proof, they'll probably call to say they've already wiped the floor with Angie and her committee. You won't even need to go to the conference, Boss!",0,""],["w",0.4],["mrt",2,"ca","007","exclamation",null],["say","avg3_100","Alright, let's not get ahead of ourselves.",1,""],["mrt",3,"ca",null,null,null],["w",0.51],["bgm",""],["ctl","avg1_112","e","005",null,null,null,null,null,null,"Linear",0.5],["say","avg1_112","I'm an optimist, what can I say? Anyway, sweating the small stuff won't help right now. Let's head back to the vehicle and sleep. We have an early start tomorrow.",0,""],["w",0.4],["se","se_148"],["trn",0,0,true,true,0.8],["w",0.5],["se","se_115"],["w",0.31],["bg","carriage_inside_night",0,0.0],["stg",0,100.0,0.0,1.1,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["w",0.3],["trn",1,0,false,false,0.7],["se","se_060"],["show","avg1_103","g","002",0.3,-0.07,1.1,0,null,0.0],["ctl","avg1_103","g",null,null,null,null,null,1.0,null,"Linear",0.5],["ctl","avg1_103","g",null,null,0.7,null,null,null,"manbu_loop","OutSine",2.2],["show","avg1_112","e","002",0.15,-0.07,1.1,0,null,0.0],["ctl","avg1_112","e",null,null,null,null,null,1.0,null,"OutSine",0.5],["ctl","avg1_112","e",null,null,0.55,null,null,null,"manbu_loop","OutSine",2.2],["show","avg1_111","d","002",0.0,-0.08,1.13,0,null,0.0],["ctl","avg1_111","d",null,null,null,null,null,1.0,null,"OutSine",0.5],["ctl","avg1_111","d",null,null,0.4,null,null,null,"manbu_loop","OutSine",2.2],["show","avg3_100","ba","002",-0.15,-0.07,1.1,0,null,0.0],["ctl","avg3_100","ba",null,null,null,null,null,1.0,null,"OutSine",0.5],["ctl","avg3_100","ba",null,null,0.25,null,null,null,"manb