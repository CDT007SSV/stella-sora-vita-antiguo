,"lengzhan","OutSine",0.35],["say","Dessert Shop Staff","Let me double-check that...==W== Hmm. You're right. They stack. Your total comes to ... one thousand Dorra.",0,""],["w",0.8],["se","se_077"],["ctl","avg3_143","a","002",null,null,null,null,null,"diantou","OutSine",0.35],["w",0.35],["goon"],["objx"],["w",0.4],["clear",1,0.4,1],["stg",0,0.0,0.0,1.05,"OutCubic",0.7,null,null,null],["w",0.05],["show","avg1_103","a","007",0.2,-0.17,1.3,0,null,0.0],["ctl","avg1_103","a",null,null,0.35,-0.1,1.15,1.0,null,"OutCubic",0.7],["show","avg1_112","a","007",0.8,-0.17,1.3,0,null,0.0],["ctl","avg1_112","a",null,"star",0.65,-0.1,1.15,1.0,null,"OutCubic",0.7],["w",0.4],["say","avg1_112","A thousand Dorra for all this? That barely buys a loaf of bread out there.",0,""],["w",0.4],["stg",0,null,-10.0,1.12,"OutCubic",0.7,null,null,null],["ctl","avg1_112","a",null,null,0.8,-0.2,1.3,null,null,"OutCubic",0.7],["ctl","avg1_103","a",null,null,0.2,-0.2,1.3,null,null,"OutCubic",0.7],["show","avg1_111","a","011",0.65,-0.075,1.1,0,null,0.0],["ctl","avg1_111","a",null,"happy",0.5,null,null,1.0,"daintou","OutCubic",0.7],["w",0.6],["say","avg1_111","This shop's coupons are popular because they stack.==W== I used to get paid in these instead of cash for odd jobs. I never thought we'd actually use them.",0,""],["w",0.65],["ctl","avg1_111","a","012","sweaty",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["goon"],["w",0.4],["ctl","avg1_111","a","026","sigh",null,null,null,null,"diantou","OutSine",0.35],["w",0.35],["say","avg1_111","You never know what'll happen. I need to make my savings last. The hundred thousand Dorra from my odd jobs has to stretch.",0,""],["w",0.4],["ctl","avg1_112","a",null,null,0.7,-0.075,1.1,null,"daintou","OutSine",0.62],["ctl","avg1_103","a","014",null,0.3,-0.075,1.1,null,"daintou","OutSine",0.62],["se","se_062"],["w",0.3],["se","se_062"],["w",0.2],["say","avg1_103","Iris. You're a god.",0,""],["w",0.4],["ctl","avg1_112","a","004","flower",null,null,null,null,"tiao2","OutSine",0.35],["w",0.35],["say","avg1_112","And a genius! I still can't believe you stash Dorra in your boots.==W== Why not use a wallet?",0,""],["w",0.6],["ctl","avg1_112","a","015","question",null,null,null,null,"lengzhan","OutSine",0.3],["w",0.3],["goon"],["w",0.4],["ctl","avg1_111","a","007","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_111","Well... I read that the Wilds and the cities are both dangerous. It's smarter to spread your cash around. If you get robbed, you don't lose everything at once.",0,""],["ctl","avg1_111","a",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.4],["ctl","avg1_112","a","006","shock",null,null,null,null,null,"OutSine",0.3],["w",0.3],["say","avg1_112","Makes sense!==W== But what if the bad guys read the same book and search every single spot?",0,""],["w",0.6],["ctl","avg1_112","a",null,null,null,null,null,null,null,"Linear",0.3],["w",0.2],["ctl","avg1_112","a","023","awkward",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["goon"],["w",0.4],["ctl","avg1_111","a","006","flurry",null,null,null,null,"daintou","Linear",0.35],["w",0.35],["say","avg1_111","Ah... I, uh...",0,""],["w",0.4],["ctl","avg1_103","a","007","flower",null,null,null,null,"tiao2","Linear",0.5],["say","avg1_103","Beat the bad guys. You keep your money, and you turn them in for a bounty.",0,""],["w",0.4],["bgm",""],["ctl","avg1_111","a","015","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_111","I-I guess that works if you can pull it off?==W== Anyway, changing the subject. What are your plans?",0,""],["w",0.8],["ctl","avg1_111","a",null,null,null,null,null,null,null,"Linear",0.35],["w",0.2],["ctl","avg1_111","a","013","question",null,null,null,null,null,"OutSine",0.35],["w",0.35],["goon"],["w",0.4],["bgm","m55"],["ctl","avg1_103","a","002","attention",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_103","I want to ... see other cities. Nova is big.",0,""],["w",0.4],["ctl","avg1_112","a","007","star",null,null,null,null,"tiao2","Linear",0.35],["w",0.35],["say","avg1_112","I'm gonna be a Trekker! Climb every Monolith just like the Tyrant. All the way to the very top.",0,""],["w",0.3],["stg",0,220.0,-15.0,1.2,"OutCubic",0.7,null,null,null],["ctl","avg1_103","a",null,null,0.17,null,null,0.0,null,"OutCubic",0.7],["hide","avg1_103",0.7],["ctl","avg1_111","a","002",null,0.25,null,null,null,null,"OutCubic",0.7],["ctl","avg1_112","a","002",null,0.59,null,null,null,null,"OutCubic",0.7],["w",0.15],["se","se_113"],["w",0.2],["obj","qstory_main_014",1,null,0.54],["w",0.3],["say","avg1_112","But first, I need to build this.",0,""],["w",0.4],["ctl","avg1_111","a","010","shock",null,null,null,null,null,"Linear",0.35],["w",0.3],["say","avg1_111","Is this ... the Artifact you asked me about?",0,""],["ctl","avg1_111","a",null,null,null,null,null,null,null,"Linear",0.3],["w",0.4],["se","se_077"],["ctl","avg1_112","a","003",null,null,null,null,null,"diantou","OutSine",0.35],["w",0.35],["say","avg1_112","Yeah! The book you lent me called it a steering wheel. It drives a super-fast vehicle.==W== Nova is a large stretch of land with tons of Monoliths. Walking would take forever. Wouldn't driving be more convenient?",0,""],["w",0.7],["ctl","avg1_112","a","005","music",null,null,null,null,null,"OutSine",0.35],["w",0.35],["goon"],["w",0.4],["ctl","avg1_111","a","015","sweaty",null,null,null,null,"lengzhan","Linear",0.5],["w",0.3],["say","avg1_111","It would... But Artifact cars are rare. Can you actually build one?",0,""],["ctl","avg1_111","a",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.4],["se","se_334"],["obj","qstory_main_013",1,null,0.54],["stg",0,null,null,null,"Linear",0.0,null,null,"Xiao"],["ctl","avg1_112","a","013","star",null,null,null,null,"tiao2","Linear",0.35],["w",0.35],["say","avg1_112","Hehehe. Feast your eyes on this.",0,""],["w",0.4],["ctl","avg1_111","a",null,null,0.12,null,null,0.0,null,"OutCubic",0.7],["hide","avg1_111",0.7],["se","se_061"],["show","avg1_103","a","003",0.25,0.1,1.1,0,null,0.0],["ctl","avg1_103","a",null,null,null,-0.07,null,1.0,null,"OutBack",0.75],["w",0.3],["ctl","avg1_103","a","015",null,null,null,null,null,null,"OutSine",0.3],["w",0.3],["say","avg1_103","It's huge. And heavy. What is it?",0,""],["w",0.4],["ctl","avg1_112","a","002","happy",null,null,null,null,"daintou","Linear",0.35],["w",0.35],["say","avg1_112","Heh. It was sitting in the orphanage basement this whole time, covered in dust. I asked Aunt Allie if I could take it when I left.",0,""],["w",0.4],["ctl","avg1_112","a","007","idea",null,null,null,null,"jushou","OutSine",0.35],["say","avg1_112","She didn't know what it was either. But my gut says ... it's the heart of an Artifact car!",0,""],["w",0.4],["ctl","avg1_103","a",null,null,0.15,null,null,0.0,null,"OutCubic",0.7],["hide","avg1_103",0.7],["w",0.1],["show","avg1_111","a","006",0.15,-0.07,1.1,0,null,0.0],["ctl","avg1_111","a",null,"symbol",0.25,null,null,1.0,null,"OutCubic",0.6],["say","avg1_111","The ... heart?!",0,""],["w",0.4],["ctl","avg1_112","a","005","music",null,null,null,null,"jushou","OutSine",0.3],["say","avg1_112","Yeah! Anyway, my gut says if I piece this hunk of metal together right and hook it up to the steering wheel, it'll zoom like crazy.",0,""],["w",0.4],["ctl","avg1_112","a","002","shock",null,null,null,null,null,"OutSine",0.3],["say","avg1_112","Hehe, we've shared our plans. Your turn, Iris!",0,""],["ctl","avg1_112","a",null,null,null,null,null,null,null,"OutSine",0.35],["objx"],["w",0.4],["bgm",""],["cbg",0,-180.0,null,null,"OutCubic",0.7,null,null,null],["ctl","avg1_112","a",null,null,0.68,null,null,0.0,null,"OutCubic",0.7],["hide","avg1_112",0.7],["ctl","avg1_111","a","002","speechless",0.415,null,null,null,null,"OutCubic",0.7],["w",0.4],["say","avg1_111","M-Me? Well, before leaving the orphanage, I passed the preliminary exam for Grace Light Academy. The entrance exam is next week.==W== I ...==W== want to go to college.",0,""],["w",0.75],["ctl","avg1_111","a","012",null,null,null,null,null,null,"OutSine",0.35],["goon"],["w",0.4],["ctl","avg1_111","a","026",null,null,null,null,null,null,"OutSine",0.3],["w",0.3],["goon"],["w",0.4],["trn",0,0,true,true,0.75],["w",0.75],["bg","dessert_house_inside",0,0.0],["cbg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["show","avg1_103","a","005",0.35,-0.1,1.15,0,null,null],["show","avg1_111","a","002",0.65,-0.1,1.15,0,null,null],["trn",1,0,false,false,0.75],["bgm","m137"],["ctl","avg1_103","a",null,"question",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_103","College? Is that to learn powerful magic?",0,""],["w",0.4],["ctl","avg1_111","a","004","sigh",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg1_111","I don't have grand dreams like that. I want a job at a big company like Grace Imperium or United Harvest ... somewhere with steady pay and vacation time.",0,""],["w",0.4],["ctl","avg1_111","a","011","idea",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","avg1_111","That way I can stay in Emor. On my days off, I can help out at the orphanage and take some weight off Aunt Allie's shoulders.",0,""],["w",0.4],["ctl","avg1_111","a","026","attention",null,null,null,null,"daintou","OutSine",0.35],["w",0.35],["say","avg1_111","But it all depends on next week's exam. Before then, I need to find a temp job to scrape together the material fees. I have to pay them on the exam day.",0,""],["w",0.4],["ctl","avg1_103","a","009","question",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_103","Material fees?",0,""],["w",0.4],["trn",0,0,true,false,0.9],["w",0.9],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["film",0],["bg","wog_academy_corridor",0,0.0],["cbg",0,null,null,1.3,"Linear",0.0,null,null,null],["show","avg1_111","b","002",0.75,-0.3,1.5,0,null,0.92],["trn",1,0,false,false,0.9],["cbg",0,-300.0,null,null,"OutSine",20.0,null,null,null],["w",0.4],["say","avg1_111","Yeah. Grace Light Academy tests you on six subjects.",3,""],["w",0.4],["say","avg1_111","Math, Rhetoric, Magic Principles, Magic Application, Grace Energy Studies, and Grace Spells.",3,""],["w",0.4],["say","avg1_111","The exam takes three days, and every subject is at a different location.",3,""],["w",0.4],["bg","wog_academy_classroom",0,0.7],["cbg",0,null,null,1.3,"Linear",0.0,null,null,null],["cbg",0,-300.0,null,null,"OutSine",20.0,null,null,null],["w",0.4],["say","avg1_111","The magic and Monolith subjects require special materials and destructible arenas.",3,""],["w",0.4],["say","avg1_111","Altogether, the fees come out to two hundred thousand Dorra.",3,""],["w",0.4],["trn",0,0,true,true,0.7],["w",0.7],["bg","dessert_house_inside",0,0.0],["cbg",0,-150.0,0.0,1.08,"Linear",0.0,null,null,null],["film",1],["show","avg1_111","a","002",0.65,-0.1,1.15,0,null,null],["show","avg1_103","a","009",0.35,-0.1,1.15,0,null,null],["trn",1,0,false,false,0.7],["w",0.25],["ctl","avg1_103","a",null,"speechless",null,null,null,null,"lengzhan","Linear",0.35],["w",0.35],["say","avg1_103","You only had a hundred thousand, and you shared it with us. Didn't save any extra for the fees?",0,""],["ctl","avg1_103","a",null,null,null,null,null,null,null,"Linear",0.35],["w",0.4],["ctl","avg1_111","a","015","sweaty",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_111","No.==W== But it's fine! If I work twenty hours a day between now and then, I can probably scrounge up the rest.",0,""],["w",0.7],["ctl","avg1_111","a","026","sigh",null,null,null,null,null,"OutSine",0.35],["w",0.35],["goon"],["w",0.4],["cbg",0,80.0,null,null,"OutCubic",0.7,null,null,null],["ctl","avg1_103","a",null,null,0.28,null,null,null,null,"OutCubic",0.7],["ctl","avg1_111","a",null,null,0.5,null,null,null,null,"OutCubic",0.7],["show","avg1_112","a","006",0.84,-0.1,1.15,0,null,0.0],["ctl","avg1_112","a",null,null,0.72,null,null,1.0,null,"OutCubic",0.7],["w",0.25],["ctl","avg1_112","a"