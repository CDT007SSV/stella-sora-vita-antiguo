 you're done.",0,""],["w",0.5],["goon"],["w",0.7],["ctl","avg3_207","a","003","love",null,null,null,null,null,"OutQuint",1.0],["goon"],["w",0.5],["stg",0,0.0,null,1.1,"OutCubic",1.0,null,null,null],["ctl","avg3_207","a",null,null,0.5,null,null,null,null,"OutQuint",1.0],["ctl","avg3_208","a",null,null,null,null,0.78,0.0,null,"OutCubic",1.0],["ctl","avg3_209","a",null,null,null,null,0.78,0.0,null,"OutCubic",1.0],["w",0.2],["ctl","avg3_1287","a",null,null,null,null,-0.73,0.0,null,"OutCubic",1.0],["ctl","avg3_1288","a",null,null,null,null,-0.73,0.0,null,"OutCubic",1.0],["se","se_121"],["mrt",1,"z","009","happy",null],["say","avg3_100","Appreciate it.==W== And that works out perfectly. We needed a local to answer a few questions anyway.",1,""],["w",0.7],["mrt",0,"z","003","speechless","diantou"],["ctl","avg3_207","a","005",null,null,null,null,null,"diantou","Linear",0.5],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["bgm",""],["stg",0,null,null,1.0,"OutCubic",1.0,null,null,null],["trn",0,7,true,true,1.0],["w",1.05],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["fx",0,"fx_avg_dust_2_b",1,0],["bg","field_room_inside_daylight",0,0.0],["w",0.5],["bgm","m62"],["trn",1,7,false,false,1.0],["w",1.0],["head","12:45, Nebula Month 7th, Mirage, Unnamed Street"],["w",0.5],["stg",0,null,null,1.1,"OutCubic",1.0,null,null,null],["show","avg1_111","a","002",0.19,null,1.05,0,null,0.0],["show","avg1_103","a","002",0.34,null,1.05,0,null,0.0],["show","avg1_112","a","002",0.73,null,1.05,0,null,0.0],["ctl","avg1_111","a","021",null,0.15,null,1.0,1.0,null,"OutQuint",1.0],["ctl","avg1_103","a","007",null,0.32,null,1.0,1.0,null,"OutQuint",1.0],["ctl","avg1_112","a","013",null,0.75,null,1.0,1.0,null,"OutQuint",1.0],["w",0.5],["obj","qstory_event_09_005",1,null,null],["fx",0,"fx_avg_bubble",0,0],["ctl","avg1_111","a","021","music",null,null,null,null,"diantou","Linear",1.0],["say","avg1_111","I never saw food like this back in Emor, but every dish is incredible! ♪==W== I'm stuffed. And our supplies are fully sorted out!",0,""],["w",1],["ctl","avg1_111","a","022","happy",null,null,null,null,"daintou","Linear",1.0],["goon"],["w",0.5],["ctl","avg1_103","a","014","shy",null,null,null,null,null,"Linear",0.5],["say","avg1_103","The tagine is good.",0,""],["w",0.5],["ctl","avg1_112","a","004","star",null,null,null,null,"tiao2","Linear",0.5],["say","avg1_112","Got the recipe down! As soon as I find the ingredients, I'm cooking this for you.",0,""],["w",0.5],["ctl","avg1_111","a",null,null,0.11,null,0.95,0.0,null,"OutQuint",1.0],["hide","avg1_111",1.0],["ctl","avg1_103","a",null,null,0.3,null,0.95,0.0,null,"OutQuint",1.0],["hide","avg1_103",1.0],["ctl","avg1_112","a",null,null,0.77,null,0.95,0.0,null,"OutQuint",1.0],["hide","avg1_112",1.0],["objx"],["w",0.3],["stg",0,null,null,1.05,"OutQuint",1.0,null,null,null],["show","avg3_207","a","002",0.5,-0.05,1.15,0,null,0.0],["ctl","avg3_207","a",null,null,null,null,1.1,1.0,null,"OutQuint",1.0],["w",0.5],["ctl","avg3_207","a","003","love",null,null,null,null,null,"Linear",1.0],["say","avg3_207","See? We're out in the middle of nowhere, but Mirage still has charm, right?",0,""],["w",0.5],["mrt",1,"z","003","happy",null],["say","avg3_100","Like they say. Home is where you feel at peace.",1,""],["w",0.5],["mrt",0,"z","012","question","diantou"],["say","avg3_100","Though you were fighting the Imperial Guard pretty hard earlier. Is there bad blood between the Imperial Guard and the locals too?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_146"],["ctl","avg3_207","a","002",null,null,null,null,null,"niunie","Linear",0.5],["say","avg3_207","Nah, not at all. We get along with the Imperial Guard fine.",0,""],["w",0.5],["ctl","avg3_207","a","005","speechless",null,null,null,null,null,"Linear",0.5],["say","avg3_207","How should I put it...==W== Let's call it a business partnership.==W== We're also teammates when it comes to fighting the White Cat Troupe.",0,""],["w",1.0],["ctl","avg3_207","a","002",null,null,null,null,null,null,"Linear",1.0],["goon"],["w",0.7],["goon"],["w",0.5],["mrt",1,"z","009","vexation",null],["say","avg3_100","The White Cat Troupe...==W== I keep hearing that name. Who are they?",1,""],["w",1.0],["mrt",0,"z","002","question",null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_207","a","008","speechless",null,null,null,null,"diantou","Linear",1.0],["bgm",""],["se","se_169"],["trn",0,0,false,true,1.0],["w",1.0],["ctl","avg3_207","a",null,null,null,null,null,0.0,null,"OutCubic",0.0],["bg","mirage_eyphkabar_inside_dusk",0,0.0],["stg",0,null,null,null,"Linear",0.0,null,null,"JingTouYaoHuang"],["w",0.2],["trn",1,0,false,false,1.0],["w",1.0],["bgm","m11"],["say","avg3_207","They used to be the old Nova Empress's personal guard. Over a decade ago they betrayed and took the Empress's life. Total villains.",9,""],["w",0.5],["say","avg3_207","Grace Imperium hired the Imperial Guard to hunt them down. The White Cats fought a running battle all the way here. Mirage is their last stand.",9,""],["w",0.5],["bg","mirage_street_daylight",0,1.0],["say","avg3_207","Word is Mirage used to be loaded back then. But years of fighting turned it into this. Now most of the city is empty ruins.",9,""],["w",0.5],["trn",0,0,false,false,1.0],["w",1.005],["bg","field_room_inside_daylight",0,0.0],["cbg",0,null,null,1.1,"Linear",0.0,null,null,null],["se","se_169"],["ctl","avg3_207","a",null,null,null,null,null,1.0,null,"Linear",0.0],["stg",0,null,null,null,"Linear",0.0,null,null,"stop"],["trn",1,0,false,false,1.0],["w",1.0],["chd",0,0,"avg1_111","a","007","symbol"],["ctl","avg1_111","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_111","E-Even the Empress?!==W== They're that ruthless?==W== Oh no.==W== We're already in their territory!==W== What if they're hiding behind a wall right now waiting to jump us?!",0,""],["w",1.0],["goon"],["w",0.7],["ctl","avg1_111","a","006","exclamation",null,null,null,null,"jushou0","Linear",1.0],["goon"],["w",0.7],["goon"],["w",0.7],["ctl","avg1_111","a",null,null,null,null,null,null,"lengzhan2","Linear",1.0],["se","se_112"],["goon"],["w",0.5],["chd",1,0,"avg1_111","a","002",null],["ctl","avg3_207","a","005","happy",null,null,null,null,"niunie","Linear",0.5],["say","avg3_207","Relax. That all happened when I was a kid.==W== Nowadays Mirage is technically at war, but there are no battles left to fight.",0,""],["w",0.7],["goon"],["w",0.5],["stg",0,null,null,1.15,"OutQuint",1.0,null,null,null],["ctl","avg3_207","a","002",null,null,null,null,null,"diantou","Linear",0.5],["cbg",0,null,null,1.05,"OutQuint",1.0,null,null,null],["se","se_077"],["say","avg3_207","We Desert Scorpions hold the abandoned crystal diamond mine up northeast.==W== The Imperial Guard has the central oasis out west. The White Cat leftovers took the second oasis down south.==W== Everyone has their turf, and we've kept out of each other's way for years.",0,""],["w",0.7],["show","avg3_157","a","002",0.72,-0.3,1.35,0,null,0.0],["ctl","avg3_157","a",null,null,0.7,null,null,0.5,null,"OutCubic",1.0],["goon"],["w",0.7],["show","avg2_968","a","002",0.28,-0.2,1.3,0,null,0.0],["ctl","avg2_968","a",null,null,0.3,null,null,0.5,null,"OutCubic",1.0],["goon"],["w",0.5],["stg",0,null,null,1.1,"OutQuint",1.0,null,null,null],["cbg",0,null,null,1.1,"OutQuint",1.0,null,null,null],["ctl","avg3_157","a",null,null,0.72,null,null,0.0,null,"OutQuint",1.0],["ctl","avg2_968","a",null,null,0.28,null,null,0.0,null,"OutQuint",1.0],["ctl","avg3_207","a","005","music",null,null,null,null,"diantou","Linear",0.5],["say","avg3_207","Besides, there are barely any White Cats left. We could wipe them out with sheer numbers anytime we wanted.",0,""],["w",0.5],["chd",0,2,"avg1_112","a","014","question"],["ctl","avg1_112","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_112","If they're that dangerous, why not take them out?",0,""],["w",0.5],["chd",1,2,"avg1_112","a","002",null],["ctl","avg3_207","a",null,"speechless",null,null,null,null,null,"Linear",0.5],["say","avg3_207","And lose our business?==W== Wipe out the White Cats, and we have nothing to do.",0,""],["w",1.0],["ctl","avg3_207","a","003","happy",null,null,null,null,"diantou2","Linear",1.0],["goon"],["w",0.5],["mrt",1,"y","020","think",null],["say","avg3_100","Business... The kids this morning said something similar.",2,""],["mrt",3,"y",null,null,null],["w",0.5],["se","se_169"],["trn",0,1,true,true,1.0],["w",1.005],["show","avg3_170","a","002",null,null,null,0,null,null],["ctl","avg3_170","a",null,null,null,null,null,null,null,"Linear",0.0],["fx",0,"fx_avg_reminiscence_loop",0,0],["bg","mirage_street_daylight",0,0.0],["trn",1,1,false,false,1.0],["w",1.0],["ctl","avg3_170","a","007","question",null,null,null,null,null,"OutQuint",1.0],["say","Energetic Kid","What are you talking about? A fight means we can finally make some deals!",0,""],["w",0.5],["se","se_169"],["trn",0,1,true,true,1.0],["w",1.0],["fx",0,"fx_avg_reminiscence_loop",1,0],["w",0.005],["bg","field_room_inside_daylight",0,0.0],["cbg",0,null,null,1.1,"Linear",0.0,null,null,null],["show","avg3_207","a","003",null,-0.05,1.1,0,null,null],["bgm",""],["trn",1,1,false,false,1.0],["w",1.0],["mrt",1,"y","003","think",null],["say","avg3_100","Ah. I get it now.",2,""],["mrt",3,"y",null,null,null],["w",0.5],["choice",["You're keeping the enemy alive on purpose."],[[]]],["w",0.5],["bgm","m59"],["ctl","avg3_207","a","006","happy",null,null,null,null,"daintou","Linear",0.5],["say","avg3_207","Sharp as always, Boss.==W== Mirage today is a city that runs entirely on war.",0,""],["w",0.7],["goon"],["w",0.5],["ctl","avg3_207","a","003","sigh",null,null,null,null,"diantou","Linear",0.5],["say","avg3_207","We Desert Scorpions are rough mercenaries. Even if we partner with the Imperial Guard, a little friction is part of the deal.",0,""],["w",0.5],["ctl","avg3_207","a","002","attention",0.7,null,null,null,null,"OutQuint",1.0],["cbg",0,-100.0,null,null,"OutQuint",1.0,null,null,null],["obj","qstory_main_02_013",1,0.35,0.55],["se","se_373"],["say","avg3_207","So we stage a fight every now and then. We leave behind some junk weapons as spoils for the Guard, and they use it to claim victories up the chain.",0,""],["w",0.5],["ctl","avg3_207","a","003","happy",null,null,null,null,"diantou","Linear",0.5],["say","avg3_207","And the Guard? War always costs something, right?==W== They dump some expensive gear, snap evidence with a Photo Capturer,==W== and bill Grace Imperium for battlefield losses.",0,""],["w",0.7],["goon"],["w",0.7],["obj","qstory_side_119_001",1,0.35,0.55],["se","se_473"],["goon"],["w",0.5],["ctl","avg3_207","a","006","speechless",null,null,null,null,null,"Linear",0.5],["say","avg3_207","But those gears aren't broken. They submit a report for new armor and spears,==W== and the money gets cleared.",0,""],["w",1.0],["goon"],["w",0.5],["ctl","avg3_207","a","003","star",null,null,null,null,null,"OutQuint",1.0],["obj","qstory_main_01_010",1,0.35,0.55],["se","se_252"],["say","avg3_207","Then they pay the kids a twentieth of the price to drag that gear back. As for the money marked for new equipment,==W== thirty percent to us, seventy to them. Round and round, and the Dorras keep rolling in.",0,""],["w",0.7],["ctl","avg3_207","a","003","flower",null,null,null,null,"daintou","OutQuint",1.0],["goon"],["w",0.5],["objx"],["cbg",0,0.0,null,null,"OutQuint",1.0,null,null,null],["ctl","avg3_207","a",null,null,0.5,null,null,null,null,"OutQuint",1.0],["mrt",1,"z","003","speechless",null],["say","avg3_100","Talk about a shameless racket...==W== But I guess the kids earn a bit of honest coin from it.==W== I don't know what to think.",1,""],["w",1],["mrt",0,"z","009","sigh","JuGong"],["goon"],["w",0.7],["mrt",0,"z","020",null,"diantou"],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_207","a","005","music",null,null,null,null,null,"Linear",0.5],["say","avg3_207","Come on, don't overthink it ♪ Nobody loses out here. Win-win, right?",0,""],["w",0.5],["ctl","avg3_207","a","003",null,null,-0.1,1.25,null,"JuGong","OutCubic",1.0],["se","se_236"],["say","avg3_207","And~==W== Guess what?==W== Today we put on a real show with the \"White Cats.\"==W== The Guard's gonna file a report on a grueling battle, claim they repelled the entire White Cat army, and demand a massive payout.",0,""],["w",0.7],["goon"],["w",0.7],["goon"],["w",0.7],["ctl","avg3_207","a",null,"happy",null,null,null,null,"huanxin","Linear",1.0],["goon"],["w",0.5],["ctl","avg3_207","a","005","star",null,null,null,null,null,"Linear",0.5],["say","avg3_207","Hehe. From that angle, we oughta thank you!",0,""],["w",0.5],["stg",0,null,null,1.05,"OutCubic",1.0,null,null,null],["chd",0,0,"avg1_111","a","006","shock"],["say","avg1_111","So ... you turned war into a business.",0,""],["w",0.5],["ctl","avg1_111","a",null,null,null,null,null,null,null,"Linear",0.5],["chd",1,0,"avg1_111","a","002",null],["stg",0,null,null,1.1,"OutCubic",1.0,null,null,null],["ctl","avg3_207","a","003","happy",null,null,null,null,"daintou","Linear",0.5],["say","avg3_207","Ahaha!==W== Mirage has no goods worth hauling out of the desert. Without war, nobody here would survive.",0,""],["w",0.7],["goon"],["w",0.5],["mrt",1,"z","020","sigh","JuGong"],["say","avg3_100","If only there were a Monolith here. Everyone could live off Artifacts.==W== Hey, Myrsha, have you ever found one out in the desert?",1,""],["w",0.7],["mrt",0,"z","002","attention","diantou"],["goon"],["mrt",3,"z","002",null,null],["w",0.5],["ctl","avg3_207","a","008","speechless",null,null,null,null,"xuanyun","Linear",0.5],["say","avg3_207","A desert Monolith?==W== Never seen one.==W== People here spot things in the sands all the time, but when they go check, there's nothing there. Probably a castle in the air.",0,""],["w",1.0],["ctl","avg3_207","a",null,"awkward",null,null,null,null,"JuGong","Linear",1.0],["goon"],["w",0.7],["goon"],["w",0.5],["stg",0,50.0,null,null,"OutCubic",1.0,null,null,null],["bg","field_room_inside_daylight",5,0.0],["cbg",5,-