w",0.5],["goon"],["ctl","avg3_152","a","005","star",null,null,null,null,"tiao2","Linear",1.0],["say","avg3_152","You'd be perfectly crispy, Laru. I am sure you'd give off the sweet, rich aroma of a deep-fried potato.",0,""],["ctl","avg1_150","a",null,"speechless",null,null,null,null,null,"Linear",1.0],["say","avg1_150","That sounds delicious...==W== Wait,==W== I can't eat myself.",0,""],["w",0.8],["ctl","avg1_150","a","011","shock",null,null,null,null,"lengzhan","Linear",1.0],["goon"],["w",1.0],["goon"],["cbg",0,0.0,null,null,"OutQuint",0.7,null,null,null],["ctl","avg3_152","a",null,null,null,null,null,0.0,null,"OutQuint",0.7],["ctl","avg1_150","a","004",null,0.38,-0.02,1.05,null,null,"OutQuint",0.7],["stg",0,280.0,-30.0,1.25,"OutQuint",0.7,null,null,null],["se","se_021"],["say","avg1_150","Alright, back to business. I dug up some intel.==W== Angie put me in charge of procuring the daily necessities and snacks, so I have a rough headcount of her current forces.==W==",0,""],["w",0.5],["goon"],["w",0.5],["ctl","avg3_152","a","011",null,0.65,null,null,null,null,"Linear",0.0],["goon"],["ctl","avg1_150","a","021",null,null,null,null,null,"diantou","Linear",1.0],["se","se_252"],["say","avg1_150","About thirty Sentinels of Dawn and Imperial Guards, fifteen Dusk Arbiters,==W== and a few dozen Trekkers.",0,""],["w",0.3],["goon"],["stg",0,0.0,null,1.1,"OutQuint",0.7,null,null,null],["ctl","avg1_150","a",null,null,0.35,0.0,1.0,null,null,"OutQuint",0.7],["ctl","avg3_152","a",null,"flurry",null,null,null,1.0,null,"OutQuint",0.7],["say","avg3_152","That is specific.==W== You got all that from groceries?",0,""],["w",0.3],["goon"],["ctl","avg1_150","a","005",null,null,null,null,null,"diantou","Linear",1.0],["se","se_077"],["say","avg1_150","Yep. The Sentinels and Imperial Guards use a specific oil to maintain their gear, and the Arbiters need special prayer candles.==W== I worked out the rest from daily consumables.",0,""],["w",0.5],["goon"],["ctl","avg1_150","a",null,null,null,null,null,0.0,null,"Linear",0.7],["hide","avg1_150",0.7],["stg",0,-280.0,0.0,1.25,"OutQuint",0.7,null,null,null],["ctl","avg3_152","a","002","happy",0.62,-0.05,1.1,null,null,"OutQuint",0.7],["say","avg3_152","Nice work, Laru. I made a discovery too.==W== Angie had me monitor that person's daily broadcasts on Scarlet Sights for clues.==W==",0,""],["w",0.5],["goon"],["w",0.3],["goon"],["chd",0,0,"avg1_150","a","005","attention"],["say","avg1_150","Ah,==W== you mean Boss.",0,""],["w",0.5],["goon"],["ctl","avg3_152","a","009","angry",null,null,null,null,"lengzhan","Linear",1.0],["say","avg3_152","Laru, you slipped up again!==W== We need to say the Tyrant.",0,""],["ctl","avg1_150","a","010",null,null,null,null,null,null,"Linear",0.5],["w",0.5],["goon"],["ctl","avg1_150","a","017","flurry",null,null,null,null,"lengzhan","Linear",1.0],["ctl","avg3_152","a",null,null,null,null,null,null,null,"Linear",1.0],["say","avg1_150","Sorry, sorry. The Tyrant.==W== Good thing nobody else heard that.",0,""],["w",0.5],["goon"],["chd",1,0,"avg1_150","a","002",null],["ctl","avg3_152","a","002",null,null,null,null,null,null,"Linear",1.0],["say","avg3_152","Anyway, here is what I found. Watch this clip.==W==",0,""],["bg","city_street_water_rain",4,0.0],["show","avg3_100","c","009",null,null,null,4,null,null],["show","avg1_150","a","004",0.35,-0.08,null,0,null,0.0],["w",0.8],["bgm",""],["se","se_507"],["stage",4,0,6],["ctl","avg3_152","a",null,null,0.6,null,null,null,null,"OutQuint",1.0],["ctl","avg1_150","a",null,null,0.38,null,null,1.0,null,"OutQuint",1.0],["obj","qstory_main_08_016",1,0.65,0.54],["goon"],["w",0.5],["stg",4,null,null,1.2,"OutQuint",1.0,null,null,null],["w",0.5],["ctl","avg3_100","c","020","speechless",null,null,null,null,null,"Linear",1.0],["say","Boss (Nazuna)","This rain on the 7th of Nebula Month is expected to last through the next two days, with temperatures continuing to fall.==W== Viewers with travel plans, bring rain gear and dress warmly.",0,""],["w",0.8],["ctl","avg