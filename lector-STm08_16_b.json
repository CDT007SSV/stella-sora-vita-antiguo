.5],["ctl","avg3_210","a","006","question",null,null,null,null,null,"Linear",0.5],["say","avg3_210","Angie showed it to me when she passed through Mirage.==W== Hah!==W== I heard she tried to kill you with it.",0,""],["w",0.7],["ctl","avg3_210","a","005","happy",null,null,null,null,"daintou","Linear",1.0],["goon"],["w",0.7],["goon"],["w",0.5],["ctl","avg3_100","a","026","symbol",null,null,null,null,"lengzhan","Linear",1.0],["say","avg3_100","Angie's here in Mirage?!",0,""],["w",0.5],["ctl","avg3_210","a","003","love",null,null,null,null,"diantou","OutQuint",1.0],["ctl","avg3_100","a","016",null,null,-0.02,null,null,null,"OutQuint",1.0],["say","avg3_210","Relax.==W== After our chat, she slithered off like a snake. Left nothing behind but her disgusting skin.",0,""],["w",1],["obj","qstory_main_08_022",1,null,null],["se","se_113"],["goon"],["w",0.5],["objx"],["ctl","avg3_100","a",null,null,null,null,null,null,null,"OutQuint",1.0],["ctl","avg3_210","a","003","speechless",null,null,null,null,null,"Linear",0.5],["say","avg3_210","But ... she's convinced you're hiding here.==W== She wanted the Desert Scorpions to help the Salvation Committee hunt you down.",0,""],["w",1],["ctl","avg3_210","a","004",null,null,null,null,null,null,"Linear",1.0],["goon"],["w",0.5],["ctl","avg3_210","a","005","happy",null,null,null,null,"diantou","Linear",0.5],["ctl","avg3_100","a","010",null,null,0.0,null,null,null,"OutQuint",1.0],["say","avg3_210","She made a compelling offer.==W== Hand you over, dead or alive,==W== and she gives us the city and its crystal diamond mine.",0,""],["w",1],["ctl","avg3_210","a",null,"attention",null,null,null,null,"youchupeng","Linear",1.0],["goon"],["w",1],["ctl","avg3_210","a",null,null,null,null,null,null,null,"Linear",1.0],["goon"],["w",0.5],["ctl","avg3_210","a","002","love",null,null,null,null,null,"Linear",0.5],["say","avg3_210","Not a bad deal, right? Haha!==W== The Imperial Guard leaves, and we become the undisputed rulers of Mirage.",0,""],["w",1],["ctl","avg3_210","a","003",null,null,null,null,null,"daintou","Linear",1.0],["goon"],["w",0.5],["ctl","avg3_100","a","005","attention",null,null,null,null,"daintou","Linear",1.0],["say","avg3_100","Good to know my life is worth that much.==W== You turned her down to pitch a team-up?==W== But if I say no, you'll walk away with nothing.",0,""],["w",0.7],["ctl","avg3_100","a","009","question",null,null,null,null,null,"Linear",1.0],["ctl","avg3_210","a","004",null,null,null,null,null,null,"Linear",1.0],["goon"],["w",0.7],["ctl","avg3_100","a",null,null,null,null,null,null,"diantou","Linear",1.0],["se","se_077"],["goon"],["w",0.5],["cbg",0,-140.0,null,null,"OutCubic",1.0,null,null,null],["ctl","avg3_210","a","003","music",0.5,null,null,null,null,"OutQuint",1.0],["ctl","avg3_100","a",null,null,0.8,null,1.05,0.0,null,"OutQuint",1.0],["hide","avg3_100",1.0],["say","avg3_210","I'd never take the bait from a snake like her.==W== We have a saying out here. Borrow another person's eyes, and you only see one path.",0,""],["w",1],["ctl","avg3_210","a","004","sigh",null,null,null,null,null,"Linear",1.0],["goon"],["w",0.5],["ctl","avg3_210","a","003","speechless",null,null,null,null,null,"Linear",0.5],["say","avg3_210","Going from mercenary captain to city lord, sitting on a fresh crystal diamond mine. Logically, I should be satisfied.",0,""],["w",0.5],["stg",0,null,null,1.25,"OutQuint",1.0,null,null,null],["ctl","avg3_210","a","005",null,null,null,null,null,null,"Linear",0.5],["fx",0,"fx_avg_line_cen_lp_w",0,1],["se","se_230"],["say","avg3_210","But I want more than a handout.==W== Out here, if you want something, you break them and take it yourself.==W== That's the law of the desert!",0,""],["w",1],["ctl","avg3_210","a","010","happy",null,null,null,null,"diantou","Linear",1.0],["goon"],["w",1],["stg",0,null,null,null,"Linear",1.0,null,null,"Xiao"],["se","se_070"],["ctl","avg3_210","a","005",null,null,null,null,null,null,"Linear",1.0],["goon"],["w",0.5],["stg",0,null,null,1.15,"OutCubic",1.0,null,null,null],["fx",0,"fx_avg_line_cen_lp_w",1,1],["ctl","avg3_210","a","006","speechless",null,null,null,null,null,"Linear",0.5],["say","avg3_210","Play lapdog to a snake and lick up her scraps?==W== Not a chance.==W== You see right through her game, don't you, Boss?",0,""],["w",0.7],["goon"],["w",0.7],["ctl","avg3_210","a","010",null,null,-0.07,1.05,null,"stop","OutQuint",1.0],["se","se_062"],["bgm",""],["goon"],["w",0.5],["choice",["Of course. I have it figured out."],[[]]],["w",0.5],["bgm","m11"],["ctl","avg3_210","a","002",null,null,null,null,null,null,"OutCubic",1.0],["show","avg1_136","a","002",0.7,-0.3,1.5,0,null,0.0],["ctl","avg1_136","a",null,null,0.65,null,null,0.4,null,"OutCubic",1.5],["mrt",1,"z","003","speechless",null],["say","avg3_100","If I die, she can forge enough evidence to brand me as the true Tyrant.",1,""],["w",0.5],["mrt",0,"z","002",null,"diantou"],["say","avg3_100","Once she does, clearing her name and retaking the Sky Institute can't be simpler.",1,""],["w",0.5],["ctl","avg1_136","a",null,null,0.5,null,null,0.0,null,"OutCubic",1.0],["hide","avg1_136",1.0],["ctl","avg3_210","a",null,null,null,null,null,0.0,null,"OutCubic",1.0],["bg","desert_notower_daylight",0,1.0],["stg",0,null,null,null,"Linear",1.0,null,null,"JingTouYaoHuang"],["say","avg3_100","Mirage has no Monolith. You have to import every daily Artifact, and you must export your crystal diamonds to earn Dorra.",9,""],["w",0.5],["bg","wog_store_inside",0,1.0],["say","avg3_100","Any Artifact pulled from the Wilds must be appraised by the Soul Shop before it can be sold. The Sky Institute runs the Soul Shop. No matter what, you'd be answering to her.",9,""],["w",0.5],["show","avg1_163","a","002",0.65,null,0.95,0,null,0.0],["show","avg3_157","a","002",0.35,null,-0.95,0,null,0.0],["ctl","avg1_163","a",null,null,null,null,null,1.0,null,"OutCubic",1.0],["ctl","avg3_157","a",null,null,null,null,null,1.0,null,"OutCubic",1.0],["bg","bank_counter",0,1.0],["say","avg3_100","The Imperial Guard buys most of your crystal diamonds, and the Sky Institute pays the Imperial Guard. That means they control your sales too.",9,""],["w",0.5],["ctl","avg1_163","a",null,null,null,null,null,0.0,null,"OutCubic",1.0],["hide","avg1_163",1.0],["ctl","avg3_157","a",null,null,null,null,null,0.0,null,"OutCubic",1.0],["hide","avg3_157",1.0],["bg","story_main_02_010",0,1.0],["say","avg3_100","Ultimately, she controls everything in and out of Mirage. When someone else sets your prices, that's just slavery.",9,""],["w",0.5],["se","se_169"],["trn",0,0,false,false,1.0],["w",1.0],["stg",0,null,null,null,"Linear",0.0,null,null,"stop"],["bg","mirage_eyphkabar_inside_daylight",0,0.0],["ctl","avg3_210","a","004",null,null,null,null,1.0,null,"Linear",0.0],["trn",1,0,false,false,1.0],["w",1.0],["ctl","avg3_210","a","004",null,null,null,null,null,"daintou","Linear",1.0],["se","se_349"],["say","avg3_210","I knew I picked right. You pieced it all together from just a few scraps.",0,""],["w",0.5],["ctl","avg3_210","a","003","happy",null,null,null,null,"diantou","Linear",0.5],["say","avg3_210","Desert Scorpions are the descendants of Mirage's founders. We were the first to mine crystal diamonds here.==W== This city is ours.",0,""],["w",0.7],["goon"],["w",0.5],["show","avg3_157","a","002",0.8,-0.2,1.2,0,null,0.0],["ctl","avg3_210","a","006","angry",null,null,null,null,"lengzhan","Linear",0.5],["ctl","avg3_157","a",null,null,0.75,null,null,0.5,null,"OutCubic",1.5],["say","avg3_210","But back then, the Imperial Guard monopolized the trade.==W== The crystal diamonds we bled to dig up were sold to them for next to nothing.",0,""],["w",0.7],["goon"],["w",0.5],["show","avg1_136","a","002",0.2,-0.2,1.2,0,null,0.0],["ctl","avg1_136","a",null,null,0.25,null,null,0.5,null,"OutCubic",1.5],["ctl","avg3_210","a",null,"speechless",null,null,null,null,null,"Linear",0.5],["say","avg3_210","Then we misplaced our trust in Grace Imperium. We took up arms to fight the White Cats for them, but ended up as cannon fodder who they didn't have to pay pensions to.",0,""],["w",0.5],["stg",0,null,null,1.1,"OutCubic",1.0,null,null,null],["ctl","avg1_136","a",null,null,0.2,null,null,0.0,null,"OutCubic",1.0],["hide","avg1_136",1.0],["ctl","avg3_157","a",null,null,0.8,null,null,0.0,null,"OutCubic",1.0],["hide","avg3_157",1.0],["ctl","avg3_210","a",null,"resentful",null,null,null,null,"jingxia2","Linear",0.5],["say","avg3_210","I thought times had changed. Then Angie waltzes in with the same old trick. Does she think we're stupid?",0,""],["w",0.5],["ctl","avg3_210","a","004","sigh",null,null,null,null,"diantou","Linear",0.5],["say","avg3_210","That's the long and short of it.==W== Desert Scorpions don't bow to anyone anymore.==W== I'll keep fighting until we get what's ours.",0,""],["w",0.7],["goon"],["w",0.7],["ctl","avg3_210","a","010",null,null,-0.15,1.15,null,null,"OutQuint",1.0],["se","se_062"],["goon"],["w",0.5],["mrt",1,"z","003","question","diantou"],["say","avg3_100","Then why take that job from United Harvest?==W== Coming to Philae to kill me doesn't sound like fighting for yourselves.",1,""],["w",0.7],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_210","a","003","happy",null,null,null,null,null,"Linear",0.5],["say","avg3_210","Heh, fair point.==W== The Imperial Guard acts like our ally, but they actually watch us like hawks.==W== They count heads every time we leave the desert, making sure we don't set up base outside.",0,""],["w",0.7],["ctl","avg3_210","a","010",null,null,null,null,null,null,"Linear",1.0],["goon"],["w",0.7],["ctl","avg3_210","a",null,null,null,null,null,null,null,"Linear",1.0],["goon"],["w",0.5],["ctl","avg3_210","a","008","vexation",null,null,null,null,"niunie","Linear",0.5],["say","avg3_210","It's like flies you can't shake. Annoying as hell.==W== So we used that commission to fake some casualties. We let our people \"die\" on paper so they could quietly set up base.",0,""],["w",0.7],["ctl","avg3_210","a","004",null,null,null,null,null,"diantou","Linear",1.0],["se","se_077"],["goon"],["w",0.5],["ctl","avg3_210","a","002","attention",0.35,null,null,null,null,"OutQuint",1.0],["obj","qstory_main_02_001",1,0.7,0.55],["say","avg3_210","Of course, what I really wanted were those Seals of Grace you supposedly carried.==W== One Seal, and we can start our own company.==W== We might not match Grace Imperium or United Harvest, but at least we wouldn't get squeezed dry.",0,""],["w",1],["ctl","avg3_210","a","003","music",null,null,null,null,"diantou","Linear",1.0],["goon"],["w",1],["ctl","avg3_210","a","004","happy",null,null,null,null,null,"Linear",1.0],["goon"],["w",0.5],["objx"],["show","avg1_145","a","002",0.75,-0.2,1.3,0,null,0.0],["ctl","avg1_145","a",null,null,0.65,null,null,0.5,null,"OutCubic",1.5],["ctl","avg3_210","a","008","awkward",null,null,null,null,"lengzhan","Linear",1.0],["say","avg3_210","Didn't expect your fox to be so tough, fending us off singlehandedly.==W== Her beating us up actually made our fake casualties look convincing, so it wasn't a total loss.",0,""],["w",0.7],["ctl","avg3_210","a","009","sigh",null,null,null,null,"diantou","Linear",1.0],["goon"],["w",0.5],["ctl","avg3_210","a",null,null,0.5,null,null,null,null,"OutQuint",1.0],["ctl","avg1_145","a",null,null,0.5,null,null,0.0,null,"OutQuint",1.0],["hide","avg1_145",1.0],["stg",0,null,null,1.05,"OutCubic",1.0,null,null,null],["mrt",1,"z","009","attention",null],["say","avg3_100","I see.==W== Well, I have three Seals on me right now.==W== Since we're partners, if everything goes well, I might let you have one.",1,""],["w",0.7],["se","se_228"],["mrt",0,"z","002",null,"diantou"],["goon"],["w",0.7],["mrt",0,"z","004","music","diantou"],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_210","a","005","happy",null,null,null,null,"diantou","Linear",0.5],["say","avg3_210","Hah! You never disappoint.==W== I'll hold you to that when the time comes.",0,""],["w",0.7],["ctl","avg3_210","a","010","star",null,null,null,null,null,"Linear",1.0],["goon"],["w",0.5],["ctl","avg3_210","a","003","speechless",null,null,null,null,null,"Linear",0.5],["say","avg3_210","But...==W== I'd take Scepters of Death over a Seal any day.==W== An exclusive Artifact like that is way better for us, no matter if we use or sell it.",0,""],["w",1.0],["obj","qstory_main_07_019",1,0.7,0.55],["ctl","avg3_210","a","002","attention",0.35,null,null,null,null,"OutQuint",1.0],["goon"],["w",1],["ctl","avg3_210","a",null,"love",null,null,null,null,"youchupeng","Linear",1.0],["goon"],["w",0.5],["objx"],["ctl","avg3_210","a","004",null,0.5,null,null,null,null,"OutQuint",1.0],["mrt",1,"z","003","speechless",null],["say","avg3_100","Heads up. Wishing for an Artifact like that will cost you a ton of memories.==W== If you want to keep them, you have to make a soul pact and put your soul in my hands.",1,""],["w",0.7],["se","se_140"],["mrt",0,"z","002",null,"diantou"],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_210","a","003","happy",null,null,null,null,"niunie","Linear",0.5],["say","avg3_210","Hah! No way.==W== I'd rather lose my memories than hand my fate to someone else.",0,""],["w",0.7],["ctl","avg3_210","a","010",null,null,null,null,null,null,"Linear",1.0],["goon"],["w",0.5],["ctl","avg3_210","a","004","music",null,null,null,null,"diantou","Linear",0.5],["say","avg3_210","Anyway, thanks for the deal.==W== By the way, it looks like your pursuers are about to catch up...",0,""],["w",1],["stg",0,50.0,null,null,"OutQuint",1.0,null,null,null],["ctl","avg3_210","a","003","speechless",0.6,null,null,null,null,"OutQuint",1.0],["goon"],["w",0.5],["stg",0,0.0,null,null,"OutQuint",1.0,null,null,null],["ctl","avg3_210","a","002","attention",0.5,null,null,null,null,"OutQuint",1.0],["say","avg3_210","Once Director Allie and the kids evacuate, we'll slip out of Mirage tonight too.==W== There's a secret tunnel in the mines.",0,""],["w",0.7],["goon"],["w",0.5],["mrt",1,"z","004","star",null],["say","avg3_100","Got it.",1,""],["mrt",3