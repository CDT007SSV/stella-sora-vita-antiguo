",1.0],["say","0","==Off== The White Cats' guns are yours.",8,""],["w",0.5],["say","0","==Off== You won't need your guns for this one.",8,""],["w",0.5],["se","se_021"],["say","0","==Off== Go to this address. Someone will be waiting for you.",8,""],["w",0.5],["say","0","==Off== And I need you to protect... No. Not to protect them.",8,""],["w",0.5],["say","0","==Off== I want you to leave the White Cats behind. Start over, Taffett. Just live your life.",8,""],["w",0.5],["se","se_052"],["say","0","==Off== Leave the White Cats behind? Live my life?",8,""],["w",0.5],["say","0","==Off== With all due respect, Your Majesty... I do not understand.",8,""],["w",0.5],["say","0","==Off== You don't have to understand it right now.",8,""],["w",0.5],["say","0","==Off== Someday, you will.",8,""],["w",0.5],["ctl","avg3_182","a",null,null,null,null,null,0.0,null,"OutCubic",1.0],["hide","avg3_182",1.0],["ctl","avg1_139","c",null,null,null,null,null,0.0,null,"OutCubic",1.0],["hide","avg1_139",1.0],["w",1],["se","se_483"],["say","0","==Off== Fate always puts things exactly where they belong.",8,""],["w",0.5],["fx",0,"fx_avg_noise",1,0],["se","se_387"],["se","se_188_stop"],["trn",0,0,true,true,0.7],["w",0.7],["say","0","Monolith Calendar Year 981",8,""],["w",0.5],["stg",0,null,null,1.1,"Linear",0.0,null,null,null],["bg","city_creche_inside_daylight",0,0.0],["cbg",0,null,null,1.15,"Linear",0.0,null,null,null],["stg",0,null,null,1.05,"OutCubic",3.5,null,null,null],["se","se_188"],["show","avg1_139","c","021",null,-0.2,1.2,0,null,0.0],["ctl","avg1_139","c",null,null,null,null,null,1.0,null,"OutCubic",3.5],["trn",1,0,false,false,1.0],["w",1.0],["head","09:50, Floris Month 2nd, Ash District in Emor, Safe House"],["w",0.5],["se","se_188_stop"],["se","se_138"],["ctl","avg1_139","c",null,null,null,null,null,null,"diantou","Linear",1.0],["w",1.0],["se","se_055"],["say","Calm Voice","That was it, Narida. Our last conversation. She handed me this Artifact tape right before I slipped out of the palace.",0,""],["w",0.5],["bgm","m14"],["cbg",0,null,null,1.05,"OutCubic",1.0,null,null,null],["ctl","avg1_139","c",null,null,0.7,-0.03,1.0,null,null,"OutQuint",1.0],["w",0.3],["show","avg3_181","a","010",0.28,-0.03,0.95,0,null,0.0],["ctl","avg3_181","a","004",null,0.3,null,1.0,1.0,null,"OutQuint",1.0],["say","avg3_181","Thanks for sharing this, Taffett.==W== But you should know... The Empress died shortly after you left.",0,""],["w",0.7],["ctl","avg1_139","c","024",null,null,null,null,null,null,"Linear",1.0],["ctl","avg3_181","a","006","sigh",null,null,null,null,"JuGong","Linear",1.0],["goon"],["w",0.5],["ctl","avg3_181","a","004",null,null,null,null,null,null,"Linear",0.5],["say","avg3_181","Think back. Did you spot anything odd while you were there? Anyone acting strange? Give me anything.",0,""],["w",1.0],["se","se_552"],["ctl","avg1_139","c",null,null,null,null,null,null,"niunie","Linear",0.5],["say","Taffett","Nothing. I swept every inch of that palace myself. It was completely secure.",0,""],["w",1.0],["ctl","avg3_181","a",null,"speechless",null,null,null,null,null,"Linear",0.5],["say","avg3_181","But...==W== Something isn't adding up.==W== Why are the new Empress and the Grace Imperium pushing a rumor==W== that she was murdered?",0,""],["w",1],["goon"],["w",1],["ctl","avg3_181","a","014","vexation",null,null,null,null,"lengzhan","Linear",1.0],["goon"],["w",0.5],["ctl","avg1_139","c","017",null,null,null,null,null,null,"Linear",1.0],["goon"],["w",0.5],["ctl","avg3_181","a","006",null,null,null,null,null,null,"Linear",1.0],["ctl","avg1_139","c",null,"symbol",null,null,null,null,"jushou0","Linear",0.5],["say","Taffett","Murdered?!==W== Give me this investigation, Narida.==W== If someone actually killed her,==W== I'll carve them to pieces.",0,""],["w",0.7],["stg",0,50.0,null,null,"OutCubic",1.0,null,null,null],["ctl","avg1_139","c",null,null,0.65,null,null,null,null,"OutQuint",1.0],["se","se_062"],["ctl","avg1_139","c","018",null,null,null,null,null,null,"Linear",1.0],["goon"],["w",0.7],["ctl","avg1_139","c",null,"angry",null,null,null,null,null,"Linear",1.0],["goon"],["w",0.7],["ctl","avg1_139","c",null,null,null,null,null,null,"lengzhan","Linear",1.0],["se","se_230"],["goon"],["w",0.5],["stg",0,0.0,null,null,"OutCubic",1.0,null,null,null],["ctl","avg3_181","a","014",null,0.38,null,null,null,null,"OutQuint",1.0],["se","se_062"],["w",0.6],["ctl","avg3_181","a",null,null,null,null,null,null,"diantou","Linear",1.0],["se","se_019"],["w",0.2],["ctl","avg1_139","c","023",null,null,null,null,null,"diantou","Linear",1.0],["say","avg3_181","Reel it in, Taffett.==W== You always fly off the handle like this.==W== Look, based on my intel, the whole murder angle is a joke. Her Majesty had been sick for years.==W== She was already running out of time.",0,""],["w",0.5],["ctl","avg3_181","a",null,null,null,null,null,null,null,"Linear",1.0],["goon"],["w",0.7],["ctl","avg3_181","a","004","sigh",null,null,null,null,null,"Linear",1.0],["goon"],["w",0.7],["goon"],["w",0.5],["ctl","avg3_181","a","014","vexation",null,null,null,null,null,"Linear",0.5],["say","avg3_181","Besides, the new regime doesn't trust us anyway. They've handed the entire investigation over to the Dusk Arbiter. We're completely locked out.",0,""],["w",0.5],["ctl","avg1_139","c","019","question",null,null,null,null,null,"Linear",0.5],["say","Taffett","The Dusk Arbiter? Please. All they do is chase shadows and scream \"heretic.\"==W== They couldn't investigate a crime scene if their lives depended on it.==W== No, I'm looking into this.",0,""],["w",0.7],["se","se_552"],["ctl","avg1_139","c","018",null,null,null,null,null,"niunie","Linear",1.0],["goon"],["w",0.7],["stg",0,-100.0,null,null,"OutCubic",0.7,null,null,null],["ctl","avg1_139","c",null,null,0.8,null,1.05,null,"manbu2","OutQuint",1.0],["ctl","avg3_181","a",null,null,null,null,null,null,null,"OutQuint",1.0],["se","se_062"],["se","se_062"],["goon"],["w",0.5],["stg",0,-180.0,null,1.1,"OutQuint",1.0,null,null,null],["ctl","avg3