ll,null,"OutBack",0.7],["say","avg3_207","Sorry to pry, but I noticed you staring at the board forever. Can't find a good commission?",0,""],["ctl","avg3_138","a","008","sigh",null,null,null,null,"diantou","Linear",1.0],["say","Novice Trekker","Yeah. Nobody wants a partner. Clients take one look at an average Trekker like me and pass.",0,""],["ctl","avg3_207","a","008","sigh",0.35,null,null,null,null,"OutQuint",1.0],["ctl","avg3_138","a",null,null,0.5,null,null,null,null,"OutQuint",1.0],["stg",0,200.0,null,1.25,"OutQuint",1.0,null,null,null],["se","se_062"],["say","avg3_207","I hear you. Standard leather armor, basic sword, fresh to the adventurer life. People size you up fast.",0,""],["ctl","avg3_207","a","004","resentful",null,null,null,null,"tiao2","Linear",1.0],["say","avg3_207","But hey, that's how it works everywhere in Nova.",0,""],["se","se_208"],["ctl","avg3_138","a",null,null,0.55,-0.2,-1.2,0.0,null,"OutQuint",0.5],["hide","avg3_138",0.5],["ctl","avg3_207","a","005",null,null,-0.15,1.2,null,"niunie1","OutQuint",1.0],["stg",0,null,-100.0,1.3,"OutCubic",0.5,null,null,null],["say","avg3_207","That's why I've got the perfect weapon for you. Check this out! With this in your hands, clients will be lining up to hire you.",0,""],["w",0.5],["obj","qstory_main_08_023",1,0.6,0.54],["fx",0,"fx_speedline_center_w",0,2],["se","se_084"],["ctl","avg3_207","a","002",null,null,null,null,null,"lengzhan","OutQuint",1.0],["w",1.2],["chd",0,2,"avg3_138","a","008","question"],["say","Novice Trekker","Is that ... a magic gun? I've never seen one shaped like that. But honestly, I suck at magic...",0,""],["ctl","avg3_207","a","007","flurry",0.3,null,null,null,null,"OutQuint",1.0],["chd",1,2,"avg3_138","a","002",null],["say","avg3_207","Oh, don't worry about that! This is no magic gun.==W== You ever hear of the Scepter of Death?",0,""],["w",0.7],["goon"],["show","avg3_138","a","007",0.7,-0.2,1.2,0,null,0.0],["objx"],["ctl","avg3_207","a",null,null,0.35,0.0,1.0,null,null,"OutQuint",1.0],["ctl","avg3_138","a",null,"speechless",0.65,0.0,1.0,1.0,null,"OutQuint",1.0],["stg",0,0.0,0.0,1.05,"OutQuint",1.0,null,null,null],["say","Novice Trekker","The Scepter of Death? That artifact they keep talking about on the news? I heard it's rare... The metal feels unlike anything I've ever touched.",0,""],["ctl","avg3_138","a",null,null,null,null,null,null,null,"Linear",1.0],["ctl","avg3_207","a","002","attention",null,null,null,null,"diantou","Linear",1.0],["say","avg3_207","Hehe, that's right! This is the newest Desert Scorpion product. The Scepter of Death 47.==W== Easy to use, easy to maintain. Even a kid like me can easily aim.",0,""],["w",0.7],["goon"],["se","se_447"],["ctl","avg3_207","a","005","love",0.4,null,null,null,"JuGong","OutQuint",1.0],["stg",0,-80.0,-30.0,1.2,"OutQuint",1.0,null,null,null],["bg","mood_1",0,0.5],["fx",0,"fx_avg_bubble_lp",0,2],["say","avg3_207","Only 99,999 Dorra. This Scepter came out of a Monolith yesterday. Brand new and all yours.",0,""],["ctl","avg3_138","a","008","awkward",null,null,null,null,"ChanDou1","Linear",1.0],["say","Novice Trekker","That price seems way too low for a rare Artifact.==W== Is this a scam?",0,""],["w",0.7],["goon"],["fx",0,"fx_avg_bubble_lp",1,2],["bg","travellers_home_inside",0,0.5],["stg",0,0.0,0.0,1.05,"OutQuint",1.0,null,null,null],["ctl","avg3_207","a","002","happy",0.35,null,null,null,null,"OutQuint",1.0],["say","avg3_207","Take it and try it out. If you like it, come back in a week and pay. If not, bring it back within seven days. No questions asked.",0,""],["ctl","avg3_138","a","007","star",null,null,null,null,null,"Linear",1.0],["say","Novice Trekker","A Scepter of Death...! Hehe, the news calls you villains, but you Desert Scorpions are actually pretty sweet.",0,""],["se","se_077"],["ctl","avg3_138","a","006",null,null,null,null,null,"diantou","Linear",1.0],["say","Novice Trekker","Alright, I'll borrow it then. Thanks!",0,""],["ctl","avg3_207","a","006","music",null,null,null,null,"tiao2","Linear",1.0],["say","avg3_207","Pleasure doing business with you!",0,""],["w",0.5],["ctl","avg3_138","a",null,null,0.8,null,null,0.0,null,"OutQuart",1.0],["hide","avg3_138",1.0],["se","se_010"],["w",1],["show","avg1_103","a","007",0.6,-0.3,1.2,0,null,0.0],["ctl","avg3_207","a",null,null,null,null,null,null,null,"OutQuint",1.0],["ctl","avg1_103","a",null,null,null,-0.15,null,1.0,null,"OutBack",0.7],["se","se_236"],["bgm",""],["say","avg1_103","Wow...==W== You sold it quick.",0,""],["w",1],["goon"],["ctl","avg1_103","a",null,null,null,null,null,null,null,"OutQuint",1.0],["ctl","avg3_207","a","005","happy",null,null,null,null,"niunie1","OutQuint",1.0],["bgm","m79"],["say","avg3_207","Nah, it's not me! Thank Boss. ==SEX1== pulled all kinds of Scepters from the Wishing Box. We're cashing in big time ♪",0,""],["show","avg3_210","a","003",0.7,null,null,0,null,0.0],["ctl","avg1_103","a",null,null,null,null,null,0.0,null,"OutQuint",0.7],["hide","avg1_103",0.7],["ctl","avg3_210","a",null,"sigh",0.65,null,null,1.0,null,"OutQuint",1.0],["se","se_062"],["say","avg3_210","But honestly, I expected more. I thought the Scepter of Death had some legendary power. Turns out it's just a handy tool.",0,""],["chd",0,0,"avg1_111","a","010","speechless"],["say","avg1_111","That works in our favor. Once it's widespread, people will see it's not the apocalyptic weapon from the prophecies.",0,""],["chd",0,2,"avg1_112","a","007","attention"],["ctl","avg1_111","a",null,null,null,null,null,null,null,"Linear",1.0],["say","avg1_112","And once that happens, all those rumors about the Tyrant destroying the world will fall apart on their own.",0,""],["chd",1,0,"avg1_111","a","002",null],["chd",1,2,"avg1_112","a","002",null],["stg",0,null,-30.0,1.1,"OutQuint",1.0,null,null,null],["ctl","avg3_210","a","005","music",null,null,null,null,"niunie1","Linear",1.0],["say","avg3_210","Sell the weapon cheap or give it away, then make a profit on the ammo. Haha, Boss is a damn business genius.",0,""],["ctl","avg3_210","a","004","happy",null,null,null,null,"diantou","Linear",1.0],["say","avg3_210","Thanks to you, we Desert Scorpions can walk through Emor with our heads held high under the Boss Accord banner. I mean it. Thank you.",0,""],["w",0.5],["mrt",1,"z","013",null,"JuGong"],["se","se_077"],["say","avg3_100","We look out for each other. We never would have escaped Angie's assault without your help.",1,""],["mrt",0,"z","010","sweaty","lengzhan"],["say","avg3_100","Besides, the Scorpions have taken their fair share of hits lately too.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_210","a","010",null,0.53,-0.05,1.1,null,null,"OutQuint",1.0],["ctl","avg3_207","a",null,null,0.3,null,0.98,null,null,"OutQuint",1.0],["se","se_062"],["se","se_226"],["say","avg3_210","We aren't afraid of a few casualties to get what we want.",0,""],["chd",0,2,"avg1_112","a","006","attention"],["say","avg1_112","Here's the weird part, though. I heard the big companies are hunting Angie even harder now that the Scepters of Death are everywhere.",0,""],["ctl","avg1_112","a","015","question",null,null,null,null,null,"OutBack",0.7],["say","avg1_112","If these Scepters are what's pushing the workers to rebel, you'd think the Senate would be gunning for us instead of her.",0,""],["ctl","avg3_210","a","002","happy",null,null,null,null,"JuGong","Linear",1.0],["say","avg3_210","Ha! They would love to get rid of us. But we're the only ones who know how to wish up more Scepters, so they can't afford to touch us.",0,""],["chd",1,2,"avg1_112","a","002",null],["ctl","avg3_210","a","003",null,null,null,null,null,"diantou","Linear",1.0],["se","se_077"],["say","avg3_210","Trace it all back and this whole mess is Angie's fault anyway. Coming after us would be a waste of time.",0,""],["w",0.5],["mrt",1,"y","014","attention",null],["say","avg3_100","A few major companies have actually approached me in secret. They want to partner up and sell the Scepters of Death together.",1,""],["mrt",0,"y","003","speechless","niunie1"],["ctl","avg3_210","a","004",null,null,null,null,null,null,"Linear",1.0],["say","avg3_100","I turned them down. Told them Boss Accord is too busy dodging the Salvation Committee to think about partnerships right now.",1,""],["mrt",0,"z","004",null,"diantou"],["se","se_077"],["say","avg3_100","I'm sure they got the hint—deal with the Committee first, and then we talk business.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["chd",0,0,"avg1_111","a","006","exclamation"],["say","avg1_111","You're even getting outside companies to do your work. That's some terrifying strategy, Boss.",0,""],["chd",0,2,"avg1_103","a","006","star"],["say","avg1_103","Boss is smart.",0,""],["ctl","avg1_111","a","016","vexation",null,null,null,null,"JuGong","Linear",1.0],["say","avg1_111","But ... are you sure about this? Flooding the market with these Scepters... I have a bad feeling. Word is a top executive at Omnisky Aegis has been murdered.",0,""],["ctl","avg3_207","a","006","happy",0.35,0.0,1.0,null,null,"OutQuint",1.0],["ctl","avg3_210","a",null,null,0.65,0.0,1.0,null,null,"OutQuint",1.0],["chd",1,0,"avg1_111","a","002",null],["chd",1,2,"avg1_103","a","002",null],["say","avg3_207","You worry too much. Those corporate suits had it coming. Besides, we're putting power in the hands of people who never had a way to fight back.",0,""],["ctl","avg3_207","a","005","music",null,null,null,null,"JuGong","Linear",1.0],["say","avg3_207","If you ask me, this is way healthier than the old days, when your worth was measured by your magic and your wallet.",0,""],["w",0.5],["mrt",1,"y","003","speechless",null],["bgm",""],["say","avg3_100","I see where Myrsha's coming from, but Iris isn't wrong to worry.",2,""],["mrt",0,"y","020",null,"diantou"],["se","se_077"],["say","avg3_100","Once we're done with the Salvation Committee, I need to rethink our distribution strategy for the Scepters of Death.",2,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg3_210","a",null,null,null,null,null,