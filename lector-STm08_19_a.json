,["say","Taffett","Heh...==W== Strict even with the wounded.==W== You were born to be ...==W== the captain of the White Cats.",0,""],["w",0.5],["ctl","avg1_139","d",null,null,null,null,null,null,null,"Linear",1.0],["goon"],["w",0.5],["stg",0,-50.0,null,null,"OutQuint",1.0,null,null,null],["ctl","avg1_139","d",null,null,0.6,-0.1,null,null,null,"OutQuint",1.0],["ctl","avg3_181","a","006",null,0.45,-0.05,null,null,null,"OutQuint",1.0],["se","se_019"],["goon"],["w",0.7],["goon"],["w",0.5],["ctl","avg3_181","a",null,null,null,0.0,null,null,null,"OutQuint",1.0],["ctl","avg1_139","d",null,null,null,-0.05,null,null,null,"OutQuint",1.0],["se","se_074"],["say","Taffett","Hey...==W== Drop me at the door. And ...==W== take my guns, please.",0,""],["w",1],["ctl","avg1_139","d","027",null,null,null,null,null,null,"Linear",1.0],["goon"],["w",1],["obj","qstory_main_028",0,null,0.55],["se","se_078"],["ctl","avg1_139","d",null,null,null,null,null,null,null,"Linear",1.0],["goon"],["w",0.5],["objx"],["ctl","avg3_181","a","014",null,null,null,null,null,null,"Linear",0.5],["say","avg3_181","Taffett, you need something to defend yourself.",0,""],["w",0.5],["cbg",0,300.0,null,1.2,"Linear",40.0,null,null,null],["ctl","avg3_181","a",null,null,null,null,null,null,"manbu_loop","Linear",1.0],["se","se_062"],["w",0.2],["ctl","avg1_139","d","012","sigh",null,null,null,null,"manbu_loop","Linear",0.5],["w",0.3],["se","se_062"],["say","Taffett","I don't need anything...==W== At least ...==W== not in front of ...==W== the kids.",0,""],["w",1],["goon"],["w",1],["goon"],["w",1],["goon"],["w",0.5],["ctl","avg1_139","d",null,"speechless",null,null,null,null,null,"Linear",0.5],["say","Taffett","They don't know ...==W== who I am...==W== And since they don't,==W== they never need to...",0,""],["w",1],["goon"],["w",1],["goon"],["w",0.7],["goon"],["w",0.5],["ctl","avg1_139","d","006",null,null,null,null,null,null,"Linear",0.5],["say","Taffett","Besides...==W== I don't want them to see me holding bloodstained weapons.",0,""],["w",1],["goon"],["w",0.5],["ctl","avg3_181","a","010","speechless",null,null,null,null,null,"Linear",0.5],["say","avg3_181","I wouldn't be too sure. They're smart. Maybe they already...",0,""],["w",0.5],["ctl","avg3_181","a",null,null,null,null,null,null,null,"Linear",1.0],["ctl","avg1_139","d","013","vexation",null,null,null,null,null,"Linear",0.5],["say","Taffett","Even so...==W== I won't drag them into our world.==W== Let this pointless fighting stay in the past. It ends with us.",0,""],["w",1],["goon"],["w",0.7],["goon"],["w",0.5],["ctl","avg3_181","a","005","happy",null,null,null,null,null,"Linear",0.5],["say","avg3_181","Ha! Look how much you've changed, Taffett.",0,""],["w",0.5],["ctl","avg1_139","d","005","flower",null,null,null,null,null,"Linear",0.5],["say","Taffett","Of course. I'm growing too...==W== Even if my housekeeping is a lost cause...==W== Anyway...==W== Help me keep this a secret...==W== You can do that, right?",0,""],["w",0.7],["ctl","avg1_139","d","027",null,null,null,null,null,null,"Linear",1.0],["goon"],["w",1],["goon"],["w",1],["ctl","avg1_139","d","012",null,0.59,-0.08,null,null,null,"OutCubic",1.0],["se","se_208"],["goon"],["ctl","avg3_181","a","008",null,null,null,null,null,null,"Linear",1.0],["w",1],["goon"],["w",0.5],["ctl","avg3_181","a","010",null,null,null,null,null,null,"Linear",0.5],["say","avg3_181","You play dirty...==W== How can I say no when you're in this state?",0,""],["w",1],["goon"],["se","se_062"],["trn",0,0,false,false,0.5],["w",0.5],["bg","city_creche_outside_daylight",0,0.0],["cbg",0,0.0,null,1.05,"OutSine",1.0,null,null,null],["cbg",0,-25.0,null,1.05,"Linear",0.0,null,null,null],["se","se_062"],["trn",1,0,false,false,0.5],["w",0.8],["se","se_077"],["ctl","avg3_181","a",null,null,null,null,null,null,"diantou","Linear",1.0],["ctl","avg1_139","d","027",null,null,null,null,null,"diantou","Linear",1.0],["say","avg3_181","Alright, we're here.==W== I'll take the gun and cause a scene in the next district. Get some rest.==W== See you tomorrow, Taffett.==W==",0,""],["w",1],["se","se_207"],["ctl","avg3_181","a","004",null,0.4,null,null,null,null,"OutCubic",1.0],["ctl","avg1_139","d","027",null,0.7,null,null,null,null,"OutCubic",1.0],["w",1.0],["goon"],["w",1.0],["se","se_062"],["ctl","avg3_181","a","010",null,0.35,-0.02,1.1,null,null,"OutQuint",1.0],["w",1.0],["goon"],["w",1],["se","se_072"],["ctl","avg3_181","a","014",null,0.25,null,1.15,0.0,"manbu_loop","OutQuint",1.0],["goon"],["w",0.5],["bgm",""],["stg",0,null,null,1.15,"OutCubic",1.0,null,null,null],["cbg",0,-50.0,null,null,"OutCubic",1.0,null,null,null],["ctl","avg1_139","d",null,"speechless",0.5,null,null,null,null,"OutCubic",1.0],["say","Taffett","See you tomorrow...==W==",0,""],["w",1],["ctl","avg1_139","d","024",null,null,null,null,null,"xuanyun","Linear",1.5],["w",1.5],["ctl","avg1_139","d",null,null,null,-0.5,null,0.0,null,"OutExpo",1.0],["hide","avg1_139",1.0],["se","se_406"],["stg",0,null,100.0,null,"OutCubic",1.0,null,null,null],["clear",0,0,1],["trn",0,0,false,false,1.0],["w",1.0],["goon"],["w",1.0],["bg","story_main_08_006",0,0.0],["stg",0,null,null,null,"Linear",0.0,null,null,"JingTouYaoHuang"],["cbg",0,-100.0,400.0,1.5,"Linear",0.0,null,null,null],["fx",0,"fx_avg_eye_ev",0,0],["se","se_186"],["trn",1,0,false,false,1.0],["w",2.0],["bgm","m52"],["cbg",0,-150.0,null,null,"OutCubic",2.0,null,null,null],["say","avg1_103","Mom...",9,"vo_STm08_19A_001"],["w",0.5],["bg","story_main_08_006",0,1.0],["cbg",0,350.0,-100.0,1.2,"OutCubic",0.0,null,null,null],["cbg",0,320.0,null,null,"OutCubic",2.0,null,null,null],["say","avg1_112","Wh-What do we do? You're bleeding... It won't stop!",9,"vo_STm08_19A_002"],["w",0.5],["say","Taffett","Cough... Hey, hush now. No tears... I'm okay. I had a clumsy fall at work, got a little scrape... Some medicine and sleep, and I'll be good as new...",9,"vo_STm08_19A_003"],["w",0.5],["bg","story_main_08_006",0,1.0],["cbg",0,-250.0,0.0,1.3,"OutQuint",0.0,null,null,null],["cbg",0,-280.0,null,null,"OutCubic",2.0,null,null,null],["say","avg1_111","Medicine... I-I'll get it!",9,"vo_STm08_19A_004"],["w",0.5],["stg",0,null,150.0,null,"OutCubic",1.0,null,null,null],["trn",0,0,false,false,1.0],["w",1.0],["stg",0,0.0,50.0,1.1,"Linear",0.0,null,null,null],["w",0.005],["bg","city_creche_outside_daylight",0,0.0],["bg","circle_light",0,0.0],["cbg",0,null,null,2.0,"Linear",0.0,null,null,null],["show","avg1_111","f","010",null,-0.1,1.2,0,null,0.98],["stg",0,null,0.0,null,"OutCubic",1.0,null,null,null],["trn",1,0,false,false,1.0],["w",1.0],["ctl","avg1_111","f",null,null,null,-0.05,null,null,null,"OutQuint",1.0],["se","se_074"],["w",1.0],["se","se_072"],["ctl","avg1_111","f",null,null,null,0.02,0.85,0.0,"manbu_loop","OutCubic",2.0],["say","0","Through blurred eyes, Taffett watched the small figure run off—the child entrusted to her by Her Majesty.",9,""],["w",0.5],["show","avg1_103","h","010",0.72,-0.1,1.2,0,null,0.0],["show","avg1_112","f","010",0.28,-0.1,1.2,0,null,0.0],["ctl","avg1_103","h",null,null,0.7,null,null,1.0,null,"OutCubic",1.0],["ctl","avg1_112","f",null,null,0.3,null,null,1.0,null,"OutCubic",1.0],["say","0","First one child. Then another. Then one more.==W== She thought she had merely taken in a few lost souls.==W== In truth, she was the one who had been taken in.",9,""],["w",0.7],["goon"],["w",0.7],["goon"],["w",0.5],["trn",0,0,true,true,1.0],["w",1.0],["say","Taffett","The one who was truly saved ... was me.",9,"vo_STm08_19A_005"],["w",0.5],["bg","story_main_08_006",0,0.0],["se","se_096"],["cbg",0,-250.0,100.0,1.2,"Linear",0.0,null,null,null],["cbg",0,null,null,1.3,"OutExpo",1.0,null,null,null],["trn",1,0,false,false,1.0],["w",1.0],["say","avg1_111","Mom! I got the medicine. Quick, take it!",9,"vo_STm08_19A_006"],["w",0.5],["say","Taffett","Thank you... But I told you… Not to call me \"Mom\"…",9,"vo_STm08_19A_007"],["w",0.5],["say","avg1_111","No! I'm not listening to you! Because…!",9,"vo_STm08_19A_008"],["w",0.5],["say","avg1_111","I'm sorry I said awful things last night...! But to me, mom is mom! Last night, we were just...",9,"vo_STm08_19A_009"],["w",0.5],["bg","story_main_08_006",0,1.0],["cbg",0,-100.0,400.0,1.5,"Linear",0.0,null,null,null],["cbg",0,-130.0,null,null,"OutCubic",2.0,null,null,null],["say","avg1_103","We wanted to be with you.",9,"vo_STm08_19A_010"],["w",0.5],["bg","story_main_08_006",0,1.0],["cbg",0,350.0,-100.0,1.2,"Linear",0.0,null,null,null],["cbg",0,320.0,null,null,"OutCubic",2.0,null,null,null],["say","avg1_112","Yes! Because yesterday was your birthday!",9,"vo_STm08_19A_011"],["w",0.5],["cbg",0,0.0,0.0,1.1,"OutCubic",2.0,null,null,null],["say","Taffett","My birthday...? Yesterday?",9,"vo_STm08_19A_012"],["w",0.5],["say","avg1_112","Yeah! Yesterday was your birthday!",9,"vo_STm08_19A_013"],["w",0.5],["say","Taffett","My ... birthday... All that time you spent preparing ... was for me?",9,"vo_STm08_19A_014"],["w",0.5],["say","Taffett","Ah... Haha... Thank you. I never would have imagined…",9,"vo_STm08_19A_015"],["w",0.5],["stg",0,null,100.0,null,"OutCubic",1.0,null,null,null],["bgm",""],["trn",0,0,false,false,1.0],["w",1.0],["bg","story_main_08_007_a",0,0.0],["stg",0,null,0.0,null,"OutCubic",2.0,null,null,"stop"],["fx",0,"fx_avg_sunlight_flip",0,0],["se","se_208"],["trn",1,0,false,false,2.0],["w",2.0],["say","Taffett","But ... can you really accept a mom like me? I ... might be a liar...",9,"vo_STm08_19A_016"],["w",0.5],["bgm","m7"],["say","avg1_112","You're not! You're our mom, our only mom!",9,"vo_STm08_19A_017"],["w",0.5],["bg","story_main_08_007_b",0,0.8],["w",0.4],["say","Taffett","... Hmm... Heh... So that's how you feel... But I... I'm sorry. I even told you not to call me Mom... Cough...",9,"vo_STm08_19A_018"],["w",0.5],["bg","story_main_08_007_a",0,0.8],["say","Taffett","I was ... so focused on finishing Her Majesty's mission for me... I never thought about what you needed... All you ever wanted ... was a real home…",9,"vo_STm08_19A_019"],["w",0.5],["bg","story_main_08_007_c",0,0.8],["say","Taffett","Th-then… Even though it might be late to say it... Until you find your real mom and dad... W-would you let me be your mom?",9,"vo_STm08_19A_020"],["w",0.5],["say","avg1_103","That's not right. Mom is mom. You are our real mom, the only one.",9,"vo_STm08_19A_021"],["w",0.5],["say","avg1_112","No matter what others say, you're our one and only mom!",9,"vo_STm08_19A_022"],["w",0.5],["say","avg1_111","So please don't take any more dangerous jobs. If we need money, we'll figure it out together!",9,"vo_STm08_19A_023"],["w",0.5],["bg","story_main_08_007_d",0,0.8],["say","Taffett","Alright... I promise... I won't take any more dangerous jobs that make you worried...",9,"vo_STm08_19A_024"],["w",0.5],["bg","story_main_08_007",0,0.8],["say","Taffett","We'll make this place bigger... Bring in all the homeless kids from Ash District... We'll build a real home and make them family…",9,"vo_STm08_19A_025"],["w",0.5],["say","avg1_111","But if there are more kids, won't that be too hard on you, Mom?",9,"vo_STm08_19A_026"],["w",0.5],["bg","story_main_08_007_d",0,0.8],["say","Taffett","Hehe... Maybe it will. But this is something ... I h-have to do.",9,"vo_STm08_19A_027"],["w",0.5],["say","Taffett","One day... You'll find your own dreams and have the courage to chase them...",9,"vo_STm08_19A_028"],["w",0.5],["bg","story_main_08_007_c",0,0.7],["say","Taffett","And when that day comes... If I can hold your hand and give you a little push when you need it... Then all this hard work will be worth it.",9,"vo_STm08_19A_029"],["w",0.5],["bg","story_main_08_007",0,0.7],["say","Taffett","Because I'm your mom... All of yours.",9,"vo_STm08_19A_030"],["w",0.5],["say","avg1_112","Yeah! So you gotta get better soon, Mom!",9,"vo_STm08_19A_031"],["w",0.5],["say","avg1_103","We'll protect you until you get better.",9,"vo_STm08_19A_032"],["w",0.5],["bg","story_main_08_007_c",0,0.8],["say","Taffett","Then I'm counting on you, my little bodyguards... Oh, but don't call me Mom in front of other people yet, okay?",9,"vo_STm08_19A_033"],["w",0.5],["say","avg1_111","Huh? Why not? You said you'll be our mom…",9,"vo_STm08_19A_034"],["w",0.5],["bg","story_main_08_007_d",0,0.8],["say","Taffett","There are things I can't tell you right now... But everything I do is to keep you safe. Therefore…",9,"vo_STm08_19A_035"],["w",0.5],["say","Taffett","Once I handle everything... You can call me Mom anywhere you want, even out in public.",9,"vo_STm08_19A_036"],["w",0.5],["bg","story_main_08_007_c",0,0.8],["say","Taffett","So for now... Let's just make it our little secret. Deal?",9,"vo_STm08_19A_037"],["w",0.5],["say","avg1_112","Okay! Then it's a deal!",9,"vo_STm08_19A_038"],["w",0.5],["say","avg1_103","No lying.",9,"vo_STm08_19A_039"],["w",0.5],["say","avg1_111","Right! Let's pinky swear!",9,"vo_STm08_19A_040"],["w",0.5],["bg","story_main_08_007_d",0,0.7],["se","se_100"],["fx",0,"fx_avg_sunlight_flip",0,0],["stg",0,null,null,null,"Linear",1.0,null,null,"niunie1"],["say","Everyone","Pinky swear, a promise that never breaks!",9,"vo_STm08_19A_041"],["w",0.5],["trn",0,0,false,false,1.0],["w",1.0],["say","0","Taffett holds the children's hands and closes her eyes.",9,""],["w",0.5],["stg",0,null,100.0,1.1,"Linear",0.0,null,null,null],["bg","sky_sunny",0,0.0],["fx",0,"fx_avg_sunlight_flip",0,0],["stg",0,null,0.0,null,"InOutCubic",2.0,null,null,null],["trn",1,0,true,true,1.5],["w",1.5],["say","0","Sunlight breaks over the edge of the city. The dawn of a new family is here.",9,""],["w",1.5],["bgm",""],["trn",0,0,false,false,1.0],["w",1.5],["say","0","One year later",8,""],["w",0.5],["say","0","Monolith Calendar Year 988",8,""],["w",0.5],["bg","city_creche_inside_daylight",0,0.0],["cbg",0,null,null,1.1,"Linear",0.0,null,null,null],["stg",0,null,null,1.2,"Linear",0.0,null,null,null],["stg",0,null,null,1.1,"OutCubic",3.5,null,null,null],["bgm","m32"],["trn",1,0,false,false,1.0],["w",1.0],["head","10:30, Sonus Month 21st, Ash District in Emor, Ash Orphanage"],["w",0.5]