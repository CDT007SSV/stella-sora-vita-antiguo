"OutQuint",1.0],["say","avg1_112","Hey, don't say it out loud! It doesn't matter how many you have. If you speak them, they won't come true!",0,""],["w",0.5],["ctl","avg1_112","f","005",null,null,null,null,null,null,"Linear",1.0],["ctl","avg1_139","b","002","happy",null,null,null,null,null,"Linear",0.5],["say","Taffett","Oh, is that how it works? Hehe.==W== Well, saying them out loud means we can all pitch in. I'd rather trust ourselves than the gods.",0,""],["w",0.7],["ctl","avg1_139","b","003",null,null,null,null,null,"diantou","Linear",1.0],["se","se_077"],["goon"],["w",0.5],["ctl","avg1_111","f","013","speechless",null,null,null,null,"lengzhan2","Linear",0.5],["say","avg1_111","Then what's the point of wishing?==W== Anyway, the candles are out.==W== Time for cake!",0,""],["w",1],["ctl","avg1_111","f","003","sigh",null,null,null,null,"JuGong","Linear",1.0],["goon"],["w",0.7],["ctl","avg1_111","f",null,null,0.2,null,null,0.0,null,"OutQuint",1.0],["hide","avg1_111",1.0],["ctl","avg1_103","h",null,null,0.3,null,null,0.0,null,"OutQuint",1.0],["hide","avg1_103",1.0],["ctl","avg1_112","f",null,null,0.1,null,null,0.0,null,"OutQuint",1.0],["hide","avg1_112",1.0],["ctl","avg1_139","b",null,null,0.85,null,null,0.0,null,"OutQuint",1.0],["stg",0,null,null,1.1,"OutCubic",1.0,null,null,null],["w",0.5],["obj","qstory_side_119_009",1,null,null],["goon"],["w",0.5],["chd",0,0,"avg1_103","h","007","happy"],["ctl","avg1_103","h","007",null,null,null,null,null,null,"Linear",0.5],["se","se_128"],["say","avg1_103","I'll cut it.",0,""],["w",0.5],["chd",0,2,"avg1_112","f","014","resentful"],["ctl","avg1_112","f",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_112","Whoa, no fair!==W== I wanted to cut it! I call dibs on the second slice!",0,""],["w",0.7],["se","se_128"],["ctl","avg1_112","f",null,null,null,null,null,null,"Tiao","Linear",1.0],["goon"],["w",0.5],["objx"],["chd",1,0,"avg1_103","a","002",null],["chd",1,2,"avg1_112","a","002",null],["stg",0,0.0,0.0,1.05,"OutCubic