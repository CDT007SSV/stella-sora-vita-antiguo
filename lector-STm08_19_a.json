["ctl","avg1_139","d","024",null,null,-0.2,null,null,null,"OutQuint",1.0],["se","se_208"],["say","avg3_181","Taffett, stay awake. Can you hear me? Say something!",0,""],["w",0.5],["ctl","avg3_181","a",null,null,0.4,null,null,null,"stop","OutQuint",1.0],["ctl","avg1_139","d",null,null,0.56,null,null,null,null,"OutQuint",1.0],["se","se_251"],["say","avg3_181","We're almost at the clinic. It's a scratch, they can patch you up.==W== Don't you dare close your eyes!",0,""],["w",0.5],["goon"],["w",0.5],["ctl","avg3_181","a","006",null,0.25,null,null,null,null,"OutQuint",1.0],["ctl","avg1_139","d",null,null,0.65,null,null,null,null,"OutQuint",1.0],["se","se_019"],["say","Taffett","No... No doctors. Take me home.",0,""],["w",0.5],["ctl","avg3_181","a","012","angry",0.35,null,null,null,"diantou","OutQuint",1.0],["se","se_062"],["say","avg3_181","Are you insane?! You're going to die!",0,""],["w",0.5],["se","se_552"],["ctl","avg1_139","d",null,null,null,null,null,null,"niunie","Linear",0.5],["say","Taffett","There's medicine in the basement, from Her Majesty. Works better than any clinic...==W== I can handle it.",0,""],["w",0.7],["goon"],["w",0.5],["ctl","avg3_181","a","006","sigh",null,null,null,null,"JuGong","Linear",0.5],["say","avg3_181","... Are you refusing a doctor because you're afraid they'll find out you're a White Cat?",0,""],["w",0.5],["ctl","avg3_181","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg3_181","This is no time to worry about that!",0,""],["w",0.5],["ctl","avg1_139","d","013","vexation",null,null,null,null,null,"Linear",0.5],["say","Taffett","No... It's not ... about the White Cats...",0,""],["w",0.5],["ctl","avg3_181","a","004","question",null,null,null,null,null,"OutCubic",1.0],["say","avg3_181","Then why?",0,""],["w",0.5],["ctl","avg3_181","a",null,null,null,null,null,0.0,null,"OutQuint",1.0],["hide","avg3_181",1.0],["ctl","avg1_139","d",null,null,null,null,null,0.0,null,"OutQuint",1.0],["hide","avg1_139",1.0],["se","se_169"],["trn",0,