],["trn",0,0,true,true,0.8],["w",0.4],["se","se_222"],["w",0.41],["fx",0,"fx_avg_reminiscence_loop",1,0],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["bg","mine_inside",0,0.0],["trn",1,0,false,false,1.0],["w",0.4],["obj","qstory_main_06_025",1,null,0.54],["mrt",1,"y","020","think",null],["say","avg3_100","We found the compass in the Ash Orphanage's basement, and the previous Empress was the one who got the orphanage settled in that building.",2,""],["w",0.4],["mrt",0,"y","012",null,null],["say","avg3_100","Narida's letter mentioned the compass too. So, this White Cat secret room in the mine ... might be set up by the Empress too.",2,""],["w",0.4],["mrt",0,"y","009","question",null],["say","avg3_100","Did that compass summon the Monolith back?",2,""],["w",0.2],["objx"],["w",0.2],["mrt",0,"y","002",null,null],["say","avg3_100","If that's true, it all connects... But what did the previous Empress have in mind for the White Cats and the orphanage?",2,""],["w",0.25],["bg","story_main_08_009",0,0.7],["w",0.2],["mrt",0,"y","020","think",null],["say","avg3_100","And then there's that book...",2,""],["mrt",3,"y",null,null,null],["w",0.51],["fx",0,"fx_avg_reminiscence_loop",0,0],["stg",0,null,null,null,"Linear",0.0,null,null,"JingTouYaoHuang"],["film",0],["se","se_021"],["bg","story_main_08_010_FP",0,1.0],["w",2.0],["se","se_021"],["bg","story_main_08_010_a_FP",0,0.9],["w",2.0],["film",1],["se","se_483"],["bg","white",0,0.9],["say","0","==Off==My Tyrant.",8,""],["w",0.6],["clear",0,0,1],["w",0.4],["se","se_169"],["trn",0,1,false,false,0.85],["w",0.85],["fx",0,"fx_avg_reminiscence_loop",1,0],["bg","mine_inside",0,0.0],["cbg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,"stop"],["w",0.4],["trn",1,1,false,false,0.9],["w",0.5],["mrt",2,"y","025","shock",null],["say","avg3_100","If everything was part of the previous empress's plan... Am I really the Tyrant?",2,""],["mrt",3,"y",null,null,null],["w",0.51],["show","avg1_112","a","014",null,null,1.0,0,null,0.0],["ctl","avg1_112","a",null,null,null,-0.1,1.15,1.0,null,"OutCubic",0.75],["w",0.25],["ctl","avg1_112","a",null,"speechless",null,null,null,null,null,"OutSine",0.35],["w",0.45],["say","avg1_112","==PLAYER_NAME==...",0,""],["ctl","avg1_112","a",null,null,null,null,null,null,null,"OutSine",0.35],["w",0.4],["mrt",1,"y","016","vexation","lengzhan"],["say","avg3_100","How could this happen? Is Angie actually right? Am I truly the Tyrant destined to end the world?",2,""],["w",0.4],["bgm",""],["mrt",0,"y","025","exclamation","jushou"],["say","avg3_100","Did I only think otherwise because I lost my memories?",2,""],["mrt",3,"y",null,null,null],["w",0.51],["se","se_070"],["stg",0,null,null,null,"Linear",0.0,null,null,"Zhong"],["ctl","avg1_112","a","009",null,null,-0.28,1.4,null,null,"OutCubic",0.7],["tsk","Zhong"],["say","avg1_112","==PLAYER_NAME==!",0,""],["w",0.4],["tsk","Xiao"],["mrt",2,"z","007","symbol","shilaimu1"],["say","avg3_100","Huh? Oh, Noya. You scared me. Wait, where did everyone go?",1,""],["mrt",3,"z",null,null,null],["w",0.51],["ctl","avg1_112","a","008","sweaty",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["bgm","m27"],["say","avg1_112","==PLAYER_NAME==, you were so spaced out we almost left you behind.==W== Just now, Chaton found a mineshaft that's still usable. So I told Iris, Amber, and Mom to go ahead with the White Cats while I stayed behind to wait.",0,""],["w",0.8],["ctl","avg1_112","a","017",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["goon"],["w",0.4],["mrt",1,"z","010","sigh",null],["say","avg3_100","S-Sorry.",1,""],["mrt",3,"z",null,null,null],["w",0.4],["ctl","avg1_112","a","006","attention",null,null,null,null,"daintou","OutSine",0.35],["w",0.35],["say","avg1_112","Ever since you came out of that hidden room, you've been trailing behind the group, lost in thought. Whatever's got you thinking this hard must be something serious.",0,""],["w",0.4],["ctl","avg1_112","a","004","music",null,null,null,null,null,"Linear",0.5],["say","avg1_112","You know, you can walk and think at the same time. Here, hold my hand so you don't get left behind.",0,""],["w",0.4],["trn",0,0,true,true,0.8],["w",0.8],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["bg","mine_inside",0,0.0],["cbg",0,-90.0,0.0,1.05,"Linear",0.0,null,null,null],["show","avg3_100","c","024",null,-0.1,1.15,0,null,null],["trn",1,0,false,false,0.8],["ctl","avg3_100","c",null,"speechless",null,null,null,null,null,"OutSine",0.35],["w",1.95],["se","se_077"],["ctl","avg3_100","c","023",null,null,null,null,null,"diantou","OutSine",0.35],["w",1.05],["ctl","avg3_100","a","022","love",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","1","Thanks, Noya. But I've figured it out now, so I'm fine. Let's go.",0,""],["w",0.4],["cbg",0,90.0,null,null,"OutCubic",0.7,null,null,null],["ctl","avg3_100","a",null,null,0.35,null,null,null,null,"OutCubic",0.7],["show","avg1_112","a","006",0.75,-0.1,1.14,0,null,0.0],["ctl","avg1_112","a",null,"question",0.65,null,null,1.0,null,"OutCubic",0.7],["w",0.4],["say","avg1_112","Are you really alright?",0,""],["w",0.4],["se","se_061"],["ctl","avg3_100","a",null,null,null,-0.32,null,0.0,null,"InBack",0.7],["hide","avg3_100",0.7],["w",0.71],["mrt",2,"z","014",null,null],["say","avg3_100","Yeah. I was just brainstorming how to escape. But since we have a clear tunnel, we should be fine.",1,""],["mrt",3,"z",null,null,null],["w",0.51],["ctl","avg1_112","a","022","exclamation",0.49,-0.21,1.3,null,null,"OutCubic",0.7],["w",0.4],["say","avg1_112","Liar. That's not what you were really thinking about at all.",0,""],["w",0.4],["mrt",2,"z","007","symbol",null],["say","avg3_100","What?",1,""],["mrt",3,"z",null,null,null],["w",0.51],["ctl","avg1_112","a","026","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_112","You didn't know this, did you, ==PLAYER_NAME==? Whenever you lie, you subconsciously look away. Honestly, you were thinking about something else, weren't you?",0,""],["ctl","avg1_112","a",null,null,null,null,null,null,null,"OutSine",0.3],["w",0.4],["mrt",1,"z","025","question",null],["say","avg3_100","I-I do? I... I...",1,""],["w",0.4],["mrt",0,"z","010","sigh","lengzhan"],["say","avg3_100","Yeah, you're right. I shouldn't keep things from you. I was actually thinking about that sketch and my identity.",1,""],["w",0.4],["ctl","avg1_112","a",null,null,0.3,null,null,null,null,"OutCubic",0.7],["bg","story_main_08_009",0,0.7],["w",0.3],["mrt",0,"y","020","speechless",null],["say","avg3_100","The book with the drawing was under Narida's letter. After she vanished, no one could open the White Cat secret room.",1,""],["mrt",3,"z",null,null,null],["w",0.51],["se","se_021"],["ctl","avg1_112","a",null,null,0.18,null,null,0.0,null,"OutCubic",0.7],["hide","avg1_112",0.7],["stg",0,null,null,1.15,"OutCubic",0.7,null,null,null],["film",0],["w",0.2],["bg","story_main_08_010_a_FP",0,0.9],["w",0.6],["mrt",1,"y","012",null,null],["say","avg3_100","Which means that sketch was placed there six years ago at the absolute latest... Long before you found me in the desert.",1,""],["w",0.4],["mrt",0,"y","024","speechless",null],["say","avg3_100","A six-year-old sketch ... and the text in that book... I hate to admit it, but based on all this, the person I was before I lost my memory …",1,""],["mrt",3,"z",null,null,null],["w",0.2],["fx",0,"fx_avg_warning",0,1],["w",0.3],["film",1],["stg",0,null,null,1.05,"OutCubic",0.7,null,null,null],["bg","white",0,0.6],["w",0.2],["se","se_226"],["say","0","==Off==Has to be the Tyrant! At least, that's what other people call me.",8,""],["w",0.7],["clear",0,0,1],["w",0.4],["fx",0,"fx_avg_warning",1,1],["bg","mine_inside",0,0.7],["w",0.2],["show","avg1_112","a","024",0.49,-0.14,1.2,0,null,0.0],["ctl","avg1_112","a",null,null,null,null,null,1.0,null,"OutCubic",0.7],["w",0.35],["mrt",2,"y","026","exclamation",null],["say","avg3_100","Nobody would orchestrate a massive lie years in advance just to trick me, especially when they couldn't guarantee I'd ever come here!",1,""],["mrt",3,"z",null,null,null],["w",0.51],["ctl","avg1_112","a","002","idea",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","avg1_112","Well, if you think so, then maybe you really are the Tyrant.",0,""],["w",0.4],["mrt",1,"z","010","sigh","lengzhan"],["say","avg3_100","See? Even you think I'm—",1,""],["mrt",3,"z",null,null,null],["w",0.51],["ctl","avg1_112","a","006","attention",null,null,null,null,"daintou","OutSine",0.35],["w",0.35],["say","avg1_112","But what difference will it make?",0,""],["w",0.4],["se","se_169"],["trn",0,1,true,true,0.9],["w",0.9],["fx",0,"fx_avg_reminiscence_loop",0,0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["film",0],["bg","carriage_inside_night",0,0.0],["show","avg3_100","i","020",null,-0.32,2.0,0,null,null],["trn",1,1,false,false,0.9],["w",0.5],["say","avg1_112","We sleep in the same RV every night. You're the first person we see when we wake up.",3,""],["w",0.4],["film",1],["ctl","avg3_100","i",null,null,null,-0.45,2.28,0.0,null,"OutCubic",0.8],["stg",0,null,null,1.13,"OutCubic",0.95,null,null,null],["show","avg1_103","g","014",0.23,null,null,0,null,0.0],["show","avg1_112","e","002",0.78,null,null,0,null,0.0],["show","avg1_111","d","011",0.5,null,null,0,null,0.0],["ctl","avg1_103","g",null,null,0.33,-0.07,1.1,1.0,null,"OutCubic",0.7],["ctl","avg1_111","d",null,null,null,-0.07,1.1,1.0,null,"OutCubic",0.7],["ctl","avg1_112","e",null,null,0.68,-0.07,1.1,1.0,null,"OutCubic",0.7],["w",0.4],["say","avg1_112","Nobody knows what kind of person you are better than the New Star Guild.",0,""],["w",0.4],["trn",0,1,true,true,0.9],["w",0.9],["fx",0,"fx_avg_reminiscence_loop",1,0],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["bg","mine_inside",0,0.0],["show","avg1_112","a","004",0.49,-0.15,1.2,0,null,null],["trn",1,1,false,false,0.9],["w",0.3],["ctl","avg1_112","a",null,"love",null,null,null,null,null,"OutSine",0.3],["w",0.3],["say","avg1_112","Anyway, the day you joined us, my intuition told me we were stuck together for good. Iris and Amber definitely feel the same way.",0,""],["w",0.4],["ctl","avg1_112","a","002",null,null,-0.25,1.34,null,null,"OutCubic",0.7],["w",0.4],["say","avg1_112","Right...?",0,""],["w",0.4],["se","se_483"],["trn",0,1,false,false,0.0],["say","0","My savior.",8,""],["ctl","avg1_112","a","004",null,null,null,null,null,null,"Linear",0.0],["w",0.6],["clear",0,0,1],["w",0.4],["trn",1,1,false,false,0.9],["w",0.4],["mrt",2,"z","007","flurry",null],["say","avg3_100","Hah... What are you talking about, Noya? What savior...",1,""],["mrt",3,"z",null,null,null],["w",0.51],["ctl","avg1_112","a","007","idea",null,null,null,null,"jushou","OutSine",0.35],["w",0.35],["say","avg1_112","That word was in the book too. If you're going to obsess over the \"Tyrant\" part, you're not going to ignore the mention of \"Savior\"!",0,""],["w",0.4],["mrt",1,"y","021","speechless","lengzhan"],["say","avg3_100","What kind of logic is that...?",1,""],["mrt",3,"z",null,null,null],["w",0.51],["ctl","avg1_112","a","004","happy",null,null,null,null,"daintou","OutSine",0.35],["w",0.35],["say","avg1_112","Since the book lists the Tyrant and the Savior side by side, that means you might not just be the Tyrant. You could be the Savior too. All we have to do is defeat Angie and make her admit you're the latter.",0,""],["w",0.4],["ctl","avg1_112","a","002","music",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_112","So stop stressing over it, ==PLAYER_NAME==. Whether you're a Tyrant or a \"savior,\" you will always be my ==PLAYER_NAME==.",0,""],["w",0.4],["mrt",1,"y","022",null,null],["say","avg3_100","Noya... Heh, you really are an optimist.",1,""],["w",0.4],["mrt",0,"z","023","sigh",null],["say","avg3_100","Don't worry. After our late-night talk, I promised I wouldn't fall back into that rut. I was shocked by the sudden \"truth,\" that's all.",1,""],["w",0.4],["mrt",0,"y","024","speechless",null],["say","avg3_100","Right now, I'm not stressing over my true identity. I'm figuring out how to protect everyone while fighting off Angie's forces.",1,""],["w",0.4],["mrt",0,"z","002","exclamation","jushou"],["say","avg3_100","And no matter how many people she brings, I have zero intention of going down easy.",1,""],["mrt",3,"z",null,null,null],["w",0.4],["ctl","avg1_112","a","004","happy",null,null,null,null,"daintou","OutSine",0.35],["w",0.35],["say","avg1_112","Heh heh, there's the ==PLAYER_NAME== I know.",0,""],["w",0.4],["ctl","avg1_112","a","002",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["mrt",1,"y","020",null,null],["say","avg3_100","Oh, right, Noya. You mentioned that I subconsciously look away when I lie.",1,""],["mrt",0,"z","002","question",null],["say","avg3_100","Is it obvious? It'd be disastrous if this comes out during the negotiations and the other side catches on.",1,""],["mrt",3,"z",null,null,null],["w",0.51],["ctl","avg1_112","a","026",null,null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_112","Ah, that? Haha...==W== I actually made that up. You don't do that at all.",0,""],["w",0.6],["ctl","avg1_112","a","027","shy",null,null,null,null,"lengzhan","OutSine",0.3],["w",0.3],["goon"],["w",0.4],["mrt",2,"z","007","resentful",null],["say","avg3_100","Y-You bluffed me?!",1,""],["mrt",3,"z",null,null,null],["w",0.51],["ctl","avg1_112","a","007","shock",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_112","After our late-night talk last time, the three of us talked things over in private. Amber said you can be pretty guarded sometimes, and that you needed someone to give you a little push to get past that. So we came up with this idea.",0,""],["ctl","avg1_112","a",null,null,null,null,null,null,null,"OutSine",0.35],["w",0.4],["ctl","avg1_112","a","019","flower",null,null,null,null,"tiao2","OutSine",0.35],["w",0.35],["say","avg1_112","Bet you didn't see that coming! I can lie too. Iris was right. The most innocent-looking people make the most ruthless liars. Haha.",0,""],["w",0.4],["mrt",1,"z","025","speechless",null],["say","avg3_100","So I fell for it completely...==W== It will never happen again!",1,""],["w",0.8],["mrt",0,"z","007","resentful","tiao2"],["goon"],["mrt",3,"z",null,null,null],["w",0.51],["ctl","avg1_112","a","020","shy",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg1_112","And I will never lie to you again. That means I'll forever be one point ahead of you, ==PLAYER_NAME==.",0,""],["w",0.4],["bgm",""],["mrt",1,"z","022","attention",null],["say","avg3_100","There's no point in trying to outdo each other here. Come on, let's catch up with the others.",1,""],["mrt",3,"z",null,null,null],["w",0.51],["stg",0,-90.0,null,null,"OutCubic",0.7,null,null,null],["trn",0,0,true,true,0.71],["w",0.71],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["bg","BG_Black",0,0.0],["trn",1,0,false,false,0.7],["se","se_569"],["fx",0,"fx_avg_smoke",0,0],["w",3.1],["trn",0,0,false,false,0.9],["w",0.9],["bg","mine_inside",0,0.0],["fx",0,"fx_fog_lp",0,1],["show","avg1_112","a","014",null,-0.07,1.1,0,null,0.0],["trn",1,0,false,false,0.8],["ctl","avg1_112","a",null,"exclamation",null,-0.17,1.25,1.0,null,"OutCubic",0.6],["bgm","m107"],["say","avg1_112","Hold on, ==PLAYER_NAME==. We've got company!",0,""],["w",0.4],["ctl","avg1_112","a",null,"speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_112","Is that green smoke up ahead?==W== No, that's powerful wind magic! They're using it to scout for us!",0,""],["w",0.8],["tsk","Xiao"],["se","se_067"],["stg",0,null,null,1.1,"OutCubic",0.7,null,null,"Xiao"],["ctl","avg1_112","a","009",null,null,null,null,null,null,"Linear",0.3],["goon"],["w",0.4],["mrt",2,"z","025","symbol",null],["say","avg3_100","Are Angie's people already in the mine?",1,""],["mrt",3,"z",null,null,null],["w",0.51],["se","se_077"],["ctl","avg1_112","a","021",null,null,null,null,null,"diantou","OutSine",0.35],["w",0.35],["say","avg1_11