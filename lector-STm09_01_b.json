unie1"],["se","se_077"],["say","avg3_100","I can't protect everyone while we're on the run.",1,""],["mrt",3,"y",null,null,null],["w",0.5],["say","avg4_999","True, but you can always try again, can't you? There has to be a timeline where everyone makes it out unharmed.",0,""],["w",0.4],["fx",0,"fx_avg_noise",0,2],["w",0.1],["fx",0,"fx_avg_speaking",1,2],["se","se_231"],["bg","story_main_be_09_001",0,0.0],["w",1.0],["fx",0,"fx_avg_noise",1,2],["se","se_231_stop"],["w",0.1],["bg","story_main_01_037",0,0.0],["fx",0,"fx_avg_speaking",0,2],["w",0.5],["mrt",1,"y","005",null,null],["se","se_226"],["say","avg3_100","And watch my closest friends die right in front of me ... over and over again?",1,""],["mrt",0,"y","010","sigh","diantou"],["say","avg3_100","Heh. That's literal torture. I'm not strong enough for that.",1,""],["mrt",0,"y","019",null,"lengzhan"],["se","se_251"],["say","avg3_100","Besides. Even if the Angie in this timeline hasn't done anything yet, I still want her to pay. Pay for what she did to Noya!",1,""],["mrt",3,"y",null,null,null],["w",0.5],["say","avg4_999","I understand. You truly are a great Tyrant who deeply values your people.",0,""],["say","avg4_999","I will leave you to it, then. I wish you a resounding victory.",0,""],["w",0.5],["fx",0,"fx_avg_speaking",1,2],["se","se_342"],["cbg",0,null,-200.0,null,"OutQuint",1.0,null,null,null],["cbg",0,null,0.0,0.98,"OutQuint",1.0,null,null,null],["w",0.5],["show","avg1_139","a","010",0.7,-0.15,1.2,0,null,0.0],["ctl","avg1_139","a",null,"question",0.6,null,null,1.0,null,"OutQuint",1.0],["se","se_208"],["say","avg1_139","Boss, who are you talking to?",0,""],["w",0.5],["mrt",1,"z","011","flurry","niunie"],["say","avg3_100","Ah, nothing. Just ... thinking out loud to my phone.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_139","a","013",null,0.5,-0.1,1.1,null,"JuGong","OutQuint",1.0],["cbg",0,null,null,1.0,"OutQuint",1.0,null,null,null],["se","se_062"],["say","avg1_139","Are we really just going to wai