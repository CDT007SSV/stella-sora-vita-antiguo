n't afford the Soul Stone recharge fees, so we save it for absolute emergencies.",0,""],["w",0.5],["stg",0,200.0,null,1.3,"OutCubic",0.5,null,null,null],["cbg",0,100.0,null,null,"OutCubic",0.5,null,null,null],["ctl","avg1_111","a",null,null,null,null,null,0.0,null,"OutCubic",0.5],["ctl","avg1_114","a",null,null,null,null,null,0.0,null,"OutCubic",0.5],["ctl","avg1_108","a",null,null,null,null,null,0.0,null,"OutCubic",0.5],["w",0.5],["show","avg1_133","a","016",0.45,0.05,0.9,0,null,0.0],["ctl","avg1_133","a","028","speechless",null,null,null,1.0,null,"Linear",0.5],["w",0.5],["say","avg1_133","The last time we used it...==W== It was to fight against Darcia. A handful of us held off hundreds of Intelligent Plants, all thanks to the Grace.",0,""],["w",0.5],["se","se_029"],["show","avg2_985","a","002",0.25,-0.35,1.5,0,null,0.0],["ctl","avg2_985","b",null,null,null,-0.35,1.5,1.0,null,"Linear",0.5],["ctl","avg1_133","a","012",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg1_133","a",null,null,null,null,null,0.0,null,"Linear",0.0],["ctl","avg2_985","b",null,null,null,null,null,0.0,null,"Linear",0.0],["stg",0,0.0,null,1.1,"OutCubic",1.0,null,null,null],["ctl","avg1_114","a","006","happy",0.5,null,null,1.0,null,"OutCubic",0.5],["w",0.5],["say","avg1_114","Hehehe... I understand perfectly.==W== We make a soul pact with you, bring the blessings outside, and become Supercats!",0,""],["w",0.5],["ctl","avg1_114","a","027","exclamation",null,-0.35,1.5,null,null,"OutCubic",0.5],["goon"],["se","se_084"],["ctl","avg1_114","a","006",null,null,null,null,null,"niunie1","Linear",0.5],["say","avg1_114","Then I can take on ten goons at once!==W== No, wait...==W== With twenty times the dark power, I could easily crush a hundred!",0,""],["w",0.5],["se","se_147"],["ctl","avg1_114","a","005",null,null,null,null,null,"chijing","Linear",0.5],["goon"],["w",0.5],["fx",0,"fx_avg_flash_light",0,0],["ctl","avg1_114","b","008",null,0.45,null,null,null,null,"OutCubic",0.2],["go