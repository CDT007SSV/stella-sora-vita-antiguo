ll,null,null,"Linear",0.5],["say","avg1_114","Twenty?!==W== If my dark power surges by twenty times, I could rule this desert right now!",0,""],["w",0.5],["stage",5,0,8],["fx",5,"fx_avg_flash_light",0,0],["ctl","avg1_114","a","017",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg1_111","a",null,null,null,null,null,0.0,null,"Linear",0.0],["hide","avg1_111",0],["bg","mine_inside_2",5,0.5],["show","avg1_108","a","011",0.25,0.1,null,5,null,0.0],["ctl","avg1_114","a",null,null,0.7,null,null,null,null,"OutCubic",0.5],["ctl","avg1_108","a","011","sigh",0.35,0.0,null,1.0,null,"OutCubic",0.5],["w",0.5],["say","avg1_108","Snap out of it, Chaton. You can't bring blessings outside. It doesn't matter how strong you get in there, you revert right back the second you leave.",0,""],["w",0.5],["bg","mine_inside_2",0,0.0],["ctl","avg1_114","a","012","vexation",null,null,null,null,null,"Linear",0.5],["w",1.0],["stg",5,null,null,1.3,"OutCubic",1.0,null,null,null],["ctl","avg1_114","a",null,null,0.9,-0.2,1.6,1.0,null,"OutCubic",0.5],["ctl","avg1_108","a",null,null,0.15,-0.35,1.6,1.0,null,"OutCubic",0.5],["show","avg1_111","a","027",0.5,null,null,5,null,0.0],["ctl","avg1_111","a","027","attention",null,null,null,1.0,"chijing","Linear",0.5],["w",0.5],["say","avg1_111","Ah, about that...",0,""],["w",0.5],["mrt",1,"z","002","happy",null],["say","avg3_100","It's okay, Iris. The White Cats are fighting alongside us. There's no reason to hide this.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_029"],["ctl","avg1_111","a","010",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_111","Okay.",0,""],["w",0.5],["stg",5,null,null,1.1,"OutCubic",1.0,null,null,null],["ctl","avg1_108","a","013",null,null,-0.3,1.4,null,null,"OutCubic",0.5],["ctl","avg1_114","a","019",null,null,-0.3,1.4,null,null,"OutCubic",0.5],["ctl","avg1_111","a","023","speechless",null,-0.3,1.4,null,null,"OutCubic",0.5],["w",0.5],["say","avg1_111","Normally, you can't bring blessings ou