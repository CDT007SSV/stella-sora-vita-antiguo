0,null,null,"OutCubic",0.35],["ctl","avg2_947","a","004",null,null,null,null,1.0,null,"Linear",0.5],["ctl","avg2_948","a","004",null,null,null,null,1.0,null,"Linear",0.5],["say","avg3_217","Second Company, listen up!==W== Maintain marching formation! About-face! Our new target is the desert Monolith. Full speed ahead!",0,""],["w",0.5],["ctl","avg3_217","a","016",null,null,null,null,null,null,"Linear",0.5],["fx",0,"fx_speedline_center",0,2],["goon"],["w",0.5],["se","se_159"],["bgm",""],["ctl","avg2_947","a","007",null,null,null,null,null,"jushou2","OutCubic",0.5],["ctl","avg2_948","a","007",null,null,null,null,1.0,"jushou2","OutCubic",0.5],["say","Committee Elite","Yes, Ma'am!",0,""],["w",0.5],["trn",0,0,true,false,1.0],["w",1.0],["bg","tower_common",0,0.5],["w",0.5],["trn",1,0,false,false,1.0],["w",1.0],["head","14:50, Nebula Month 18th, Desert Monolith, Ground Floor"],["bgm",""],["w",0.5],["show","avg3_216","a","007",0.5,0.05,null,0,null,0.0],["ctl","avg3_216","a","007","sigh",null,0.0,null,1.0,"chijing","OutCubic",0.5],["say","avg3_216","Phew, we made it. My Third Company had to force-march all the way here from our dune positions. Half my squad is straggling.==W== Greyhorn, what's your status?",0,""],["w",1.0],["ctl","avg3_216","a","005","question",0.25,null,null,null,null,"OutCubic",0.5],["show","avg1_163","a","005",null,null,null,2,null,1.0],["bg","mine_inside_2",2,0.0],["stage",2,0,0],["goon"],["w",0.5],["ctl","avg1_163","a","003","vexation",null,null,null,null,null,"Linear",0.5],["say","avg1_163","Two Trekkers misled us, and we were trapped in a mineshaft for ages. No casualties, but morale hit rock bottom.==W== Luckily, Laru from logistics brought us fries and ice cream. That perked everyone up a bit.",0,""],["w",0.5],["obj","qstory_main_09_002",1,0.65,null],["ctl","avg1_163","a","007",null,0.6,null,null,null,null,"OutCubic",0.5],["goon"],["w",0.5],["objx"],["w",0.5],["ctl","avg1_163","a",null,null,0.5,null,null,null,null,"OutCubic",0.5],["ctl","avg3_216","a","004","sigh",null,null,null,null,null,"Linear",0.5],["say","avg3_216","Ugh, I really don't get what Lady Angie is thinking. Giving up a perfectly fortified camp just to surround this Monolith, all because of one message from the Tyrant.",0,""],["w",0.5],["ctl","avg3_216","a","013",null,null,null,null,null,null,"Linear",0.5],["say","avg3_216","Sure, this Monolith only has one exit, so it is a prime opportunity to corner the Tyrant.==W== But pulling the entire Salvation Committee here, with Lady Angie personally leading the charge up the Monolith? Isn't that a bit...",0,""],["w",0.5],["ctl","avg3_216","a","008","vexation",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg1_163","a","003","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_163","\"One who force-marches a hundred miles for an advantage will suffer\"...",0,""],["w",0.5],["ctl","avg3_216","a","005","question",null,null,null,null,null,"Linear",0.5],["say","avg3_216","Huh? What did you say?",0,""],["w",0.5],["ctl","avg1_163","a","004","attention",null,null,null,null,null,"Linear",0.5],["say","avg1_163","I said, Lady Angie has great foresight.",0,""],["ctl","avg1_163","a","011",null,null,null,null,null,"diantou2","Linear",0.5],["say","avg1_163","We aren't strangers to climbing Monoliths, but we definitely aren't experts. Massing our forces to crush them with sheer numbers isn't a bad call.",0,""],["bgm",""],["ctl","avg1_163","a","003","speechless",null,null,null,null,null,"Linear",0.5],["w",0.5],["say","avg1_163","It's just...==W== I can't shake the feeling that the Tyrant's strategy goes far deeper than simply leveraging the blessings and knowing the terrain.",0,""],["w",1.0],["ctl","avg3_216","a","004",null,null,null,null,null,null,"Linear",0.5],["se","se_226"],["ctl","avg1_163","a","005",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["trn",0,0,true,false,1.0],["w",1.0],["stage",2,1,3],["bg","tower_common",0,0.5],["w",0.5],["stg",0,null,null,1.2,"Linear",0