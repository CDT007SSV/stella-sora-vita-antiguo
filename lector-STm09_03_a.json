0,null,"OutQuint",0.7],["hide","avg1_139",0.7],["ctl","avg3_1311","c",null,null,null,null,null,0.0,null,"OutQuint",0.7],["hide","avg3_1311",0.7],["show","avg1_112","g","014",0.4,-0.2,1.4,0,null,0.0],["ctl","avg1_112","g",null,"flurry",0.5,0.0,1.0,1.0,null,"OutQuint",1.0],["say","avg1_112","O-Of course I was! At that moment, I was thinking...==W== Iris, what was I thinking again?",0,""],["w",1],["ctl","avg1_112","g","015",null,null,-0.05,null,null,"ChanDou1","OutQuint",0.7],["se","se_030"],["goon"],["chd",0,0,"avg1_111","a","004","speechless"],["say","avg1_111","Well, Mom. We don't have the sheer power of Nazuka or Chitose. We can't just wipe out enemies instantly.",0,""],["chd",0,2,"avg1_103","a","003","speechless"],["say","avg1_103","And unlike the White Cats, we can't just slip away and keep our distance.",0,""],["ctl","avg1_103","a",null,null,null,null,null,null,null,"Linear",1.0],["ctl","avg1_111","a","017",null,null,null,null,null,"JuGong","Linear",1.0],["se","se_226"],["say","avg1_111","But our teamwork is perfect.==W== No words. No signals. Just three of us moving as one.",0,""],["ctl","avg1_103","a","010",null,null,null,null,null,"daintou","Linear",1.0],["ctl","avg1_112","g","006",null,null,null,null,null,"lengzhan","Linear",1.0],["w",1],["goon"],["ctl","avg1_112","g","021",null,null,null,null,null,"Tiao","OutQuint",0.7],["se","se_236"],["say","avg1_112","Yeah, exactly! So charging in and fighting like crazy was the best way to stall them! Yep, that was my plan all along.",0,""],["stg",0,null,-30.0,1.2,"OutQuint",1.0,null,null,null],["chd",1,0,"avg1_111","a","002",null],["chd",1,2,"avg1_103","a","002",null],["ctl","avg1_112","g",null,null,null,0.0,null,null,null,"InBack",0.7],["se","se_208"],["say","avg1_112","Besides, it's just a scratch!==W== It doesn't even hurt anymore. Watch, I can get up right now...",0,""],["w",0.7],["goon"],["show","avg1_139","b","029",0.8,null,null,0,null,0.0],["ctl","avg1_139","b",null,null,0.65,null,null,1.0,null,"OutBack",0.7],["ctl","avg1_112","g","015",null,0.45,-0.1,null,null,"lengzhan","OutQuint",1.0],["stg",0,-100.0,null,null,"OutQuint",1.0,null,null,"Xiao"],["se","se_062"],["se","se_251"],["say","avg1_139","Sit. You are staying in this bed for thirty minutes. No moving. Or that wound will tear right back open.",0,""],["ctl","avg1_112","g","008","symbol",null,null,null,null,"lengzhan","Linear",1.0],["say","avg1_112","What? Half an hour of no moving?!",0,""],["ctl","avg1_139","b",null,"speechless",null,null,null,null,"JuGong","Linear",1.0],["say","avg1_139","And keep it dry. No heavy exercise for two days. Do not pick at the glue. And for a full week, absolutely no stretching that area.",0,""],["ctl","avg1_139","b",null,null,null,null,null,null,null,"Linear",1.0],["ctl","avg1_112","g","015","flurry",null,null,null,null,"niunie","OutQuint",0.7],["say","avg1_112","Wait, so I can't fight for a week?! Mom, you know how tough I am! I fell off the Waterway as a kid and came out fine. A normal person might need a week to heal, but I'll be fine by tomorrow!",0,""],["ctl","avg1_139","b","016","angry",null,null,null,null,null,"Linear",1.0],["stg",0,null,-50.0,1.25,"OutQuint",0.7,null,null,"Xiao"],["say","avg1_139","That's because you fell straight into the pond!==W== And Iris used magic to break your fall!",0,""],["w",0.5],["goon"],["stg",0,null,-80.0,1.3,"OutQuint",0.7,null,null,"Xiao"],["ctl","avg1_112","g","012",null,null,null,null,null,"lengzhan","Linear",1.0],["ctl","avg1_139","b","022","resentful",null,null,null,null,null,"Linear",1.0],["say","avg1_139","Do you know? A fraction deeper and you'd have had massive internal bleeding!==W== Mirage has no doctors. No hospitals. We could have lost you!",0,""],["w",0.5],["goon"],["ctl","avg1_139","b","016",null,null,null,null,null,null,"OutQuint",1.0],["ctl","avg1_112","g",null,"flurry",null,null,null,null,"niunie","Linear",1.0],["stg",0,0.0,-30.0,1.2,"OutQuint",1.0,null,null,null],["say","avg1_112","Eek! Mom, please don't be mad. I'll stay put, I swear.==W== B-But I really do have some crucial intel to share.",0,""],["w",1],["ctl","avg1_112","g","010",null,null,null,null,null,"diantou","Linear",1.0],["se","se_077"],["goon"],["chd",0,0,"avg1_111","a","004","sigh"],["say","avg1_111","Just listen to Mom and rest, Noya. Amber and I will share Laru's intel. Boss already guessed most of it anyway. We just need to go over the combat data for those three Company Commanders.",0,""],["chd",0,2,"avg1_103","c","007",null],["se","se_118"],["say","avg1_103","I saved it on my phone. Sending over Heartlink now.",0,""],["chd",1,0,"avg1_111","a","002",null],["chd",1,2,"avg1_103","a","002",null],["stg",0,-200.0,-50.0,1.25,"OutQuint",1.0,null,null,null],["ctl","avg1_112","g",null,null,0.38,-0.18,1.1,null,null,"OutQuint",1.0],["ctl","avg1_139","b","010","sigh",0.62,null,null,null,null,"OutQuint",0.7],["say","avg1_139","Phew. I need to check on the kids. We can't leave everything to Nazuka. Boss, keep an eye on Noya for me.",0,""],["w",0.5],["mrt",1,"z","022",null,"JuGong"],["se","se_077"],["say","avg3_100","Yeah.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_139","b",null,null,0.65,null,null,0.0,null,"OutQuint",0.7],["hide","avg1_139",0.7],["ctl","avg1_112","g","010","sweaty",0.5,null,1.0,null,null,"OutQuint",1.0],["stg",0,0.0,100.0,1.15,"OutQuint",1.0,null,null,null],["say","avg1_112","==PLAYER_NAME== is watching me? But ... ==PLAYER_NAME== has actual work to do.",0,""],["w",0.5],["mrt",1,"z","013","happy","niunie"],["say","avg3_100","Not at all. My schedule is wide open.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["chd",0,2,"avg1_139","a","010","vexation"],["say","avg1_139","Because other than me, ==PLAYER_NAME== is the only one who can keep you in line.",0,""],["w",0.5],["chd",1,2,"avg1_139","a","002",null],["se","se_010"],["se","se_168"],["bgm",""],["stg",0,0.0,0.0,1.1,"OutQuint",1.0,null,null,null],["w",0.7],["se","se_166"],["w",1.5],["se","se_207"],["ctl","avg1_112","g","008","sweaty",null,0.0,null,null,null,"OutBack",1.0],["bgm","m31"],["say","avg1_112","Well, they're gone. Seriously though, is babysitting me for half an hour ruining your plans?",0,""],["w",0.5],["mrt",1,"z","011","flurry","niunie"],["say","avg3_100","Nope. Everyone knows their assignments. I'd just be standing around anyway.",1,""],["mrt",0,"y","003",null,"diantou"],["se","se_019"],["say","avg3_100","Mirage is surrounded. It's looking incredibly bleak. But when things get this dark, I have to stay calm and look on the bright side. You taught me that, Noya.",1,""],["mrt",0,"y","014","attention",null],["say","avg3_100","Plus, my friend got hurt. Sitting here with her is pretty important to me. But if you're really worried about delaying our battle prep, let's hear this intel.",1,""],["mrt",3,"y",null,null,null],["w",0.5],["stg",0,-200.0,-30.0,1.2,"OutQuint",1.0,null,null,null],["ctl","avg1_112","g","015","question",null,null,null,null,null,"OutBack",0.7],["show","avg1_103","b","004",0.7,-0.4,1.5,0,null,0.0],["ctl","avg1_103","b",null,null,0.75,null,null,0.9,null,"OutQuint",1.0],["say","avg1_112","Me? Honestly, Amber's notes are probably way more accurate...",0,""],["w",0.5],["mrt",1,"z","022","happy","niunie1"],["say","avg3_100","Maybe. But your instincts are incredibly sharp. I want to hear your gut read on all this.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_103","b",null,null,null,null,null,0.0,null,"OutQuint",0.5],["hide","avg1_103",0.5],["ctl","avg1_112","g","014",null,0.55,0.0,null,null,"JuGong","OutQuint",0.7],["stg",0,100.0,null,null,"OutQuint",1.0,null,null,null],["se","se_208"],["bgm",""],["obj","qstory_main_09_008",1,0.35,0.54],["say","avg1_112","My gut read... O-Okay! Take a look at this.",0,""],["w",0.5],["mrt",1,"y","012","question",null],["bgm","m42"],["say","avg3_100","What are these? Empty fry boxes?",1,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_112","g","006",null,null,null,null,null,"JuGong","Linear",1.0],["se","se_077"],["say","avg1_112","Yeah. So, we totally smashed right through the Salvation Committee's line, but then some sniper ambushed us out of nowhere.",0,""],["ctl","avg1_112","g","023","sweaty",null,null,null,null,"lengzhan","Linear",1.0],["say","avg1_112","Luckily, they only fired twice before stopping.",0,""],["w",0.5],["mrt",1,"z","010","sigh",null],["say","avg3_100","Those shots came from the dunes miles outside Mirage. Of course you couldn't spot them.",1,""],["mrt",0,"y","014",null,"diantou"],["se","se_019"],["say","avg3_100","They only fired twice because Minova and Kaede snuck into the enemy camp in disguise. They tried to jump Angie and failed, but they totally distracted the sniper.",1,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_112","g","006","attention",null,null,null,null,null,"OutQuint",1.0],["se","se_021"],["say","avg1_112","Whoa, from that far out?==W== Oh, then I know exactly who it is! Hang on, let me look... Here, inside this box, it says...",0,""],["w",0.7],["goon"],["w",0.5],["stg",3,null,100.0,1.2,"Linear",0.0,null,null,null],["bg","BG_Black",3,0.0],["stage",3,0,6],["show","avg3_216","a","006",null,-0.25,1.7,3,null,null],["stg",3,null,0.0,null,"OutSine",7.0,null,null,null],["mrt",1,"y","003","speechless",null],["say","avg3_100","Gunhild. Sentinel of Dawn gunner. Wields the ultra-long-range precision magic cannon, Piercer. Rumor says if Piercer hits you once, it remembers you. Next time, it just auto-aims and fires on its own.",1,""],["mrt",0,"y","012",null,null],["say","avg3_100","It also engulfs other magic to temporarily boost its own damage. The more magic it swallows, the deadlier the shell... But the longer it takes to charge.",1,""],["ctl","avg3_216","a","016",null,null,null,null,null,null,"Linear",1.0],["mrt",0,"y","014","attention","diantou"],["say","avg3_100","Fiercely loyal, respects authority, no bad habits. Top-tier marksmanship. Weakness: incredibly proud of her shooting, and easily irritated.",1,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_112","g","007","idea",null,null,null,null,"tiao2","Linear",1.0],["say","avg1_112","I get it! We'll just find a crack shot to provoke her, and she won't be able to aim straight!",0,""],["w",0.5],["stage",3,1,7],["stg",0,0.0,0.0,1.05,"OutQuint",1.0,null,null,null],["ctl","avg1_112","g",null,null,0.5,null,null,null,null,"OutQuint",1.0],["objx"],["se","se_021"],["mrt",1,"z","020",null,"JuGong"],["say","avg3_100","This fry box is an absolute goldmine. How did you even get this?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_112","g","015","speechless",null,null,null,null,"niunie1","Linear",1.0],["say","avg1_112","It's nuts. You won't even believe me. It happened right after we ducked into the backstreets to dodge the sniper...",0,""],["ctl","avg1_112","g","014",null,null,null,null,null,"JuGong","Linear",1.0],["stg",0,null,-50.0,1.2,"OutQuint",1.0,null,null,null],["se","se_226"],["say","avg1_112","Where we ran into a total fry freak!",0,""],["w",0.5],["bgm",""],["trn",0,0,false,false,2.0],["w",2.0],["end"]]}