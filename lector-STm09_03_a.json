Linear",1.0],["se","se_030"],["say","avg1_144","I beg your forgiveness, my ==SEX11==. A wall of knights held me back, and I failed to stop the arbiter who struck at you. I bear the blame entirely.",0,""],["w",0.5],["mrt",1,"z","022","flurry","niunie"],["say","avg3_100","Don't blame yourselves. The Committee had us severely outmanned. You both did everything you could.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["stg",0,null,null,1.15,"OutQuint",1.0,null,null,null],["ctl","avg1_144","a",null,null,0.1,-0.15,1.4,0.0,null,"OutQuint",0.7],["hide","avg1_144",0.7],["ctl","avg1_133","a",null,null,0.9,-0.15,1.4,0.0,null,"OutQuint",0.7],["hide","avg1_133",0.7],["ctl","avg1_114","a",null,null,0.35,0.0,1.0,1.0,null,"OutQuart",1.0],["ctl","avg1_108","a",null,null,0.65,0.0,1.0,1.0,null,"OutQuart",1.0],["se","se_093"],["se","se_062"],["w",0.7],["ctl","avg1_114","a","025","music",null,null,null,null,null,"Linear",1.0],["say","avg1_114","Heh! The great Chaton returns in triumph! Those Committee goons kept scurrying around like rats,==W== but they didn't stand a chance against my surging dark power and flawless beats.==W== Not a single one crossed my line!",0,""],["w",0.5],["show","avg3_1304","b","011",0.35,null,0.96,0,null,0.0],["ctl","avg1_114","a",null,null,null,null,null,0.0,"JuGong","OutQuint",0.7],["hide","avg1_114",0.7],["ctl","avg3_1304","b",null,null,null,null,null,1.0,"JuGong","OutQuint",0.7],["stg",0,200.0,null,1.2,"OutQuint",0.7,null,null,null],["fx",0,"fx_speedline_center_w",0,2],["se","se_257"],["goon"],["ctl","avg1_108","a","011",null,null,null,null,null,null,"Linear",1.0],["w",0.5],["goon"],["ctl","avg1_108","a","008",null,null,null,null,null,"lengzhan","Linear",1.0],["se","se_077"],["say","avg1_108","Reel it in, Chaton. Arrogance leads to downfall!",0,""],["stg",0,-100.0,null,1.1,"OutQuint",1.0,null,null,null],["ctl","avg3_1304","b",null,null,0.3,0.02,0.9,null,null,"OutQuint",1.0],["ctl","avg1_108","a","005",null,0.55,-0.05,1.1,null,null,"OutQuint",0.7],["se","se_062"],["say","avg1_108","Boss, the Committee's warding magic is thick. We fought them off, but hardly left a scratch. The second they reform their ranks, they're coming right for us again.",0,""],["ctl","avg1_108","a","006","speechless",null,null,null,null,null,"Linear",1.0],["say","avg1_108","Sitting here makes us easy targets. We need to move. Chaton, get back out there and scout the mineshafts.",0,""],["stg",0,0.0,null,null,"OutQuint",1.0,null,null,null],["ctl","avg1_108","a",null,null,0.65,0.0,1.0,null,null,"OutQuint",1.0],["ctl","avg3_1304","a",null,null,0.35,0.0,1.0,0.0,"tiao2","OutQuint",0.7],["hide","avg3_1304",0.7],["show","avg1_114","a","024",0.3,0.02,0.9,0,null,0.0],["ctl","avg1_114","a",null,"happy",0.35,0.0,1.0,1.0,"tiao2","OutQuint",0.7],["say","avg1_114","Understood! The great Chaton is on her way!",0,""],["w",0.5],["mrt",1,"z","014","attention",null],["say","avg3_100","Hold on. There's no rush. The Committee isn't attacking anytime soon.",1,""],["mrt",0,"y","003",null,"diantou"],["se","se_077"],["ctl","avg1_114","a","016",null,null,null,null,null,null,"Linear",1.0],["ctl","avg1_108","a","013",null,null,null,null,null,null,"Linear",1.0],["say","avg3_100","Angie and I just agreed to negotiate in two hours. We have a ceasefire until then.",1,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_108","a","008",null,null,null,null,null,"lengzhan","Linear",1.0],["se","se_251"],["say","avg1_108","Negotiate? Boss, don't do it.==W== You can't trust Angie or her Committee for a second.",0,""],["w",0.5],["ctl","avg1_114","a","030",null,null,null,null,null,"daintou","Linear",1.0],["goon"],["ctl","avg1_114","a",null,null,null,null,null,0.0,null,"OutQuint",0.7],["hide","avg1_114",0.7],["ctl","avg1_108","a",null,null,null,null,null,0.0,null,"OutQuint",0.7],["hide","avg1_108",0.7],["stg",0,null,null,1.0,"OutQuint",1.0,null,null,null],["show","avg1_144","a","012",0.1,-0.2,1.4,0,null,0.0],["show","avg1_133","a","010",0.9,-0.2,1.4,0,null,0.0],["ctl","avg1_144","a",null,null,0.3,0.0,1.0,1.0,null,"OutQuart",1.0],["ctl","avg1_133","a",null,null,0.7,0.0,1.04,1.0,null,"OutQuart",1.0],["se","se_062"],["say","avg1_144","I must agree. She lured you to her quarters once before, my ==SEX11==, only to spring a lethal trap. This is the exact same ploy. Do not fall for it.",0,""],["ctl","avg1_133","a","019","flurry",null,null,null,null,"niunie","Linear",1.0],["say","avg1_133","We've got the desert and the old mineshafts right outside! We can find a way to slip away. There's zero reason to parley with her.",0,""],["w",0.5],["mrt",1,"y","003","sigh",null],["say","avg3_100","I hear you. But the only reason she even offered a truce is that you all fought her to a standstill.",1,""],["mrt",0,"y","014","attention",null],["say","avg3_100","Before you arrived, Minova checked in. She, Otoha, and Kaede slipped into the dunes in disguise and hit the Committee's artillery camp.",1,""],["mrt",0,"z","002",null,"diantou"],["se","se_077"],["say","avg3_100","Mistique also used a fake interview to feed me some intel: the Committee split their raid into three troops.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_144","a",null,null,null,null,null,0.0,null,"OutQuint",0.7],["hide","avg1_144",0.7],["ctl","avg1_133","a",null,null,null,null,null,0.0,null,"OutQuint",0.7],["hide","avg1_133",0.7],["bg","BG_Black",4,0.0],["bg","BG_Black",3,0.0],["show","avg1_163","a","005",null,-0.3,1.4,3,null,null],["show","avg3_217","a","007",null,-0.35,1.5,4,null,null],["stage",3,0,0],["chd",0,0,"avg1_156","a","006","speechless"],["say","avg1_156","Three troops... Guess that tin can leads one.",0,""],["stage",4,0,0],["ctl","avg1_156","a",null,null,null,null,null,null,null,"Linear",1.0],["chd",0,2,"avg1_134","a","006","flurry"],["say","avg1_134","And... The arbiter who made me see all those awful illusions... That's two.",0,""],["w",0.5],["chd",1,0,"avg1_156","a","002",null],["chd",1,2,"avg1_134","a","002",null],["stage",3,1,1],["stage",4,1,1],["ctl","avg1_163","a",null,null,null,null,null,0.0,null,"Linear",0.3],["hide","avg1_163",0.3],["ctl","avg3_217","a",null,null,null,null,null,0.0,null,"Linear",0.3],["hide","avg3_217",0.3],["show","avg3_216","a","005",null,-0.28,1.5,5,null,null],["bg","BG_Black",5,0.0],["stage",5,0,0],["mrt",1,"y","002",null,null],["say","avg3_100","Which makes the artillery camp out on the dunes the third.",1,""],["mrt",0,"z","014","attention","diantou"],["say","avg3_100","When Angie asked for this talk, all three of her forces were compromised. Stuck in the mines, pinned down by you, or blindsided by Minova.",1,""],["stage",5,1,15],["stg",0,null,null,1.05,"OutQuint",1.0,null,null,null],["show","avg1_108","a","002",null,null,null,0,null,0.0],["ctl","avg1_108","a",null,null,null,null,null,1.0,null,"OutQuint",1.0],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_216","a",null,null,null,null,null,null,null,"Linear",0.0],["hide","avg3_216",0],["ctl","avg1_108","a","005","speechless",null,null,null,null,"JuGong","Linear",1.0],["say","avg1_108","Makes sense. Her board was completely clear. She just needed time to piece her formations back together. The negotiation is a stall.",0,""],["stg",0,100.0,null,null,"OutQuint",1.0,null,null,null],["show","avg1_144","a","006",0.15,null,null,0,null,0.0],["ctl","avg1_144","a",null,"question",0.25,null,null,1.0,null,"OutQuint",1.0],["ctl","avg1_108","a",null,null,0.55,null,null,null,null,"OutQuint",1.0],["say","avg1_144","Then I am lost, my ==SEX11==. If you have already laid bare her scheme, why would you ever...",0,""],["w",0.5],["mrt",1,"z","003",null,"JuGong"],["se","se_208"],["say","avg3_100","Because we need that time far more than she does.",1,""],["mrt",0,"z","020","speechless","niunie1"],["cbg",0,null,null,1.05,"OutQuint",1.0,null,null,null],["say","avg3_100","Look at our situation back then. Fuyuka, Nazuna, and Allie had just barely shaken off No. 160's magic. I had no idea if the rest of you were still standing,==W== and the Daisy Orphanage was sitting right in the crossfire.",1,""],["w",0.7],["goon"],["mrt",0,"z","010","sigh","lengzhan"],["ctl","avg1_144","a","008",null,null,null,null,null,null,"Linear",0.0],["ctl","avg1_108","a","013",null,null,null,null,null,null,"Linear",0.0],["cbg",0,null,null,1.0,"OutQuint",0.5,null,null,null],["say","avg3_100","Taking her deal was my way of stalling, too.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["show","avg1_133","a","021",0.9,null,1.04,0,null,0.0],["ctl","avg1_133","a",null,"flurry",0.7,null,null,1.0,null,"OutBack",0.8],["ctl","avg1_108","a",null,null,0.5,null,null,null,null,"OutQuint",0.7],["ctl","avg1_144","a",null,null,0.2,null,null,0.0,null,"OutQuint",0.7],["hide","avg1_144",0.7],["stg",0,-200.0,null,1.05,"OutQuint",1.0,null,null,null],["se","se_062"],["say","avg1_133","But ... that's still too dangerous. Let's just run the clock and make a break for it! Boss, I can carry you and fly us straight out of Mirage!",0,""],["w",0.5],["mrt",1,"y","020","speechless","niunie1"],["say","avg3_100","Two hours won't cut it. Kasimira, how long does it take to evacuate the White Cats and empty the city of civilians?",1,""],["mrt",3,"y",null,null,null],["w",0.5],["stg",0,0.0,null,1.15,"OutQuint",1.0,null,null,null],["ctl","avg1_133","a",null,null,0.8,null,null,0.0,null,"OutQuint",0.7],["hide","avg1_133",0.7],["ctl","avg1_108","a","012","vexation",0.5,null,null,null,"niunie1","OutQuint",1.0],["say","avg1_108","We're out of capacity. Fifty White Cats shepherding over a thousand people is too much of an undertaking.",0,""],["ctl","avg1_108","a","014",null,null,null,null,null,null,"Linear",1.0],["say","avg1_108","Not to mention the sheer amount of supplies we'd need for a desert march. I figure the earliest they'll be ready is tonight.",0,""],["w",0.5],["mrt",1,"y","010","sweaty",null],["say","avg3_100","Allie is in the same boat. She and Benito are at the orphanage preparing to leave the city with the kids. But in two hours, they won't get far enough.",1,""],["mrt",0,"z","020",null,"diantou"],["se","se_077"],["say","avg3_100","So, I'll try to stall them at the negotiation table and buy us some time.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_014"],["w",0.7],["ctl","avg1_108","a",null,null,null,0.03,0.9,0.0,null,"OutQuint",0.7],["hide","avg1_108",0.7],["stg",0,null,null,1.0,"OutQuint",1.0,null,null,null],["show","avg3_1311","b","012",null,-0.2,1.4,0,null,0.0],["ctl","avg3_1311","b",null,null,null,0.0,1.0,1.0,null,"OutQuart",1.0],["se","se_118"],["bgm",""],["w",0.7],["ctl","avg3_1311","b","002","attention",null,null,null,null,"diantou","Linear",1.0],["say","1","It's Firenze. She must have an update on the Dusk Arbiter.",0,""],["w",0.5],["bg","forest",1,0.0],["show","avg1_110","c","010",null,null,null,1,null,0.9],["se","se_342"],["bgm","m46"],["stage",1,0,0],["cbg",0,-100.0,null,0.98,"OutQuint",1.0,null,null,null],["ctl","avg3_1311","b","009",null,0.75,-0.1,1.2,null,null,"OutQuint",1.0],["obj","qstory_main_007",1,null,0.54],["w",1],["ctl","avg1_110","c",null,null,null,-0.07,1.15,1.0,null,"OutQuint",1.0],["se","se_101"],["say","avg1_110","Good afternoon, Boss. I've been holding off on a direct line. I didn't want the Salvation Committee tapping our Heartlink.",0,""],["ctl","avg1_110","c","009","attention",null,null,null,null,"diantou","Linear",1.0],["say","avg1_110","But it's the 18th now. Nazuka's team must have found you. If you're picking up, you must already know about the raid and have it under control.",0,""],["ctl","avg3_1311","b","014","sigh",null,null,null,null,"niunie1","OutQuint",1.0],["say","1","Not exactly under control, but it doesn't matter anymore. We've already clashed with them here in Mirage. If they're listening in, let them.",0,""],["ctl","avg1_110","c","018","happy",null,null,null,null,"JuGong","Linear",1.0],["say","avg1_110","Heh. Fair enough. Judging by your tone, the Committee didn't walk all over you.",0,""],["ctl","avg3_1311","b","009","speechless",null,null,null,null,"niunie1","Linear",1.0],["say","1","We barely held the line. They outmatched us in numbers, gear, and magic. Things are grim.==W== What's your status?",0,""],["w",0.7],["ctl","avg3_1311","b","014","question",null,null,null,null,null,"Linear",1.0],["goon"],["se","se_226"],["ctl","avg1_110","c","009",null,0.65,null,null,0.9,null,"OutQuint",0.7],["stg",1,150.0,-50.0,1.15,"OutQuint",0.7,null,null,null],["show","avg3_129","a","002",0.3,0.05,null,1,null,0.0],["show","avg1_107","a","002",0.48,-0.05,null,1,null,0.0],["ctl","avg3_129","a",null,null,null,null,null,1.0,null,"OutQuint",0.7],["ctl","avg1_107","a",null,null,null,null,null,1.0,null,"OutQuint",0.7],["say","avg1_110","I diverted the Imperial Guard's grain convoy and hired some extra muscle out of Emor. Roughly two hundred fighters in total.==W== We'll hit Mirage in three days.",0,""],["w",0.5],["goon"],["ctl","avg1_107","a",null,null,null,null,null,0.0,null,"OutQuint",0.7],["hide","avg1_107",0.7],["ctl","avg3_129","a",null,null,null,null,null,0.0,null,"OutQuint",0.7],["hide","avg3_129",0.7],["show","avg1_149","a","002",0.4,-0.3,1.4,1,null,0.0],["ctl","avg1_149","a",null,null,null,null,null,1.0,null,"OutQuint",0.7],["ctl","avg3_1311","b","009",null,null,null,null,null,null,"Linear",1.0],["say","avg1_110","The Dusk Arbiter also threw in a few arbiters at the last minute.==W== Their leader looks formidable.",0,""],["w",0.5],["goon"],["ctl","avg1_149","a",null,null,null,null,null,0.0,null,"OutQuint",0.7],["hide","avg1_149",0.7],["show","avg3_150","a","002",0.4,-0.3,1.4,1,null,0.0],["ctl","avg3_150","a",null,null,null,null,null,1.0,null,"OutQuint",0.7],["say","avg1_110","And Albedo is rallying any Sentinels of Dawn who don't believe you'll destroy the world.==W== They're marching for the desert, about a day behind us.",0,""],["w",0.5],["goon"],["stg",1,0.0,0.0,1.0,"OutQuint",1.0,null,null,null],["ctl","avg3_150","a",null,null,null,null,null,0.0,null,"OutQuint",0.7],["hide","avg3_150",0.7],["ctl","avg1_110","c","014","attention",0.5,null,null,1.0,null,"OutQuint",1.0],["s