{"id":"STm09_03_b","names":{"0":"","Capable Committee Member":"Capable Committee Member","Preparing Committee Member":"Preparing Committee Member","avg1_111":"Iris","avg1_132":"Minova","avg1_133":"Nazuka","avg1_134":"Fuyuka","avg1_136":"Angie","avg1_144":"Chitose","avg1_145":"Otoha","avg1_163":"Greyhorn","avg2_947":"Sentinel of Dawn Soldier","avg2_948":"Sentinel of Dawn Soldier","avg3_100":"Sylar","avg3_1307":"Sentinel of Dawn Soldier M","avg3_1308":"Sentinel of Dawn Soldier F","avg3_216":"Gunhild","avg4_999":"Vita"},"en":{"0":"","Capable Committee Member":"Capable Committee Member","Preparing Committee Member":"Preparing Committee Member","avg1_111":"Iris","avg1_132":"Minova","avg1_133":"Nazuka","avg1_134":"Fuyuka","avg1_136":"Angie","avg1_144":"Chitose","avg1_145":"Otoha","avg1_163":"Greyhorn","avg2_947":"Sentinel of Dawn Soldier","avg2_948":"Sentinel of Dawn Soldier","avg3_100":"Sylar","avg3_1307":"Sentinel of Dawn Soldier","avg3_1308":"Sentinel of Dawn Soldier","avg3_216":"Gunhild","avg4_999":"Vita"},"tx":1,"steps":[["intro","Act Three","Rain in the Desert","Angie's terms for peace remain unchanged: your life. Her deductions hit dangerously close to the truth of the Tyrant Development System. Though shaken, you still give Fuyuka the signal to spring the trap..."],["trn",0,0,false,false,1.0],["w",1.0],["bg","mirage_street_2_daylight",0,0.5],["w",0.5],["cbg",0,null,null,1.05,"Linear",0.0,null,null,null],["fx",0,"fx_avg_sand_lp",0,0],["se","se_001"],["stg",0,null,null,1.1,"OutCubic",3.0,null,null,null],["trn",1,0,false,false,1.0],["w",1.0],["head","15:00, Nebula Month 18th, Mirage, Unnamed Street"],["show","avg1_136","a","002",0.5,0.05,0.9,0,null,0.0],["ctl","avg1_136","a","002",null,null,0.0,1.0,1.0,null,"OutCubic",1.0],["w",2.0],["se","se_100"],["ctl","avg1_136","a",null,null,null,null,null,null,"JuGong","Linear",0.5],["say","avg1_136","We meet again, Tyrant.",0,""],["bgm","m111"],["ctl","avg1_136","a","004","attention",null,null,null,null,null,"Linear",0.5],["say","avg1_136","Just one guard. I admit, I'm a bit surprised.",0,""],["w",0.5],["ctl","avg1_136","a",null,null,0.25,null,null,null,null,"OutCubic",0.5],["fx",0,"fx_avg_sand_lp",1,0],["bg","mirage_street_2_daylight",2,0.0],["show","avg1_144","a","016",0.65,0.05,0.9,2,null,1.0],["show","avg3_100","a","003",0.45,null,null,2,null,1.0],["stage",2,0,0],["ctl","avg3_100","a","003","sigh",null,null,null,null,null,"Linear",0.5],["w",0.5],["say","avg3_100","Let's be real, Angie. You have no one left to send.",0,""],["ctl","avg3_100","a","012",null,null,null,null,1.0,null,"Linear",0.5],["say","avg3_100","We have 160. Gunhild is tied down at the artillery. Greyhorn is the only backup you could scrape together.",0,""],["w",0.5],["stg",0,200.0,null,null,"OutCubic",0.5,null,null,null],["ctl","avg1_136","a",null,null,null,null,null,null,null,"Linear",0.5],["show","avg1_163","a","002",0.08,0.1,0.8,0,null,0.0],["ctl","avg1_163","a",null,null,null,null,null,1.0,null,"Linear",0.5],["ctl","avg3_100","c","020","speechless",null,null,null,null,null,"Linear",0.5],["say","avg3_100","Greyhorn is an honorable knight. She wouldn't stoop to a sneak attack.==W== And as for you...",0,""],["w",1.0],["stg",0,0.0,null,null,"OutCubic",1.0,null,null,null],["ctl","avg3_100","a",null,null,null,null,null,1.0,null,"Linear",0.5],["ctl","avg1_163","a",null,null,null,null,null,0.0,null,"Linear",0.5],["ctl","avg1_136","a",null,null,null,null,null,null,null,"OutCubic",0.5],["goon"],["se","se_434"],["ctl","avg1_144","a",null,null,null,null,null,null,"JuGong","OutCubic",0.5],["ctl","avg3_100","a","012",null,null,null,null,1.0,null,"Linear",0.5],["say","avg3_100","Your Scepter of Death stands no chance against Chitose's blade.",0,""],["se","se_029"],["ctl","avg3_100","a","014",null,null,null,null,null,null,"Linear",0.5],["say","avg3_100","So having Chitose with me is more than enough. The rest of my team has better things to do.",0,""],["w",0.5],["ctl","avg1_136","a","014","vexation",null,null,null,null,"niunie1","Linear",0.5],["say","avg1_136","Oh my. Am I really nothing but a backstabbing coward to you?",0,""],["w",0.5],["ctl","avg3_100","a","012","question",null,null,null,null,null,"Linear",0.5],["say","avg3_100","Aren't you? You invited me to a hotel just to murder me with an Artifact I wished into existence.",0,""],["w",0.5],["ctl","avg1_136","a","003","happy",null,null,null,null,null,"Linear",0.5],["say","avg1_136","Heh. I never denied being despicable. I'll do whatever it takes to save this world.",0,""],["se","se_226"],["ctl","avg1_136","a","013",null,null,null,null,null,null,"Linear",0.5],["say","avg1_136","But sneak attacks are hardly my only tactic.",0,""],["w",0.5],["ctl","avg3_100","a","009",null,null,null,null,null,null,"Linear",0.5],["say","avg3_100","Enough talk. The fighting hasn't caused too much damage yet, and nobody has died.",0,""],["se","se_074"],["ctl","avg1_144","a",null,null,null,null,null,0.0,null,"Linear",0.5],["ctl","avg3_100","a","002",null,0.5,-0.35,1.5,null,null,"Linear",0.3],["say","avg3_100","Angie, order the Salvation Committee to stand down. I'll guarantee your safety, ensure a fair trial, and even plead your case.",0,""],["w",0.5],["ctl","avg1_136","a","014","attention",null,null,null,null,null,"Linear",0.5],["say","avg1_136","Are those your terms? How merciful, considering we are trying to kill you.",0,""],["w",0.5],["ctl","avg1_136","a","017","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_136","But ...==W== where is all this confidence coming from?",0,""],["w",1.0],["se","se_257"],["ctl","avg1_136","a","015",null,null,-0.35,1.5,null,null,"Linear",0.3],["goon"],["w",0.5],["ctl","avg3_100","a","012","exclamation",null,null,null,null,null,"Linear",0.5],["say","avg3_100","We just steamrolled your Second Company in a head-on fight. And we captured 160.",0,""],["w",0.5],["ctl","avg1_136","a","003","happy",null,null,null,null,null,"Linear",0.5],["say","avg1_136","Heh. A minor setback.",0,""],["w",0.5],["ctl","avg1_136","a","004","sigh",null,null,null,null,null,"Linear",0.5],["say","avg1_136","Your companions are strong, and your tactics are sharp. But wars are won on logistics, not individual heroism.",0,""],["ctl","avg1_136","a","006",null,0.4,null,null,null,null,"OutCubic",0.5],["ctl","avg1_163","a","003",null,0.15,null,null,1.0,null,"OutCubic",0.5],["say","avg1_136","Greyhorn. Give ==SEX4== the casualty report for the Second Company.",0,""],["w",0.5],["ctl","avg1_163","a","002",null,null,null,null,null,null,"Linear",0.5],["ctl","avg1_136","a",null,null,0.4,null,null,null,null,"OutCubic",0.5],["say","avg1_163","Yes, Ma'am.",0,""],["w",0.5],["ctl","avg1_136","a",null,null,0.45,null,1.6,0.0,null,"Linear",0.3],["se","se_080"],["ctl","avg1_163","a","004",null,0.25,-0.3,1.4,null,null,"Linear",0.3],["say","avg1_163","Zero fatalities. Forty minor injuries, ten severe. Aside from the critical cases, the rest can return to duty after a brief rest.",0,""],["w",0.5],["ctl","avg3_100","c","009","think",null,null,null,null,null,"Linear",0.5],["say","avg3_100","(Just like Nazuka said. The Committee has bottomless magic reserves. They're spamming defensive magic like it's free.)",0,""],["ctl","avg3_100","c","010","sigh",null,null,null,null,null,"Linear",0.5],["say","avg3_100","(We tore right through their entire unit, but barely made a dent in their actual numbers.)",0,""],["w",0.5],["ctl","avg1_163","a",null,null,0.1,-0.15,1.2,0.0,null,"OutCubic",0.5],["ctl","avg1_136","a","014","sweaty",0.3,-0.35,1.5,1.0,null,"OutCubic",0.5],["ctl","avg3_100","c","012",null,null,null,null,null,null,"Linear",0.5],["say","avg1_136","Your flawless assault only cost me ten soldiers. And I still have two completely untouched companies waiting in the wings.",0,""],["ctl","avg1_136","a","009","happy",null,null,null,null,null,"Linear",0.5],["say","avg1_136","You might pull off a few more beautiful victories. But how long will the Grace in your Soul Stones actually last?",0,""],["w",0.5],["stage",2,1,1],["ctl","avg1_136","a","003","music",0.5,null,null,null,null,"OutCubic",0.5],["say","avg1_136","We have an overwhelming advantage in both numbers and supplies.",0,""],["ctl","avg1_136","a","004",null,null,null,null,null,null,"Linear",0.5],["say","avg1_136","You only called this meeting to pressure me. Riding the momentum of your recent win, hoping I'd panic and cave to your demands.",0,""],["w",0.5],["stg",0,null,null,null,"Linear",1.0,null,null,"Zhong"],["fx",0,"fx_speedline_center",0,0],["ctl","avg1_136","a","016",null,null,null,null,null,null,"Linear",0.5],["say","avg1_136","But you don't understand the Salvation Committee at all. Our only goal is to save the world. No matter how the battle turns, we will never accept your terms.",0,""],["w",0.5],["trn",0,0,true,false,0.5],["w",0.5],["bg","mood_3",0,0.5],["w",0.5],["show","avg3_100","c","009",0.5,null,null,0,null,1.0],["trn",1,0,false,false,0.5],["w",0.5],["se","se_146"],["ctl","avg3_100","c","009",null,null,null,null,1.0,"lengzhan2","OutSine",0.5],["w",0.5],["say","avg3_100","(She saw right through me. I really did want to put the pressure on her.)",0,""],["ctl","avg3_100","c","020",null,null,null,null,1.0,null,"OutSine",0.5],["say","avg3_100","(Changing the outcome for Noya and the Second Company means I can't predict what happens next. If the battle continues, the Committee definitely has the edge.)",0,""],["w",0.5],["bg","BG_Black",0,0.5],["se","se_030"],["ctl","avg3_100","c","010",null,null,null,null,1.0,null,"OutSine",0.5],["say","avg3_100","(Then again, I never expected a few cheap words to fool her, let alone convince her army to surrender.)",0,""],["ctl","avg3_100","c","012","exclamation",null,null,null,1.0,null,"OutSine",0.5],["say","avg3_100","(This whole conversation is just a stall. It gives the others time to get into position. I need to crush the Committee now, while my memories of the last loop are still useful.)",0,""],["w",0.5],["trn",0,0,true,false,0.5],["w",0.5],["bg","mirage_street_2_daylight",0,0.5],["w",0.5],["trn",1,0,false,false,0.5],["w",0.5],["show","avg1_136","a","004",0.5,null,null,0,"question",0.0],["ctl","avg1_136","a","004",null,null,null,null,1.0,null,"Linear",0.5],["say","avg1_136","Well? Nothing to say?==W== I know you're waiting on Firenze and the Dusk Arbiters. They'll be here in about two days.",0,""],["w",0.5],["ctl","avg1_136","a","006",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["mrt",1,"y","020","attention",null],["say","avg3_100","Looks like Angie has her own intel on Firenze and the Arbiters, even without my Heartlink calls.",2,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_136","a","002","happy",null,null,null,null,"niunie1","Linear",0.5],["say","avg1_136","But using this negotiation to stall for time only exposes your weakness.",0,""],["se","se_226"],["ctl","avg1_136","a","015",null,null,-0.35,1.5,null,null,"OutCubic",0.3],["say","avg1_136","The Salvation Committee just needs to keep up a relentless assault. Twenty-four hours is more than enough to take Mirage. Time is not on your side, Tyrant.",0,""],["w",0.5],["mrt",1,"z","002","happy",null],["say","avg3_100","Then why aren't you attacking right now? When it comes down to it, you're using this negotiation to buy time to regroup too, aren't you?",1,""],["mrt",0,"z","003",null,null],["say","avg3_100","We both know exactly where the other stands. Let's drop the act.",1,""],["mrt",0,"z","012","question",null],["say","avg3_100","I'm just curious. Even if I really am the legendary Tyrant, what makes you so sure the Tyrant will destroy the world? Is it all based on that Book of Grace Prophecies?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_136","a","004","attention",null,null,null,null,null,"Linear",0.5],["say","avg1_136","Asking that proves you've read the diary in the White Cat's secret room.==W== You've accepted that you are the Tyrant.",0,""],["w",0.5],["ctl","avg1_136","a",null,null,0.3,null,null,null,null,"OutCubic",0.5],["bg","story_main_08_010_a_FP",0,0.5],["w",0.5],["cbg",0,100.0,null,1.05,"Linear",1.5,null,null,null],["goon"],["w",0.5],["ctl","avg1_136","a","003","idea",null,null,null,null,null,"Linear",0.5],["say","avg1_136","You're right. We both need a little more time. So I'll share something the diary left out.",0,""],["w",0.5],["ctl","avg1_136","a","004",null,null,null,null,null,null,"OutCubic",0.5],["say","avg1_136","Tyrant,==W== do you know the basic principles behind Monolith wishes?",0,""],["w",0.5],["se","se_219"],["bg","tower_wishbox_room",0,0.5],["cbg",0,200.0,null,1.5,"Linear",0.0,null,null,null],["goon"],["w",0.5],["choice",["The wisher sacrifices their memories in exchange for an Artifact."],[[]]],["w",0.5],["ctl","avg1_136","a","017",null,null,null,null,null,null,"Linear",0.5],["say","avg1_136","Exactly. Novians want the convenience of Artifacts, and the Monolith demands their vivid memories.",0,""],["w",0.5],["bgm",""],["se","se_483"],["bg","mirage_street_2_daylight",0,0.5],["ctl","avg1_136","a","002",null,0.5,null,null,1.0,null,"OutCubic",0.5],["say","avg1_136","But I hear your companions... Or rather, the employees of the Boss Accord ... haven't lost any memories in quite some time.",0,""],["w",0.5],["se","se_169"],["trn",0,1,true,false,1.0],["w",1.0],["bg","luckyoasis_forest_daylight",0,0.5],["w",0.5],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["fx",0,"fx_avg_reminiscence_loop",0,2],["trn",1,1,false,false,1.0],["w",1.0],["se","se_401"],["mrt",2,"z","002",null,null],["say","avg4_999","Memories are also a form of information. Vita will replicate memories the Monolith demands during your wish-making, then hand over those copies while you keep your originals.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["show","avg1_111","a","003",null,-0.2,1.25,0,null,0.0],["ctl","avg1_111","a","006",null,null,-0.23,1.3,1.0,null,"OutQuad",0.5],["w",0.5],["say","avg1_111","Can ...==W== it really work like that?",0,""],["se","se_112"],["ctl","avg1_111","a",null,null,null,null,null,null,"lengzhan","Linear",0.5],["w",0.5],["goon"],["ctl","avg1_111","a",null,null,null,null,null,0.0,null,"OutSine",0.5],["w",0.5],["mrt",1,"z","009",null,null],["say","avg3_100","Tricking the Monolith...==W== No, technically we're not tricking it. The Monolith does get the memories, even if they're copies. Info is info, and a copy works just as well as the real thing.",1,""],["w",1],["mrt",0,"z","012","exclamation","jushou"],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["se","se_169"],["trn",0,1,true,false,1.0],["w",1.0],["fx",0,"fx_avg_reminiscence_loop",1,2],["bg","BG_Black",0,0.5],["w",0.5],["trn",1,0,false,false,1.0],["w",1.0],["mrt",1,"y","009","attention",null],["say","avg3_100","That's ...==W== a feature created by the Tyrant Development System combining with the chess piece's authority. It feeds the Monolith copied memories during a wish.",2,""],["w",1.0],["bg","story_main_01_019",0,0.5],["goon"],["mrt",0,"y","020",null,null],["say","avg3_100","To an outsider, it definitely looks like Boss Accord employees can wish without losing their memories.",2,""],["mrt",3,"y",null,null,null],["w",0.5],["bg","BG_Black",0,0.5],["w",0.5],["bg","mirage_street_2_daylight",0,0.5],["show","avg1_136","a","004",null,-0.35,1.5,0,null,0.0],["se","se_055"],["ctl","avg1_136","a","004",null,null,null,null,1.0,null,"Linear",0.5],["w",0.5],["say","avg1_136","The Book of Grace Prophecies 10:10.",0,""],["w",0.5],["trn",0,0,true,false,0.5],["w",0.5],["bg","story_main_01_023",0,1.0],["w",1.0],["stg",0,null,null,null,"Linear",1.0,null,null,"JingTouYaoHuang"],["film",0],["trn",1,0,false,false,0.5],["w",0.5],["se","se_520"],["bgm","m107"],["w",0.5],["say","avg1_136","\"The arrogant Tyrant blinded the defenseless gods with false vows, stealing away their precious relics.\"",3,""],["w",0.5],["bg","story_main_01_023_a",0,1.0],["say","avg1_136","\"From then on, the eternal tower began to decay, and the very foundations of the world began to shake.\"",3,""],["w",0.5],["trn",0,0,true,false,1.0],["w",1.0],["stg",0,null,null,null,"Linear",1.0,null,null,"stop"],["film",1],["bg","mirage_street_2_daylight",0,0.5],["w",0.5],["trn",1,0,false,false,1.0],["w",1.0],["show","avg1_136","a","004",0.5,-0.35,1.5,0,null,0.0],["ctl","avg1_136","a","004","exclamation",null,null,null,1.0,null,"Linear",0.5],["say","avg1_136","Your actions mirror the Book of Grace Prophecies exactly. I believe that answers your question.",0,""],["w",0.5],["mrt",2,"y","025","shock",null],["say","avg3_100","That system feature is going to destroy the world? How is that even possible...",2,""],["se","se_251"],["mrt",0,"y","016",null,"lengzhan"],["say","avg3_100","Ever since I read that diary in the White Cat's secret room, I've been trying to prove I'm not the Tyrant. But the harder I try to escape this doomsday prophecy, the closer I get to fulfilling it.",2,""],["mrt",3,"z",null,null,null],["w",0.5],["trn",0,0,false,false,0.2],["w",0.2],["bg","BG_Black",0,0.1],["ctl","avg1_136","a",null,null,null,null,null,0.0,null,"Linear",0.1],["w",0.1],["stg",0,0.0,0.0,1.1,"Linear",0.0,null,null,null],["trn",1,0,false,false,0.2],["w",0.2],["mrt",1,"y","009","think",null],["say","avg3_100","Angie couldn't possibly know about the Tyrant Development System.==W== And she has no reason to lie to me right now. If she made that up, I could easily check the book myself.",2,""],["w",1.0],["mrt",0,"y","020",null,null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["fx",0,"fx_avg_flash_light",0,0],["mrt",2,"y","025",null,null],["say","avg3_100","So... Does that mean...",2,""],["mrt",0,"y","009","flurry","chijing"],["say","avg3_100","No, no, no. I can't let her get into my head.",2,""],["w",0.5],["bg","mirage_street_2_daylight",0,0.5],["cbg",0,null,null,1.05,"Linear",0.0,null,null,null],["ctl","avg1_136","a","002",null,null,null,null,1.0,null,"Linear",0.5],["w",0.5],["mrt",0,"y","012","exclamation",null],["say","avg3_100","This woman in front of me is just trying to mess with my head.",2,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_136","a","003","happy",null,null,null,null,null,"Linear",0.5],["say","avg1_136","Heh. Watching your expressions change is quite entertaining, Tyrant.",0,""],["ctl","avg1_136","a","004",null,null,null,null,null,null,"Linear",0.5],["say","avg1_136","It's rare we get to negotiate like this. Allow me to present my terms.",0,""],["w",0.5],["se","se_515"],["ctl","avg1_136","c","002",null,null,null,null,null,"JuGong1","Linear",0.5],["w",1.0],["ctl","avg1_136","c","008",null,null,null,null,null,null,"Linear",0.5],["say","avg1_136","Take this Scepter of Death and end your own life. Sacrifice yourself to save the world.",0,""],["ctl","avg1_136","c","003","music",null,null,null,null,null,"Linear",0.5],["say","avg1_136","Do that, and I will guarantee the safety and freedom of your companions and the people of Mirage.",0,""],["w",0.5],["bg","mood_2",4,0.0],["show","avg1_144","a","012",0.5,-0.3,1.4,4,null,1.0],["stage",4,0,0],["ctl","avg1_144","a","012","exclamation",null,null,null,null,null,"Linear",0.5],["say","avg1_144","My ==SEX11==, you needn't listen to such absurdity. I should have cut this woman down at the Monolith in Philae.",0,""],["w",0.5],["stage",4,1,1],["ctl","avg1_136","a","014","sigh",null,null,null,null,"JuGong1","Linear",0.5],["say","avg1_136","Don't be so hasty. I know it's a difficult proposal to accept, so I will add an extra condition.",0,""],["ctl","avg1_136","a","004","idea",null,null,null,null,null,"Linear",0.5],["say","avg1_136","Your companions may join the Salvation Committee and stay by my side. If, after observing my actions, they decide I am not actually saving the world, they may kill me at any time.",0,""],["ctl","avg1_144","a",null,null,null,null,null,0.0,null,"Linear",0.0],["hide","avg1_144",0],["ctl","avg1_136","a","017",null,null,null,null,null,null,"Linear",0.5],["say","avg1_136","Even if they spare me for now, in four years, when the world is truly safe from destruction, I will ask them to take my life as recompense for yours.",0,""],["