ll,"happy",null,null,null,1.0,null,"OutQuint",1.0],["ctl","avg1_111","a",null,null,0.3,null,null,1.0,null,"OutQuint",1.0],["ctl","avg1_103","a",null,null,0.7,null,null,1.0,null,"OutQuint",1.0],["say","avg1_112","Phew... Talk about a blast from the past. We actually made it back here.",0,""],["ctl","avg1_111","a","013","flurry",null,null,null,null,"niunie1","Linear",1.0],["say","avg1_111","Thinking back... How did the three of us manage to lug a Wishing Box that huge down fifty floors?",0,""],["ctl","avg1_103","a","017","sigh",null,null,null,null,"JuGong","Linear",1.0],["say","avg1_103","We ran on Iris's terrifying obsession with Artifacts.",0,""],["ctl","avg1_112","a","005","attention",null,null,null,null,"Tiao","Linear",1.0],["say","avg1_112","Haha! When we cracked it open and saw ==PLAYER_NAME==, Iris thought ==SEX== was a humanoid Artifact. ==SEX1== was patting ==SEX4== down trying to find a power switch!",0,""],["ctl","avg1_111","a","016","awkward",null,null,null,null,"lengzhan","Linear",1.0],["say","avg1_111","H-Hey, keep it down! We were out of Dorra for food back then!",0,""],["ctl","avg1_103","a",null,null,null,null,null,0.0,null,"OutQuint",0.5],["hide","avg1_103",0.5],["ctl","avg1_111","a",null,null,null,null,null,0.0,null,"OutQuint",0.5],["hide","avg1_111",0.5],["stg",0,null,null,1.2,"OutQuint",1.0,null,null,null],["ctl","avg1_112","a","003","speechless",0.75,-0.12,1.2,0.9,null,"OutQuint",1.0],["bg","story_main_00_003_FP",0,1.0],["say","avg1_112","Honestly, finding ==PLAYER_NAME== in there was way better than finding an Artifact. If we hadn't met ==SEX4==, Feagin would've eaten us alive when we got back to Emor.",0,""],["ctl","avg1_112","a",null,null,null,null,null,null,null,"Linear",1.0],["show","avg1_111","a","012",0.23,-0.12,1.2,0,null,0.0],["ctl","avg1_111","a",null,"sigh",0.25,null,null,0.9,null,"OutQuint",1.0],["say","avg1_111","Yeah. It feels like a dream. After all those adventures, here we are... Right back where it all began.",0,""],["ctl","avg1_112","a",null,"happy",null,null,null,null,"tiao2","Linear",1.0],["say","avg1_112","And facing another massive crisis, too!",0,""],["stg",0,null,null,1.1,"OutQuint",1.0,null,null,null],["bg","tower_common",0,1.0],["ctl","avg1_112","a","002",null,0.5,0.0,1.0,1.0,null,"OutQuint",1.0],["ctl","avg1_111","a",null,null,0.3,0.0,1.0,1.0,null,"OutQuint",1.0],["show","avg1_103","a","003",0.7,null,null,0,null,0.0],["ctl","avg1_103","a",null,null,null,null,null,1.0,null,"OutQuint",1.0],["se","se_062"],["bgm",""],["say","avg1_112","But hey, if we made it back here, it means we can beat this. And when we set off again, we'll go even further.",0,""],["w",0.5],["ctl","avg1_111","a",null,null,null,null,null,0.0,null,"OutQuint",0.7],["hide","avg1_111",0.7],["ctl","avg1_112","a",null,null,null,null,null,0.0,null,"OutQuint",0.7],["hide","avg1_112",0.7],["ctl","avg1_103","a",null,null,null,null,null,0.0,null,"OutQuint",0.7],["hide","avg1_103",0.7],["bgm","m79"],["stg",0,null,-100.0,1.1,"OutSine",1.0,null,null,null],["say","0","Under the cover of our allies, the New Star Guild and I reach the top floor of the Desert Monolith in just over two hours.",0,""],["say","0","Aside from the unique top floor, every level in a Monolith is a tangled web of nearly identical parallel floors.",0,""],["bg","white",0,0.5],["w",0.5],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["bg","tower_inside",0,0.5],["stg",0,null,0.0,1.05,"OutSine",2.0,null,null,null],["say","0","Inside the Monolith, Floor 30 isn't a fixed location. It simply means a climber has reached the thirtieth floor's trial.",0,""],["bg","white",0,0.5],["w",0.5],["bg","tower_inside_arcade",0,0.5],["say","0","When the elevator doors open, there's no guarantee it's the same Floor 30 you saw last time. Two guilds entering back-to-back could climb all the way to the top without ever crossing paths.",0,""],["bg","white",0,0.5],["w",0.5],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["bg","tower_elevator_close",0,0.5],["stg",0,0.0,0.0,1.0,"OutSine",2.0,null,null,null],["say","0","We build our entire strategy against the Salvation Committee around this exact mechanic.",0,""],["say","0","The Monolith's elevators only hold ten people at a time, naturally funneling the enemy into isolated squads that can't support each other.",0,""],["se","se_493"],["bg","tower_elevator_unknow",0,1.0],["say","0","By entering first and securing the right blessings, we use our advantage in power and terrain to ambush them.",0,""],["bg","white",0,0.5],["w",0.5],["bg","tower_common",0,0.5],["stg",0,0.0,0.0,1.1,"OutQuint",1.0,null,null,null],["se","se_014"],["show","avg3_1311","c","009",null,null,null,0,null,0.0],["ctl","avg3_1311","c",null,null,null,null,null,1.0,null,"OutQuint",1.0],["bg","tower_wind_light",1,0.0],["w",1],["se","se_342"],["ctl","avg3_1311","b","009",null,0.75,-0.1,1.2,null,null,"OutQuint",1.0],["obj","qstory_main_007",1,null,0.54],["stage",1,0,0],["show","avg1_133","a","008",null,-0.15,1.3,1,null,null],["say","avg1_133","Boss, the interceptions on each floor are going as planned. Iris's Monolith Blessing Combo Guide is a lifesaver. Syncing our setups to her strategies gave our magic and strength a massive boost.",0,""],["ctl","avg1_133","a","015","speechless",null,null,null,null,"niunie1","Linear",1.0],["say","avg1_133","We engaged over two hundred Committee members, crushed about a hundred and fifty, and the rest retreated outside. Only Fuyuka, Chaton, and Chitose took some minor hits, but nothing serious.",0,""],["ctl","avg3_1311","b","020",null,null,null,null,null,"diantou","Linear",1.0],["ctl","avg1_133","a",null,null,null,null,null,null,null,"Linear",1.0],["se","se_077"],["say","1","Great work. So there are under a hundred enemies left inside?",0,""],["ctl","avg1_133","a","005","vexation",null,null,null,null,"lengzhan","Linear",1.0],["say","avg1_133","Yes, but they're the elites. And we still haven't caught any sign of Angie or Greyhorn.",0,""],["ctl","avg1_133","a","028","sweaty",null,null,null,null,null,"Linear",1.0],["say","avg1_133","Our spare Soul Stones are tapped out. Everyone's running on fumes.",0,""],["ctl","avg3_1311","b","014","question",null,null,null,null,null,"Linear",1.0],["say","1","Can we loot the enemy's?",0,""],["ctl","avg1_133","a","024","sigh",null,null,null,null,"niunie1","Linear",1.0],["say","avg1_133","No good. Theirs are rigged with magical seals. Cracking them would take way too long.",0,""],["ctl","avg3_1311","b","022","happy",null,null,null,null,"diantou","Linear",1.0],["say","1","Understood. You've all done an incredible job. Let's move to Phase Two. You fall back, exit the Monolith, and resupply. Leave distracting the Committee to us.",0,""],["ctl","avg1_133","a","010","attention",null,null,null,null,"diantou","Linear",1.0],["say","avg1_133","Roger that, Boss. Stay safe.",0,""],["ctl","avg3_1311","b","023",null,null,null,null,null,"diantou","Linear",1.0],["se","se_077"],["say","1","You too.",0,""],["w",0.5],["stage",1,1,1],["ctl","avg1_133","a",null,null,null,null,null,0.0,null,"OutQuint",1.0],["hide","avg1_133",1.0],["se","se_342"],["objx"],["ctl","avg3_1311","b","009",null,0.5,null,null,null,null,"OutQuint",1.0],["w",1.5],["ctl","avg3_1311","b",null,null,null,-0.3,1.6,0.0,null,"OutQuint",1.0],["hide","avg3_1311",1.0],["stg",0,null,null,1.15,"OutQuint",1.0,null,null,null],["show","avg1_112","a","021",0.5,null,null,0,null,0.0],["show","avg1_111","a","002",0.25,null,null,0,null,0.0],["show","avg1_103","a","010",0.75,null,null,0,null,0.0],["ctl","avg1_112","a",null,null,null,null,null,1.0,null,"OutQuint",1.0],["ctl","avg1_111","a",null,null,0.28,null,null,1.0,null,"OutQuint",1.0],["ctl","avg1_103","a",null,"attention",0.72,null,null,1.0,null,"OutQuint",1.0],["se","se_208"],["say","avg1_103","Boss, what about the rest? Do we go on the offensive?",0,""],["ctl","avg1_112","a",null,null,null,null,null,null,"JuGong","Linear",1.0],["se","se_128"],["say","avg1_112","One swing of my sword shoots wind blades in eight directions now! The three of us can easily take on ten of them!",0,""],["w",0.5],["mrt",1,"y","020","speechless",null],["say","avg3_100","It won't be that easy. Angie and Greyhorn are still missing, and Captain Greyhorn is formidable. Dodging Nazuka's teams might not just be luck. They might be using a specific climbing technique.",1,""],["mrt",0,"z","002",null,"diantou"],["se","se_077"],["say","avg3_100","We should play it safe. Stick to the plan and use the Monolith's terrain to outmaneuver them. We head to Floor 51: the Boss's Domain.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["stg",0,200.0,-30.0,1.25,"OutQuint",1.0,null,null,null],["ctl","avg1_112","a",null,null,null,null,null,0.0,null,"OutQuint",0.7],["ctl","avg1_103","a",null,null,null,null,null,0.0,null,"OutQuint",0.7],["ctl","avg1_111","a","005","vexation",null,null,null,null,"niunie1","OutQuint",1.0],["show","avg2_979","a","002",0.6,-0.05,1.2,0,null,0.0],["ctl","avg2_979","a",null,null,null,0.0,null,0.9,"lengzhan","OutQuint",1.0],["say","avg1_111","Ugh... Do we really have to go there?!==W== What if... What if that terrifying Stellaroid is still waiting for us?",0,""],["w",0.3],["goon"],["w",0.5],["mrt",1,"z","014","music",null],["say","avg3_100","Even if it is, we'll be fine. You said there's only one elevator up there, and the Stellaroid didn't attack until you stepped out of it.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg2_979","a",null,null,null,null,null,0.0,null,"OutQuint",0.7],["hide","avg2_979",0.7],["stg",0,0.0,0.0,1.1,"OutQuint",1.0,null,null,null],["ctl","avg1_103","a","009",null,null,null,null,1.0,null,"OutQuint",1.0],["ctl","avg1_112","a","010","flurry",null,null,null,1.0,null,"OutQuint",1.0],["say","avg1_112","Yeah. It only showed up when we tried to open the Wishing Box. Maybe it's just guarding it.",0,""],["w",0.5],["mrt",1,"z","023",null,"diantou"],["se","se_077"],["say","avg3_100","That's all we need. If we don't touch the Wishing Box, the Boss's Domain becomes a safe house that only we control.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_103","a","007","idea",null,null,null,null,"lengzhan","Linear",1.0],["say","avg1_103","We pop out to hit Angie. But she can't hit us.",0,""],["w",0.5],["mrt",1,"z","013",null,"JuGong"],["se","se_238"],["say","avg3_100","Exactly. Even if Angie knows how to repeat history, it won't matter. With only one elevator in the Boss's Domain, choking them out will be effortless.",1,""],["ctl","avg1_111","a","015",null,null,null,null,null,null,"Linear",1.0],["ctl","avg1_112","a","006",null,null,null,null,null,null,"Linear",1.0],["mrt",0,"z","020","speechless",null],["say","avg3_100","Nazuka's team keeps their blessings even outside the Monolith. We just hold the line until they resupply and return. Then, the Salvation Committee is completely out of options.",1,""],["mrt",0,"y","003",null,"diantou"],["se","se_077"],["say","avg3_100","Let's head up and see if that giant Stellaroid is still around. We'll iron out the details after.",1,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_111","a","004",null,0.5,-0.1,1.2,null,null,"OutQuint",1.0],["stg",0,0.0,0.0,1.0,"OutQuint",1.0,null,null,null],["ctl","avg1_112","a","014",null,0.35,0.03,0.9,null,null,"OutQuint",1.0],["ctl","avg1_103","a","010",null,0.65,0.03,0.9,null,null,"OutQuint",1.0],["se","se_062"],["bgm",""],["say","avg1_111","Alright. Time to repeat history.",0,""],["w",0.5],["trn",0,1,false,false,0.3],["w",0.3],["se","se_416"],["say","0","O God of Grace, please… Please let us find an absurdly huge Wishing Box!",8,""],["ctl","avg1_112","a",null,null,null,null,null,0.0,null,"Linear",0.0],["ctl","avg1_111","a",null,null,null,null,null,0.0,null,"Linear",0.0],["ctl","avg1_103","a",null,null,null,null,null,0.0,null,"Linear",0.0],["bg","story_main_00_005",0,0.0],["w",0.5],["fx",0,"fx_avg_reminiscence_loop",0,0],["se","se_169"],["trn",1,1,false,false,0.5],["w",2.0],["se","se_169"],["bg","white",0,0.5],["w",0.5],["bg","story_main_00_006",0,0.5],["w",2.0],["se","se_169"],["