ll,null,null,null,null,null,null,"OutQuart",1.0],["ctl","avg1_111","a","009","question",null,null,null,null,null,"OutQuart",1.0],["say","avg1_111","What is it, Noya?",0,""],["w",0.5],["ctl","avg1_103","a","015",null,null,null,null,null,null,"OutQuart",1.0],["ctl","avg1_111","a",null,null,null,null,null,null,null,"OutQuart",1.0],["se","se_062"],["ctl","avg1_112","g",null,"speechless",0.73,-0.1,1.2,null,null,"OutQuart",1.0],["bgm",""],["say","avg1_112","The Fry Girl... She vanished.",0,""],["w",0.5],["se","se_076"],["trn",0,2,true,true,1.0],["w",1.5],["bg","mirage_creche_inside_daylight",0,0.0],["cbg",0,null,null,1.1,"Linear",0.0,null,null,null],["stg",0,null,null,1.15,"Linear",0.0,null,null,null],["stg",0,null,null,1.1,"OutCubic",3.5,null,null,null],["trn",1,2,false,false,1.0],["w",1.0],["bgm","m53"],["head","15:40, Nebula Month 18th, Mirage, The Daisy Orphanage"],["w",0.5],["show","avg1_112","g","003",null,null,1.0,0,null,0.0],["ctl","avg1_112","g","003","speechless",null,-0.02,1.05,1.0,null,"OutQuart",1.0],["say","avg1_112","So that is what happened.==W== That Grace Imperium lady called herself the Fry Girl,==W== but honestly? Fry Weirdo fits way better.",0,""],["w",0.7],["ctl","avg1_112","g","005",null,0.7,null,null,null,null,"OutQuart",1.0],["se","se_236"],["show","avg1_150","a","002",0.25,-0.3,1.5,0,null,0.0],["ctl","avg1_150","a",null,null,0.35,null,null,0.9,null,"OutQuart",1.0],["goon"],["w",0.7],["ctl","avg1_150","a","023",null,null,null,null,null,null,"Linear",1.0],["ctl","avg1_112","g","004","music",null,null,null,null,"daintou","Linear",1.0],["goon"],["w",0.5],["ctl","avg1_150","a",null,null,0.3,null,null,0.0,null,"OutCubic",1.0],["obj","qstory_main_09_002",1,0.35,null],["ctl","avg1_112","g","002",null,null,null,null,null,"diantou","OutQuint",1.0],["se","se_345"],["say","avg1_112","But she's definitely on our side. After we finished the fries she sent us, we found a message written all over the inside of the boxes.",0,""],["w",0.5],["ctl","avg1_112","g","005","happy",null,null,null,null,null,"Linear",0.5],["say","avg1_112","She even protected the ink from grease with rice paper.",0,""],["w",0.5],["mrt",1,"y","021","think",null],["say","avg3_100","No, she must have intended not to let the ink ruin her fries. Priorities.",2,""],["mrt",3,"y",null,null,null],["w",0.5],["ctl","avg1_112","g",null,null,0.9,null,null,0.0,null,"OutQuart",1.0],["hide","avg1_112",1.0],["cbg",0,null,null,1.15,"OutQuart",1.0,null,null,null],["objx"],["se","se_345"],["say","0","Three flattened fry boxes sit on the table before me. The cardboard is packed with neat handwriting detailing troop counts, defensive layout, and key personnel.",8,""],["w",0.5],["say","0","At the very bottom sits a tiny signature: Bastelina.",8,""],["w",0.5],["show","avg3_100","c","003",null,-0.5,null,0,null,0.0],["ctl","avg3_100","c",null,"think",null,0.0,null,1.0,null,"OutBack",0.8],["say","avg3_100","This is what Bastelina and Laru gathered when they went undercover in the Committee.",0,""],["w",0.5],["ctl","avg3_100","c","012","attention",null,null,null,null,null,"Linear",1.0],["say","avg3_100","It says ...==W== they got their phones confiscated and lost their contacts. They couldn't reach Albedo, so they smuggled this to us instead. They want us to make it out alive.",0,""],["w",0.7],["goon"],["w",0.5],["ctl","avg3_100","c",null,null,null,null,null,null,"diantou","Linear",1.0],["se","se_077"],["say","avg3_100","We already figured some of this out... The three divisions, the elite sniper with Angie, the artillery camp outside the city.",0,""],["w",0.5],["bgm",""],["ctl","avg3_100","c",null,null,null,-0.1,1.2,null,null,"OutQuart",1.0],["se","se_345"],["say","avg3_100","But there's still a ton of solid intel here. Take this one...",0,""],["w",0.5],["bgm","m42"],["ctl","avg3_100","c",null,null,null,-0.5,null,0.0,null,"InBack",0.8],["hide","avg3_100",0.8],["se","se_061"],["w",0.5],["stg",0,null,null,1.15,"OutCubic",1.5,null,null,null],["show","avg3_152","a","004",0.75,-0.4,1.5,0,null,0.0],["w",0.5],["ctl","avg3_152","a","004",null,0.7,null,null,0.9,null,"OutQuart",1.0],["se","se_022"],["se","se_049"],["show","avg1_163","a","002",0.2,null,1.0,0,null,0.0],["ctl","avg1_163","a",null,null,0.3,null,null,0.9,"diantou","OutCubic",1.0],["w",1],["say","0","Greyhorn. A Knight Commander of the Imperial Guard. She is not a Committee member. She is only assisting Director Angie on orders from a superior.==P== She gives it her all in battles, but she will not needlessly pursue you or your allies.",10,""],["w",0.5],["se","se_022_stop"],["ctl","avg1_163","a",null,null,0.2,null,null,0.0,null,"OutCubic",1.0],["hide","avg1_163",1.0],["mrt",1,"z","002","attention",null],["say","avg3_100","And this part...",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_152","a","012",null,null,null,null,null,null,"Linear",0.5],["se","se_022"],["se","se_055"],["show","avg3_217","a","002",0.2,null,1.0,0,null,0.0],["ctl","avg3_217","a",null,null,0.3,null,null,0.9,null,"OutCubic",1.0],["say","0","No. 160, one of the Dusk Arbiters. She seemingly experienced severe childhood trauma and carries deep psychological scars.==P== She displays masochistic tendencies, but this is merely a trigger. She uses pain to recall her trauma, which freezes time itself all around her.==P== But this magic doesn't actually stop time. It just forcibly uses magic power to restrict the movement of anything within a certain range around her that she can see.",10,""],["w",0.5],["se","se_125"],["ctl","avg3_152","a","009",null,null,null,null,null,"lengzhan2","Linear",1.0],["say","0","The more pain and fear she endures, the further and longer she can freeze everything around her.==P== She's not much of a fighter physically, but that dagger of hers is the real threat. A single cut plants \"Fear\" in her victims, forcing them to confront their worst nightmares, leaving them defenseless.==P== Additionally, No. 160 is a former inter-city operator. She can intercept Heartlink comms within a certain radius. Please use your phones cautiously.",10,""],["w",0.5],["se","se_022_stop"],["ctl","avg3_217","a",null,null,0.2,null,null,0.0,null,"OutCubic",1.0],["mrt",1,"y","020","think",null],["say","avg3_100","So her magic really is stopping time. The more she suffers, the longer it lasts... That explains why she took Fuyuka's punch on purpose.",2,""],["w",0.5],["se","se_077"],["mrt",0,"y","003",null,"diantou"],["say","avg3_100","Firenze is right to be cautious. Someone in the Salvation Committee really can tap into our Heartlinks. If Nazuka and Chitose give away their location, they won't be able to swoop in and bail us out.",2,""],["w",0.5],["mrt",0,"y","002","attention",null],["say","avg3_100","Hmm, there's more...",2,""],["mrt",3,"y",null,null,null],["w",0.5],["se","se_022"],["se","se_049"],["show","avg1_136","a","002",0.2,null,1.0,0,null,0.0],["ctl","avg1_136","a",null,null,0.3,null,null,0.9,null,"OutCubic",1.0],["ctl","avg3_152","a","007",null,null,null,null,null,null,"Linear",0.5],["say","0","Director Angie is an amateur.==P== She lacks both tactical and magical expertise.==P====W== However, she commands loyalty from the Committee because she will sacrifice absolutely anything to save the world, which means killing you.",10,""],["w",0.5],["se","se_125"],["ctl","avg3_152","a","018",null,null,null,null,null,"JuGong","Linear",1.0],["goon"],["w",0.5],["se","se_022_stop"],["ctl","avg3_152","a","006",null,null,null,null,null,null,"Linear",0.5],["se","se_177"],["say","0","Please be extremely careful.",8,""],["w",0.5],["ctl","avg1_136","a",null,null,0.2,null,null,0.0,null,"OutCubic",1.0],["hide","avg1_136",1.0],["ctl","avg3_152","a",null,null,0.75,null,null,0.0,null,"OutCubic",1.0],["stg",0,null,null,1.1,"OutCubic",1.5,null,null,null],["w",1],["show","avg3_100","c","009",null,-0.5,1.2,0,null,0.0],["ctl","avg3_100","c","009","speechless",null,-0.05,null,1.0,null,"OutBack",0.8],["say","avg3_100","Sacrifice anything to kill me, huh?==W== Why is she so convinced the Tyrant will end the world?==W== I wonder if I can drag some answers out of her during the negotiations.",0,""],["w",1.0],["ctl","avg3_100","c","010","vexation",null,null,null,null,"niunie","Linear",1.0],["goon"],["w",1.0],["ctl","avg3_100","c","005","sigh",null,null,null,null,"JuGong","Linear",1.0],["bgm",""],["goon"],["w",0.5],["show","avg1_112","g","002",0.7,-0.13,1.35,0,null,0.0],["ctl","avg1_112","g","024",null,0.6,null,1.25,1.0,null,"OutCubic",1.0],["ctl","avg3_100","a","023",null,0.42,-0.12,1.15,null,null,"OutCubic",1.0],["say","avg3_100","Anyway, this intel is huge. You did great.==W== Once we clear this mess, we owe Bastelina and Laru big time.",0,""],["w",0.7],["bgm","m113"],["ctl","avg3_100","a","013","happy",null,null,null,null,"diantou","Linear",1.0],["goon"],["w",0.5],["stg",0,null,null,1.15,"OutCubic",1.0,null,null,null],["se","se_065"],["ctl","avg1_112","g","004","music",null,null,1.15,null,null,"OutQuart",1.0],["say","avg1_112","Hehe. See? Taking a hit had its perks.",0,""],["w",0.5],["stg",0,null,null,1.1,"OutBack",0.8,null,null,"Zhong"],["ctl","avg1_112","g","015",null,0.65,null,null,null,null,"OutBack",0.8],["ctl","avg3_100","a","007",null,0.35,null,null,null,null,"OutBack",0.8],["se","se_070"],["say","avg3_100","Whoa, Noya, personal space! Your nose is practically touching mine.",0,""],["w",0.5],["stg",0,null,null,1.15,"OutCubic",1.0,null,null,null],["ctl","avg3_100","a","010","sigh",null,null,null,null,"JuGong","OutCubic",1.0],["ctl","avg1_112","g","027",null,null,null,null,null,null,"OutCubic",1.0],["say","avg3_100","And don't say that. There is zero perk to getting hurt. Just looking at that gash makes me wince.",0,""],["w",0.5],["ctl","avg3_100","a","003","attention",null,null,null,null,null,"Linear",1.0],["say","avg3_100","If you mean the intel, Laru and Bastelina would've found a way to deliver it even if you were fine.",0,""],["w",0.5],["ctl","avg3_100","a","012",null,null,-0.8,null,0.0,null,"InBack",0.8],["hide","avg3_100",0.8],["se","se_061"],["w",0.8],["stg",0,null,null,1.05,"OutQuart",1.0,null,null,null],["cbg",0,50.0,null,null,"OutQuart",1.0,null,null,null],["ctl","avg1_112","g","003","happy",0.5,null,null,null,null,"OutQuart",1.0],["say","avg1_112","I wasn't talking about the intel.",0,""],["w",0.5],["ctl","avg1_112","g","020",null,null,-0.15,1.2,null,null,"OutQuart",1.0],["se","se_062"],["say","avg1_112","It's been so, so long since I could just watch your profile while you're hard at work.",0,""],["w",0.5],["mrt",2,"z","015","question",null],["say","avg3_100","Wh-What's so great about my profile?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_112","g","003","sigh",null,null,null,null,null,"Linear",0.5],["say","avg1_112","I don't know. I just like looking at it.",0,""],["w",0.5],["choice",["Sit next to Noya"],[[]]],["w",0.5],["stg",0,null,-50.0,1.3,"OutBack",0.8,null,null,"jushou"],["ctl","avg1_112","g","015",null,null,-0.145,1.18,null,null,"OutBack",0.8],["w",0.2],["se","se_019"],["mrt",1,"z","002",null,null],["say","avg3_100","Here. Stare all you want. Special treatment for the patient.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_112","g","028","flurry",null,null,null,null,"lengzhan2","Linear",0.5],["say","avg1_112","Ah! If you sit right next to me, my angles are all messed up!==W== No, no, the whole vibe is gone!",0,""],["w",1.0],["ctl","avg1_112","g",null,"vexation",null,null,null,null,"niunie","Linear",1.0],["goon"],["w",0.5],["mrt",1,"z","013","happy",null],["say","avg3_100","Pfft...==W== You're sentimental today.==W== Iris was right. You're not acting like yourself at all.",1,""],["w",0.5],["ctl","avg1_112","g","015",null,null,null,null,null,null,"Linear",1.0],["mrt",0,"z","002",null,null],["goon"],["w",0.7],["mrt",0,"z","022",null,null],["goon"],["w",0.5],["mrt",0,"z","023","music",null],["say","avg3_100","Usually, if you wanted to stare, you'd just tackle me and press your face right against mine.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_112","g","022","resentful",null,null,null,null,"daintou","Linear",0.5],["say","avg1_112","Hey! Stop making me sound like a puppy greeting its owner!",0,""],["w",0.5],["ctl","avg1_112","g","027","sigh",null,null,null,null,"JuGong","Linear",0.5],["say","avg1_112","Sigh... It's all because of this awful gut feeling. It's making me anxious.",0,""],["w",0.5],["mrt",1,"z","012","symbol",null],["say","avg3_100","Huh? The overwhelmingly cheerful Noya is anxious?",1,""],["w",0.5],["mrt",0,"z","003","question",null],["say","avg3_100","What is this gut feeling telling you?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["cbg",0,null,null,1.05,"OutCubic",3.0,null,null,null],["ctl","avg1_112","g","026",null,null,-0.19,1.25,null,null,"OutCubic",3.0],["se","se_055"],["bgm",""],["say","avg1_112","...==W== Ever since we left the White Cat's secret room... I've had this heavy premonition...",0,""],["w",1.0],["goon"],["w",0.5],["ctl","avg1_112","g","014",null,null,null,null,null,null,"Linear",0.5],["say","0","That today ... is the day you leave us.",8,""],["w",0.5],["trn",0,0,false,false,2.0],["w",2.0],["end"]]}