_009_FP",0,null,null],["w",1.0],["say","0","And so, we end up tightly bound by Amber's string of fate for quite a while before she finally unties us.",0,""],["w",0.5],["trn",0,0,false,false,1.0],["w",1.0],["objx"],["w",1.0],["bg","mirage_street_daylight",0,0.5],["w",0.5],["se","se_060"],["cbg",0,null,null,1.1,"Linear",1.0,null,null,null],["trn",1,0,false,false,0.5],["w",0.5],["say","0","Then, we head to the Eureka Bar for our final meeting before the negotiation.",0,""],["w",0.5],["trn",0,0,false,false,1.0],["w",1.0],["stg",0,100.0,null,1.1,"Linear",0.5,null,null,null],["w",0.5],["bg","mirage_eyphkabar_inside_daylight",0,0.5],["w",0.5],["se","se_093"],["trn",1,0,false,false,1.0],["w",1.0],["head","16:15, Nebula Month 18th, Mirage, Eureka Bar"],["w",0.5],["se","se_345"],["obj","qstory_main_09_008",0,null,null],["w",1.0],["bgm","m59"],["mrt",1,"z","020",null,null],["say","avg3_100","According to the intel Laru sent us, the arbiter we fought earlier, No. 160, really can eavesdrop on Heartlink communications within a certain range.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["objx"],["w",0.5],["stg",0,0.0,null,null,"Linear",2.0,null,null,null],["show","avg1_108","a","002",0.38,null,null,0,null,0.0],["show","avg1_133","a","002",0.6,null,null,0,null,0.0],["show","avg1_144","a","002",0.8,null,null,0,null,0.0],["show","avg1_114","a","002",0.2,null,null,0,null,0.0],["ctl","avg1_114","a","002",null,null,null,null,1.0,null,"OutSine",0.5],["w",0.3],["ctl","avg1_108","a","002",null,null,null,null,1.0,null,"OutSine",0.5],["w",0.3],["ctl","avg1_133","a","002",null,null,null,null,1.0,null,"OutSine",0.5],["w",0.3],["ctl","avg1_144","a","002",null,null,null,null,1.0,null,"OutSine",0.5],["w",0.5],["mrt",1,"z","002",null,null],["say","avg3_100","So, to avoid any leaks, I thought it best to gather everyone here and map out our next steps face-to-face.",1,""],["stg",0,50.0,-50.0,1.2,"OutCubic",1.0,null,null,null],["mrt",0,"z","002","attention",null],["say","avg3_100","Captain Kasimira, please update us on the evacuation status.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_114","a","025",null,null,null,null,null,"xuanyun","Linear",0.5],["ctl","avg1_133","a","004",null,null,null,null,null,null,"Linear",0.5],["ctl","avg1_144","a","005",null,null,null,null,null,null,"Linear",0.5],["se","se_075"],["ctl","avg1_108","a","005",null,null,-0.15,1.2,null,null,"OutCubic",0.5],["say","avg1_108","Good news. Chaton found an abandoned mineshaft leading to the Monolith outside the city. A few sections are blocked by rubble,==W== but luckily, we found a very capable helper—",0,""],["w",0.5],["ctl","avg1_108","a","007","music",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["bgm",""],["trn",0,0,true,false,1.0],["w",1.0],["stg",0,0.0,0.0,1.1,"Linear",0.0,null,null,null],["bg","mine_inside_2",0,0.5],["w",0.5],["trn",1,0,false,false,1.0],["w",1.0],["bgm",""],["stg",0,null,null,null,"Linear",1.0,null,null,"Xiao"],["show","avg1_142","a","006",0.4,-0.05,1.1,0,null,0.0],["fx",0,"fx_avg_dust_light",0,2],["se","se_225"],["ctl","avg1_142","a",null,null,0.4,null,null,1.0,"JuGong","OutCubic",0.5],["w",1.0],["ctl","avg1_142","a","021","sigh",null,null,null,null,"chijing","Linear",0.5],["w",0.5],["say","avg1_142","Phew, the rubble over here is all cleared out. I'm exhausted. And I'm so thirsty.",0,""],["w",0.5],["ctl","avg1_142","a","022","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_142","What's going on with this city? All these Sentinels of Dawn showed up out of nowhere...==W== I'll worry about capturing the Boss later. For now, I need to blend in with the locals and get out of here!",0,""],["w",0.5],["se","se_030"],["ctl","avg1_142","a","026",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["bgm","m28"],["stg",0,-120.0,null,1.2,"OutCubic",0.5,null,null,null],["show","avg1_146","a","007",0.8,0.1,0.8,0,null,0.0],["ctl","avg1_146","a",null,"exclamation",0.75,null,null,1.0,null,"OutCubic",0.5],["ctl","avg1_142","a","002",null,null,null,null,null,null,"Linear",0.5],["say","avg1_146","Wow, Cosette, you're incredible!==W== Ten of us spent an hour clearing a boulder about that size and still couldn't get it done.",0,""],["w",0.5],["ctl","avg1_146","a","008",null,null,-0.05,1.1,null,"jushou2","OutCubic",0.5],["goon"],["w",0.5],["ctl","avg1_142","a","014","happy",null,null,null,null,"xuanyun","Linear",0.5],["say","avg1_142","Hehe, I'm pretty good at digging.",0,""],["w",0.5],["se","se_348"],["ctl","avg1_146","a","016",null,0.65,null,null,null,"JuGong1","Linear",0.5],["say","avg1_146","You must be thirsty. Here, have some sweet cactus tea.",0,""],["w",0.5],["stg",0,0.0,null,null,"OutCubic",0.5,null,null,null],["ctl","avg1_142","a","016","attention",null,null,null,null,null,"Linear",0.5],["w",1.0],["se","se_284"],["ctl","avg1_142","a","018",null,null,null,null,null,"JuGong1","Linear",0.5],["w",1.0],["se","se_284"],["ctl","avg1_142","a",null,null,null,null,null,null,"JuGong1","Linear",0.5],["say","avg1_142","Gulp... Gulp...==W== Ahhh! I've got my energy back! I'll go clear the rocks up ahead!",0,""],["w",0.5],["ctl","avg1_142","a","007","star",null,null,null,null,"jushou2","Linear",0.5],["goon"],["w",0.5],["se","se_065"],["ctl","avg1_142","a",null,null,0.1,null,null,0.0,null,"OutCubic",0.5],["trn",0,0,true,false,1.0],["w",1.0],["bg","mirage_eyphkabar_inside_daylight",0,0.5],["w",0.5],["stg",0,100.0,0.0,1.1,"Linear",0.0,null,null,null],["trn",1,0,false,false,1.0],["w",1.0],["bgm",""],["show","avg1_108","a","007",0.45,null,null,0,null,0.0],["ctl","avg1_108","a",null,"music",null,null,null,1.0,null,"Linear",0.5],["w",0.5],["say","avg1_108","With her help, the route to the Monolith should be fully cleared by 17:00 at the latest. If the citizens evacuate through this tunnel, they can all be out of the combat zone within three hours.",0,""],["w",0.5],["bgm",""],["mrt",1,"z","012","speechless",null],["say","avg3_100","Good. Then my minimum objective is to keep the negotiation going until at least 17:00.==W== If we can delay Angie and the Salvation Committee until 20:00, we'll have enough time to withdraw.",1,""],["w",0.5],["mrt",0,"z","020","idea",null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["stg",0,-150.0,null,1.2,"OutCubic",0.8,null,null,null],["show","avg1_133","a","002",0.7,0.05,0.9,0,null,0.0],["ctl","avg1_133","a",null,null,null,null,null,1.0,null,"OutCubic",0.5],["ctl","avg1_108","a",null,null,0.35,-0.15,1.2,0.0,null,"OutQuint",1.0],["mrt",1,"z","002","question",null],["say","avg3_100","Nazuka, any movement from the Salvation Committee?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_146"],["ctl","avg1_133","a","029",null,null,null,null,null,"lengzhan","Linear",0.5],["w",1.0],["bgm","m79"],["ctl","avg1_133","a","023",null,0.6,-0.1,1.1,null,null,"OutCubic",0.5],["say","avg1_133","Only bad news on my end. Based on my recon, the Salvation Committee has taken control of the Desert Scorpions and local Imperial Guard.",0,""],["w",0.5],["chd",0,2,"avg1_112","g","006","question"],["say","avg1_112","Weren't they already under the Committee's control? They were in the forces we countercharged earlier.",0,""],["w",0.5],["chd",0,0,"avg1_103","b","012","vexation"],["say","avg1_103","And Hazana's sandstorm.",0,""],["w",0.5],["chd",1,0,"avg1_103","a","002",null],["chd",1,2,"avg1_112","a","002",null],["ctl","avg1_133","a","016","sigh",null,null,null,null,null,"Linear",0.5],["say","avg1_133","At the time, neither the Desert Scorpions nor the Imperial Guard had mobilized on a large scale. Those were likely individual actions, or the Committee's sleeper agents.",0,""],["show","avg3_207","a","008",0.3,-0.15,1.4,0,null,0.0],["ctl","avg3_207","a",null,null,null,null,null,0.6,null,"OutCubic",0.5],["ctl","avg1_133","a","028",null,null,null,null,null,null,"Linear",0.5],["say","avg1_133","But half an hour ago, the Committee stormed both camps and arrested anyone who resisted. I even saw Myrsha tied up.",0,""],["ctl","avg3_207","a",null,null,null,null,null,0.0,null,"Linear",0.5],["hide","avg3_207",0.5],["se","se_176"],["ctl","avg1_133","a","019",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_133","So they weren't fully compliant before. Regardless, with both forces added to its ranks, the Committee can now command around a thousand soldiers.",0,""],["w",0.5],["stg",0,0.0,null,null,"OutCubic",1.0,null,null,null],["show","avg1_111","a","005",0.3,0.03,0.9,0,null,0.0],["ctl","avg1_111","a","005","speechless",null,null,null,1.0,null,"Linear",0.5],["say","avg1_111","A...==W== A thousand?==W== Even with the White Cats, we only have sixty or seventy people...",0,""],["w",0.5],["stg",0,null,null,null,"Linear",1.0,null,null,"Xiao"],["ctl","avg1_133","a","024",null,null,null,null,null,null,"Linear",0.5],["ctl","avg1_111","a","006","symbol",null,null,null,null,"chijing","Linear",0.5],["goon"],["w",1.0],["ctl","avg1_111","a","007","flurry",null,null,null,null,"diantou2","Linear",0.5],["goon"],["w",0.5],["ctl","avg1_133","a",null,null,0.65,-0.15,1.2,0.0,null,"OutCubic",0.5],["stg",0,250.0,-50.0,1.3,"OutCubic",1.0,null,null,null],["w",1.0],["mrt",2,"z","022",null,null],["say","avg3_100","Don't worry, Iris. They were thrown together at the last minute, so their command structure is bound to be disorganized. Our goal is to escape, so their sheer numbers might actually work to our advantage.",1,""],["mrt",0,"z","002","question",null],["say","avg3_100","The orphanage still has some Imperial Guard armor and Desert Scorpion uniforms, right?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_111","a","010",null,0.4,null,null,null,null,"OutCubic",0.5],["say","avg1_111","Y-Yes, we do. The kids scavenged some armor, and the Scorpions sometimes bring us clothes to mend. We have a few pieces left.",0,""],["w",0.5],["mrt",1,"z","014","music",null],["say","avg3_100","We'll bring them along. Once night falls, we'll put them on and blend in with their squads. That'll make it harder for the Committee to find us.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["chd",0,0,"avg1_103","c","006","attention"],["say","avg1_103","Good plan. I'll get the clothes.",0,""],["w",0.5],["chd",1,0,"avg1_103","a","002",null],["mrt",1,"z","002",null,null],["say","avg3_100","How is the children's evacuation going?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_029"],["ctl","avg1_111","a","013",null,null,null,null,null,"diantou2","Linear",1.0],["w",1.0],["trn",0,0,true,false,0.5],["w",0.5],["bg","mine_inside",0,0.5],["w",0.5],["film",0],["stg",0,null,0.0,null,"Linear",1.0,null,null,null],["trn",1,0,false,false,0.5],["w",0.5],["show","avg1_139","a","027",0.65,0.1,0.9,0,null,0.0],["show","avg3_168","a","002",0.55,0.05,0.9,0,null,0.0],["show","avg3_170","a","002",0.42,0.05,-0.9,0,null,0.0],["stg",0,null,-100.0,null,"Linear",0.0,null,null,null],["ctl","avg1_139","a",null,null,null,null,null,1.0,null,"Linear",0.5],["ctl","avg3_168","a",null,null,null,null,null,1.0,null,"Linear",0.5],["ctl","avg3_170","a",null,null,null,null,null,1.0,null,"Linear",0.5],["w",0.5],["say","avg1_111","Mom has organized the children and has them waiting in the mineshaft.==W== Fuyuka and Nazuna are helping her.",0,""],["w",0.5],["show","avg1_156","a","002",0.2,0.2,0.8,0,null,0.0],["show","avg1_134","a","002",0.0,0.2,0.8,0,null,0.0],["show","avg3_167","a","006",0.2,0.1,0.8,0,null,0.0],["ctl","avg3_167","a",null,null,0.3,0.05,0.9,1.0,null,"Linear",0.5],["ctl","avg1_134","a",null,null,0.1,0.15,0.9,1.0,null,"Linear",0.5],["ctl","avg1_156","a",null,null,0.25,0.15,0.9,1.0,null,"Linear",0.5],["w",0.5],["goon"],["w",0.5],["trn",0,0,true,false,0.5],["w",0.5],["bg","mirage_eyphkabar_inside_daylight",0,0.5],["w",0.5],["stg",0,250.0,-50.0,1.3,"Linear",0.0,null,null,null],["film",1],["trn",1,0,false,false,0.5],["w",0.5],["show","avg1_111","a","013",0.4,null,null,0,null,0.0],["ctl","avg1_111","a",null,null,null,null,null,1.0,null,"OutCubic",0.5],["w",0.5],["mrt",1,"z","012",null,null],["say","avg3_100","Once we're done here, Iris, take Amber and go help them. Kasimira will need all the help she can get to evacuate Mirage's citizens.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["stg",0,null,null,null,"Linear",1.0,null,null,"Xiao"],["ctl","avg1_111","a","007","shock",null,-0.3,1.4,null,null,"OutCubic",0.3],["say","avg1_111","What about you? Negotiating with Angie is incredibly dangerous.",0,""],["w",0.5],["mrt",1,"z","022",null,null],["say","avg3_100","Noya, Chitose, and Nazuka will protect me. When it comes to making a getaway, a crowd would only make things harder.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["stg",0,null,null,1.2,"OutCubic",0.5,null,null,null],["show","avg1_112","a","004",0.0,0.05,0.9,0,null,0.0],["show","avg1_144","a","012",0.7,0.05,0.9,0,null,0.0],["ctl","avg1_112","a",null,"music",0.15,null,null,1.0,null,"OutCubic",0.5],["se","se_434"],["ctl","avg1_144","a",null,null,0.65,null,null,1.0,null,"OutCubic",0.5],["w",0.5],["ctl","avg1_144","a",null,null,null,null,null,null,"JuGong1","Linear",1.0],["w",1.0],["ctl","avg1_111","a","012",null,null,null,null,null,null,"OutCubic",0.5],["say","avg1_111","O-Okay.",0,""],["w",0.5],["clear",1,0.5,1],["mrt",1,"z","009",null,null],["say","avg3_100","And finally...==W== The great Chaton.",1,""],["w",0.5],["stg",0,null,null,1.3,"OutCubic",1.0,null,null,null],["show","avg1_114","a","019",0.5,null,null,0,null,0.0],["ctl","avg1_114","a",null,null,null,null,null,1.0,null,"Linear",0.5],["mrt",0,"z","002","attention",null],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_114","a","002","question",0.45,null,null,null,null,"OutCubic",0.5],["say","avg1_114","Oho! Boss, calling me \"the great Chaton\"!==W== Have you finally acknowledged my dark power?",0,""],["w",0.5],["se","se_305"],["ctl","avg1_114","b","011",null,0.35,-0.05,1.1,null,null,"OutQuad",0.5],["goon"],["w",0.5],["mrt",1,"z","013","love",null],["say","avg3_100","I have an extremely important task for you, one that only someone with dark powers can handle.",1,""],["mrt",0,"z","012","exc