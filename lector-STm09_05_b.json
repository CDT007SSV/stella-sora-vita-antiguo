ull,null,null,null,null,"OutQuint",1.0],["bgm","m42"],["say","avg3_100","Bastelina, you're awake! How's your injury? You lost so much blood, are you feeling okay?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_108","a",null,null,null,null,null,0.0,null,"OutQuint",0.7],["hide","avg1_108",0.7],["ctl","avg3_152","a","007","flower",0.5,0.0,1.0,null,"JuGong","OutQuint",1.0],["say","avg3_152","Heheh, Boss is worried about me.",0,""],["ctl","avg3_152","a","010","happy",null,null,null,null,"niunie1","Linear",1.0],["say","avg3_152","I'm feeling alright! The wound looked worse than it actually was. I just caught a magic blast and bled a bit more than usual. Director Allie patched me right up.",0,""],["say","avg3_152","She sealed the cut with some miracle glue. Said it wouldn't even leave a scar.",0,""],["ctl","avg3_152","a","019",null,null,null,null,null,"JuGong","Linear",1.0],["bg","mood_1",0,0.5],["stg",0,null,30.0,1.2,"OutQuint",0.7,null,null,null],["se","se_084"],["fx",0,"fx_avg_congr",0,0],["say","avg3_152","Thank goodness. Soul Shop clerks have to attend banquets every now and then. Now I don't have to worry about scaring people away in a backless dress! I remain the perfect, adorable Bastelina.",0,""],["w",0.5],["mrt",1,"z","025","exclamation",null],["say","avg3_100","You caught a magic blast?==W== Who did that?",1,""],["bg","mood_3",0,0.5],["ctl","avg3_152","a","009",null,null,null,null,null,"lengzhan","Linear",1.0],["w",0.3],["goon"],["mrt",3,"z",null,null,null],["w",0.5],["stg",0,null,0.0,1.05,"OutQuint",1.0,null,null,null],["bg","mirage_street_daylight_tower",0,0.5],["ctl","avg3_152","a","018","sigh",null,null,null,null,null,"Linear",1.0],["say","avg3_152","Actually... It was friendly fire.",0,""],["ctl","avg3_152","a",null,"speechless",null,null,null,null,"niunie1","Linear",1.0],["say","avg3_152","The Committee was using magic to level the houses on the outskirts of Mirage to clear their firing lines. I got caught in the crossfire sneaking over here.",0,""],["ctl","avg3_152","a","017","attention",null,null,null,null,null,"Linear",1.0],["say","avg3_152","Anyway, that's not important. Boss, you need to run.",0,""],["ctl","avg3_152","a","014","sigh",null,null,null,null,"diantou","Linear",1.0],["stg",0,null,20.0,1.1,"OutQuint",1.0,null,null,null],["say","avg3_152","Capturing Lady Angie didn't stop the Committee. It actually made them more dangerous.",0,""],["w",0.5],["mrt",1,"z","025","question",null],["say","avg3_100","Because ... they swapped commanders? But with Angie captured, why are they still fighting?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg3_152","a","018",null,null,null,null,null,"niunie","Linear",1.0],["se","se_208"],["say","avg3_152","You misunderstood the Committee. To outsiders, they might look like a bunch of lunatics obsessed with the Book of Grace Prophecies, but they aren't Lady Angie's private army.",0,""],["se","se_226"],["ctl","avg3_152","a","008",null,null,null,null,null,"diantou","Linear",1.0],["say","avg3_152","After Laru and I infiltrated them, we realized their motivation to save the world is genuine. They each have an unwavering reason and the sheer willpower to stop the end of the world...",0,""],["bgm",""],["w",0.5],["trn",0,0,false,false,1.0],["w",1.0],["clear",1,0,1],["bg","desert_2_notower_daylight",0,0.0],["w",1],["trn",1,0,false,false,1.0],["stg",0,200.0,0.0,1.05,"Linear",0.0,null,null,null],["show","avg3_216","a","004",0.3,null,null,0,null,0.0],["fx",0,"fx_avg_sand_lp",0,0],["se","se_036"],["bgm","m14"],["head","18:15, Nebula Month 18th, Mirage, Desert Outside the City"],["show","avg1_163","c","002",0.8,null,null,0,null,0.0],["ctl","avg3_216","a",null,null,null,null,null,1.0,null,"OutQuint",1.0],["ctl","avg1_163","c",null,null,0.7,null,null,1.0,null,"OutQuint",1.0],["stg",0,0.0,null,null,"OutQuint",1.0,null,null,null],["se","se_062"],["say","avg1_163","Gunhild, what is the status of our advance?",0,""],["ctl","avg3_216","a","005",null,null,null,null,null,"diantou","Linear",1.0],["se","se_077"],["say","avg3_216","Your tactics are working. We divided our remaining forces into twenty-five combat squads. Five are guarding the camp, while the other twenty are fanning out and pushing forward.",0,""],["ctl","avg3_216","a","008","sigh",null,null,null,null,"lengzhan","Linear",1.0],["say","avg3_216","We've got the Tyrant pinned down in the blocks around the orphanage. Only...",0,""],["ctl","avg1_163","c","004","question",null,null,null,null,null,"Linear",1.0],["say","avg1_163","Only what?",0,""],["ctl","avg3_216","a","004","speechless",0.25,null,null,null,null,"OutQuint",0.7],["ctl","avg1_163","c",null,null,0.75,null,null,null,null,"OutQuint",0.7],["fx",0,"fx_avg_sand_lp",1,0],["se","se_036_stop"],["stg",0,null,null,1.15,"OutQuint",1.0,null,null,null],["show","avg1_136","a","002",0.55,-0.32,1.5,0,null,0.0],["ctl","avg1_136","a",null,null,null,-0.3,null,0.8,null,"OutQuint",1.0],["say","avg3_216","Losing Lady Angie has riled everyone up. They're furious. The \"only target the Tyrant\" order is dead in the water.",0,""],["ctl","avg1_163","c","003",null,null,null,null,null,null,"Linear",1.0],["say","avg3_216","After all, everyone here has been through hell, and she was the one who pulled us out of it, one by one.",0,""],["stg",0,null,null,1.05,"OutQuint",1.0,null,null,null],["ctl","avg1_136","a",null,null,null,null,null,0.0,null,"OutQuint",0.5],["hide","avg1_136",0.5],["ctl","avg3_216","a",null,null,0.3,null,null,null,null,"OutQuint",0.7],["ctl","avg1_163","c",null,null,0.7,null,null,null,null,"OutQuint",0.7],["se","se_227"],["say","avg3_216","We are not going to target civilians or kids, of course, but no one is too worried about collateral damage anymore. As for the Tyrant's companions... It has escalated from \"wound them\" to \"shoot to kill.\"",0,""],["ctl","avg1_163","c","003","speechless",null,null,null,null,"niunie1","Linear",1.0],["say","avg1_163","I am not a member of the Committee, Gunhild. I don't know the pain you've all suffered, but I accepted Lady Angie's orders, and I intend to carry them out faithfully.",0,""],["say","avg1_163","I will do everything in my power to lead us to victory. But this kind of warfare... I don't think this is what Lady Angie wanted.",0,""],["ctl","avg1_163","c","005",null,null,null,null,null,"diantou","Linear",1.0],["se","se_077"],["say","avg1_163","So please, try to rein them in, even if it's just a little.",0,""],["ctl","avg3_216","a","013",null,null,null,null,null,"lengzhan","Linear",1.0],["se","se_251"],["say","avg3_216","I understand what you're saying, but ... I can't.",0,""],["se","se_062"],["cbg",0,-100.0,null,null,"OutQuint",1.0,null,null,null],["ctl","avg3_216","a","004",null,0.35,-0.15,1.4,null,null,"OutQuint",1.0],["ctl","avg1_163","c",null,null,0.73,0.0,0.95,null,null,"OutQuint",1.0],["bgm",""],["say","avg3_216","We haven't worked together for long, Greyhorn. I don't think I've ever told you==W== about my hometown, have I?",0,""],["w",0.7],["goon"],["ctl","avg1_163","c","004",null,null,null,null,null,"niunie1","Linear",1.0],["ctl","avg3_216","a",null,null,null,null,null,null,null,"OutQuint",1.0],["se","se_077"],["say","avg1_163","No. I only know you joined the Sentinel of Dawn in Emor, but judging by your accent, you clearly aren't from there.",0,""],["trn",0,1,false,false,0.3],["se","se_169"],["se","se_037"],["w",0.5],["film",0],["fx",0,"fx_avg_reminiscence_loop",0,0],["fx",0,"fx_avg_snowstorm_lp",0,0],["ctl","avg1_163","c",null,null,null,null,null,0.0,null,"OutQuint",0.0],["hide","avg1_163",0],["ctl","avg3_216","a",null,null,null,null,null,0.0,null,"OutQuint",0.0],["hide","avg3_216",0],["bg","north_street_city_daylight",0,0.0],["trn",1,1,false,false,1.0],["stg",0,null,null,1.07,"OutSine",3.0,null,null,null],["say","avg3_216","I'm not. I'm from the far north.==W== It's freezing up there. Winter lasts for six months of the year. We relied on Artifacts from the Monolith just to survive.",0,""],["w",0.7],["goon"],["say","avg3_216","Life was harsh, but we looked out for each other. We actually had it pretty good.",0,""],["se","se_037_stop"],["fx",0,"fx_avg_snowstorm_lp",1,0],["se","se_226"],["bg","BG_Black",0,0.0],["say","avg3_216","And then... The Monolith went dark.",0,""],["bg","desert_2_notower_daylight",3,0.0],["bg","desert_2_notower_daylight",4,0.0],["show","avg1_163","c","006",0.48,-0.18,1.2,4,"symbol",null],["stage",4,0,6],["bgm","m29"],["say","avg1_163","Went ... dark? How is that even possible?",0,""],["show","avg3_216","a","008",null,-0.15,1.18,3,"sigh",null],["stage",3,0,6],["say","avg3_216","You're an Imperial Guard Captain, yet you don't know about this? Looks like your Grand Captain doesn't see you as part of the inner circle.",0,""],["ctl","avg3_216","a","004","speechless",null,null,null,null,"niunie1","Linear",1.0],["say","avg3_216","The top brass at the major Nova companies have a tacit agreement to cover these things up. But that's a conversation for another time.",0,""],["stage",3,1,7],["stage",4,1,7],["ctl","avg3_216","a",null,null,null,null,null,0.0,null,"Linear",0.5],["hide","avg3_216",0.5],["ctl","avg1_163","c",null,null,null,null,null,0.0,null,"Linear",0.5],["hide","avg1_163",0.5],["bg","north_street_grey_night_nolight",0,0.0],["cbg",0,null,null,1.02,"OutSine",1.0,null,null,null],["say","avg3_216","Anyway, after the Monolith went dark, a sudden blizzard buried my hometown. I was separated from my parents and wandered into a neighboring city as an orphan.",0,""],["say","avg3_216","Honestly, I didn't even qualify to be an orphan. There was only so much charity to go around on those streets. Me taking a bite meant someone else starved.",0,""],["show","avg1_136","a","003",null,-0.35,1.5,0,null,0.0],["bg","BG_Black",0,0.5],["ctl","avg1_136","a",null,null,null,-0.38,1.55,1.0,null,"OutSine",2.0],["say","avg3_216","If Lady Angie hadn't found me, I probably would have frozen into a block of ice on the street, just like my home.",0,""],["trn",0,1,false,false,0.5],["w",0.7],["bg","desert_2_notower_daylight",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["film",1],["fx",0,"fx_avg_reminiscence_loop",1,0],["ctl","avg1_136","a",null,null,null,null,null,null,null,"Linear",0.0],["hide","avg1_136",0],["trn",1,1,false,false,1.0],["show","avg3_216","a","004",0.35,-0.15,1.4,0,"speechless",null],["show","avg1_163","c","003",0.73,0.0,0.95,0,null,null],["say","avg3_216","Every member of the Committee has a story like mine. And the Tyrant responsible for all of this is right in front of us, surrounded by a bunch of stubborn fools protecting ==SEX4==.",0,""],["ctl","avg3_216","a","012",null,null,null,null,null,"lengzhan","Linear",1.0],["se","se_226"],["cbg",0,null,null,0.98,"OutQuint",1.0,null,null,null],["ctl","avg1_163","c",null,null,null,null,null,null,null,"OutQuint",1.0],["say","avg3_216","How am I supposed to rein everyone in under these conditions?!",0,""],["se","se_251"],["ctl","avg3_216","a","007",null,null,null,null,null,"lengzhan","Linear",1.0],["say","avg3_216","If my cannon wasn't jammed, I'd completely level the bar the Tyrant is hiding in right now!",0,""],["cbg",0,null,null,1.0,"OutQuint",0.7,null,null,null],["ctl","avg3_216","a","010",null,null,null,null,null,null,"OutQuint",1.0],["ctl","avg1_163","c","008",null,null,null,null,null,null,"OutQuint",0.5],["ctl","avg1_163","c","008",null,null,-0.05,null,null,"lengzhan","InQuart",0.7],["say","avg1_163","Cough, cough, cough...==W==",0,""],["w",0.2],["se","se_096"],["stg",0,null,null,null,"Linear",1.0,null,null,"Xiao"],["w",0.5],["goon"],["ctl","avg3_216","a","012","flurry",0.42,0.0,1.0,null,null,"OutQuint",1.0],["se","se_062"],["stg",0,-200.0,20.0,1.2,"OutQuint",1.0,null,null,null],["say","avg3_216","Greyhorn, your internal injuries are serious. You need rest, right now.",0,""],["ctl","avg1_163","c","006",null,null,0.0,null,null,null,"OutQuart",1.0],["se","se_208"],["say","avg1_163","It's... It's fine. Just a few broken ribs. I gave Lady Angie my word, and I will fulfill my duty to the very end.",0,""],["ctl","avg1_163","c","003","speechless",null,null,null,null,null,"Linear",1.0],["ctl","avg3_216","a","004",null,null,null,null,null,null,"Linear",1.0],["say","avg1_163","I understand how your people feel. Since you can't rein them in, we will resolve this with the least amount of casualties possible on both sides.",0,""],["se","se_226"],["stg",0,-380.0,null,1.25,"OutQuint",1.0,null,null,null],["ctl","avg1_163","c","005",null,0.65,null,null,null,null,"OutQuint",1.0],["ctl","avg3_216","a",null,null,0.4,0.03,0.9,null,null,"OutQuint",1.0],["say","avg1_163","Tell the troops to rotate shifts and wear the Tyrant down until dawn. Then we launch a full-scale assault and end this!",0,""],["bgm",""],["w",0.5],["trn",0,0,false,false,1.0],["w",1.0],["clear",1,0,1],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["w",1],["bg","mirage_street_daylight_tower",0,0.0],["show","avg3_152","a","018",null,null,null,0,null,0.0],["trn",1,0,false,false,1.0],["bgm","m111"],["head","18:30, Nebula Month 7th, Mirage, Unnamed Street"],["ctl","avg3_152","a",null,"sigh",null,null,null,1.0,null,"OutQuint",1.0],["say","avg3_152","And that's the situation. The Salvation Committee is just made up of people who lost their homes.",0,""],["ctl","avg3_152","a","015",null,null,null,null,null,"diantou","Linear",1.0],["se","se_077"],["say","avg3_152","Lady Angie just gathered them together. Even without her, they'd still desperately want to save the world.",0,""],["w",0.5],["mrt",1,"z","010","sweaty",null],["say","avg3_100","So by capturing Angie, I actually did the Committee a favor?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["stg",0,null,10.0,1.1,"OutQuint",0.7,null,null,null],["se","se_030"],["ctl","avg3_152","a","008",null,null,null,null,null,null,"Linear",1.0],["say","avg3_152","Looking at the outcome, yes. Honestly, Lady Angie is a complete amateur when it comes to commanding battles.",0,""],["ctl","avg3_152","a","014","vexation",null,null,null,null,"niunie1","Linear",1.0],["say","avg3_152","Clumping elite warriors into three clunky companies, when only Captain Greyhorn has any real command experience... Only Lady Angie would think that's a good idea.",0,""],["ctl","avg3_152","a","012",null,null,null,null,null,"diantou","Linear",1.0],["se","se_077"],["say","avg3_152","Therefore, Boss... Speaking entirely as a rep looking out for a client's best interests, I highly recommend you slip away tonight under the cover of darkness.",0,""],["stg",0,null,0.0,1.05,"OutQuint",1.0,null,null,null],["cbg",0,-50.0,null,null,"OutQuint",1.0,null,null,null],["ctl","avg3_152","a",null,null,0.65,0.03,0.9,null,null,"OutQuint",1.0],["show","avg1_108","a","003",0.4,-0.25,1.3,0,null,0.0],["ctl","avg1_108","a",null,null,0.45,null,null,1.0,null,"OutQuint",1.0],["se","se_062"],["say","avg1_108","I suggest the same. With Director Allie and the rest of your team, the Committee won't be able to stop you.",0,""],["w",0.5],["mrt",1,"z","016",null,"lengzhan"],["se","se_251"],["ctl","avg3_152","a","008",null,null,null,null,null,null,"Linear",1.0],["say","avg3_100","I... I can't just run.",1,""],["mrt",0,"y","010",null,"diantou"],["se","se_077"],["say","avg3_100","Kasimira, what's the evacuation status for the kids and the citizens of Mirage?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["stg",0,0.0,0.0,1.0,"OutQuint",1.0,null,null,null],["ctl","avg1_108","a","012","speechless",0.5,0.0,1.0,null,null,"OutQuint",1.0],["ctl","avg3_152","a",null,null,0.7,null,null,0.0,null,"OutQuint",0.7],["hide","avg3_152",0.7],["say","avg1_108","It's bad. The Committee has Mirage surrounded on the east and south. The Desert Scorpions and the local Imperial Guard haven't made a move, but they're blocking the west and north routes. We can't get through.",0,""],["say","avg1_108","The fighting has caved in multiple sections of the underground mineshafts too. Evacuation is crawling. We won't have everyone out until tomorrow morning.",0,""],["w",0.5],["trn",0,1,false,false,0.2],["w",0.2],["fx",0,"fx_avg_reminisce