,null,null],["w",0.85],["bg","story_main_10001_001_c",0,0.6],["cbg",0,null,40.0,null,"Linear",0.0,null,null,null],["w",0.85],["bg","story_main_10001_001",0,0.6],["cbg",0,500.0,-30.0,1.4,"Linear",0.0,null,null,null],["w",0.85],["bg","story_main_10001_001_c",0,0.6],["cbg",0,500.0,-30.0,1.4,"Linear",0.0,null,null,null],["w",0.85],["bg","story_main_10001_001",0,0.6],["cbg",0,500.0,-30.0,1.4,"Linear",0.0,null,null,null],["w",0.85],["bg","story_main_10001_001_c",0,0.6],["cbg",0,500.0,-30.0,1.4,"Linear",0.0,null,null,null],["w",0.4],["say","0","Elis gives me a meaningful look. Looks like she wants me to say yes.",9,""],["w",0.4],["mrt",1,"y","020","think",null],["say","avg3_100","This Night Watcher clearly respects the title. If we want out of here, I need to lean hard into this Acolyte persona.",2,""],["w",0.4],["mrt",0,"y","014",null,"diantou"],["say","avg3_100","... Looks like I'm playing along with Elis for now.",2,""],["w",0.4],["mrt",0,"y","009","sigh","lengzhan"],["say","avg3_100","I need to keep my answers vague. Give her nothing to poke holes in.",2,""],["mrt",3,"y",null,null,null],["w",0.51],["bg","story_main_10001_001_c",0,0.6],["cbg",0,-820.0,450.0,1.65,"Linear",0.0,null,null,null],["w",0.4],["mrt",1,"y","002","question",null],["say","avg3_100","Three years ago... That rings a bell. But what does that have to do with locking us in a cage?",1,""],["mrt",3,"y",null,null,null],["w",0.51],["se","se_021"],["bg","story_main_10001_001_n",0,0.6],["cbg",0,-820.0,450.0,1.65,"Linear",0.0,null,null,"jushou"],["w",0.4],["say","avg1_162","Take a look at this portrait.",9,""],["w",0.4],["bgm",""],["mrt",2,"z","025","exclamation",null],["say","avg3_100","... This is!",1,""],["mrt",3,"z",null,null,null],["w",0.51],["bg","story_main_10001_001_a",0,0.6],["cbg",0,-820.0,450.0,1.65,"Linear",0.0,null,null,null],["w",0.35],["say","avg1_162","A word in private, if you would.",9,""],["w",0.4],["se","se_076"],["trn",0,2,true,true,1.0],["w",1.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,nul