s.",0,""],["w",0.4],["mrt",1,"y","025","think",null],["say","avg3_100","Elis is the Fallen Saintess? And I'm under her spell?==W== No. I am immune to magic. I can't be bewitched.",2,""],["w",0.8],["se","se_146"],["mrt",0,"y","009",null,"chijing"],["goon"],["mrt",3,"y",null,null,null],["w",0.51],["ctl","avg1_162","a","012","sigh",null,null,null,null,"lengzhan","OutSine",0.35],["w",0.35],["say","avg1_162","Your elegant bearing and fine clothes tell me you are indeed an Acolyte, or at least someone of equal standing.",0,""],["w",0.4],["se","se_062"],["cbg",0,null,null,1.05,"OutCubic",0.7,null,null,null],["ctl","avg1_162","a","011","sweaty",null,-0.24,1.35,null,null,"OutCubic",0.7],["w",0.45],["say","avg1_162","Your eyes are clear. You aren't under any spell. Which begs the question: why are you covering for a sinner and willingly lying for her?",0,""],["w",0.4],["stg",0,null,null,null,"Linear",0.0,null,null,"Xiao"],["mrt",1,"z","025","symbol",null],["tsk","Xiao"],["say","avg3_100","L-Lying?",1,""],["mrt",3,"z",null,null,null],["w",0.51],["ctl","avg1_162","a","014","speechless",null,null,null,null,null,"OutSine",0.35],["w",0.35],["say","avg1_162","When speaking of Elis, you never once called her your slave. You don't view her as property. A true master would never carry ==SEX8== that way.",0,""],["ctl","avg1_162","a",null,null,null,null,null,null,null,"OutSine",0.35],["w",0.4],["cbg",0,-140.0,null,null,"OutCubic",0.7,null,null,null],["ctl","avg1_162","a","005","exclamation",0.68,null,null,null,null,"OutCubic",0.7],["show","avg3_182","b","015",0.5,-0.16,1.12,0,null,0.0],["ctl","avg3_182","b",null,null,0.32,null,null,1.0,null,"OutCubic",0.7],["w",0.4],["say","avg1_162","It seems to me there's no master-servant relationship between the two of you.",0,""],["w",0.4],["se","se_062"],["cbg",0,60.0,null,null,"OutCubic",0.7,null,null,null],["ctl","avg3_182","b",null,null,0.45,null,null,0.0,null,"OutCubic",0.7],["hide","avg3_182",0.7],["ctl","avg1_162","a","002",null,0.5,null,nul