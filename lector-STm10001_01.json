,"avg3_100","What do you think, Vita?",2,""],["mrt",3,"y",null,null,null],["ctl","avg3_1311","c",null,null,null,null,null,0.0,null,"OutSine",0.7],["hide","avg3_1311",0.7],["w",0.51],["bg","story_main_09_015",0,0.0],["cbg",0,null,0.0,null,"Linear",0.0,null,null,null],["cbg",0,null,100.0,null,"OutBack",0.8,null,null,null],["w",0.15],["se","se_118"],["w",0.6],["show","avg1_103","a","002",0.62,-0.2,1.35,0,"speechless",0.0],["w",2.0],["ctl","avg1_103","a",null,null,null,null,null,null,null,"OutSine",0.3],["se","se_169"],["trn",0,1,true,true,0.9],["w",0.9],["bg","story_main_10001_001_b",0,0.0],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["cbg",0,null,40.0,1.05,"Linear",0.0,null,null,null],["w",0.1],["trn",1,1,false,false,0.9],["w",0.25],["mrt",1,"y","016","vexation","lengzhan"],["say","avg3_100","... Right. What am I doing? Vita broke trying to save me.",2,""],["w",0.4],["mrt",0,"y","010","sigh","lengzhan"],["say","avg3_100","Ugh, enough spiraling. Wherever I am, priority one is getting out of this cage. Time to chat with the Night Watcher.",2,""],["mrt",3,"y",null,null,null],["w",0.71],["choice",["Elis, ask the Night Watcher to step over here."],[[]]],["w",0.1],["bg","story_main_10001_001_f",0,0.6],["cbg",0,null,40.0,1.05,"Linear",0.0,null,null,null],["w",0.35],["bgm","m149"],["say","avg3_182","Master? You don't need to entertain the whims of a lowly Night Watcher.",9,""],["w",0.4],["bg","circle_light",0,0.0],["cbg",0,-200.0,null,2.8,"Linear",0.0,null,null,null],["bg","story_main_10001_001_o",0,0.6],["cbg",0,220.0,-40.0,1.3,"Linear",0.0,null,null,null],["cbg",0,450.0,null,null,"OutBack",0.8,null,null,null],["w",0.45],["say","avg3_182","She threw us in this cage without a shred of proof! She's completely barbaric.",9,""],["w",0.4],["bg","story_main_10001_001_c",0,0.6],["cbg",0,450.0,-40.0,1.3,"Linear",0.0,null,null,null],["w",0.35],["say","avg3_182","Once we reach the city, I'll find her Patron and ensure she is severely punished.",9,""],["w",0.4],["bg","story_main