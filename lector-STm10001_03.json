3_c",0,0.5],["w",0.5],["trn",1,1,false,false,1.0],["w",1.0],["stg",0,null,null,null,"Linear",0.5,null,null,"niunie1"],["w",0.5],["ctl","avg1_103","a",null,null,null,null,1.0,null,null,"Linear",0.0],["w",0.7],["cbg",0,null,null,null,"Linear",1.0,null,null,"jushou"],["ctl","avg1_103","a",null,"question",null,null,null,null,null,"Linear",1.0],["w",0.5],["say","avg3_182","Besides, I'm your slave. It's only natural for a slave to wash her Master's back, isn't it?",9,""],["w",0.5],["mrt",1,"cd","007","shock","chijing"],["say","avg3_100","N-Natural? We're only pretending to be master and slave to fool the locals. I don't even like the idea of slaves, let alone need one.",1,""],["mrt",3,"cd",null,null,null],["ctl","avg1_103","a",null,null,0.4,null,1.0,null,null,"Linear",0.5],["w",0.5],["bg","story_main_10001_003_c",0,0.5],["w",0.5],["ctl","avg1_103","a",null,"question",null,null,null,null,null,"Linear",1.0],["say","avg3_182","Oh? Master hates the idea of slavery just as much as the locals do. Why is that?",9,""],["w",0.5],["mrt",1,"cd","010","sigh",null],["say","avg3_100","Why should anyone own another person? It just feels wrong. I don't need a better reason than that.",1,""],["bg","story_main_10001_003",0,0.5],["w",1.0],["mrt",0,"cd","002","attention",null],["say","avg3_100","What about you? If you needed a cover, you could have been a friend or a traveling companion. Why insist on being a slave?",1,""],["mrt",3,"cd",null,null,null],["ctl","avg1_103","a",null,null,0.45,-0.05,1.0,null,null,"Linear",0.0],["bg","story_main_10001_003_a",0,0.5],["w",0.5],["bg","story_main_10001_003_b",0,0.5],["stg",0,null,null,null,"OutSine",1.0,null,null,"jushou"],["ctl","avg1_103","a",null,"music",null,null,null,null,null,"Linear",1.0],["w",0.5],["say","avg3_182","Because it's practical. You said owning another person felt wrong. But what if Novians don't consider slaves as people in the first place?",9,""],["bg","story_main_10001_003",0,0.5],["w",0.5],["mrt",1,"cd","025","exclamation",null],["say","avg3_100","Not people...",1,""],["mrt",3,"cd",null,null,null],["w",0.5],["bg","story_main_10001_003_c",0,0.5],["w",0.5],["say","avg3_182","Heh. At the markets in Emor, a horse fetches a much higher price than a slave. To most Novians, a slave is nothing but an object.",9,""],["w",0.3],["bg","story_main_10001_003_a",0,0.5],["w",0.5],["say","avg3_182","And being an object has its advantages.",9,""],["bg","story_main_10001_003",0,0.5],["w",1],["mrt",1,"cd","002","question",null],["say","avg3_100","How is that an advantage?",1,""],["mrt",3,"cd",null,null,null],["w",0.5],["bg","story_main_10001_003",0,1.0],["cbg",0,null,-50.0,1.1,"OutSine",0.0,null,null,null],["stg",0,0.0,0.0,1.0,"OutSine",1.0,null,null,null],["bgm",""],["w",0.3],["trn",0,0,true,true,1.0],["w",1.0],["bg","phylanis_bathing",0,1.0],["w",1.0],["stg",0,0.0,0.0,1.1,"InCubic",0.0,null,null,null],["cbg",0,null,-100.0,1.3,"Linear",0.0,null,null,null],["show","avg3_182","c","004",null,-0.5,1.35,0,null,0.0],["trn",1,0,false,false,1.0],["w",1.3],["se","se_432"],["ctl","avg3_182","c",null,null,null,-0.35,null,1.0,null,"OutBack",1.0],["w",1.0],["ctl","avg3_182","c","014","sigh",null,null,null,null,null,"Linear",0.5],["w",1.0],["ctl","avg3_182","c","021","music",null,null,null,null,"jushou","Linear",0.5],["w",0.5],["say","avg3_182","Well, nobody looks twice at an object.==W== And that to me is the greatest advantage.",0,""],["w",0.3],["se","se_077"],["bgm","m25"],["ctl","avg3_182","c","002",null,null,-0.17,1.2,null,null,"OutQuad",0.7],["w",0.7],["goon"],["w",0.5],["ctl","avg3_182","c","015","sweaty",null,null,null,null,null,"Linear",0.5],["say","avg3_182","If I called myself your companion, I'd have to invent a flawless backstory. One that would crumble under scrutiny, given I'm a Fallen Saintess who spent three years locked in a tower.",0,""],["w",0.5],["ctl","avg3_182","c","018","star",null,null,null,null,"niunie1","Linear",0.5],["say","avg3_182","But as a slave? I only need your nod of approval. People will focus all their scrutiny on you, because I am simply something you own.",0,""],["w",0.5],["se","se_112"],["mrt",2,"cd","007",null,"chijing2"],["say","avg3_100","Hey now. You actually thought this all through. I can't tell if you're incredibly cunning or just completely reckless.",1,""],["ctl","avg3_182","c",null,"music",null,null,null,null,"youzai","Linear",0.5],["w",1.0],["mrt",0,"cd","014","attention",null],["say","avg3_100","What if I refused to play along? Or what if I was dangerous?",1,""],["mrt",3,"cd",null,null,null],["ctl","avg3_182","c","004",null,null,null,null,null,null,"OutSine",0.5],["w",1.0],["ctl","avg3_182","c","005",null,null,null,null,null,null,"Linear",0.5],["say","avg3_182","You were a corpse when I found you, so I had nothing to fear.==W== You waking up did give me a fright, but I watched you closely before deciding to keep up the act.",0,""],["w",0.3],["ctl","avg3_182","c","006",null,null,null,null,null,"diantou","Linear",1.0],["goon"],["w",0.5],["ctl","avg3_182","c","014",null,null,null,null,null,null,"Linear",0.5],["w",0.5],["say","avg3_182","You're gentle, kind, clever, and completely harmless.==W== The best person I've ever met~",0,""],["se","se_251"],["ctl","avg3_182","c",null,null,null,-0.3,1.35,null,"niunie1","OutSine",0.7],["stg",0,null,-0.5,1.2,"OutSine",1.0,null,null,"jushou"],["w",1.0],["ctl","avg3_182","c","021","love",null,null,null,null,null,"Linear",1.0],["goon"],["w",0.5],["mrt",1,"ce","021","awkward",null],["say","avg3_100","Ugh. Why does that feel like an insult?!",2,""],["mrt",3,"ce",null,null,null],["w",0.5],["ctl","avg3_182","c","006","music",null,null,null,null,"diantou","Linear",0.5],["say","avg3_182","That's why playing your slave was risk-free.==W== I even bet you wouldn't treat me like an object. And I was right.",0,""],["w",0.3],["ctl","avg3_182","c","018","happy",null,null,null,null,"niunie","Linear",1.0],["goon"],["w",0.5],["ctl","avg3_182","c","013","attention",null,null,null,null,"huanxin","Linear",0.5],["say","avg3_182","By the way, this is my first time playing a slave. I'm doing a flawless job, aren't I? Where's my praise?",0,""],["bgm",""],["w",0.5],["se","se_095"],["mrt",1,"cd","021","happy",null],["say","avg3_100","Sure, sure. Good job.",1,""],["mrt",3,"cd",null,null,null],["w",0.5],["ctl","avg3_182","c","020","resentful",null,null,null,null,"buman","Linear",0.5],["say","avg3_182","You could at least pretend to mean it!",0,""],["w",1.0],["bgm","m147"],["mrt",1,"cd","002","attention",null],["say","avg3_100","Elis, you didn't sneak into my bath just to chat and act cute, did you?",1,""],["mrt",3,"cd",null,null,null],["w",0.5],["ctl","avg3_182","c","003",null,null,null,null,null,null,"Linear",0.5],["w",1],["ctl","avg3_182","c","004","shy",null,null,null,null,"diantou","Linear",0.5],["say","avg3_182","Haha, I got a little too into character. Almost forgot why I came.",0,""],["w",0.5],["ctl","avg3_182","c","014","star",null,null,null,null,"huanxin","Linear",0.5],["say","avg3_182","We meet the Archon after this. Our act might fool a backwater Night Watcher, but it won't hold up against the Archon.",0,""],["w",0.5],["mrt",1,"cd","002","shock",null],["say","avg3_100","So what do we do?",1,""],["mrt",3,"cd",null,null,null],["w",0.5],["ctl","avg3_182","c","018","happy",null,null,null,null,"youzai","Linear",0.5],["say","avg3_182","We run!",0,""],["w",0.5],["ctl","avg3_182","c",null,null,0.4,null,null,null,null,"OutQuad",0.7],["stg",0,-200.0,null,1.25,"OutQuad",0.7,null,null,null],["w",1],["bg","phylanis_bathing",4,0.0],["cbg",4,0.0,-600.0,2.0,"Linear",0.0,null,null,null],["show","avg2_978","a","002",0.7,null,1.2,4,null,null],["ctl","avg2_978","a",null,null,0.82,-0.5,null,null,null,"OutSine",0.0],["stage",4,0,6],["se","se_099"],["ctl","avg2_978","a",null,null,0.8,null,1.5,1.0,"xuanyun","InOutBack",1.0],["mrt",1,"ce","002",null,null],["say","avg3_100","There's no escaping. Those black magic arms are watching the doors and windows. They call it service, but it's clearly surveillan