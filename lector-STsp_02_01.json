ctl","avg1_112","a","006","idea",null,null,null,null,"jushou","Linear",0.5],["w",0.5],["say","avg1_112","I know, it's wild! The first time I saw it, I couldn't believe it either. It's just a door on a rock, not connected to anything. You'd never guess it's the way in.",0,""],["ctl","avg1_112","a",null,null,null,null,null,0.0,null,"OutSine",0.5],["w",0.5],["chd",0,4,"avg1_103","a","002",null],["bg","tower_entrance",0,1.0],["cbg",0,200.0,-100.0,1.35,"OutSine",0.0,null,null,null],["say","avg1_103","Open the door. Step in. Close it. Open it again. You're there.",0,""],["hide","avg1_112"],["chd",1,4,"avg1_103","a","002",null],["bg","tower_entrance",0,1.0],["w",1.3],["mrt",0,"z","002","question",null],["say","avg3_100","How in the world does that work?",1,""],["stg",0,null,null,1.15,"OutSine",0.6,null,null,null],["show","avg1_111","a","002",null,null,null,0,null,null],["ctl","avg1_111","a","004","speechless",null,-0.01,null,null,null,"Linear",0.3],["w",0.3],["say","avg1_111","The Monoliths are full of mysteries. It's not confirmed, but we think it's some form of teleportation magic...",0,""],["ctl","avg1_111","a","003",null,null,null,null,null,null,"Linear",0.3],["w",0.3],["ctl","avg1_111","a","002",null,null,0.0,null,null,null,"OutSine",0.5],["say","avg1_111","There's no door at the base of the Monolith. The only way in is to find one of these elevators blended into the terrain. They link up with the elevators inside the Monolith.",0,""],["w",0.4],["mrt",2,"z","002","shock",null],["say","avg3_100","That's just ... incredible.",1,""],["ctl","avg1_111","a","009",null,null,null,null,null,null,"Linear",0.5],["w",0.5],["say","avg1_111","These elevators vanish the second you use them, only to pop up somewhere else around the Monolith. It's probably just like the legends say—==W==a trial from the God of Grace for anyone who dares to climb the Monoliths.",0,""],["ctl","avg1_111","a","011","attention",null,null,null,null,"diantou","Linear",0.3],["goon"],["ctl","avg1_111","a","010",null,null,null,null,null,null,"Linear",0.3],["w",0.3],["say","avg1_111","It usually takes some time to find an entrance. Today was actually really fast. One time, we roamed around a Monolith for two whole days and still couldn't find its entrance...",0,""],["w",0.4],["ctl","avg1_111","a","009",null,null,null,null,null,null,"Linear",1.0],["mrt",0,"z","003","sweaty",null],["say","avg3_100","No wonder it felt like we were just driving in circles.",1,""],["w",0.4],["show","avg1_112","a","002",0.75,null,null,0,null,0.0],["ctl","avg1_112","a",null,null,0.7,null,null,1.0,null,"OutSine",0.5],["ctl","avg1_111","a",null,null,0.3,null,null,null,null,"OutSine",0.5],["w",0.5],["ctl","avg1_112","a",null,"music",null,null,null,null,"diantou","Linear",1.0],["say","avg1_112","When that happens, it just means your luck's out. Probably shouldn't attempt a climb! Even if you force it, your wish will probably be a dud.",0,""],["ctl","avg1_111","a","004","sigh",null,null,null,null,"diantou","Linear",1.0],["w",1.0],["say","avg1_111","There's no actual evidence connecting the two...==W== That's just a hunch of yours, Noya.",0,""],["w",0.3],["goon"],["ctl","avg1_112","a","004","happy",null,null,null,null,"huanxin","Linear",1.0],["w",1.0],["say","avg1_112","Who cares! We found it this fast, so we must be on a roll! C'mon, let's get ready and dive in!",0,""],["ctl","avg1_111","a",null,null,0.5,null,null,null,null,"OutSine",0.6],["ctl","avg1_112","a",null,null,0.8,null,null,0.0,null,"OutSine",0.6],["stg",0,null,null,1.2,"OutSine",0.6,null,null,null],["w",0.6],["ctl","avg1_111","a","003","speechless",null,null,null,null,null,"Linear",1.0],["w",1.0],["say","avg1_111","You've got a point...==W== Okay, let's start prepping.",0,""],["ctl","avg1_111","a","002",null,null,null,null,null,"diantou","Linear",0.3],["w",0.3],["goon"],["ctl","avg1_111","a","026",null,null,null,null,null,null,"Linear",0.5],["w",0.5],["say","avg1_111","What about you? If you don't wanna climb, you can just wait out here for