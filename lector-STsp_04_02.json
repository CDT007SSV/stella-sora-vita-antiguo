,["w",0.5],["ctl","avg1_119","b","013","exclamation",null,null,null,null,"ChanDou","Linear",0.5],["say","avg1_119","What...==W== Blocked...!",0,""],["w",0.5],["ctl","avg1_119","b","008",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg1_119","b",null,null,null,null,null,null,null,"Linear",0.3],["ctl","avg3_147","a","003","happy",null,null,null,null,"ChanDou","Linear",0.3],["say","Gold District Visitor","Warriors bought with Dorra might not be loyal, but magic scrolls bought with Dorra? They never fail me.",0,""],["w",0.5],["ctl","avg3_147","a",null,null,null,null,null,null,null,"Linear",0.3],["ctl","avg1_119","b","007",null,null,null,null,null,"ChanDou","Linear",0.3],["se","se_174"],["w",0.3],["se","se_137"],["stg",0,null,null,null,"Linear",1.0,null,null,"Xiao"],["fx",0,"fx_avg_wind_attack",0,1],["ctl","avg3_147","a",null,null,null,null,null,null,"jingxia","Linear",0.5],["w",0.5],["ctl","avg1_119","b","006",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_119","Blocked again... There's no opening. The shield just reforms. Where do I aim?",0,""],["w",0.5],["ctl","avg3_147","a",null,null,null,null,null,null,null,"Linear",0.35],["cbg",0,null,null,1.5,"Linear",20.0,null,null,null],["ctl","avg3_147","a",null,null,0.2,null,null,null,null,"Linear",20.0],["ctl","avg1_119","b",null,null,null,null,null,null,null,"Linear",20.0],["say","Gold District Visitor","I'd say just give up. I sank every last Dorra from that tax into these scrolls.==W== I've got plenty more.",0,""],["w",0.5],["goon"],["ctl","avg3_147","a","002",null,null,null,null,null,null,"Linear",0.0],["say","Gold District Visitor","But hey, if you want to keep trying, I've got all night.==W== Your friends, though... I doubt they have that long.",0,""],["w",0.5],["goon"],["ctl","avg1_119","b","010",null,null,null,null,null,"ChanDou","Linear",0.3],["say","avg1_119","Okra, Isaki...",0,""],["w",0.5],["bgm",""],["ctl","avg3_147","a","006",null,null,null,null,null,null,"Linear",0.5],[