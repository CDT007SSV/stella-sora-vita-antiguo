ative.",0,""],["ctl","avg1_119","b","013",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_119","I wonder how Isaki and Okra are doing...",0,""],["w",0.5],["se","se_014"],["stg",0,30.0,null,null,"OutSine",0.3,null,null,null],["cbg",0,15.0,null,null,"OutSine",0.3,null,null,null],["ctl","avg1_119","b",null,null,0.15,null,null,null,null,"OutSine",0.3],["w",0.3],["bgm","m12"],["say","avg1_119","How's it going on your end?",0,""],["say","avg3_203","I'm on fugu sashimi. Pretty sure most of these guests won't know about this dish.",0,""],["say","avg3_202","Heh heh, and I've got fresh grated crimson radish! Plus, a matcha cake.",0,""],["ctl","avg1_119","b","013",null,null,null,null,null,null,"Linear",0.5],["say","avg1_119","Fugu sashimi... Right, exotic stuff for Philae. The radish is a nice touch, too. But ... a matcha cake?",0,""],["say","avg3_202","It's for dessert at the end! I'm gonna give it my all!",0,""],["say","avg3_203","Don't worry. I'll keep an eye on her. Though I've already lost count of how much matcha powder she's gone through.",0,""],["ctl","avg1_119","b","004",null,null,null,null,null,null,"Linear",1.0],["w",1.0],["say","avg1_119","Well, now I'm actually looking forward to Isaki's matcha cake.",0,""],["say","avg3_202","See? Even Master's looking forward to my cake!",0,""],["say","avg3_203","Just stick to the recipe. As long as you don't improvise, it should be fine... Probably...",0,""],["bgm",""],["w",0.5],["trn",0,0,true,true,0.75],["w",0.75],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["bg","hotel_banquet_hall_night",0,0.0],["cbg",0,0.0,0.0,1.1,"Linear",0.0,null,null,null],["trn",1,0,false,false,0.75],["w",1.25],["show","avg3_145","a","002",0.2,null,null,0,null,0.0],["show","avg3_146","a","005",0.8,null,null,0,null,0.0],["show","avg3_147","a","002",0.5,null,null,0,null,0.0],["ctl","avg3_145","a",null,null,null,null,null,1.0,null,"Linear",0.5],["w",0.5],["ctl","avg3_145","a",null,"attention",null,null,null,null,"JuGong","Linear",0.5],