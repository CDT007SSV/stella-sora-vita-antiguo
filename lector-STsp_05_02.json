{"id":"STsp_05_02","names":{"Delivery Person":"Delivery Person","avg1_150":"Laru","avg3_139":"Trekker","avg3_152":"Bastelina","avg3_161":"Leafia","avg3_999":"???"},"en":{"Delivery Person":"Delivery Person","avg1_150":"Laru","avg3_139":"Generic Trekker Male","avg3_152":"Bastelina","avg3_161":"Leafia","avg3_999":"???"},"tx":1,"steps":[["intro","Act Two","The Old Timer and the Newcomer (Part II)","After arriving at the Trekker Association, they are informed that Willow is on a trip. Determined not to go back to work, Laru decides to simply wait there until Willow's return."],["trn",0,0,false,false,1.0],["w",1.0],["bg","travellers_home_inside",0,0.5],["w",0.5],["trn",1,0,false,false,1.0],["se","se_093"],["stg",0,null,-30.0,1.05,"Linear",1.0,null,null,null],["w",1.5],["bgm","m30"],["show","avg3_161","a","004",0.4,null,null,0,null,0.0],["ctl","avg3_161","a",null,null,0.5,null,null,1.0,null,"Linear",0.5],["say","avg3_999","Welcome to the Trekker Association.",0,""],["w",0.5],["show","avg1_150","a","002",0.3,null,null,0,null,0.0],["ctl","avg1_150","a",null,"attention",0.35,null,null,1.0,null,"Linear",0.5],["ctl","avg3_161","a",null,null,0.7,null,null,null,null,"Linear",0.5],["say","avg1_150","Oh hey, Leafia! You're on duty today? That's a first.",0,""],["w",0.5],["ctl","avg3_161","a","005","sweaty",null,null,null,null,null,"Linear",0.5],["say","avg3_161","True. Didn't you just come by a few days ago? Here to slack off again?",0,""],["w",0.5],["ctl","avg1_150","a","017","happy",null,null,null,null,"chijing","Linear",0.5],["say","avg1_150","No no no... Perish the thought!==W== I'm here to show the newbie around!",0,""],["w",0.5],["ctl","avg1_150","a","006",null,0.25,null,null,1.0,null,"OutSine",0.5],["w",0.5],["ctl","avg1_150","a",null,"music",0.45,null,null,null,null,"Linear",0.5],["show","avg3_152","a","002",0.2,null,null,0,null,0.0],["ctl","avg3_152","a",null,null,0.25,null,null,1.0,null,"Linear",0.5],["ctl","avg3_161","a",null,null,0.8,null,null,null,null,"Linear",0.5],["w",0.5],["goon"],["w",0.5],["stg",0,-80.0,null,null,"Linear",0.5,null,null,null],["ctl","avg1_150","a",null,null,0.3,null,null,null,null,"Linear",0.5],["ctl","avg3_152","a","005","flower",0.5,null,null,null,"JuGong1","Linear",0.5],["say","avg3_152","Hello, I'm Bastelina. I just became a full-time employee of Grace Imperium.",0,""],["w",0.5],["ctl","avg3_161","a","010",null,null,null,null,null,"JuGong1","Linear",0.5],["say","avg3_161","My name's Leafia. I'm a surveyor for Sea Wakers. I help out at the front desk once in a while.",0,""],["w",0.5],["stg",0,-100.0,null,null,"Linear",0.5,null,null,null],["ctl","avg3_152","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["ctl","avg1_150","a","007","attention",0.5,null,null,null,"jushou2","Linear",0.5],["say","avg1_150","Where's Willow? Let her explain the details to Bastelina.",0,""],["w",0.5],["ctl","avg3_161","a","002",null,null,null,null,null,null,"Linear",0.5],["say","avg3_161","You haven't heard? Miss Willow went on a business trip to HQ. She hasn't come back yet.",0,""],["w",0.5],["ctl","avg1_150","a","004","question",null,null,null,null,null,"Linear",0.5],["say","avg1_150","A business trip?==W== Oh right! She mentioned something about that—because of the Monolith Meltdown...",0,""],["w",1.0],["ctl","avg1_150","a","014","exclamation",null,null,null,1.0,"diantou","OutSine",0.5],["goon"],["w",0.5],["ctl","avg3_161","a","004",null,null,null,null,null,null,"Linear",0.5],["say","avg3_161","She's scheduled to be back tonight. Maybe you would like to come another day?",0,""],["w",0.5],["ctl","avg1_150","a","006","happy",null,null,null,null,null,"Linear",0.5],["say","avg1_150","Nah, we'll just wait here for her to come back!",0,""],["ctl","avg3_152","a","008",null,0.2,null,null,0.0,null,"Linear",0.0],["w",0.5],["stg",0,80.0,null,null,"Linear",0.5,null,null,null],["w",0.5],["ctl","avg3_161","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["se","se_047"],["ctl","avg3_152","a",null,null,0.25,null,null,1.0,null,"Linear",0.5],["say","avg3_152","Miss Laru, we don't have to wait all day, do we?",0,""],["w",0.5],["se","se_146"],["ctl","avg1_150","a","009",null,null,null,null,null,"chijing","Linear",0.5],["say","avg1_150","Come on, think about it!==W== If we go back now, that means going back to work, doesn't it?",0,""],["w",0.8],["ctl","avg1_150","a","014","awkward",null,null,null,1.0,null,"OutSine",0.5],["goon"],["w",0.5],["se","se_077"],["ctl","avg3_152","a","006",null,null,null,null,null,"JuGong1","Linear",0.5],["say","avg3_152","Then you stay here, Miss Laru. I'll head back first, there's stuff to do at the Soul Shop.",0,""],["w",0.5],["se","se_072"],["ctl","avg3_152","a",null,null,0.1,null,null,0.0,null,"Linear",0.5],["w",0.5],["ctl","avg1_150","a","010","attention",null,null,null,null,null,"Linear",0.5],["w",1.0],["se","se_099"],["ctl","avg1_150","a",null,null,0.3,null,null,null,null,"Linear",0.5],["w",0.5],["ctl","avg1_150","a","016","flurry",0.6,null,null,null,null,"Linear",0.5],["ctl","avg3_152","a",null,null,0.35,null,null,1.0,null,"Linear",0.5],["say","avg1_150","No no no! My job today is to \"help the newbie get familiar with the process.\" If the newbie leaves, then I can't do my job, can I?",0,""],["w",0.5],["ctl","avg1_150","a","014","sigh",null,null,null,null,"JuGong2","Linear",0.5],["say","avg1_150","Work's about finishing fast and enjoying your free time, that's what I always say.",0,""],["w",0.5],["ctl","avg1_150","a",null,null,null,null,null,0.0,null,"Linear",0.5],["stg",0,100.0,null,null,"Linear",0.5,null,null,null],["w",0.5],["bg","BG_Black",0,0.5],["ctl","avg3_152","a","008","awkward",null,null,null,null,"chijing","Linear",0.5],["say","avg3_152","(Why is Laru so motivated only when it's about goofing off...?)",0,""],["w",0.5],["ctl","avg1_150","a","018",null,0.8,null,null,null,null,"Linear",0.0],["ctl","avg3_152","a",null,null,null,null,null,0.0,null,"Linear",0.5],["bg","travellers_home_inside",0,0.5],["w",1.0],["show","avg3_139","a","006",0.3,null,null,0,null,0.0],["ctl","avg3_139","a","006","exclamation",0.4,null,null,1.0,"jushou2","Linear",0.5],["w",0.5],["say","Delivery Person","Hello! Super–mega–jumbo Monolith fries delivery! Whose order is it?",0,""],["w",0.5],["stg",0,-60.0,null,null,"Linear",0.5,null,null,null],["ctl","avg1_150","a",null,"flower",0.65,null,null,1.0,"jushou2","Linear",0.5],["say","avg1_150","It's mine! Mine! Thank you~",0,""],["w",1.0],["ctl","avg3_152","a",null,null,0.5,null,null,0.0,null,"Linear",0.0],["ctl","avg1_150","a",null,null,null,null,null,0.0,null,"Linear",0.5],["ctl","avg3_139","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["ctl","avg3_152","a","011","attention",null,null,null,1.0,null,"Linear",0.5],["w",0.5],["bg","BG_Black",0,0.5],["w",0.5],["say","avg3_152","(When did she order this?==W== Wait—don't tell me this was her plan all along?)",0,""],["w",0.5],["ctl","avg3_152","a","009","symbol",null,null,null,1.0,"chijing","OutSine",0.5],["goon"],["w",0.5],["ctl","avg3_152","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["stg",0,60.0,null,null,"Linear",0.0,null,null,null],["ctl","avg3_152","a",null,null,0.3,null,null,null,null,"Linear",0.0],["ctl","avg1_150","a","023",null,0.5,null,null,null,null,"Linear",0.0],["bg","travellers_home_inside",0,0.5],["w",0.5],["ctl","avg3_152","a",null,null,null,null,null,1.0,null,"Linear",0.5],["se","se_341"],["ctl","avg1_150","a",null,null,null,null,null,1.0,"youzai","Linear",1.0],["w",1.0],["stg",0,-60.0,null,null,"Linear",0.5,null,null,null],["w",0.5],["ctl","avg3_161","a",null,null,0.85,null,null,0.0,null,"Linear",0.0],["se","se_074"],["ctl","avg3_161","a",null,null,0.8,null,null,1.0,null,"Linear",0.5],["w",0.5],["say","avg3_161","If you are going to wait, please come inside. Follow me, please.",0,""],["w",0.5],["se","se_065"],["ctl","avg3_161","a",null,null,0.9,null,null,0.0,null,"Linear",0.5],["w",0.5],["trn",0,0,true,false,1.0],["w",1.0],["bg","travellers_home_office",0,0.5],["w",0.5],["stg",0,0.0,null,null,"Linear",0.0,null,null,null],["trn",1,0,false,false,1.0],["w",1.0],["show","avg3_161","a","002",null,null,null,0,null,0.0],["se","se_077"],["ctl","avg3_161","a",null,null,0.5,null,null,1.0,"JuGong1","Linear",0.5],["w",0.5],["say","avg3_161","I'll head back to work. I am downstairs, please call me if you need me.",0,""],["w",0.5],["ctl","avg3_161","a",null,null,0.7,null,null,0.0,null,"Linear",0.5],["w",0.5],["show","avg1_150","a","018",0.4,null,null,0,null,0.0],["ctl","avg1_150","a",null,"music",0.5,null,null,1.0,null,"Linear",0.5],["say","avg1_150","Yup, thanks!",0,""],["w",0.5],["bgm",""],["se","se_074"],["ctl","avg1_150","a","003",null,null,null,null,null,"JuGong1","Linear",0.5],["w",0.5],["ctl","avg1_150","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["se","se_061"],["obj","qstory_tales_05_001",0,null,null],["w",1.0],["se","se_341"],["say","avg1_150","Ahh~ Fries taste best when you're lying on a couch~",0,""],["w",0.5],["obj","qstory_tales_05_001",1,null,null],["w",0.5],["bgm","m49"],["show","avg3_152","a","008",0.25,null,null,0,null,0.0],["ctl","avg3_152","a",null,null,0.3,null,null,1.0,null,"Linear",0.5],["say","avg3_152","Miss Laru, it doesn't seem right for you to be eating fries on someone else's sofa...",0,""],["w",0.5],["ctl","avg1_150","a","006",null,0.65,null,null,0.0,null,"Linear",0.0],["objx"],["w",1.0],["ctl","avg1_150","a",null,"happy",null,null,null,1.0,"JuGong1","Linear",0.5],["say","avg1_150","Don't worry. Willow doesn't care about stuff like this~",0,""],["w",0.5],["se","se_050"],["ctl","avg1_150","a","013",null,null,null,null,null,"zuochupeng","Linear",0.5],["say","avg1_150","Make yourself at home, Bastelina.==W== Oh, that cushion's a bit flat—grab another spot, if you like.",0,""],["w",0.5],["ctl","avg1_150","a","004","attention",null,null,null,1.0,null,"OutSine",0.5],["goon"],["w",0.5],["ctl","avg3_152","a","014","speechless",null,null,null,null,"niunie1","Linear",0.5],["say","avg3_152","You seem very familiar with this place...",0,""],["ctl","avg3_152","a",null,null,null,null,null,null,null,"Linear",0.0],["w",0.5],["ctl","avg1_150","a","024","flower",null,null,null,null,"youzai","Linear",0.5],["say","avg1_150","Of course! This is like a second home to me!",0,""],["ctl","avg1_150","a","005",null,null,null,null,null,"jushou2","Linear",0.5],["say","avg1_150","Once you start taking field assignments, you can come hang out here too!",0,""],["w",0.5],["ctl","avg3_152","a","009","sweaty",null,null,null,null,"chijing","Linear",0.5],["say","avg3_152","I think I'll pass...==W== Even if I do, I'll ask for time off first.",0,""],["w",0.5],["ctl","avg3_152","a","006",null,null,null,null,1.0,null,"OutSine",0.5],["goon"],["w",0.5],["se","se_030"],["ctl","avg1_150","a","009",null,null,null,null,null,"chijing","Linear",0.5],["say","avg1_150","No no no, if you take time off they'll dock your pay, and your supervisor will think poorly of you. Especially if it's someone like that ice queen Albedo.",0,""],["w",0.5],["ctl","avg3_152","a","008","speechless",null,null,null,null,"niunie1","Linear",0.5],["say","avg3_152","But ...==W== isn't that bad for the company? They pay us every month on time, after all.",0,""],["w",1.0],["ctl","avg3_152","a","015","vexation",null,null,null,1.0,null,"OutSine",0.5],["goon"],["w",0.5],["ctl","avg1_150","a","012","happy",0.5,null,null,null,null,"Linear",0.5],["say","avg1_150","Bastelina, you really don't get it. The company pays us for delivering results, not for our time!",0,""],["w",0.5],["ctl","avg3_152","a","016","flurry",null,null,null,null,"chijing","Linear",0.5],["say","avg3_152","But if we get caught doing that, they'll definitely dock our pay...",0,""],["w",0.5],["ctl","avg1_150","a","014",null,null,null,null,null,"JuGong1","Linear",0.5],["say","avg1_150","That's why you don't get caught! I've got this book from the Monolith called The Art of Strategic Slacking. It's got thirty-six ingenious tactics! I'll lend it to you some time.",0,""],["ctl","avg1_150","a","008","exclamation",null,null,null,null,null,"Linear",0.5],["say","avg1_150","Just don't let your boss see it, or she'll confiscate it and use the same tricks on you.",0,""],["w",0.5],["ctl","avg3_152","a","014","happy",null,null,null,null,"niunie1","Linear",0.5],["say","avg3_152","Ahaha... As a newbie, I don't think I'm ready for those \"tactics.\" I'll just stick to doing my job. Thanks though, Miss Laru.",0,""],["w",0.5],["ctl","avg1_150","a","005","music",null,null,null,null,null,"Linear",0.5],["say","avg1_150","Okay. Just let me know if you change your mind.",0,""],["w",0.5],["se","se_074"],["ctl","avg1_150","a","014",null,0.65,null,null,null,null,"Linear",0.5],["say","avg1_150","But seriously, it's so boring when Willow's not here~",0,""],["ctl","avg1_150","a","013","question",null,null,null,null,null,"Linear",0.5],["say","avg1_150","You like fishing? Let's go fishing!",0,""],["w",0.5],["ctl","avg3_152","a","011","attention",null,null,null,null,"jushou2","Linear",0.5],["say","avg3_152","Weren't you supposed to be showing me the work process? And what if Miss Willow comes back while we're gone?",0,""],["w",0.5],["ctl","avg1_150","a","010","idea",null,null,null,null,null,"Linear",0.5],["say","avg1_150","Oh right, right! About that.==W== Have you heard of the Trekkers' House?",0,""],["w",0.5],["se","se_099"],["ctl","avg1_150","a","005",null,0.55,null,null,1.0,null,"OutSine",0.5],["goon"],["w",0.5],["ctl","avg3_152","a","002","speechless",null,null,null,null,null,"Linear",0.5],["say","avg3_152","I think so... It's that super important place for Trekkers, right?",0,""],["ctl","avg3_152","a",null,null,null,null,null,null,null,"Linear",0.0],["w",0.5],["ctl","avg1_150","a","003",null,null,null,null,null,"diantou2","Linear",0.5],["say","avg1_150","Yeah. It's kind of like a field office they'd set up in Nova's Wilds.",0,""],["w",0.5],["ctl","avg1_150","a",null,null,null,null,null,0.0,null,"Linear",0.5],["ctl","avg3_152","a",null,null,null,null,null,0.0,null,"Linear",0.5],["w",0.5],["bg","ruin_travellers_home_inside",0,0.5],["cbg",0,-60.0,null,null,"Linear",4.0,null,null,null],["w",0.5],["say","avg1_150","Trekkers pick up commissions and get paid there. They've also got cheap rooms and meals.==W== Basically, if you wanna find lots of Trekkers, that's the only place. You won't find any in the city.",0,""],["w",0.5],["goon"],["w",0.5],["bg","travellers_home_office",0,0.5],["w",0.5],["ctl","avg3_152","a","005","idea",null,null,null,1.0,null,"Linear",0.5],["say","avg3_152","Ah, I get it! That's why we have the Trekker Association handle our Artifact commissions all at once. Doing it ourselves at every Trekkers' House would waste a ton of time!",0,""],["w",0.5],["ctl","avg1_150","a","005","music",null,null,null,1.0,null,"Linear",0.5],["say","avg1_150","Smart girl! You catch on fast for a rookie.",0,""],["w",0.5],["se","se_062"],["ctl","avg1_150","a","006",null,0.6,null,null,null,null,"Linear",0.5],["say","avg1_150","Anyway, all we have to do is grab the inventory lists and price sheets from Willow, hand them to Albedo and her bookkeepers, and we're done.",0,""],["w",0.5],["ctl","avg3_152","a","012","question",null,null,null,null,null,"Linear",0.5],["say","avg3_152","Just the list? Don't we check the goods?==W== What if something's wrong...?",0,""],["w",0.5],["se","se_112"],["ctl","avg3_152","a",null,null,null,null,null,1.0,"chijing","OutSine",0.5],["goon"],["w",0.5],["ctl","avg1_150","a","013","star",null,null,null,null,null,"Linear",0.5],["say","avg1_150","Don't worry. Willow's super reliable. She checks everything, even the tiniest scratch on these Artifacts.",0,""],["se","se_061"],["ctl","avg1_150","a","003",null,null,null,null,null,"youzai","Linear",0.5],["say","avg1_150","We've worked with her for ages and never had an issue. We just need to do our part and trust her.",0,""],["w",0.5],["ctl","avg1_150","a","007","music",null,null,null,null,null,"Linear",0.5],["say","avg1_150","Besides, if we tried to check every detail of the process ourselves, we'd never have time for anything else. You've gotta trust your partners~",0,""],["w",0.5],["ctl","avg3_152","a","011","attention",null,null,null,null,"diantou","Linear",0.5],["w",0.5],["se","se_022"],["ctl","avg3_152","a","006",null,null,null,null,null,"niunie1","Linear",0.5],["say","avg3_152","I see... So finding trustworthy partners is key...",0,""],["w",0.5],["se","se_022_stop"],["bgm",""],["trn",0,0,true,false,0.5],["w",0.5],["trn",1,0,false,false,0.5],["w",0.5],["stg",0,null,null,null,"Linear",1.0,null,null,"Zhong"],["se","se_143"],["w",0.5],["show","avg3_161","a","004",0.4,null,null,0,null,0.0],["ctl","avg3_161","a",null,"attention",0.5,null,null,1.0,"JuGong1","Linear",0.5],["w",0.5],["say","avg3_161","Excuse me, I just need to move these boxes.",0,""],["w",0.5],["bgm","m2"],["show","avg1_150","a","004",0.3,null,null,0,null,0.0],["ctl","avg3_161","a",null,null,0.65,null,null,null,null,"Linear",0.5],["ctl","avg1_150","a",null,"exclamation",0.35,null,null,1.0,null,"Linear",0.5],["say","avg1_150","Whoa... That's a mountain of paperwork!",0,""],["w",0.5],["ctl","avg3_161","a","005","sigh",null,null,null,null,null,"Linear",0.5],["say","avg3_161","Yes, and there are two more boxes like this downstairs.",0,""],["w",0.5],["stg",0,-60.0,null,null,"Linear",0.5,null,null,null],["ctl","avg1_150","a",null,null,0.25,null,null,0.0,null,"Linear",0.3],["ctl","avg3_161","a",null,null,0.4,null,null,null,null,"Linear",0.5],["show","avg3_152","a","002",0.75,null,null,0,null,0.0],["ctl","avg3_152","a",null,"question",0.7,null,null,1.0,null,"Linear",0.5],["say","avg3_152","Want help?",0,""],["w",0.5],["se","se_054"],["ctl","avg3_161","a","009",null,null,null,null,null,"chijing","Linear",0.5],["say","avg3_161","No, thanks. You are our guests.",0,""],["w",0.5],["ctl","avg3_152","a","010","happy",0.65,null,null,null,"jushou2","Linear",0.5],["say","avg3_152","It's fine! We're partners, right? Helping each other is only natural!",0,""],["w",0.5],["ctl","avg3_161","a","004",n