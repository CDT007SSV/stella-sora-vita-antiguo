1.0],["w",2.15],["se","se_096"],["w",1.0],["stg",0,null,null,1.0,"OutSine",0.5,null,null,null],["ctl","avg3_205","a",null,null,null,null,null,1.0,null,"Linear",0.5],["w",1.0],["se","se_062"],["ctl","avg3_205","a","002",null,0.5,null,null,null,null,"OutSine",0.75],["w",1.25],["ctl","avg3_205","a",null,null,null,null,null,null,null,"InQuint",1.0],["w",1.0],["say","avg3_205","Hmph... Drop the act. Kneeling that long must have killed your legs. Here, let me help you up.",0,""],["w",0.5],["trn",0,0,true,true,1.0],["w",1.0],["se","se_100"],["stg",0,0.0,-35.0,1.1,"Linear",0.0,null,null,null],["show","avg3_205","a","002",0.65,null,null,0,null,null],["show","avg1_118","a","013",0.35,null,null,0,null,null],["w",2.0],["cbg",0,300.0,0.0,1.25,"Linear",0.0,null,null,null],["trn",1,0,false,false,1.0],["w",1.0],["ctl","avg3_205","a","003","sigh",null,null,null,null,null,"Linear",0.5],["say","avg3_205","They certainly didn't hold back. You'd think being a fellow officer of the Grace Imperium would count for something.",0,""],["w",0.5],["se","se_146"],["ctl","avg1_118","a","012",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_118","I'm fine. If anything, the pain helps. It serves as a useful distraction.",0,""],["ctl","avg1_118","a",null,null,null,null,null,null,null,"Linear",0.5],["w",0.5],["se","se_252"],["ctl","avg3_205","a","004",null,0.55,null,null,null,null,"OutSine",0.5],["say","avg3_205","The verdict's in.==W== Take a look.",0,""],["w",0.75],["ctl","avg3_205","a","003",null,0.65,null,null,null,null,"OutSine",0.5],["goon"],["w",0.5],["ctl","avg3_205","a",null,null,0.7,null,null,0.0,null,"OutSine",0.5],["ctl","avg1_118","a",null,null,0.5,-0.15,1.2,null,null,"OutSine",0.5],["se","se_021"],["ctl","avg1_118","a","014",null,null,null,null,null,"diantou","OutSine",0.5],["say","avg1_118","Let's see...==W== Hmm. \"Blasphemy against the God of Grace. Heresy. Sentenced to public hanging.\"",0,""],["w",1.0],["ctl","avg1_118","a","006","speechless",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg1_118","a","007","angry",null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_118","Hah. Just as I predicted. How tedious... Fools always resort to crude violence when they face something they can't understand.",0,""],["w",0.5],["se","se_062"],["ctl","avg1_118","a",null,null,0.35,null,null,null,null,"OutSine",0.5],["ctl","avg3_205","a",null,null,0.75,-0.17,1.2,null,null,"Linear",0.0],["ctl","avg3_205","a","004",null,0.68,null,null,1.0,null,"OutSine",0.5],["w",0.5],["say","avg3_205","I heard you tried to turn your trial into an academic debate.",0,""],["w",0.5],["ctl","avg1_118","a","014","question",null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_118","You call that a debate? Their ignorance was staggering... Trying to reason with Dusk Arbiters is like casting pearls before swine.",0,""],["w",0.5],["ctl","avg1_118","a","012","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_118","I made it perfectly clear: \"The Nocturn Eterna do not need the God of Grace's blessing to wield magic.\"",0,""],["w",0.5],["ctl","avg1_118","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_118","\"They generate their own magic. No Soul Stones required.\"==W== ... Simple. Empirical.",0,""],["w",1.0],["ctl","avg1_118","a","006","angry",null,null,null,null,"chijing","Linear",0.5],["goon"],["ctl","avg1_118","a",null,null,null,null,null,null,null,"Linear",0.5],["w",0.5],["se","se_049"],["ctl","avg3_205","a","008","happy",null,null,null,null,"diantou2","Linear",0.5],["say","avg3_205","Hahaha! Well, they aren't academics, Coronis. They don't care about the science.",0,""],["w",0.5],["ctl","avg3_205","a","007",null,null,null,null,null,null,"Linear",0.5],["say","avg3_205","Their job is to stop thinking, issue a verdict that fits the \"ancient doctrine,\" and close the case.",0,""],["clear",1,0.5,1],["bg","story_main_02_018",0,1.0],["w",1.0],["say","avg3_205","Doctrine states that magic and Soul Stones are exclusive gifts from the God of Grace. No one dares question that publicly... Even researching it is forbidden.",0,""],["w",0.5],["say","avg1_118","Hmph... I think they're playing dumb. Avoiding truths they're too terrified to face.",0,""],["trn",0,0,false,false,1.0],["w",1.0],["bg","court_inside",0,0.0],["cbg",0,180.0,null,1.1,"Linear",0.0,null,null,null],["fx",0,"fx_avg_reminiscence_loop",0,0],["cbg",0,-180.0,null,null,"Linear",11.0,null,null,null],["trn",1,0,false,false,1.0],["w",1.0],["say","avg1_118","One High Arbiter actually argued that \"faith in the God of Grace\" is a prerequisite for magic. I nearly laughed out loud in the middle of court.",0,""],["say","avg1_118","I considered casting a spell while denouncing their god, just to prove them wrong. But what a hassle... I'd have to explain the basic principles of magic from scratch.",0,""],["w",0.5],["trn",0,0,false,false,1.0],["w",1.0],["fx",0,"fx_avg_reminiscence_loop",1,0],["bg","city_prison",0,1.0],["w",1.0],["cbg",0,300.0,null,1.25,"Linear",1.0,null,null,null],["w",1.0],["show","avg1_118","a","002",0.35,null,null,0,null,null],["show","avg3_205","a","002",0.65,null,null,0,null,null],["trn",1,0,false,false,1.0],["w",1.5],["ctl","avg3_205","a","009","speechless",null,null,null,null,null,"Linear",0.5],["say","avg3_205","So you waived the rest of the defense and let them skip straight to sentencing?",0,""],["ctl","avg3_205","a",null,null,null,null,null,null,null,"Linear",0.5],["w",0.5],["ctl","avg1_118","a","012","sigh",null,null,null,null,null,"Linear",0.5],["say","avg1_118","Like I said: pearls before swine. No matter how clearly I explain, they lack the capacity to understand.",0,""],["ctl","avg3_205","a","002","attention",null,null,null,null,null,"Linear",0.5],["w",0.5],["say","avg3_205","Pearls before swine...==W== Hahaha!",0,""],["w",0.5],["ctl","avg3_205","a","008","happy",null,null,null,null,"diantou2","Linear",0.5],["goon"],["w",0.5],["ctl","avg3_205","a","007","music",null,null,null,null,"jushou1","Lin