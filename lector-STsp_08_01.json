,["say","avg1_118","Oh. Is that so? Well, guess I'll check out Biology then...",0,""],["w",0.5],["se","se_010"],["ctl","avg1_118","a","012",null,0.8,null,null,0.0,null,"InSine",2.0],["say","avg1_118","If I'd known, I wouldn't have stayed up all night working on that specimen... Yawn...",0,""],["w",0.5],["ctl","avg3_205","a","006","exclamation",null,null,null,null,"jushou1","Linear",0.5],["say","avg3_205","Wait! Hold on!==W== Did you just say ... \"specimen\"?",0,""],["w",0.75],["se","se_062"],["stg",0,-300.0,-50.0,1.2,"OutSine",0.5,null,null,null],["ctl","avg1_118","a",null,null,null,null,null,2.0,null,"OutSine",1.0],["ctl","avg3_205","a",null,null,0.45,null,null,null,null,"OutSine",0.5],["w",0.5],["goon"],["w",0.5],["ctl","avg1_118","a","014","attention",null,null,null,null,null,"OutSine",0.5],["say","avg1_118","Hm? Yes. Scored a piece of free monster remains from the Trekker Association yesterday. Had to process them before they rotted, so I was up late.",0,""],["w",0.5],["ctl","avg3_205","a","009","symbol",null,null,null,null,"chijing","Linear",0.5],["say","avg3_205","What's the matter with the freshmen these days? Haven't even started classes and you're already preserving samples?",0,""],["w",0.5],["ctl","avg1_118","a","008","happy",null,null,null,null,"daintou","Linear",0.5],["say","avg1_118","Just a hobby. I'm Coronis...==W== Are you ... a teacher here?",0,""],["w",1.0],["ctl","avg1_118","a","011",null,0.75,null,null,null,null,"OutSine",0.5],["goon"],["w",0.5],["ctl","avg3_205","a","007",null,null,null,null,null,null,"Linear",0.5],["say","avg3_205","No, I'm Igna. Two years ahead of you. Just here helping the faculty sort some files.",0,""],["w",0.5],["ctl","avg3_205","a","008","idea",null,null,null,null,"jushou0","Linear",0.75],["w",0.75],["say","avg3_205","Tell you what, I'll take you to the professor. Registration is closed, but if you explain the situation and show her what you can do, she might make an exception.",0,""],["w",0.5],["ctl","avg3_205","a","007",null,0.55,null,null,null,null,"OutSine",0.5],["w",0.5],["se","se_019"],["cbg",0,50.0,null,null,"OutSine",0.5,null,null,null],["ctl","avg3_205","a",null,null,0.45,null,null,null,null,"OutSine",0.5],["ctl","avg1_118","a","005",null,0.7,null,null,null,null,"OutSine",0.5],["w",0.5],["say","avg3_205","It'd be a shame to let another department snatch up a student of your caliber.",0,""],["w",0.5],["ctl","avg1_118","a","018","flower",null,null,null,null,"niunie","Linear",1.0],["say","avg1_118","Thank you so much,==W== Senior Igna.",0,""],["w",1.0],["ctl","avg1_118","a","010","music",null,null,null,null,"JuGong1","Linear",0.5],["goon"],["w",0.5],["ctl","avg3_205","a","008","happy",null,null,null,null,"youchupeng","Linear",0.5],["say","avg3_205","Hahaha, no need for that. I'm not big on titles. Just call me Igna.",0,""],["w",0.5],["ctl","avg3_205","a","007",null,null,null,null,null,null,"Linear",0.5],["say","avg3_205","Hmm... Actually, showing the professor your work directly would be more convincing. Let's swing by your dorm and grab that specimen.",0,""],["w",0.5],["ctl","avg1_118","a","016","music",null,null,null,null,"diantou2","Linear",1.0],["w",1.0],["se","se_065"],["trn",0,0,true,true,1.0],["w",1.0],["bg","wog_academy_office",0,1.0],["w",1.0],["trn",1,0,false,false,1.0],["w",2.0],["show","avg3_171","a","002",0.65,null,null,0,null,0.0],["ctl","avg3_171","a",null,null,null,null,null,1.0,null,"Linear",0.5],["w",0.5],["ctl","avg3_171","a","006","attention",null,null,null,null,"jushou0","Linear",0.5],["say","Medical Instructor","This is a remarkably fine specimen. Did you really preserve this yourself? The incision work is flawless—I'd say you have at least three years of experience.",0,""],["w",0.5],["show","avg1_118","a","002",0.45,null,null,0,null,0.0],["ctl","avg3_171","a",null,null,0.75,null,null,null,null,"OutSine",0.5],["ctl","avg1_118","a","003",null,0.5,null,null,1.0,null,"OutSine",0.5],["w",0.5],["ctl","avg1_118","a",null,"star",null,null,null,null,"JuGong","Linear",0.5],["say","avg1_118","You flatter me. But since bones are the only enduring proof that a creature ever lived, I believe carving into a subject demands the reverence due to art.",0,""],["w",0.5],["ctl","avg3_171","a","007","question",null,null,null,null,null,"Linear",0.5],["say","Medical Instructor","I see. Tell me, why pick Medicine as your primary major? Why not Biology?",0,""],["w",0.5],["ctl","avg1_118","a","008",null,null,null,null,null,null,"Linear",0.5],["say","avg1_118","Humans are the apex of creation. They incite a curiosity in me that no other creature can match. General biology is fine, but the human body... That is what suits my tastes.",0,""],["w",0.5],["ctl","avg1_118","a","014","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_118","But self-study has insurmountable limits. Specifically in anatomy—it is remarkably difficult to source high-quality human subjects on my own, so...",0,""],["ctl","avg1_118","a",null,null,null,null,null,null,null,"Linear",0.5],["w",0.5],["ctl","avg3_171","a","008","symbol",null,null,null,null,"jingxia","Linear",0.5],["say","Medical Instructor","Whoa, stop right there. Are you saying ... you only want to enroll here so you can slice people open?",0,""],["w",0.5],["ctl","avg3_171","a",null,null,0.85,null,null,null,null,"OutSine",0.5],["ctl","avg1_118","a",null,null,0.4,null,null,null,null,"OutSine",0.5],["chd",0,1,"avg3_205","a","009","flurry"],["say","avg3_205","Uh, Professor! What Coronis means is that human anatomy presents a unique challenge! She wants to master it to... Uh... Benefit society!",0,""],["w",0.5],["ctl","avg3_171","a",null,"attention",null,null,null,null,"lengzhan","Linear",0.5],["say","Medical Instructor","Ah... Is that so? I see.",0,""],["w",0.5],["chd",1,1,"avg3_205","a","002",null],["ctl","avg1_118","a",null,null,0.5,null,null,null,null,"OutSine",0.5],["ctl","avg3_171","a",null,null,0.75,null,null,null,null,"OutSine",0.5],["w",0.5],["ctl","avg3_171","a","002",null,null,null,null,null,"daintou","Linear",0.5],["say","Medical Instructor","Coronis, aside from dissection, do you have any other interests?",0,""],["w",0.5],["ctl","avg1_118","a","003","music",null,null,null,null,"JuGong1","Linear",0.5],["say","avg1_118","I also dabble in pharmacology.",0,""],["w",0.5],["se","se_113"],["ctl","avg1_118","a","008",null,null,null,null,null,"JuGong","Linear",1.0],["w",1.0],["say","0","Coronis produces a test tube filled with a mysterious liquid.",0,""],["w",0.5],["ctl","avg3_171","a","007","shock",null,null,null,null,"chijing","Linear",0.5],["say","Medical Instructor","And what is this?",0,""],["ctl","avg3_171","a",null,null,null,null,null,null,null,"Linear",0.0],["w",0.5],["ctl","avg1_118","a","016","star",null,null,null,null,null,"Linear",0.5],["say","avg1_118","A potion I cooked up myself. It functions as a magic amplifier.",0,""],["say","avg1_118","Once ingested, it temporarily spikes the user's mana output, effectively doubling spell potency.",0,""],["w",0.5],["ctl","avg3_171","a","006","attention",0.7,null,null,null,"diantou","OutSine",0.45],["w",0.45],["say","Medical Instructor","Fascinating. It's actually purple.",0,""],["say","Medical Instructor","Mind if I have a taste?",0,""],["w",0.5],["ctl","avg1_118","a","010","happy",null,null,null,null,"diantou","Linear",0.5],["say","avg1_118","Be my guest.",0,""],["w",0.5],["ctl","avg1_118","a",null,null,0.4,null,null,0.0,null,"OutSine",0.5],["ctl","avg3_171","a",null,null,0.62,null,null,null,null,"OutSine",0.5],["w",1.0],["se","se_239"],["ctl","avg3_171","a","007",null,null,null,null,null,"JuGong2","Linear",0.5],["w",1.5],["ctl","avg3_171","a",null,"speechless",null,null,null,null,null,"Linear",1.0],["say","Medical Instructor","Hmm... Not bad. Goes down smooth.==W== Let's test it out. A simple Light Spell should do.",0,""],["w",1.0],["ctl","avg3_171","a","006",null,null,-0.1,1.1,null,null,"OutSine",0.5],["goon"],["w",0.5],["bgm",""],["fx",0,"fx_avg_flash_ev",0,1],["w",0.15],["fx",0,"fx_avg_flash_end_ev",