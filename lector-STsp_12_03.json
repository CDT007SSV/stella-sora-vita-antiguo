ll,null,null,null,null,"Linear",0.5],["w",0.5],["say","avg1_149","Exhibit A: The blood on that phone is ancient, meaning it had been silent for ages, yet it rang the second we found it. A bit too convenient, no?",0,""],["ctl","avg1_149","a","004",null,null,null,null,null,"diantou","Linear",0.5],["w",0.5],["say","avg1_149","Exhibit B: If a Trekker dropped it during an attack, where's the mess? No struggle marks, no scattered gear—nothing.",0,""],["w",0.5],["se","se_257"],["ctl","avg1_149","a","011",null,null,null,null,null,null,"Linear",0.5],["say","avg1_149","Exhibit C: The Trekkers were ambushed by Stellaroids on previous floors, yet they could sprint all the way to the Boss's Domain unscathed? Please.",0,""],["w",0.5],["mrt",1,"z","009","speechless",null],["say","avg3_100","...",1,""],["mrt",3,"z",null,null,null],["ctl","avg1_149","a","003",null,null,null,null,null,null,"Linear",0.5],["w",0.5],["se","se_062"],["ctl","avg1_149","a","004",null,null,-0.27,1.3,null,null,"OutQuad",0.5],["say","avg1_149","Since we're on the same page, why not call them off? It's likely a trap. No need to walk right into the snare.",0,""],["w",0.5],["mrt",1,"z","012",null,null],["say","avg3_100","No. We keep moving.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_149","a","006","shock",null,null,null,null,null,"Linear",0.5],["say","avg1_149","Why?",0,""],["ctl","avg1_149","a",null,null,null,null,null,null,null,"Linear",0.5],["w",0.5],["mrt",1,"z","002",null,null],["say","avg3_100","You're wasting your breath. My guild isn't stupid. They know it smells like a trap. But what if there's a one-percent chance someone does need saving? They'll take that bet.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_149","a","015","question",null,null,null,null,"niunie","Linear",0.5],["say","avg1_149","Oh? Walking into a trap with your eyes wide open... Sounds like plain old recklessness.",0,""],["w",0.5],["mrt",1,"z","012",null,null],["say","avg3_100","Not reckless. It's solidarity. Trekkers look out for their own—we all know how easily it could be us next time.",1,""],["w",0.5],["se","se_169"],["trn",0,1,true,true,0.7],["w",0.7],["fx",0,"fx_avg_reminiscence_loop",0,1],["bg","tower_supermarket",0,0.0],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["show","avg3_100","j","002",null,null,null,0,null,null],["trn",1,1,false,false,1.0],["w",1.5],["ctl","avg3_100","j",null,null,null,null,null,0.0,null,"OutSine",0.8],["show","avg1_112","a","012",0.25,-0.06,1.1,0,null,0.0],["show","avg1_111","a","015",null,-0.06,1.1,0,null,0.0],["show","avg1_103","a","005",0.75,-0.06,1.1,0,null,0.0],["w",1.0],["hide","avg3_100"],["w",0.5],["ctl","avg1_103","a",null,null,null,null,null,1.0,null,"Linear",0.75],["ctl","avg1_112","a",null,null,null,null,null,1.0,null,"OutSine",0.75],["ctl","avg1_111","a",null,null,null,null,null,1.0,null,"OutSine",0.75],["w",1],["mrt",1,"z","022",null,null],["say","avg3_100","They saved me once, too. If they hadn't...==W== Well, we wouldn't be having this lovely chat.",1,""],["w",0.5],["trn",0,0,false,false,0.6],["w",0.6],["fx",0,"fx_avg_reminiscence_loop",1,1],["hide","avg1_103"],["hide","avg1_111"],["hide","avg1_112"],["bg","tower_common",0,0.0],["show","avg1_149","a","015",null,-0.27,1.3,0,null,null],["trn",1,0,false,false,1.0],["w",0.3],["goon"],["bgm",""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_149","a","017","happy",null,null,null,null,null,"Linear",0.5],["say","avg1_149","Fascinating. I suppose that warrants an update to your Heresy Score. Let's call it seventy points~",0,""],["bgm","m36"],["ctl","avg1_149","a","002","love",null,null,null,null,"diantou","Linear",0.5],["w",0.5],["mrt",1,"z","007","symbol","buman"],["say","avg3_100","Hold up! I just saw through a trap. Why does that raise my score?! And seriously, what is your grading rubric anyway?!",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_149","a",null,null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_149","You see through the nature o