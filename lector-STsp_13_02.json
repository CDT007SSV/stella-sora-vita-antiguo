","a","006",0.65,null,-1.0,0,null,0.0],["show","avg3_198","a","004",0.3,null,null,0,null,0.0],["ctl","avg3_198","a",null,null,null,null,null,1.0,null,"OutSine",0.5],["ctl","avg3_199","a",null,"happy",0.65,null,null,1.0,"jushou2","OutSine",0.5],["say","Suspicious Sidekick","Hahaha! Give it up! You're never getting out of this house!",0,""],["w",0.5],["ctl","avg3_198","a","006","star",null,null,null,1.0,null,"OutSine",0.5],["say","Suspicious Trekker","This has always been our turf! Good thing we kept those intruder traps active.",0,""],["w",0.5],["bg","mood_1",0,0.5],["ctl","avg3_199","a",null,"flower",null,null,null,null,"chijing","Linear",0.5],["say","Suspicious Sidekick","Can't believe we hooked a rich little princess from the Gold District! Hahaha!",0,""],["w",0.5],["ctl","avg3_198","a",null,null,0.4,null,null,null,null,"OutCubic",0.5],["say","Suspicious Trekker","I was planning to squeeze more cash out of her, but now...==W== We'll just hold her family to ransom.",0,""],["w",0.5],["ctl","avg3_198","a","003","exclamation",null,null,null,1.0,"diantou","OutSine",0.5],["goon"],["ctl","avg3_198","a",null,"music",null,null,null,null,"niunie1","Linear",0.5],["say","Suspicious Trekker","Heheh. Now, how much should we ask for?",0,""],["w",0.5],["bg","hotel_corridor_daylight",0,0.5],["stg",0,-60.0,null,null,"Linear",0.5,null,null,null],["se","se_411"],["bgm",""],["ctl","avg3_199","a","004",null,0.8,null,null,null,null,"Linear",0.5],["say","Suspicious Sidekick","Blame yourself! Naive little brat, you seriously underestimated what the Trekker life is about.",0,""],["w",0.5],["trn",0,0,true,false,1.0],["w",1.0],["bg","hotel_guest_room",0,0.5],["w",0.5],["stg",0,-100.0,0.0,1.1,"Linear",0.0,null,null,null],["trn",1,0,false,false,1.0],["w",1.0],["show","avg1_137","b","009",0.55,null,null,0,null,0.0],["ctl","avg1_137","b",null,"sigh",null,null,null,1.0,"chijing","Linear",0.5],["say","avg1_137","... Hah... I'm so ridiculously gullible. Maybe I'm just not cut out to be a Trekker...",0,""],["w",0.5],["bgm","m61"],["mrt",1,"z","009","speechless",null],["say","avg3_100","It's not your fault. I don't know you well enough yet, but I do know one thing...",1,""],["mrt",0,"z","012",null,null],["say","avg3_100","A bunch of thugs doesn't get to decide your path in life.",1,""],["mrt",0,"z","022",null,null],["say","avg3_100","Truth is, I don't have much more experience as a Trekker than you do. But here's what I do know:",1,""],["mrt",0,"z","002","exclamation",null],["say","avg3_100","To be a Trekker is to be freer than anyone else.",1,""],["ctl","avg1_137","b","005",null,null,null,null,null,null,"Linear",0.5],["mrt",0,"z","023",null,"niunie1"],["say","avg3_100","Following your gut, adventuring without chains... That describes every Trekker I've ever met.",1,""],["mrt",0,"z","013","happy",null],["say","avg3_100","If you want to be the real deal, ignore them. Stick to the reason you started this journey in the first place.",1,""],["mrt",3,"z",null,null,null],["w",0.5],["ctl","avg1_137","b","016","shy",null,null,null,null,null,"Linear",0.5],["say","avg1_137","Mentor... Thank you.",0,""],["w",0.5],["ctl","avg1_137","b","012",null,null,null,null,null,"niunie1","Linear",0.5],["say","avg1_137","Actually ... this isn't the first time I've got myself into a mess like this.==W== I got kidnapped once as a kid. They held me for a huge ransom then, too.",0,""],["w",1.0],["bg","mood_3",0,0.5],["ctl","avg1_137","b","005","vexation",null,null,null,null,null,"Linear",0.5],["goon"],["ctl","avg1_137","b","009",null,null,null,null,null,null,"Linear",0.5],["say","avg1_137","Our head maid stepped in and saved me just in time.==W== Turns out, she used to be a Trekker.",0,""],["w",0.5],["bg","hotel_guest_room",0,0.5],["ctl","avg1_137","b","014","exclamation",null,null,null,null,"jushou2","Linear",0.5],["goon"],["w",0.5],["mrt",1,"z","002","attention",null],["say","avg3_100","A retired Trekker... Is she the reason you wanted to become one?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_029"],["ctl","avg1_137","b","002",null,null,null,null,null,"JuGong1","Linear",0.5],["say","avg1_137","Yeah. Since that day, I swore I'd grow up to be just like her—==W==a cool, capable adult who protects others.",0,""],["w",0.5],["ctl","avg1_137","b","013",null,null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["mrt",1,"z","022",null,null],["say","avg3_100","I see. Then we definitely can't sit around waiting to be rescued, can we?",1,""],["mrt",3,"z",null,null,null],["w",0.5],["se","se_099"],["ctl","avg1_137","b","004",null,null,-0.35,1.5,null,"jushou2","Linear",0.3],["say","avg1_137","You're absolutely right, Mentor! Let's find a way out of here together!",0,""],["w",0.5],["bgm",""],["trn",0,0,true,false,1.0],["w",1.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["bg","hotel_guest_room",0,1.0],["w",1.0],["se","se_076"],["trn",1,0,false,false,1.0],["w",1.5],["mrt",1,"z","009","speechless",null],["say","avg3_100","My guild is inside the Monolith, so they're out of reach. We need another angle...",1,""],["mrt",3,"z",null,null,null],["w",0.5],["show","avg1_137","b","002",null,null,null,0,null,0.0],["ctl","avg1_137","b",null,"attention",null,null,null,1.0,"jushou2","Linear",0.5],["say","avg1_137","Mentor, may I show you what's in my suitcase?",0,""],["w",0.5],["ctl","avg1_137","b",null,null,null,null,null,0.0,null,"Linear",0.5],["hide","avg1_137",0.5],["w",0.5],["bg","BG_Black",5,0.0],["show","avg1_137","b","002",null,0.5,null,5,null,1.0],["stage",5,0,0],["ctl","avg1_137","b",null,null,null,0.7,null,1.0,null,"Linear",0.5],["se","se_077"],["ctl","avg1_137","b","002",null,null,null,null,null,null,"Linear",0.5],["say","avg1_137","I've also got a bunch of props I collected back in the day…",0,""],["w",0.5],["stage",5,1,1],["ctl","avg1_137","b",null,null,null,null,null,0.0,null,"Linear",0.0],["hide","avg1_137",0],["w",0.1],["show","avg1_137","b","003",null,null,null,0,null,0.0],["ctl","avg1_137","b","003","flower",null,null,null,1.0,null,"Out