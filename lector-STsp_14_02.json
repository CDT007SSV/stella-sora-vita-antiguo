","avg3_205","a",null,null,0.55,null,null,null,null,"Linear",0.0],["stg",0,100.0,200.0,1.2,"Linear",0.0,null,null,"jushou"],["w",0.5],["trn",1,0,false,false,1.0],["ctl","avg1_147","a",null,null,null,-0.35,null,null,"jushou","OutQuad",0.4],["w",0.2],["se","se_110"],["bgm",""],["stg",0,null,null,null,"Linear",1.0,null,null,"jushou"],["w",1.5],["ctl","avg1_147","a",null,"flurry",null,null,null,null,"youchupeng","Linear",0.5],["say","avg1_147","I might be losing my mind... Doctor, can you hear me out?",0,""],["w",0.5],["stg",0,0.0,-100.0,null,"Linear",0.8,null,null,null],["w",1.0],["se","se_070"],["ctl","avg3_205","a","004",null,null,null,null,null,"chijing","Linear",1.0],["w",1.5],["ctl","avg1_147","a",null,null,null,null,null,null,"youchupeng","Linear",1.0],["w",0.5],["ctl","avg3_205","a",null,"sweaty",null,null,null,null,null,"Linear",1.0],["w",1.0],["stg",0,0.0,0.0,1.1,"Linear",2.0,null,null,null],["w",1.5],["bgm",""],["se","se_065"],["trn",0,2,true,true,1.0],["w",1.0],["show","avg1_147","a","011",0.3,null,null,0,null,null],["show","avg3_205","a","004",0.7,null,null,0,null,null],["stg",0,0.0,0.0,1.1,"Linear",0.7,null,null,null],["w",0.7],["se","se_066"],["bgm",""],["trn",1,2,false,false,1.5],["w",2.0],["ctl","avg3_205","a","005","question",null,null,null,null,null,"Linear",0.5],["say","avg3_205","So, you played the guitar in the Monolith, and then experienced hallucinations... Is that correct?",0,""],["w",0.5],["ctl","avg1_147","a",null,null,null,null,null,null,null,"Linear",0.5],["say","avg1_147","Yes—no!==W== Midas isn't a guitar, it's a bass!",0,""],["w",0.5],["ctl","avg1_147","a","007","resentful",null,null,null,null,"buman","Linear",1.0],["goon"],["w",0.5],["ctl","avg3_205","a","015","sweaty",null,null,null,null,null,"Linear",0.5],["say","avg3_205","My apologies. I'm not very familiar with music... Ahem. Let's get back on track.",0,""],["ctl","avg1_147","a","015",null,null,null,null,null,null,"Linear",1.0],["w",0.5],["ctl","avg3_205","a","013",null,null,null,null,null,null,"Linear",0.5],["say","avg3_205","In the hallucination, you were playing your instrument. But partway through, your fingers started moving on their own, the instrument's tone changed, and in the end you couldn't even speak... Is that right?",0,""],["ctl","avg1_147","a","011",null,null,null,null,null,null,"Linear",1.0],["w",0.5],["se","se_112"],["ctl","avg1_147","a","018","flurry",null,null,null,null,"lengzhan","Linear",0.5],["w",0.5],["say","avg1_147","Yes... It was terrifying. It felt like I was turned into a puppet on strings...",0,""],["ctl","avg3_205","a","009",null,null,null,null,null,null,"Linear",1.0],["w",0.5],["ctl","avg1_147","a","012","awkward",null,null,null,null,null,"Linear",0.5],["say","avg1_147","The things I wanted to say... I just couldn't get it out. The audience and the producer took over...",0,""],["w",0.5],["ctl","avg1_147","a","014","vexation",null,null,null,null,"jinzhang","Linear",0.5],["say","avg1_147","Doctor... Do I have aphasia or something?",0,""],["w",0.5],["ctl","avg3_205","a","004",null,null,null,null,null,"niunie","Linear",0.5],["say","avg3_205","Don't worry. From the examination results, your vocal cords are fine, and there's no sign of a mental disorder.",0,""],["w",0.5],["ctl","avg1_147","a","005","attention",null,null,null,null,"jushou2","Linear",0.5],["w",0.5],["say","avg1_147","That's a relief...==W== Could it be a side effect of making a wish? Maybe I made some huge wish and just don't remember...",0,""],["w",0.5],["ctl","avg1_147","a","008",null,null,null,null,null,null,"Linear",1.0],["goon"],["w",0.5],["ctl","avg3_205","a","015","sweaty",null,null,null,null,null,"Linear",0.5],["say","avg3_205","That's hard to say. There have been reports of memory loss, but hallucinations during Monolith exploration... This is the first I've heard of it.",0,""],["ctl","avg1_147","a","011",null,null,null,null,null,null,"Linear",1.0],["w",0.5],["ctl","avg3_205","a","003","sigh",null,null,null,null,"JuGong","Linear",0.5],["say","avg3_205","There are still many unsolved mysteries about the Monolith. It's possible that something abnormal happened inside, indirectly affecting your mind.",0,""],["ctl","avg3_205","a","002",null,null,null,null,null,null,"Linear",1.0],["w",0.5],["ctl","avg1_147","a","017","symbol",null,null,null,null,null,"Linear",0.5],["say","avg1_147","Something abnormal?",0,""],["w",0.5],["ctl","avg3_205","a","005","question",null,null,null,null,null,"Linear",0.5],["say","avg3_205","You got any clues?",0,""],["bgm",""],["w",0.5],["ctl","avg1_147","a","015",null,null,null,null,null,null,"Linear",0.5],["say","avg1_147","I'm not sure if it counts as abnormal, but at the time everything felt unnaturally quiet. I couldn't hear the Monolith's sound at all, even though it's usually always there...",0,""],["w",0.5],["ctl","avg1_147","a","016",null,null,null,null,null,null,"Linear",0.5],["bgm","m105"],["say","avg1_147","But when I played Midas, I heard something... Like it was responding to me.",0,""],["ctl","avg3_205","a","013",null,null,null,null,null,null,"Linear",1.0],["w",0.5],["ctl","avg1_147","a","019",null,null,null,null,null,null,"Linear",0.5],["say","avg1_147","I was really happy, so I kept playing. It was the best duet I've ever done...",0,""],["w",0.5],["ctl","avg1_147","a","015",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg1_147","But then came the horrible hallucinations...==W== Could it be that the Monolith wasn't happy with my response? And then got angry?",0,""],["w",0.3],["stg",0,300.0,-100.0,1.35,"OutQuad",1.5,null,null,null],["ctl","avg3_205","a",null,null,null,null,null,0.0,null,"OutQuad",1.0],["w",0.5],["ctl","avg1_147","a",null,null,null,null,null,0.0,"lengzhan","OutQuad",1.0],["w",1.0],["se","se_112"],["obj","qstory_tales_14_003",0,null,null],["goon"],["w",1.0],["objx"],["w",1.0],["stg",0,0.0,0.0,1.05,"OutQuad",1.0,null,null,null],["w",1.0],["ctl","avg1_147","a","011",null,null,null,null,1.0,null,"OutSine",1.0],["ctl","avg3_205","a",null,null,null,null,null,1.0,null,"OutSine",1.0],["w",1.0],["ctl","avg3_205","a","004",null,null,null,null,null,null,"Linear",0.5],["say","avg3_205","That is possible, yes...",0,""],["w",0.5],["ctl","avg3_205","a","013",null,null,null,null,null,null,"Linear",0.5],["say","avg3_205","In the hallucination, you were forced to play music that wasn't your own. If the thing controlling you was the Monolith itself, then that would make a certain kind of sense.",0,""],["w",0.5],["ctl","avg1_147","a","016","speechless",null,null,null,null,null,"Linear",0.5],["say","avg1_147","Come to think of it... In the hallucination, someone kept telling me that I had to play fast songs on the guitar.==W== They said it was a rule set by \"Rovina.\"",0,""],["ctl","avg1_147","a","015",null,null,null,null,null,null,"Linear",0.5],["w",0.5],["goon"],["w",0.5],["ctl","avg3_205","a","010","shock",null,null,null,null,"ChanDou","Linear",1.0],["w",1.0],["say","avg3_205","Rovina?",0,""],["ctl","avg3_205","a",null,null,null,null,null,null,null,"Linear",1.0],["w",0.5],["ctl","avg1_147","a","005",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_147","Yes. Could it be that the Monolith has a name?",0,""],["w",0.5],["ctl","avg3_205","a","013",null,null,null,null,null,null,"Linear",0.5],["say","avg3_205","... Hard to say. As I mentioned, there are still many unknowns about the Monolith. Or—",0,""],["w",0.5],["bgm",""],["ctl","avg3_205","a","004",null,null,null,null,null,null,"Linear",0.5],["say","avg3_205","That might be the name of \"something\" that harms Trekkers.",0,""],["ctl","avg1_147","a","008",null,null,null,null,null,null,"Linear",0.5],["bgm","m42"],["w",0.5],["ctl","avg3_205","a","005",null,null,null,null,null,null,"Linear",0.5],["say","avg3_205","To be safe, you should report this to the Trekker Association. I'll prepare your full medical report.",0,""],["ctl","avg1_147","a","002",null,null,null,null,null,null,"Linear",1.0],["w",0.5],["ctl","avg3_205","a","002",null,null,null,null,null,null,"Linear",0.5],["say","avg3_205","Aside from treating your wounds, I can also prescribe something to soothe your nerves. Do you need anything else?",0,""],["w",0.5],["se","se_112"],["ctl","avg1_147","a","009",null,null,null,null,null,"jinzhang","Linear",0.5],["say","avg1_147","Um... You might think I haven't learned my lesson... But I still want to ask—can I keep playing inside the Monolith?",0,""],["ctl","avg1_147","a","005",null,null,null,null,null,null,"Linear",1.0],["w",0.5],["ctl","avg3_205","a","003","sigh",null,null,null,null,"JuGong","Linear",0.5],["say","avg3_205","A doctor doesn't have the right to take music away from a musician. But aren't you afraid of the hallucinations?",0,""],["ctl","avg3_205","a","005",null,null,null,null,null,null,"Linear",1.0],["w",0.5],["se","se_047"],["ctl","avg1_147","a","008",null,null,null,null,null,"diantou","Linear",0.5],["say","avg1_147","To be honest, I am...==W== But what I feel even more is frustration. Like my response wasn't good enough.",0,""],["w",0.5],["ctl","avg1_147","a","015",null,null,null,null,null,null,"Linear",1.0],["goon"],["ctl","avg1_147","a","002",null,null,null,null,null,null,"Linear",0.5],["say","avg1_147","And I want to understand why the Monolith prefers that kind of music... As a performer, I want to know for myself.",0,""],["w",0.5],["ctl","avg3_205","a","004",null,null,null,null,null,null,"Linear",1.0],["w",1.0],["ctl","avg3_205","a","011",null,null,null,null,null,"diantou","Linear",0.5],["say","avg3_205","I see... You do not lack in ambition.==W== In that case, who am I to stand in your way? You have my support.",0,""],["ctl","avg3_205","a","014","music",null,null,null,null,null,"Linear",0.5],["w",0.5],["goon"],["w",0.5],["ctl","avg3_205","a","012",null,null,null,null,null,null,"Linear",1.0],["ctl","avg1_147","a","006","happy",null,null,null,null,"huanxin","Linear",0.5],["say","avg1_147","Thank you, Doctor Igna!",0,""],["w",0.5],["ctl","avg1_147","a","004",null,null,null,null,null,null,"Linear",0.5],["say","avg1_147","One day, I'll make both the Monolith and its hallucination accept my music. I'll keep working toward that. Thank you for treating me today!",0,""],["w",0.5],["ctl","avg3_205","a","007",null,null,null,null,null,null,"Linear",0.5],["say","avg3_205","If anything happens again, come see me anytime. Take care.",0,""],["w",0.5],["bgm",""],["ctl","avg1_147","a",null,null,0.25,null,null,0.0,null,"Linear",1.0],["w",0.7],["ctl","avg3_205","a","002",null,null,null,null,null,null,"Linear",1.0],["trn",0,0,true,true,1.0],["w",1.0],["stg",0,0.0,0.0,1.05,"Linear",0.0,null,null,null],["show","avg3_205","a","002",null,-0.17,1.2,0,null,null],["cbg",0,0.0,0.0,1.05,"Linear",1.0,null,null,null],["w",1.0],["trn",1,0,false,false,1.0],["w",1.5],["ctl","avg3_205","a","003","speechless",null,null,null,null,null,"Linear",1.0],["w",1.0],["ctl","avg3_205","a","002",null,null,null,null,null,null,"Linear",0.5],["say","avg3_205","Rovina's rules, huh...",0,""],["w",0.5],["ctl","avg3_205","a","013",null,null,null,null,null,null,"Linear",0.5],["w",0.5],["say","avg3_205","Never did I expect to catch a trace of you here. I'm not going to waste this chance...==W== \"Opera Ghost.\"",0,""],["w",0.4],["se","se_257"],["ctl","avg3_205","a","010",null,null,null,null,null,null,"Linear",1.0],["stg",0,null,-50.0,1.3,"OutQuad",0.4,null,null,null],["goon"],["w",0.5],["bgm",""],["stg",0,0.0,0.0,1.1,"Linear",1.8,null,null,null],["w",1.2],["trn",0,0,true,true,1.0],["w",1.0],["bg","travellers_home_inside",0,1.0],["w",2.0],["show","avg1_147","a","002",0.3,null,null,0,null,0.0],["se","se_072"],["trn",1,0,false,false,1.0],["w",1.0],["bgm","m56"],["w",0.5],["ctl","avg1_147","a","005","attention",0.5,null,null,1.0,"2TiaoYue","OutQuad",0.8],["w",1],["say","avg1_147","Hello! Is the person in charge here? I encountered a very dangerous situation in the Monolith and need to report it.",0,""],["w",0.5],["se","se_061"],["stg",0,-200.0,null,1.2,"Linear",0.6,null,null,null],["w",0.6],["chd",0,2,"avg3_161","a","002",n