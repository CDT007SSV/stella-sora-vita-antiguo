.5],["say","avg3_102","I suppose it's possible.==W== But even if the money's sorted, do we have the tech to build what she's envisioning?",9,""],["w",0.5],["goon"],["w",0.5],["say","avg3_102","Sigh.==W== No point talking to myself about it. I'll wait for Horizon to get here, and then—",9,""],["w",0.5],["goon"],["w",0.5],["se","se_172"],["bg","story_tales_16_001_b",0,0.5],["w",1.0],["say","avg3_102","Come in.",9,""],["w",0.5],["bgm",""],["trn",0,0,true,true,0.75],["w",0.75],["se","se_036_stop"],["bg","travellers_home_inside",0,0.0],["stg",0,0.0,0.0,1.0,"Linear",0.0,null,null,null],["cbg",0,0.0,0.0,1.1,"Linear",0.0,null,null,null],["se","se_093"],["w",0.5],["show","avg3_102","a","015",null,null,null,0,null,null],["trn",1,0,false,false,0.75],["w",1.25],["ctl","avg3_102","a","019","question",null,null,null,null,"jushou","Linear",0.5],["say","avg3_102","Hmm? Is she early...?",0,""],["w",0.3],["se","se_072"],["w",0.2],["show","avg3_161","a","007",0.2,null,null,0,null,0.0],["ctl","avg3_102","a",null,null,0.7,null,null,null,null,"OutQuad",0.6],["ctl","avg3_161","a",null,null,0.3,null,null,1.0,"tiao2","OutQuad",0.6],["w",1.1],["bgm","m28"],["stg",0,null,null,1.05,"OutQuad",0.5,null,null,null],["ctl","avg3_161","a","010",null,null,null,null,null,"diantou","Linear",0.5],["say","avg3_161","Hey!==W== Good==W== moooorning—!",0,""],["w",0.5],["stg",0,null,null,1.1,"OutQuad",0.5,null,null,null],["ctl","avg3_161","a","004",null,null,null,null,null,"lengzhan","Linear",0.5],["goon"],["w",0.5],["se","se_063"],["fx",0,"fx_speedline_center_w",0,0],["stg",0,null,null,1.15,"OutQuad",0.5,null,null,"Xiao"],["ctl","avg3_161","a","007",null,null,null,null,null,"jushou","Linear",0.5],["tsk","Xiao"],["goon"],["w",0.5],["stg",0,null,null,1.0,"OutQuad",0.5,null,null,null],["ctl","avg3_102","a","025","sweaty",null,null,null,null,"lengzhan","Linear",0.5],["say","avg3_102","Leafia?",0,""],["w",0.5],["ctl","avg3_102","a","019",null,null,null,null,null,null,"Linear",0.5],["say","avg3_102","I thought you were in Philae. What brings you all the way out to Emor?",0,""],["w",0.5],["ctl","avg3_161","a","004",null,null,null,null,null,"youchupeng","Linear",0.5],["say","avg3_161","Ran into a minor detour.",0,""],["w",0.5],["ctl","avg3_102","a","015","question",null,null,null,null,null,"Linear",0.5],["say","avg3_102","Oh?",0,""],["w",0.5],["ctl","avg3_102","a","003",null,null,null,null,null,"diantou","Linear",0.5],["say","avg3_102","Well, your timing's perfect. Horizon should be here any minute. If you don't mind waiting, you can brief us both at the same time.",0,""],["w",0.5],["ctl","avg3_161","a","002",null,null,null,null,null,null,"OutQuad",0.5],["say","avg3_161","About that... That's actually why I'm here.==W== She is probably back in Sailstead by now.",0,""],["w",0.5],["se","se_062"],["ctl","avg3_161","a","002",null,0.35,null,null,null,null,"OutQuad",0.5],["goon"],["w",0.5],["se","se_070"],["stg",0,null,null,null,"Linear",0.5,null,null,"Xiao"],["ctl","avg3_102","a","023",null,null,null,null,null,"lengzhan","Linear",0.5],["tsk","Xiao"],["say","avg3_102","Excuse me?",0,""],["w",0.5],["chd",0,1,"avg3_159","a","002",null],["ctl","avg3_102","a","021",null,0.75,null,null,null,null,"OutQuad",0.5],["ctl","avg3_161","a","011","speechless",0.25,null,null,null,null,"OutQuad",0.5],["say","avg3_161","I bumped into her back in Philae! She was about to explore a Monolith and completely roped me in as free labor.",0,""],["w",0.5],["ctl","avg3_161","a","005",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg3_161","Then, we found these blueprints for a massive ship inside. She stared at them all night and decided it was totally doable...",0,""],["w",0.5],["chd",1,1,"avg3_159","a","002",null],["ctl","avg3_161","a",null,null,0.3,null,null,null,null,"OutQuad",0.5],["ctl","avg3_102","a","010","angry",0.7,null,null,null,null,"OutQuad",0.5],["tsk","Xiao"],["say","avg3_102","Let me guess. She had an epiphany and bolted straight back to Sailstead to start building? Without running it by me first, of course...==W== Typical. She just does whatever pops into her head.",0,""],["w",0.5],["ctl","avg3_102","a","024",null,null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["ctl","avg3_161","a","009",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg3_161","... Pretty much.",0,""],["w",0.5],["ctl","avg3_102","a","020","sigh",null,null,null,null,"diantou","Linear",0.5],["say","avg3_102","Ugh...==W== Will she ever learn to slow down?",0,""],["w",0.5],["ctl","avg3_102","a","021",null,null,null,null,null,"lengzhan","Linear",0.5],["goon"],["w",0.5],["bg","mood_4",0,0.75],["ctl","avg3_161","a",null,null,null,null,null,0.0,null,"Linear",0.6],["ctl","avg3_102","a","016","awkward",null,null,null,null,"lengzhan","Linear",0.5],["say","avg3_102","Forget the funding for a second. That rundown shipyard at headquarters lacks both the equipment and the supplies. It can't possibly handle a massive vessel...",0,""],["w",0.5],["bg","travellers_home_inside",0,0.5],["cbg",0,null,null,1.1,"Linear",0.0,null,null,null],["ctl","avg3_161","a","004","attention",null,null,null,1.0,"jushou","Linear",0.35],["say","avg3_161","She said she'll figure all that out herself.",0,""],["w",0.5],["se","se_467"],["ctl","avg3_102","a","013",null,null,null,null,null,null,"Linear",0.5],["ctl","avg3_161","a","002",null,0.4,null,null,null,"diantou","OutQuad",0.5],["say","avg3_161","Oh, right! She made sure I handed this to you.",0,""],["w",0.5],["ctl","avg3_102","a","019","question",null,null,null,null,"lengzhan","Linear",0.5],["say","avg3_102","What is this...?",0,""],["w",0.5],["se","se_020"],["ctl","avg3_102","a","025",null,null,null,null,null,"JuGong","Linear",0.5],["say","avg3_102","Budgets, fundraising plans,==W== shipyard renovations, crew recruitment...==W== She even drafted investor pitches for the major companies. Her efficiency is infuriating when she gets like this...",0,""],["w",0.5],["ctl","avg3_102","a",null,null,null,null,null,null,"jinzhang","Linear",0.5],["goon"],["w",0.5],["se","se_020_stop"],["ctl","avg3_102","a","020","sigh",null,null,null,null,null,"Linear",0.5],["goon"],["w",0.5],["ctl","avg3_161","a","004",null,null,null,null,null,null,"Linear",0.5],["ctl","avg3_102","a","013","shock",null,null,null,null,"diantou","Linear",0.5],["say","avg3_102","Hmm?==W== And a letter...?",0,""],["w",0.5],["ctl","avg3_102","a","009",null,null,null,null,null,null,"Linear",0.5],["goon"],["bgm",""],["w",0.5],["se","se_021"],["chd",0,0,"avg3_159","a","007",null],["ctl","avg3_161","a",null,null,0.5,null,null,null,null,"OutQuad",0.5],["ctl","avg3_102","a",null,null,0.8,null,null,null,null,"OutQuad",0.5],["say","0","I'll handle the shipyard. Leaving the logistics to you girls!",0,""],["w",0.5],["chd",1,0,"avg3_159","a","002",null],["ctl","avg3_161","a",null,null,0.4,null,null,null,null,"OutQuad",0.5],["ctl","avg3_102","a","021","speechless",0.7,null,null,null,"lengzhan","OutQuad",0.5],["say","avg3_102","...",0,""],["w",0.5],["ctl","avg3_102","a","021",null,null,null,null,null,null,"Linear",0.5],["ctl","avg3_161","a","009",null,null,null,null,null,"jushou","Linear",0.5],["say","avg3_161","Um, Miss Willow? I totally understand how you feel...",0,""],["w",0.5],["bgm","m45"],["ctl","avg3_102","a","008","happy",null,null,null,null,null,"Linear",0.5],["say","avg3_102","... Heh.==W== Don't worry, I'm not going to blow up.",0,""],["w",0.5],["ctl","avg3_102","a","015",null,null,null,null,null,"diantou","Linear",0.5],["goon"],["w",0.5],["ctl","avg3_102","a","020",null,null,null,null,null,null,"Linear",0.5],["say","avg3_102","She's always like this. Gets an idea and runs with it, completely ignoring everyone's schedules. I'm used to it.",0,""],["w",0.5],["ctl","avg3_161","a","011",null,null,null,null,null,"lengzhan","Linear",0.5],["say","avg3_161","Haha, acting on impulse is kind of her trademark...",0,""],["w",0.5],["ctl","avg3_161","a","004",null,null,null,null,null,null,"Linear",0.5],["ctl","avg3_102","a","021","sigh",null,null,null,null,n