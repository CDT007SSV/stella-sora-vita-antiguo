ull,null,null,null,1.0,null,"Linear",0.5],["ctl","avg3_138","a",null,null,null,null,null,1.0,null,"Linear",0.5],["w",0.85],["stg",0,-50.0,null,null,"OutQuad",0.5,null,null,null],["cbg",0,-25.0,null,null,"OutQuad",0.5,null,null,null],["ctl","avg3_138","a","006","attention",null,null,null,null,"jushou","Linear",0.5],["say","Assertive Trekker","I know people who have already left to find that Monolith! When they get back, we'll know for sure if the rumor's true!",0,""],["w",0.5],["stg",0,50.0,null,null,"OutQuad",0.5,null,null,null],["cbg",0,25.0,null,null,"OutQuad",0.5,null,null,null],["ctl","avg3_139","a","003","happy",null,null,null,null,"lengzhan","Linear",0.5],["say","Skeptical Trekker","You know what it says about you if you actually buy that? It means you're completely brain-dead! Wahahaha!",0,""],["w",0.5],["stg",0,-50.0,null,null,"OutQuad",0.5,null,null,"Xiao"],["cbg",0,-25.0,null,null,"OutQuad",0.5,null,null,null],["ctl","avg3_143","a","008",null,null,null,null,null,"lengzhan","Linear",0.5],["ctl","avg3_138","a","005","resentful",null,null,null,null,"jushou","Linear",0.5],["tsk","Xiao"],["say","Assertive Trekker","What was that? I dare you to say it again!",0,""],["bgm",""],["w",0.2],["se","se_072"],["w",0.3],["stg",0,0.0,null,null,"OutQuad",0.5,null,null,null],["cbg",0,0.0,null,null,"OutQuad",0.5,null,null,null],["ctl","avg3_143","a",null,null,null,-0.1,null,0.0,null,"OutQuad",0.5],["hide","avg3_143",0.5],["w",0.5],["se","se_061"],["stg",0,null,null,null,"Linear",0.5,null,null,"Xiao"],["show","avg1_107","a","015",null,null,0.97,0,null,0.0],["ctl","avg1_107","a",null,null,null,null,1.0,1.0,"chijing","OutQuad",0.5],["tsk","Xiao"],["say","avg1_107","Hey, hey, that's enough! Break it up, everyone!",0,""],["w",0.5],["ctl","avg1_107","a","011","attention",null,null,null,null,"jushou","Linear",0.5],["say","avg1_107","Oh! Willow! Over here!",0,""],["w",0.5],["se","se_062"],["ctl","avg3_139","a",null,null,0.15,null,null,0.0,null,"OutQuad",0.5],["hide","avg3_139",0.5],